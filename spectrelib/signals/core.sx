fn windows_number(sig: Signal) i32 = {
    match sig {
        Signal.Interrupt => {
            return 2
        }
        Signal.IllegalInstruction => {
            return 4
        }
        Signal.FloatingPointException => {
            return 8
        }
        Signal.SegmentationViolation => {
            return 11
        }
        Signal.Terminate => {
            return 15
        }
        Signal.Break => {
            return 21
        }
        Signal.Abort => {
            return 22
        }
    }
    return -1
}

/// Return the platform signal number for `sig`, or -1 when the signal does not
/// exist on the current platform.
pub fn number(sig: Signal) i32 = {
    when windows {
        return windows_number(sig)
    }
    or when darwin {
        return bsd_number(sig)
    }
    or when bsd {
        return bsd_number(sig)
    }
    or when linux {
        return linux_number(sig)
    }
    or when android {
        return linux_number(sig)
    }
    otherwise {
        return -1
    }
}

/// Return the conventional name of `sig` (for example "SIGINT").
pub fn name(sig: Signal) ref u8 = {
    match sig {
        Signal.Hangup => {
            return c"SIGHUP"
        }
        Signal.Interrupt => {
            return c"SIGINT"
        }
        Signal.Quit => {
            return c"SIGQUIT"
        }
        Signal.IllegalInstruction => {
            return c"SIGILL"
        }
        Signal.Trap => {
            return c"SIGTRAP"
        }
        Signal.Abort => {
            return c"SIGABRT"
        }
        Signal.Break => {
            return c"SIGBREAK"
        }
        Signal.BusError => {
            return c"SIGBUS"
        }
        Signal.FloatingPointException => {
            return c"SIGFPE"
        }
        Signal.Kill => {
            return c"SIGKILL"
        }
        Signal.User1 => {
            return c"SIGUSR1"
        }
        Signal.SegmentationViolation => {
            return c"SIGSEGV"
        }
        Signal.User2 => {
            return c"SIGUSR2"
        }
        Signal.Pipe => {
            return c"SIGPIPE"
        }
        Signal.Alarm => {
            return c"SIGALRM"
        }
        Signal.Terminate => {
            return c"SIGTERM"
        }
        Signal.Child => {
            return c"SIGCHLD"
        }
        Signal.Continue => {
            return c"SIGCONT"
        }
        Signal.Stop => {
            return c"SIGSTOP"
        }
        Signal.StopTerminal => {
            return c"SIGTSTP"
        }
        Signal.BackgroundRead => {
            return c"SIGTTIN"
        }
        Signal.BackgroundWrite => {
            return c"SIGTTOU"
        }
        Signal.Urgent => {
            return c"SIGURG"
        }
        Signal.CpuTimeExceeded => {
            return c"SIGXCPU"
        }
        Signal.FileSizeExceeded => {
            return c"SIGXFSZ"
        }
        Signal.VirtualTimer => {
            return c"SIGVTALRM"
        }
        Signal.ProfilingTimer => {
            return c"SIGPROF"
        }
        Signal.WindowChange => {
            return c"SIGWINCH"
        }
        Signal.Io => {
            return c"SIGIO"
        }
        Signal.Power => {
            return c"SIGPWR"
        }
        Signal.System => {
            return c"SIGSYS"
        }
    }
    return c"SIGUNKNOWN"
}

fn dispatch(signum: i32) void = trust {
    if @load(installed_slot(signum)) != 0 {
        // Reinstall the dispatcher. Some C libraries reset the handler to the
        // default action after the first delivery.
        rt.signal(signum, dispatch)
    }

    val count: usize = listener_count
    val i: mut usize = 0
    for {
        if i >= count {
            break
        }
        val registered: i32 = @load(listener_signal_slot(i as i64))
        if registered == signum {
            val address: usize = @load(listener_callback_slot(i as i64))
            if address != 0 {
                val callback: fn(i32) void = @bitcast(address, fn(i32) void)
                @call(callback, signum)
            }
        }
        i = i + 1
    }
}

fn install(signum: i32) result[void, SignalError] = trust {
    if @load(installed_slot(signum)) != 0 {
        return ok ()
    }

    val previous: fn(i32) void = rt.signal(signum, dispatch)
    val previous_address: usize = previous as usize
    if @bitcast(previous_address, i64) == -1 {
        return err SignalError.InstallFailed
    }

    @store(previous_slot(signum), previous_address)
    @store(installed_slot(signum), 1)
    return ok ()
}

/// Register `listener` for a numeric signal.
///
/// Multiple listeners may be registered for the same signal; they run in the
/// order they were added. Returns an error when the signal is invalid, cannot
/// be caught, or the listener table is full.
pub fn on_number(signum: i32, listener: fn(i32) void) result[void, SignalError] = trust {
    if signum <= 0 || signum >= MAX_SIGNALS {
        return err SignalError.InvalidSignal
    }

    val address: usize = listener as usize
    if address == 0 {
        return err SignalError.InvalidListener
    }

    val count: usize = listener_count
    if count >= MAX_LISTENERS {
        return err SignalError.TableFull
    }

    match install(signum) {
        ok _ => {}
        err e => {
            return err e
        }
    }

    @store(listener_signal_slot(count as i64), signum)
    @store(listener_callback_slot(count as i64), address)
    listener_count = count + 1
    return ok ()
}

/// Register `listener` for `sig`.
pub fn on(sig: Signal, listener: fn(i32) void) result[void, SignalError] = trust {
    if sig == Signal.Kill || sig == Signal.Stop {
        return err SignalError.CannotCatch
    }

    val signum: i32 = number(sig)
    if signum < 0 {
        return err SignalError.Unsupported
    }

    return on_number(signum, listener)
}

/// Remove every listener registered for a numeric signal and restore the
/// handler that was installed before the first listener was added.
pub fn off_number(signum: i32) void = trust {
    if signum <= 0 || signum >= MAX_SIGNALS {
        return
    }

    if @load(installed_slot(signum)) != 0 {
        val previous_address: usize = @load(previous_slot(signum))
        val previous: fn(i32) void = @bitcast(previous_address, fn(i32) void)
        rt.signal(signum, previous)
        @store(previous_slot(signum), 0)
        @store(installed_slot(signum), 0)
    }

    val count: usize = listener_count
    val write: mut usize = 0
    val i: mut usize = 0
    for {
        if i >= count {
            break
        }

        val registered: i32 = @load(listener_signal_slot(i as i64))
        if registered != signum {
            if write != i {
                val callback: usize = @load(listener_callback_slot(i as i64))
                @store(listener_signal_slot(write as i64), registered)
                @store(listener_callback_slot(write as i64), callback)
            }
            write = write + 1
        }

        i = i + 1
    }
    listener_count = write
}

/// Remove every listener registered for `sig`.
pub fn off(sig: Signal) void = trust {
    off_number(number(sig))
}

/// Remove every listener and restore all previous signal handlers.
pub fn clear() void = trust {
    val signum: mut i32 = 1
    for {
        if signum >= MAX_SIGNALS {
            break
        }
        off_number(signum)
        signum = signum + 1
    }
}

/// Send a numeric signal to the current process.
pub fn raise_number(signum: i32) i32 = trust {
    return rt.raise(signum)
}

/// Send `sig` to the current process.
pub fn raise_signal(sig: Signal) i32 = trust {
    val signum: i32 = number(sig)
    if signum < 0 {
        return -1
    }
    return rt.raise(signum)
}

fn test_listener(sig: i32) void = {
    test_hits = test_hits + sig
}

test "signals invoke listeners in registration order" {
    test_hits = 0
    trust on(Signal.Interrupt, test_listener)
    trust on(Signal.Interrupt, test_listener)

    trust raise_signal(Signal.Interrupt)
    assert test_hits == 4

    trust off(Signal.Interrupt)

    trust on(Signal.Interrupt, test_listener)
    trust raise_signal(Signal.Interrupt)
    assert test_hits == 6

    trust off(Signal.Interrupt)
    test_hits = 0
}

test "signal metadata matches the host platform" {
    assert number(Signal.Interrupt) == 2
    assert number(Signal.Terminate) == 15

    when posix {
        assert number(Signal.Kill) > 0
        assert number(Signal.IllegalInstruction) == 4
        assert number(Signal.SegmentationViolation) == 11
    }

    when windows {
        assert number(Signal.Abort) == 22
        assert number(Signal.Break) == 21
    }
}
