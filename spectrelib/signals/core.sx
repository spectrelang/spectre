/// Signal handling.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026
///
/// NOTE:
/// Listeners run inside the native signal handler, so they should be short and
/// should avoid allocating, blocking, or taking locks. Keep the work to setting
/// a flag or writing to a self-pipe where possible.

val rt = use("../runtime")

/// Number of listeners that can be registered at once.
pub val MAX_LISTENERS: usize = 32

/// Highest signal number accepted by the numeric API.
pub val MAX_SIGNALS: i32 = 128

/// Signals that can be intercepted.
///
/// Some entries only exist on certain platforms. `number` returns -1 and
/// `on` reports `SignalError.Unsupported` when a signal is not available.
pub enum Signal = {
    Hangup
    Interrupt
    Quit
    IllegalInstruction
    Trap
    Abort
    Break
    BusError
    FloatingPointException
    Kill
    User1
    SegmentationViolation
    User2
    Pipe
    Alarm
    Terminate
    Child
    Continue
    Stop
    StopTerminal
    BackgroundRead
    BackgroundWrite
    Urgent
    CpuTimeExceeded
    FileSizeExceeded
    VirtualTimer
    ProfilingTimer
    WindowChange
    Io
    Power
    System
}

/// Errors reported while installing or removing signal listeners.
pub enum SignalError = {
    InvalidSignal
    Unsupported
    CannotCatch
    TableFull
    InvalidListener
    InstallFailed
}

val listener_signals: mut [32]i32 = @zeroed
val listener_callbacks: mut [32]usize = @zeroed
val listener_count: mut usize = 0

val previous_handlers: mut [128]usize = @zeroed
val installed: mut [128]usize = @zeroed

val test_hits: mut i32 = 0

fn listener_signal_slot(index: i64) mut ref i32 = trust {
    return @ptradd(@addr(listener_signals), index * 4) as ref i32
}

fn listener_callback_slot(index: i64) mut ref usize = trust {
    return @ptradd(@addr(listener_callbacks), index * 8) as ref usize
}

fn previous_slot(signum: i32) mut ref usize = trust {
    return @ptradd(@addr(previous_handlers), (signum as i64) * 8) as ref usize
}

fn installed_slot(signum: i32) mut ref usize = trust {
    return @ptradd(@addr(installed), (signum as i64) * 8) as ref usize
}

fn linux_number(sig: Signal) i32 = {
    match sig {
        Signal.Hangup => {
            return 1
        }
        Signal.Interrupt => {
            return 2
        }
        Signal.Quit => {
            return 3
        }
        Signal.IllegalInstruction => {
            return 4
        }
        Signal.Trap => {
            return 5
        }
        Signal.Abort => {
            return 6
        }
        Signal.BusError => {
            return 7
        }
        Signal.FloatingPointException => {
            return 8
        }
        Signal.Kill => {
            return 9
        }
        Signal.User1 => {
            return 10
        }
        Signal.SegmentationViolation => {
            return 11
        }
        Signal.User2 => {
            return 12
        }
        Signal.Pipe => {
            return 13
        }
        Signal.Alarm => {
            return 14
        }
        Signal.Terminate => {
            return 15
        }
        Signal.Child => {
            return 17
        }
        Signal.Continue => {
            return 18
        }
        Signal.Stop => {
            return 19
        }
        Signal.StopTerminal => {
            return 20
        }
        Signal.BackgroundRead => {
            return 21
        }
        Signal.BackgroundWrite => {
            return 22
        }
        Signal.Urgent => {
            return 23
        }
        Signal.CpuTimeExceeded => {
            return 24
        }
        Signal.FileSizeExceeded => {
            return 25
        }
        Signal.VirtualTimer => {
            return 26
        }
        Signal.ProfilingTimer => {
            return 27
        }
        Signal.WindowChange => {
            return 28
        }
        Signal.Io => {
            return 29
        }
        Signal.Power => {
            return 30
        }
        Signal.System => {
            return 31
        }
    }
    return -1
}

fn bsd_number(sig: Signal) i32 = {
    match sig {
        Signal.Hangup => {
            return 1
        }
        Signal.Interrupt => {
            return 2
        }
        Signal.Quit => {
            return 3
        }
        Signal.IllegalInstruction => {
            return 4
        }
        Signal.Trap => {
            return 5
        }
        Signal.Abort => {
            return 6
        }
        Signal.BusError => {
            return 10
        }
        Signal.FloatingPointException => {
            return 8
        }
        Signal.Kill => {
            return 9
        }
        Signal.SegmentationViolation => {
            return 11
        }
        Signal.System => {
            return 12
        }
        Signal.Pipe => {
            return 13
        }
        Signal.Alarm => {
            return 14
        }
        Signal.Terminate => {
            return 15
        }
        Signal.Urgent => {
            return 16
        }
        Signal.Stop => {
            return 17
        }
        Signal.StopTerminal => {
            return 18
        }
        Signal.Continue => {
            return 19
        }
        Signal.Child => {
            return 20
        }
        Signal.BackgroundRead => {
            return 21
        }
        Signal.BackgroundWrite => {
            return 22
        }
        Signal.Io => {
            return 23
        }
        Signal.CpuTimeExceeded => {
            return 24
        }
        Signal.FileSizeExceeded => {
            return 25
        }
        Signal.VirtualTimer => {
            return 26
        }
        Signal.ProfilingTimer => {
            return 27
        }
        Signal.WindowChange => {
            return 28
