/// Layout of a PtrList struct (3 fields * 8 bytes each):
///
///   offset 0 : ptr  — ref void, pointer to heap buffer
///   offset 8 : len  — usize, number of elements
///   offset 16: cap  — usize, allocated capacity in elements
///
/// Each element is one pointer-sized slot (8 bytes).
/// Values are stored and retrieved as untyped (ref void / usize).

val stdio = use("../stdio")
val allocators = use("../allocators")

val ELEMENT_SIZE: usize = 8

fn alloc_in[A: allocators.GeneralAllocator](ac: A, size: usize) option[ref void] = {
    pre {
        size_positive: size > 0
    }
    return A.alloc(ac, size)
}

fn free_in[A: allocators.GeneralAllocator](ac: A, ptr: ref void) void = trust {
    if ptr != none {
        A.free(ac, ptr)
    }
}

fn realloc_in[A: allocators.GeneralAllocator](ac: A, ptr: ref void, new_size: usize) option[ref void] = {
    pre {
        new_size_positive: new_size > 0
    }
    if ptr == none {
        return A.alloc(ac, new_size)
    }
    return A.realloc(ac, ptr, new_size)
}

fn copy_cstr_in[A: allocators.GeneralAllocator](ac: A, src: ref u8) option[ref u8] = trust {
    val len: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(src, len))
        if c == 0 { break }
        len++
    }
    val buf_opt = alloc_in[A](ac, (len + 1) as usize)
    match buf_opt {
        some buf => {
            @memcpy(buf, src, len)
            @store8(@ptradd(buf, len), 0)
            return some (buf as ref u8)
        }
        none => {
            return none
        }
    }
}

pub enum ListAllocError = {
    OutOfMemory
}

/// An unsafe list for storing values of any type as untyped pointers (ref void).
type PtrList = {
    ptr: ref void
    len: usize
    cap: usize
}

/// Allocate a new PtrList with the given initial capacity.
pub fn (PtrList) new[A: allocators.GeneralAllocator](ac: A, initial_cap: usize) result[ref void, ListAllocError] = trust {
    val header_opt = alloc_in[A](ac, 24 as usize)
    match header_opt {
        none => {
            return err ListAllocError.OutOfMemory
        }
        some header => {
            val buf: mut ref void = none
            if initial_cap > 0 {
                val buf_opt = alloc_in[A](ac, initial_cap * ELEMENT_SIZE)
                match buf_opt {
                    some raw => {
                        buf = raw
                        @memset(buf, 0, initial_cap * ELEMENT_SIZE)
                    }
                    none => {
                        free_in[A](ac, header)
                        return err ListAllocError.OutOfMemory
                    }
                }
            }
            @store(header, buf)
            @store(@ptradd(header, 8), 0)
            @store(@ptradd(header, 16), initial_cap)
            return ok header
        }
    }
}

/// Free a PtrList and its backing buffer.
pub fn (PtrList) free[A: allocators.GeneralAllocator](ac: A, list: mut self) void = trust {
    val buf: ref void = @load(list)
    free_in[A](ac, buf)
    free_in[A](ac, list)
}

/// Return the number of elements in the list.
pub fn (PtrList) len(list: self) usize = {
    return trust @load(@ptradd(list, 8)) as usize
}

/// Return the current capacity.
pub fn (PtrList) cap(list: self) usize = {
    return trust @load(@ptradd(list, 16)) as usize
}

/// Grow the backing buffer to at least new_cap elements.
/// Requires new_cap > 0 to avoid a zero-size allocation.
fn (PtrList) grow[A: allocators.GeneralAllocator](ac: A, list: mut self, new_cap: usize) result[void, ListAllocError] = {
    pre {
        new_cap_positive : new_cap > 0
    }
    val old_buf: ref void = trust @load(list)
    val old_cap: usize = trust @load(@ptradd(list, 16)) as usize
    val old_size: usize = old_cap * ELEMENT_SIZE
    val new_size: usize = new_cap * ELEMENT_SIZE
    val new_buf_opt = realloc_in[A](ac, old_buf, new_size)
    val new_buf: mut ref void = none
    match new_buf_opt {
        some raw => { new_buf = raw }
        none => { return err ListAllocError.OutOfMemory }
    }
    if new_size > old_size {
        trust @memset(@ptradd(new_buf, old_size), 0, new_size - old_size)
    }
    trust @store(list, new_buf)
    trust @store(@ptradd(list, 16), new_cap)
    post {
        new_cap_positive : new_cap > 0
    }
    return ok ()
}

/// Append a value to the end of the list.
/// Requires the list pointer to be non-null (non-zero).
pub fn (PtrList) push[A: allocators.GeneralAllocator](ac: A, list: mut self, value: usize) result[void, ListAllocError] = trust {
    val len: usize = @load(@ptradd(list, 8)) as usize
    val cap: usize = @load(@ptradd(list, 16)) as usize
    if (len >= cap) {
        val new_cap: usize = cap * 2 + 1
        PtrList.grow[A](ac, list, new_cap)?
    }
    val buf: ref void = @load(list)
    val slot: ref void = @ptradd(buf, len * ELEMENT_SIZE)
    @store(slot, value)
    @store(@ptradd(list, 8), len + 1)
    return ok ()
}

/// Get the element at index i.
/// Requires i < len to guarantee in-bounds access.
/// Returns none if out of bounds (defensive, belt-and-suspenders).
pub fn (PtrList) get(list: self, i: usize) option[usize] = {
    pre {
        in_bounds : i < trust @load(@ptradd(list, 8))
    }
    val len: usize = trust @load(@ptradd(list, 8)) as usize
    if (i >= len) {
        return none
    }
    val buf: ref void = trust @load(list)
    val slot: ref void = trust @ptradd(buf, i * ELEMENT_SIZE)
    post {
        in_bounds : i < len
    }
    return some (trust @load(slot) as usize)
}

/// Set the element at index i.
/// Requires i < len to guarantee in-bounds write.
/// Returns 1 on success, 0 if out of bounds (defensive).
pub fn (PtrList) set(list: self, i: usize, value: usize) usize = {
    pre {
        in_bounds : i < trust @load(@ptradd(list, 8))
    }
    val len: usize = trust @load(@ptradd(list, 8)) as usize
    if (i >= len) {
        return 0
    }
    val buf: ref void = trust @load(list)
    val slot: ref void = trust @ptradd(buf, i * ELEMENT_SIZE)
    trust @store(slot, value)
    post {
        in_bounds : i < len
    }
    return 1
}

/// Pop the last element.
/// Requires the list to be non-empty.
pub fn (PtrList) pop(list: self) option[usize] = {
    pre {
        not_empty : trust @load(@ptradd(list, 8)) > 0
    }
    val len: usize = trust @load(@ptradd(list, 8)) as usize
    if (len == 0) {
        return none
    }
    val new_len: usize = len - 1
    val buf: ref void = trust @load(list)
    val slot: ref void = trust @ptradd(buf, new_len * ELEMENT_SIZE)
    val value: usize = trust @load(slot) as usize
    trust @store(@ptradd(list, 8), new_len)
    post {
        not_empty : len > 0
    }
    return some value
}

/// A hash map using open-addressing with linear probing.
///
/// Keys and values are stored as untyped usize slots (8 bytes each).
/// The caller is responsible for casting to/from the appropriate pointer types.
///
/// Layout of a Map header (4 fields × 8 bytes each):
///   offset 0:  buckets — ref void, pointer to heap bucket array
///   offset 8:  len     — usize, number of live entries
///   offset 16: cap     — usize, number of bucket slots
///   offset 24: hash_fn — ref void, pointer to hash function (usize -> usize)
///
/// Each bucket is 24 bytes:
///   offset 0:  state — usize  (0 = empty, 1 = live, 2 = tombstone)
///   offset 8:  key   — usize
///   offset 16: value — usize

val MAP_BUCKET_SIZE: usize = 24
val MAP_BUCKET_EMPTY: usize = 0
val MAP_BUCKET_LIVE: usize = 1
val MAP_BUCKET_DEAD: usize = 2
val MAP_HEADER_SIZE: usize = 32

pub type Map = {
    header: ref void
}

pub type StringMap = {
    header: ref void
}

/// Default identity hash for integer keys.
pub fn hash_identity(key: usize) usize = {
    return key
}

/// Allocate a new Map with the given initial capacity and hash function.
/// initial_cap must be > 0.
pub fn (Map) new[A: allocators.GeneralAllocator](ac: A, initial_cap: usize, hash_fn: ref void) self = trust {
    pre {
        cap_positive: initial_cap > 0
    }
    val header_opt = alloc_in[A](ac, MAP_HEADER_SIZE)
    match header_opt {
        some header => {
            val buckets_opt = alloc_in[A](ac, initial_cap * MAP_BUCKET_SIZE)
            match buckets_opt {
                some buckets => {
                    @memset(buckets, 0, initial_cap * MAP_BUCKET_SIZE)
                    @store(header, buckets)
                    @store(@ptradd(header, 8), 0)
                    @store(@ptradd(header, 16), initial_cap)
                    @store(@ptradd(header, 24), hash_fn)
                    return { header: header }
                }
                none => {
                    free_in[A](ac, header)
                    return { header: none }
                }
            }
        }
        none => {
            return { header: none }
        }
    }
}

/// Free the map and its backing bucket array.
pub fn (Map) free[A: allocators.GeneralAllocator](ac: A, map: self) void = trust {
    val header: ref void = map.header
    if header != none {
        val buckets: ref void = @load(header)
        free_in[A](ac, buckets)
        free_in[A](ac, header)
    }
}

/// Return the number of live entries.
pub fn (Map) len(map: self) usize = {
    return trust @load(@ptradd(map.header, 8)) as usize
}

/// Return the current bucket capacity.
pub fn (Map) cap(map: self) usize = trust {
    return @load(@ptradd(map.header, 16)) as usize
}

/// Internal: grow the map to new_cap buckets and rehash all live entries.
fn (Map) grow[A: allocators.GeneralAllocator](ac: A, map: mut self, new_cap: usize) void = trust {
    pre {
        new_cap_positive: new_cap > 0
    }
    val header: ref void = map.header
    val old_buckets: ref void = @load(header)
    val old_cap: usize = @load(@ptradd(header, 16)) as usize
    val new_buckets_opt = alloc_in[A](ac, new_cap * MAP_BUCKET_SIZE)
    match new_buckets_opt {
        some new_buckets => {
            @memset(new_buckets, 0, new_cap * MAP_BUCKET_SIZE)

            @store(header, new_buckets)
            @store(@ptradd(header, 8), 0)
            @store(@ptradd(header, 16), new_cap)

            for (i = 0; i < old_cap; i++) {
                val slot: ref void = @ptradd(old_buckets, i * MAP_BUCKET_SIZE)
                val state: usize = @load(slot) as usize
                if (state == MAP_BUCKET_LIVE) {
                    val k: usize = @load(@ptradd(slot, 8)) as usize
                    val v: usize = @load(@ptradd(slot, 16)) as usize
                    Map.set[A](ac, map, k, v)
                }
            }

            free_in[A](ac, old_buckets)
        }
        none => {}
    }
}

/// Insert or update a key-value pair.
/// Grows the map (2x + 1) when load factor exceeds 70%.
pub fn (Map) set[A: allocators.GeneralAllocator](ac: A, map: mut self, key: usize, value: usize) void = trust {
    val header: ref void = map.header
    val len: usize = @load(@ptradd(header, 8)) as usize
    val cap: usize = @load(@ptradd(header, 16)) as usize

    if (len * 10 >= cap * 7) {
        val new_cap: usize = cap * 2 + 1
        Map.grow[A](ac, map, new_cap)
    }

    val cur_cap: usize = @load(@ptradd(header, 16)) as usize
    val buckets: ref void = @load(header)
    val hash_fn: ref void = @load(@ptradd(header, 24))
    val h: usize = @call(hash_fn, key)
    val start: usize = h - (h / cur_cap) * cur_cap

    for (i = 0; i < cur_cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cur_cap) * cur_cap
        val slot: ref void = @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = @load(slot) as usize

        if (state == MAP_BUCKET_EMPTY) {
            @store(slot, MAP_BUCKET_LIVE)
            @store(@ptradd(slot, 8), key)
            @store(@ptradd(slot, 16), value)
            @store(@ptradd(header, 8), @load(@ptradd(header, 8)) + 1)
            return
        }

        if (state == MAP_BUCKET_LIVE) {
            val existing_key: usize = @load(@ptradd(slot, 8)) as usize
            if (existing_key == key) {
                @store(@ptradd(slot, 16), value)
                return
            }
        }
    }
}

/// Look up a key. Returns some(value) if found, none otherwise.
pub fn (Map) get(map: self, key: usize) option[usize] = {
    pre {
        map_not_null: map.header != none
    }
    val header: ref void = map.header
    val cap: usize = trust @load(@ptradd(header, 16)) as usize
    val buckets: ref void = trust @load(header)
    val hash_fn: ref void = trust @load(@ptradd(header, 24))
    val h: usize = @call(hash_fn, key)
    val start: usize = h - (h / cap) * cap

    for (i = 0; i < cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cap) * cap
        val slot: ref void = trust @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = trust @load(slot) as usize

        if (state == MAP_BUCKET_EMPTY) {
            return none
        }

        if (state == MAP_BUCKET_LIVE) {
            val existing_key: usize = trust @load(@ptradd(slot, 8)) as usize
            if (existing_key == key) {
                return some (trust @load(@ptradd(slot, 16)) as usize)
            }
        }
    }

    post {
        map_not_null: map.header != none
    }

    return none
}

/// Remove a key. Returns 1 if the key was present, 0 otherwise.
pub fn (Map) delete(map: self, key: usize) usize = trust {
    val header: ref void = map.header
    val cap: usize = @load(@ptradd(header, 16)) as usize
    val buckets: ref void = @load(header)
    val hash_fn: ref void = @load(@ptradd(header, 24))
    val h: usize = @call(hash_fn, key)
    val start: usize = h - (h / cap) * cap

    for (i = 0; i < cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cap) * cap
        val slot: ref void = @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = @load(slot) as usize

        if (state == MAP_BUCKET_EMPTY) {
            return 0
        }

        if (state == MAP_BUCKET_LIVE) {
            val existing_key: usize = @load(@ptradd(slot, 8)) as usize
            if (existing_key == key) {
                @store(slot, MAP_BUCKET_DEAD)
                @store(@ptradd(header, 8), @load(@ptradd(header, 8)) - 1)
                return 1
            }
        }
    }

    return 0
}

/// Check if a key exists in the map.
pub fn (Map) contains(map: self, key: usize) bool = {
    pre {
        map_not_null: map.header != none
    }
    val result = Map.get(map, key)
    val found: mut usize = 0
    match result {
        some _ => { found = 1 }
        none   => { found = 0 }
    }
    post {
        map_not_null: map.header != none
    }
    return found != 0
}

/// Clear all entries (reset to empty, keep allocation).
pub fn (Map) clear(map: self) void = {
    val header: ref void = map.header
    val cap: usize = trust @load(@ptradd(header, 16)) as usize
    val buckets: ref void = trust @load(header)
    trust @memset(buckets, 0, cap * MAP_BUCKET_SIZE)
    trust @store(@ptradd(header, 8), 0)
}

test {
    @puts("STARTING 2")
    val heap: allocators.HeapAllocator = @zeroed
    val m: mut Map = trust Map.new[allocators.HeapAllocator](heap, 8 as usize, @addr(hash_identity))

    assert Map.len(m) == 0

    trust Map.set[allocators.HeapAllocator](heap, m, 1 as usize, 100 as usize)
    trust Map.set[allocators.HeapAllocator](heap, m, 2 as usize, 200 as usize)
    trust Map.set[allocators.HeapAllocator](heap, m, 3 as usize, 300 as usize)

    assert Map.len(m) == 3

    match Map.get(m, 1 as usize) {
        some v => { assert(v == 100) }
        none   => { assert(false) }
    }
    match Map.get(m, 2 as usize) {
        some v => { assert(v == 200) }
        none   => { assert(false) }
    }
    match Map.get(m, 3 as usize) {
        some v => { assert(v == 300) }
        none   => { assert(false) }
    }
    match Map.get(m, 99 as usize) {
        some _ => { assert(false) }
        none   => {}
    }

    trust Map.set[allocators.HeapAllocator](heap, m, 1 as usize, 999 as usize)
    match Map.get(m, 1 as usize) {
        some v => { assert(v == 999) }
        none   => { assert(false) }
    }

    assert Map.len(m) == 3
    assert Map.contains(m, 2 as usize)
    assert !Map.contains(m, 42 as usize)

    val deleted = trust Map.delete(m, 2 as usize)
    assert deleted == 1
    assert Map.len(m) == 2
    assert !Map.contains(m, 2 as usize)

    val not_deleted = trust Map.delete(m, 2 as usize)
    assert not_deleted == 0

    Map.clear(m)
    assert Map.len(m) == 0
    assert !Map.contains(m, 1 as usize)

    val big: mut Map = trust Map.new[allocators.HeapAllocator](heap, 4 as usize, @addr(hash_identity))

    for (i = 0; i < 20; i++) {
        trust Map.set[allocators.HeapAllocator](heap, big, i, i * 10)
    }
    assert Map.len(big) == 20
    for (i = 0; i < 20; i++) {
        match Map.get(big, i) {
            some v => { assert(v == i * 10) }
            none   => { assert(false) }
        }
    }

    trust Map.free[allocators.HeapAllocator](heap, m)
    trust Map.free[allocators.HeapAllocator](heap, big)

    stdio.puts("map tests passed")
}

test {
    val heap: allocators.HeapAllocator = @zeroed

    val list: mut ref void = trust PtrList.new[allocators.HeapAllocator](heap, 2 as usize)?
    defer {
        trust PtrList.free[allocators.HeapAllocator](heap, list)
    }

    assert(PtrList.len(list) == 0)
    assert(PtrList.cap(list) == 2)

    trust PtrList.push[allocators.HeapAllocator](heap, list, 42 as usize)?
    trust PtrList.push[allocators.HeapAllocator](heap, list, 84 as usize)?

    assert(PtrList.len(list) == 2)
    assert(PtrList.get(list, 0 as usize) == some 42)
    assert(PtrList.get(list, 1 as usize) == some 84)

    trust PtrList.push[allocators.HeapAllocator](heap, list, 126 as usize)?

    assert(PtrList.len(list) == 3)
    assert(PtrList.cap(list) >= 3)
    assert(PtrList.get(list, 2 as usize) == some 126)
    assert(PtrList.set(list, 1 as usize, 99 as usize) == 1)
    assert(PtrList.get(list, 1 as usize) == some 99)
    assert(PtrList.pop(list) == some 126)
    assert(PtrList.len(list) == 2)
    assert(PtrList.pop(list) == some 99)
    assert(PtrList.pop(list) == some 42)

    val list2: mut ref void = trust PtrList.new[allocators.HeapAllocator](heap, 1 as usize)?
    defer {
        trust PtrList.free[allocators.HeapAllocator](heap, list2)
    }

    trust PtrList.push[allocators.HeapAllocator](heap, list2, 10 as usize)?
    assert(PtrList.get(list2, 0 as usize) == some 10)

    val list3: mut ref void = trust PtrList.new[allocators.HeapAllocator](heap, 1 as usize)?
    defer {
        trust PtrList.free[allocators.HeapAllocator](heap, list3)
    }

    trust PtrList.push[allocators.HeapAllocator](heap, list3, 5 as usize)?

    stdio.puts("list tests passed")
}

/// A hash map with ref u8 (C string) keys and usize values.
///
/// Built on top of Map using a djb2 string hash.

/// Casts the string pointer to usize for use as a Map key seed, then hashes
/// the actual bytes so distinct strings with the same address never collide.
pub fn hash_string(key: ref u8) usize = {
    pre {
        key != none
    }
    val s: ref u8 = key as ref u8
    val h: mut usize = 5381
    val i: mut i64 = 0
    for {
        val c: u8 = trust @load8(@ptradd(s, i))
        if (c == 0) { break }
        h = (h * 33) - ((h * 33) / 4294967296) * 4294967296
        h = h - (h / 4294967296) * 4294967296
        val cu: usize = c as usize
        h = h - ((h - cu) / 4294967296) * 4294967296
        h = h + cu
        i++
    }
    return h
}

/// Compare two null-terminated C strings for equality.
fn str_eq(a: ref u8, b: ref u8) bool = trust {
    val i: mut i64 = 0
    for {
        val ca: u8 = @load8(@ptradd(a, i))
        val cb: u8 = @load8(@ptradd(b, i))
        if (ca != cb) { return false }
        if (ca == 0)  { return true  }
        i++
    }
    return true
}

/// Allocate a new StringMap with the given initial capacity.
pub fn (StringMap) new[A: allocators.GeneralAllocator](ac: A, initial_cap: usize) self = trust {
    val base: Map = Map.new[A](ac, initial_cap, @addr(hash_string))
    return { header: base.header }
}

/// Insert or update a string key with a usize value.
///
/// The key is copied onto the heap; the copy is owned by the map.
pub fn (StringMap) set[A: allocators.GeneralAllocator](ac: A, map: self, key: ref u8, value: usize) void = trust {
    val header: ref void = map.header
    val cap: usize = @load(@ptradd(header, 16)) as usize
    val buckets: ref void = @load(header)
    val hash_fn: ref void = @load(@ptradd(header, 24))
    val key_holder: mut usize = 0
    @store(@addr(key_holder) as ref void, key)
    val h: usize = @call(hash_fn, key_holder)
    val start: usize = h - (h / cap) * cap

    for (i = 0; i < cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cap) * cap
        val slot: ref void = @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = @load(slot) as usize
        if (state == MAP_BUCKET_EMPTY) {
            break
        }
        if (state == MAP_BUCKET_LIVE) {
            val existing_key: ref u8 = @load(@ptradd(slot, 8)) as ref u8
            if (str_eq(existing_key, key)) {
                @store(@ptradd(slot, 16), value)
                return
            }
        }
    }
    val copy_opt = copy_cstr_in[A](ac, key)
    match copy_opt {
        some copy => {
            val copy_holder: mut usize = 0
            @store(@addr(copy_holder) as ref void, copy)
            val base: mut Map = { header: header }
            Map.set[A](ac, base, copy_holder, value)
        }
        none => {}
    }
}

/// Look up a string key. Returns some(value) or none.
pub fn (StringMap) get(map: self, key: ref u8) option[usize] = {
    val header: ref void = map.header
    val cap: usize = trust @load(@ptradd(header, 16)) as usize
    val buckets: ref void = trust @load(header)
    val hash_fn: ref void = trust @load(@ptradd(header, 24))
    val key_holder: mut usize = 0
    trust @store(@addr(key_holder) as ref void, key)
    val h: usize = @call(hash_fn, key_holder)
    val start: usize = h - (h / cap) * cap

    for (i = 0; i < cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cap) * cap
        val slot: ref void = trust @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = trust @load(slot) as usize
        if (state == MAP_BUCKET_EMPTY) {
            return none
        }
        if (state == MAP_BUCKET_LIVE) {
            val existing_key: ref u8 = trust @load(@ptradd(slot, 8)) as ref u8
            if (trust str_eq(existing_key, key)) {
                return some (trust @load(@ptradd(slot, 16)) as usize)
            }
        }
    }

    return none
}

/// Check if a string key exists.
pub fn (StringMap) contains(map: self, key: ref u8) bool = {
    val result = StringMap.get(map, key)
    match result {
        some _ => { return true  }
        none   => { return false }
    }
}

/// Remove a string key. Returns 1 if found and removed, 0 otherwise.
pub fn (StringMap) delete[A: allocators.GeneralAllocator](ac: A, map: self, key: ref u8) usize = trust {
    val header: ref void = map.header
    val cap: usize = @load(@ptradd(header, 16)) as usize
    val buckets: ref void = @load(header)
    val hash_fn: ref void = @load(@ptradd(header, 24))
    val key_holder: mut usize = 0
    @store(@addr(key_holder) as ref void, key)
    val h: usize = @call(hash_fn, key_holder)
    val start: usize = h - (h / cap) * cap

    for (i = 0; i < cap; i++) {
        val idx: usize = (start + i) - ((start + i) / cap) * cap
        val slot: ref void = @ptradd(buckets, idx * MAP_BUCKET_SIZE)
        val state: usize = @load(slot) as usize
        if (state == MAP_BUCKET_EMPTY) {
            return 0
        }
        if (state == MAP_BUCKET_LIVE) {
            val existing_key: ref u8 = @load(@ptradd(slot, 8)) as ref u8
            if (str_eq(existing_key, key)) {
                free_in[A](ac, existing_key as ref void)
                @store(slot, MAP_BUCKET_DEAD)
                @store(@ptradd(header, 8), @load(@ptradd(header, 8)) - 1)
                return 1
            }
        }
    }

    return 0
}

/// Return the number of live entries.
pub fn (StringMap) len(map: self) usize = {
    val base: Map = { header: map.header }
    return Map.len(base)
}

/// Free all heap-copied keys, then free the map itself.
pub fn (StringMap) free[A: allocators.GeneralAllocator](ac: A, map: self) void = trust {
    val header: ref void = map.header
    val cap: usize = @load(@ptradd(header, 16)) as usize
    val buckets: ref void = @load(header)
    for (i = 0; i < cap; i++) {
        val slot: ref void = @ptradd(buckets, i * MAP_BUCKET_SIZE)
        val state: usize = @load(slot) as usize
        if (state == MAP_BUCKET_LIVE) {
            val k: ref u8 = @load(@ptradd(slot, 8)) as ref u8
            free_in[A](ac, k as ref void)
        }
    }
    free_in[A](ac, buckets)
    free_in[A](ac, header)
}

test {
    @puts("sm: new")
    val heap: allocators.HeapAllocator = @zeroed
    val m: StringMap = trust StringMap.new[allocators.HeapAllocator](heap, 8 as usize)

    @puts("sm: len==0")
    assert StringMap.len(m) == 0

    @puts("sm: set hello")
    trust StringMap.set[allocators.HeapAllocator](heap, m, "hello", 1 as usize)
    @puts("sm: set world")
    trust StringMap.set[allocators.HeapAllocator](heap, m, "world", 2 as usize)
    @puts("sm: set foo")
    trust StringMap.set[allocators.HeapAllocator](heap, m, "foo",   3 as usize)

    @puts("sm: len==3")
    assert StringMap.len(m) == 3
    @puts("sm: contains hello")
    assert StringMap.contains(m, "hello")
    @puts("sm: contains world")
    assert StringMap.contains(m, "world")
    @puts("sm: !contains bar")
    assert !StringMap.contains(m, "bar")

    @puts("sm: get hello")
    match StringMap.get(m, "hello") {
        some v => { assert(v == 1) }
        none   => { assert(false) }
    }
    @puts("sm: get world")
    match StringMap.get(m, "world") {
        some v => { assert(v == 2) }
        none   => { assert(false) }
    }
    @puts("sm: get missing")
    match StringMap.get(m, "missing") {
        some _ => { assert(false) }
        none   => {}
    }

    @puts("sm: update hello=99")
    trust StringMap.set[allocators.HeapAllocator](heap, m, "hello", 99 as usize)
    @puts("sm: get hello==99")
    match StringMap.get(m, "hello") {
        some v => { assert(v == 99) }
        none   => { assert(false) }
    }
    @puts("sm: len==3 again")
    assert StringMap.len(m) == 3

    @puts("sm: delete world")
    val deleted = trust StringMap.delete[allocators.HeapAllocator](heap, m, "world")
    @puts("sm: assert deleted==1")
    assert deleted == 1
    @puts("sm: len==2")
    assert StringMap.len(m) == 2
    @puts("sm: !contains world")
    assert !StringMap.contains(m, "world")

    @puts("sm: delete world again")
    val not_deleted = trust StringMap.delete[allocators.HeapAllocator](heap, m, "world")
    @puts("sm: assert not_deleted==0")
    assert not_deleted == 0

    @puts("sm: free")
    trust StringMap.free[allocators.HeapAllocator](heap, m)

    stdio.puts("string map tests passed")
}

/// An insertion-order preserving map with ref u8 keys and usize values.
///
/// Implemented as a StringMap for O(1) lookup plus a PtrList of keys
/// to track insertion order.
type IndexMap = {
    inner_header: ref void
    keys: ref void
}
type RawIndexMap = {}

val IMAP_HEADER_SIZE: usize = 16

/// Allocate a new IndexMap with the given initial capacity.
pub fn (IndexMap) new[A: allocators.GeneralAllocator](ac: A, initial_cap: usize) self = trust {
    val inner: StringMap = StringMap.new[A](ac, initial_cap)
    val keys: mut ref void = none
    val keys_res = PtrList.new[A](ac, initial_cap)
    match keys_res {
        ok k => { keys = k }
        err _ => {
            val fallback = PtrList.new[A](ac, 1 as usize)
            match fallback {
                ok k => { keys = k }
                err _ => {}
            }
        }
    }
    if inner.header == none || keys == none {
        if keys != none { PtrList.free[A](ac, keys) }
        if inner.header != none { StringMap.free[A](ac, inner) }
        return { inner_header: none, keys: none }
    }
    return { inner_header: inner.header, keys: keys }
}

/// Insert or update a key-value pair, preserving insertion order for new keys.
pub fn (IndexMap) set[A: allocators.GeneralAllocator](ac: A, map: self, key: ref u8, value: usize) void = trust {
    val inner: StringMap = { header: map.inner_header }
    val keys:  mut ref void = map.keys
    val already = StringMap.contains(inner, key)
    StringMap.set[A](ac, inner, key, value)
    if !already {
        if !StringMap.contains(inner, key) {
            return
        }
        val copy_opt = copy_cstr_in[A](ac, key)
        match copy_opt {
            some copy => {
                val copy_holder: mut usize = 0
                @store(@addr(copy_holder) as ref void, copy)
                val push_res = PtrList.push[A](ac, keys, copy_holder)
                match push_res {
                    ok _  => {}
                    err _ => { free_in[A](ac, copy as ref void) }
                }
            }
            none => {}
        }
    }
}

/// Look up a key. Returns some(value) or none.
pub fn (IndexMap) get(map: self, key: ref u8) option[usize] = trust {
    return StringMap.get({ header: map.inner_header }, key)
}

/// Check if a key exists.
pub fn (IndexMap) contains(map: self, key: ref u8) bool = {
    return StringMap.contains({ header: map.inner_header }, key)
}

/// Remove a key. Returns 1 if found, 0 otherwise.
/// Note: removal marks the key as a tombstone in the ordered list (sets to 0).
pub fn (IndexMap) delete[A: allocators.GeneralAllocator](ac: A, map: self, key: ref u8) usize = trust {
    val inner: StringMap = { header: map.inner_header }
    val keys:  ref void = map.keys
    val removed = StringMap.delete[A](ac, inner, key)
    if removed == 1 {
        val n: usize = PtrList.len(keys)
        for (i = 0; i < n; i++) {
            match PtrList.get(keys, i) {
                none   => {}
                some p => {
                    if p != 0 {
                        val k: ref u8 = p as ref u8
                        if str_eq(k, key) {
                            free_in[A](ac, k as ref void)
                            PtrList.set(keys, i, 0 as usize)
                            break
                        }
                    }
                }
            }
        }
    }
    return removed
}

/// Return the number of live entries.
pub fn (IndexMap) len(map: self) usize = {
    return StringMap.len({ header: map.inner_header })
}

/// Iterate in insertion order. Calls callback(key, value) for each live entry.
pub fn (IndexMap) each(map: self, cb: fn(ref u8, usize) void) void = trust {
    val inner: StringMap = { header: map.inner_header }
    val keys:  ref void = map.keys
    val n: usize = PtrList.len(keys)
    for (i = 0; i < n; i++) {
        match PtrList.get(keys, i) {
            none   => {}
            some p => {
                if p != 0 {
                    val k: ref u8 = p as ref u8
                    match StringMap.get(inner, k) {
                        none   => {}
                        some v => { cb(k, v) }
                    }
                }
            }
        }
    }
}

/// Get the i-th key in insertion order (skipping tombstones).
/// Returns none if out of range.
pub fn (IndexMap) key_at(map: self, i: usize) option[ref u8] = {
    val keys: ref void = map.keys
    val n: usize = PtrList.len(keys)
    val live: mut usize = 0
    for (j = 0; j < n; j++) {
        match PtrList.get(keys, j) {
            none   => {}
            some p => {
                if p != 0 {
                    if live == i { return some (p as ref u8) }
                    live++
                }
            }
        }
    }
    return none
}

/// Free the IndexMap and all owned key copies.
pub fn (IndexMap) free[A: allocators.GeneralAllocator](ac: A, map: self) void = trust {
    val inner: StringMap = { header: map.inner_header }
    val keys:  mut ref void = map.keys
    val n: usize = PtrList.len(keys)
    for (i = 0; i < n; i++) {
        match PtrList.get(keys, i) {
            none   => {}
            some p => { if p != 0 { free_in[A](ac, p as ref void) } }
        }
    }
    PtrList.free[A](ac, keys)
    StringMap.free[A](ac, inner)
}

pub fn (RawIndexMap) new(initial_cap: usize) ref void = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val inner: IndexMap = IndexMap.new[allocators.HeapAllocator](heap, initial_cap)
    if inner.inner_header == none || inner.keys == none {
        return none
    }
    val raw_opt = allocators.HeapAllocator.alloc(heap, IMAP_HEADER_SIZE)
    match raw_opt {
        some raw => {
            @store(raw, inner.inner_header)
            @store(@ptradd(raw, 8), inner.keys)
            return raw
        }
        none => {
            IndexMap.free[allocators.HeapAllocator](heap, inner)
            return none
        }
    }
}

pub fn (RawIndexMap) set(map: ref void, key: ref u8, value: usize) void = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val inner: IndexMap = {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    IndexMap.set[allocators.HeapAllocator](heap, inner, key, value)
}

pub fn (RawIndexMap) get(map: ref void, key: ref u8) option[usize] = trust {
    val inner: IndexMap = {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    return IndexMap.get(inner, key)
}

pub fn (RawIndexMap) contains(map: ref void, key: ref u8) bool = {
    val inner: IndexMap = trust {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    return IndexMap.contains(inner, key)
}

pub fn (RawIndexMap) delete(map: ref void, key: ref u8) usize = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val inner: IndexMap = {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    return IndexMap.delete[allocators.HeapAllocator](heap, inner, key)
}

pub fn (RawIndexMap) len(map: ref void) usize = {
    val inner: IndexMap = trust {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    return IndexMap.len(inner)
}

pub fn (RawIndexMap) each(map: ref void, cb: fn(ref u8, usize) void) void = trust {
    val inner: IndexMap = {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    IndexMap.each(inner, cb)
}

pub fn (RawIndexMap) key_at(map: ref void, i: usize) option[ref u8] = {
    val inner: IndexMap = trust {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    return IndexMap.key_at(inner, i)
}

pub fn (RawIndexMap) free(map: ref void) void = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val inner: IndexMap = {
        inner_header: @load(map) as ref void
        keys: @load(@ptradd(map, 8)) as ref void
    }
    IndexMap.free[allocators.HeapAllocator](heap, inner)
    allocators.HeapAllocator.free(heap, map)
}

test {
    val heap: allocators.HeapAllocator = @zeroed
    val m: IndexMap = trust IndexMap.new[allocators.HeapAllocator](heap, 8 as usize)

    assert IndexMap.len(m) == 0

    trust IndexMap.set[allocators.HeapAllocator](heap, m, "c", 3 as usize)
    trust IndexMap.set[allocators.HeapAllocator](heap, m, "a", 1 as usize)
    trust IndexMap.set[allocators.HeapAllocator](heap, m, "b", 2 as usize)

    assert IndexMap.len(m) == 3
    assert IndexMap.contains(m, "a")
    assert IndexMap.contains(m, "b")
    assert IndexMap.contains(m, "c")
    assert !IndexMap.contains(m, "z")

    match trust IndexMap.get(m, "a") {
        some v => { assert v == 1 }
        none   => { assert false }
    }
    match trust IndexMap.get(m, "b") {
        some v => { assert v == 2 }
        none   => { assert false }
    }
    match trust IndexMap.get(m, "c") {
        some v => { assert v == 3 }
        none   => { assert false }
    }

    trust IndexMap.set[allocators.HeapAllocator](heap, m, "a", 99 as usize)
    match trust IndexMap.get(m, "a") {
        some v => { assert v == 99 }
        none   => { assert false }
    }
    assert IndexMap.len(m) == 3

    match IndexMap.key_at(m, 0 as usize) {
        some k => { assert trust str_eq(k, "c") }
        none   => { assert false }
    }
    match IndexMap.key_at(m, 1 as usize) {
        some k => { assert trust str_eq(k, "a") }
        none   => { assert false }
    }
    match IndexMap.key_at(m, 2 as usize) {
        some k => { assert trust str_eq(k, "b") }
        none   => { assert false }
    }

    val deleted = trust IndexMap.delete[allocators.HeapAllocator](heap, m, "a")
    assert deleted == 1
    assert IndexMap.len(m) == 2
    assert !IndexMap.contains(m, "a")

    match IndexMap.key_at(m, 0 as usize) {
        some k => { assert trust str_eq(k, "c") }
        none   => { assert false }
    }
    match IndexMap.key_at(m, 1 as usize) {
        some k => { assert trust str_eq(k, "b") }
        none   => { assert false }
    }

    trust IndexMap.free[allocators.HeapAllocator](heap, m)

    stdio.puts("index map tests passed")
}

test {
    val m: ref void = trust RawIndexMap.new(8 as usize)
    trust RawIndexMap.set(m, "hello", 11 as usize)
    assert RawIndexMap.contains(m, "hello")
    match trust RawIndexMap.get(m, "hello") {
        some v => { assert v == 11 }
        none => { assert false }
    }
    trust RawIndexMap.free(m)
}
