/// StringView and zero-terminated string helpers.
///
/// Owned String operations live in `std/string/owned`, the StringBuilder
/// in `std/string/builder`, and pointer-only operations in `std/string/cstr`.

val allocators = use("../allocators")
val cstr       = use("std/string/cstr")

extern (C, header) fn strlen(s: ref u8) i64 = "strlen"

extern (C, header) fn strcmp(a: ref u8, b: ref u8) i64 = "strcmp"

/// This is the classic string type.
///
/// An owned heap string: ptr, len, cap - each 8 bytes.
pub type String = {
    ptr: ref u8
    len: i64
    cap: i64
}

/// A borrowed, non-owning view over a byte range.
///
/// A view does not own `ptr` and is not required to be null-terminated.
/// The caller must ensure the underlying bytes outlive the view.
pub type StringView = {
    ptr: ref u8
    len: i64
}

fn alloc_in[T: allocators.Allocator](ac: T, size: i64) ref void = {
    pre {
        size_positive: size > 0
    }
    val out_opt = T.alloc(ac, size as usize)
    match out_opt {
        some out => {
            return out as ref void
        }
        none => {
            return none
        }
    }
}

fn alloc_string_in[T: allocators.Allocator](ac: T, len: i64) String = trust {
    val buf: ref void = alloc_in[T](ac, len + 1)
    if buf == none {
        return none
    }
    @memset(buf, 0, len + 1)

    val s: ref void = alloc_in[T](ac, 24)
    if s == none {
        return none
    }

    @store(s, buf)
    @store(@ptradd(s, 8), len)
    @store(@ptradd(s, 16), len + 1)
    return s as String
}

/// Extract `ref u8` from supported types.
pub fn as_cstr[T](x: T) ref u8 = trust {
    when T is ref u8 {
        return x
    }
    when T is String {
        return x.ptr
    }
    when T is StringView {
        return x.ptr
    }
    when T !in (ref u8, String, StringView) {
        @staticerror("unsupported type for string comparison")
    }
}

/// Build a borrowed view over `len` bytes starting at `ptr`.
pub fn view(ptr: ref u8, len: i64) StringView = {
    val safe_len: mut i64 = len
    if safe_len < 0 {
        safe_len = 0
    }
    if ptr == none {
        safe_len = 0
    }
    return StringView{ptr: ptr, len: safe_len}
}

/// Build a view over an existing null-terminated C str.
fn from_cstr_impl(s: ref u8) StringView = trust {
    if s == none {
        return view(none, 0)
    }
    return view(s, strlen(s))
}

/// Build a view over an existing null-terminated C str.
pub fn from_cstr(s: ref u8) StringView = {
    return trust from_cstr_impl(s)
}

/// Extract a borrowed view from a String, StringView, or raw C str.
pub fn as_view[T](x: T) StringView = trust {
    when T is StringView {
        return x
    }
    when T is String {
        val l: i64 = @load(@ptradd(x as ref void, 8)) as i64
        val p: ref u8 = @load(x as ref void) as ref u8
        return view(p, l)
    }
    when T is ref u8 {
        return from_cstr_impl(x)
    }
    when T !in (StringView, String, ref u8) {
        @staticerror("unsupported type for string view")
    }
}

pub fn len(v: StringView) i64 = {
    return v.len
}

pub fn ptr(v: StringView) ref u8 = {
    return v.ptr
}

pub fn is_empty(v: StringView) bool = {
    return v.len == 0
}

/// Compare two views byte-for-byte using their lengths.
pub fn cmp(a: StringView, b: StringView) i64 = trust {
    val shorter: mut i64 = b.len
    if a.len < b.len {
        shorter = a.len
    }
    val i: mut i64 = 0
    for {
        if i >= shorter {
            break
        }
        val ac: u8 = @load8(@ptradd(a.ptr, i))
        val bc: u8 = @load8(@ptradd(b.ptr, i))
        if ac != bc {
            return ac as i64 - bc as i64
        }
        i++
    }
    if a.len < b.len {
        return -1
    }
    if a.len > b.len {
        return 1
    }
    return 0
}

pub fn eql(a: StringView, b: StringView) bool = trust {
    return cmp(a, b) == 0
}

/// Compare a view with a null-terminated string literal.
pub fn eql_cstr(v: StringView, s: ref u8) bool = trust {
    return eql(v, from_cstr(s))
}

/// Return a sub-view clamped to the bounds of `v`.
pub fn slice(v: StringView, start: i64, end: i64) StringView = trust {
    val real_start: mut i64 = start
    val real_end: mut i64 = end
    if real_start < 0 {
        real_start = 0
    }
    if real_end > v.len {
        real_end = v.len
    }
    if real_end < real_start {
        real_end = real_start
    }
    return view(@ptradd(v.ptr, real_start) as ref u8, real_end - real_start)
}

pub fn starts_with(v: StringView, prefix: StringView) bool = trust {
    if prefix.len > v.len {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= prefix.len {
            break
        }
        if @load8(@ptradd(v.ptr, i)) != @load8(@ptradd(prefix.ptr, i)) {
            return false
        }
        i++
    }
    return true
}

pub fn ends_with(v: StringView, suffix: StringView) bool = trust {
    if suffix.len > v.len {
        return false
    }
    val offset: i64 = v.len - suffix.len
    val i: mut i64 = 0
    for {
        if i >= suffix.len {
            break
        }
        if @load8(@ptradd(v.ptr, offset + i)) != @load8(@ptradd(suffix.ptr, i)) {
            return false
        }
        i++
    }
    return true
}

pub fn find(v: StringView, needle: StringView) option[i64] = trust {
    if needle.len == 0 {
        return some 0
    }
    if needle.len > v.len {
        return none
    }
    val limit: i64 = v.len - needle.len
    val i: mut i64 = 0
    for {
        if i > limit {
            break
        }
        val j: mut i64 = 0
        val matched: mut bool = true
        for {
            if j >= needle.len {
                break
            }
            if @load8(@ptradd(v.ptr, i + j)) != @load8(@ptradd(needle.ptr, j)) {
                matched = false
                break
            }
            j++
        }
        if matched {
            return some i
        }
        i++
    }
    return none
}

pub fn contains(v: StringView, needle: StringView) bool = trust {
    match find(v, needle) {
        some _ => {
            return true
        }
        none => {
            return false
        }
    }
}

pub fn trim_left(v: StringView) StringView = trust {
    val i: mut i64 = 0
    for {
        if i >= v.len {
            break
        }
        val c: u8 = @load8(@ptradd(v.ptr, i))
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        i++
    }
    return slice(v, i, v.len)
}

pub fn trim_right(v: StringView) StringView = trust {
    val end: mut i64 = v.len
    for {
        if end <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(v.ptr, end - 1))
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end--
    }
    return slice(v, 0, end)
}

pub fn trim(v: StringView) StringView = trust {
    return trim_left(trim_right(v))
}

/// An owned, NUL-terminated C str.
///
/// Construct with `zstr_from`; release with `zstr_free` using the
/// same allocator.
pub type ZString = {
    ptr: ref u8
}

/// Allocate a NUL-terminated copy of a view with an explicit allocator.
pub fn zstr_from[T: allocators.GeneralAllocator](
    ac: T,
    v: StringView
) ZString = trust {
    val out_opt = T.alloc(ac, (v.len + 1) as usize)
    match out_opt {
        some out => {
            val buf: ref u8 = out as ref u8
            if v.len > 0 {
                @memcpy(buf as ref void, v.ptr as ref void, v.len as usize)
            }
            @store8(@ptradd(buf, v.len), 0)
            return ZString{ptr: buf}
        }
        none => {
            return ZString{ptr: none}
        }
    }
}

pub fn zstr_from_cstr[T: allocators.GeneralAllocator](
    ac: T,
    s: ref u8
) ZString = trust {
    return zstr_from[T](ac, from_cstr(s))
}

pub fn zstr_ptr(s: ZString) ref u8 = {
    return s.ptr
}

pub fn zstr(s: ZString) StringView = {
    return from_cstr(s.ptr)
}

pub fn zstr_free[T: allocators.GeneralAllocator](ac: T, s: ZString) void = trust {
    if s.ptr != none {
        T.free(ac, s.ptr as ref void)
    }
}

/// Copy a view into a newly allocated owning String.
pub fn to_string[T: allocators.Allocator](ac: T, v: StringView) String = trust {
    val out: String = alloc_string_in[T](ac, v.len)
    if out == none {
        return none
    }
    if v.len > 0 {
        val dst: ref void = @load(out as ref void)
        @memcpy(dst, v.ptr as ref void, v.len as usize)
    }
    return out
}

/// Compare supported string-like values using their lengths.
pub fn compare[A, B](a: A, b: B) i64 = trust {
    return cmp(as_view[A](a), as_view[B](b))
}

/// Returns true when `c` is an ASCII letter (A-Z or a-z).
pub fn is_alpha(c: u8) bool = {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

test "string views borrow without owning" {
    val base: StringView = "hello world"
    assert len(base) == 11
    assert !is_empty(base)
    assert is_empty(view(none, 0))
    assert trust eql(base, "hello world")
    assert trust eql(slice(base, 0, 5), "hello")
    assert trust eql(slice(base, 6, 11), "world")
    assert trust eql(slice(base, 6, 999), "world")
    assert trust eql(slice(base, -4, 5), "hello")
    assert trust eql(slice(base, 5, 5), "")
    assert trust starts_with(base, "hello")
    assert !(trust starts_with(base, "world"))
    assert trust ends_with(base, "world")
    assert !(trust ends_with(base, "hello"))
    assert trust contains(base, "lo wo")
    assert !(trust contains(base, "nope"))
    val found = trust find(base, "world")
    match found {
        some _ => {
            assert true
        }
        none => {
            assert false
        }
    }
    val missing = trust find(base, "nope")
    match missing {
        some _ => {
            assert false
        }
        none => {
            assert true
        }
    }
    assert trust eql(trim("  hi \n"), "hi")
    assert trust cmp("abc", "abd") < 0
    assert trust cmp("abd", "abc") > 0
    assert trust cmp("abc", "abc") == 0
    assert trust eql(as_view[ref u8](c"literal"), "literal")

    val heap: allocators.HeapAllocator = @zeroed
    val cstr_copy: ZString = trust zstr_from[allocators.HeapAllocator](
        heap,
        slice(base, 6, 11)
    )
    assert cstr.eql(zstr_ptr(cstr_copy), c"world")
    trust zstr_free[allocators.HeapAllocator](heap, cstr_copy)
}
