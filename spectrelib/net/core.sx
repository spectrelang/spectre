val allocators = use("../allocators")
val string     = use("../string")
val stdio      = use("../stdio")

when darwin {
    lib "curl"
    lib "nghttp2"
    link "-framework CoreFoundation"
    link "-framework Security"
    link "-framework SystemConfiguration"
    link "-framework CFNetwork"
    link "-lz"
    link "-lldap"
}

when linux {
    lib "curl"
    lib "nghttp2"
    link "-lz"
    link "-lssl"
    link "-lcrypto"
    link "-lbrotlidec"
    link "-lbrotlicommon"
}

when windows {
    link "-lwininet"
    link "-lws2_32"
    extern "wininet.h"
    extern "winsock2.h"
}

when posix {
    extern (C) fn curl_easy_init() ref void = "curl_easy_init"
    extern (C) fn curl_easy_cleanup(handle: ref void) void = "curl_easy_cleanup"
    extern (C) fn curl_easy_setopt(handle: ref void, opt: i32, ...) i64 = "curl_easy_setopt"
    extern (C) fn curl_easy_perform(handle: ref void) i64 = "curl_easy_perform"
    extern (C) fn curl_easy_getinfo(handle: ref void, info: i32, ...) i64 = "curl_easy_getinfo"
    extern (C) fn curl_slist_append(list: ref void, str: ref u8) ref void = "curl_slist_append"
    extern (C) fn curl_slist_free_all(list: ref void) void = "curl_slist_free_all"
    extern (C) fn curl_global_init(flags: i64) i64 = "curl_global_init"
    extern (C) fn curl_global_cleanup() void = "curl_global_cleanup"

    extern (C) fn socket(domain: i32, type_: i32, protocol: i32) i32 = "socket"
    extern (C) fn bind(fd: i32, addr: ref void, addrlen: i32) i32 = "bind"
    extern (C) fn listen(fd: i32, backlog: i32) i32 = "listen"
    extern (C) fn accept(fd: i32, addr: ref void, addrlen: ref void) i32 = "accept"
    extern (C) fn send(fd: i32, buf: ref void, len: i64, flags: i32) i64 = "send"
    extern (C) fn recv(fd: i32, buf: ref void, len: i64, flags: i32) i64 = "recv"
    extern (C) fn close(fd: i32) i32 = "close"
    extern (C) fn htons(port: i32) i32 = "htons"
    extern (C) fn setsockopt(fd: i32, level: i32, opt: i32, vl: ref void, len: i32) i32 = "setsockopt"
    extern (C) fn fcntl(fd: i32, cmd: i32, ...) i32 = "fcntl"
    extern (C) fn poll(fds: ref void, count: usize, timeout: i32) i32 = "poll"
}

when windows {
    extern (C, header) fn InternetOpenA(
        agent: ref u8,
        access: u32,
        proxy: ref u8,
        bypass: ref u8,
        flags: u32
    ) ref void = "InternetOpenA"
    extern (C, header) fn InternetConnectA(
        handle: ref void,
        server: ref u8,
        port: u16,
        user: ref u8,
        password: ref u8,
        service: u32,
        flags: u32,
        context: usize
    ) ref void = "InternetConnectA"
    extern (C, header) fn HttpOpenRequestA(
        handle: ref void,
        verb: ref u8,
        path: ref u8,
        version: ref u8,
        referrer: ref void,
        accept: ref void,
        flags: u32,
        context: usize
    ) ref void = "HttpOpenRequestA"
    extern (C, header) fn HttpSendRequestA(
        handle: ref void,
        headers: ref u8,
        headers_len: u32,
        optional: ref void,
        optional_len: u32
    ) i32 = "HttpSendRequestA"
    extern (C, header) fn HttpQueryInfoA(
        handle: ref void,
        info: u32,
        buf: ref void,
        len: ref u32,
        index: ref u32
    ) i32 = "HttpQueryInfoA"
    extern (C, header) fn InternetReadFile(
        handle: ref void,
        buf: ref void,
        len: u32,
        read: ref u32
    ) i32 = "InternetReadFile"
    extern (C, header) fn InternetCloseHandle(handle: ref void) i32 = "InternetCloseHandle"

    extern (C, header) fn WSAStartup(version: u16, data: ref void) i32 = "WSAStartup"
    extern (C, header) fn WSACleanup() i32 = "WSACleanup"
    extern (C, header) fn win_socket(domain: i32, type_: i32, protocol: i32) u64 = "socket"
    extern (C, header) fn win_bind(fd: u64, addr: ref void, addrlen: i32) i32 = "bind"
    extern (C, header) fn win_listen(fd: u64, backlog: i32) i32 = "listen"
    extern (C, header) fn win_accept(fd: u64, addr: ref void, addrlen: ref void) u64 = "accept"
    extern (C, header) fn win_send(fd: u64, buf: ref void, len: i32, flags: i32) i32 = "send"
    extern (C, header) fn win_recv(fd: u64, buf: ref void, len: i32, flags: i32) i32 = "recv"
    extern (C, header) fn closesocket(fd: u64) i32 = "closesocket"
    extern (C, header) fn win_htons(port: u16) u16 = "htons"
    extern (C, header) fn win_setsockopt(fd: u64, level: i32, opt: i32, vl: ref void, len: i32) i32 = "setsockopt"
    extern (C, header) fn WSAPoll(fds: ref void, count: u32, timeout: i32) i32 = "WSAPoll"
    extern (C, header) fn ioctlsocket(fd: u64, cmd: i32, argp: ref u32) i32 = "ioctlsocket"
}

pub val CURLOPT_URL = 10002
pub val CURLOPT_WRITEFUNCTION = 20011
pub val CURLOPT_WRITEDATA = 10001
pub val CURLOPT_HTTPHEADER = 10023
pub val CURLOPT_POSTFIELDS = 10015
pub val CURLOPT_CUSTOMREQUEST = 10036
pub val CURLINFO_RESPONSE_CODE = 2097154
pub val CURL_GLOBAL_DEFAULT = 3
pub val AF_INET = 2
pub val IPPROTO_TCP = 6

pub val POLL_READ: i32 = 1
pub val POLL_WRITE: i32 = 2
pub val POLL_ERROR: i32 = 4

when linux {
    val O_NONBLOCK: i32 = 2048
}
otherwise {
    val O_NONBLOCK: i32 = 4
}

val F_GETFL: i32 = 3
val F_SETFL: i32 = 4
val FIONBIO: u32 = 0x8004667E

when windows {
    val POLLFD_SIZE: i64 = 16
}
otherwise {
    val POLLFD_SIZE: i64 = 8
}

type Buffer = {
    data: mut ref void
    len: mut i64
    cap: mut i64
    failed: mut bool
}

/// An owned HTTP response.
type Response = {
    body: mut ref u8
    status: mut i64
    len: mut i64
}

type I32Slot = {
    value: mut i32
}

type I64Slot = {
    value: mut i64
}

type WinUrl = {
    secure: mut bool
    host: mut ref u8
    port: mut u16
    path: mut ref u8
}

type WinHeader = {
    next: mut ref void
    value: mut ref u8
}

fn buf_new() ref Buffer = trust {
    val b_raw: ref void = @alloc(32)
    if b_raw == none {
        return none
    }
    val data: ref void = @alloc(256)
    if data == none {
        @free(b_raw)
        return none
    }
    val b: mut ref Buffer = b_raw as mut ref Buffer
    b.data = data
    b.len = 0
    b.cap = 256
    b.failed = false
    return b
}

fn buf_append(buf: mut ref Buffer, data: ref void, total: i64) bool = trust {
    val new_len: i64 = buf.len + total
    if (new_len + 1 > buf.cap) {
        val new_cap: i64 = (new_len + 1) * 2
        val resized: ref void = @realloc(buf.data, new_cap)
        if resized == none {
            buf.failed = true
            return false
        }
        buf.data = resized
        buf.cap = new_cap
    }
    if total > 0 {
        @memcpy(@ptradd(buf.data, buf.len), data, total)
    }
    @store8(@ptradd(buf.data, new_len), 0)
    buf.len = new_len
    return true
}

/// Internal write callback for curl.
/// Signature matches: size_t write_fn(u8 *ptr, size_t size, size_t nmemb, void *userdata)
pub fn curl_write_cb(ptr: ref void, size: i64, nmemb: i64, userdata: ref void) i64 = trust {
    val total: i64 = size * nmemb
    val buf: mut ref Buffer = userdata as mut ref Buffer
    if !buf_append(buf, ptr, total) {
        return 0
    }
    return total
}

/// Allocate a Response from a raw body using the provided allocator.
fn response_new[A: allocators.GeneralAllocator](
    ac: A,
    status: i64,
    body_ptr: ref void,
    body_len: i64
) ref Response = trust {
    val body_copy_opt = allocators.alloc_in[A](ac, (body_len + 1) as usize)
    match body_copy_opt {
        none => {
            return none
        }
        some body_copy => {
            if body_len > 0 {
                @memcpy(body_copy, body_ptr, body_len)
            }
            @store8(@ptradd(body_copy, body_len), 0)

            val resp_opt = allocators.alloc_in[A](ac, 24 as usize)
            match resp_opt {
                none => {
                    allocators.free_in[A](ac, body_copy)
                    return none
                }
                some resp_raw => {
                    val resp: mut ref Response = resp_raw as mut ref Response
                    resp.body = body_copy as ref u8
                    resp.status = status
                    resp.len = body_len
                    return resp
                }
            }
        }
    }
}

/// Perform a curl request, capturing the response body via the write callback.
/// Returns a Response allocated with the provided allocator.
when posix {
    fn do_request[A: allocators.GeneralAllocator](ac: A, handle: ref void) ref Response = trust {
        val buf: ref Buffer = buf_new()
        if buf == none {
            return none
        }

        curl_easy_setopt(handle, CURLOPT_WRITEFUNCTION, @addr(curl_write_cb))
        curl_easy_setopt(handle, CURLOPT_WRITEDATA, buf)
        curl_easy_perform(handle)

        if buf.failed {
            @free(buf.data)
            @free(buf)
            return none
        }

        val sc: mut ref I64Slot = @alloc(8) as mut ref I64Slot
        if sc == none {
            @free(buf.data)
            @free(buf)
            return none
        }
        sc.value = 0
        curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, sc)
        val status: i64 = sc.value
        @free(sc)

        val body_ptr: ref void = buf.data
        val body_len: i64 = buf.len
        @free(buf)

        val resp: ref Response = response_new[A](ac, status, body_ptr, body_len)
        @free(body_ptr)
        return resp
    }
}

fn win_char(s: ref u8, i: i64) u8 = trust {
    return @load8(@ptradd(s, i)) as u8
}

fn win_url_free(url: ref WinUrl) void = trust {
    if url == none {
        return
    }
    if url.host != none {
        @free(url.host)
    }
    if url.path != none {
        @free(url.path)
    }
    @free(url)
}

/// Parse an http:// or https:// URL into the pieces WinINet needs.
fn win_parse_url(url: ref u8) ref WinUrl = trust {
    val len: i64 = string.len_raw(url)
    val scheme_end: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i + 2 >= len {
            break
        }
        if win_char(url, i) == 58 && win_char(url, i + 1) == 47 && win_char(url, i + 2) == 47 {
            scheme_end = i
            break
        }
        i++
    }
    if scheme_end <= 0 {
        return none
    }

    val secure: bool = scheme_end == 5 && win_char(url, 0) == 104 && win_char(url, 1) == 116 && win_char(url, 2) == 116 && win_char(url, 3) == 112 && win_char(url, 4) == 115

    val host_start: i64 = scheme_end + 3
    if host_start >= len {
        return none
    }

    val host_end: mut i64 = len
    val port_start: mut i64 = -1
    val path_start: mut i64 = -1
    i = host_start
    for {
        if i >= len {
            break
        }
        val c: u8 = win_char(url, i)
        if c == 58 {
            if port_start < 0 {
                port_start = i
                host_end = i
            }
        } elif c == 47 || c == 63 || c == 35 {
            if i < host_end {
                host_end = i
            }
            path_start = i
            break
        }
        i++
    }
    if host_end <= host_start {
        return none
    }

    val parsed: mut ref WinUrl = @alloc(@sizeof(WinUrl)) as mut ref WinUrl
    if parsed == none {
        return none
    }
    parsed.secure = secure
    parsed.host = string.substr(url, host_start, host_end - host_start)
    parsed.path = none
    parsed.port = 80 as u16
    if secure {
        parsed.port = 443 as u16
    }

    if port_start >= 0 {
        val port_begin: i64 = port_start + 1
        val port_end: mut i64 = port_begin
        for {
            if port_end >= len {
                break
            }
            val c: u8 = win_char(url, port_end)
            if c < 48 || c > 57 {
                break
            }
            port_end++
        }
        val p: mut u16 = 0 as u16
        val pi: mut i64 = port_begin
        for {
            if pi >= port_end {
                break
            }
            p = (p * 10 as u16) + (win_char(url, pi) - 48) as u16
            pi++
        }
        parsed.port = p
    }

    if path_start >= 0 {
        val path_end: mut i64 = len
        val pi: mut i64 = path_start
        for {
            if pi >= len {
                break
            }
            if win_char(url, pi) == 35 {
                path_end = pi
                break
            }
            pi++
        }
        val raw_path: ref u8 = string.substr(url, path_start, path_end - path_start)
        if win_char(raw_path, 0) == 47 {
            parsed.path = raw_path
        } else {
            parsed.path = string.concat_raw("/", raw_path)
            @free(raw_path)
        }
    } else {
        parsed.path = string.concat_raw("/", "")
    }

    if parsed.host == none || parsed.path == none {
        win_url_free(parsed)
        return none
    }
    return parsed
}

fn win_header_new(value: ref u8) ref void = trust {
    val node: mut ref WinHeader = @alloc(@sizeof(WinHeader)) as mut ref WinHeader
    if node == none {
        return none
    }
    node.next = none
    node.value = value
    return node as ref void
}

fn win_header_append(list: ref void, value: ref u8) ref void = trust {
    if list == none {
        return win_header_new(value)
    }
    val head: ref void = list
    val cur: mut ref WinHeader = list as mut ref WinHeader
    for {
        if cur.next == none {
            break
        }
        cur = cur.next as mut ref WinHeader
    }
    val node: ref void = win_header_new(value)
    if node == none {
        return head
    }
    cur.next = node
    return head
}

fn win_header_free(list: ref void) void = trust {
    val cur: mut ref WinHeader = list as mut ref WinHeader
    for {
        if cur == none {
            break
        }
        val next: ref void = cur.next
        @free(cur)
        cur = next as mut ref WinHeader
    }
}

/// Join our header list into the CRLF-separated block WinINet expects.
fn win_headers_build(list: ref void) ref u8 = trust {
    if list == none {
        return none
    }
    val total: mut i64 = 0
    val cur: mut ref WinHeader = list as mut ref WinHeader
    for {
        if cur == none {
            break
        }
        if cur.value != none {
            total += string.len_raw(cur.value) + 2
        }
        cur = cur.next as mut ref WinHeader
    }
    if total == 0 {
        return none
    }

    val out: ref u8 = @alloc(total + 1) as ref u8
    if out == none {
        return none
    }
    val pos: mut i64 = 0
    cur = list as mut ref WinHeader
    for {
        if cur == none {
            break
        }
        if cur.value != none {
            val vlen: i64 = string.len_raw(cur.value)
            if vlen > 0 {
                @memcpy(@ptradd(out, pos), cur.value, vlen)
                pos += vlen
            }
            @store8(@ptradd(out, pos), 13)
            @store8(@ptradd(out, pos + 1), 10)
            pos += 2
        }
        cur = cur.next as mut ref WinHeader
    }
    @store8(@ptradd(out, pos), 0)
    return out
}

when windows {
    fn win_query_status(handle: ref void) i64 = trust {
        val buf: ref u8 = @alloc(32) as ref u8
        if buf == none {
            return 0
        }
        @store8(buf, 0)
        val buflen: mut u32 = 32 as u32
        val info_index: mut u32 = 0 as u32
        val rc: i32 = HttpQueryInfoA(handle, 19 as u32, buf, @addr(buflen), @addr(info_index))
        val status: mut i64 = 0
        if rc != 0 {
            val n: i64 = buflen as i64
            val i: mut i64 = 0
            for {
                if i >= n {
                    break
                }
                val c: u8 = win_char(buf, i)
                if c < 48 || c > 57 {
                    break
                }
                status = status * 10 + (c - 48) as i64
                i++
            }
        }
        @free(buf)
        return status
    }
}

when windows {
    /// Perform an HTTP request with WinINet. Returns a Response allocated with
    /// the provided allocator.
    fn win_do_request[A: allocators.GeneralAllocator](
        ac: A,
        method: ref u8,
        url: ref u8,
        body: ref u8,
        header_list: ref void
    ) ref Response = trust {
        val parsed: ref WinUrl = win_parse_url(url)
        if parsed == none {
            return none
        }

        val session: ref void = InternetOpenA("spectre-net/1.0", 0 as u32, none, none, 0 as u32)
        if session == none {
            win_url_free(parsed)
            return none
        }

        val conn: ref void = InternetConnectA(
            session,
            parsed.host,
            parsed.port,
            none,
            none,
            3 as u32,
            0 as u32,
            0 as usize
        )
        if conn == none {
            InternetCloseHandle(session)
            win_url_free(parsed)
            return none
        }

        val flags: mut u32 = 0 as u32
        if parsed.secure {
            // INTERNET_FLAG_SECURE
            flags = 8388608 as u32
        }

        val req: ref void = HttpOpenRequestA(conn, method, parsed.path, none, none, none, flags, 0 as usize)
        if req == none {
            InternetCloseHandle(conn)
            InternetCloseHandle(session)
            win_url_free(parsed)
            return none
        }

        val headers: ref u8 = win_headers_build(header_list)
        val headers_len: u32 = 0 as u32
        if headers != none {
            headers_len = string.len_raw(headers) as u32
        }
        val body_len: u32 = 0 as u32
        if body != none {
            body_len = string.len_raw(body) as u32
        }

        val sent: i32 = HttpSendRequestA(req, headers, headers_len, body, body_len)
        if headers != none {
            @free(headers)
        }
        if sent == 0 {
            InternetCloseHandle(req)
            InternetCloseHandle(conn)
            InternetCloseHandle(session)
            win_url_free(parsed)
            return none
        }

        val status: i64 = win_query_status(req)

        val buf: ref Buffer = buf_new()
        if buf == none {
            InternetCloseHandle(req)
            InternetCloseHandle(conn)
            InternetCloseHandle(session)
            win_url_free(parsed)
            return none
        }
        val chunk: ref void = @alloc(8192)
        if chunk == none {
            @free(buf.data)
            @free(buf)
            InternetCloseHandle(req)
            InternetCloseHandle(conn)
            InternetCloseHandle(session)
            win_url_free(parsed)
            return none
        }

        val reading: mut bool = true
        for {
            if !reading {
                break
            }
            val read: mut u32 = 0 as u32
            val rc: i32 = InternetReadFile(req, chunk, 8192 as u32, @addr(read))
            if rc == 0 {
                buf.failed = true
                reading = false
            } elif read == 0 as u32 {
                reading = false
            } else {
                if !buf_append(buf, chunk, read as i64) {
                    reading = false
                }
            }
        }
        @free(chunk)

        InternetCloseHandle(req)
        InternetCloseHandle(conn)
        InternetCloseHandle(session)
        win_url_free(parsed)

        if buf.failed {
            @free(buf.data)
            @free(buf)
            return none
        }

        val body_ptr: ref void = buf.data
        val body_len_out: i64 = buf.len
        @free(buf)
        val resp: ref Response = response_new[A](ac, status, body_ptr, body_len_out)
        @free(body_ptr)
        return resp
    }
}

type Http = {}

type ServerHandle = {
    port: mut i64
    fd: mut i64
}

/// Initialise the HTTP client global state. Call once at program start.
pub fn (Http) init() void = {
    when posix {
        trust curl_global_init(CURL_GLOBAL_DEFAULT)
    }
}

/// Clean up the HTTP client global state. Call once at program end.
pub fn (Http) cleanup() void = trust {
    when posix {
        curl_global_cleanup()
    }
}

/// Perform an HTTP GET request.
/// Returns a Response allocated with the provided allocator; caller must call Http.free_response().
pub fn (Http) get[A: allocators.GeneralAllocator](ac: A, url: ref u8) ref Response = trust {
    when windows {
        return win_do_request[A](ac, "GET", url, none, none)
    }
    when posix {
        val handle: ref void = curl_easy_init()
        if handle == none {
            return none
        }
        curl_easy_setopt(handle, CURLOPT_URL, url)
        val resp: ref Response = do_request[A](ac, handle)
        curl_easy_cleanup(handle)
        return resp
    }
    return none
}

/// Perform an HTTP POST request with a body string.
/// Returns a Response allocated with the provided allocator; caller must call Http.free_response().
pub fn (Http) post_request[A: allocators.GeneralAllocator](
    ac: A,
    url: ref u8,
    body: ref u8,
    content_type: ref u8
) ref Response = trust {
    when windows {
        val headers: mut ref void = none
        if content_type != none {
            headers = win_header_new(content_type)
        }
        val resp: ref Response = win_do_request[A](ac, "POST", url, body, headers)
        if headers != none {
            win_header_free(headers)
        }
        return resp
    }
    when posix {
        val handle: ref void = curl_easy_init()
        if handle == none {
            return none
        }
        val headers: ref void = curl_slist_append(none, content_type)

        curl_easy_setopt(handle, CURLOPT_URL, url)
        curl_easy_setopt(handle, CURLOPT_POSTFIELDS, body)
        curl_easy_setopt(handle, CURLOPT_HTTPHEADER, headers)

        val resp: ref Response = do_request[A](ac, handle)

        curl_slist_free_all(headers)
        curl_easy_cleanup(handle)
        return resp
    }
    return none
}

/// Perform an arbitrary HTTP request (GET, POST, PUT, DELETE, PATCH …).
pub fn (Http) request[A: allocators.GeneralAllocator](
    ac: A,
    method: ref u8,
    url: ref u8,
    body: ref u8,
    headers: ref void
) ref Response = trust {
    when windows {
        return win_do_request[A](ac, method, url, body, headers)
    }
    when posix {
        val handle: ref void = curl_easy_init()
        if handle == none {
            return none
        }

        curl_easy_setopt(handle, CURLOPT_URL, url)
        curl_easy_setopt(handle, CURLOPT_CUSTOMREQUEST, method)

        if (body != none) {
            curl_easy_setopt(handle, CURLOPT_POSTFIELDS, body)
        }
        if (headers != none) {
            curl_easy_setopt(handle, CURLOPT_HTTPHEADER, headers)
        }

        val resp: ref Response = do_request[A](ac, handle)
        curl_easy_cleanup(handle)
        return resp
    }
    return none
}

/// Free a Response returned by Http.get / Http.post / Http.request with the same allocator used to create it.
pub fn (Http) free_response[A: allocators.GeneralAllocator](ac: A, resp: ref Response) void = trust {
    allocators.free_in[A](ac, resp.body)
    allocators.free_in[A](ac, resp)
}

/// Read the HTTP status code from a Response.
pub fn (Http) status(resp: ref Response) i64 = {
    return resp.status
}

/// Read the body pointer from a Response.
pub fn (Http) body(resp: ref Response) ref u8 = {
    return resp.body
}

/// Read the body length from a Response.
pub fn (Http) body_len(resp: ref Response) i64 = {
    return resp.len
}

/// Build a header list from a single "Key: Value" string.
pub fn (Http) make_headers(header: ref u8) ref void = trust {
    when windows {
        return win_header_new(header)
    }
    when posix {
        return curl_slist_append(none, header)
    }
    return none
}

/// Append a header to an existing header list.
pub fn (Http) append_header(list: ref void, header: ref u8) ref void = trust {
    when windows {
        return win_header_append(list, header)
    }
    when posix {
        return curl_slist_append(list, header)
    }
    return list
}

/// Free a header list created with Http.make_headers / Http.append_header.
pub fn (Http) free_headers(list: ref void) void = trust {
    when windows {
        win_header_free(list)
    }
    when posix {
        curl_slist_free_all(list)
    }
}

fn poll_events_to_platform(events: i32) i16 = {
    val out: mut i32 = 0
    when windows {
        if (events & POLL_READ) != 0 {
            out = out | 0x0100
        }
        if (events & POLL_WRITE) != 0 {
            out = out | 0x0010
        }
    }
    when posix {
        if (events & POLL_READ) != 0 {
            out = out | 0x001
        }
        if (events & POLL_WRITE) != 0 {
            out = out | 0x004
        }
    }
    return out as i16
}

fn poll_events_from_platform(events: i32) i32 = {
    val out: mut i32 = 0
    when windows {
        if (events & 0x0100) != 0 || (events & 0x0200) != 0 {
            out = out | POLL_READ
        }
        if (events & 0x0010) != 0 {
            out = out | POLL_WRITE
        }
        if (events & 0x0001) != 0 || (events & 0x0002) != 0 || (events & 0x0004) != 0 {
            out = out | POLL_ERROR
        }
    }
    when posix {
        if (events & 0x001) != 0 {
            out = out | POLL_READ
        }
        if (events & 0x004) != 0 {
            out = out | POLL_WRITE
        }
        if (events & 0x008) != 0 || (events & 0x010) != 0 || (events & 0x020) != 0 {
            out = out | POLL_ERROR
        }
    }
    return out
}

/// Put a socket into non-blocking mode.
pub fn (TcpServer) set_non_blocking(fd: i64) bool = trust {
    when posix {
        val flags: i32 = fcntl(fd as i32, F_GETFL)
        if flags < 0 {
            return false
        }
        return fcntl(fd as i32, F_SETFL, flags | O_NONBLOCK) == 0
    }
    when windows {
        val enabled: mut u32 = 1
        return ioctlsocket(fd as u64, FIONBIO as i32, @addr(enabled)) == 0
    }
    return false
}

/// A poll-based event loop. Register file descriptors with `watch`, call
/// `wait`, then inspect ready descriptors with `fd_at` and `revents_at`.
pub type EventLoop = {
    fds: mut list[i64]
    events: mut list[i64]
    revents: mut list[i64]
}

/// Create a new event loop.
pub fn (EventLoop) new() EventLoop = trust {
    val loop: mut ref EventLoop = @alloc(@sizeof(EventLoop)) as mut ref EventLoop
    loop.fds = []
    loop.events = []
    loop.revents = []
    return loop as EventLoop
}

/// Add or update a descriptor and the events to watch.
pub fn (EventLoop) watch(loop: self, fd: i64, events: i32) void = trust {
    val fds: mut list[i64] = loop.fds
    val watched: mut list[i64] = loop.events
    val ready: mut list[i64] = loop.revents

    val count: i64 = @len(fds) as i64
    val i: mut i64 = 0
    for {
        if i >= count {
            break
        }
        val existing_opt = @get(fds, i as usize)
        if existing_opt is some existing {
            if (existing as i64) == fd {
                @set(watched, i as usize, events as i64)
                @set(ready, i as usize, 0)
                return
            }
        }
        i++
    }
    @append(fds, fd)
    @append(watched, events as i64)
    @append(ready, 0)
}

/// Stop watching a descriptor.
pub fn (EventLoop) unwatch(loop: self, fd: i64) void = trust {
    val fds: mut list[i64] = loop.fds
    val watched: mut list[i64] = loop.events
    val ready: mut list[i64] = loop.revents

    val count: i64 = @len(fds) as i64
    val i: mut i64 = 0
    for {
        if i >= count {
            break
        }
        val existing_opt = @get(fds, i as usize)
        if existing_opt is some existing {
            if (existing as i64) == fd {
                @remove(fds, i as usize)
                @remove(watched, i as usize)
                @remove(ready, i as usize)
                return
            }
        }
        i++
    }
}

/// Return the number of watched descriptors.
pub fn (EventLoop) count(loop: self) i64 = {
    return @len(loop.fds) as i64
}

/// Return the descriptor at `index`.
pub fn (EventLoop) fd_at(loop: self, index: i64) i64 = trust {
    val value_opt = @get(loop.fds, index as usize)
    if value_opt is some value {
        return value as i64
    }
    return -1
}

/// Return the ready events for `index` after the most recent `wait`.
pub fn (EventLoop) revents_at(loop: self, index: i64) i32 = trust {
    val value_opt = @get(loop.revents, index as usize)
    if value_opt is some value {
        return value as i32
    }
    return 0
}

/// Wait for events. `timeout_ms` is in milliseconds; use a negative value to
/// wait indefinitely. Returns the number of ready descriptors, 0 on timeout,
/// or -1 on failure.
pub fn (EventLoop) wait(loop: self, timeout_ms: i32) i32 = trust {
    val fds: list[i64] = loop.fds
    val watched: list[i64] = loop.events
    val ready_events: mut list[i64] = loop.revents

    val count: i64 = @len(fds) as i64
    if count == 0 {
        when posix {
            return poll(none, 0 as usize, timeout_ms)
        }
        when windows {
            return WSAPoll(none, 0 as u32, timeout_ms)
        }
        return 0
    }

    val raw: mut ref void = @alloc((count * POLLFD_SIZE) as usize)
    if raw == none {
        return -1
    }

    val i: mut i64 = 0
    for {
        if i >= count {
            break
        }
        val fd_opt = @get(fds, i as usize)
        val event_opt = @get(watched, i as usize)
        if fd_opt is some fd_raw {
            if event_opt is some event_raw {
                val platform_events: i16 = poll_events_to_platform(event_raw as i32)
                val item_offset: i64 = i * POLLFD_SIZE
                when windows {
                    @store(@ptradd(raw, item_offset), (fd_raw as i64) as u64)
                    @store16(@ptradd(raw, item_offset + 8), platform_events)
                    @store16(@ptradd(raw, item_offset + 10), 0 as i16)
                }
                when posix {
                    @store32(@ptradd(raw, item_offset), (fd_raw as i64) as i32)
                    @store16(@ptradd(raw, item_offset + 4), platform_events)
                    @store16(@ptradd(raw, item_offset + 6), 0 as i16)
                }
            }
        }
        i++
    }

    val ready: mut i32 = 0
    when posix {
        ready = poll(raw, count as usize, timeout_ms)
    }
    when windows {
        ready = WSAPoll(raw, count as u32, timeout_ms)
    }

    if ready > 0 {
        i = 0
        for {
            if i >= count {
                break
            }
            val item_offset: i64 = i * POLLFD_SIZE
            val platform_events: mut i32 = 0
            when windows {
                platform_events = @load16(@ptradd(raw, item_offset + 10)) as i32
            }
            when posix {
                platform_events = @load16(@ptradd(raw, item_offset + 6)) as i32
            }
            @set(ready_events, i as usize, poll_events_from_platform(platform_events) as i64)
            i++
        }
    }

    @free(raw)
    return ready
}

/// Free an event loop and its internal lists.
pub fn (EventLoop) free(loop: mut self) void = trust {
    val fds_buffer: mut ref void = @load(@addr(loop.fds))
    val events_buffer: mut ref void = @load(@addr(loop.events))
    val revents_buffer: mut ref void = @load(@addr(loop.revents))
    if fds_buffer != none {
        @free(fds_buffer)
    }
    if events_buffer != none {
        @free(events_buffer)
    }
    if revents_buffer != none {
        @free(revents_buffer)
    }
    @free(loop)
}

type TcpServer = {}

/// Create a TCP server bound to `port` and start listening.
/// Returns a server handle allocated with the provided allocator; caller must call TcpServer.close().
pub fn (TcpServer) listen[A: allocators.GeneralAllocator](ac: A, port: i32) ref ServerHandle = trust {
    when windows {
        val wsa: ref void = @alloc(512)
        if wsa == none {
            return none
        }
        @memset(wsa, 0, 512)
        val wsa_rc: i32 = WSAStartup(514 as u16, wsa)
        @free(wsa)
        if wsa_rc != 0 {
            return none
        }
    }

    val sock_stream: i32 = 1
    val fd: mut i64 = -1
    when posix {
        fd = socket(AF_INET, sock_stream, IPPROTO_TCP) as i64
    }
    when windows {
        fd = win_socket(AF_INET, sock_stream, IPPROTO_TCP) as i64
    }
    if fd == -1 {
        when windows {
            WSACleanup()
        }
        return none
    }

    val sol_socket: mut i32 = 1
    val so_reuseaddr: mut i32 = 2

    when linux {
        sol_socket = 1
        so_reuseaddr = 2
    }
    when darwin {
        sol_socket = 65535
        so_reuseaddr = 4
    }
    when netbsd {
        sol_socket = 65535
        so_reuseaddr = 4
    }
    when freebsd {
        sol_socket = 65535
        so_reuseaddr = 4
    }
    when openbsd {
        sol_socket = 65535
        so_reuseaddr = 4
    }
    when dragonflybsd {
        sol_socket = 65535
        so_reuseaddr = 4
    }
    when windows {
        sol_socket = 65535
        so_reuseaddr = 4
    }

    val one: mut ref I32Slot = @alloc(4) as mut ref I32Slot
    if one == none {
        when posix {
            close(fd as i32)
        }
        when windows {
            closesocket(fd as u64)
            WSACleanup()
        }
        return none
    }
    one.value = 1
    when posix {
        setsockopt(fd as i32, sol_socket, so_reuseaddr, one, 4 as i32)
    }
    when windows {
        win_setsockopt(fd as u64, sol_socket, so_reuseaddr, one, 4 as i32)
    }
    @free(one)

    val address: mut ref void = @alloc(16)
    if address == none {
        when posix {
            close(fd as i32)
        }
        when windows {
            closesocket(fd as u64)
            WSACleanup()
        }
        return none
    }
    @memset(address, 0, 16)
    @store(address, 2)
    val net_port: mut i32 = 0
    when posix {
        net_port = htons(port)
    }
    when windows {
        net_port = win_htons(port as u16) as i32
    }
    val port_ptr: mut ref void = @ptradd(address, 2)
    @store(port_ptr, net_port)

    val bind_rc: mut i32 = 0
    when posix {
        bind_rc = bind(fd as i32, address, 16 as i32)
    }
    when windows {
        bind_rc = win_bind(fd as u64, address, 16 as i32)
    }
    if bind_rc != 0 {
        @free(address)
        when posix {
            close(fd as i32)
        }
        when windows {
            closesocket(fd as u64)
            WSACleanup()
        }
        return none
    }

    val listen_rc: mut i32 = 0
    when posix {
        listen_rc = listen(fd as i32, 128 as i32)
    }
    when windows {
        listen_rc = win_listen(fd as u64, 128 as i32)
    }
    @free(address)
    if listen_rc != 0 {
        when posix {
            close(fd as i32)
        }
        when windows {
            closesocket(fd as u64)
            WSACleanup()
        }
        return none
    }

    val handle_opt = allocators.alloc_in[A](ac, 16 as usize)
    match handle_opt {
        none => {
            when posix {
                close(fd as i32)
            }
            when windows {
                closesocket(fd as u64)
                WSACleanup()
            }
            return none
        }
        some handle_raw => {
            val handle: mut ref ServerHandle = handle_raw as mut ref ServerHandle
            handle.port = port as i64
            handle.fd = fd
            return handle
        }
    }
}

/// Accept the next incoming connection.
/// Returns the client socket fd, or -1 on error.
pub fn (TcpServer) accept(server: ref ServerHandle) i64 = trust {
    when posix {
        return accept(server.fd as i32, none, none) as i64
    }
    when windows {
        return win_accept(server.fd as u64, none, none) as i64
    }
    return -1
}

/// Send bytes over a client socket fd.
/// Returns the number of bytes sent, or -1 on error.
pub fn (TcpServer) send(client_fd: i64, data: ref u8, len: i64) i64 = trust {
    when posix {
        return send(client_fd as i32, data, len, 0 as i32)
    }
    when windows {
        return win_send(client_fd as u64, data, len as i32, 0 as i32) as i64
    }
    return -1
}

/// Receive bytes from a client socket fd into buf (at most max_len bytes).
/// Returns the number of bytes received, or -1 on error / 0 on close.
pub fn (TcpServer) recv(client_fd: i64, buf: ref u8, max_len: i64) i64 = trust {
    when posix {
        return recv(client_fd as i32, buf, max_len, 0 as i32)
    }
    when windows {
        return win_recv(client_fd as u64, buf, max_len as i32, 0 as i32) as i64
    }
    return -1
}

/// Close a client socket fd.
pub fn (TcpServer) close_client(client_fd: i64) void = trust {
    when posix {
        close(client_fd as i32)
    }
    when windows {
        closesocket(client_fd as u64)
    }
}

/// Shut down and free the server handle.
pub fn (TcpServer) close[A: allocators.GeneralAllocator](ac: A, server: ref ServerHandle) void = trust {
    when posix {
        close(server.fd as i32)
    }
    when windows {
        closesocket(server.fd as u64)
        WSACleanup()
    }
    allocators.free_in[A](ac, server)
}

/// Read the listening port from a server handle.
pub fn (TcpServer) port(server: ref ServerHandle) i64 = {
    return server.port
}

/// Read the listening fd from a server handle.
pub fn (TcpServer) fd(server: ref ServerHandle) i64 = {
    return server.fd
}

test {
    val ac: allocators.HeapAllocator = @zeroed
    Http.init()

    val url: ref u8 = "https://example.com"
    val resp: ref Response = trust Http.get[_](ac, url)
    assert resp != none

    val status: i64 = Http.status(resp)
    val body_ptr: ref u8 = Http.body(resp)

    trust stdio.print("{d} {s}\n", {status, body_ptr})

    val body_len: i64 = Http.body_len(resp)

    trust @print("{d}\n", {body_len})
    assert status > 0
    assert body_ptr != none
    assert body_len >= 0
    trust Http.free_response[_](ac, resp)

    val loop = trust EventLoop.new()
    trust EventLoop.watch(loop, 42 as i64, POLL_READ)
    assert EventLoop.count(loop) == 1
    assert trust EventLoop.fd_at(loop, 0) == 42
    assert trust EventLoop.revents_at(loop, 0) == 0

    trust EventLoop.watch(loop, 42 as i64, POLL_WRITE)
    assert EventLoop.count(loop) == 1

    trust EventLoop.unwatch(loop, 42)
    assert EventLoop.count(loop) == 0

    val free_loop: mut EventLoop = trust EventLoop.new()
    trust EventLoop.watch(free_loop, 43 as i64, POLL_READ)
    trust EventLoop.free(free_loop)

    val server: ref ServerHandle = trust TcpServer.listen[_](ac, 8080 as i32)
    assert server != none
    val listen_fd: i64 = TcpServer.fd(server)
    val listen_port: i64 = TcpServer.port(server)
    assert listen_fd > 0
    assert listen_port == 8080

    trust TcpServer.close[_](ac, server)
    trust Http.cleanup()
}
