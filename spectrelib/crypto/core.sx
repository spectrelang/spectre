val string = use("../string")
val random = use("../crypto/random")
val allocators = use("../allocators")
val fs = use("../fs")

pub enum CryptoError = {
    InvalidHexLength,
    InvalidHexDigit,
    InvalidBase64Length,
    InvalidBase64Char,
    InvalidBase64Padding,
    OutOfMemory,
    FileOpenFailed,
    FileReadFailed
}

extern (C) fn fopen(path: ref u8, mode: ref u8) ref void = "fopen"
extern (C) fn fclose(stream: ref void) i32 = "fclose"
extern (C) fn fread(buf: ref void, size: usize, count: usize, stream: ref void) usize = "fread"
extern (C) fn fseek(stream: ref void, offset: i64, whence: i32) i32 = "fseek"
extern (C) fn ftell(stream: ref void) i64 = "ftell"
extern (C) fn rewind(stream: ref void) void = "rewind"

/// FNV-1a hash.
///
/// This is for pointer-sized keys treated as raw integers.
pub fn hash_fnv(key: usize) usize = trust {
    val FNV_OFFSET: usize = 14695981039346656037
    val FNV_PRIME: usize = 1099511628211
    val h: mut usize = FNV_OFFSET
    val k: mut usize = key
    for (i = 0; i < 8; i++) {
        val byte: usize = k & 255
        h = h ^ byte
        h = h * FNV_PRIME
        k = k >> 8
    }
    return h
}

fn bytes_ptr[T](data: T) ref void = {
    when T is string.String {
        return trust @load(data) as ref void
    }
    when T is ref u8 {
        return data as ref void
    }
    when T !in (string.String, ref u8) {
        @staticerror("invalid type for bytes_ptr")
    }
    return none
}

fn bytes_len[T](data: T) i64 = trust {
    when T is string.String {
        return string.len(data)
    }
    when T is ref u8 {
        return string.len_raw(data)
    }
    when T !in (string.String, ref u8) {
        @staticerror("invalid type for bytes_len")
    }
    return 0
}

fn alloc_in[A: allocators.Allocator](ac: A, len: i64) ref void = {
    pre { len > 0 }
    val buf_opt = A.alloc(ac, len as usize)
    match buf_opt {
        some buf => { return buf }
        none => { return none }
    }
}

fn alloc_heap_string(len: i64) string.String = trust {
    val buf: ref void = @alloc(len + 1)
    @memset(buf, 0, len + 1)
    val out: ref void = @alloc(24)
    @store(out, buf)
    @store(@ptradd(out, 8), len)
    @store(@ptradd(out, 16), len + 1)
    return out as string.String
}

fn alloc_string[A: allocators.Allocator](ac: A, len: i64) string.String = trust {
    val buf: ref void = alloc_in[A](ac, len + 1)
    if buf == none { return none }
    @memset(buf, 0, len + 1)

    val out: ref void = alloc_in[A](ac, 24)
    if out == none { return none }

    @store(out, buf)
    @store(@ptradd(out, 8), len)
    @store(@ptradd(out, 16), len + 1)
    return out as string.String
}

fn copy_string[A: allocators.Allocator](ac: A, src: string.String) string.String = trust {
    if src == none { return none }

    val len: i64 = string.len(src)
    val out: string.String = alloc_string[A](ac, len)
    if out == none { return none }

    val src_ptr: ref void = @load(src) as ref void
    val out_ptr: ref void = @load(out) as ref void
    if len > 0 {
        @memcpy(out_ptr, src_ptr, len)
    }
    return out
}

fn mask_u32(x: u64) u64 = {
    return x & 0xffffffff
}

fn store_u32_slot(buf: ref void, idx: i64, value: u64) void = trust {
    @store(@ptradd(buf, idx * 8), mask_u32(value))
}

fn load_u32_slot(buf: ref void, idx: i64) u64 = trust {
    return (@load(@ptradd(buf, idx * 8)) as u64) & 0xffffffff
}

fn read_be_u32(buf: ref void, offset: i64) u64 = trust {
    val b0: u64 = @load8(@ptradd(buf, offset + 0)) as u64
    val b1: u64 = @load8(@ptradd(buf, offset + 1)) as u64
    val b2: u64 = @load8(@ptradd(buf, offset + 2)) as u64
    val b3: u64 = @load8(@ptradd(buf, offset + 3)) as u64
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn write_be_u32(buf: ref void, offset: i64, value: u64) void = trust {
    val word: u64 = mask_u32(value)
    @store8(@ptradd(buf, offset + 0), ((word >> 24) & 255) as u8)
    @store8(@ptradd(buf, offset + 1), ((word >> 16) & 255) as u8)
    @store8(@ptradd(buf, offset + 2), ((word >> 8) & 255) as u8)
    @store8(@ptradd(buf, offset + 3), (word & 255) as u8)
}

fn rotr32(x: u64, n: i64) u64 = {
    val word: u64 = mask_u32(x)
    return mask_u32((word >> n) | (word << (32 - n)))
}

fn sha256_ch(x: u64, y: u64, z: u64) u64 = {
    return mask_u32((x & y) ^ ((mask_u32(~x)) & z))
}

fn sha256_maj(x: u64, y: u64, z: u64) u64 = {
    return mask_u32((x & y) ^ (x & z) ^ (y & z))
}

fn sha256_big_sigma0(x: u64) u64 = {
    return mask_u32(rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22))
}

fn sha256_big_sigma1(x: u64) u64 = {
    return mask_u32(rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25))
}

fn sha256_small_sigma0(x: u64) u64 = {
    return mask_u32(rotr32(x, 7) ^ rotr32(x, 18) ^ (mask_u32(x) >> 3))
}

fn sha256_small_sigma1(x: u64) u64 = {
    return mask_u32(rotr32(x, 17) ^ rotr32(x, 19) ^ (mask_u32(x) >> 10))
}

fn add32(a: u64, b: u64) u64 = {
    return mask_u32(a + b)
}

fn add32_4(a: u64, b: u64, c: u64, d: u64) u64 = {
    return mask_u32(a + b + c + d)
}

fn add32_5(a: u64, b: u64, c: u64, d: u64, e: u64) u64 = {
    return mask_u32(a + b + c + d + e)
}

fn add32_6(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) u64 = {
    return mask_u32(a + b + c + d + e + f)
}

val SHA256_K: [64]u32 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

/// Compute the SHA-256 digest of a string or byte string.
///
/// Returns a 32-byte String allocated with the provided allocator.
fn sha256_heap[T](data: T) string.String = trust {
    val src_ptr: ref void = bytes_ptr[T](data)
    val src_len: i64 = bytes_len[T](data)

    val bit_len: u64 = (src_len as u64) * 8
    val total_len: i64 = ((src_len + 9 + 63) / 64) * 64
    val padded: ref void = @alloc(total_len)
    @memset(padded, 0, total_len)
    if src_len > 0 {
        @memcpy(padded, src_ptr, src_len)
    }
    @store8(@ptradd(padded, src_len), 128)

    val tail: i64 = total_len - 8
    @store8(@ptradd(padded, tail + 0), ((bit_len >> 56) & 255) as u8)
    @store8(@ptradd(padded, tail + 1), ((bit_len >> 48) & 255) as u8)
    @store8(@ptradd(padded, tail + 2), ((bit_len >> 40) & 255) as u8)
    @store8(@ptradd(padded, tail + 3), ((bit_len >> 32) & 255) as u8)
    @store8(@ptradd(padded, tail + 4), ((bit_len >> 24) & 255) as u8)
    @store8(@ptradd(padded, tail + 5), ((bit_len >> 16) & 255) as u8)
    @store8(@ptradd(padded, tail + 6), ((bit_len >> 8) & 255) as u8)
    @store8(@ptradd(padded, tail + 7), (bit_len & 255) as u8)

    val w: ref void = @alloc(64 * 8)
    val h0: mut u64 = 0x6a09e667
    val h1: mut u64 = 0xbb67ae85
    val h2: mut u64 = 0x3c6ef372
    val h3: mut u64 = 0xa54ff53a
    val h4: mut u64 = 0x510e527f
    val h5: mut u64 = 0x9b05688c
    val h6: mut u64 = 0x1f83d9ab
    val h7: mut u64 = 0x5be0cd19

    val offset: mut i64 = 0
    for {
        if offset >= total_len { break }

        val t0: mut i64 = 0
        for {
            if t0 >= 16 { break }
            store_u32_slot(w, t0, read_be_u32(padded, offset + t0 * 4))
            t0++
        }

        val t1: mut i64 = 16
        for {
            if t1 >= 64 { break }
            val s0: u64 = sha256_small_sigma0(load_u32_slot(w, t1 - 15))
            val s1: u64 = sha256_small_sigma1(load_u32_slot(w, t1 - 2))
            val next: u64 = add32_4(load_u32_slot(w, t1 - 16), s0, load_u32_slot(w, t1 - 7), s1)
            store_u32_slot(w, t1, next)
            t1++
        }

        val a: mut u64 = h0
        val b: mut u64 = h1
        val c: mut u64 = h2
        val d: mut u64 = h3
        val e: mut u64 = h4
        val f: mut u64 = h5
        val g: mut u64 = h6
        val h: mut u64 = h7

        val round: mut i64 = 0
        for {
            if round >= 64 { break }
            val k_opt = @get(SHA256_K, round as usize)
            val k: mut u64 = 0
            match k_opt {
                some v => { k = v as u64 }
                none => {}
            }
            val temp1: u64 = add32_5(h, sha256_big_sigma1(e), sha256_ch(e, f, g), k, load_u32_slot(w, round))
            val temp2: u64 = add32(sha256_big_sigma0(a), sha256_maj(a, b, c))
            h = g
            g = f
            f = e
            e = add32(d, temp1)
            d = c
            c = b
            b = a
            a = add32(temp1, temp2)
            round++
        }

        h0 = add32(h0, a)
        h1 = add32(h1, b)
        h2 = add32(h2, c)
        h3 = add32(h3, d)
        h4 = add32(h4, e)
        h5 = add32(h5, f)
        h6 = add32(h6, g)
        h7 = add32(h7, h)
        offset = offset + 64
    }

    @free(w)
    @free(padded)

    val out: string.String = alloc_heap_string(32)
    val out_ptr: ref void = @load(out) as ref void
    write_be_u32(out_ptr, 0, h0)
    write_be_u32(out_ptr, 4, h1)
    write_be_u32(out_ptr, 8, h2)
    write_be_u32(out_ptr, 12, h3)
    write_be_u32(out_ptr, 16, h4)
    write_be_u32(out_ptr, 20, h5)
    write_be_u32(out_ptr, 24, h6)
    write_be_u32(out_ptr, 28, h7)
    return out
}

/// Compute the SHA-256 digest of a string or byte string.
///
/// Returns a 32-byte String allocated with the provided allocator.
pub fn sha256[A: allocators.Allocator, T](ac: A, data: T) string.String = trust {
    val heap_out: string.String = sha256_heap[T](data)
    if heap_out == none { return none }

    val out: string.String = copy_string[A](ac, heap_out)
    string.string_free(heap_out)
    return out
}

fn hex_char(nibble: u8) u8 = {
    if nibble < 10 { return 48 + nibble }
    return 97 + (nibble - 10)
}

fn hex_value(ch: u8) i64 = {
    if ch >= 48 && ch <= 57 { return (ch - 48) as i64 }
    if ch >= 65 && ch <= 70 { return (ch - 65 + 10) as i64 }
    if ch >= 97 && ch <= 102 { return (ch - 97 + 10) as i64 }
    return -1
}

/// Hex-encode a string or byte string.
///
/// Returns a newly allocated lowercase C string from the provided allocator.
pub fn hex_encode[A: allocators.Allocator, T](ac: A, data: T) ref u8 = trust {
    val src_ptr: ref void = bytes_ptr[T](data)
    val src_len: i64 = bytes_len[T](data)
    val out: ref u8 = alloc_in[A](ac, src_len * 2 + 1) as ref u8
    if out == none { return none }
    val i: mut i64 = 0
    for {
        if i >= src_len { break }
        val byte: u8 = @load8(@ptradd(src_ptr, i)) as u8
        @store8(@ptradd(out as ref void, i * 2 + 0), hex_char((byte >> 4) & 15))
        @store8(@ptradd(out as ref void, i * 2 + 1), hex_char(byte & 15))
        i++
    }
    @store8(@ptradd(out as ref void, src_len * 2), 0)
    return out
}

/// Decode a hexadecimal C string.
///
/// Returns an owned byte String from the provided allocator on success.
pub fn hex_decode[A: allocators.Allocator](ac: A, text: ref u8) result[string.String, CryptoError] = trust {
    val text_len: i64 = string.len_raw(text)
    if ((text_len % 2) != 0) {
        return err CryptoError.InvalidHexLength
    }

    val out_len: i64 = text_len / 2
    val out: string.String = alloc_string[A](ac, out_len)
    if out == none { return err CryptoError.OutOfMemory }
    val out_ptr: ref void = @load(out) as ref void

    val i: mut i64 = 0
    for {
        if i >= out_len { break }
        val hi: i64 = hex_value(@load8(@ptradd(text as ref void, i * 2 + 0)) as u8)
        val lo: i64 = hex_value(@load8(@ptradd(text as ref void, i * 2 + 1)) as u8)
        if hi < 0 || lo < 0 {
            return err CryptoError.InvalidHexDigit
        }
        @store8(@ptradd(out_ptr, i), ((hi << 4) | lo) as u8)
        i++
    }

    return ok out
}

fn b64_char(v: u8) u8 = {
    if v < 26 { return 65 + v }
    if v < 52 { return 97 + (v - 26) }
    if v < 62 { return 48 + (v - 52) }
    if v == 62 { return 43 }
    return 47
}

fn b64_value(ch: u8) i64 = {
    if ch >= 65 && ch <= 90 { return (ch - 65) as i64 }
    if ch >= 97 && ch <= 122 { return (ch - 97 + 26) as i64 }
    if ch >= 48 && ch <= 57 { return (ch - 48 + 52) as i64 }
    if ch == 43 { return 62 }
    if ch == 47 { return 63 }
    return -1
}

/// Base64-encode a string or byte string using the standard alphabet.
///
/// Returns a newly allocated C string with padding from the provided allocator.
pub fn base64_encode[A: allocators.Allocator, T](ac: A, data: T) ref u8 = trust {
    val src_ptr: ref void = bytes_ptr[T](data)
    val src_len: i64 = bytes_len[T](data)
    val out_len: i64 = ((src_len + 2) / 3) * 4
    val out: ref u8 = alloc_in[A](ac, out_len + 1) as ref u8
    if out == none { return none }

    val si: mut i64 = 0
    val oi: mut i64 = 0
    for {
        if si >= src_len { break }

        val rem: i64 = src_len - si
        val b0: u8 = @load8(@ptradd(src_ptr, si)) as u8
        val b1: mut u8 = 0
        val b2: mut u8 = 0
        if rem > 1 { b1 = @load8(@ptradd(src_ptr, si + 1)) as u8 }
        if rem > 2 { b2 = @load8(@ptradd(src_ptr, si + 2)) as u8 }

        @store8(@ptradd(out as ref void, oi + 0), b64_char((b0 >> 2) & 63))
        @store8(@ptradd(out as ref void, oi + 1), b64_char((((b0 & 3) << 4) | (b1 >> 4)) & 63))
        if rem > 1 {
            @store8(@ptradd(out as ref void, oi + 2), b64_char((((b1 & 15) << 2) | (b2 >> 6)) & 63))
        } else {
            @store8(@ptradd(out as ref void, oi + 2), 61)
        }
        if rem > 2 {
            @store8(@ptradd(out as ref void, oi + 3), b64_char(b2 & 63))
        } else {
            @store8(@ptradd(out as ref void, oi + 3), 61)
        }

        si = si + 3
        oi = oi + 4
    }

    @store8(@ptradd(out as ref void, out_len), 0)
    return out
}

/// Decode a standard base64 C string with `=` padding.
///
/// Returns an owned byte String from the provided allocator on success.
pub fn base64_decode[A: allocators.Allocator](ac: A, text: ref u8) result[string.String, CryptoError] = trust {
    val text_len: i64 = string.len_raw(text)
    if ((text_len % 4) != 0) {
        return err CryptoError.InvalidBase64Length
    }

    val pad: mut i64 = 0
    if text_len > 0 && (@load8(@ptradd(text as ref void, text_len - 1)) as u8) == 61 { pad++ }
    if text_len > 1 && (@load8(@ptradd(text as ref void, text_len - 2)) as u8) == 61 { pad++ }

    val out_len: i64 = (text_len / 4) * 3 - pad
    val out: string.String = alloc_string[A](ac, out_len)
    if out == none { return err CryptoError.OutOfMemory }
    val out_ptr: ref void = @load(out) as ref void

    val i: mut i64 = 0
    val oi: mut i64 = 0
    for {
        if i >= text_len { break }

        val c0: u8 = @load8(@ptradd(text as ref void, i + 0)) as u8
        val c1: u8 = @load8(@ptradd(text as ref void, i + 1)) as u8
        val c2: u8 = @load8(@ptradd(text as ref void, i + 2)) as u8
        val c3: u8 = @load8(@ptradd(text as ref void, i + 3)) as u8

        val v0: i64 = b64_value(c0)
        val v1: i64 = b64_value(c1)
        if v0 < 0 || v1 < 0 {
            return err CryptoError.InvalidBase64Char
        }

        val last_quad: bool = i + 4 == text_len
        if c2 == 61 {
            if !last_quad || c3 != 61 {
                return err CryptoError.InvalidBase64Padding
            }
            @store8(@ptradd(out_ptr, oi), (((v0 as u8) << 2) | ((v1 as u8) >> 4)) as u8)
            oi++
            i = i + 4
            continue
        }

        val v2: i64 = b64_value(c2)
        if v2 < 0 {
            return err CryptoError.InvalidBase64Char
        }

        @store8(@ptradd(out_ptr, oi + 0), (((v0 as u8) << 2) | ((v1 as u8) >> 4)) as u8)
        oi++

        if c3 == 61 {
            if !last_quad {
                return err CryptoError.InvalidBase64Padding
            }
            @store8(@ptradd(out_ptr, oi), ((((v1 as u8) & 15) << 4) | ((v2 as u8) >> 2)) as u8)
            oi++
            i = i + 4
            continue
        }

        val v3: i64 = b64_value(c3)
        if v3 < 0 {
            return err CryptoError.InvalidBase64Char
        }

        @store8(@ptradd(out_ptr, oi + 0), ((((v1 as u8) & 15) << 4) | ((v2 as u8) >> 2)) as u8)
        @store8(@ptradd(out_ptr, oi + 1), ((((v2 as u8) & 3) << 6) | (v3 as u8)) as u8)
        oi = oi + 2
        i = i + 4
    }

    return ok out
}

/// Compare two strings or byte strings without early exit.
pub fn ct_eq[T](a: T, b: T) bool = trust {
    val ap: ref void = bytes_ptr[T](a)
    val bp: ref void = bytes_ptr[T](b)
    val al: i64 = bytes_len[T](a)
    val bl: i64 = bytes_len[T](b)
    val max_len: mut i64 = al
    if bl > max_len { max_len = bl }

    val diff: mut i64 = al ^ bl
    val i: mut i64 = 0
    for {
        if i >= max_len { break }
        val av: mut u8 = 0
        val bv: mut u8 = 0
        if i < al { av = @load8(@ptradd(ap, i)) as u8 }
        if i < bl { bv = @load8(@ptradd(bp, i)) as u8 }
        diff = diff | ((av ^ bv) as i64)
        i++
    }
    return diff == 0
}

/// Compute HMAC-SHA256 for the given key and data.
///
/// Returns a 32-byte String allocated with the provided allocator.
fn hmac_sha256_heap[T](key: T, data: T) string.String = trust {
    val block_size: i64 = 64
    val key_ptr: mut ref void = bytes_ptr[T](key)
    val key_len: mut i64 = bytes_len[T](key)
    val hashed_key: mut string.String = 0 as string.String

    if key_len > block_size {
        hashed_key = sha256_heap[T](key)
        key_ptr = @load(hashed_key) as ref void
        key_len = 32
    }

    val ipad: ref void = @alloc(block_size)
    val opad: ref void = @alloc(block_size)
    @memset(ipad, 0x36, block_size)
    @memset(opad, 0x5c, block_size)

    val i: mut i64 = 0
    for {
        if i >= key_len { break }
        val kb: u8 = @load8(@ptradd(key_ptr, i)) as u8
        @store8(@ptradd(ipad, i), ((@load8(@ptradd(ipad, i)) as u8) ^ kb) as u8)
        @store8(@ptradd(opad, i), ((@load8(@ptradd(opad, i)) as u8) ^ kb) as u8)
        i++
    }

    val data_ptr: ref void = bytes_ptr[T](data)
    val data_len: i64 = bytes_len[T](data)

    val inner: string.String = alloc_heap_string(block_size + data_len)
    val inner_ptr: ref void = @load(inner) as ref void
    @memcpy(inner_ptr, ipad, block_size)
    if data_len > 0 {
        @memcpy(@ptradd(inner_ptr, block_size), data_ptr, data_len)
    }
    val inner_digest: string.String = sha256_heap[string.String](inner)
    string.string_free(inner)

    val inner_digest_ptr: ref void = @load(inner_digest) as ref void
    val outer: string.String = alloc_heap_string(block_size + 32)
    val outer_ptr: ref void = @load(outer) as ref void
    @memcpy(outer_ptr, opad, block_size)
    @memcpy(@ptradd(outer_ptr, block_size), inner_digest_ptr, 32)

    @free(ipad)
    @free(opad)
    if hashed_key != none { string.string_free(hashed_key) }
    string.string_free(inner_digest)

    val out: string.String = sha256_heap[string.String](outer)
    string.string_free(outer)
    return out
}

/// Compute HMAC-SHA256 for the given key and data.
///
/// Returns a 32-byte String allocated with the provided allocator.
pub fn hmac_sha256[A: allocators.Allocator, T](ac: A, key: T, data: T) string.String = trust {
    val heap_out: string.String = hmac_sha256_heap[T](key, data)
    if heap_out == none { return none }

    val out: string.String = copy_string[A](ac, heap_out)
    string.string_free(heap_out)
    return out
}

/// Generate a nonce-safe random string.
///
/// Returns 24 random bytes encoded as lowercase hex (48 chars) from the provided allocator.
pub fn unique_nonce[A: allocators.Allocator](ac: A) ref u8 = trust {
    val buf: string.String = alloc_heap_string(24)
    val ptr: ref void = @load(buf) as ref void
    random.random_bytes(ptr, 24 as usize)
    val out: ref u8 = hex_encode[A, string.String](ac, buf)
    string.string_free(buf)
    return out
}

/// Compute the SHA-256 digest of an entire file.
///
/// Returns the 32-byte digest as a String allocated with the provided allocator.
pub fn hash_file_sha256[A: allocators.Allocator](ac: A, path: ref u8) result[string.String, CryptoError] = trust {
    val file: ref void = fopen(path, "rb")
    if file == none {
        return err CryptoError.FileOpenFailed
    }

    if fseek(file, 0, 2 as i32) != 0 {
        fclose(file)
        return err CryptoError.FileReadFailed
    }

    val file_len: i64 = ftell(file)
    if file_len < 0 {
        fclose(file)
        return err CryptoError.FileReadFailed
    }

    rewind(file)

    val data: string.String = alloc_heap_string(file_len)
    if data == none {
        fclose(file)
        return err CryptoError.OutOfMemory
    }

    val data_ptr: ref void = @load(data) as ref void
    if file_len > 0 {
        val nread: usize = fread(data_ptr, 1 as usize, file_len as usize, file)
        if nread != file_len as usize {
            fclose(file)
            string.string_free(data)
            return err CryptoError.FileReadFailed
        }
    }

    fclose(file)

    val digest: string.String = sha256[A, string.String](ac, data)
    string.string_free(data)
    if digest == none {
        return err CryptoError.OutOfMemory
    }
    return ok digest
}

test {
    val arena = trust allocators.Arena.new(32768 as usize)?
    val sha_hex_expected: ref u8 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

    assert trust hash_fnv(0 as usize) != trust hash_fnv(1 as usize)

    val sha: string.String = trust sha256[allocators.Arena, ref u8](arena, "abc")
    val sha_hex: ref u8 = trust hex_encode[allocators.Arena, string.String](arena, sha)

    assert string.rchar_cmp(sha_hex, sha_hex_expected) == 0

    val hmac_out: string.String = trust hmac_sha256[allocators.Arena, ref u8](
        arena,
        "key",
        "The quick brown fox jumps over the lazy dog"
    )
    val hmac_hex: ref u8 = trust hex_encode[allocators.Arena, string.String](arena, hmac_out)
    assert string.rchar_cmp(hmac_hex, "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8") == 0

    val encoded_hex: ref u8 = trust hex_encode[allocators.Arena, ref u8](arena, "hi")
    assert string.rchar_cmp(encoded_hex, "6869") == 0

    val decoded_hex_res = trust hex_decode[allocators.Arena](arena, "6869")
    match decoded_hex_res {
        ok decoded_hex => {
            val decoded_hex_roundtrip: ref u8 = trust hex_encode[allocators.Arena, string.String](arena, decoded_hex)
            assert string.rchar_cmp(decoded_hex_roundtrip, "6869") == 0
        }
        err _ => { assert false }
    }

    val bad_hex_res = trust hex_decode[allocators.Arena](arena, "0z")
    match bad_hex_res {
        ok _ => {
            assert false
        }
        err e => { assert e == CryptoError.InvalidHexDigit }
    }

    val encoded_b64: ref u8 = trust base64_encode[allocators.Arena, ref u8](arena, "hello")
    assert string.rchar_cmp(encoded_b64, "aGVsbG8=") == 0

    val decoded_b64_res = trust base64_decode[allocators.Arena](arena, "aGVsbG8=")
    match decoded_b64_res {
        ok decoded_b64 => {
            val decoded_b64_roundtrip: ref u8 = trust hex_encode[allocators.Arena, string.String](arena, decoded_b64)
            assert string.rchar_cmp(decoded_b64_roundtrip, "68656c6c6f") == 0
        }
        err _ => { assert false }
    }

    val bad_b64_res = trust base64_decode[allocators.Arena](arena, "abcd*===")
    match bad_b64_res {
        ok _ => {
            assert false
        }
        err e => {
            assert e == CryptoError.InvalidBase64Length || e == CryptoError.InvalidBase64Char || e == CryptoError.InvalidBase64Padding
        }
    }

    assert trust ct_eq[ref u8]("same", "same")
    assert !(trust ct_eq[ref u8]("same", "different"))
    assert !(trust ct_eq[ref u8]("same", "same!"))

    val nonce1: ref u8 = trust unique_nonce[allocators.Arena](arena)
    val nonce2: ref u8 = trust unique_nonce[allocators.Arena](arena)
    assert string.len_raw(nonce1) == 48
    assert string.len_raw(nonce2) == 48

    assert trust fs.write_all("crypto_hash_file_sha256_test.txt", "abc")
    val file_hash_res = trust hash_file_sha256[allocators.Arena](arena, "crypto_hash_file_sha256_test.txt")
    match file_hash_res {
        ok file_hash => {
            val file_hash_hex: ref u8 = trust hex_encode[allocators.Arena, string.String](arena, file_hash)
            assert string.rchar_cmp(file_hash_hex, sha_hex_expected) == 0
        }
        err _ => { assert false }
    }
    assert trust fs.delete("crypto_hash_file_sha256_test.txt")

    val missing_file_hash_res = trust hash_file_sha256[allocators.Arena](arena, "crypto_hash_file_sha256_missing.txt")
    match missing_file_hash_res {
        ok _ => { assert false }
        err e => { assert e == CryptoError.FileOpenFailed }
    }

    trust allocators.Arena.free(arena)
}
