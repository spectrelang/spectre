/// Cryptographically secure random number generation and UUID v4 generation.
///
/// No seeding is required; the OS manages entropy automatically.

val stdio = use("../stdio")
val str   = use("std/string")

when linux {
    // glibc >= 2.25 / musl provide getrandom(2) directly.
    extern (C) fn getrandom(buf: ref void, buflen: usize, flags: u32) isize = "getrandom"
}
or when android {
    extern (C) fn getrandom_android(buf: ref void, buflen: usize, flags: u32) isize = "getrandom"
}
or when posix {
    // arc4random is native on macOS and the BSDs.
    extern (C) fn arc4random_buf(buf: ref void, len: usize) void = "arc4random_buf"
}
or when windows {
    link "-lbcrypt"
    extern (C) fn BCryptGenRandom(
        hAlgorithm: ref void,
        pbBuffer: ref void,
        cbBuffer: u32,
        dwFlags: u32
    ) i32 = "BCryptGenRandom"
}

/// Fill `buf` with `len` cryptographically secure random bytes.
pub fn random_bytes(buf: ref void, len: usize) void = {
    when linux {
        val total: mut usize = 0
        for {
            if total >= len {
                break
            }
            val n: isize = trust getrandom(@ptradd(buf, total as i64), len - total, 0 as u32)
            if n <= 0 {
                break
            }
            total = total + (n as usize)
        }
    }
    or when android {
        val total: mut usize = 0
        for {
            if total >= len {
                break
            }
            val n: isize = trust getrandom_android(
                @ptradd(buf, total as i64),
                len - total,
                0 as u32
            )
            if n <= 0 {
                break
            }
            total = total + (n as usize)
        }
    }
    or when posix {
        trust arc4random_buf(buf, len)
    }
    or when windows {
        trust BCryptGenRandom(none, buf, len as u32, 2 as u32)
    }
}

/// Return a cryptographically secure random u64.
pub fn random_u64() u64 = {
    val buf: ref void = @alloc(8)
    random_bytes(buf, 8 as usize)
    val result: u64 = trust @load(buf) as u64
    trust @free(buf)
    return result
}

/// Return a cryptographically secure u32 in (0, upper_bound) without modulo bias.
/// Requires upper_bound > 0.
pub fn random_u32_below(upper_bound: u32) u32 = {
    if upper_bound <= 1 {
        return 0
    }
    val threshold: u32 = (4294967295 as u32 % upper_bound + 1) % upper_bound
    for {
        val buf: ref void = @alloc(4)
        random_bytes(buf, 4 as usize)
        val r: u32 = trust @load(buf) as u32
        trust @free(buf)
        if r >= threshold {
            return r % upper_bound
        }
    }
    return 0
}

/// Allocate and return a null-terminated UUID v4 string (37 bytes: 36 chars + null).
/// The caller is responsible for freeing the returned pointer.
///
/// Format: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx (RFC 4122)
pub fn random_uuid() ref u8 = trust {
    val rnd: ref void = @alloc(16)
    random_bytes(rnd, 16 as usize)

    val hi: u64 = @load(rnd) as u64
    val lo: u64 = @load(@ptradd(rnd, 8)) as u64
    val hi_v: u64 = (hi & 0xffffffffffff0fff) | 0x0000000000004000
    val lo_v: u64 = (lo & 0x3fffffffffffffff) | 0x8000000000000000
    val out: ref u8 = @alloc(37) as ref u8

    @snprintf(out, 37, "{08llx}-{04llx}-{04llx}-{04llx}-{012llx}",
        (hi_v >> 32) & 0xffffffff,
        (hi_v >> 16) & 0xffff,
        hi_v & 0xffff,
        (lo_v >> 48) & 0xffff,
        lo_v & 0xffffffffffff)

    @free(rnd)
    return out
}

test "random values and uuids are generated" {
    val r1 = random_u64()
    val r2 = random_u64()
    assert r1 != r2

    val r3 = random_u32_below(100 as u32)
    assert r3 >= 0
    assert r3 < 100

    val uuid1: mut ref u8 = trust random_uuid()
    val uuid2: mut ref u8 = trust random_uuid()
    assert uuid1 != none
    assert uuid2 != none

    stdio.puts(str.cstr_raw(uuid1))
    stdio.puts(str.cstr_raw(uuid2))

    trust @free(uuid1)
    trust @free(uuid2)
}
