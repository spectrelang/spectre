val str        = use("std/string")
val cstr = use("std/string/cstr")
val ostr = use("std/string/owned")
val builder = use("std/string/builder")
val stdio      = use("../stdio")
val allocators = use("../allocators")
val os         = use("../os")

when windows {
    extern (C, header) fn CreateDirectoryA(
        path: ref u8,
        security: ref void
    ) i32 = "CreateDirectoryA"
}

/// Gets the name of some file path without the file extension.
pub fn get_name_without_ext_cstr(arena: ref allocators.Arena, path: ref u8) ref u8 = {
    val len: i64 = cstr.len(path)
    val last_slash: mut i64 = -1
    val i: mut i64 = 0

    for {
        if (i >= len) {
            break
        }
        val c: mut u8 = '\0'
        if cstr.byte_at(path, i) is some v {
            c = v
        }
        if (c == 47) {
            last_slash = i
        }
        when windows {
            if (c == 92) {
                last_slash = i
            }
        }
        i++
    }

    val filename_start: i64 = last_slash + 1
    val filename_len: i64 = len - filename_start
    val last_dot: mut i64 = -1
    val j: mut i64 = 0

    for {
        if (j >= filename_len) {
            break
        }
        val c: mut u8 = '\0'
        if cstr.byte_at(path, filename_start + j) is some v {
            c = v
        }
        if (c == 46) {
            last_dot = j
        }
        j++
    }

    val name_len: mut i64 = 0

    if (last_dot >= 0) {
        name_len = last_dot
    } else {
        name_len = filename_len
    }

    val buf_opt = allocators.Arena.alloc(arena, name_len + 1)
    val buf: mut ref void = none
    match buf_opt {
        some b => {
            buf = b
        }
        none => {
            stdio.puts("error: out of memory")
            return ""
        }
    }
    trust @memcpy(buf, @ptradd(path, filename_start), name_len)
    trust @store8(@ptradd(buf, name_len), 0)

    return buf as ref u8
}

/// View-taking variant of `get_name_without_ext_cstr`.
pub fn get_name_without_ext(
    arena: ref allocators.Arena,
    path: str.StringView
) ref u8 = trust {
    val base: str.StringView = base_name(path)
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= base.len {
            break
        }
        if @load8(@ptradd(base.ptr, i)) == 46 {
            last_dot = i
        }
        i++
    }

    val name_len: mut i64 = base.len
    if last_dot >= 0 {
        name_len = last_dot
    }
    val buf_opt = allocators.Arena.alloc(arena, name_len + 1)
    val buf: mut ref void = none
    match buf_opt {
        some b => {
            buf = b
        }
        none => {
            stdio.puts("error: out of memory")
            return c""
        }
    }
    if name_len > 0 {
        @memcpy(buf, base.ptr as ref void, name_len as usize)
    }
    @store8(@ptradd(buf, name_len), 0)
    return buf as ref u8
}

/// Join dir + "/" + name, returning a heap-allocated str.
/// Does not add a second separator when `dir` already ends with one.
pub fn join_cstr(dir: ref u8, name: ref u8) ref u8 = trust {
    val dlen: i64 = cstr.len(dir)
    val nlen: i64 = cstr.len(name)
    val sep: mut i64 = 1
    if dlen > 0 {
        val last: u8 = @load8(@ptradd(dir, dlen - 1))
        if last == 47 || last == 92 {
            sep = 0
        }
    }
    val buf: ref u8 = @alloc(dlen + nlen + sep + 1) as ref u8
    @memcpy(buf, dir, dlen as usize)
    if sep == 1 {
        @store8(@ptradd(buf, dlen), '/')
    }
    @memcpy(@ptradd(buf, dlen + sep), name, nlen as usize)
    @store8(@ptradd(buf, dlen + sep + nlen), 0)
    return buf
}

/// Join two views, returning a newly allocated null-terminated str.
pub fn join(dir: str.StringView, name: str.StringView) ref u8 = trust {
    val dlen: i64 = dir.len
    val nlen: i64 = name.len
    val sep: mut i64 = 1
    if dlen > 0 {
        val last: u8 = @load8(@ptradd(dir.ptr, dlen - 1))
        if last == 47 || last == 92 {
            sep = 0
        }
    }
    val buf: ref u8 = @alloc(dlen + nlen + sep + 1) as ref u8
    if dlen > 0 {
        @memcpy(buf as ref void, dir.ptr as ref void, dlen as usize)
    }
    if sep == 1 {
        @store8(@ptradd(buf, dlen), '/')
    }
    if nlen > 0 {
        @memcpy(@ptradd(buf, dlen + sep) as ref void, name.ptr as ref void, nlen as usize)
    }
    @store8(@ptradd(buf, dlen + sep + nlen), 0)
    return buf
}

/// Return the directory part of a path as a view.
/// Returns "." if no separator found.
pub fn dir(path: str.StringView) str.StringView = trust {
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= path.len {
            break
        }
        val c: u8 = @load8(@ptradd(path.ptr, i))
        if c == 47 {
            last_slash = i
        }
        when windows {
            if c == 92 {
                last_slash = i
            }
        }
        i++
    }
    if last_slash < 0 {
        return "."
    }
    return str.slice(path, 0, last_slash + 1)
}

/// Return the directory part of a path (everything up to and including last separator).
/// Returns "." if no separator found.
pub fn dir_cstr(path: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(path)
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(path, i))
        if c == 47 {
            last_slash = i
        }
        when windows {
            if c == 92 {
                last_slash = i
            }
        }
        i++
    }
    if last_slash < 0 {
        return c"."
    }
    val buf: ref u8 = @alloc(last_slash + 2) as ref u8
    @memcpy(buf, path, (last_slash + 1) as usize)
    @store8(@ptradd(buf, last_slash + 1), 0)
    return buf
}

/// Returns the path with all .. or parent references resolved.
pub fn canonicalize_path_cstr(path: ref u8) ref u8 = trust {
    if path == none {
        return path
    }
    val len: i64 = cstr.len(path)
    if len == 0 {
        return path
    }
    val is_abs: bool = @load8(@ptradd(path, 0)) == 47
    val keep_dot_prefix: bool = len >= 2 &&
    @load8(@ptradd(path, 0)) == 46 &&
    @load8(@ptradd(path, 1)) == 47
    val list_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
        (len * 16 + 1024) as usize
    )?
    defer {
        allocators.ScopedArena.free(list_arena)
    }
    val list_ac: allocators.ListArena = {arena: list_arena}
    val segs: mut list[ref u8] = @listalloc[allocators.ListArena, ref u8](list_ac)?
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(path, i))
        if c == 47 {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= len {
                break
            }
            val c2: u8 = @load8(@ptradd(path, i))
            if c2 == 47 {
                break
            }
            i++
        }
        val seg_len: i64 = i - start
        val seg: ref u8 = @alloc((seg_len + 1) as usize) as ref u8
        @memcpy(seg, @ptradd(path, start), seg_len as usize)
        @store8(@ptradd(seg, seg_len), 0)
        if cstr.cmp(seg, c".") == 0 {
            @free(seg as ref void)
            continue
        }
        if cstr.cmp(seg, c"..") == 0 {
            val segs_len: i64 = @len(segs) as i64
            if segs_len > 0 {
                val last_opt = @get(segs, (segs_len - 1) as usize)
                match last_opt {
                    some last => {
                        if cstr.cmp(last as ref u8, c"..") != 0 {
                            @free(last as ref void)
                            @remove(segs, segs_len - 1)
                            @free(seg as ref void)
                        } elif !is_abs {
                            @append(segs, seg)
                        } else {
                            @free(seg as ref void)
                        }
                    }
                    none => {
                        if !is_abs {
                            @append(segs, seg)
                        } else {
                            @free(seg as ref void)
                        }
                    }
                }
            } elif !is_abs {
                @append(segs, seg)
            } else {
                @free(seg as ref void)
            }
            continue
        }
        @append(segs, seg)
    }
    if @len(segs) as i64 == 0 {
        val leaf: ref u8 = @alloc(2) as ref u8
        if is_abs {
            @store8(leaf, 47)
        } else {
            @store8(leaf, 46)
        }
        @store8(@ptradd(leaf, 1), 0)
        return leaf
    }
    val sb: ref void = builder.StringBuilder.new()
    if is_abs {
        builder.StringBuilder.append_char(sb, 47 as u8)
    }
    val si: mut i64 = 0
    for {
        if si >= @len(segs) as i64 {
            break
        }
        val s_opt = @get(segs, si as usize)
        if s_opt is some s {
            if si > 0 {
                builder.StringBuilder.append_char(sb, 47 as u8)
            } elif keep_dot_prefix && !is_abs {
                builder.StringBuilder.append_cstr(sb, c"./")
            }
            builder.StringBuilder.append_cstr(sb, s as ref u8)
        }
        si++
    }
    val built: ref void = builder.StringBuilder.build(sb)
    val out: ref u8 = ostr.as_cstr(built)
    builder.StringBuilder.free(sb)
    @free(built)
    val fi: mut i64 = 0
    for fi < @len(segs) as i64 {
        val seg_opt = @get(segs, fi as usize)
        if seg_opt is some seg {
            val seg_ptr: mut ref u8 = seg as ref u8
            @free(seg_ptr as ref void)
        }
        fi++
    }
    if cstr.len(out) == 0 {
        @free(out as ref void)
        if is_abs {
            return c"/"
        }
        return c"."
    }
    return out
}

/// Canonicalize a path held in a view, returning an owned str.
pub fn canonicalize_path(path: str.StringView) ref u8 = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val tmp: str.ZString = str.zstr_from[allocators.HeapAllocator](heap, path)
    if tmp.ptr == none {
        return none
    }
    val result: ref u8 = canonicalize_path_cstr(tmp.ptr)
    if result == tmp.ptr {
        str.zstr_free[allocators.HeapAllocator](heap, tmp)
        val empty: ref u8 = @alloc(1) as ref u8
        @store8(empty, 0)
        return empty
    }
    str.zstr_free[allocators.HeapAllocator](heap, tmp)
    return result
}

/// Returns true when `c` is a path separator on any supported platform.
pub fn is_path_sep(c: u8) bool = {
    return c == 47 || c == 92
}

/// Returns the separator used in PATH-style environment variables.
///
/// This is ':' on POSIX systems and ';' on Windows. It is not the same as the
/// separator between path components.
pub fn path_sep() u8 = {
    when windows {
        return ';'
    }
    return ':'
}

/// Returns the final component of a path.
///
/// Both '/' and '\\' are accepted as separators. A path consisting only of
/// separators yields an empty str.
pub fn base_name_cstr(path: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(path)
    if len == 0 {
        return c""
    }

    val end: mut i64 = len
    for {
        if end <= 1 {
            break
        }
        val c: u8 = @load8(@ptradd(path, end - 1)) as u8
        if is_path_sep(c) {
            end--
        } else {
            break
        }
    }

    val i: mut i64 = end - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(path, i)) as u8
        if is_path_sep(c) {
            return cstr.substr(path, i + 1, end - i - 1)
        }
        i--
    }
    return cstr.substr(path, 0, end)
}

/// Return the final component of a path as a borrowed view.
pub fn base_name(path: str.StringView) str.StringView = trust {
    if path.len == 0 {
        return ""
    }

    val end: mut i64 = path.len
    for {
        if end <= 1 {
            break
        }
        val c: u8 = @load8(@ptradd(path.ptr, end - 1)) as u8
        if is_path_sep(c) {
            end--
        } else {
            break
        }
    }

    val i: mut i64 = end - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(path.ptr, i)) as u8
        if is_path_sep(c) {
            return str.slice(path, i + 1, end)
        }
        i--
    }
    return str.slice(path, 0, end)
}

fn lower_char(c: u8) u8 = {
    if c >= 65 && c <= 90 {
        return (c + 32) as u8
    }
    return c
}

fn has_exe_suffix(s: ref u8) bool = trust {
    val len: i64 = cstr.len(s)
    if len <= 4 {
        return false
    }
    val dot: u8 = @load8(@ptradd(s, len - 4)) as u8
    val e1: u8 = lower_char(@load8(@ptradd(s, len - 3)) as u8)
    val x: u8 = lower_char(@load8(@ptradd(s, len - 2)) as u8)
    val e2: u8 = lower_char(@load8(@ptradd(s, len - 1)) as u8)
    return dot == 46 && e1 == 101 && x == 120 && e2 == 101
}

/// Normalize a shell name or shell executable path.
///
/// Returns the lower-case base name with any `.exe` suffix removed, so
/// `/bin/Bash`, `bash`, and `C:\\Windows\\System32\\BASH.EXE` all become
/// `bash`.
pub fn normalize_shell_cstr(name: ref u8) ref u8 = trust {
    val base: ref u8 = base_name_cstr(name)
    val len: i64 = cstr.len(base)
    val trimmed: mut ref u8 = base
    if has_exe_suffix(base) {
        trimmed = cstr.substr(base, 0, len - 4)
    }

    val lower: ref u8 = @alloc(cstr.len(trimmed) + 1) as ref u8
    val i: mut i64 = 0
    for {
        if i >= cstr.len(trimmed) {
            break
        }
        val c: u8 = @load8(@ptradd(trimmed, i)) as u8
        @store8(@ptradd(lower, i), lower_char(c))
        i++
    }
    @store8(@ptradd(lower, i), 0)
    return lower
}

/// Normalize a shell name or shell executable path held in a view.
pub fn normalize_shell(name: str.StringView) ref u8 = trust {
    val base: str.StringView = base_name(name)
    val len: i64 = base.len
    val trimmed: mut str.StringView = base
    if len > 4 {
        val dot: u8 = @load8(@ptradd(base.ptr, len - 4)) as u8
        val e1: u8 = lower_char(@load8(@ptradd(base.ptr, len - 3)) as u8)
        val x: u8 = lower_char(@load8(@ptradd(base.ptr, len - 2)) as u8)
        val e2: u8 = lower_char(@load8(@ptradd(base.ptr, len - 1)) as u8)
        if dot == 46 && e1 == 101 && x == 120 && e2 == 101 {
            trimmed = str.slice(base, 0, len - 4)
        }
    }

    val lower: ref u8 = @alloc(trimmed.len + 1) as ref u8
    val i: mut i64 = 0
    for {
        if i >= trimmed.len {
            break
        }
        val c: u8 = @load8(@ptradd(trimmed.ptr, i)) as u8
        @store8(@ptradd(lower, i), lower_char(c))
        i++
    }
    @store8(@ptradd(lower, i), 0)
    return lower
}

fn is_directory(path: ref u8) bool = trust {
    val handle: ref void = os.opendir(path)
    if handle == none {
        return false
    }
    os.closedir(handle)
    return true
}

fn make_directory(path: ref u8) bool = trust {
    when windows {
        return CreateDirectoryA(path, none) != 0
    }
    when posix {
        return os.mkdir(path, 493 as u32) == 0
    }
    return false
}

/// Create a directory and all of its missing parent directories.
///
/// Returns true when the directory exists after the call. Existing directories
/// are treated as success.
pub fn ensure_dir_cstr(path: ref u8) bool = trust {
    val len: i64 = cstr.len(path)
    if len == 0 || cstr.cmp(path, c".") == 0 {
        return true
    }
    if is_directory(path) {
        return true
    }

    val i: mut i64 = 1
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(path, i)) as u8
        if is_path_sep(c) {
            val parent: ref u8 = cstr.substr(path, 0, i)
            if cstr.len(parent) > 0 && !is_directory(parent) {
                make_directory(parent)
            }
        }
        i++
    }

    if is_directory(path) {
        return true
    }
    return make_directory(path)
}

/// View-taking variant of `ensure_dir_cstr`.
pub fn ensure_dir(path: str.StringView) bool = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val tmp: str.ZString = str.zstr_from[allocators.HeapAllocator](heap, path)
    if tmp.ptr == none {
        return false
    }
    val result: bool = ensure_dir_cstr(tmp.ptr)
    str.zstr_free[allocators.HeapAllocator](heap, tmp)
    return result
}

/// View-taking variant of `path_contains_dir_cstr`.
pub fn path_contains_dir(target: str.StringView) bool = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val tmp: str.ZString = str.zstr_from[allocators.HeapAllocator](heap, target)
    if tmp.ptr == none {
        return false
    }
    val result: bool = path_contains_dir_cstr(tmp.ptr)
    str.zstr_free[allocators.HeapAllocator](heap, tmp)
    return result
}

/// Returns true when `target` is one of the entries in the PATH environment
/// variable.
pub fn path_contains_dir_cstr(target: ref u8) bool = trust {
    val env_opt = os.env(c"PATH")
    val value: mut ref u8 = c""
    match env_opt {
        none => {
            return false
        }
        some found => {
            value = found
        }
    }

    val len: i64 = cstr.len(value)
    val sep: u8 = path_sep()
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        val at_end: bool = i == len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(value, i)) as u8
        }
        if at_end || c == sep {
            val part: ref u8 = cstr.substr(value, start, i - start)
            if cstr.len(part) > 0 && cstr.cmp(part, target) == 0 {
                return true
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i++
    }
    return false
}

test "path helpers split names, normalize shells and detect PATH entries" {
    assert cstr.cmp(trust base_name_cstr(c"/usr/local/bin/spectre"), c"spectre") == 0
    assert cstr.cmp(trust base_name_cstr(c"C:\\Tools\\phantom.exe"), c"phantom.exe") == 0
    assert cstr.cmp(trust normalize_shell_cstr(c"/bin/Bash"), c"bash") == 0
    assert cstr.cmp(trust normalize_shell_cstr(c"C:\\Windows\\System32\\BASH.EXE"), c"bash") == 0
    assert is_path_sep(47)
    assert is_path_sep(92)
    assert !is_path_sep(65)
}

test "path canonicalization normalizes segments" {
    assert cstr.cmp(
        trust canonicalize_path_cstr(c"./samples/bigproj/hi/../mod1.sx"),
        c"./samples/bigproj/mod1.sx"
    ) == 0
    assert cstr.cmp(
        trust canonicalize_path_cstr(c"samples/bigproj/hi//../mod1.sx"),
        c"samples/bigproj/mod1.sx"
    ) == 0
    assert cstr.cmp(trust canonicalize_path_cstr(c"../samples/../mod1.sx"), c"../mod1.sx") == 0
}
