val stdio = use("../stdio")
val allocators = use("../allocators")

extern (C) fn localtime(timep: ref i64) ref void = "localtime"
extern (C) fn gettimeofday(tv: ref TimeVal, tz: ref void) i32 = "gettimeofday"

when posix {
    extern (C) fn usleep(usec: u32) i32 = "usleep"
}

when windows {
    extern (C) fn Sleep(ms: u32) void = "Sleep"
}

extern type TimeVal = {
    tv_sec:  i64
    tv_usec: i64  
}

/// A DateTime holds a calendar date and wall-clock time.
type DateTime = {
    year:   mut i64
    month:  mut i64
    day:    mut i64
    hour:   mut i64
    minute: mut i64
    second: mut i64
    millis: mut i64
}

/// Allocate and return a new DateTime on the heap.
/// All fields are validated on construction.
pub fn (DateTime) new[A: allocators.Allocator](
    ac: A,
    year: i64, 
    month: i64, 
    day: i64, 
    hour: i64, 
    minute: i64, 
    second: i64, 
    millis: i64
) DateTime = {
    pre {
        valid_month  : month  >= 1  && month  <= 12
        valid_day    : day    >= 1  && day    <= 31
        valid_hour   : hour   >= 0  && hour   <= 23
        valid_minute : minute >= 0  && minute <= 59
        valid_second : second >= 0  && second <= 59
        valid_millis : millis >= 0  && millis <= 999
    }

    val ptr: mut ref DateTime = A.alloc(ac, @sizeof(DateTime)) as ref DateTime

    ptr.year = year
    ptr.month = month
    ptr.day = day
    ptr.hour = hour
    ptr.minute = minute
    ptr.second = second
    ptr.millis = millis
    
    return ptr
}

/// Return the current local time as a DateTime.
/// Wraps the C `localtime` / `gettimeofday` pair.
pub fn (DateTime) now[A: allocators.Allocator](ac: A) DateTime = {
    val tv: ref TimeVal = A.alloc(ac, @sizeof(TimeVal))

    trust gettimeofday(tv, 0)

    val seconds: mut i64 = tv.tv_sec
    val usecs:   i64 = tv.tv_usec
    val tm: ref void = trust localtime(@addr(seconds))

    val year:   i64 = ((trust @load(@ptradd(tm, 20))) & 0xFFFFFFFF) as i64
    val month:  i64 = ((trust @load(@ptradd(tm, 16))) & 0xFFFFFFFF) as i64
    val day:    i64 = ((trust @load(@ptradd(tm, 12))) & 0xFFFFFFFF) as i64
    val hour:   i64 = ((trust @load(@ptradd(tm, 8)))  & 0xFFFFFFFF) as i64
    val minute: i64 = ((trust @load(@ptradd(tm, 4)))  & 0xFFFFFFFF) as i64
    val second: i64 = ((trust @load(@ptradd(tm, 0)))  & 0xFFFFFFFF) as i64
    val millis: i64 = usecs / 1000

    return DateTime.new[A](ac, year + 1900, month + 1, day, hour, minute, second, millis)
}

/// Return the current Unix timestamp in seconds since epoch.
pub fn unix_now[A: allocators.Allocator](ac: A) i64 = {
    val tv: ref TimeVal = allocators.bump_alloc_unwrap[A](ac, @sizeof(TimeVal))
    trust gettimeofday(tv, 0)
    val seconds: i64 = tv.tv_sec
    return seconds
}

/// Return the current Unix timestamp in milliseconds since epoch.
pub fn unix_now_millis[A: allocators.Allocator](ac: A) i64 = {
    val tv: ref TimeVal = allocators.bump_alloc_unwrap[A](ac, @sizeof(TimeVal))
    trust gettimeofday(tv, 0)
    val millis: i64 = tv.tv_sec * 1000 + tv.tv_usec / 1000
    return millis
}

/// Return the current Unix timestamp in microseconds since epoch.
pub fn unix_now_micros[A: allocators.Allocator](ac: A) i64 = {
    val tv: ref TimeVal = allocators.bump_alloc_unwrap[A](ac, @sizeof(TimeVal))
    trust gettimeofday(tv, 0)
    val micros: i64 = tv.tv_sec * 1000000 + tv.tv_usec
    return micros
}

/// Sleep the current thread for approximately `ms` milliseconds.
pub fn sleep_millis(ms: i64) void = trust {
    pre {
        non_negative: ms >= 0
    }

    when posix {
        val remaining_us: mut i64 = ms * 1000
        for {
            if remaining_us <= 0 { break }
            if remaining_us > 4294967295 {
                usleep(4294967295 as u32)
                remaining_us = remaining_us - 4294967295
            } else {
                usleep(remaining_us as u32)
                break
            }
        }
    }

    when windows {
        val remaining_ms: mut i64 = ms
        for {
            if remaining_ms <= 0 { break }
            if remaining_ms > 4294967295 {
                Sleep(4294967295 as u32)
                remaining_ms = remaining_ms - 4294967295
            } else {
                Sleep(remaining_ms as u32)
                break
            }
        }
    }
}

/// Read the year field.
pub fn (DateTime) year(dt: self) i64 = {
    return dt.year
}

/// Read the month field (1–12).
pub fn (DateTime) month(dt: self) i64 = {
    return dt.month 
}

/// Read the day field (1–31).
pub fn (DateTime) day(dt: self) i64 = {
    return dt.day 
}

/// Read the hour field (0–23).
pub fn (DateTime) hour(dt: self) i64 = {
    return dt.hour
}

/// Read the minute field (0–59).
pub fn (DateTime) minute(dt: self) i64 = {
    return dt.minute
}

/// Read the second field (0–59).
pub fn (DateTime) second(dt: self) i64 = {
    return dt.second
}

/// Read the milliseconds field (0–999).
pub fn (DateTime) millis(dt: self) i64 = {
    return dt.millis
}

/// Convert a DateTime to a Unix timestamp (seconds since epoch).
/// Does not account for leap seconds.
pub fn (DateTime) to_unix(dt: self) i64 = {
    val y:  i64 = DateTime.year(dt)
    val mo: i64 = DateTime.month(dt)
    val d:  i64 = DateTime.day(dt)
    val h:  i64 = DateTime.hour(dt)
    val mi: i64 = DateTime.minute(dt)
    val s:  i64 = DateTime.second(dt)
    val years_since: i64  = y - 1970
    val leap_days:   i64  = (years_since - 1) / 4
    val days_in_year: i64 = years_since * 365 + leap_days
    val month_days: i64   = (mo - 1) * 30 + (mo - 1) / 2
    val total_days: i64   = days_in_year + month_days + (d - 1)
    return total_days * 86400 + h * 3600 + mi * 60 + s
}

/// Return true if the year is a leap year.
pub fn (DateTime) is_leap_year(dt: self) bool = {
    val y: i64 = DateTime.year(dt)
    if (y % 400 == 0) { return true }
    if (y % 100 == 0) { return false }
    return y % 4 == 0
}

/// Return the number of days in the month of this DateTime.
pub fn (DateTime) days_in_month(dt: self) i64 = {
    val mo:   i64  = DateTime.month(dt)
    val leap: bool = DateTime.is_leap_year(dt)

    if (mo == 2) {
        if (leap) { return 29 }
        return 28
    }
    if (mo == 4 || mo == 6 || mo == 9 || mo == 11) {
        return 30
    }
    return 31
}

/// Return true if two DateTimes represent the same instant (ignoring millis).
pub fn (DateTime) equals(a: self, b: self) bool = {
    val ay: i64 = DateTime.year(a)
    val by: i64 = DateTime.year(b)
    if (ay != by) { return false }

    val amo: i64 = DateTime.month(a)
    val bmo: i64 = DateTime.month(b)
    if (amo != bmo) { return false }

    val ad: i64 = DateTime.day(a)
    val bd: i64 = DateTime.day(b)
    if (ad != bd) { return false }

    val ah: i64 = DateTime.hour(a)
    val bh: i64 = DateTime.hour(b)
    if (ah != bh) { return false }

    val ami: i64 = DateTime.minute(a)
    val bmi: i64 = DateTime.minute(b)
    if (ami != bmi) { return false }

    val as_: i64 = DateTime.second(a)
    val bs_: i64 = DateTime.second(b)
    return as_ == bs_
}

/// Return true if `a` is strictly before `b`.
pub fn (DateTime) before(a: self, b: self) bool = {
    val ua: i64 = DateTime.to_unix(a)
    val ub: i64 = DateTime.to_unix(b)
    return ua < ub
}

/// Return true if `a` is strictly after `b`.
pub fn (DateTime) after(a: self, b: self) bool = {
    val ua: i64 = DateTime.to_unix(a)
    val ub: i64 = DateTime.to_unix(b)
    return ua > ub
}

/// Return the difference in seconds between two DateTimes (a - b).
pub fn (DateTime) diff_seconds(a: self, b: self) i64 = {
    val ua: i64 = DateTime.to_unix(a)
    val ub: i64 = DateTime.to_unix(b)
    return ua - ub
}

test {
    val ac: mut allocators.Arena = trust allocators.Arena.new(10240 as usize)?
    val dt: DateTime = DateTime.new[_](ac, 2026, 4, 2, 14, 30, 0, 0)
    assert DateTime.year(dt)   == 2026
    assert DateTime.month(dt)  == 4
    assert DateTime.day(dt)    == 2
    assert DateTime.hour(dt)   == 14
    assert DateTime.minute(dt) == 30
    assert DateTime.second(dt) == 0
    assert DateTime.millis(dt) == 0
    assert DateTime.is_leap_year(dt) == false
    assert DateTime.days_in_month(dt) == 30

    val dt2: DateTime = DateTime.new[_](ac, 2024, 2, 1, 0, 0, 0, 0)
    assert DateTime.is_leap_year(dt2) == true
    assert DateTime.days_in_month(dt2) == 29
    assert DateTime.before(dt2, dt) == true
    assert DateTime.after(dt, dt2)  == true
    assert DateTime.equals(dt, dt)  == true
    assert unix_now_millis[_](ac) >= unix_now[_](ac) * 1000
    assert unix_now_micros[_](ac) >= unix_now_millis[_](ac) * 1000
    
    trust stdio.print("year: {d}\n", {DateTime.now[_](ac).year})
    trust allocators.Arena.free(ac)
}
