val time     = use("../time")
val stdio    = use("../stdio")
val os       = use("../os")
val terminal = use("../terminal")


pub enum Level = {
    Debug
    Info
    Warn
    Error
    Fatal
}

val colors: mut bool = terminal.is_enabled()
val min_level: mut Level = Level.Debug

pub fn set_colors(c: bool) void = {
    colors = c
}

pub fn set_level(l: Level) void = {
    min_level = l
}

fn should_log(l: Level) bool = {
    return (l as i32) >= (min_level as i32)
}

fn get_time_string() ref u8 = {
    val dt: time.DateTime = time.DateTime.now()
    return trust @fmtalloc("{d}-{d}-{d} {d}:{d}:{d}", {
            time.DateTime.year(dt),
            time.DateTime.month(dt),
            time.DateTime.day(dt),
            time.DateTime.hour(dt),
            time.DateTime.minute(dt),
            time.DateTime.second(dt)}
    )
}

fn log_out(msg: ref u8, label: ref u8, color: terminal.Color) void = trust {
    val ts = get_time_string()
    if colors {
        stdio.print(
            "{s}{s}{s} [{s}{s}{s}] {s}{s}{s}\n",
            {
                terminal.fg(color), ts, terminal.reset(),
                terminal.fg(color), label, terminal.reset(),
                terminal.fg(color), msg, terminal.reset()
            }
        )
    } else {
        stdio.print(
            "{s} [{s}] {s}\n", {ts, label, msg}
        )
    }
}

fn log_err(msg: ref u8, label: ref u8, color: terminal.Color) void = trust {
    val ts = get_time_string()
    if colors {
        stdio.eprint(
            "{s}{s}{s} [{s}{s}{s}] {s}{s}{s}\n",
            {
                terminal.fg(color), ts, terminal.reset(),
                terminal.fg(color), label, terminal.reset(),
                terminal.fg(color), msg, terminal.reset()
            }
        )
    } else {
        stdio.eprint(
            "{s} [{s}] {s}\n", {ts, label, msg}
        )
    }
}

pub fn debug(msg: ref u8) void = {
    if !should_log(Level.Debug) {
        return
    }
    trust log_out(msg, c"DEBUG", terminal.Color.Blue)
}

pub fn info(msg: ref u8) void = {
    if !should_log(Level.Info) {
        return
    }
    trust log_out(msg, c"INFO", terminal.Color.Green)
}

pub fn warn(msg: ref u8) void = {
    if !should_log(Level.Warn) {
        return
    }
    trust log_err(msg, c"WARN", terminal.Color.Yellow)
}

pub fn error(msg: ref u8) void = {
    if !should_log(Level.Error) {
        return
    }
    trust log_err(msg, c"ERROR", terminal.Color.Red)
}

pub fn fatal(msg: ref u8) void = {
    trust log_err(msg, c"FATAL", terminal.Color.Red)
    trust os.exit(1)
}

test "log levels filter messages" {
    set_colors(false)
    set_level(Level.Debug)
    debug(c"This is a debug")
    info(c"This is some info message")
    warn(c"This is some warning")
    error(c"This is an error")
    set_level(Level.Warn)
    set_colors(true)
    debug(c"This should not appear")
    info(c"This should not appear")
    warn(c"This should appear")
    error(c"This should appear")
}
