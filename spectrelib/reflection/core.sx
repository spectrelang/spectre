pub enum Platform = {
    Windows
    Linux
    Darwin
    NetBSD
    DragonflyBSD
    FreeBSD
    OpenBSD
    Android
    Haiku
    Redox
    Plan9
    Unknown
}

when darwin {
    extern type UnameResult = {
        sysname: [256]u8
        nodename: [256]u8
        release: [256]u8
        version: [256]u8
        machine: [256]u8
    }
}

when linux {
    extern type UnameResult = {
        sysname: [65]u8
        nodename: [65]u8
        release: [65]u8
        version: [65]u8
        machine: [65]u8
        domainname: [65]u8
    }
}

when freebsd {
    extern type UnameResult = {
        sysname: [256]u8
        nodename: [256]u8
        release: [256]u8
        version: [256]u8
        machine: [256]u8
    }
}

when openbsd {
    extern type UnameResult = {
        sysname: [256]u8
        nodename: [256]u8
        release: [256]u8
        version: [256]u8
        machine: [256]u8
    }
}

when netbsd {
    extern type UnameResult = {
        sysname: [32]u8
        nodename: [256]u8
        release: [256]u8
        version: [256]u8
        machine: [256]u8
    }
}

val stdio      = use("../stdio")
val cstr       = use("std/string/cstr")
val allocators = use("../allocators")
val env        = use("../env")
val rt         = use("../runtime")

pub fn get_current_platform[T: allocators.Allocator](ac: T) Platform = trust {
    when android {
        return Platform.Android
    }

    when haiku {
        return Platform.Haiku
    }

    when redox {
        return Platform.Redox
    }

    when plan9 {
        return Platform.Plan9
    }

    when windows {
        return Platform.Windows
    }

    when posix {
        val buf: mut UnameResult = {
            sysname: 0,
            nodename: 0,
            release: 0,
            version: 0,
            machine: 0
        }
        val r = rt.uname(@addr(buf))
        if r == 0 {
            val sysname: ref u8 = @addr(buf.sysname) as ref u8
            if cstr.cmp(sysname, c"Linux") == 0 {
                return Platform.Linux
            }
            if cstr.cmp(sysname, c"Darwin") == 0 {
                return Platform.Darwin
            }
            if cstr.cmp(sysname, c"FreeBSD") == 0 {
                return Platform.FreeBSD
            }
            if cstr.cmp(sysname, c"OpenBSD") == 0 {
                return Platform.OpenBSD
            }
            if cstr.cmp(sysname, c"NetBSD") == 0 {
                return Platform.NetBSD
            }
            if cstr.cmp(sysname, c"DragonFly") == 0 {
                return Platform.DragonflyBSD
            }
            if cstr.cmp(sysname, c"Haiku") == 0 {
                return Platform.Haiku
            }
            if cstr.cmp(sysname, c"Redox") == 0 {
                return Platform.Redox
            }
            if cstr.cmp(sysname, c"Plan9") == 0 || cstr.cmp(sysname, c"Plan 9") == 0 {
                return Platform.Plan9
            }
        }
    }

    return Platform.Unknown
}

/// Returns the current platform name as a lowercase string (e.g. "linux", "darwin").
pub fn current_platform_name[T: allocators.Allocator](ac: T) ref u8 = trust {
    val p = get_current_platform[T](ac)
    match p {
        Platform.Linux => {
            return c"linux"
        }
        Platform.Darwin => {
            return c"darwin"
        }
        Platform.FreeBSD => {
            return c"freebsd"
        }
        Platform.OpenBSD => {
            return c"openbsd"
        }
        Platform.NetBSD => {
            return c"netbsd"
        }
        Platform.DragonflyBSD => {
            return c"dragonflybsd"
        }
        Platform.Windows => {
            return c"windows"
        }
        Platform.Android => {
            return c"android"
        }
        Platform.Haiku => {
            return c"haiku"
        }
        Platform.Redox => {
            return c"redox"
        }
        Platform.Plan9 => {
            return c"plan9"
        }
    }
    return c"unknown"
}

/// Returns the current process architecture as a lowercase string
/// (e.g. "x86_64", "aarch64", "riscv64", "x86").
pub fn current_arch_name[T: allocators.Allocator](ac: T) ref u8 = trust {
    when windows {
        val raw: ref u8 = env.get(c"PROCESSOR_ARCHITECTURE")
        if cstr.cmp(raw, c"AMD64") == 0 || cstr.cmp(raw, c"amd64") == 0 {
            return c"x86_64"
        }
        if cstr.cmp(raw, c"ARM64") == 0 || cstr.cmp(raw, c"arm64") == 0 {
            return c"aarch64"
        }
        if cstr.cmp(raw, c"x86") == 0 || cstr.cmp(raw, c"X86") == 0 {
            return c"x86"
        }
        return raw
    }

    when posix {
        val buf: mut UnameResult = {
            sysname: 0,
            nodename: 0,
            release: 0,
            version: 0,
            machine: 0
        }
        val r = rt.uname(@addr(buf))
        if r == 0 {
            val machine: ref u8 = @addr(buf.machine) as ref u8
            if cstr.cmp(machine, c"x86_64") == 0 || cstr.cmp(machine, c"amd64") == 0 {
                return c"x86_64"
            }
            if cstr.cmp(machine, c"aarch64") == 0 || cstr.cmp(machine, c"arm64") == 0 {
                return c"aarch64"
            }
            if cstr.cmp(machine, c"riscv64") == 0 {
                return c"riscv64"
            }
            if cstr.cmp(
                machine,
                c"i386"
            ) == 0 || cstr.cmp(machine, c"i686") == 0 || cstr.cmp(machine, c"x86") == 0 {
                return c"x86"
            }
        }
    }

    return c"unknown"
}

when darwin {
    extern (C) fn _NSGetExecutablePath(buf: ref u8, bufsize: ref u32) i32 = "_NSGetExecutablePath"
}

when windows {
    extern (C, header) fn GetModuleFileNameA(
        module: ref void,
        buf: ref u8,
        size: u32
    ) u32 = "GetModuleFileNameA"
}

/// Returns the absolute path to the current executable.
pub fn get_exe_path[T: allocators.Allocator](ac: T) ref u8 = trust {
    val buf_opt: option[ref u8] = T.alloc(ac, 1024)
    if buf_opt is some buf {
        when darwin {
            val size: mut u32 = 1024 as u32
            val r = _NSGetExecutablePath(buf, @addr(size))
            if r == 0 {
                val resolved: option[ref u8] = T.alloc(ac, 1024)
                if resolved is some rp {
                    val canon: i64 = rt.realpath(buf, rp)
                    if canon != 0 {
                        return rp
                    }
                }
                return buf
            }
        }
        when linux {
            val n = rt.readlink(c"/proc/self/exe", buf, 1024)
            if n > 0 {
                @store8(@ptradd(buf, n), 0)
                return buf
            }
        }
        when freebsd {
            val n = rt.readlink(c"/proc/curproc/file", buf, 1024)
            if n > 0 {
                @store8(@ptradd(buf, n), 0)
                return buf
            }
        }
        when netbsd {
            val n = rt.readlink(c"/proc/curproc/exe", buf, 1024)
            if n > 0 {
                @store8(@ptradd(buf, n), 0)
                return buf
            }
        }
        when windows {
            if GetModuleFileNameA(none, buf, 1024 as u32) != 0 {
                return buf
            }
        }
    }
    return c"."
}

test "reflection returns platform and executable path" {
    val arena: allocators.Arena = trust allocators.Arena.new(10240 as usize)?

    stdio.puts("calling get_current_platform")
    val platform = trust get_current_platform[allocators.Arena](arena)
    trust stdio.print("Current platform: {d}\n", {platform})

    val exe_path = trust get_exe_path[allocators.Arena](arena)
    trust stdio.print("Exe path: {s}\n", {exe_path})

    trust allocators.Arena.free(arena)
}
