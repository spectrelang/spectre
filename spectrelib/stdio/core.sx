val str = use("../string")

extern (C, header) fn fwrite(
    ptr: ref void,
    size: usize,
    nmemb: usize,
    stream: ref void
) usize = "fwrite"

/// Write a borrowed string view to stdout without requiring null termination.
pub fn printv(data: str.StringView) void = trust {
    if data.len > 0 {
        fwrite(data.ptr as ref void, 1 as usize, data.len as usize, @stdout())
    }
}

/// Write a borrowed string view to stderr without requiring null termination.
pub fn eprintv(data: str.StringView) void = trust {
    if data.len > 0 {
        fwrite(data.ptr as ref void, 1 as usize, data.len as usize, @stderr())
    }
}

/// Print a string followed by a newline to stdout.
pub fn puts(data: str.StringView) void = {
    trust printv(data)
    val nl: mut u8 = 10
    trust fwrite(@addr(nl) as ref void, 1 as usize, 1 as usize, @stdout())
}

/// Print a formatted string to stdout.
pub fn print(fmt: str.StringView, args: argspack) void = trust {
    @print(fmt, args)
}

val STD_ERROR_HANDLE: i32 = -12

when windows {
    extern (C, header) fn GetStdHandle(nStdHandle: i32) ref void = "GetStdHandle"
    extern (C, header) fn WriteFile(
        hFile: ref void,
        lpBuffer: ref void,
        nNumberOfBytesToWrite: u32,
        lpNumberOfBytesWritten: ref u32,
        lpOverlapped: ref void
    ) i32 = "WriteFile"
}

/// Print a string to stderr followed by a newline (fd 2).
pub fn eputs(msg: str.StringView) void = {
    trust eprintv(msg)
    val nl: mut u8 = 10
    trust fwrite(@addr(nl) as ref void, 1 as usize, 1 as usize, @stderr())
}

/// Print a string to stderr followed by a newline (fd 2).
pub fn eprint(fmt: str.StringView, args: argspack) void = trust {
    @dprintf(2, fmt, args)
}

/// Read a single character from stdin.
/// Returns -1 on EOF.
pub fn read_key() i32 = trust {
    return @getchar()
}

/// Read a line from stdin into buf.
/// (at most max_len bytes, including null terminator).
/// Returns buf on success, or a null pointer on EOF/error.
pub fn read_line(buf: ref u8, max_len: i64) ref u8 = trust {
    return @fgets(buf, max_len, @stdin())
}

test "stdio reads a line" {
    val buffer: mut ref u8 = c""
    val result = trust read_line(buffer, 100)
    trust print("{s}", result)
}
