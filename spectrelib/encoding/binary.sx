/// Read some u16 from a data pointer (little-endian)
pub fn read_u16_le(data: ref u8, offset: usize) u16 = trust {
    val b0: u16 = @load8(@ptradd(data, offset + (0 as usize))) as u16
    val b1: u16 = @load8(@ptradd(data, offset + (1 as usize))) as u16
    return b0 | (b1 << 8)
}

/// Read some u32 from a data pointer (little-endian)
pub fn read_u32_le(data: ref u8, offset: usize) u32 = trust {
    val b0: u32 = @load8(@ptradd(data, offset + (0 as usize))) as u32
    val b1: u32 = @load8(@ptradd(data, offset + (1 as usize))) as u32
    val b2: u32 = @load8(@ptradd(data, offset + (2 as usize))) as u32
    val b3: u32 = @load8(@ptradd(data, offset + (3 as usize))) as u32
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

/// Read some u64 from a data pointer (little-endian)
pub fn read_u64_le(data: ref u8, offset: usize) u64 = trust {
    val b0: u64 = @load8(@ptradd(data, offset + (0 as usize))) as u64
    val b1: u64 = @load8(@ptradd(data, offset + (1 as usize))) as u64
    val b2: u64 = @load8(@ptradd(data, offset + (2 as usize))) as u64
    val b3: u64 = @load8(@ptradd(data, offset + (3 as usize))) as u64
    val b4: u64 = @load8(@ptradd(data, offset + (4 as usize))) as u64
    val b5: u64 = @load8(@ptradd(data, offset + (5 as usize))) as u64
    val b6: u64 = @load8(@ptradd(data, offset + (6 as usize))) as u64
    val b7: u64 = @load8(@ptradd(data, offset + (7 as usize))) as u64

    return b0
    | (b1 << 8)
    | (b2 << 16)
    | (b3 << 24)
    | (b4 << 32)
    | (b5 << 40)
    | (b6 << 48)
    | (b7 << 56)
}

/// Write some u16 into a data pointer (little-endian)
pub fn write_u16_le(data: ref u8, offset: usize, value: u16) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), (value & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 8) & 255) as u8)
}

/// Write some u32 into a data pointer (little-endian)
pub fn write_u32_le(data: ref u8, offset: usize, value: u32) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), (value & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), ((value >> 24) & 255) as u8)
}

/// Write some u64 into a data pointer (little-endian)
pub fn write_u64_le(data: ref u8, offset: usize, value: u64) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), (value & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), ((value >> 24) & 255) as u8)
    @store8(@ptradd(data, offset + (4 as usize)), ((value >> 32) & 255) as u8)
    @store8(@ptradd(data, offset + (5 as usize)), ((value >> 40) & 255) as u8)
    @store8(@ptradd(data, offset + (6 as usize)), ((value >> 48) & 255) as u8)
    @store8(@ptradd(data, offset + (7 as usize)), ((value >> 56) & 255) as u8)
}

/// Read some u16 from a data pointer (big-endian)
pub fn read_u16_be(data: ref u8, offset: usize) u16 = trust {
    val b0: u16 = @load8(@ptradd(data, offset + (0 as usize))) as u16
    val b1: u16 = @load8(@ptradd(data, offset + (1 as usize))) as u16
    return (b0 << 8) | b1
}

/// Read some u32 from a data pointer (big-endian)
pub fn read_u32_be(data: ref u8, offset: usize) u32 = trust {
    val b0: u32 = @load8(@ptradd(data, offset + (0 as usize))) as u32
    val b1: u32 = @load8(@ptradd(data, offset + (1 as usize))) as u32
    val b2: u32 = @load8(@ptradd(data, offset + (2 as usize))) as u32
    val b3: u32 = @load8(@ptradd(data, offset + (3 as usize))) as u32

    return (b0 << 24)
    | (b1 << 16)
    | (b2 << 8)
    | b3
}

/// Read some u64 from a data pointer (big-endian)
pub fn read_u64_be(data: ref u8, offset: usize) u64 = trust {
    val b0: u64 = @load8(@ptradd(data, offset + (0 as usize))) as u64
    val b1: u64 = @load8(@ptradd(data, offset + (1 as usize))) as u64
    val b2: u64 = @load8(@ptradd(data, offset + (2 as usize))) as u64
    val b3: u64 = @load8(@ptradd(data, offset + (3 as usize))) as u64
    val b4: u64 = @load8(@ptradd(data, offset + (4 as usize))) as u64
    val b5: u64 = @load8(@ptradd(data, offset + (5 as usize))) as u64
    val b6: u64 = @load8(@ptradd(data, offset + (6 as usize))) as u64
    val b7: u64 = @load8(@ptradd(data, offset + (7 as usize))) as u64

    return (b0 << 56)
    | (b1 << 48)
    | (b2 << 40)
    | (b3 << 32)
    | (b4 << 24)
    | (b5 << 16)
    | (b6 << 8)
    | b7
}

/// Write some u16 into a data pointer (big-endian)
pub fn write_u16_be(data: ref u8, offset: usize, value: u16) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), (value & 255) as u8)
}

/// Write some u32 into a data pointer (big-endian)
pub fn write_u32_be(data: ref u8, offset: usize, value: u32) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), ((value >> 24) & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), (value & 255) as u8)
}

/// Write some u64 into a data pointer (big-endian)
pub fn write_u64_be(data: ref u8, offset: usize, value: u64) void = trust {
    @store8(@ptradd(data, offset + (0 as usize)), ((value >> 56) & 255) as u8)
    @store8(@ptradd(data, offset + (1 as usize)), ((value >> 48) & 255) as u8)
    @store8(@ptradd(data, offset + (2 as usize)), ((value >> 40) & 255) as u8)
    @store8(@ptradd(data, offset + (3 as usize)), ((value >> 32) & 255) as u8)
    @store8(@ptradd(data, offset + (4 as usize)), ((value >> 24) & 255) as u8)
    @store8(@ptradd(data, offset + (5 as usize)), ((value >> 16) & 255) as u8)
    @store8(@ptradd(data, offset + (6 as usize)), ((value >> 8) & 255) as u8)
    @store8(@ptradd(data, offset + (7 as usize)), (value & 255) as u8)
}

/// Number of bytes needed to encode an unsigned LEB128 value.
pub fn uleb128_len(value: u64) usize = {
    val remaining: mut u64 = value
    val count: mut usize = 1
    for {
        if remaining < (128 as u64) {
            break
        }
        remaining = remaining >> 7
        count++
    }
    return count
}

/// Write an unsigned LEB128 value at `offset`, returning the byte length.
pub fn write_uleb128(data: ref u8, offset: usize, value: u64) usize = trust {
    val remaining: mut u64 = value
    val written: mut usize = 0
    for {
        val byte: u8 = (remaining & (127 as u64)) as u8
        remaining = remaining >> 7
        if remaining == (0 as u64) {
            @store8(@ptradd(data, offset + written), byte)
            written++
            break
        }
        @store8(@ptradd(data, offset + written), (byte | (128 as u8)) as u8)
        written++
    }
    return written
}

/// Number of bytes needed to encode a signed LEB128 value.
pub fn sleb128_len(value: i64) usize = trust {
    val negative: bool = value < 0
    val all_ones: u64 = @bitcast(-1 as i64, u64)
    val sign_fill: u64 = all_ones << 57
    val bits: mut u64 = @bitcast(value, u64)
    val count: mut usize = 0
    for {
        val byte: u8 = (bits & (127 as u64)) as u8
        bits = bits >> 7
        if negative {
            bits = bits | sign_fill
        }
        val sign_set: bool = (byte & (64 as u8)) != (0 as u8)
        val done: bool = (bits == (0 as u64) && !sign_set)
        || (bits == all_ones && sign_set)
        count++
        if done {
            break
        }
    }
    return count
}

/// Write a signed LEB128 value at `offset`, returning the byte length.
pub fn write_sleb128(data: ref u8, offset: usize, value: i64) usize = trust {
    val negative: bool = value < 0
    val all_ones: u64 = @bitcast(-1 as i64, u64)
    val sign_fill: u64 = all_ones << 57
    val bits: mut u64 = @bitcast(value, u64)
    val written: mut usize = 0
    for {
        val byte: u8 = (bits & (127 as u64)) as u8
        bits = bits >> 7
        if negative {
            bits = bits | sign_fill
        }
        val sign_set: bool = (byte & (64 as u8)) != (0 as u8)
        val done: bool = (bits == (0 as u64) && !sign_set)
        || (bits == all_ones && sign_set)
        if done {
            @store8(@ptradd(data, offset + written), byte)
            written++
            break
        }
        @store8(@ptradd(data, offset + written), (byte | (128 as u8)) as u8)
        written++
    }
    return written
}

test "leb128 writers match their length helpers" {
    val data: [32]u8 = @zeroed

    trust {
        assert uleb128_len(0 as u64) == (1 as usize)
        assert uleb128_len(127 as u64) == (1 as usize)
        assert uleb128_len(128 as u64) == (2 as usize)
        assert uleb128_len(300 as u64) == (2 as usize)
        assert write_uleb128(data as ref u8, 0 as usize, 624485 as u64) == (3 as usize)
        assert @load8(@ptradd(data as ref u8, 0)) == (0xE5 as u8)
        assert @load8(@ptradd(data as ref u8, 1)) == (0x8E as u8)
        assert @load8(@ptradd(data as ref u8, 2)) == (0x26 as u8)

        assert sleb128_len(0 as i64) == (1 as usize)
        assert sleb128_len(63 as i64) == (1 as usize)
        assert sleb128_len(64 as i64) == (2 as usize)
        assert sleb128_len(-64 as i64) == (1 as usize)
        assert sleb128_len(-65 as i64) == (2 as usize)
        assert write_sleb128(data as ref u8, 8 as usize, -123456 as i64) == (3 as usize)
        assert @load8(@ptradd(data as ref u8, 8)) == (0xC0 as u8)
        assert @load8(@ptradd(data as ref u8, 9)) == (0xBB as u8)
        assert @load8(@ptradd(data as ref u8, 10)) == (0x78 as u8)
    }
}
