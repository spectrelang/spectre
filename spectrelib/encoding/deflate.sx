    if index < 0 || index >= 29 {
        return 0
    }
    if index == 0 {
        return 0
    } elif index == 1 {
        return 0
    } elif index == 2 {
        return 0
    } elif index == 3 {
        return 0
    } elif index == 4 {
        return 0
    } elif index == 5 {
        return 0
    } elif index == 6 {
        return 0
    } elif index == 7 {
        return 0
    } elif index == 8 {
        return 1
    } elif index == 9 {
        return 1
    } elif index == 10 {
        return 1
    } elif index == 11 {
        return 1
    } elif index == 12 {
        return 2
    } elif index == 13 {
        return 2
    } elif index == 14 {
        return 2
    } elif index == 15 {
        return 2
    } elif index == 16 {
        return 3
    } elif index == 17 {
        return 3
    } elif index == 18 {
        return 3
    } elif index == 19 {
        return 3
    } elif index == 20 {
        return 4
    } elif index == 21 {
        return 4
    } elif index == 22 {
        return 4
    } elif index == 23 {
        return 4
    } elif index == 24 {
        return 5
    } elif index == 25 {
        return 5
    } elif index == 26 {
        return 5
    } elif index == 27 {
        return 5
    } elif index == 28 {
        return 0
    }
    return 0
}

fn dist_base(index: i64) i64 = {
    if index < 0 || index >= 30 {
        return 0
    }
    if index == 0 {
        return 1
    } elif index == 1 {
        return 2
    } elif index == 2 {
        return 3
    } elif index == 3 {
        return 4
    } elif index == 4 {
        return 5
    } elif index == 5 {
        return 7
    } elif index == 6 {
        return 9
    } elif index == 7 {
        return 13
    } elif index == 8 {
        return 17
    } elif index == 9 {
        return 25
    } elif index == 10 {
        return 33
    } elif index == 11 {
        return 49
    } elif index == 12 {
        return 65
    } elif index == 13 {
        return 97
    } elif index == 14 {
        return 129
    } elif index == 15 {
        return 193
    } elif index == 16 {
        return 257
    } elif index == 17 {
        return 385
    } elif index == 18 {
        return 513
    } elif index == 19 {
        return 769
    } elif index == 20 {
        return 1025
    } elif index == 21 {
        return 1537
    } elif index == 22 {
        return 2049
    } elif index == 23 {
        return 3073
    } elif index == 24 {
        return 4097
    } elif index == 25 {
        return 6145
    } elif index == 26 {
        return 8193
    } elif index == 27 {
        return 12289
    } elif index == 28 {
        return 16385
    } elif index == 29 {
        return 24577
    }
    return 0
}

fn dist_extra(index: i64) i64 = {
    if index < 0 || index >= 30 {
        return 0
    }
    if index == 0 {
        return 0
    } elif index == 1 {
        return 0
    } elif index == 2 {
        return 0
    } elif index == 3 {
        return 0
    } elif index == 4 {
        return 1
    } elif index == 5 {
        return 1
    } elif index == 6 {
        return 2
    } elif index == 7 {
        return 2
    } elif index == 8 {
