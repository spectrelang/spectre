/// DEFLATE / zlib decompression.
///
/// This module implements the RFC 1950 (zlib) and RFC 1951 (DEFLATE)
/// formats without relying on a platform-specific compression library.  It
/// is used by the dependency fetcher to unpack git objects, but it is a
/// general-purpose utility and can be used anywhere a zlib stream needs to
/// be decoded.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val allocators = use("../allocators")

pub enum DeflateError = {
    OutOfMemory
    InvalidHeader
    InvalidData
    UnexpectedSize
}

type Huffman = {
    table: mut ref void
    max_bits: mut i64
}

type BitReader = {
    data: mut ref u8
    len: mut i64
    bit_pos: mut i64
    failed: mut bool
}

fn length_base(index: i64) i64 = {
    if index < 0 || index >= 29 {
        return 0
    }
    if index == 0 {
        return 3
    } elif index == 1 {
        return 4
    } elif index == 2 {
        return 5
    } elif index == 3 {
        return 6
    } elif index == 4 {
        return 7
    } elif index == 5 {
        return 8
    } elif index == 6 {
        return 9
    } elif index == 7 {
        return 10
    } elif index == 8 {
        return 11
    } elif index == 9 {
        return 13
    } elif index == 10 {
        return 15
    } elif index == 11 {
        return 17
    } elif index == 12 {
        return 19
    } elif index == 13 {
        return 23
    } elif index == 14 {
        return 27
    } elif index == 15 {
        return 31
    } elif index == 16 {
        return 35
    } elif index == 17 {
        return 43
    } elif index == 18 {
        return 51
    } elif index == 19 {
        return 59
    } elif index == 20 {
        return 67
    } elif index == 21 {
        return 83
    } elif index == 22 {
        return 99
    } elif index == 23 {
        return 115
    } elif index == 24 {
        return 131
    } elif index == 25 {
        return 163
    } elif index == 26 {
        return 195
    } elif index == 27 {
        return 227
    } elif index == 28 {
        return 258
    }
    return 0
}

