/// Spectre-owned freestanding runtime core.
///
/// This module implements allocation and string primitives directly in
/// Spectre.  It calls only the small `__sx_sys_*` boundary in
/// `spectrelib/csources/freestanding/runtime.c` for memory mapping.
///
/// Functions named `sx_*` are exported with their exact names by the compiler
/// so the C boundary, the standard library, and generated code can share one
/// stable ABI.

extern (C) fn __sx_sys_mmap(size: usize) ref void = "__sx_sys_mmap"
extern (C) fn __sx_sys_munmap(ptr: ref void, size: usize) void = "__sx_sys_munmap"
extern (C) fn __sx_sys_open(path: ref u8, flags: i64, mode: i64) i64 = "__sx_sys_open"
extern (C) fn __sx_sys_read(fd: i64, buf: ref void, n: usize) i64 = "__sx_sys_read"
extern (C) fn __sx_sys_write(fd: i64, buf: ref void, n: usize) i64 = "__sx_sys_write"
extern (C) fn __sx_sys_close(fd: i64) i64 = "__sx_sys_close"
extern (C) fn __sx_sys_lseek(fd: i64, off: i64, whence: i64) i64 = "__sx_sys_lseek"
extern (C) fn __sx_sys_stdio(which: i64) i64 = "__sx_sys_stdio"
extern (C) fn __sx_sys_clock_us() i64 = "__sx_sys_clock_us"
extern (C) fn __sx_sys_nanosleep_us(us: i64) i64 = "__sx_sys_nanosleep_us"
extern (C) fn __sx_sys_gettid() i64 = "__sx_sys_gettid"
extern (C) fn __sx_sys_sched_yield() i64 = "__sx_sys_sched_yield"
extern (C) fn __sx_sys_futex(addr: i64, op: i64, value: i64, timeout: i64) i64 = "__sx_sys_futex"
extern (C) fn __sx_sys_clone_thread(
    flags: i64,
    stack: ref void,
    entry: ref void,
    arg: ref void
) i64 = "__sx_sys_clone_thread"
extern (C) fn __sx_sys_create_thread(entry: ref void, arg: ref void) i64 = "__sx_sys_create_thread"
extern (C) fn __sx_sys_wait_thread(handle: i64) i64 = "__sx_sys_wait_thread"
extern (C) fn __sx_sys_detach_thread(handle: i64) i64 = "__sx_sys_detach_thread"
extern (C) fn __sx_sys_getenv(name: ref u8, out: ref u8, cap: usize) i64 = "__sx_sys_getenv"
extern (C) fn __sx_sys_getcwd(buf: ref u8, cap: usize) i64 = "__sx_sys_getcwd"
extern (C) fn __sx_sys_chdir(path: ref u8) i64 = "__sx_sys_chdir"
extern (C) fn __sx_sys_access(path: ref u8, mode: i64) i64 = "__sx_sys_access"
extern (C) fn __sx_sys_mkdir(path: ref u8, mode: i64) i64 = "__sx_sys_mkdir"
extern (C) fn __sx_sys_rmdir(path: ref u8) i64 = "__sx_sys_rmdir"
extern (C) fn __sx_sys_remove(path: ref u8) i64 = "__sx_sys_remove"
extern (C) fn __sx_sys_rename(oldpath: ref u8, newpath: ref u8) i64 = "__sx_sys_rename"
extern (C) fn __sx_sys_readlink(path: ref u8, buf: ref u8, cap: usize) i64 = "__sx_sys_readlink"
extern (C) fn __sx_sys_isatty(fd: i64) i64 = "__sx_sys_isatty"
extern (C) fn __sx_sys_realpath(path: ref u8, out: ref u8, cap: usize) i64 = "__sx_sys_realpath"
extern (C) fn __sx_sys_stat(path: ref u8, buf: ref void) i64 = "__sx_sys_stat"
extern (C) fn __sx_sys_opendir(path: ref u8) ref void = "__sx_sys_opendir"
extern (C) fn __sx_sys_readdir(dir: ref void) ref void = "__sx_sys_readdir"
extern (C) fn __sx_sys_closedir(dir: ref void) i64 = "__sx_sys_closedir"
extern (C) fn __sx_sys_exit(code: i64) void = "__sx_sys_exit"
extern (C) fn __sx_sys_getrandom(buf: ref void, n: usize) i64 = "__sx_sys_getrandom"
extern (C) fn __sx_sys_uname(buf: ref void) i64 = "__sx_sys_uname"

val heap_base: mut ref u8 = none
val heap_used: mut usize = 0
val heap_cap: mut usize = 0
val HEAP_CHUNK: usize = 1048576

fn align16(n: usize) usize = {
    return ((n + 15) / 16) * 16
}

fn map_chunk(n: usize) ref u8 = trust {
    val rounded: usize = ((n + 4095) / 4096) * 4096
    return __sx_sys_mmap(rounded) as ref u8
}

fn r_alloc(n: usize) ref void = trust {
    val total: usize = align16(n) + 16
    if heap_base == none || heap_used + total > heap_cap {
        val cap: mut usize = HEAP_CHUNK
        if total > cap {
            cap = total
        }
        val fresh: ref u8 = map_chunk(cap)
        if fresh == none {
            return none
        }
        heap_base = fresh
        heap_used = 0
        heap_cap = cap
    }
    val raw: ref u8 = @ptradd(heap_base, heap_used as i64) as ref u8
    heap_used = heap_used + total
    @store(raw, n)
    return @ptradd(raw, 16) as ref void
}

fn r_calloc(count: usize, size: usize) ref void = trust {
    val n: usize = count * size
    val p: ref void = r_alloc(n)
    if p != none && n > 0 {
        r_memset(p, 0, n)
    }
    return p
}

fn r_free(ptr: ref void) void = trust {
    if ptr == none {
        return
    }
    // The bump allocator keeps small objects in chunks and releases in bulk.
}

fn r_realloc(ptr: ref void, n: usize) ref void = trust {
    if ptr == none {
        return r_alloc(n)
    }
    if n == 0 {
        r_free(ptr)
        return none
    }
    val header: ref void = @ptradd(ptr, -16)
    val old: usize = @load(header) as usize
    val fresh: ref void = r_alloc(n)
    if fresh == none {
        return none
    }
    val copy_len: mut usize = old
    if n < copy_len {
        copy_len = n
    }
    r_memcpy(fresh, ptr, copy_len)
    return fresh
}

fn r_memcpy(dst: ref void, src: ref void, n: usize) ref void = trust {
    val d: ref u8 = dst as ref u8
    val s: ref u8 = src as ref u8
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        @store8(@ptradd(d, i as i64), @load8(@ptradd(s, i as i64)))
        i = i + 1
    }
    return dst
}

fn r_memmove(dst: ref void, src: ref void, n: usize) ref void = trust {
    if dst == src || n == 0 {
        return dst
    }
    val d: ref u8 = dst as ref u8
    val s: ref u8 = src as ref u8
    if d < s {
        return r_memcpy(dst, src, n)
    }
    val i: mut usize = n
    for {
        if i == 0 {
            break
        }
        i = i - 1
        @store8(@ptradd(d, i as i64), @load8(@ptradd(s, i as i64)))
    }
    return dst
}

fn r_memset(dst: ref void, value: i32, n: usize) ref void = trust {
    val d: ref u8 = dst as ref u8
    val v: u8 = value as u8
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        @store8(@ptradd(d, i as i64), v)
        i = i + 1
    }
    return dst
}

fn r_memcmp(a: ref void, b: ref void, n: usize) i32 = trust {
    val x: ref u8 = a as ref u8
    val y: ref u8 = b as ref u8
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        val xa: u8 = @load8(@ptradd(x, i as i64))
        val yb: u8 = @load8(@ptradd(y, i as i64))
        if xa != yb {
            return (xa as i32) - (yb as i32)
        }
        i = i + 1
    }
    return 0
}

fn r_strlen(s: ref u8) i64 = trust {
    if s == none {
        return 0
    }
    val n: mut i64 = 0
    for {
        if @load8(@ptradd(s, n)) == 0 {
            break
        }
        n = n + 1
    }
    return n
}

fn r_strcmp(a: ref u8, b: ref u8) i32 = trust {
    val x: mut ref u8 = a
    val y: mut ref u8 = b
    if x == none {
        x = c""
    }
    if y == none {
        y = c""
    }
    val i: mut i64 = 0
    for {
        val xa: u8 = @load8(@ptradd(x, i))
        val yb: u8 = @load8(@ptradd(y, i))
        if xa != yb {
            return (xa as i32) - (yb as i32)
        }
        if xa == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

fn r_strncmp(a: ref u8, b: ref u8, n: usize) i32 = trust {
    val x: mut ref u8 = a
    val y: mut ref u8 = b
    if x == none {
        x = c""
    }
    if y == none {
        y = c""
    }
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        val xa: u8 = @load8(@ptradd(x, i as i64))
        val yb: u8 = @load8(@ptradd(y, i as i64))
        if xa != yb {
            return (xa as i32) - (yb as i32)
        }
        if xa == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

fn r_strcpy(dst: ref u8, src: ref u8) ref u8 = trust {
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(src, i))
        @store8(@ptradd(dst, i), ch)
        if ch == 0 {
            break
        }
        i = i + 1
    }
    return dst
}

fn r_strcat(dst: ref u8, src: ref u8) ref u8 = trust {
    val start: i64 = r_strlen(dst)
    r_strcpy(@ptradd(dst, start) as ref u8, src)
    return dst
}

fn r_strchr(s: ref u8, c: i32) ref u8 = trust {
    if s == none {
        return none
    }
    val want: u8 = c as u8
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch == want {
            return @ptradd(s, i) as ref u8
        }
        if ch == 0 {
            return none
        }
        i = i + 1
    }
    return none
}

fn r_strrchr(s: ref u8, c: i32) ref u8 = trust {
    if s == none {
        return none
    }
    val want: u8 = c as u8
    val last: mut ref u8 = none
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch == want {
            last = @ptradd(s, i) as ref u8
        }
        if ch == 0 {
            break
        }
        i = i + 1
    }
    return last
}

fn r_strstr(haystack: ref u8, needle: ref u8) ref u8 = trust {
    if haystack == none || needle == none {
        return none
    }
    if @load8(needle) == 0 {
        return haystack
    }
    val h: mut i64 = 0
    for {
        if @load8(@ptradd(haystack, h)) == 0 {
            return none
        }
        val n: mut i64 = 0
        for {
            val nc: u8 = @load8(@ptradd(needle, n))
            if nc == 0 {
                return @ptradd(haystack, h) as ref u8
            }
            val hc: u8 = @load8(@ptradd(haystack, h + n))
            if hc != nc {
                break
            }
            n = n + 1
        }
        h = h + 1
    }
    return none
}

fn r_strdup(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val n: i64 = r_strlen(s)
    val out: ref u8 = r_alloc((n + 1) as usize) as ref u8
    if out == none {
        return none
    }
    r_memcpy(out as ref void, s as ref void, (n + 1) as usize)
    return out
}

fn r_strtok_r(s: ref u8, delim: ref u8, save: ref ref u8) ref u8 = trust {
    if delim == none || save == none {
        return none
    }
    val cursor: mut ref u8 = s
    if cursor == none {
        cursor = @load(save)
    }
    if cursor == none {
        return none
    }
    for {
        val ch: u8 = @load8(cursor)
        if ch == 0 {
            @store(save, cursor)
            return none
        }
        if r_strchr(delim, ch as i32) != none {
            cursor = @ptradd(cursor, 1) as ref u8
        } else {
            break
        }
    }
    val start: ref u8 = cursor
    for {
        val ch: u8 = @load8(cursor)
        if ch == 0 {
            @store(save, cursor)
            return start
        }
        if r_strchr(delim, ch as i32) != none {
            @store8(cursor, 0)
            @store(save, @ptradd(cursor, 1) as ref u8)
            return start
        }
        cursor = @ptradd(cursor, 1) as ref u8
    }
    return start
}

fn r_atoi(s: ref u8) i32 = trust {
    if s == none {
        return 0
    }
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            i = i + 1
        } else {
            break
        }
    }
    val sign: mut i32 = 1
    val ch0: u8 = @load8(@ptradd(s, i))
    if ch0 == 45 {
        sign = -1
        i = i + 1
    } elif ch0 == 43 {
        i = i + 1
    }
    val value: mut i32 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch < 48 || ch > 57 {
            break
        }
        value = value * 10 + ((ch as i32) - 48)
        i = i + 1
    }
    return sign * value
}

fn r_isdigit(c: i32) i32 = trust {
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

fn r_strtol(s: ref u8, end: ref ref u8, base: i32) i64 = trust {
    if s == none {
        if end != none {
            @store(end, s)
        }
        return 0
    }
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            i = i + 1
        } else {
            break
        }
    }
    val sign: mut i64 = 1
    val ch0: u8 = @load8(@ptradd(s, i))
    if ch0 == 45 {
        sign = -1
        i = i + 1
    } elif ch0 == 43 {
        i = i + 1
    }
    val radix: mut i64 = base as i64
    if radix == 0 {
        radix = 10
    }
    val value: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        val digit: mut i64 = -1
        if ch >= 48 && ch <= 57 {
            digit = (ch as i64) - 48
        } elif ch >= 97 && ch <= 102 {
            digit = (ch as i64) - 97 + 10
        } elif ch >= 65 && ch <= 70 {
            digit = (ch as i64) - 65 + 10
        }
        if digit < 0 || digit >= radix {
            break
        }
        value = value * radix + digit
        i = i + 1
    }
    if end != none {
        @store(end, @ptradd(s, i) as ref u8)
    }
    return sign * value
}


// ---------------------------------------------------------------------------
// File layer
// ---------------------------------------------------------------------------

type SxFile = {
    fd: mut i64
    eof: mut i32
    ungot: mut i32
    is_std: mut i32
}

val std_in_file: mut ref SxFile = none
val std_out_file: mut ref SxFile = none
val std_err_file: mut ref SxFile = none

fn new_file(fd: i64, is_std: i32) ref SxFile = trust {
    val f: mut ref SxFile = r_alloc(@sizeof(SxFile)) as ref SxFile
    if f == none {
        return none
    }
    f.fd = fd
    f.eof = 0
    f.ungot = -1
    f.is_std = is_std
    return f
}

fn r_fopen(path: ref u8, mode: ref u8) ref void = trust {
    if path == none || mode == none {
        return none
    }
    val c0: u8 = @load8(mode)
    val plus: bool = @load8(@ptradd(mode, 1)) == 43
    val flags: mut i64 = 0
    if c0 == 114 {
        if plus {
            flags = 2
        } else {
            flags = 0
        }
    } elif c0 == 119 {
        flags = 4 | 8
        if plus {
            flags = flags | 2
        } else {
            flags = flags | 1
        }
    } elif c0 == 97 {
        flags = 4 | 16
        if plus {
            flags = flags | 2
        } else {
            flags = flags | 1
        }
    } else {
        flags = 0
    }
    val fd: i64 = __sx_sys_open(path, flags, 438)
    if fd < 0 {
        return none
    }
    return new_file(fd, 0) as ref void
}

fn r_fclose(fp: ref void) i32 = trust {
    if fp == none {
        return -1
    }
    val f: ref SxFile = fp as ref SxFile
    if f.is_std == 0 {
        __sx_sys_close(f.fd)
        r_free(fp)
    }
    return 0
}

fn r_fread(ptr: ref void, size: usize, count: usize, fp: ref void) usize = trust {
    if ptr == none || fp == none || size == 0 {
        return 0
    }
    val f: mut ref SxFile = fp as ref SxFile
    val total: usize = size * count
    val out: ref u8 = ptr as ref u8
    val done: mut usize = 0
    if f.ungot >= 0 && total > 0 {
        @store8(out, f.ungot as u8)
        f.ungot = -1
        done = 1
    }
    for {
        if done >= total {
            break
        }
        val n: i64 = __sx_sys_read(f.fd, @ptradd(ptr, done as i64), total - done)
        if n <= 0 {
            f.eof = 1
            break
        }
        done = done + (n as usize)
    }
    return done / size
}

fn r_fwrite(ptr: ref void, size: usize, count: usize, fp: ref void) usize = trust {
    if ptr == none || fp == none || size == 0 {
        return 0
    }
    val f: ref SxFile = fp as ref SxFile
    val total: usize = size * count
    val done: mut usize = 0
    for {
        if done >= total {
            break
        }
        val n: i64 = __sx_sys_write(f.fd, @ptradd(ptr, done as i64), total - done)
        if n <= 0 {
            break
        }
        done = done + (n as usize)
    }
    return done / size
}

fn r_fseek(fp: ref void, offset: i64, whence: i32) i32 = trust {
    if fp == none {
        return -1
    }
    val f: mut ref SxFile = fp as ref SxFile
    val r: i64 = __sx_sys_lseek(f.fd, offset, whence as i64)
    f.eof = 0
    if r < 0 {
        return -1
    }
    return 0
}

fn r_ftell(fp: ref void) i64 = trust {
    if fp == none {
        return -1
    }
    val f: ref SxFile = fp as ref SxFile
    return __sx_sys_lseek(f.fd, 0, 1)
}

fn r_rewind(fp: ref void) void = trust {
    if fp != none {
        r_fseek(fp, 0, 0)
    }
}

fn r_fflush(_: ref void) i32 = trust {
    return 0
}

fn r_fgetc(fp: ref void) i32 = trust {
    if fp == none {
        return -1
    }
    val f: mut ref SxFile = fp as ref SxFile
    if f.ungot >= 0 {
        val r: i32 = f.ungot
        f.ungot = -1
        return r
    }
    val b: ref u8 = r_alloc(1) as ref u8
    if b == none {
        return -1
    }
    val n: i64 = __sx_sys_read(f.fd, b, 1)
    if n != 1 {
        f.eof = 1
        r_free(b)
        return -1
    }
    val v: i32 = @load8(b) as i32
    r_free(b)
    return v
}

fn r_getchar() i32 = trust {
    return r_fgetc(r_stdin())
}

fn r_fputc(c: i32, fp: ref void) i32 = trust {
    if fp == none {
        return -1
    }
    val f: ref SxFile = fp as ref SxFile
    val b: ref u8 = r_alloc(1) as ref u8
    if b == none {
        return -1
    }
    @store8(b, c as u8)
    val n: i64 = __sx_sys_write(f.fd, b, 1)
    r_free(b)
    if n != 1 {
        return -1
    }
    return c
}

fn r_putchar(c: i32) i32 = trust {
    return r_fputc(c, r_stdout())
}

fn r_fgets(buf: ref u8, n: i32, fp: ref void) ref u8 = trust {
    if buf == none || n <= 0 || fp == none {
        return none
    }
    val i: mut i32 = 0
    for {
        if i >= n - 1 {
            break
        }
        val c: i32 = r_fgetc(fp)
        if c < 0 {
            break
        }
        @store8(@ptradd(buf, i as i64), c as u8)
        i = i + 1
        if c == 10 {
            break
        }
    }
    if i == 0 {
        return none
    }
    @store8(@ptradd(buf, i as i64), 0)
    return buf
}

fn r_fputs(s: ref u8, fp: ref void) i32 = trust {
    if s == none || fp == none {
        return -1
    }
    val n: i64 = r_strlen(s)
    return (r_fwrite(s as ref void, 1, n as usize, fp) as i32) * 1
}

fn r_fdopen(fd: i32, _: ref u8) ref void = trust {
    return new_file(fd as i64, 0) as ref void
}

fn r_fileno(fp: ref void) i32 = trust {
    if fp == none {
        return -1
    }
    return (fp as ref SxFile).fd as i32
}

fn r_feof(fp: ref void) i32 = trust {
    if fp == none {
        return 0
    }
    return (fp as ref SxFile).eof
}

fn r_ferror(_: ref void) i32 = trust {
    return 0
}

fn r_stdin() ref void = trust {
    if std_in_file == none {
        std_in_file = new_file(__sx_sys_stdio(0), 1)
    }
    return std_in_file as ref void
}

fn r_stdout() ref void = trust {
    if std_out_file == none {
        std_out_file = new_file(__sx_sys_stdio(1), 1)
    }
    return std_out_file as ref void
}

fn r_stderr() ref void = trust {
    if std_err_file == none {
        std_err_file = new_file(__sx_sys_stdio(2), 1)
    }
    return std_err_file as ref void
}

// ---------------------------------------------------------------------------
// Time layer
// ---------------------------------------------------------------------------

val tm_storage: mut ref u8 = none

fn r_gettimeofday(tv: ref void, _: ref void) i32 = trust {
    val us: i64 = __sx_sys_clock_us()
    if tv != none {
        @store(tv, us / 1000000)
        @store(@ptradd(tv, 8), us % 1000000)
    }
    return 0
}

fn r_localtime(t: ref i64) ref void = trust {
    if tm_storage == none {
        tm_storage = r_alloc(88) as ref u8
        if tm_storage == none {
            return none
        }
    }
    val stamp: i64 = @load(t) as i64
    val days: i64 = stamp / 86400
    val rem: mut i64 = stamp % 86400
    if rem < 0 {
        rem = rem + 86400
    }
    @store32(tm_storage, rem % 60)
    @store32(@ptradd(tm_storage, 4), (rem / 60) % 60)
    @store32(@ptradd(tm_storage, 8), rem / 3600)
    val year: mut i64 = 1970
    val d: mut i64 = days
    for {
        val leap: bool = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
        val ylen: mut i64 = 365
        if leap {
            ylen = 366
        }
        if d < ylen {
            break
        }
        d = d - ylen
        year = year + 1
    }
    val leap2: bool = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
    val month: mut i64 = 0
    for {
        if month >= 12 {
            break
        }
        val md: mut i64 = 31
        if month == 1 {
            if leap2 {
                md = 29
            } else {
                md = 28
            }
        } elif month == 3 || month == 5 || month == 8 || month == 10 {
            md = 30
        }
        if d < md {
            break
        }
        d = d - md
        month = month + 1
    }
    @store32(@ptradd(tm_storage, 12), d + 1)
    @store32(@ptradd(tm_storage, 16), month)
    @store32(@ptradd(tm_storage, 20), year - 1900)
    return tm_storage as ref void
}

fn r_usleep(usec: u32) i32 = trust {
    return __sx_sys_nanosleep_us(usec as i64) as i32
}

fn r_sleep(seconds: u32) i32 = trust {
    return r_usleep(seconds * 1000000)
}

fn r_time(out: ref i64) i64 = trust {
    val sec: i64 = __sx_sys_clock_us() / 1000000
    if out != none {
        @store(out, sec)
    }
    return sec
}

// ---------------------------------------------------------------------------
// Thread layer
// ---------------------------------------------------------------------------

type SxThread = {
    fnptr: mut usize
    arg: mut ref void
    done: mut i32
    result: mut ref void
    stack: mut ref void
    stack_size: mut usize
    tid: mut i64
}

fn thread_entry(p: ref void) ref void = trust {
    val t: mut ref SxThread = p as ref SxThread
    val f: fn(ref void) ref void = @bitcast(t.fnptr, fn(ref void) ref void)
    t.result = @call(f, t.arg)
    t.done = 1
    __sx_sys_futex(@bitcast(@addr(t.done), i64), 1, 1, 0)
    return t.result
}

fn r_pthread_create(thread: ref void, _: ref void, entry: usize, arg: ref void) i32 = trust {
    val t: mut ref SxThread = r_calloc(1, @sizeof(SxThread)) as ref SxThread
    if t == none {
        return -1
    }
    t.fnptr = entry
    t.arg = arg
    t.stack_size = 1048576
    t.stack = __sx_sys_mmap(t.stack_size)
    if t.stack == none {
        r_free(t)
        return -1
    }
    val entry_ptr: ref void = @bitcast(thread_entry as usize, ref void)
    when windows {
        if t.stack != none {
            __sx_sys_munmap(t.stack, t.stack_size)
            t.stack = none
        }
        val handle: i64 = __sx_sys_create_thread(entry_ptr, t as ref void)
        if handle < 0 {
            r_free(t)
            return -1
        }
        t.tid = handle
    }
    otherwise {
        val top: ref void = @ptradd(t.stack, t.stack_size as i64) as ref void
        val tid: i64 = __sx_sys_clone_thread(0x50F00, top, entry_ptr, t as ref void)
        if tid < 0 {
            __sx_sys_munmap(t.stack, t.stack_size)
            r_free(t)
            return -1
        }
        t.tid = tid
    }
    @store(thread, t as ref void)
    return 0
}

fn r_pthread_join(thread: ref void, retval: ref void) i32 = trust {
    if thread == none {
        return -1
    }
    val t: mut ref SxThread = thread as ref SxThread
    when windows {
        __sx_sys_wait_thread(t.tid)
    }
    otherwise {
        for {
            if t.done != 0 {
                break
            }
            __sx_sys_futex(@bitcast(@addr(t.done), i64), 0, 0, 0)
        }
        __sx_sys_munmap(t.stack, t.stack_size)
    }
    if retval != none {
        @store(retval, t.result)
    }
    r_free(t)
    return 0
}

fn r_pthread_detach(thread: ref void) i32 = trust {
    if thread == none {
        return 0
    }
    when windows {
        if thread != none {
            val t: ref SxThread = thread as ref SxThread
            __sx_sys_detach_thread(t.tid)
        }
    }
    return 0
}

fn r_pthread_self() ref void = trust {
    return @bitcast(__sx_sys_gettid() as usize, ref void)
}

fn r_sched_yield() i32 = trust {
    return __sx_sys_sched_yield() as i32
}

fn r_mutex_init(m: ref void) i32 = trust {
    if m != none {
        @store32(m, 0)
    }
    return 0
}

fn r_mutex_destroy(_: ref void) i32 = trust {
    return 0
}

fn r_mutex_lock(m: ref void) i32 = trust {
    if m == none {
        return -1
    }
    for {
        if @load32(m) == 0 {
            break
        }
    }
    @store32(m, 1)
    return 0
}

fn r_mutex_unlock(m: ref void) i32 = trust {
    if m != none {
        @store32(m, 0)
    }
    return 0
}


// ---------------------------------------------------------------------------
// Formatting layer
// ---------------------------------------------------------------------------

fn fmt_putc(buf: ref u8, cap: i64, pos: ref i64, ch: u8) void = trust {
    if @load(pos) + 1 < cap {
        @store8(@ptradd(buf, @load(pos)), ch)
    }
    @store(pos, @load(pos) + 1)
}

fn fmt_puts(buf: ref u8, cap: i64, pos: ref i64, s: mut ref u8) void = trust {
    if s == none {
        s = c"(null)"
    }
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(s, i))
        if ch == 0 {
            break
        }
        fmt_putc(buf, cap, pos, ch)
        i = i + 1
    }
}

fn fmt_puts_n(buf: ref u8, cap: i64, pos: ref i64, s: ref u8, n: i64) void = trust {
    val str: mut ref u8 = s
    if str == none {
        str = c"(null)"
    }
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val ch: u8 = @load8(@ptradd(str, i))
        if ch == 0 {
            break
        }
        fmt_putc(buf, cap, pos, ch)
        i = i + 1
    }
}

fn fmt_str(
    buf: ref u8,
    cap: i64,
    pos: ref i64,
    s: ref u8,
    width: i64,
    precision: i64,
    left: bool
) void = trust {
    val str: mut ref u8 = s
    if str == none {
        str = c"(null)"
    }
    val full: i64 = r_strlen(str)
    val n: mut i64 = full
    if precision >= 0 && precision < n {
        n = precision
    }
    val pad: mut i64 = width - n
    if pad < 0 {
        pad = 0
    }
    if !left {
        for k = 0, k < pad, k++ {
            fmt_putc(buf, cap, pos, 32)
        }
    }
    fmt_puts_n(buf, cap, pos, str, n)
    if left {
        for k = 0, k < pad, k++ {
            fmt_putc(buf, cap, pos, 32)
        }
    }
}

fn udivmod_small(value: u64, base: u64, rem: ref u64) u64 = trust {
    val hi: u64 = value >> 32
    val lo: u64 = value & 0xffffffff
    val qhi: u64 = hi / base
    val r1: u64 = hi % base
    val mid: u64 = (r1 << 32) | lo
    val qlo: u64 = mid / base
    @store(rem, mid % base)
    return (qhi << 32) | qlo
}

fn fmt_uint_text(value: u64, base: u64, upper: bool, tmp: ref u8) i64 = trust {
    val v: mut u64 = value
    val lower = c"0123456789abcdef"
    val upper_chars = c"0123456789ABCDEF"
    val digits: mut ref u8 = lower
    if upper {
        digits = upper_chars
    }
    val n: mut i64 = 0
    if v == 0 {
        @store8(tmp, 48)
        @store8(@ptradd(tmp, 1), 0)
        return 1
    }
    val rev: mut [66]u8 = @zeroed
    val rem: mut u64 = 0
    for {
        if v == 0 {
            break
        }
        v = udivmod_small(v, base, @addr(rem))
        @store8(@ptradd(@addr(rev) as ref u8, n), @load8(@ptradd(digits, rem as i64)))
        n = n + 1
    }
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        @store8(@ptradd(tmp, i), @load8(@ptradd(@addr(rev) as ref u8, n - 1 - i)))
        i = i + 1
    }
    @store8(@ptradd(tmp, n), 0)
    return n
}

fn fmt_int(buf: ref u8, cap: i64, pos: ref i64, value: i64, base: u64, upper: bool,
    width: i64, precision: i64, zero: bool, left: bool, plus: bool, space: bool) void = trust {
    val tmp: mut [80]u8 = @zeroed
    val neg: bool = value < 0
    val mag: mut u64 = value as u64
    if neg {
        mag = (0 - value) as u64
    }
    val n: i64 = fmt_uint_text(mag, base, upper, @addr(tmp) as ref u8)
    val digits: i64 = n
    val sign_len: mut i64 = 0
    if neg || plus || space {
        sign_len = 1
    }
    val total: i64 = sign_len + digits
    val pad: mut i64 = width - total
    if precision > digits {
        pad = pad - (precision - digits)
    }
    if !left && pad > 0 && !zero {
        val k: mut i64 = 0
        for {
            if k >= pad {
                break
            }
            fmt_putc(buf, cap, pos, 32)
            k = k + 1
        }
    }
    if neg {
        fmt_putc(buf, cap, pos, 45)
    } elif plus {
        fmt_putc(buf, cap, pos, 43)
    } elif space {
        fmt_putc(buf, cap, pos, 32)
    }
    if !left && pad > 0 && zero {
        val k: mut i64 = 0
        for {
            if k >= pad {
                break
            }
            fmt_putc(buf, cap, pos, 48)
            k = k + 1
        }
    }
    if precision > digits {
        val k: mut i64 = 0
        for {
            if k >= precision - digits {
                break
            }
            fmt_putc(buf, cap, pos, 48)
            k = k + 1
        }
    }
    val ti: mut i64 = 0
    for {
        if ti >= digits {
            break
        }
        fmt_putc(buf, cap, pos, @load8(@ptradd(@addr(tmp) as ref u8, ti)))
        ti = ti + 1
    }
    if left && pad > 0 {
        val k: mut i64 = 0
        for {
            if k >= pad {
                break
            }
            fmt_putc(buf, cap, pos, 32)
            k = k + 1
        }
    }
}

fn fmt_float(buf: ref u8, cap: i64, pos: ref i64, value: f64,
    precision: i64, width: i64, zero: bool, left: bool, plus: bool, space: bool, force_dec: bool) void = trust {
    val p: mut i64 = precision
    if p < 0 {
        p = 6
    }
    if p > 18 {
        p = 18
    }
    val neg: bool = value < 0.0
    val v: mut f64 = value
    if neg {
        v = 0.0 - value
    }
    val s: mut u64 = 1
    for k = 0, k < p, k++ {
        s = s * 10
    }
    val whole: u64 = v as u64
    val frac_d: f64 = v - (whole as f64)
    val frac: u64 = (frac_d * (s as f64) + 0.5) as u64
    val w2: mut u64 = whole
    val f2: mut u64 = frac
    if f2 >= s {
        w2 = w2 + 1
        f2 = f2 - s
    }
    val tmp: mut [128]u8 = @zeroed
    val t: ref u8 = @addr(tmp) as ref u8
    val n1: i64 = fmt_uint_text(w2, 10, false, t)
    val total0: mut i64 = n1
    if neg || plus || space {
        total0 = total0 + 1
    }
    if p > 0 || force_dec {
        total0 = total0 + 1 + p
    }
    val pad0: i64 = width - total0
    if !left && pad0 > 0 && !zero {
        for k = 0, k < pad0, k++ {
            fmt_putc(buf, cap, pos, 32)
        }
    }
    if neg {
        fmt_putc(buf, cap, pos, 45)
    } elif plus {
        fmt_putc(buf, cap, pos, 43)
    } elif space {
        fmt_putc(buf, cap, pos, 32)
    }
    if !left && pad0 > 0 && zero {
        for k = 0, k < pad0, k++ {
            fmt_putc(buf, cap, pos, 48)
        }
    }
    for k = 0, k < n1, k++ {
        fmt_putc(buf, cap, pos, @load8(@ptradd(t, k)))
    }
    if p > 0 || force_dec {
        fmt_putc(buf, cap, pos, 46)
        val ftmp: mut [80]u8 = @zeroed
        val fn_: i64 = fmt_uint_text(f2, 10, false, @addr(ftmp) as ref u8)
        for k = 0, k < p - fn_, k++ {
            fmt_putc(buf, cap, pos, 48)
        }
        for k = 0, k < fn_, k++ {
            fmt_putc(buf, cap, pos, @load8(@ptradd(@addr(ftmp) as ref u8, k)))
        }
    }
    if left && pad0 > 0 {
        for k = 0, k < pad0, k++ {
            fmt_putc(buf, cap, pos, 32)
        }
    }
}

pub fn sx_snprintf(buf: ref u8, cap: usize, fmt: ref u8, ...) i32 = trust {
    val ap: va_list = @va_start()
    val out_cap: i64 = cap as i64
    val pos: mut i64 = 0
    val i: mut i64 = 0
    for {
        val ch: u8 = @load8(@ptradd(fmt, i))
        if ch == 0 {
            break
        }
        if ch != 37 {
            fmt_putc(buf, out_cap, @addr(pos), ch)
            i = i + 1
            continue
        }
        i = i + 1
        val next: u8 = @load8(@ptradd(fmt, i))
        if next == 37 {
            fmt_putc(buf, out_cap, @addr(pos), 37)
            i = i + 1
            continue
        }
        val left: mut bool = false
        val zero: mut bool = false
        val plus: mut bool = false
        val space: mut bool = false
        val alt: mut bool = false
        for {
            val fch: u8 = @load8(@ptradd(fmt, i))
            if fch == 45 {
                left = true
                i = i + 1
            } elif fch == 48 {
                zero = true
                i = i + 1
            } elif fch == 43 {
                plus = true
                i = i + 1
            } elif fch == 32 {
                space = true
                i = i + 1
            } elif fch == 35 {
                alt = true
                i = i + 1
            } else {
                break
            }
        }
        val width: mut i64 = 0
        for {
            val wch: u8 = @load8(@ptradd(fmt, i))
            if wch < 48 || wch > 57 {
                break
            }
            width = width * 10 + ((wch as i64) - 48)
            i = i + 1
        }
        val precision: mut i64 = -1
        val pch: u8 = @load8(@ptradd(fmt, i))
        if pch == 46 {
            i = i + 1
            precision = 0
            if @load8(@ptradd(fmt, i)) == 42 {
                precision = @va_arg(ap, i32) as i64
                i = i + 1
            } else {
                for {
                    val dch: u8 = @load8(@ptradd(fmt, i))
                    if dch < 48 || dch > 57 {
                        break
                    }
                    precision = precision * 10 + ((dch as i64) - 48)
                    i = i + 1
                }
            }
        }
        val length: mut i64 = 0
        val lch: u8 = @load8(@ptradd(fmt, i))
        if lch == 104 {
            i = i + 1
            if @load8(@ptradd(fmt, i)) == 104 {
                length = 1
                i = i + 1
            } else {
                length = 2
            }
        } elif lch == 108 {
            i = i + 1
            if @load8(@ptradd(fmt, i)) == 108 {
                length = 4
                i = i + 1
            } else {
                length = 3
            }
        } elif lch == 122 || lch == 116 || lch == 106 {
            length = 5
            i = i + 1
        }
        val conv: u8 = @load8(@ptradd(fmt, i))
        i = i + 1
        if conv == 100 || conv == 105 {
            val v: mut i64 = 0
            if length == 4 || length == 5 || length == 6 || length == 7 {
                v = @va_arg(ap, i64)
            } else {
                v = @va_arg(ap, i32) as i64
            }
            fmt_int(
                buf,
                out_cap,
                @addr(pos),
                v,
                10,
                false,
                width,
                precision,
                zero,
                left,
                plus,
                space
            )
        } elif conv == 117 || conv == 111 || conv == 120 || conv == 88 {
            val v: mut u64 = 0
            if length == 4 || length == 5 || length == 6 || length == 7 {
                v = @va_arg(ap, u64)
            } else {
                v = @va_arg(ap, u32) as u64
            }
            val base: mut u64 = 10
            if conv == 111 {
                base = 8
            } elif conv == 120 || conv == 88 {
                base = 16
            }
            fmt_int(
                buf,
                out_cap,
                @addr(pos),
                v as i64,
                base,
                conv == 88,
                width,
                precision,
                zero,
                left,
                false,
                false
            )
        } elif conv == 99 {
            val c: i32 = @va_arg(ap, i32)
            fmt_putc(buf, out_cap, @addr(pos), c as u8)
        } elif conv == 115 {
            val sp: usize = @va_arg(ap, usize)
            fmt_str(buf, out_cap, @addr(pos), @bitcast(sp, ref u8), width, precision, left)
        } elif conv == 112 {
            val vp: usize = @va_arg(ap, usize)
            val tmp: mut [80]u8 = @zeroed
            val n: i64 = fmt_uint_text(vp as u64, 16, false, @addr(tmp) as ref u8)
            fmt_putc(buf, out_cap, @addr(pos), 48)
            fmt_putc(buf, out_cap, @addr(pos), 120)
            for k = 0, k < n, k++ {
                fmt_putc(buf, out_cap, @addr(pos), @load8(@ptradd(@addr(tmp) as ref u8, k)))
            }
        } elif conv == 102 || conv == 70 || conv == 103 || conv == 71 || conv == 101 || conv == 69 {
            val v: f64 = @va_arg(ap, f64)
            val p: mut i64 = precision
            if p < 0 {
                p = 6
            }
            if conv == 103 || conv == 71 {
                if p == 0 {
                    p = 1
                }
            }
            fmt_float(buf, out_cap, @addr(pos), v, p, width, zero, left, plus, space, alt)
        } else {
            fmt_putc(buf, out_cap, @addr(pos), 37)
            fmt_putc(buf, out_cap, @addr(pos), conv)
        }
    }
    @va_end(ap)
    if out_cap > 0 {
        val end: mut i64 = out_cap - 1
        if pos < out_cap {
            end = pos
        }
        @store8(@ptradd(buf, end), 0)
    }
    return pos as i32
}

// ---------------------------------------------------------------------------
// Environment / filesystem metadata layer
// ---------------------------------------------------------------------------

fn r_getenv(name: ref u8) ref u8 = trust {
    if name == none {
        return none
    }
    val buf: ref u8 = r_alloc(4096) as ref u8
    if buf == none {
        return none
    }
    val n: i64 = __sx_sys_getenv(name, buf, 4096)
    if n < 0 {
        return none
    }
    return buf
}

fn r_getcwd(buf: ref u8, size: usize) ref u8 = trust {
    if buf == none {
        return none
    }
    if __sx_sys_getcwd(buf, size) < 0 {
        return none
    }
    return buf
}

fn r_chdir(path: ref u8) i32 = trust {
    return __sx_sys_chdir(path) as i32
}

fn r_access(path: ref u8, mode: i32) i32 = trust {
    return __sx_sys_access(path, mode as i64) as i32
}

fn r_mkdir(path: ref u8, mode: u32) i32 = trust {
    return __sx_sys_mkdir(path, mode as i64) as i32
}

fn r_rmdir(path: ref u8) i32 = trust {
    return __sx_sys_rmdir(path) as i32
}

fn r_remove(path: ref u8) i32 = trust {
    return __sx_sys_remove(path) as i32
}

fn r_rename(old: ref u8, new: ref u8) i32 = trust {
    return __sx_sys_rename(old, new) as i32
}

fn r_unlink(path: ref u8) i32 = trust {
    return __sx_sys_remove(path) as i32
}

fn r_realpath(path: ref u8, out: ref u8) ref u8 = trust {
    val buf: mut ref u8 = out
    if buf == none {
        buf = r_alloc(4096) as ref u8
        if buf == none {
            return none
        }
    }
    if __sx_sys_realpath(path, buf, 4096) < 0 {
        return none
    }
    return buf
}

fn r_readlink(path: ref u8, buf: ref u8, n: usize) i64 = trust {
    return __sx_sys_readlink(path, buf, n)
}

fn r_isatty(fd: i32) i32 = trust {
    return __sx_sys_isatty(fd as i64) as i32
}

fn r_stat(path: ref u8, buf: ref void) i32 = trust {
    return __sx_sys_stat(path, buf) as i32
}

fn r_opendir(path: ref u8) ref void = trust {
    return __sx_sys_opendir(path)
}

fn r_readdir(dir: ref void) ref void = trust {
    return __sx_sys_readdir(dir)
}

fn r_closedir(dir: ref void) i32 = trust {
    return __sx_sys_closedir(dir) as i32
}

fn r_uname(buf: ref void) i32 = trust {
    return __sx_sys_uname(buf) as i32
}

fn r_exit(code: i32) void = trust {
    __sx_sys_exit(code as i64)
}

fn r_getrandom(buf: ref void, n: usize, _: u32) i64 = trust {
    return __sx_sys_getrandom(buf, n)
}

fn r_arc4random_buf(buf: ref void, n: usize) void = trust {
    val p: ref u8 = buf as ref u8
    val done: mut usize = 0
    for {
        if done >= n {
            break
        }
        val r: i64 = __sx_sys_getrandom(@ptradd(p, done as i64) as ref void, n - done)
        if r <= 0 {
            break
        }
        done = done + r as usize
    }
}

// Exported ABI wrappers.
pub fn sx_alloc(n: usize) ref void = trust {
    return r_alloc(n)
}

pub fn sx_calloc(count: usize, size: usize) ref void = trust {
    return r_calloc(count, size)
}

pub fn sx_free(ptr: ref void) void = trust {
    r_free(ptr)
}

pub fn sx_realloc(ptr: ref void, n: usize) ref void = trust {
    return r_realloc(ptr, n)
}

pub fn sx_memcpy(dst: ref void, src: ref void, n: usize) ref void = trust {
    return r_memcpy(dst, src, n)
}

pub fn sx_memmove(dst: ref void, src: ref void, n: usize) ref void = trust {
    return r_memmove(dst, src, n)
}

pub fn sx_memset(dst: ref void, value: i32, n: usize) ref void = trust {
    return r_memset(dst, value, n)
}

pub fn sx_memcmp(a: ref void, b: ref void, n: usize) i32 = trust {
    return r_memcmp(a, b, n)
}

pub fn sx_strlen(s: ref u8) i64 = trust {
