/// An arena hands out memory from a single large block.
///
/// Individual allocations cannot be freed — the whole arena is freed at once.
/// This is ideal for request-scoped or phase-scoped allocations.
///
/// Layout of an Arena struct (3 fields × 8 bytes each):
///   offset 0:  buf    — ref void, pointer to the backing block
///   offset 8:  offset — usize, current bump position (bytes used)
///   offset 16: cap    — usize, total capacity in bytes
pub type (Allocator) Arena = {
    buf: ref void
    offset: usize
    cap: usize
}

/// An error that occurs when attempting to allocate memory.
pub enum AllocError = {
    OutOfMemory
}


/// Interface for the classic bump allocator.
pub spec Allocator = {
    pub fn new(capacity: usize) result[Allocator, AllocError]
    pub fn free(a: self) void
    pub fn alloc(a: self, size: usize) option[ref void]
}

/// Create a new arena backed by a block of `capacity` bytes.
/// Capacity must be > 0.
pub fn (Arena) new(capacity: usize) result[Allocator, AllocError] = trust {
    pre {
        capacity_positive: capacity > 0
    }

    val header: ref void = @alloc(24)
    if (header == none) {
        return err AllocError.OutOfMemory
    }

    val buf: ref void = @alloc(capacity)
    if (buf == none) {
        @free(header)
        return err AllocError.OutOfMemory
    }

    @memset(buf, 0, capacity)
    @store(header, buf)
    @store(@ptradd(header, 8), 0)
    @store(@ptradd(header, 16), capacity)

    return ok (header as Arena)
}

/// Free the entire arena and its backing block.
pub fn (Arena) free(arena: self) void = trust {
    val au: mut ref Arena = arena as ref Arena
    val buf: mut ref void = @load(au)
    if buf != none {
        @free(buf)
    }
    @free(au as ref void)
}

/// Allocate `size` bytes from the arena.
///
/// Requires size > 0. Returns none if there is not enough space remaining.
pub fn (Arena) alloc(arena: self, size: usize) option[ref void] = {
    guarded pre {
        pre_size_positive: size > 0
    }
    val off: usize = trust @load(@ptradd(arena, 8)) as usize
    val cap: usize = trust @load(@ptradd(arena, 16)) as usize
    val aligned: usize = (size + 7) - ((size + 7) - ((size + 7) / 8) * 8)
    if (off + aligned > cap) {
        return none
    }
    val buf: ref void = trust @load(arena)
    val ptr: ref void = trust @ptradd(buf, off)
    trust @store(@ptradd(arena, 8), off + aligned)
    return some ptr
}

/// Allocate `size` bytes from the arena, returning none when it is exhausted.
///
/// This is a convenience wrapper around `alloc` for call sites that prefer a
/// nullable pointer over an `option` result.
pub fn (Arena) alloc_or_none(arena: self, size: usize) ref void = {
    pre {
        size_positive: size > 0
    }
    val out = Arena.alloc(arena, size)
    match out {
        some p => {
            return p
        }
        none => {
            return none
        }
    }
}

/// Allocate `size` bytes without wrapping the result in an option.
///
/// Returns none when the arena is exhausted.
pub fn (Arena) alloc_raw(arena: self, size: usize) ref void = trust {
    val out = Arena.alloc(arena, size)
    if out is some p {
        return p
    }
    return none
}

/// Return the number of bytes currently used.
pub fn (Arena) used(arena: self) usize = {
    return trust @load(@ptradd(arena, 8)) as usize
}

/// Return the total capacity in bytes.
pub fn (Arena) cap(arena: self) usize = {
    return trust @load(@ptradd(arena, 16)) as usize
}

/// Return the number of bytes remaining.
/// Contracts: used <= cap, so the subtraction never underflows.
pub fn (Arena) remaining(arena: self) usize = {
    pre {
        used_le_cap: trust @load(@ptradd(arena, 8)) <= trust @load(@ptradd(arena, 16))
    }
    val off: usize = trust @load(@ptradd(arena, 8)) as usize
    val cap: usize = trust @load(@ptradd(arena, 16)) as usize
    post {
        used_le_cap: off <= cap
    }
    return cap - off
}

/// Reset the arena — all previously allocated pointers become invalid.
pub fn (Arena) reset(arena: self) void = trust {
    val buf: mut ref void = @load(arena)
    val cap: usize = @load(@ptradd(arena, 16)) as usize
    @memset(buf, 0, cap)
    @store(@ptradd(arena, 8), 0)
}

test "arena allocates and tracks usage" {
    val arena: Arena = trust Arena.new(64 as usize)?

    assert Arena.cap(arena) == 64
    assert Arena.used(arena) == 0
    assert Arena.remaining(arena) == 64

    val a1 = Arena.alloc(arena, 8 as usize)
    assert a1 != none
    assert Arena.used(arena) == 8
    assert Arena.remaining(arena) == 56

    val a2 = Arena.alloc(arena, 16 as usize)
    assert a2 != none
    assert Arena.used(arena) == 24
    assert Arena.remaining(arena) == 40

    trust Arena.free(arena)
}

/// A Stack Allocator allows for LIFO (Last-In, First-Out) memory management.
///
/// You can "save" the current position and "restore" to it later.
///
/// Layout (identical to Arena for binary compatibility):
///    offset 0:  buf    — ref void
///    offset 8:  offset — usize
///    offset 16: cap    — usize
type (Allocator) Stack = {
    buf: ref void
    offset: usize
    cap: usize
}

/// Create a new stack allocator.
pub fn (Stack) new(capacity: usize) result[Allocator, AllocError] = trust {
    pre {
        capacity_positive: capacity > 0
    }
    val header: mut ref void = @alloc(24)
    val buf: ref void = @alloc(capacity)
    @store(header, buf)
    @store(@ptradd(header, 8), 0)
    @store(@ptradd(header, 16), capacity)
    return ok (header as Stack)
}

/// Allocate memory from the stack.
pub fn (Stack) alloc(stack: self, size: usize) option[ref void] = {
    pre {
        size_positive: size > 0
    }

    val off: usize = trust @load(@ptradd(stack, 8)) as usize
    val cap: usize = trust @load(@ptradd(stack, 16)) as usize
    val aligned: usize = (size + 7) & ~7

    if (off + aligned > cap) {
        return none
    }

    val buf: ref void = trust @load(stack)
    val ptr: ref void = trust @ptradd(buf, off)

    trust @store(@ptradd(stack, 8), off + aligned)
    return some ptr
}

/// Capture the current state of the stack.
/// The returned usize is a "marker" or "checkpoint".
pub fn (Stack) save(stack: self) usize = {
    return trust @load(@ptradd(stack, 8)) as usize
}

/// Restore the stack to a previous checkpoint.
/// This effectively "frees" everything allocated after the 'save' call.
pub fn (Stack) restore(stack: self, checkpoint: usize) void = {
    pre {
        valid_checkpoint: checkpoint <= trust @load(@ptradd(stack, 16))
        no_rewind_past_zero: checkpoint >= 0
    }
    // Hmm...
    trust @store(@ptradd(stack, 8), checkpoint)
}

/// Free the underlying memory.
pub fn (Stack) free(stack: self) void = trust {
    val su: mut ref Stack = stack as ref Stack
    val buf: mut ref void = @load(su)
    if buf != none {
        @free(buf)
    }
    @free(su as ref void)
}

test "stack allocator saves and restores markers" {
    val stack: Stack = trust Stack.new(1024 as usize)?
    val marker = Stack.save(stack)
    val tmp1 = Stack.alloc(stack, 200 as usize)

    assert Stack.save(stack) > marker

    Stack.restore(stack, marker)

    val p2 = Stack.alloc(stack, 50 as usize)

    assert p2 == tmp1

    trust Stack.free(stack)
}

pub spec GeneralAllocator = {
    pub fn alloc(a: self, size: usize) option[ref void]
    pub fn free(a: self, ptr: ref void) void
    pub fn realloc(a: self, ptr: ref void, new_size: usize) option[ref void]
}

/// A simple heap-backed general allocator.
pub type (GeneralAllocator) HeapAllocator = {}

/// Allocate `size` bytes.
pub fn (HeapAllocator) alloc(_: self, size: usize) option[ref void] = trust {
    pre {
        size_positive: size > 0
    }
    val total: usize = size + 8
    val raw: ref void = @alloc(total)
    if raw == none {
        return none
    }
    @store(raw, size)
    val user_ptr: ref void = @ptradd(raw, 8)
    return some user_ptr
}

/// Free a previously allocated block.
pub fn (HeapAllocator) free(_: self, ptr: ref void) void = trust {
    val raw: ref void = @ptradd(ptr, -8)
    @free(raw)
}

/// Reallocate a block.
pub fn (HeapAllocator) realloc(_: self, ptr: ref void, new_size: usize) option[ref void] = trust {
    pre {
        new_size_positive: new_size > 0
    }

    val old_raw: ref void = @ptradd(ptr, -8)
    val new_total: usize = new_size + 8
    val new_raw: ref void = @realloc(old_raw, new_total)

    if new_raw == none {
        return none
    }

    @store(new_raw, new_size)

    val new_ptr: ref void = @ptradd(new_raw, 8)
    return some new_ptr
}

/// Allocates memory, returns the pointer on success, and returns none on failure.
pub fn bump_alloc_unwrap[A: Allocator](ac: A, size: usize) ref void = {
    pre {
        size_positive: size > 0
    }
    val opt = A.alloc(ac, size)
    if opt is some v {
        return v
    }
    return none
}

/// Allocates "size" bytes using the specified allocator.
///
/// Returns some containing a pointer to the allocated memory on success,
/// or none if the allocation fails.
///
/// Requires size to be greater than zero.
pub fn alloc_in[A: GeneralAllocator](ac: A, size: usize) option[ref void] = {
    pre {
        size_positive: size > 0
    }
    return A.alloc(ac, size)
}

/// Frees memory allocated by the specified allocator.
///
/// Does nothing if ptr is none.
pub fn free_in[A: GeneralAllocator](ac: A, ptr: ref void) void = trust {
    if ptr != none {
        A.free(ac, ptr)
    }
}

/// Resizes a memory allocation using the specified allocator.
///
/// If ptr is none, allocates a new memory block of new_size bytes.
/// Otherwise, resizes the existing allocation to new_size bytes.
/// Returns some containing a pointer to the resized memory on success,
/// or none if the allocation fails.
/// Requires new_size to be greater than zero.
pub fn realloc_in[A: GeneralAllocator](ac: A, ptr: ref void, new_size: usize) option[ref void] = {
    pre {
        new_size_positive: new_size > 0
    }
    if ptr == none {
        return A.alloc(ac, new_size)
    }
    return A.realloc(ac, ptr, new_size)
}

test "heap allocator allocates, reallocs and frees" {
    val alloc: HeapAllocator = @zeroed
    val p1 = trust HeapAllocator.alloc(alloc, 16 as usize)
    assert p1 != none

    if p1 is some ptr1 {
        trust @store(ptr1, 0xDEADBEEF as usize)
        val raw1: ref void = trust @ptradd(ptr1, -8)
        val size1: usize = trust @load(raw1) as usize
        assert size1 == 16

        trust HeapAllocator.free(alloc, ptr1)
    }

    @puts("done with heap allocator")
}

/// Opaque handle type for `ScopedArena`.
pub spec ScopedArenaAllocator = {}

/// A growable, resettable arena made of linked blocks.
///
/// `reset` reclaims all individual allocations at once while keeping the
/// backing blocks for reuse. `free` releases the blocks and the arena handle.
pub type (ScopedArenaAllocator) ScopedArena = {
    head: mut ref void
    cur: mut ref void
    block_size: mut usize
}

type ScopedArenaBlock = {
    buf: mut ref void
    offset: mut usize
    cap: mut usize
    next: mut ref ScopedArenaBlock
}

fn scoped_block_new(block_size: usize) result[ref ScopedArenaBlock, AllocError] = trust {
    val node: mut ref ScopedArenaBlock = @alloc(@sizeof(ScopedArenaBlock)) as ref ScopedArenaBlock
    val buf: ref void = @alloc(block_size)
    if node == none || buf == none {
        if node != none {
            @free(node)
        }
        return err AllocError.OutOfMemory
    }
    node.buf = buf
    node.offset = 0
    node.cap = block_size
    node.next = none
    return ok node
}

/// Create a new scoped arena. `block_size` is the size of each backing block.
pub fn (ScopedArena) new(block_size: usize) result[ScopedArenaAllocator, AllocError] = trust {
    pre {
        block_size_positive: block_size > 0
    }
    val a: mut ref ScopedArena = @alloc(@sizeof(ScopedArena)) as ref ScopedArena
    if a == none {
        return err AllocError.OutOfMemory
    }
    a.head = none
    a.cur = none
    a.block_size = block_size
    return ok (a as ScopedArenaAllocator)
}

/// Allocate `size` bytes from the arena, growing with fresh blocks as needed.
pub fn (ScopedArena) alloc(a: ScopedArenaAllocator, size: usize) option[ref void] = trust {
    pre {
        size_positive: size > 0
    }
    val au: mut ref ScopedArena = a as ref ScopedArena
    val aligned: usize = (size + 7) & ~(7 as usize)
    val node: mut ref ScopedArenaBlock = au.cur as ref ScopedArenaBlock
    for {
        if node == none {
            break
        }
        if node.offset + aligned <= node.cap {
            val ptr: ref void = @ptradd(node.buf, node.offset)
            node.offset = node.offset + aligned
            au.cur = node
            return some ptr
        }
        node = node.next
    }
    val cap: mut usize = au.block_size
    if aligned > cap {
        cap = aligned
    }
    match scoped_block_new(cap) {
        ok nb => {
            nb.next = au.head as ref ScopedArenaBlock
            au.head = nb as ref void
            au.cur = nb as ref void
            val ptr: ref void = @ptradd(nb.buf, nb.offset)
            nb.offset = nb.offset + aligned
            return some ptr
        }
        err _ => {
            return none
        }
    }
    return none
}

/// Allocate `size` bytes, returning none on exhaustion.
pub fn (ScopedArena) alloc_or_none(a: ScopedArenaAllocator, size: usize) ref void = {
    match trust ScopedArena.alloc(a, size) {
        some p => {
            return p
        }
        none => {
            return none
        }
    }
}

/// Allocate `size` bytes without wrapping the result in an option.
///
/// Returns none when allocation fails.
pub fn (ScopedArena) alloc_raw(a: ScopedArenaAllocator, size: usize) ref void = trust {
    match ScopedArena.alloc(a, size) {
        some p => {
            return p
        }
        none => {
            return none
        }
    }
}

/// Reclaim all arena allocations while retaining the backing blocks.
pub fn (ScopedArena) reset(a: ScopedArenaAllocator) void = trust {
    val au: mut ref ScopedArena = a as ref ScopedArena
    val node: mut ref ScopedArenaBlock = au.head as ref ScopedArenaBlock
    for {
        if node == none {
            break
        }
        node.offset = 0
        node = node.next
    }
    au.cur = au.head
}

/// Release all backing blocks and the arena handle.
pub fn (ScopedArena) free(a: ScopedArenaAllocator) void = trust {
    val au: mut ref ScopedArena = a as ref ScopedArena
    val node: mut ref ScopedArenaBlock = au.head as ref ScopedArenaBlock
    for {
        if node == none {
            break
        }
        val next_node: ref ScopedArenaBlock = node.next
        @free(node.buf)
        @free(node)
        node = next_node
    }
    @free(au)
}

/// A general allocator backed by a scoped arena.
///
/// This is useful for large groups of short-lived lists that all share one
/// arena and are released together. Individual frees are no-ops, the backing
/// arena is released separately.
pub type (GeneralAllocator) ListArena = {
    arena: mut ScopedArenaAllocator
}

/// Allocate a block from the list arena.
pub fn (ListArena) alloc(a: self, size: usize) option[ref void] = trust {
    val raw: ref void = ScopedArena.alloc_or_none(a.arena, size + 8)
    if raw == none {
        return none
    }
    @store(raw, size)
    return some (@ptradd(raw, 8))
}

/// Individual frees are no-ops, the whole arena is released at once.
pub fn (ListArena) free(_: self, _: ref void) void = {}

/// Copy into a fresh arena block. The old block remains arena-owned.
pub fn (ListArena) realloc(a: self, ptr: ref void, new_size: usize) option[ref void] = trust {
    if ptr == none {
        return ListArena.alloc(a, new_size)
    }
    val old_size: usize = @load(@ptradd(ptr, -8)) as usize
    val next = ListArena.alloc(a, new_size)
    if next is some p {
        val copy_len: mut usize = old_size
        if new_size < copy_len {
            copy_len = new_size
        }
        @memcpy(p, ptr, copy_len)
        return some p
    }
    return none
}

test "scoped arena grows past its block size" {
    val sa: ScopedArenaAllocator = trust ScopedArena.new(64 as usize)?
    val p1: mut ref void = ScopedArena.alloc_or_none(sa, 16 as usize)
    val p2: mut ref void = ScopedArena.alloc_or_none(sa, 200 as usize)

    assert p1 != none
    assert p2 != none

    trust @store8(p1 as ref u8, 65)
    trust @store8(p2 as ref u8, 66)
    assert trust @load8(p1 as ref u8) == 65
    assert trust @load8(p2 as ref u8) == 66

    trust ScopedArena.reset(sa)
    val p3: ref void = ScopedArena.alloc_or_none(sa, 16 as usize)
    assert p3 != none

    trust ScopedArena.free(sa)
}

test "list arena appends items" {
    val sa: ScopedArenaAllocator = trust ScopedArena.new(128 as usize)?
    val la: ListArena = {arena: sa}
    val xs: mut list[i64] = @listalloc[ListArena, i64](la)?
    @append(xs, 1)
    @append(xs, 2)
    assert @len(xs) == 2
    trust ScopedArena.free(sa)
}
