val os          = use("std/os")
val mem         = use("../../src/meta/mem.sx")
val c_translate = use("../../src/translate/c_translate.sx")
val check       = use("lib/check.sx")

test "c translator does not leak" {
    trust {
        mem.init()
        val before = check.baseline()
        val input = "./samples/csamples/hello.c"
        val output = "./s-out/checkmem-c.sx"
        val code: i32 = c_translate.translate_c(check.cptr(input), check.cptr(output))
        os.delete(check.cptr(output))
        mem.close()
        check.expect_clean_since("c_translate", before)
        assert code == 0
    }
}
