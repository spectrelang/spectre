/// (C) Navid Momtahen - 2026

val os    = use("std/os")
val mem   = use("../../src/meta/mem.sx")
val docs  = use("../../src/meta/docs.sx")
val check = use("lib/check.sx")

test "docs generator does not leak" {
    trust {
        mem.init()
        val before = check.baseline()
        val target = "./fw/harness/fixtures/smoke.sx"
        val output = "./s-out/checkmem-docs"
        val read = ""
        val code: i32 = docs.cmd_doc(
            check.cptr(target),
            false,
            check.cptr(output),
            check.cptr(read)
        )
        os.run(check.cptr("rm -rf ./s-out/checkmem-docs"))
        mem.close()
        check.expect_clean_since("docs", before)
        assert code == 0
    }
}
