/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val stdio      = use("std/stdio")
val string     = use("std/string")
val allocators = use("std/allocators")
val mem        = use("../../src/meta/mem.sx")
val sema       = use("../../src/sema/sema.sx")
val codegen    = use("../../src/codegen/codegen.sx")
val check      = use("lib/check.sx")

test "codegen does not leak" {
    trust {
        mem.init()
        val arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
            67108864 as usize
        )?
        val path = "./fw/harness/fixtures/smoke.sx"
        val src_target = ""
        val root = check.resolve(arena, path)
        val errors = sema.check_module_tree(arena, root, 1, check.cptr(src_target))
        if (@len(errors) as i64) > 0 {
            for error in errors {
                stdio.print("[FAIL] sema: {s}\n", {error})
            }
            assert false
        }

        val before = check.baseline()
        val output: mut ref codegen.CgOutput = codegen.gen_module_resolved_test(
            root,
            false,
            check.cptr(src_target),
            false
        )
        if output.qbe != none && string.len_raw(output.qbe) > 0 {
            @free(output.qbe as ref void)
        }
        if output.shim != none && string.len_raw(output.shim) > 0 {
            @free(output.shim as ref void)
        }
        @free(output as ref void)

        allocators.ScopedArena.free(arena)
        mem.close()
        check.expect_clean_since("codegen", before)
    }
}
