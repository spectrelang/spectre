val os       = use("std/os")
val fs       = use("std/fs")
val mem      = use("../../src/meta/mem.sx")
val meta     = use("../../src/meta/meta.sx")
val commands = use("../../src/meta/commands.sx")
val check    = use("lib/check.sx")
val str      = use("std/string")

when posix {
    extern (C) fn chdir(path: ref u8) i32 = "chdir"
}

test "commands parses sx.mod without leaking" {
    trust {
        mem.init()
        val content = \\entry "./src/main.sx"
        \\version "1.2.3"
        \\spectre_version "0.0.0"
        \\single_flags "-release -dynamic"
        \\dep "https://example.com/lib.git" {
        \\    build_actions {
        \\        ["ls", "-l"],
        \\        "echo hello"
        \\    }
        \\}
        \\build dev {
        \\    action "./script.sh"
        \\    actions {
        \\        ["sh", "other.sh"],
        \\        "echo free form"
        \\    }
        \\    flags "-l"
        \\    output "./out"
        \\    env {
        \\        FOO=bar
        \\    }
        \\    linux {
        \\        flags "-O2"
        \\    }
        \\}
        val parsed = commands.parse_sxmod(check.cptr(content), check.cptr("."), check.cptr(""))
        assert @len(parsed.deps) as i64 == 1
        assert @len(parsed.builds) as i64 == 1
        val dep_opt = @get(parsed.deps, 0 as usize)
        if dep_opt is some raw_dep {
            val dep: ref commands.SxDep = raw_dep as ref commands.SxDep
            assert @len(dep.actions) as i64 == 2
        } else {
            assert false
        }
        val cfg_opt = @get(parsed.builds, 0 as usize)
        if cfg_opt is some raw_cfg {
            val cfg: ref commands.SxBuildConfig = raw_cfg as ref commands.SxBuildConfig
            assert @len(cfg.rules) as i64 == 1
            assert @len(cfg.base.actions) as i64 == 3
            assert @len(cfg.base.envs) as i64 == 1
        } else {
            assert false
        }
        mem.close()
        check.expect_clean("commands")
    }
}

test "commands build does not leak" {
    trust {
        mem.init()
        val dir = "./s-out/checkmem-commands"
        fs.remove_dir_all(dir)
        assert fs.mkdir_path(dir)

        val version: str.StringView = meta.get_spectre_version()
        val prefix: str.StringView = "entry \"./main.sx\"\nversion \"1.2.3\"\nspectre_version \""
        val suffix: str.StringView = "\"\nbuild checkmem { action \"true\" }\n"
        assert fs.write_all("./s-out/checkmem-commands/sx.mod", prefix)
        assert fs.append_all("./s-out/checkmem-commands/sx.mod", version)
        assert fs.append_all("./s-out/checkmem-commands/sx.mod", suffix)

        when posix {
            assert chdir(check.cptr(dir)) == 0
            val code: i32 = commands.cmd_build(
                check.cptr("checkmem"),
                check.cptr("./spectre-checkmem"),
                check.cptr("")
            )
            assert chdir(check.cptr("../..")) == 0
            assert code == 0
        }

        when windows {
            os.run(check.cptr("rmdir /s /q .\\s-out\\checkmem-commands"))
        }
        when posix {
            os.run(check.cptr("rm -rf ./s-out/checkmem-commands"))
        }
        mem.close()
        check.expect_clean("commands-build")
    }
}
