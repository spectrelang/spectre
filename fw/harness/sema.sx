/// (C) Navid Momtahen - 2026

val stdio      = use("std/stdio")
val allocators = use("std/allocators")
val mem        = use("../../src/meta/mem.sx")
val sema       = use("../../src/sema/sema.sx")
val check      = use("lib/check.sx")

test "sema does not leak" {
    trust {
        mem.init()
        val arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
            67108864 as usize
        )?
        val path = "./fw/harness/fixtures/smoke.sx"
        val src_target = ""
        val root = check.resolve(arena, path)
        val before = check.baseline()
        val errors = sema.check_module_tree(arena, root, 1, check.cptr(src_target))
        if (@len(errors) as i64) > 0 {
            for error in errors {
                stdio.print("[FAIL] sema: {s}\n", {error})
            }
            assert false
        }
        allocators.ScopedArena.free(arena)
        mem.close()
        check.expect_clean_since("sema", before)
    }
}
