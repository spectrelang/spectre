val json  = use("std/json")
val stdio = use("std/stdio")

pub fn main() void = trust {
    val raw_str = \\{"Alice": "asdf"}
    val doc_opt = json.parse(raw_str)
    match doc_opt {
        err _ => {
            @puts("Got nothing.")
        }
        ok handle => {
            @puts("Got something:")
            stdio.print("Raw string: {s}\n", {raw_str})
            val root = json.root(handle)
            match json.object_get_str(root, "Alice") {
                some value => {
                    stdio.print("{s}", {value})
                }
                none => {
                    assert false
                }
            }
            assert json.is_object(root)
            json.doc_free(handle)
        }
    }
}
