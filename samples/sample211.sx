val allocators = use("std/allocators")

type Inner = {
    a: mut list[i32]
    b: mut list[i32]
    c: mut list[i32]
}

type Outer = {
    inner: mut Inner
}

pub fn main() i32 = {
    val sa: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(4096 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val o: mut Outer = {
        inner: {
            a: @listalloc[allocators.ListArena, i32](la)?,
            b: @listalloc[allocators.ListArena, i32](la)?,
            c: @listalloc[allocators.ListArena, i32](la)?
        }
    }
    @append(o.inner.a, 1 as i32)
    @append(o.inner.a, 2 as i32)
    @append(o.inner.b, 3 as i32)
    @append(o.inner.c, 4 as i32)
    @append(o.inner.c, 5 as i32)
    @append(o.inner.c, 6 as i32)
    assert @len(o.inner.a) == (2 as usize)
    assert @len(o.inner.b) == (1 as usize)
    assert @len(o.inner.c) == (3 as usize)
    trust allocators.ScopedArena.free(sa)
    return 0 as i32
}
