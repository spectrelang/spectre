val SEED: u64 = 123456789
val ROUNDS: i64 = 4000000

fn mix(x: u64) u64 = {
    val v: mut u64 = x
    v = v ^ (v >> 13)
    v = v * 1000003
    v = v ^ (v >> 7)
    v = v * 2654435761
    return v
}

fn collatz(n: u64) u64 = {
    val x: mut u64 = n
    val steps: mut u64 = 0
    for {
        if x == 1 {
            break
        }
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        steps = steps + 1
    }
    return steps
}

pub fn main() i32 = {
    val acc: mut u64 = 0
    for i = 0, i < ROUNDS, i++ {
        acc = acc + mix(SEED) + collatz(SEED % 1000 + 1)
    }
    trust @print("{d}\n", {(acc & 0x7fffffff) as i64})
    return 0
}
