val json = use("std/json")

pub fn main() void = trust {
    val input = \\{"name":"Alice"}
    val doc_opt = json.parse(input)
    match doc_opt {
        err _ => {
            @puts("got nothing")
            assert false
        }
        ok handle => {
            @puts("got something")
            json.doc_free(handle)
        }
    }
}
