val stdio      = use("std/stdio")
val allocators = use("std/allocators")

type Node = {
    x: i32
    y: i32
}

pub fn make_list[A: allocators.GeneralAllocator](
    ac: A
) result[list[Node], ref u8] = trust {
    val a: mut list[Node] = @listalloc[A, Node](ac)?
    @append(a, {x: 1, y: 2})
    @append(a, {x: 3, y: 4})
    return ok a
}

pub fn wrap[A: allocators.GeneralAllocator](
    ac: A
) result[result[list[Node], ref u8], ref u8] = trust {
    val r = make_list[A](ac)
    return ok r
}

pub fn main() void = trust {
    val sa: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(4096 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val r2 = wrap[allocators.ListArena](la)

    match r2 {
        ok inner => {
            match inner {
                ok lst => {
                    val n = @len(lst)
                    stdio.print("len = {lld}\n", {n})

                    val i: mut i64 = 0
                    for {
                        if i >= n {
                            break
                        }

                        val v = @get(lst, i as usize)
                        if v is some x {
                            stdio.print("{d} {d}\n", {x.x, x.y})
                        } else {
                            stdio.print("CORRUPTED LIST\n", {})
                        }
                        i++
                    }
                }
                err e => {
                    stdio.print("inner err: {s}\n", {e})
                }
            }
        }
        err e => {
            stdio.print("outer err: {s}\n", {e})
        }
    }
    allocators.ScopedArena.free(sa)
}
