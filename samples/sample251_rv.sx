pub fn atoi(s: ref u8) i64 = {
    return @atoi(s)
}

pub fn main() void = trust {
    assert atoi(c"") == 0
    assert atoi(c"0") == 0
    assert atoi(c"42") == 42
    assert atoi(c"+7") == 7
    assert atoi(c"-123") == -123
    assert atoi(c"  99xyz") == 99
    assert atoi(c"abc") == 0
    assert atoi(c"-") == 0
    @puts("atoi ok\n")
}
