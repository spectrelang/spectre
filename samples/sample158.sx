 val mod = use("sample158_mod.sx")
 
 fn build_demo() mod.Demo = {
     return {
         stars: [
             mod.make_star(mod.make_vec3(-7.0 as f32, 4.8 as f32, -13.0 as f32), mod.make_vec3(0.95 
as f32, 0.98 as f32, 1.00 as f32), 0.06 as f32, 0.26 as f32),
             mod.make_star(mod.make_vec3(-5.4 as f32, 6.0 as f32, -11.0 as f32), mod.make_vec3(0.72 
as f32, 0.84 as f32, 1.00 as f32), 0.05 as f32, 0.22 as f32)
         ],
         particles: [
             mod.make_particle(mod.make_vec3(-1.55 as f32, 0.35 as f32, -0.65 as f32), 
mod.make_vec3(1.00 as f32, 0.48 as f32, 0.86 as f32), 0.08 as f32, 0.42 as f32, 1.80 as f32, 0.0 as 
f32, 0.28 as f32, 0.46 as f32),
             mod.make_particle(mod.make_vec3(-1.55 as f32, 0.42 as f32, -0.65 as f32), 
mod.make_vec3(0.98 as f32, 0.74 as f32, 1.00 as f32), 0.05 as f32, 0.56 as f32, 1.20 as f32, 1.4 as 
f32, 0.52 as f32, 0.30 as f32),
             mod.make_particle(mod.make_vec3(1.55 as f32, 0.58 as f32, -2.30 as f32), 
mod.make_vec3(0.34 as f32, 0.90 as f32, 1.00 as f32), 0.09 as f32, 0.48 as f32, -1.55 as f32, 0.5 as
 f32, 0.32 as f32, 0.48 as f32),
             mod.make_particle(mod.make_vec3(1.55 as f32, 0.72 as f32, -2.30 as f32), 
mod.make_vec3(0.78 as f32, 0.96 as f32, 1.00 as f32), 0.05 as f32, 0.64 as f32, -1.10 as f32, 2.1 as
 f32, 0.66 as f32, 0.30 as f32),
             mod.make_particle(mod.make_vec3(0.0 as f32, 0.30 as f32, -1.50 as f32), 
mod.make_vec3(1.00 as f32, 0.84 as f32, 0.56 as f32), 0.05 as f32, 1.20 as f32, 0.75 as f32, 2.4 as 
f32, 0.18 as f32, 0.20 as f32)
         ]
     }
 }
 
 pub fn main() i32 = {
     val d: mod.Demo = build_demo()
     trust @print("{p}\n", {d})
     return 0 as i32
 }
