val str        = use("std/string")
val allocators = use("std/allocators")
val stdio      = use("std/stdio")

fn normalize_path[A: allocators.Allocator](ac: A, raw: ref u8) str.String = {
    val path: str.String = trust str.from[A](ac, raw)
    trust {
        str.trim(path)
        str.to_lower(path)
    }
    val result = trust str.trim_prefix(path, str.from[A](ac, "/api/"))
    post {
        result.len > 0
    }
    return result
}

pub fn main() void = trust {
    val arena: allocators.Arena = allocators.Arena.new(1024 as usize)?
    val route = normalize_path[allocators.Arena](arena, "  /API/Users/42  ")
    stdio.print("route: {s}\n", {str.cstr(route)})
}
