/// cc_expr_drain bug in the alt backend.

type Mat4 = {
    m00: f32
    m01: f32
    m02: f32
    m03: f32
    m10: f32
    m11: f32
    m12: f32
    m13: f32
    m20: f32
    m21: f32
    m22: f32
    m23: f32
    m30: f32
    m31: f32
    m32: f32
    m33: f32
}

fn mat4(
    m00: f32, m01: f32, m02: f32, m03: f32,
    m10: f32, m11: f32, m12: f32, m13: f32,
    m20: f32, m21: f32, m22: f32, m23: f32,
    m30: f32, m31: f32, m32: f32, m33: f32
) Mat4 = {
    return {
        m00: m00, m01: m01, m02: m02, m03: m03,
        m10: m10, m11: m11, m12: m12, m13: m13,
        m20: m20, m21: m21, m22: m22, m23: m23,
        m30: m30, m31: m31, m32: m32, m33: m33
    }
}

fn mat_mul(a: Mat4, b: Mat4) Mat4 = {
    return mat4(
        a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20 + a.m03 * b.m30,
        a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21 + a.m03 * b.m31,
        a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22 + a.m03 * b.m32,
        a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03 * b.m33,
        a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20 + a.m13 * b.m30,
        a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21 + a.m13 * b.m31,
        a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22 + a.m13 * b.m32,
        a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13 * b.m33,
        a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20 + a.m23 * b.m30,
        a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21 + a.m23 * b.m31,
        a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22 + a.m23 * b.m32,
        a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23 * b.m33,
        a.m30 * b.m00 + a.m31 * b.m10 + a.m32 * b.m20 + a.m33 * b.m30,
        a.m30 * b.m01 + a.m31 * b.m11 + a.m32 * b.m21 + a.m33 * b.m31,
        a.m30 * b.m02 + a.m31 * b.m12 + a.m32 * b.m22 + a.m33 * b.m32,
        a.m30 * b.m03 + a.m31 * b.m13 + a.m32 * b.m23 + a.m33 * b.m33
    )
}

pub fn main() i32 = {
    val a: Mat4 = mat4(
        1.0 as f32, 2.0 as f32, 3.0 as f32, 4.0 as f32,
        5.0 as f32, 6.0 as f32, 7.0 as f32, 8.0 as f32,
        9.0 as f32, 10.0 as f32, 11.0 as f32, 12.0 as f32,
        13.0 as f32, 14.0 as f32, 15.0 as f32, 16.0 as f32
    )
    mat_mul(a, a)
    return 0
}
