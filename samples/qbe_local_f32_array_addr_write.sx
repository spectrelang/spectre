// QBE codegen repro: write an element through a pointer into a local f32
// fixed array initialized from an array literal.
//
// Expected diagnostic:
//   qbe: ... invalid type for first operand %t1 in stores
//   error: qbe stage failed
//
// The store itself is valid when the array is initialized with @zeroed();
// the same pattern works for local [4]i32, [4]i64, [4]u8, and [4]f64 arrays.
pub fn main() void = trust {
    val arr: mut [4]f32 = [1.0, 2.0, 3.0, 4.0]
    val p = @addr(arr) as ref f32
    @store32(@ptradd(p, 0), 1077936128)
    assert @deref(p) == 3.0
}
