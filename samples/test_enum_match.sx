pub enum Color = {
    Red
    Green
    Blue
}

pub fn color_name(c: Color) ref u8 = {
    match c {
        Color.Red => {
            return c"red"
        }
        Color.Green => {
            return c"green"
        }
        Color.Blue => {
            return c"blue"
        }
    }
    return c"unknown"
}

val stdio = use("std/stdio")

pub fn main() void = {
    trust stdio.print("{s}\n", {color_name(Color.Red)})
}
