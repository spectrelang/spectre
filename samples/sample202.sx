val net        = use("std/net")
val allocators = use("std/allocators")
val stdio      = use("std/stdio")
val string     = use("std/string")

/// Write a complete HTTP response and close the connection.
fn respond(client: i64, status: ref u8, content_type: ref u8, body: ref u8) void = trust {
    val sb = string.StringBuilder.new()
    string.StringBuilder.append_cstr(sb, "HTTP/1.1 ")
    string.StringBuilder.append_cstr(sb, status)
    string.StringBuilder.append_cstr(sb, "\r\nContent-Type: ")
    string.StringBuilder.append_cstr(sb, content_type)
    string.StringBuilder.append_cstr(sb, "\r\nContent-Length: ")
    string.StringBuilder.append_cstr(sb, @fmt("{d}", {string.len_raw(body)}))
    string.StringBuilder.append_cstr(sb, "\r\nConnection: close\r\n\r\n")
    string.StringBuilder.append_cstr(sb, body)

    val response: mut string.String = string.StringBuilder.build(sb)
    net.TcpServer.send(client, string.cstr(response), string.len(response))

    string.string_free(response)
    string.StringBuilder.free(sb)
}

/// Route a request to one of the demo endpoints.
fn handle_request(client: i64, request: ref u8) void = trust {
    if string.raw_starts_with(request, "GET / HTTP/1.1") {
        respond(client, "200 OK", "application/json", "{\"name\":\"Spectre API\",\"version\":\"0.1.0\",\"endpoints\":[\"/health\",\"/hello\"]}")
    } elif string.raw_starts_with(request, "GET /health HTTP/1.1") {
        respond(client, "200 OK", "application/json", "{\"status\":\"ok\"}")
    } elif string.raw_starts_with(request, "GET /hello HTTP/1.1") {
        respond(client, "200 OK", "application/json", "{\"message\":\"Hello, world!\"}")
    } else {
        respond(client, "404 Not Found", "application/json", "{\"error\":\"Not found\"}")
    }
}

pub fn main() void = trust {
    val ac: allocators.HeapAllocator = @zeroed

    val server = net.TcpServer.listen[_](ac, 8080 as i32)
    if server == none {
        stdio.print("Failed to start server\n", {})
        return
    }

    stdio.print("API listening on port {d}\n", {net.TcpServer.port(server)})

    for {
        val client = net.TcpServer.accept(server)
        if client < 0 {
            continue
        }

        val request: mut ref u8 = @alloc(4096) as mut ref u8
        if request == none {
            net.TcpServer.close_client(client)
            continue
        }

        val received = net.TcpServer.recv(client, request, 4095)
        if received > 0 {
            @store8(@ptradd(request, received), 0)
            handle_request(client, request)
        }

        @free(request)
        net.TcpServer.close_client(client)
    }
}
