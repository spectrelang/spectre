pub fn strcmp(a: ref u8, b: ref u8) i64 = {
    return @strcmp(a, b)
}

pub fn main() void = trust {
    assert strcmp("", "") == 0
    assert strcmp("abc", "abc") == 0
    assert strcmp("abc", "abd") < 0
    assert strcmp("abd", "abc") > 0
    assert strcmp("a", "") > 0
    assert strcmp("", "a") < 0
    @puts("strcmp ok\n")
}
