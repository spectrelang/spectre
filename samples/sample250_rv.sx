pub fn strcmp(a: ref u8, b: ref u8) i64 = {
    return @strcmp(a, b)
}

pub fn main() void = trust {
    assert strcmp(c"", c"") == 0
    assert strcmp(c"abc", c"abc") == 0
    assert strcmp(c"abc", c"abd") < 0
    assert strcmp(c"abd", c"abc") > 0
    assert strcmp(c"a", c"") > 0
    assert strcmp(c"", c"a") < 0
    @puts("strcmp ok\n")
}
