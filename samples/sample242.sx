val stdio = use("std/stdio")

pub fn main() void = {
    val st: mut SomeType = { x: 255, y: 0, z: 0, m: 0, a: 0, b: 0, c: 0, d: 0 }
    val n = test_number(st, @addr(st), @addr(st.x), 255, 65535, 3.1415926)
    //val n = test_number(st, @addr(st), @addr(st.x), 255 as u8, 65535 as u16, 3.1415926 as f32)
    trust stdio.print("\nst: x={d} y={d} z={d} m={d} a={d}\n", {st.x, st.y, st.z, st.m, st.a})
    trust stdio.print("n = {d}", {n})
}

type SomeType = {
    x: mut u8 y: mut u8 z: mut u8 m: mut u8
    a: mut u8 b: mut u8 c: mut u8 d: mut u8
}
fn test_number(st: mut SomeType, pst: mut ref SomeType, px: mut ref u8, a: u8, b: u16, c: f32) u64 = {
    st.x = st.x + 1 trust stdio.print("st.x + 1 = {d}\n", {st.x})
    pst.x = pst.x - 1 trust stdio.print("pst->x - 1 = {d}\n", {pst.x})
    @deref(px) = @deref(px) + 1 trust stdio.print("*px + 1 = {d}\t# It's u8 !!?\n", {@deref(px)}) // bug 256 !!?
    @deref(px) = 0
    @deref(px) = @deref(px) - 3 trust stdio.print("*px = 0\n*px - 3 = {d}\n", {@deref(px)}) // bug -3 !!? maybe is i32
    trust stdio.print("*((u64*)px) = {u}\t# maybe it's i32\n", {@deref(px as ref u64)})

    //return st.x + pst.x + @deref(px) + a + b + c
    return st.x + pst.x + @deref(px) + a + b + c as u64
}