val flags = use("std/flags")
val stdio = use("std/stdio")
val os    = use("std/os")

pub fn main() void = trust {
    val verbose: mut bool = false
    val name: mut ref u8 = c"world"
    val times: mut i64 = 1

    val fs: mut flags.FlagSet = flags.new(c"greet", c"Say hello to someone, a few times.")?

    // Double-dash spellings are disabled by default.
    // flags.allow_double_dash(fs, true)

    flags.bool_var(fs, c"verbose", c"v", @addr(verbose), c"print extra information")
    flags.string_var(fs, c"name", c"n", @addr(name), c"who to greet")
    flags.int_var(fs, c"times", c"t", @addr(times), c"how many greetings")

    val argv = os.get_args()
    match flags.parse(fs, argv) {
        ok _ => {}
        err e => {
            if flags.is_help(e) {
                flags.usage(fs)
                return
            }
            stdio.eprint("error: {s}\n", {flags.message(e)})
            flags.usage_err(fs)
            os.exit(1)
        }
    }

    for i = 0, i < times, i++ {
        stdio.print("hello, {s}!\n", {name})
    }

    if verbose {
        stdio.print("verbose: name={s} times={d}\n", {name, times})
    }

    for extra in flags.args(fs) {
        stdio.print("extra argument: {s}\n", {extra})
    }

    flags.destroy(fs)
}
