val cstr       = use("std/string/cstr")
val allocators = use("std/allocators")

type Vec2 = {
    x: f64
    y: f64
}

pub fn map[A: allocators.GeneralAllocator, T, U](
    ac: A,
    items: list[T],
    f: fn(T) U
) list[U] = {
    val out: mut list[U] = @listalloc[A, U](ac)?

    for x in items {
        val y = @call(f, x)
        @append(out, y)
    }

    return out
}

pub fn reduce[T, U](items: list[T], init: U, f: fn(U, T) U) U = {
    val acc: mut U = init

    for x in items {
        acc = @call(f, acc, x)
    }

    return acc
}

pub fn double_i32(x: i32) i32 = {
    return x * 2
}

pub fn half_f64(x: f64) f64 = {
    return x / 2.0
}

pub fn excite_str(x: ref u8) ref u8 = {
    return trust cstr.concat(x, c"!")
}

pub fn shift_vec2(v: Vec2) Vec2 = {
    return { x: v.x + 1.0, y: v.y + 1.0 }
}

pub fn add_i32(acc: i32, x: i32) i32 = {
    return acc + x
}

pub fn add_f64(acc: f64, x: f64) f64 = {
    return acc + x
}

pub fn concat_str(acc: ref u8, x: ref u8) ref u8 = {
    return trust cstr.concat(acc, x)
}

pub fn add_vec2(acc: Vec2, x: Vec2) Vec2 = {
    return {
        x: acc.x + x.x,
        y: acc.y + x.y
    }
}

// pub fn main() void = {
//     val f: fn(Vec2) Vec2 = shift_vec2
//     val v = @call(f, {x: 1.0, y: 2.0})
//
//     trust @print("{f} {f}\n", {v.x, v.y})
// }


pub fn main() void = {
    val sa: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(8192 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val nums = @list(la, 1, 2, 3, 4)?
    val nums2 = map[allocators.ListArena, i32, i32](la, nums, double_i32)
    val sum_nums = reduce[i32, i32](nums2, 0, add_i32)

    trust @print("int = {d}\n", {sum_nums})

    val floats = @list(la, 1.0, 2.0, 3.0)?
    val floats2 = map[allocators.ListArena, f64, f64](la, floats, half_f64)
    val sum_floats = reduce[f64, f64](floats2, 0.0, add_f64)

    trust @print("float = {f}\n", {sum_floats})

    val words = @list(la, c"a", c"b", c"c")?
    val excited = map[allocators.ListArena, ref u8, ref u8](la, words, excite_str)
    val sentence = reduce[ref u8, ref u8](excited, "" as ref u8, concat_str)

    trust @print("{s}\n", {sentence})

    val pts: list[Vec2] = @list(
        la,
        {x: 1.0, y: 2.0},
        {x: 3.0, y: 4.0}
    )?

    val moved = map[allocators.ListArena, Vec2, Vec2](la, pts, shift_vec2)
    val total = reduce[Vec2, Vec2](moved, {x: 0.0, y: 0.0}, add_vec2)

    trust @print("vec = ({f}, {f})\n", {total.x, total.y})
    trust allocators.ScopedArena.free(sa)
}
