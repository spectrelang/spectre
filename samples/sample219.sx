val allocators = use("std/allocators")
val stdio      = use("std/stdio")

pub fn main() void = trust {
    val ac: allocators.HeapAllocator = @zeroed

    // Allocator-backed literal with inferred element type.
    val xs: list[i64] = @list(ac, 1, 2, 3, 4)?
    stdio.print("allocator list: len={d} cap={d}\n", {@len(xs), @capacity(xs)})
    @listfree(xs)

    // Empty allocator-backed list, element type from the annotation.
    val empty: list[i64] = @list(ac)?
    stdio.print("empty allocator list: len={d}\n", {@len(empty)})
    @listfree(empty)

    // Raw literal syntax remains available.
    val raw = @list(ac, 5, 6, 7)?
    stdio.print("raw list: len={d}\n", {@len(raw)})
    @listfree(raw)
}
