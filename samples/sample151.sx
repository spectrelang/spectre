val cstr = use("std/string/cstr")

pub fn combine[T, U](left: T, right: U) T = {
    when T is ref u8 && U is ref u8 {
        return trust cstr.concat(left, right)
    }
    when T in (i32, i64) {
        when U in (i32, i64) {
            return left + right
        }
    }
    return left
}

pub fn main() void = {
    val text = combine[ref u8, ref u8](c"generic ", c"strings")
    val total = combine[i64, i64](30, 12)
    trust @print("{s}\n", {text})
    trust @print("{d}\n", {total})
}
