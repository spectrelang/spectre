// QBE codegen repro: take a pointer into a local f32 fixed array and read an
// element through @ptradd.
//
// Expected diagnostic:
//   qbe: ... invalid type for first operand %t1 in stores
//   error: qbe stage failed
//
// The failure comes from lowering the f32 array literal, not from the read:
// the identical read works for [4]i32, [4]i64, [4]u8, and [4]f64 locals, and
// works for f32 when the local array is initialized with @zeroed().
pub fn main() void = trust {
    val arr: mut [4]f32 = [1.0, 2.0, 3.0, 4.0]
    val p = @addr(arr) as ref f32
    assert @deref(@ptradd(p, 8)) == 3.0
}
