pub fn something(v: i32) option[ref u8] = {
    if v < 10 {
        return some "hello"
    }
    return some ":)"
}

pub fn main() void = {
    // Current syntax:
    if something(11 as i32) is some v {
        trust @print("{s}\n", {v})
    }

    // Instead of that, we can do this:
    if something(11 as i32) is some v {
        trust @print("{s}\n", {v})
    }
}
