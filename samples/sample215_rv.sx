val stdio      = use("std/stdio")
val str     = use("std/string")
val ostr = use("std/string/owned")
val fmt        = use("std/fmt")
val allocators = use("std/allocators")

pub fn main() void = trust {
    val arena = allocators.Arena.new(4096 as usize)?

    val formatted = fmt.format[allocators.Arena](
        arena,
        c"{s} {d} {d} {d}",
        {c"many", 11, 22, 33}
    )
    assert str.cmp_raw(ostr.cstr(formatted), c"many 11 22 33") == 0

    allocators.Arena.free(arena)
    stdio.puts("generic argspack pack values ok")
}
