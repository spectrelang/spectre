val allocators = use("std/allocators")

pub union Kind = {
    Foo()
    | Bar(i64)
}

fn get_kind(items: list[ref Kind], i: i64) Kind = trust {
    val opt = @get(items, i as usize)
    if opt is some t {
        return (t as ref Kind)
    } else {
        return Foo()
    }
}

pub fn main() i64 = trust {
    val sa: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(4096 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val items: list[ref Kind] = @listalloc[allocators.ListArena, ref Kind](la)?
    val k = get_kind(items, 0)
    match k {
        Foo() => {
            @puts("foo")
        }
        Bar _ => {
            @puts("bar")
        }
    }
    allocators.ScopedArena.free(sa)
    return 0
}
