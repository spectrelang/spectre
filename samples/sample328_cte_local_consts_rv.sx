pub fn main() void = {
    val base: i64 = 40
    val offset: i64 = 2
    val answer: i64 = @static(base + offset)
    assert answer == 42

    val chained: i64 = @static(answer + 1)
    assert chained == 43

    val untyped = 10
    val other: i64 = @static(untyped + 32)
    assert other == 42

    if true {
        val inner_offset: i64 = 100
        val inner: i64 = @static(base + inner_offset)
        assert inner == 140
    }
    assert offset == 2
}
