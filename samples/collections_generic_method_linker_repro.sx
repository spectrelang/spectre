val allocators = use("../std/allocators")
val collections = use("../std/collections")

pub fn main() result[void, collections.ListAllocError] = trust {
    val heap: allocators.HeapAllocator = @zeroed
    val m: ref void = collections.IndexMap.new[allocators.HeapAllocator](heap, 8 as usize)?
    collections.IndexMap.set[allocators.HeapAllocator](heap, m, "hello", 1 as usize)?
    @print("{d}\n", {collections.IndexMap.len(m)})
    return ok ()
}
