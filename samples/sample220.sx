val allocators = use("std/allocators")
val stdio      = use("std/stdio")
val str        = use("std/string")

// Result values can be passed to ordinary helper parameters.
fn unwrap(r: result[ref u8, allocators.AllocError]) ref u8 = trust {
    match r {
        ok p => {
            return p
        }
        err _ => {
            return none
        }
    }
    return none
}

// Argument packs can be forwarded through ordinary helper functions.
fn vfmt(args: argspack) ref u8 = trust {
    val b: ref u8 = @alloc(256) as ref u8
    @snprintf(b, 256, "{s} {s}", args)
    return b
}

fn forward(args: argspack) ref u8 = trust {
    return vfmt(args)
}

pub fn main() void = trust {
    val h: allocators.HeapAllocator = @zeroed
    val msg = unwrap(@fmtalloc[allocators.HeapAllocator](h, "result {d}", {7}))
    stdio.puts(str.view_cstr(msg))
    stdio.puts("\n")
    allocators.HeapAllocator.free(h, msg as ref void)

    val packed: mut ref u8 = forward({"pack", "forwarded"})
    stdio.puts(str.view_cstr(packed))
    stdio.puts("\n")
    @free(packed as ref void)
}
