val CELL_SIZE: f32 = 1.0 as f32
val COUNT: i32 = 4 as i32

fn scale(v: f32) f32 = {
    return v * CELL_SIZE
}

pub fn main() i32 = {
    val x: f32 = scale(3.0 as f32)
    if x < (2.9 as f32) || x > (3.1 as f32) {
        return 1 as i32
    }
    if COUNT != (4 as i32) {
        return 2 as i32
    }
    return 0 as i32
}
