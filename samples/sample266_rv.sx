val str     = use("std/string")
val cstr = use("std/string/cstr")
val allocators = use("std/allocators")

pub fn main() void = trust {
    val literal: mut ref u8 = @fmtalloc("lit={s}", {"view-literal"})
    assert cstr.cmp(literal, c"lit=view-literal") == 0
    @free(literal)

    val base = c"prefix:body:suffix"
    val view: str.StringView = str.slice(str.from_cstr(base), 7, 11)

    val sliced: mut ref u8 = @fmtalloc("slice={s}!", {view})
    assert cstr.cmp(sliced, c"slice=body!") == 0
    @free(sliced)

    val mixed: mut ref u8 = @fmtalloc("{d}:{s}:{d}", {3, view, 7})
    assert cstr.cmp(mixed, c"3:body:7") == 0
    @free(mixed)

    val ac: allocators.HeapAllocator = @zeroed
    val allocated = @fmtalloc[allocators.HeapAllocator](
        ac,
        "alloc {d}:{s}",
        {5, view}
    )?
    assert cstr.cmp(allocated, c"alloc 5:body") == 0
    allocators.HeapAllocator.free(ac, allocated as ref void)

    val buf: mut ref u8 = @alloc(64) as mut ref u8
    @snprintf(buf, 64, "sn={d}:{s}", {11, view})
    assert cstr.cmp(buf, c"sn=11:body") == 0
    @free(buf)

    @print("print={s}\n", {view})
}
