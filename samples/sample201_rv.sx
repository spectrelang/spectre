val GRID: mut [2][3]i32 = [
    [1, 0, 3],
    [4, 5, 6]
]

pub fn main() i32 = {
    if @get(GRID, 0, 0) is some v {
        if v != 1 {
            return 1
        }
    } else {
        return 2
    }
    if @get(GRID, 0, 1) is some v {
        if v != 0 {
            return 3
        }
    } else {
        return 4
    }
    if @get(GRID, 1, 2) is some v {
        if v != 6 {
            return 5
        }
    } else {
        return 6
    }
    return 0
}
