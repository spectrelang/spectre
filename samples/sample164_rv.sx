type Item = {
    value: i32
}

type Manager = {
    scenes: mut list[Item]
    active_index: mut usize
}

type Root = {
    m: mut Manager
}

pub fn main() i32 = {
    val root: mut Root = {
        m: {
            scenes: [],
            active_index: 0 as usize
        }
    }

    @append(root.m.scenes, { value: 7 as i32 })

    if @get(root.m.scenes, root.m.active_index) is some scene {
        return scene.value
    }

    return 0 as i32
}
