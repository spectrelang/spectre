val allocators = use("std/allocators")

type Item = {
    value: i32
}

type Manager = {
    scenes: mut list[Item]
    active_index: mut usize
}

type Root = {
    m: mut Manager
}

pub fn main() i32 = {
    val sa: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(4096 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val root: mut Root = {
        m: {
            scenes: @listalloc[allocators.ListArena, Item](la)?,
            active_index: 0 as usize
        }
    }

    @append(root.m.scenes, { value: 7 as i32 })

    if @get(root.m.scenes, root.m.active_index) is some scene {
        trust allocators.ScopedArena.free(sa)
        return scene.value
    }

    trust allocators.ScopedArena.free(sa)
    return 0 as i32
}
