fn nested_hell(x: i32) i32 = trust {
    pre {
        start: x >= 0
    }

    if x > 0 {
        
            match some x {
                some a => {
                    if a > 1 {
                        
                            match some a {
                                some b => {
                                    if b > 2 {
                                        
                                            match some b {
                                                some c => {
                                                    if c > 3 {
                                                        pre {
                                                            deeper: c > 3
                                                        }
                                                        return nested_hell(c - 1) + 1
                                                    } else {
                                                        return c
                                                    }
                                                }
                                                none => { return 0 }
                                            }
                                        
                                    } else {
                                        return b
                                    }
                                }
                                none => { return 0 }
                            }
                        
                    } else {
                        return a
                    }
                }
                none => { return 0 }
            }
        
    } else {
        return 0
    }
}

spec Val = {
    fn get(s: self) i32
}

fn smash[T: Val](x: T, n: i32) i32 = {
    pre {
        n_ok: n >= 0
    }
    when T is A00 {
        return T.get(x) + n
    }
    when T is A01 {
        return T.get(x) + n + 1
    }
    when T is A02 {
        return T.get(x) + n + 2
    }
    when T is A03 {
        return T.get(x) + n + 3
    }
    when T is A04 {
        return T.get(x) + n + 4
    }
    when T is A05 {
        return T.get(x) + n + 5
    }
    when T is A06 {
        return T.get(x) + n + 6
    }
    when T is A07 {
        return T.get(x) + n + 7
    }
    when T is A08 {
        return T.get(x) + n + 8
    }
    when T is A09 {
        return T.get(x) + n + 9
    }
    return n
}

pub fn main() void = trust {
    val r1 = deep_add(10)
    val r2 = nested_hell(12)

    val a0: A00 = {v: 42}
    val a1: A01 = {v: 43}
    val a2: A02 = {v: 44}
    val a3: A03 = {v: 45}
    val a4: A04 = {v: 46}

    val s0 = smash[A00](a0, 1)
    val s1 = smash[A01](a1, 2)
    val s2 = smash[A02](a2, 3)
    val s3 = smash[A03](a3, 4)
    val s4 = smash[A04](a4, 5)

    stdio.print("results: {d} {d} {d}\n", {r1, r2, s0 + s1 + s2 + s3 + s4})
}