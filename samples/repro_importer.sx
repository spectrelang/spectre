// Problem: C emission for list element assignments inside a returned struct literal corrupts when imported
// symbol names are long enough.
val abcdef = use("abcdef.sx")

fn build_demo_scene() abcdef.Scene3D = {
    return {
        sphere0: abcdef.make_sphere(
            abcdef.make_vec3(-1.75 as f32, -0.45 as f32, 0.6 as f32),
            abcdef.make_vec3(0.96 as f32, 0.38 as f32, 0.33 as f32),
            0.92 as f32
        ),
        sphere1: abcdef.make_sphere(
            abcdef.make_vec3(1.75 as f32, -0.22 as f32, -1.0 as f32),
            abcdef.make_vec3(0.32 as f32, 0.72 as f32, 1.00 as f32),
            1.02 as f32
        ),
        cube0: abcdef.make_cube(
            abcdef.make_vec3(-1.55 as f32, 0.82 as f32, -0.65 as f32),
            abcdef.make_vec3(1.00 as f32, 0.44 as f32, 0.82 as f32),
            0.98 as f32,
            1.15 as f32
        ),
        cube1: abcdef.make_cube(
            abcdef.make_vec3(1.55 as f32, 1.16 as f32, -2.30 as f32),
            abcdef.make_vec3(0.28 as f32, 0.92 as f32, 1.00 as f32),
            1.16 as f32,
            -0.88 as f32
        ),
        stars: [
            abcdef.make_star(abcdef.make_vec3(-7.0 as f32, 4.8 as f32, -13.0 as f32), abcdef.make_vec3(0.95 as f32, 0.98 as f32, 1.00 as f32), 0.06 as f32, 0.26 as f32),
            abcdef.make_star(abcdef.make_vec3(-5.4 as f32, 6.0 as f32, -11.0 as f32), abcdef.make_vec3(0.72 as f32, 0.84 as f32, 1.00 as f32), 0.05 as f32, 0.22 as f32),
            abcdef.make_star(abcdef.make_vec3(-3.1 as f32, 5.4 as f32, -12.5 as f32), abcdef.make_vec3(1.00 as f32, 0.90 as f32, 0.78 as f32), 0.07 as f32, 0.28 as f32),
            abcdef.make_star(abcdef.make_vec3(-1.2 as f32, 6.4 as f32, -10.4 as f32), abcdef.make_vec3(0.82 as f32, 0.92 as f32, 1.00 as f32), 0.05 as f32, 0.20 as f32),
            abcdef.make_star(abcdef.make_vec3(0.8 as f32, 5.0 as f32, -14.0 as f32), abcdef.make_vec3(0.96 as f32, 0.98 as f32, 1.00 as f32), 0.06 as f32, 0.24 as f32),
            abcdef.make_star(abcdef.make_vec3(2.5 as f32, 6.1 as f32, -12.2 as f32), abcdef.make_vec3(0.72 as f32, 0.84 as f32, 1.00 as f32), 0.05 as f32, 0.22 as f32),
            abcdef.make_star(abcdef.make_vec3(4.7 as f32, 5.6 as f32, -11.4 as f32), abcdef.make_vec3(1.00 as f32, 0.92 as f32, 0.84 as f32), 0.06 as f32, 0.24 as f32),
            abcdef.make_star(abcdef.make_vec3(6.8 as f32, 4.9 as f32, -13.3 as f32), abcdef.make_vec3(0.84 as f32, 0.92 as f32, 1.00 as f32), 0.05 as f32, 0.20 as f32)
        ],
        particles: [
            abcdef.make_particle(abcdef.make_vec3(-1.55 as f32, 0.35 as f32, -0.65 as f32), abcdef.make_vec3(1.00 as f32, 0.48 as f32, 0.86 as f32), 0.08 as f32, 0.42 as f32, 1.80 as f32, 0.0 as f32, 0.28 as f32, 0.46 as f32),
            abcdef.make_particle(abcdef.make_vec3(-1.55 as f32, 0.42 as f32, -0.65 as f32), abcdef.make_vec3(0.98 as f32, 0.74 as f32, 1.00 as f32), 0.05 as f32, 0.56 as f32, 1.20 as f32, 1.4 as f32, 0.52 as f32, 0.30 as f32),
            abcdef.make_particle(abcdef.make_vec3(1.55 as f32, 0.58 as f32, -2.30 as f32), abcdef.make_vec3(0.34 as f32, 0.90 as f32, 1.00 as f32), 0.09 as f32, 0.48 as f32, -1.55 as f32, 0.5 as f32, 0.32 as f32, 0.48 as f32),
            abcdef.make_particle(abcdef.make_vec3(1.55 as f32, 0.72 as f32, -2.30 as f32), abcdef.make_vec3(0.78 as f32, 0.96 as f32, 1.00 as f32), 0.05 as f32, 0.64 as f32, -1.10 as f32, 2.1 as f32, 0.66 as f32, 0.30 as f32),
            abcdef.make_particle(abcdef.make_vec3(0.0 as f32, 0.30 as f32, -1.50 as f32), abcdef.make_vec3(1.00 as f32, 0.84 as f32, 0.56 as f32), 0.05 as f32, 1.20 as f32, 0.75 as f32, 2.4 as f32, 0.18 as f32, 0.20 as f32)
        ],
        environment: abcdef.default_environment(),
        model: abcdef.empty_model()
    }
}

pub fn main() i32 = {
    val scene: abcdef.Scene3D = build_demo_scene()
    if @len(scene.particles) == 5 as usize {
        return 0 as i32
    }
    return 1 as i32
}
