val m = use("sample177_mod.sx")

pub fn main() i32 = {
    val w: option[m.WaterSurface] = some m.make_water(
        0.05 as f32,
        2.2 as f32,
        2.2 as f32,
        m.make_vec3(0.18 as f32, 0.52 as f32, 0.82 as f32),
        1.4 as f32,
        0.018 as f32,
        2.8 as f32
    )
    if w is some v {
        if v.wave_frequency > (2.0 as f32) {
            return 0 as i32
        }
    }
    return 1 as i32
}
