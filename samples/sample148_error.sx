pub fn some_func[T](x: T, y: i32) i32 = {
    when T in (i32, i64, usize, isize) {
        return x + y
    }
    when T !in (i32, i64, usize, isize) {
        @staticerror("bad value")
    }
    return y
}

pub fn main() void = {
    val bad = some_func[f64](12.0, 14 as i32)
    trust @print("{d}\n", {bad})
}

