type Vec3 = {
    x: f32
    y: f32
    z: f32
}

type Star = {
    position: Vec3
    color: Vec3
    radius: f32
    glow: f32
}

type Particle = {
    center: Vec3
    color: Vec3
    radius: f32
    orbit_radius: f32
    speed: f32
    phase: f32
    height: f32
    glow: f32
}

type Demo = {
    stars: list[Star]
    particles: list[Particle]
}

fn vec3(x: f32, y: f32, z: f32) Vec3 = {
    return { x: x, y: y, z: z }
}

fn make_star(position: Vec3, color: Vec3, radius: f32, glow: f32) Star = {
    return {
        position: position,
        color: color,
        radius: radius,
        glow: glow
    }
}

fn make_particle(
    center: Vec3,
    color: Vec3,
    radius: f32,
    orbit_radius: f32,
    speed: f32,
    phase: f32,
    height: f32,
    glow: f32
) Particle = {
    return {
        center: center,
        color: color,
        radius: radius,
        orbit_radius: orbit_radius,
        speed: speed,
        phase: phase,
        height: height,
        glow: glow
    }
}

fn build_demo() Demo = {
    return {
        stars: [
            make_star(
                vec3(-7.0 as f32, 4.8 as f32, -13.0 as f32),
                vec3(0.95 as f32, 0.98 as f32, 1.00 as f32),
                0.06 as f32,
                0.26 as f32
            )
        ],
        particles: [
            make_particle(
                vec3(-1.55 as f32, 0.35 as f32, -0.65 as f32),
                vec3(1.00 as f32, 0.48 as f32, 0.86 as f32),
                0.08 as f32,
                0.42 as f32,
                1.80 as f32,
                0.0 as f32,
                0.28 as f32,
                0.46 as f32
            ),
            make_particle(
                vec3(-1.55 as f32, 0.42 as f32, -0.65 as f32),
                vec3(0.98 as f32, 0.74 as f32, 1.00 as f32),
                0.05 as f32,
                0.56 as f32,
                1.20 as f32,
                1.4 as f32,
                0.52 as f32,
                0.30 as f32
            ),
            make_particle(
                vec3(1.55 as f32, 0.58 as f32, -2.30 as f32),
                vec3(0.34 as f32, 0.90 as f32, 1.00 as f32),
                0.09 as f32,
                0.48 as f32,
                -1.55 as f32,
                0.5 as f32,
                0.32 as f32,
                0.48 as f32
            ),
            make_particle(
                vec3(1.55 as f32, 0.72 as f32, -2.30 as f32),
                vec3(0.78 as f32, 0.96 as f32, 1.00 as f32),
                0.05 as f32,
                0.64 as f32,
                -1.10 as f32,
                2.1 as f32,
                0.66 as f32,
                0.30 as f32
            )
        ]
    }
}

pub fn main() i32 = {
    val d: Demo = build_demo()
    trust @print("{p}\n", {d})
    return 0 as i32
}
