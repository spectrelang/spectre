val allocators = use("std/allocators")
val fs         = use("std/fs")
val cstr       = use("std/string/cstr")

pub fn read_len[A: allocators.Allocator](ac: A, path: ref u8) i64 = trust {
    if fs.read_all_cstr[A](ac, path) is some text {
        return cstr.len(text as ref u8)
    } else {
        return -1
    }
}

pub fn cwd_len[A: allocators.Allocator](ac: A) i64 = trust {
    if fs.cwd[A](ac) is some dir {
        return cstr.len(dir as ref u8)
    } else {
        return -1
    }
}

pub fn walk_count[A: allocators.GeneralAllocator](ac: A, path: ref u8) i64 = trust {
    if fs.walk_dir[A](ac, path) is some entries {
        val count: mut i64 = 0
        for _ in entries {
            count++
        }
        return count
    } else {
        return -1
    }
}

pub fn passthrough_read[A: allocators.Allocator](ac: A, path: ref u8) option[ref u8] = trust {
    return fs.read_all_cstr[A](ac, path)
}

pub fn main() void = {}
