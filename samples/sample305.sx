val rand  = use("std/fastrand")
val stdio = use("std/stdio")
val fmt   = use("std/fmt")

pub fn main() void = trust {
    val actual = rand.random_u32_below(100)
    for {
        val buf: ref u8 = @alloc(50)
        stdio.read_line(buf, 100)
        val guess = fmt.string_to_i64(buf)
        if guess is ok g {
            if g == actual {
                break
            } elif g < actual {
                @puts("too low")
                continue
            }
            @puts("too high")
        }
    }
    @puts("correct")
}
