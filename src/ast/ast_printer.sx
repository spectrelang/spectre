val stdio  = use("std/stdio")
val parser = use("parser.sx")

fn kind_to_name(kind: i64) ref u8 = {
    if kind == parser.NK_FN {
        return c"FN"
    } elif kind == parser.NK_USE {
        return c"USE"
    } elif kind == parser.NK_TYPEDEF {
        return c"TYPEDEF"
    } elif kind == parser.NK_ENUMDEF {
        return c"ENUMDEF"
    } elif kind == parser.NK_UNIONDEF {
        return c"UNIONDEF"
    } elif kind == parser.NK_CONST {
        return c"CONST"
    } elif kind == parser.NK_EXTERN_FN {
        return c"EXTERN_FN"
    } elif kind == parser.NK_EXTERN_TYPE {
        return c"EXTERN_TYPE"
    } elif kind == parser.NK_EXTERN_VAL {
        return c"EXTERN_VAL"
    } elif kind == parser.NK_LINK {
        return c"LINK"
    } elif kind == parser.NK_LIB {
        return c"LIB"
    } elif kind == parser.NK_EXTERN_HEADER {
        return c"EXTERN_HEADER"
    } elif kind == parser.NK_WHEN_ITEMS {
        return c"WHEN_ITEMS"
    } elif kind == parser.NK_TAGGED_UNIONDEF {
        return c"TAGGED_UNIONDEF"
    } elif kind == parser.NK_VAL {
        return c"VAL"
    } elif kind == parser.NK_ASSIGN {
        return c"ASSIGN"
    } elif kind == parser.NK_RETURN {
        return c"RETURN"
    } elif kind == parser.NK_IF {
        return c"IF"
    } elif kind == parser.NK_FOR {
        return c"FOR"
    } elif kind == parser.NK_FORIN {
        return c"FORIN"
    } elif kind == parser.NK_BREAK {
        return c"BREAK"
    } elif kind == parser.NK_CONTINUE {
        return c"CONTINUE"
    } elif kind == parser.NK_DEFER {
        return c"DEFER"
    } elif kind == parser.NK_ASSERT {
        return c"ASSERT"
    } elif kind == parser.NK_PRE {
        return c"PRE"
    } elif kind == parser.NK_POST {
        return c"POST"
    } elif kind == parser.NK_GUARDED_PRE {
        return c"GUARDED_PRE"
    } elif kind == parser.NK_GUARDED_POST {
        return c"GUARDED_POST"
    } elif kind == parser.NK_EXPR_STMT {
        return c"EXPR_STMT"
    } elif kind == parser.NK_MATCH_OPT {
        return c"MATCH_OPT"
    } elif kind == parser.NK_MATCH_RES {
        return c"MATCH_RES"
    } elif kind == parser.NK_MATCH_ENUM {
        return c"MATCH_ENUM"
    } elif kind == parser.NK_MATCH_VALUE {
        return c"MATCH_VALUE"
    } elif kind == parser.NK_MATCH_UNION {
