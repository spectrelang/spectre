    } elif kind == parser.NK_MATCH_STR {
        return c"MATCH_STR"
    } elif kind == parser.NK_WHEN_STMT {
        return c"WHEN_STMT"
    } elif kind == parser.NK_INCREMENT {
        return c"INCREMENT"
    } elif kind == parser.NK_DECREMENT {
        return c"DECREMENT"
    } elif kind == parser.NK_ADD_ASSIGN {
        return c"ADD_ASSIGN"
    } elif kind == parser.NK_SUB_ASSIGN {
        return c"SUB_ASSIGN"
    } elif kind == parser.NK_TEST {
        return c"TEST"
    } elif kind == parser.NK_MATCH_TAGGED_UNION {
        return c"MATCH_TAGGED_UNION"
    } elif kind == parser.NK_GUARD {
        return c"GUARD"
    } elif kind == parser.NK_INT_LIT {
        return c"INT_LIT"
    } elif kind == parser.NK_FLOAT_LIT {
        return c"FLOAT_LIT"
    } elif kind == parser.NK_STR_LIT {
        return c"STR_LIT"
    } elif kind == parser.NK_IDENT {
        return c"IDENT"
    } elif kind == parser.NK_BOOL {
        return c"BOOL"
    } elif kind == parser.NK_SOME {
