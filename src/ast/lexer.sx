val allocators = use("std/allocators")
val mem        = use("../meta/mem.sx")
val str        = use("std/string")
val cstr       = use("std/string/cstr")

val SUPPRESS_UNUSED: i64 = 1

pub union TokenKind = {
    Fn()
    | Spec()
    | Val()
    | Mut()
    | Pub()
    | Type()
    | Pre()
    | Post()
    | Return()
    | If()
    | Else()
    | Elif()
    | Trust()
    | Inline()
    | Use()
    | Ref()
    | For()
    | In()
    | Some()
    | None()
    | Ok()
    | Err()
    | Match()
    | True()
    | False()
    | Defer()
    | Break()
    | Continue()
    | As()
    | Assert()
    | When()
    | Union()
    | Enum()
    | Extern()
    | Link()
    | Lib()
    | Guarded()
    | Not()
    | Test()
    | Guard()
    | Invariant()
    | Ident(ref u8)
    | Str(ref u8)
    | CStr(ref u8)
    | Int(ref u8)
    | Float(ref u8)
    | CharLit(i64)
    | LParen()
    | RParen()
    | LBrace()
    | RBrace()
    | LBracket()
    | RBracket()
    | Colon()
    | Semicolon()
    | Comma()
    | Dot()
    | DotDotDot()
    | Eq()
    | Bang()
    | At()
    | Plus()
    | Minus()
    | Star()
    | Slash()
    | Percent()
    | PlusPlus()
    | MinusMinus()
    | PlusEq()
    | MinusEq()
    | EqEq()
    | BangEq()
    | Lt()
    | Gt()
    | LtEq()
    | GtEq()
    | And()
    | Or()
    | BitAnd()
    | BitOr()
    | BitXor()
    | Shl()
    | Shr()
    | Arrow()
    | FatArrow()
    | Tilde()
    | Question()
    | Eof()
}

pub type Token = {
    kind: mut TokenKind
    /// Payload for ident, string, integer, and float tokens.
    text: mut str.StringView
    line: mut i64
    col: mut i64
    /// Suppression directives attached to this token by preceding comments.
    suppress: mut i64
    /// Non-none when this token list owns its backing arena.
    arena: mut allocators.ScopedArenaAllocator
}

fn make_tok(l: mut ref Lexer, kind: TokenKind, line: i64, col: i64) ref Token = trust {
    val t: mut ref Token = allocators.ScopedArena.alloc_or_none(
        l.arena,
        @sizeof(Token) as usize
    ) as ref Token
    t.kind = kind
    t.text = str.view(none, 0)
    t.line = line
    t.col = col
    t.suppress = l.pending_suppress
    l.pending_suppress = 0
    if l.owns_arena {
        t.arena = l.arena
    } else {
        t.arena = none
    }
    return t
}


type Lexer = {
    src: mut str.StringView
    pos: mut i64
    line: mut i64
    col: mut i64
    arena: mut allocators.ScopedArenaAllocator
    owns_arena: mut bool
    pending_suppress: mut i64
}

fn lexer_new(
    arena: allocators.ScopedArenaAllocator,
    owns_arena: bool,
    src: str.StringView
) ref Lexer = trust {
    val l: mut ref Lexer = @alloc(@sizeof(Lexer)) as ref Lexer
    l.src = src
    l.pos = 0
    l.line = 1
    l.col = 1
    l.arena = arena
    l.owns_arena = owns_arena
    l.pending_suppress = 0
    return l
}

fn lx_peek(l: ref Lexer) i64 = {
    guard (l.pos < l.src.len) else {
        return -1
    }
    return trust @load8(@ptradd(l.src.ptr, l.pos)) as i64
}

fn lx_peek2(l: ref Lexer) i64 = {
    val p: i64 = l.pos + 1
    guard (p < l.src.len) else {
        return -1
    }
    return trust @load8(@ptradd(l.src.ptr, p)) as i64
}

fn lx_advance(l: mut ref Lexer) i64 = trust {
    if l.pos >= l.src.len {
        return -1
    }
    val c: i64 = @load8(@ptradd(l.src.ptr, l.pos)) as i64
    l.pos++
    if c == 10 {
        l.line++
        l.col = 1
    } else {
        l.col++
    }
    return c
}

fn is_alpha(c: i64) bool = trust {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_digit(c: i64) bool = trust {
    return c >= 48 && c <= 57
}

fn is_alnum(c: i64) bool = trust {
    return is_alpha(c) || is_digit(c)
}

fn is_hex(c: i64) bool = trust {
    return is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn is_space(c: i64) bool = trust {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn substr_view(
    arena: allocators.ScopedArenaAllocator,
    src: str.StringView,
    start: i64,
    end: i64
) str.StringView = trust {
    val n: i64 = end - start
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(arena, (n + 1) as usize) as ref u8
    if n > 0 {
        @memcpy(buf, @ptradd(src.ptr, start), n)
    }
    @store8(@ptradd(buf, n), 0)
    return str.view(buf, n)
}

fn keyword_kind(s: str.StringView) TokenKind = trust {
    if str.eql_cstr(s, c"fn") {
        return Fn()
    }
    if str.eql_cstr(s, c"spec") {
        return Spec()
    }
    if str.eql_cstr(s, c"val") {
        return Val()
    }
    if str.eql_cstr(s, c"mut") {
        return Mut()
    }
    if str.eql_cstr(s, c"pub") {
        return Pub()
    }
    if str.eql_cstr(s, c"type") {
        return Type()
    }
    if str.eql_cstr(s, c"pre") {
        return Pre()
    }
    if str.eql_cstr(s, c"post") {
        return Post()
    }
    if str.eql_cstr(s, c"return") {
        return Return()
    }
    if str.eql_cstr(s, c"if") {
        return If()
    }
    if str.eql_cstr(s, c"else") {
        return Else()
    }
    if str.eql_cstr(s, c"elif") {
        return Elif()
    }
    if str.eql_cstr(s, c"trust") {
        return Trust()
    }
    if str.eql_cstr(s, c"inline") {
        return Inline()
    }
    if str.eql_cstr(s, c"use") {
        return Use()
    }
    if str.eql_cstr(s, c"ref") {
        return Ref()
    }
    if str.eql_cstr(s, c"for") {
        return For()
    }
    if str.eql_cstr(s, c"in") {
        return In()
    }
    if str.eql_cstr(s, c"some") {
        return Some()
    }
    if str.eql_cstr(s, c"none") {
        return None()
    }
    if str.eql_cstr(s, c"ok") {
        return Ok()
    }
    if str.eql_cstr(s, c"err") {
        return Err()
    }
    if str.eql_cstr(s, c"match") {
        return Match()
    }
    if str.eql_cstr(s, c"true") {
        return True()
    }
    if str.eql_cstr(s, c"false") {
        return False()
    }
    if str.eql_cstr(s, c"defer") {
        return Defer()
    }
    if str.eql_cstr(s, c"break") {
        return Break()
    }
    if str.eql_cstr(s, c"continue") {
        return Continue()
    }
    if str.eql_cstr(s, c"as") {
        return As()
    }
    if str.eql_cstr(s, c"assert") {
        return Assert()
    }
    if str.eql_cstr(s, c"when") {
        return When()
    }
    if str.eql_cstr(s, c"union") {
        return Union()
    }
    if str.eql_cstr(s, c"enum") {
        return Enum()
    }
    if str.eql_cstr(s, c"extern") {
        return Extern()
    }
    if str.eql_cstr(s, c"link") {
        return Link()
    }
    if str.eql_cstr(s, c"lib") {
        return Lib()
    }
    if str.eql_cstr(s, c"guarded") {
        return Guarded()
    }
    if str.eql_cstr(s, c"not") {
        return Not()
    }
    if str.eql_cstr(s, c"test") {
        return Test()
    }
    if str.eql_cstr(s, c"guard") {
        return Guard()
    }
    if str.eql_cstr(s, c"invariant") {
        return Invariant()
    }
    return Ident(s.ptr)
}

fn lex_string(l: mut ref Lexer) str.StringView = trust {
    val buf_cap: mut i64 = 4096
    val buf: mut ref u8 = @alloc(buf_cap) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = lx_advance(l)
        if c == -1 || c == 34 {
            break
        }
        if i >= buf_cap - 2 {
            buf_cap = buf_cap * 2
            buf = @realloc(buf, buf_cap) as ref u8
        }
        if c == 92 {
            val esc: i64 = lx_advance(l)
            if esc == 110 {
                @store8(@ptradd(buf, i), 10)
            } elif esc == 116 {
                @store8(@ptradd(buf, i), 9)
            } elif esc == 114 {
                @store8(@ptradd(buf, i), 13)
            } elif esc == 34 {
                @store8(@ptradd(buf, i), 34)
            } elif esc == 92 {
                @store8(@ptradd(buf, i), 92)
            } elif esc == 120 {  // '\x' hex escape: read exactly 2 hex digits
                val h1: i64 = lx_advance(l)
                val h2: i64 = lx_advance(l)
                val d1: mut i64 = 0
                if h1 >= 97 {
                    d1 = h1 - 87
                } elif h1 >= 65 {
                    d1 = h1 - 55
                } else {
                    d1 = h1 - 48
                }
                val d2: mut i64 = 0
                if h2 >= 97 {
                    d2 = h2 - 87
                } elif h2 >= 65 {
                    d2 = h2 - 55
                } else {
                    d2 = h2 - 48
                }
                @store8(@ptradd(buf, i), (d1 * 16 + d2) as u8)
            } else {
                @store8(@ptradd(buf, i), 92 as u8)
                i++
                @store8(@ptradd(buf, i), esc as u8)
            }
        } else {
            @store8(@ptradd(buf, i), c as u8)
        }
        i++
    }
    @store8(@ptradd(buf, i), 0)
    val result: ref u8 = allocators.ScopedArena.alloc_or_none(l.arena, (i + 1) as usize) as ref u8
    @memcpy(result, buf, i + 1)
    @free(buf)
    return str.view(result, i)
}

fn lex_number(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    val start: i64 = l.pos - 1
    val is_float: mut bool = false
    val first: i64 = @load8(@ptradd(l.src.ptr, start)) as i64

    if first == 48 && lx_peek(l) == 120 {
        lx_advance(l)
        for {
            if !is_hex(lx_peek(l)) {
                break
            }
            lx_advance(l)
        }
        val hex_text: str.StringView = substr_view(l.arena, l.src, start, l.pos)
        val hex_tok: mut ref Token = make_tok(l, Int(hex_text.ptr), line, col)
        hex_tok.text = hex_text
        return hex_tok
    }
    for {
        if !is_digit(lx_peek(l)) {
            break
        }
        lx_advance(l)
    }
    if lx_peek(l) == 46 || lx_peek(l) == 101 || lx_peek(l) == 69 {
        is_float = true
        if lx_peek(l) == 46 {
            lx_advance(l)
            for {
                if !is_digit(lx_peek(l)) {
                    break
                }
                lx_advance(l)
            }
        }
        if lx_peek(l) == 101 || lx_peek(l) == 69 {
            lx_advance(l)
            if lx_peek(l) == 43 || lx_peek(l) == 45 {
                lx_advance(l)
            }
            for {
                if !is_digit(lx_peek(l)) {
                    break
                }
                lx_advance(l)
            }
        }
    }
    val text: str.StringView = substr_view(l.arena, l.src, start, l.pos)
    if is_float {
        val ftok: mut ref Token = make_tok(l, Float(text.ptr), line, col)
        ftok.text = text
        return ftok
    }
    val itok: mut ref Token = make_tok(l, Int(text.ptr), line, col)
    itok.text = text
    return itok
}

fn skip_whitespace(l: mut ref Lexer) void = trust {
    for {
        if !is_space(lx_peek(l)) {
            break
        }
        lx_advance(l)
    }
}

fn lx_match_text(l: ref Lexer, start: i64, end: i64, text: ref u8) bool = trust {
    val n: i64 = cstr.len(text)
    if start < 0 || start + n > end {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val actual: i64 = @load8(@ptradd(l.src.ptr, start + i)) as i64
        val expected: i64 = @load8(@ptradd(text, i)) as i64
        if actual != expected {
            return false
        }
        i++
    }
    return true
}

/// Recognize `//!suppress "unused-function"` in the comment spanning
/// `start` (inclusive) to `end` (exclusive).
fn comment_suppresses_unused(l: ref Lexer, start: i64, end: i64) bool = trust {
    val prefix: ref u8 = c"//!suppress"
    if !lx_match_text(l, start, end, prefix) {
        return false
    }
    val p: mut i64 = start + cstr.len(prefix)
    if p >= end {
        return false
    }
    val first: i64 = @load8(@ptradd(l.src.ptr, p)) as i64
    if !is_space(first) {
        return false
    }
    for {
        if p >= end {
            break
        }
        val c: i64 = @load8(@ptradd(l.src.ptr, p)) as i64
        if !is_space(c) {
            break
        }
        p++
    }
    if p >= end {
        return false
    }
    val open_quote: i64 = @load8(@ptradd(l.src.ptr, p)) as i64
    if open_quote != 34 {
        return false
    }
    p++
    val feature: ref u8 = c"unused-function"
    if !lx_match_text(l, p, end, feature) {
        return false
    }
    p = p + cstr.len(feature)
    if p >= end {
        return false
    }
    val close_quote: i64 = @load8(@ptradd(l.src.ptr, p)) as i64
    if close_quote != 34 {
        return false
    }
    p++
    for {
        if p >= end {
            break
        }
        val c: i64 = @load8(@ptradd(l.src.ptr, p)) as i64
        if !is_space(c) {
            return false
        }
        p++
    }
    return true
}

fn skip_comment(l: mut ref Lexer) bool = trust {
    if lx_peek(l) == 47 && lx_peek2(l) == 47 {
        val start: i64 = l.pos
        for {
            val c: i64 = lx_peek(l)
            if c == -1 || c == 10 {
                break
            }
            lx_advance(l)
        }
        if comment_suppresses_unused(l, start, l.pos) {
            l.pending_suppress = l.pending_suppress | SUPPRESS_UNUSED
        }
        return true
    }
    return false
}

fn lex_raw_string(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    lx_advance(l)
    val buf_cap: mut i64 = 4096
    val buf: mut ref u8 = @alloc(buf_cap) as ref u8
    val i: mut i64 = 0
    for {
        for {
            val ch: i64 = lx_peek(l)
            if ch == -1 || ch == 10 {
                break
            }
            lx_advance(l)
            if i >= buf_cap - 2 {
                buf_cap = buf_cap * 2
                buf = @realloc(buf, buf_cap) as ref u8
            }
            @store8(@ptradd(buf, i), ch as u8)
            i++
        }
        if lx_peek(l) == 10 {
            lx_advance(l)
        }
        for {
            if !is_space(lx_peek(l)) || lx_peek(l) == 10 {
                break
            }
            lx_advance(l)
        }
        if lx_peek(l) == 92 && lx_peek2(l) == 92 {
            @store8(@ptradd(buf, i), 10)
            i++
            lx_advance(l)
            lx_advance(l)
        } else {
            break
        }
    }
    @store8(@ptradd(buf, i), 0)
    val result: ref u8 = allocators.ScopedArena.alloc_or_none(l.arena, (i + 1) as usize) as ref u8
    @memcpy(result, buf, i + 1)
    @free(buf)
    val sv: str.StringView = str.view(result, i)
    val stok: mut ref Token = make_tok(l, Str(sv.ptr), line, col)
    stok.text = sv
    return stok
}

fn lex_char_literal(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    val ch: i64 = lx_advance(l)
    val char_val: mut i64 = ch
    if ch == 92 {
        val esc: i64 = lx_advance(l)
        if esc == 110 {
            char_val = 10
        } elif esc == 116 {
            char_val = 9
        } elif esc == 114 {
            char_val = 13
        } elif esc == 48 {
            char_val = 0
        } elif esc == 39 {
            char_val = 39
        } elif esc == 92 {
            char_val = 92
        } else {
            char_val = esc
        }
    }
    lx_advance(l)
    return make_tok(l, CharLit(char_val), line, col)
}

fn lex_identifier(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    val start: i64 = l.pos - 1
    for {
        if !is_alnum(lx_peek(l)) {
            break
        }
        lx_advance(l)
    }
    val text: str.StringView = substr_view(l.arena, l.src, start, l.pos)
    val kind: TokenKind = keyword_kind(text)
    val tok: mut ref Token = make_tok(l, kind, line, col)
    tok.text = text
    return tok
}

fn lex_single_char(l: mut ref Lexer, c: i64, line: i64, col: i64) result[ref Token, bool] = trust {
    if c == 40 {
        return ok make_tok(l, LParen(), line, col)
    }
    if c == 41 {
        return ok make_tok(l, RParen(), line, col)
    }
    if c == 123 {
        return ok make_tok(l, LBrace(), line, col)
    }
    if c == 125 {
        return ok make_tok(l, RBrace(), line, col)
    }
    if c == 91 {
        return ok make_tok(l, LBracket(), line, col)
    }
    if c == 93 {
        return ok make_tok(l, RBracket(), line, col)
    }
    if c == 58 {
        return ok make_tok(l, Colon(), line, col)
    }
    if c == 59 {
        return ok make_tok(l, Semicolon(), line, col)
    }
    if c == 44 {
        return ok make_tok(l, Comma(), line, col)
    }
    if c == 64 {
        return ok make_tok(l, At(), line, col)
    }
    if c == 126 {
        return ok make_tok(l, Tilde(), line, col)
    }
    if c == 63 {
        return ok make_tok(l, Question(), line, col)
    }
    if c == 37 {
        return ok make_tok(l, Percent(), line, col)
    }
    if c == 94 {
        return ok make_tok(l, BitXor(), line, col)
    }
    if c == 42 {
        return ok make_tok(l, Star(), line, col)
    }
    return err false
}

fn lex_dot(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 46 && lx_peek2(l) == 46 {
        lx_advance(l)
        lx_advance(l)
        return make_tok(l, DotDotDot(), line, col)
    }
    return make_tok(l, Dot(), line, col)
}

fn lex_plus(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 43 {
        lx_advance(l)
        return make_tok(l, PlusPlus(), line, col)
    }
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, PlusEq(), line, col)
    }
    return make_tok(l, Plus(), line, col)
}

fn lex_minus(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 62 {
        lx_advance(l)
        return make_tok(l, Arrow(), line, col)
    }
    if lx_peek(l) == 45 {
        lx_advance(l)
        return make_tok(l, MinusMinus(), line, col)
    }
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, MinusEq(), line, col)
    }
    return make_tok(l, Minus(), line, col)
}

fn lex_eq(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, EqEq(), line, col)
    }
    if lx_peek(l) == 62 {
        lx_advance(l)
        return make_tok(l, FatArrow(), line, col)
    }
    return make_tok(l, Eq(), line, col)
}

fn lex_bang(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, BangEq(), line, col)
    }
    return make_tok(l, Bang(), line, col)
}

fn lex_lt(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, LtEq(), line, col)
    }
    if lx_peek(l) == 60 {
        lx_advance(l)
        return make_tok(l, Shl(), line, col)
    }
    return make_tok(l, Lt(), line, col)
}

fn lex_gt(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 61 {
        lx_advance(l)
        return make_tok(l, GtEq(), line, col)
    }
    if lx_peek(l) == 62 {
        lx_advance(l)
        return make_tok(l, Shr(), line, col)
    }
    return make_tok(l, Gt(), line, col)
}

fn lex_amp(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 38 {
        lx_advance(l)
        return make_tok(l, And(), line, col)
    }
    return make_tok(l, BitAnd(), line, col)
}

fn lex_pipe(l: mut ref Lexer, line: i64, col: i64) ref Token = trust {
    if lx_peek(l) == 124 {
        lx_advance(l)
        return make_tok(l, Or(), line, col)
    }
    return make_tok(l, BitOr(), line, col)
}

fn lex_operator(l: mut ref Lexer, c: i64, line: i64, col: i64) result[ref Token, bool] = trust {
    if c == 46 {
        return ok lex_dot(l, line, col)
    }
    if c == 43 {
        return ok lex_plus(l, line, col)
    }
    if c == 45 {
        return ok lex_minus(l, line, col)
    }
    if c == 47 {
        return ok make_tok(l, Slash(), line, col)
    }
    if c == 61 {
        return ok lex_eq(l, line, col)
    }
    if c == 33 {
        return ok lex_bang(l, line, col)
    }
    if c == 60 {
        return ok lex_lt(l, line, col)
    }
    if c == 62 {
        return ok lex_gt(l, line, col)
    }
    if c == 38 {
        return ok lex_amp(l, line, col)
    }
    if c == 124 {
        return ok lex_pipe(l, line, col)
    }
    return err false
}

/// Release a token list produced by `tokenize`, including its backing arena
/// when the list owns it (the `tokenize` convenience form does).
pub fn free_tokens(tokens: list[ref Token]) void = trust {
    val n: i64 = @len(tokens) as i64
    if n > 0 {
        val first_opt = @get(tokens, 0 as usize)
        if first_opt is some first_raw {
            val first: ref Token = first_raw as ref Token
            if first.arena != none {
                allocators.ScopedArena.free(first.arena)
            }
        }
    }
    @listfree(tokens)
}

fn tokenize_in(
    arena: allocators.ScopedArenaAllocator,
    owns_arena: bool,
    src: str.StringView
) result[list[ref Token], ref u8] = trust {
    val l: mut ref Lexer = lexer_new(arena, owns_arena, src)
    val tokens: mut list[ref Token] = mem.new[ref Token]()
    for {
        skip_whitespace(l)
        if skip_comment(l) {
            continue
        }

        val line: i64 = l.line
        val col: i64 = l.col
        val c: i64 = lx_peek(l)

        if c == -1 {
            @append(tokens, make_tok(l, Eof(), line, col))
            break
        }

        lx_advance(l)

        if c == 92 && lx_peek(l) == 92 {
            @append(tokens, lex_raw_string(l, line, col))
            continue
        }
        if c == 99 && lx_peek(l) == 34 {
            lx_advance(l)
            val cstr_view: str.StringView = lex_string(l)
            val cstr_tok: mut ref Token = make_tok(l, CStr(cstr_view.ptr), line, col)
            cstr_tok.text = cstr_view
            @append(tokens, cstr_tok)
            continue
        }
        if c == 34 {
            val str_view: str.StringView = lex_string(l)
            val str_tok: mut ref Token = make_tok(l, Str(str_view.ptr), line, col)
            str_tok.text = str_view
            @append(tokens, str_tok)
            continue
        }
        if c == 39 {
            @append(tokens, lex_char_literal(l, line, col))
            continue
        }
        if is_digit(c) {
            @append(tokens, lex_number(l, line, col))
            continue
        }
        if is_alpha(c) {
            @append(tokens, lex_identifier(l, line, col))
            continue
        }
        match lex_single_char(l, c, line, col) {
            ok t => {
                @append(tokens, t)
                continue
            }
            err _ => {}
        }
        match lex_operator(l, c, line, col) {
            ok t => {
                @append(tokens, t)
                continue
            }
            err _ => {}
        }
        val errbuf: ref u8 = @alloc(64) as ref u8
        @snprintf(errbuf, 64, "unexpected character at {lld}:{lld}", {line, col})
        @free(l)
        free_tokens(tokens)
        return err errbuf
    }

    @free(l)
    return ok tokens
}

/// Convenience form that owns a private arena for the returned token list.
pub fn tokenize_view(src: str.StringView) result[list[ref Token], ref u8] = trust {
    val arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(1048576 as usize)?
    val res = tokenize_in(arena, true, src)
    match res {
        ok toks => {
            return ok toks
        }
        err e => {
            allocators.ScopedArena.free(arena)
            return err e
        }
    }
}

/// Convenience form that owns a private arena for the returned token list.
pub fn tokenize(src: ref u8) result[list[ref Token], ref u8] = trust {
    return tokenize_view(str.from_cstr(src))
}

/// Tokenize using a caller-owned arena. The arena must outlive the tokens.
pub fn tokenize_with_view(
    arena: allocators.ScopedArenaAllocator,
    src: str.StringView
) result[list[ref Token], ref u8] = trust {
    return tokenize_in(arena, false, src)
}

/// Tokenize using a caller-owned arena. The arena must outlive the tokens.
pub fn tokenize_with(
    arena: allocators.ScopedArenaAllocator,
    src: ref u8
) result[list[ref Token], ref u8] = trust {
    return tokenize_with_view(arena, str.from_cstr(src))
}

pub fn tok_kind(tokens: list[ref Token], i: i64) TokenKind = {
    val opt = @get(tokens, i as usize)
    if opt is some t {
        return (t as ref Token).kind
    } else {
        return Eof()
    }
}

// Extract text payload from Ident/Str/Int/Float variants, empty otherwise.
pub fn tok_text(tokens: list[ref Token], i: i64) str.StringView = {
    val opt = @get(tokens, i as usize)
    if opt is some t {
        val tok: ref Token = t as ref Token
        return tok.text
    } else {
        return str.view(none, 0)
    }
}

/// Compatibility helper for code that still requires a null-terminated pointer.
pub fn tok_text_raw(tokens: list[ref Token], i: i64) ref u8 = {
    val v: str.StringView = tok_text(tokens, i)
    return v.ptr
}

pub fn tok_suppress_unused(tokens: list[ref Token], i: i64) bool = {
    val opt = @get(tokens, i as usize)
    if opt is some t {
        return ((t as ref Token).suppress & SUPPRESS_UNUSED) != 0
    }
    return false
}

pub fn kind_is_fn(k: TokenKind) bool = {
    match k {
        Fn() => {
            return true
        } else => {
            return false
        }
    }
}

