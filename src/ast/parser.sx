fn make_int_lit(
    arena: allocators.ScopedArenaAllocator,
    text: ref u8,
    line: i64
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_INT_LIT, line)
    node_store_string_slot(@addr(n.d0), text)
    return ok n
}

pub fn int_lit_text(n: ref Node) str.StringView = {
    return node_str(n.d0)
}

pub fn int_lit_text_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d0)
}

fn make_float_lit(
    arena: allocators.ScopedArenaAllocator,
    text: ref u8,
    line: i64
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_FLOAT_LIT, line)
    node_store_string_slot(@addr(n.d0), text)
    return ok n
}

pub fn float_lit_text(n: ref Node) str.StringView = {
    return node_str(n.d0)
}

pub fn float_lit_text_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d0)
}

fn make_str_lit(
    arena: allocators.ScopedArenaAllocator,
    text: ref u8,
    line: i64
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_STR_LIT, line)
    node_store_string_slot(@addr(n.d0), text)
    return ok n
}

/// Construct a `c"..."` literal. It shares `NK_STR_LIT` with ordinary string
/// literals and marks the node through `d1`.
fn make_cstr_lit(
    arena: allocators.ScopedArenaAllocator,
    text: ref u8,
    line: i64
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_STR_LIT, line)
    node_store_string_slot(@addr(n.d0), text)
    n.d1 = 1
    return ok n
}

pub fn str_lit_is_cstr(n: ref Node) bool = {
    if n == none || n.kind != NK_STR_LIT {
        return false
    }
    return n.d1 != 0
}

pub fn str_lit_text(n: ref Node) str.StringView = {
    return node_str(n.d0)
}

pub fn str_lit_text_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d0)
}

/// For a named struct literal `Name{...}`, return `Name`; otherwise `none`.
pub fn struct_lit_type_name(n: ref Node) str.StringView = {
    return node_str(n.d2)
}

pub fn struct_lit_type_name_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d2)
}

/// Optional name attached to a `test "name" { ... }` block.
pub fn test_name(n: ref Node) str.StringView = {
    return node_str(n.d1)
}

pub fn test_name_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d1)
}

pub fn val_bulk_items(n: ref Node) list[ref Node] = {
    return n.d0 as list[ref Node]
}

type Parser = {
    tokens: mut list[ref lexer.Token]
    pos: mut i64
    filename: mut ref u8
    arena: mut allocators.ScopedArenaAllocator
}

pub fn parser_new(
    arena: allocators.ScopedArenaAllocator,
    tokens: list[ref lexer.Token],
    filename: ref u8
) ref Parser = trust {
    val p: mut ref Parser = allocators.ScopedArena.alloc_or_none(
        arena,
        @sizeof(Parser) as usize
    ) as ref Parser
    p.tokens = tokens
    p.pos = 0
    p.filename = filename
    p.arena = arena
    set_node_string_arena(arena)
    return p
}

fn p_peek_kind(p: ref Parser) lexer.TokenKind = trust {
    return lexer.tok_kind(p.tokens, p.pos)
}

fn p_peek2_kind(p: ref Parser) lexer.TokenKind = trust {
    return lexer.tok_kind(p.tokens, p.pos + 1)
}

fn p_peek3_kind(p: ref Parser) lexer.TokenKind = trust {
    return lexer.tok_kind(p.tokens, p.pos + 2)
}

fn p_peek_line(p: ref Parser) i64 = trust {
    val opt = @get(p.tokens, p.pos as usize)
    if opt is some t {
        return (t as ref lexer.Token).line
    } else {
        return 0
    }
}

fn p_suppress_unused(p: ref Parser) bool = trust {
    return lexer.tok_suppress_unused(p.tokens, p.pos)
}

fn p_advance(p: mut ref Parser) lexer.TokenKind = trust {
    val k: lexer.TokenKind = p_peek_kind(p)
    if p.pos + 1 < @len(p.tokens) as i64 {
        p.pos++
    }
    return k
}

fn p_advance_text(p: mut ref Parser) ref u8 = trust {
    val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
    if p.pos + 1 < @len(p.tokens) as i64 {
        p.pos++
    }
    return txt
}

fn p_line(p: ref Parser) i64 = trust {
    return p_peek_line(p)
}

fn p_error(p: ref Parser, msg: ref u8) ref u8 = trust {
    val line: i64 = p_peek_line(p)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(p.arena, 512 as usize) as ref u8
    @snprintf(buf, 512, "{s}:{lld}: {s}", {p.filename, line, msg})
    return buf
}

fn p_eat_fn(p: mut ref Parser, is_kind: fn(lexer.TokenKind) bool) bool = trust {
    if is_kind(p_peek_kind(p)) {
        p_advance(p)
        return true
    }
    return false
}

fn p_expect_kind(
    p: mut ref Parser,
    is_kind: fn(lexer.TokenKind) bool,
    name: ref u8
) result[ref u8, ref u8] = trust {
    if is_kind(p_peek_kind(p)) {
        val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
        p_advance(p)
        return ok txt
    }
    val msg: ref u8 = allocators.ScopedArena.alloc_or_none(p.arena, 128 as usize) as ref u8
    @snprintf(msg, 128, "expected {s}", {name})
    return err p_error(p, msg)
}

fn p_expect_ident(p: mut ref Parser) result[ref u8, ref u8] = trust {
    match p_peek_kind(p) {
        Ident _ => {
            val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            p_advance(p)
            return ok txt
        }
        else => {
            return err p_error(p, c"expected identifier")
        }
    }
}

fn p_expect_string(p: mut ref Parser) result[ref u8, ref u8] = trust {
    match p_peek_kind(p) {
        Str _ => {
            val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            p_advance(p)
            return ok txt
        }
        else => {
            return err p_error(p, c"expected string literal")
        }
    }
}

fn p_expect_lbrace(p: mut ref Parser) result[ref u8, ref u8] = trust {
    return p_expect_kind(p, lexer.kind_is_lbrace, c"'{'" )
}

fn p_expect_rbrace(p: mut ref Parser) result[ref u8, ref u8] = trust {
    return p_expect_kind(p, lexer.kind_is_rbrace, c"'}'" )
