type NodeSlotBox = {
    value: i64
}

pub type Node = {
    kind: mut i64
    line: mut i64
    d0: mut i64
    d1: mut i64
    d2: mut i64
    d3: mut i64
    d4: mut i64
    d5: mut i64
    d6: mut i64
}

pub fn make_node(
    arena: allocators.ScopedArenaAllocator,
    kind: i64,
    line: i64
) ref Node = trust {
    val n: mut ref Node = allocators.ScopedArena.alloc_or_none(
        arena,
        @sizeof(Node) as usize
    ) as ref Node
    n.kind = kind
    n.line = line
    n.d0 = 0
    n.d1 = 0
    n.d2 = 0
    n.d3 = 0
    n.d4 = 0
    n.d5 = 0
    n.d6 = 0
    return n
}

/// Arena used for StringView payloads stored in AST nodes.
val node_string_arena: mut allocators.ScopedArenaAllocator = none

pub fn set_node_string_arena(arena: allocators.ScopedArenaAllocator) void = trust {
    node_string_arena = arena
}

pub fn node_store_string_slot(slot: ref i64, text: ref u8) void = trust {
    if node_string_arena == none {
        return
    }
    val v: str.StringView = str.from_cstr(text)
    val sv: mut ref str.StringView = allocators.ScopedArena.alloc_or_none(
        node_string_arena,
        @sizeof(str.StringView) as usize
    ) as ref str.StringView
    if sv == none {
        return
    }
    sv.ptr = v.ptr
    sv.len = v.len
    @store(slot, sv)
}

pub fn node_store_slot[T](slot: ref i64, value: T) void = trust {
    @store(slot, value)
}

/// Read a string slot. The slot stores an arena-owned StringView pointer.
pub fn node_str(d: i64) str.StringView = {
    if d == 0 {
        return str.view(none, 0)
    }
    val box: NodeSlotBox = {value: d}
    val sv: ref str.StringView = box.value as ref str.StringView
    return str.view(sv.ptr, sv.len)
}

/// Raw-pointer compatibility view for callers that still need `ref u8`.
pub fn node_str_raw(d: i64) ref u8 = {
    val v: str.StringView = node_str(d)
    return v.ptr
}

pub fn ptr_to_i64[T](p: T) i64 = trust {
    val i: mut i64 = 0
    @store(@addr(i) as ref void, p)
    return i
}

pub fn ptr_to_usize[T](p: T) usize = trust {
    val u: mut usize = 0
    @store(@addr(u) as ref void, p)
    return u
}

fn make_binop(
    arena: allocators.ScopedArenaAllocator,
    op: i64,
    line: i64,
    left: ref Node,
    right: ref Node
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_BINOP, line)
    n.d0 = op
    node_store_slot[ref Node](@addr(n.d1), left)
    node_store_slot[ref Node](@addr(n.d2), right)
    return ok n
}

pub fn binop_op(n: ref Node) i64 = {
    return n.d0
}

pub fn binop_left(n: ref Node) ref Node = {
    return n.d1 as ref Node
}

pub fn binop_right(n: ref Node) ref Node = {
    return n.d2 as ref Node
}

pub fn generic_fn_type_params(n: ref Node) list[ref Node] = {
    return n.d6 as list[ref Node]
}

pub fn tparam_name(tp: ref Node) str.StringView = {
    return node_str(tp.d0)
}

pub fn tparam_name_raw(tp: ref Node) ref u8 = {
    return node_str_raw(tp.d0)
}

pub fn tparam_constraint(tp: ref Node) ref Node = {
    return tp.d1 as ref Node
}

pub fn generic_fn_is_unsafe(n: ref Node) bool = {
    return (n.d0 & 2) != 0
}

pub fn generic_when_conditions(n: ref Node) list[ref Node] = {
    return n.d0 as list[ref Node]
}

pub fn generic_when_body(n: ref Node) ref Node = {
    return n.d1 as ref Node
}

pub fn generic_inst_base(n: ref Node) ref Node = {
    return n.d0 as ref Node
}

pub fn generic_inst_type_args(n: ref Node) list[ref Node] = {
    return n.d1 as list[ref Node]
}

pub fn builtin_name(n: ref Node) str.StringView = {
    return node_str(n.d0)
}

pub fn builtin_name_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d0)
}

pub fn builtin_args(n: ref Node) ref void = {
    return n.d1 as ref void
}

/// Explicit type arguments attached to an intrinsic, e.g. @fmtalloc[A](...).
/// Intrinsic arguments live in d1; embed metadata uses d2/d3, so d4 is used
/// for intrinsic type arguments.
pub fn builtin_type_args(n: ref Node) list[ref Node] = {
    return n.d4 as list[ref Node]
}

pub fn builtin_set_type_args(n: ref Node, targs: list[ref Node]) void = trust {
    node_store_slot[list[ref Node]](@addr(n.d4), targs)
}

pub fn gwhen_cond_tparam(n: ref Node) str.StringView = {
    return node_str(n.d0)
}

pub fn gwhen_cond_tparam_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d0)
}

pub fn gwhen_cond_kind(n: ref Node) i64 = {
    return n.d1
}

pub fn gwhen_cond_types(n: ref Node) list[ref Node] = {
    return n.d2 as list[ref Node]
}

fn make_unop(
    arena: allocators.ScopedArenaAllocator,
    op: i64,
    line: i64,
    inner: ref Node
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_UNOP, line)
    n.d0 = op
    node_store_slot[ref Node](@addr(n.d1), inner)
    return ok n
}

pub fn unop_op(n: ref Node) i64 = {
    return n.d0
}

pub fn unop_inner(n: ref Node) ref Node = {
    return n.d1 as ref Node
}

pub fn fixed_arr_size(n: ref Node) i64 = {
    return n.d0
}

pub fn fixed_arr_inner(n: ref Node) ref Node = {
    return n.d1 as ref Node
}

pub fn fixed_arr_size_name(n: ref Node) str.StringView = {
    return node_str(n.d2)
}

pub fn fixed_arr_size_name_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d2)
}

pub fn fn_is_unsafe(n: ref Node) bool = {
    if n.kind == NK_EXTERN_FN {
        return true
    }
    if n.kind == NK_GENERIC_FN {
        return ((n.d0 >> 1) & 1) != 0
    }
    return (n.d6 & FN_FLAG_UNSAFE) != 0
}

pub fn fn_is_inline(n: ref Node) bool = {
    if n == none || n.kind == NK_EXTERN_FN {
        return false
    }
    if n.kind == NK_GENERIC_FN {
        return ((n.d0 >> 2) & 1) != 0
    }
    return (n.d6 & FN_FLAG_INLINE) != 0
}

pub fn fn_suppresses_unused(n: ref Node) bool = {
    if n == none {
        return false
    }
    if n.kind == NK_GENERIC_FN {
        return (n.d0 & GENERIC_FN_FLAG_SUPPRESS_UNUSED) != 0
    }
    if n.kind == NK_EXTERN_FN {
        return false
    }
    return (n.d6 & FN_FLAG_SUPPRESS_UNUSED) != 0
}

pub fn extern_fn_is_variadic(n: ref Node) bool = {
    return (n.d6 & EXTERN_FLAG_VARIADIC) != 0
}

pub fn extern_fn_uses_header(n: ref Node) bool = {
    return (n.d6 & EXTERN_FLAG_HEADER) != 0
}

fn make_field(
    arena: allocators.ScopedArenaAllocator,
    base: ref Node,
    line: i64,
    name: ref u8
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_FIELD, line)
    node_store_slot[ref Node](@addr(n.d0), base)
    node_store_string_slot(@addr(n.d1), name)
    return ok n
}

pub fn field_base(n: ref Node) ref Node = {
    return n.d0 as ref Node
}

pub fn field_name(n: ref Node) str.StringView = {
    return node_str(n.d1)
}

pub fn field_name_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d1)
}

fn make_call(
    arena: allocators.ScopedArenaAllocator,
    callee: ref Node,
    line: i64,
    args: list[ref Node]
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_CALL, line)
    node_store_slot[ref Node](@addr(n.d0), callee)
    node_store_slot[list[ref Node]](@addr(n.d1), args)
    return ok n
}

pub fn call_callee(n: ref Node) ref Node = trust {
    return n.d0 as ref Node
}

pub fn call_args(n: ref Node) list[ref Node] = trust {
    return n.d1 as list[ref Node]
}

pub fn call_resolved_fn(n: ref Node) ref Node = trust {
    return n.d2 as ref Node
}

pub fn call_set_resolved_fn(n: ref Node, fn_node: ref Node) void = trust {
    node_store_slot[ref Node](@addr(n.d2), fn_node)
}

fn make_struct_field(
    arena: allocators.ScopedArenaAllocator,
    name: ref u8,
    line: i64,
    expr: ref Node
) result[ref Node, ref u8] = trust {
    val n: mut ref Node = make_node(arena, NK_FIELD, line)
    node_store_string_slot(@addr(n.d0), name)
    node_store_slot[ref Node](@addr(n.d1), expr)
    return ok n
}

pub fn match_opt_expr(n: ref Node) ref Node = {
    return n.d0 as ref Node
}

pub fn match_opt_some_bind(n: ref Node) str.StringView = {
    return node_str(n.d1)
}

pub fn match_opt_some_bind_raw(n: ref Node) ref u8 = {
    return node_str_raw(n.d1)
}

pub fn match_opt_some_body(n: ref Node) ref Node = {
    return n.d2 as ref Node
}  // wrapper, .d0 = stmts list

pub fn match_opt_none_body(n: ref Node) ref Node = {
    return n.d3 as ref Node
}  // wrapper, .d0 = stmts list

pub fn match_opt_sugar_kind(n: ref Node) i64 = {
    return n.d6
}

pub fn match_opt_is_sugar(n: ref Node) bool = {
    return match_opt_sugar_kind(n) != 0
}

pub fn wrap_allocator(n: ref Node) ref Node = trust {
    if n == none {
        return none
    }
    val k: i64 = n.kind
    if k == NK_SOME || k == NK_OK_VAL || k == NK_ERR_VAL {
        return n.d1 as ref Node
    }
    return none
}

pub fn match_res_expr(n: ref Node) ref Node = {
    return n.d0 as ref Node
}

pub fn match_res_ok_bind(n: ref Node) str.StringView = {
