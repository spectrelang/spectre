/// Copy a heap string into the parser arena so AST-owned names live exactly
/// as long as the AST. The temporary builder result can then be released.
fn p_arena_str(p: ref Parser, s: ref u8) ref u8 = trust {
    val n: i64 = cstr.len(s)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        p.arena,
        (n + 1) as usize
    ) as ref u8
    @memcpy(out, s, n as usize)
    @store8(@ptradd(out, n), 0)
    return out
}

pub fn parse_type(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)

    if lexer.kind_is_lbracket(p_peek_kind(p)) {
        p_advance(p)
        if lexer.kind_is_rbracket(p_peek_kind(p)) {
            p_advance(p)
            val inner = parse_type(p)?
            val n: mut ref Node = make_node(p.arena, TY_SLICE, line)
            node_store_slot[ref Node](@addr(n.d0), inner)
            return ok n
        }
        val sz: mut i64 = 0
        val sz_name: mut ref u8 = none
        if kind_is_int(p_peek_kind(p)) {
            val sz_text: ref u8 = p_advance_text(p)
            val sz_res = fmt.string_to_i64(sz_text)
            match sz_res {
                ok v => {
                    sz = v
                }
                err _ => {
                    return err p_error(p, c"invalid array size")
                }
            }
        } elif kind_is_ident(p_peek_kind(p)) {
            val sb: ref void = builder.StringBuilder.new()
            builder.StringBuilder.append_cstr(sb, p_advance_text(p))
            for {
                if !lexer.kind_is_dot(p_peek_kind(p)) {
                    break
                }
                p_advance(p)
                val seg = p_expect_ident(p)?
                builder.StringBuilder.append_char(sb, 46 as u8)
                builder.StringBuilder.append_cstr(sb, seg)
            }
            val built: ref void = builder.StringBuilder.build(sb)
            sz_name = p_arena_str(p, ostr.as_cstr(built))
            builder.StringBuilder.free(sb)
            @free(@load(built))
            @free(built)
        } else {
            return err p_error(p, c"expected integer size in fixed array type")
        }
        p_expect_rbracket(p)?
        val inner2 = parse_type(p)?
        val n2: mut ref Node = make_node(p.arena, TY_FIXED_ARR, line)
        n2.d0 = sz
        node_store_slot[ref Node](@addr(n2.d1), inner2)
        node_store_string_slot(@addr(n2.d2), sz_name)
        return ok n2
    }

    if kind_is_ref(p_peek_kind(p)) {
        p_advance(p)
        val inner3 = parse_type(p)?
        val n3: mut ref Node = make_node(p.arena, TY_REF, line)
        node_store_slot[ref Node](@addr(n3.d0), inner3)
        return ok n3
    }

    if kind_is_mut(p_peek_kind(p)) {
        p_advance(p)
        val inner4 = parse_type(p)?
        val n4: mut ref Node = make_node(p.arena, TY_MUT, line)
        node_store_slot[ref Node](@addr(n4.d0), inner4)
        return ok n4
    }

    if kind_is_fn(p_peek_kind(p)) {
        p_advance(p)
        p_expect_lparen(p)?
        val params: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rparen(p_peek_kind(p)) {
                break
            }
            val pt = parse_type(p)?
            @append(params, pt)
            if !p_eat_fn(p, lexer.kind_is_comma) {
                break
            }
        }
        p_expect_rparen(p)?
        val ret = parse_type(p)?
        val nfp: mut ref Node = make_node(p.arena, TY_FNPTR, line)
        val plist: list[ref Node] = params
        node_store_slot[list[ref Node]](@addr(nfp.d0), plist)
        node_store_slot[ref Node](@addr(nfp.d1), ret)
        return ok nfp
    }

    if kind_is_ident(p_peek_kind(p)) {
        val name: ref u8 = p_advance_text(p)
        if cstr.eql(name, c"void") {
            return ok make_node(p.arena, TY_VOID, line)
        }
        if cstr.eql(name, c"argspack") {
            return ok make_node(p.arena, TY_ARGSPACK, line)
        }
        if cstr.eql(name, c"option") {
            p_expect_lbracket(p)?
            val inner5 = parse_type(p)?
            p_expect_rbracket(p)?
            val no: mut ref Node = make_node(p.arena, TY_OPTION, line)
            node_store_slot[ref Node](@addr(no.d0), inner5)
            return ok no
        }
        if cstr.eql(name, c"result") {
            p_expect_lbracket(p)?
            val ok_ty = parse_type(p)?
            p_expect_comma(p)?
            val err_ty = parse_type(p)?
            p_expect_rbracket(p)?
            val nr: mut ref Node = make_node(p.arena, TY_RESULT, line)
            node_store_slot[ref Node](@addr(nr.d0), ok_ty)
            node_store_slot[ref Node](@addr(nr.d1), err_ty)
            return ok nr
        }
        if cstr.eql(name, c"list") {
            p_expect_lbracket(p)?
            val inner6 = parse_type(p)?
            p_expect_rbracket(p)?
            val nl: mut ref Node = make_node(p.arena, TY_LIST, line)
            node_store_slot[ref Node](@addr(nl.d0), inner6)
            return ok nl
        }
        val sb: ref void = builder.StringBuilder.new()
        builder.StringBuilder.append_cstr(sb, name)
        for {
            if !lexer.kind_is_dot(p_peek_kind(p)) {
                break
            }
            p_advance(p)
            val seg = p_expect_ident(p)?
            builder.StringBuilder.append_char(sb, 46 as u8)
            builder.StringBuilder.append_cstr(sb, seg)
        }
        val full_str: ref void = builder.StringBuilder.build(sb)
        val full: ref u8 = p_arena_str(p, ostr.as_cstr(full_str))
        builder.StringBuilder.free(sb)
        @free(@load(full_str))
        @free(full_str)
        val nn: mut ref Node = make_node(p.arena, TY_NAMED, line)
        node_store_string_slot(@addr(nn.d0), full)
        return ok nn
    }

    return err p_error(p, c"expected type")
}

pub fn parse_expr(p: mut ref Parser) result[ref Node, ref u8] = trust {
    return parse_or(p)
}

fn substitute_self_type(ty: ref Node, self_name: ref u8) ref Node = trust {
    if ty == none || self_name == none {
        return ty
    }
    if ty.kind == TY_NAMED {
        if cstr.eql(node_str_raw(ty.d0), c"self") {
            node_store_string_slot(@addr(ty.d0), self_name)
        }
        return ty
    }
    if ty.kind == TY_REF || ty.kind == TY_MUT || ty.kind == TY_OPTION || ty.kind == TY_LIST || ty.kind == TY_SLICE {
        val inner: ref Node = ty.d0 as ref Node
        node_store_slot[ref Node](@addr(ty.d0), substitute_self_type(inner, self_name))
        return ty
    }
    if ty.kind == TY_RESULT {
        val ok_ty: ref Node = ty.d0 as ref Node
        val err_ty: ref Node = ty.d1 as ref Node
        node_store_slot[ref Node](@addr(ty.d0), substitute_self_type(ok_ty, self_name))
        node_store_slot[ref Node](@addr(ty.d1), substitute_self_type(err_ty, self_name))
        return ty
    }
    if ty.kind == TY_FIXED_ARR {
        val inner2: ref Node = ty.d1 as ref Node
        node_store_slot[ref Node](@addr(ty.d1), substitute_self_type(inner2, self_name))
        return ty
    }
    if ty.kind == TY_FNPTR {
        val params: ref void = ty.d0 as ref void
        if params != none {
            for p in params as list[ref Node] {
                substitute_self_type(p as ref Node, self_name)
            }
        }
        val ret_ty: ref Node = ty.d1 as ref Node
        node_store_slot[ref Node](@addr(ty.d1), substitute_self_type(ret_ty, self_name))
        return ty
    }
    return ty
}

fn parse_or(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_and(p)?
    val res: mut ref Node = lhs
    for {
        if !lexer.kind_is_or(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_and(p)?
        res = make_binop(p.arena, OP_OR, line, res, rhs)?
    }
    return ok res
}

fn parse_and(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_cmp(p)?
    val res: mut ref Node = lhs
    for {
        if !lexer.kind_is_and(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_cmp(p)?
        res = make_binop(p.arena, OP_AND, line, res, rhs)?
    }
    return ok res
}

fn parse_cmp(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_bitor(p)?
    val res: mut ref Node = lhs
    for {
        val k: lexer.TokenKind = p_peek_kind(p)
        val op: mut i64 = 0
        if lexer.kind_is_eqeq(k) {
            op = OP_EQ
        } elif lexer.kind_is_bangeq(k) {
            op = OP_NE
        } elif kind_is_lt(k) {
            op = OP_LT
        } elif kind_is_gt(k) {
            op = OP_GT
        } elif lexer.kind_is_lteq(k) {
            op = OP_LE
        } elif lexer.kind_is_gteq(k) {
            op = OP_GE
        }
        if op == 0 {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_bitor(p)?
        res = make_binop(p.arena, op, line, res, rhs)?
    }
    return ok res
}

fn parse_bitor(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_bitxor(p)?
    val res: mut ref Node = lhs
    for {
        if !kind_is_bitor(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_bitxor(p)?
        res = make_binop(p.arena, OP_BOR, line, res, rhs)?
    }
    return ok res
}

fn parse_bitxor(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_bitand(p)?
    val res: mut ref Node = lhs
    for {
        if !kind_is_bitxor(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_bitand(p)?
        res = make_binop(p.arena, OP_BXOR, line, res, rhs)?
    }
    return ok res
}

fn parse_bitand(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_shift(p)?
    val res: mut ref Node = lhs
    for {
        if !kind_is_bitand(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_shift(p)?
        res = make_binop(p.arena, OP_BAND, line, res, rhs)?
    }
    return ok res
}

fn parse_shift(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_add(p)?
    val res: mut ref Node = lhs
    for {
        val k: lexer.TokenKind = p_peek_kind(p)
        val op: mut i64 = 0
        if lexer.kind_is_shl(k) {
            op = OP_SHL
        } elif lexer.kind_is_shr(k) {
            op = OP_SHR
        }
        if op == 0 {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_add(p)?
        res = make_binop(p.arena, op, line, res, rhs)?
    }
    return ok res
}

fn parse_add(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_mul(p)?
    val res: mut ref Node = lhs
    for {
        val k: lexer.TokenKind = p_peek_kind(p)
        val op: mut i64 = 0
        if kind_is_plus(k) {
            op = OP_ADD
        } elif kind_is_minus(k) {
            op = OP_SUB
        }
        if op == 0 {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_mul(p)?
        res = make_binop(p.arena, op, line, res, rhs)?
    }
    return ok res
}

fn parse_mul(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val lhs = parse_unary(p)?
    val res: mut ref Node = lhs
    for {
        val k: lexer.TokenKind = p_peek_kind(p)
        val op: mut i64 = 0
        if kind_is_star(k) {
            op = OP_MUL
        } elif kind_is_slash(k) {
            op = OP_DIV
        } elif kind_is_percent(k) {
            op = OP_REM
        }
        if op == 0 {
            break
        }
        val line: i64 = p_line(p)
        p_advance(p)
        val rhs = parse_unary(p)?
        res = make_binop(p.arena, op, line, res, rhs)?
    }
    return ok res
}

fn parse_wrap_args(
    p: mut ref Parser,
    allow_empty: bool
) result[ref Node, ref u8] = trust {
    val out: mut ref Node = make_node(p.arena, NK_ARGS_PACK, p_line(p))
    out.d0 = 0
    out.d1 = 0
    if lexer.kind_is_lparen(p_peek_kind(p)) {
        p_advance(p)
        if allow_empty && lexer.kind_is_rparen(p_peek_kind(p)) {
            p_advance(p)
            return ok out
        }
        val first = parse_expr(p)?
        if p_eat_fn(p, lexer.kind_is_comma) {
            node_store_slot[ref Node](@addr(out.d1), first)
            if lexer.kind_is_rparen(p_peek_kind(p)) {
                p_advance(p)
                return ok out
            }
            val inner = parse_expr(p)?
            node_store_slot[ref Node](@addr(out.d0), inner)
            p_expect_rparen(p)?
        } else {
            p_expect_rparen(p)?
            node_store_slot[ref Node](@addr(out.d0), first)
        }
        return ok out
    }
    val inner = parse_unary(p)?
    node_store_slot[ref Node](@addr(out.d0), inner)
    return ok out
}

fn parse_unary(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val k: lexer.TokenKind = p_peek_kind(p)
    if kind_is_bang(k) || kind_is_not(k) {
        p_advance(p)
        val inner = parse_unary(p)?
        return make_unop(p.arena, UOP_NOT, line, inner)
    }
    if kind_is_minus(k) {
        p_advance(p)
        val inner2 = parse_unary(p)?
        return make_unop(p.arena, UOP_NEG, line, inner2)
    }
    if kind_is_tilde(k) {
        p_advance(p)
        val inner3 = parse_unary(p)?
        return make_unop(p.arena, UOP_BNOT, line, inner3)
    }
    if kind_is_trust(k) {
        p_advance(p)
        val inner4 = parse_unary(p)?
        val n4: mut ref Node = make_node(p.arena, NK_TRUST, line)
        node_store_slot[ref Node](@addr(n4.d0), inner4)
        return ok n4
    }
    if kind_is_some(k) {
        p_advance(p)
        val args5 = parse_wrap_args(p, false)?
        val n5: mut ref Node = make_node(p.arena, NK_SOME, line)
        node_store_slot[ref Node](@addr(n5.d0), args5.d0 as ref Node)
        node_store_slot[ref Node](@addr(n5.d1), args5.d1 as ref Node)
        return ok n5
    }
    if kind_is_ok(k) {
        p_advance(p)
        val args6 = parse_wrap_args(p, true)?
        val n6: mut ref Node = make_node(p.arena, NK_OK_VAL, line)
        n6.d0 = args6.d0
        node_store_slot[ref Node](@addr(n6.d1), args6.d1 as ref Node)
        return ok n6
    }
    if kind_is_err(k) {
        p_advance(p)
        val args7 = parse_wrap_args(p, false)?
        val n7: mut ref Node = make_node(p.arena, NK_ERR_VAL, line)
        node_store_slot[ref Node](@addr(n7.d0), args7.d0 as ref Node)
        node_store_slot[ref Node](@addr(n7.d1), args7.d1 as ref Node)
        return ok n7
    }
    return parse_postfix(p)
}

fn parse_postfix(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val base = parse_primary(p)?
    val res: mut ref Node = base
    for {
        val k: lexer.TokenKind = p_peek_kind(p)
        val line: i64 = p_line(p)
        if lexer.kind_is_dot(k) {
            p_advance(p)
            val field = p_expect_ident(p)?
            res = make_field(p.arena, res, line, field)?
            continue
        }
        if lexer.kind_is_lparen(k) {
            p_advance(p)
            val args: mut list[ref Node] = mem.new[ref Node]()
            for {
                if lexer.kind_is_rparen(p_peek_kind(p)) {
                    break
                }
                val arg = parse_expr(p)?
                @append(args, arg)
                if !p_eat_fn(p, lexer.kind_is_comma) {
                    break
                }
            }
            p_expect_rparen(p)?
            res = make_call(p.arena, res, line, args)?
            continue
        }
        if lexer.kind_is_lbrace(k) && (res.kind == NK_IDENT || res.kind == NK_FIELD) {
            val after_open: lexer.TokenKind = p_peek2_kind(p)
            val has_fields: bool =
            kind_is_ident(after_open) && lexer.kind_is_colon(p_peek3_kind(p))
            if has_fields {
                val type_name: ref u8 = expr_to_type_name(p, res)
                if type_name != none {
                    res = parse_struct_lit_fields(p, line, type_name)?
                    continue
                }
            }
        }
        if lexer.kind_is_question(k) {
            p_advance(p)
            val n3: mut ref Node = make_node(p.arena, NK_TRY, line)
            node_store_slot[ref Node](@addr(n3.d0), res)
            res = n3
            continue
        }
        if kind_is_as(k) {
            p_advance(p)
            val ty = parse_type(p)?
            val n4: mut ref Node = make_node(p.arena, NK_CAST, line)
            node_store_slot[ref Node](@addr(n4.d0), res)
            node_store_slot[ref Node](@addr(n4.d1), ty)
            res = n4
            continue
        }
        if lexer.kind_is_lbracket(k) {
            p_advance(p)
            val targs: mut list[ref Node] = mem.new[ref Node]()
            for {
                if lexer.kind_is_rbracket(p_peek_kind(p)) {
                    break
                }
                val ta: mut ref Node = none
                if kind_is_ident(p_peek_kind(p)) && cstr.eql(
                    lexer.tok_text_raw(p.tokens, p.pos),
                    c"_"
                ) {
                    p_advance(p)
                    ta = make_node(p.arena, TY_INFER, line)
                } else {
                    ta = parse_type(p)?
                }
                @append(targs, ta)
                if !p_eat_fn(p, lexer.kind_is_comma) {
                    break
                }
            }
            p_expect_rbracket(p)?
            val ng: mut ref Node = make_node(p.arena, NK_GENERIC_INST, line)
            node_store_slot[ref Node](@addr(ng.d0), res)
            val tl: list[ref Node] = targs
            node_store_slot[list[ref Node]](@addr(ng.d1), tl)
            res = ng
            continue
        }
        break
    }
    return ok res
}

fn expr_to_type_name(p: ref Parser, expr: ref Node) ref u8 = trust {
    if expr == none {
        return none
    }
    if expr.kind == NK_IDENT {
        return node_str_raw(expr.d0)
    }
    if expr.kind == NK_FIELD {
        val base: ref Node = field_base(expr)
        val field: ref u8 = field_name_raw(expr)
        val base_name: ref u8 = expr_to_type_name(p, base)
        if base_name == none || field == none {
            return none
        }
        val sb: ref void = builder.StringBuilder.new()
        builder.StringBuilder.append_cstr(sb, base_name)
        builder.StringBuilder.append_char(sb, 46 as u8)
        builder.StringBuilder.append_cstr(sb, field)
        val built: ref void = builder.StringBuilder.build(sb)
        val out: ref u8 = p_arena_str(p, ostr.as_cstr(built))
        builder.StringBuilder.free(sb)
        @free(@load(built))
        @free(built)
        return out
    }
    return none
}

fn parse_struct_lit_fields(
    p: mut ref Parser,
    line: i64,
    type_name: ref u8
) result[ref Node, ref u8] = trust {
    p_expect_lbrace(p)?
    val fields: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        val fname = p_expect_ident(p)?
        p_expect_colon(p)?
        val fval = parse_expr(p)?
        val pair = make_struct_field(p.arena, fname, line, fval)?
        @append(fields, pair)
        p_eat_fn(p, lexer.kind_is_comma)
    }
    p_expect_rbrace(p)?
    val ns: mut ref Node = make_node(p.arena, NK_STRUCT_LIT, line)
    val flist: list[ref Node] = fields
    node_store_slot[list[ref Node]](@addr(ns.d0), flist)
    if type_name != none {
        node_store_string_slot(@addr(ns.d2), type_name)
    }
    return ok ns
}

fn parse_primary(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val k: lexer.TokenKind = p_peek_kind(p)

    if kind_is_int(k) {
        return make_int_lit(p.arena, p_advance_text(p), line)
    }
    if kind_is_float(k) {
        return make_float_lit(p.arena, p_advance_text(p), line)
    }
    if kind_is_str(k) {
        return make_str_lit(p.arena, p_advance_text(p), line)
    }
    if kind_is_cstr(k) {
        return make_cstr_lit(p.arena, p_advance_text(p), line)
    }

    if kind_is_true(k) {
        p_advance(p)
        val n4: mut ref Node = make_node(p.arena, NK_BOOL, line)
        n4.d0 = 1
        return ok n4
    }
    if kind_is_false(k) {
        p_advance(p)
        val n5: mut ref Node = make_node(p.arena, NK_BOOL, line)
        n5.d0 = 0
        return ok n5
    }
    if kind_is_none(k) {
        p_advance(p)
        return ok make_node(p.arena, NK_NONE, line)
    }
    if kind_is_char(k) {
        val char_val: i64 = kind_char_val(k)
        p_advance(p)
        val nc: mut ref Node = make_node(p.arena, NK_CHAR_LIT, line)
        nc.d0 = char_val
        return ok nc
    }

    if lexer.kind_is_lparen(k) {
        p_advance(p)
        val inner = parse_expr(p)?
        p_expect_rparen(p)?
        return ok inner
    }

    if lexer.kind_is_lbrace(k) {
        if kind_is_ident(p_peek2_kind(p)) && lexer.kind_is_colon(p_peek3_kind(p)) {
            return parse_struct_lit_fields(p, line, none)
        }
        p_advance(p)
        val elems: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            val e = parse_expr(p)?
            @append(elems, e)
            if !p_eat_fn(p, lexer.kind_is_comma) {
                break
            }
        }
        p_expect_rbrace(p)?
        val na: mut ref Node = make_node(p.arena, NK_ARGS_PACK, line)
        val elist: list[ref Node] = elems
        node_store_slot[list[ref Node]](@addr(na.d0), elist)
        return ok na
    }

    if lexer.kind_is_lbracket(k) {
        p_advance(p)
        val elems2: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rbracket(p_peek_kind(p)) {
                break
            }
            val e2 = parse_expr(p)?
            @append(elems2, e2)
            if !p_eat_fn(p, lexer.kind_is_comma) {
                break
            }
        }
        p_expect_rbracket(p)?
        val nl: mut ref Node = make_node(p.arena, NK_LIST_LIT, line)
        val elist2: list[ref Node] = elems2
        node_store_slot[list[ref Node]](@addr(nl.d0), elist2)
        return ok nl
    }

    if lexer.kind_is_at(k) {
        p_advance(p)
        val bname = p_expect_ident(p)?
        val btype_args: mut list[ref Node] = mem.new[ref Node]()
        if lexer.kind_is_lbracket(p_peek_kind(p)) {
            p_advance(p)
            for {
                if lexer.kind_is_rbracket(p_peek_kind(p)) {
                    break
                }
                val bta: mut ref Node = none
                if kind_is_ident(p_peek_kind(p)) && cstr.eql(
                    lexer.tok_text_raw(p.tokens, p.pos),
                    c"_"
                ) {
                    p_advance(p)
                    bta = make_node(p.arena, TY_INFER, line)
                } else {
                    bta = parse_type(p)?
                }
                @append(btype_args, bta)
                if !p_eat_fn(p, lexer.kind_is_comma) {
                    break
                }
            }
            p_expect_rbracket(p)?
        }
        if cstr.eql(bname, c"zeroed") {
            if !lexer.kind_is_lparen(p_peek_kind(p)) {
                val nz0: mut ref Node = make_node(p.arena, NK_ZERO_INIT, line)
                node_store_string_slot(@addr(nz0.d0), bname)
                return ok nz0
            }
        }
        p_expect_lparen(p)?
        if cstr.eql(bname, c"zeroed") {
            p_expect_rparen(p)?
            val nz1: mut ref Node = make_node(p.arena, NK_ZERO_INIT, line)
            node_store_string_slot(@addr(nz1.d0), bname)
            return ok nz1
        }
        if cstr.eql(bname, c"addr") {
            val inner2 = parse_expr(p)?
            p_expect_rparen(p)?
            val na2: mut ref Node = make_node(p.arena, NK_ADDR, line)
            node_store_slot[ref Node](@addr(na2.d0), inner2)
            return ok na2
        }
        if cstr.eql(bname, c"deref") {
            val inner3 = parse_expr(p)?
            p_expect_rparen(p)?
            val nd: mut ref Node = make_node(p.arena, NK_DEREF, line)
            node_store_slot[ref Node](@addr(nd.d0), inner3)
            return ok nd
        }
        if cstr.eql(bname, c"sizeof") {
            val ty = parse_type(p)?
            p_expect_rparen(p)?
            val nb: mut ref Node = make_node(p.arena, NK_BUILTIN, line)
            node_store_string_slot(@addr(nb.d0), bname)
            val targs: mut list[ref Node] = mem.new[ref Node]()
            @append(targs, ty)
            node_store_slot[list[ref Node]](@addr(nb.d1), targs)
            node_store_slot[list[ref Node]](@addr(nb.d4), btype_args)
            return ok nb
        }
        if cstr.eql(bname, c"bitcast") {
            val source_expr = parse_expr(p)?
            p_expect_comma(p)?
            val target_ty = parse_type(p)?
            p_expect_rparen(p)?
            val nb: mut ref Node = make_node(p.arena, NK_BUILTIN, line)
            node_store_string_slot(@addr(nb.d0), bname)
            val bargs: mut list[ref Node] = mem.new[ref Node]()
            @append(bargs, target_ty)
            @append(bargs, source_expr)
            node_store_slot[list[ref Node]](@addr(nb.d1), bargs)
            node_store_slot[list[ref Node]](@addr(nb.d4), btype_args)
            return ok nb
        }
        val bargs: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rparen(p_peek_kind(p)) {
                break
            }
            val ba = parse_expr(p)?
            @append(bargs, ba)
            if !p_eat_fn(p, lexer.kind_is_comma) {
                break
            }
        }
        p_expect_rparen(p)?
        val nb: mut ref Node = make_node(p.arena, NK_BUILTIN, line)
        node_store_string_slot(@addr(nb.d0), bname)
        val blist: list[ref Node] = bargs
        node_store_slot[list[ref Node]](@addr(nb.d1), blist)
        node_store_slot[list[ref Node]](@addr(nb.d4), btype_args)
        return ok nb
    }

    if kind_is_ident(k) {
        val name: ref u8 = p_advance_text(p)
        if lexer.kind_is_lbrace(p_peek_kind(p)) && lexer.kind_is_rbrace(p_peek2_kind(p)) {
            p_advance(p)
            p_advance(p)
            val nz: mut ref Node = make_node(p.arena, NK_ZERO_INIT, line)
            node_store_string_slot(@addr(nz.d0), name)
            return ok nz
        }
        val ni: mut ref Node = make_node(p.arena, NK_IDENT, line)
        node_store_string_slot(@addr(ni.d0), name)
        return ok ni
    }

    return err p_error(p, c"expected expression")
}

/// Parse a when-clause selector: either a platform/architecture name or a
/// dotted platform.architecture pair (for example `linux.x86_64`).
fn parse_when_selector(p: mut ref Parser) result[ref u8, ref u8] = trust {
    val first = p_expect_ident(p)?
    if !lexer.kind_is_dot(p_peek_kind(p)) {
        return ok first
    }
    val sb: ref void = builder.StringBuilder.new()
    builder.StringBuilder.append_cstr(sb, first)
    for {
        if !lexer.kind_is_dot(p_peek_kind(p)) {
            break
        }
        p_advance(p)
        val seg = p_expect_ident(p)?
        builder.StringBuilder.append_char(sb, 46 as u8)
        builder.StringBuilder.append_cstr(sb, seg)
    }
    val built: ref void = builder.StringBuilder.build(sb)
    val out: ref u8 = p_arena_str(p, ostr.as_cstr(built))
    builder.StringBuilder.free(sb)
    @free(@load(built))
    @free(built)
    return ok out
}

fn parse_contracts(p: mut ref Parser) result[list[ref Node], ref u8] = trust {
    val contracts: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        val line: i64 = p_line(p)
        val label: mut ref u8 = none
        if kind_is_ident(p_peek_kind(p)) && lexer.kind_is_colon(p_peek2_kind(p)) {
            label = p_advance_text(p)
            p_advance(p)
        }
        val expr = parse_expr(p)?
        val c: mut ref Node = make_node(p.arena, NK_PRE, line)
        node_store_string_slot(@addr(c.d0), label)
        node_store_slot[ref Node](@addr(c.d1), expr)
        @append(contracts, c)
    }
    return ok contracts
}

pub fn parse_stmt(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val k: lexer.TokenKind = p_peek_kind(p)

    if kind_is_val(k) {
        p_advance(p)
        if lexer.kind_is_lparen(p_peek_kind(p)) {
            return err p_error(p, c"bulk val declarations are only allowed at top level")
        }
        val name = p_expect_ident(p)?
        val mutable: mut i64 = 0
        val ty: mut ref Node = none
        if p_eat_fn(p, lexer.kind_is_colon) {
            if p_eat_fn(p, kind_is_mut) {
                mutable = 1
            }
            ty = parse_type(p)?
        }
        p_expect_eq(p)?
        val expr = parse_expr(p)?
        if expr.kind == NK_IDENT && lexer.kind_is_lbrace(p_peek_kind(p)) {
            return err p_error(p, c"type-prefixed initialization is not valid")
        }
        val n: mut ref Node = make_node(p.arena, NK_VAL, line)
        node_store_string_slot(@addr(n.d0), name)
        n.d1 = mutable
        node_store_slot[ref Node](@addr(n.d2), ty)
        node_store_slot[ref Node](@addr(n.d3), expr)
        return ok n
    }

    if kind_is_return(k) {
        p_advance(p)
        val n2: mut ref Node = make_node(p.arena, NK_RETURN, line)
        if !lexer.kind_is_rbrace(p_peek_kind(p)) && !kind_is_eof(p_peek_kind(p)) {
            val ret_expr = parse_expr(p)?
            node_store_slot[ref Node](@addr(n2.d0), ret_expr)
        }
        return ok n2
    }

    if kind_is_pre(k) {
        p_advance(p)
        p_expect_lbrace(p)?
        val cs = parse_contracts(p)?
        p_expect_rbrace(p)?
        val n3: mut ref Node = make_node(p.arena, NK_PRE, line)
        val clist: list[ref Node] = cs
        node_store_slot[list[ref Node]](@addr(n3.d0), clist)
        return ok n3
    }

    if kind_is_post(k) {
        p_advance(p)
        p_expect_lbrace(p)?
        val cs2 = parse_contracts(p)?
        p_expect_rbrace(p)?
        val n4: mut ref Node = make_node(p.arena, NK_POST, line)
        val clist2: list[ref Node] = cs2
        node_store_slot[list[ref Node]](@addr(n4.d0), clist2)
        return ok n4
    }

    if kind_is_guarded(k) {
        p_advance(p)
        val sub: lexer.TokenKind = p_peek_kind(p)
        if !kind_is_pre(sub) && !kind_is_post(sub) {
            return err p_error(p, c"expected 'pre' or 'post' after 'guarded'")
        }
        val is_post: bool = kind_is_post(sub)
        p_advance(p)
        p_expect_lbrace(p)?
        val cs3 = parse_contracts(p)?
        p_expect_rbrace(p)?
        val nk5: mut i64 = NK_GUARDED_PRE
        if is_post {
            nk5 = NK_GUARDED_POST
        }
        val n5: mut ref Node = make_node(p.arena, nk5, line)
        val clist3: list[ref Node] = cs3
        node_store_slot[list[ref Node]](@addr(n5.d0), clist3)
        return ok n5
    }

    if kind_is_guard(k) {
        p_advance(p)
        val gcond = parse_expr(p)?
        if !kind_is_else(p_peek_kind(p)) {
            return err p_error(p, c"expected 'else' after guard condition")
        }
        p_advance(p)
        p_expect_lbrace(p)?
        val gbody = parse_stmts(p)?
        p_expect_rbrace(p)?
        val ng: mut ref Node = make_node(p.arena, NK_GUARD, line)
        node_store_slot[ref Node](@addr(ng.d0), gcond)
        val gbl: list[ref Node] = gbody
        node_store_slot[list[ref Node]](@addr(ng.d1), gbl)
        return ok ng
    }

    if kind_is_if(k) {
        p_advance(p)
        val cond = parse_expr(p)?

        val peek_next_some: mut bool = false
        val peek_next_none: mut bool = false
        val peek_next_ok: mut bool = false
        val peek_next_err: mut bool = false
        if lexer.kind_is_ident(p_peek_kind(p)) {
            val ptxt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if ptxt != none {
                if cstr.eql(ptxt, c"is") {
                    if kind_is_some(p_peek2_kind(p)) {
                        peek_next_some = true
                    } elif kind_is_none(p_peek2_kind(p)) {
                        peek_next_none = true
                    } elif kind_is_ok(p_peek2_kind(p)) {
                        peek_next_ok = true
                    } elif kind_is_err(p_peek2_kind(p)) {
                        peek_next_err = true
                    }
                }
            }
        }
        if peek_next_some {
            p_advance(p)
            p_advance(p)
            val is_bind = p_expect_ident(p)?
            p_expect_lbrace(p)?
            val is_some_stmts = parse_stmts(p)?
            p_expect_rbrace(p)?

            val is_sbl: list[ref Node] = is_some_stmts
            val is_some_body: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
            node_store_slot[list[ref Node]](@addr(is_some_body.d0), is_sbl)

            val is_elif_list: mut list[ref Node] = mem.new[ref Node]()
            for {
                if !kind_is_elif(p_peek_kind(p)) {
                    break
                }
                val iel: i64 = p_line(p)
                p_advance(p)
                val iecond = parse_expr(p)?
                p_expect_lbrace(p)?
                val iebody = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iep: mut ref Node = make_node(p.arena, NK_IF, iel)
                node_store_slot[ref Node](@addr(iep.d0), iecond)
                val iebl: list[ref Node] = iebody
                node_store_slot[list[ref Node]](@addr(iep.d1), iebl)
                @append(is_elif_list, iep)
            }
            val is_else_node: mut ref Node = none
            if p_eat_fn(p, kind_is_else) {
                p_expect_lbrace(p)?
                val ieb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iebl2: list[ref Node] = ieb
                val ien: mut ref Node = make_node(p.arena, NK_IF, line)
                node_store_slot[list[ref Node]](@addr(ien.d0), iebl2)
                is_else_node = ien
            }

            val is_none_body: mut ref Node = none
            val is_elif_count: i64 = @len(is_elif_list) as i64
            if is_elif_count > 0 {
                val ife0_opt = @get(is_elif_list, 0 as usize)
                if ife0_opt is some ife0 {
                    val ife0n: ref Node = ife0 as ref Node
                    val irest: mut list[ref Node] = mem.new[ref Node]()
                    val iri: mut i64 = 1
                    for {
                        if iri >= is_elif_count {
                            break
                        }
                        val ire_opt = @get(is_elif_list, iri as usize)
                        if ire_opt is some ire {
                            @append(irest, ire as ref Node)
                        }
                        iri++
                    }
                    val isyn: mut ref Node = make_node(p.arena, NK_IF, ife0n.line)
                    isyn.d0 = ife0n.d0
                    isyn.d1 = ife0n.d1
                    val irestl: list[ref Node] = irest
                    node_store_slot[list[ref Node]](@addr(isyn.d2), irestl)
                    node_store_slot[ref Node](@addr(isyn.d3), is_else_node)
                    val instmts: mut list[ref Node] = mem.new[ref Node]()
                    @append(instmts, isyn)
                    val instl: list[ref Node] = instmts
                    val inc: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
                    node_store_slot[list[ref Node]](@addr(inc.d0), instl)
                    is_none_body = inc
                }
            } elif is_else_node != none {
                is_none_body = is_else_node
            }

            val nmo: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
            node_store_slot[ref Node](@addr(nmo.d0), cond)
            node_store_string_slot(@addr(nmo.d1), is_bind)
            node_store_slot[ref Node](@addr(nmo.d2), is_some_body)
            node_store_slot[ref Node](@addr(nmo.d3), is_none_body)
            nmo.d6 = 1
            return ok nmo
        }

        if peek_next_none {
            p_advance(p)
            p_advance(p)
            p_expect_lbrace(p)?
            val is_none_stmts = parse_stmts(p)?
            p_expect_rbrace(p)?

            val is_nbl: list[ref Node] = is_none_stmts
            val is_none_body: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
            node_store_slot[list[ref Node]](@addr(is_none_body.d0), is_nbl)

            val is_elif_list: mut list[ref Node] = mem.new[ref Node]()
            for {
                if !kind_is_elif(p_peek_kind(p)) {
                    break
                }
                val iel: i64 = p_line(p)
                p_advance(p)
                val iecond = parse_expr(p)?
                p_expect_lbrace(p)?
                val iebody = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iep: mut ref Node = make_node(p.arena, NK_IF, iel)
                node_store_slot[ref Node](@addr(iep.d0), iecond)
                val iebl: list[ref Node] = iebody
                node_store_slot[list[ref Node]](@addr(iep.d1), iebl)
                @append(is_elif_list, iep)
            }
            val is_else_node: mut ref Node = none
            if p_eat_fn(p, kind_is_else) {
                p_expect_lbrace(p)?
                val ieb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iebl2: list[ref Node] = ieb
                val ien: mut ref Node = make_node(p.arena, NK_IF, line)
                node_store_slot[list[ref Node]](@addr(ien.d0), iebl2)
                is_else_node = ien
            }

            val is_some_body: mut ref Node = none
            val is_elif_count: i64 = @len(is_elif_list) as i64
            if is_elif_count > 0 {
                val ife0_opt = @get(is_elif_list, 0 as usize)
                if ife0_opt is some ife0 {
                    val ife0n: ref Node = ife0 as ref Node
                    val irest: mut list[ref Node] = mem.new[ref Node]()
                    val iri: mut i64 = 1
                    for {
                        if iri >= is_elif_count {
                            break
                        }
                        val ire_opt = @get(is_elif_list, iri as usize)
                        if ire_opt is some ire {
                            @append(irest, ire as ref Node)
                        }
                        iri++
                    }
                    val isyn: mut ref Node = make_node(p.arena, NK_IF, ife0n.line)
                    isyn.d0 = ife0n.d0
                    isyn.d1 = ife0n.d1
                    val irestl: list[ref Node] = irest
                    node_store_slot[list[ref Node]](@addr(isyn.d2), irestl)
                    node_store_slot[ref Node](@addr(isyn.d3), is_else_node)
                    val instmts: mut list[ref Node] = mem.new[ref Node]()
                    @append(instmts, isyn)
                    val instl: list[ref Node] = instmts
                    val inc: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
                    node_store_slot[list[ref Node]](@addr(inc.d0), instl)
                    is_some_body = inc
                }
            } elif is_else_node != none {
                is_some_body = is_else_node
            }

            val nmo: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
            node_store_slot[ref Node](@addr(nmo.d0), cond)
            node_store_string_slot(@addr(nmo.d1), none)
            node_store_slot[ref Node](@addr(nmo.d2), is_some_body)
            node_store_slot[ref Node](@addr(nmo.d3), is_none_body)
            nmo.d6 = 2
            return ok nmo
        }

        if peek_next_ok {
            p_advance(p)
            p_advance(p)
            val is_bind = p_expect_ident(p)?
            p_expect_lbrace(p)?
            val is_ok_stmts = parse_stmts(p)?
            p_expect_rbrace(p)?

            val is_obl: list[ref Node] = is_ok_stmts
            val is_ok_body: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
            node_store_slot[list[ref Node]](@addr(is_ok_body.d0), is_obl)

            val is_elif_list: mut list[ref Node] = mem.new[ref Node]()
            for {
                if !kind_is_elif(p_peek_kind(p)) {
                    break
                }
                val iel: i64 = p_line(p)
                p_advance(p)
                val iecond = parse_expr(p)?
                p_expect_lbrace(p)?
                val iebody = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iep: mut ref Node = make_node(p.arena, NK_IF, iel)
                node_store_slot[ref Node](@addr(iep.d0), iecond)
                val iebl: list[ref Node] = iebody
                node_store_slot[list[ref Node]](@addr(iep.d1), iebl)
                @append(is_elif_list, iep)
            }
            val is_else_node: mut ref Node = none
            if p_eat_fn(p, kind_is_else) {
                p_expect_lbrace(p)?
                val ieb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iebl2: list[ref Node] = ieb
                val ien: mut ref Node = make_node(p.arena, NK_IF, line)
                node_store_slot[list[ref Node]](@addr(ien.d0), iebl2)
                is_else_node = ien
            }

            val is_err_body: mut ref Node = none
            val is_elif_count: i64 = @len(is_elif_list) as i64
            if is_elif_count > 0 {
                val ife0_opt = @get(is_elif_list, 0 as usize)
                if ife0_opt is some ife0 {
                    val ife0n: ref Node = ife0 as ref Node
                    val irest: mut list[ref Node] = mem.new[ref Node]()
                    val iri: mut i64 = 1
                    for {
                        if iri >= is_elif_count {
                            break
                        }
                        val ire_opt = @get(is_elif_list, iri as usize)
                        if ire_opt is some ire {
                            @append(irest, ire as ref Node)
                        }
                        iri++
                    }
                    val isyn: mut ref Node = make_node(p.arena, NK_IF, ife0n.line)
                    isyn.d0 = ife0n.d0
                    isyn.d1 = ife0n.d1
                    val irestl: list[ref Node] = irest
                    node_store_slot[list[ref Node]](@addr(isyn.d2), irestl)
                    node_store_slot[ref Node](@addr(isyn.d3), is_else_node)
                    val instmts: mut list[ref Node] = mem.new[ref Node]()
                    @append(instmts, isyn)
                    val instl: list[ref Node] = instmts
                    val inc: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
                    node_store_slot[list[ref Node]](@addr(inc.d0), instl)
                    is_err_body = inc
                }
            } elif is_else_node != none {
                is_err_body = is_else_node
            }

            val nmr: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
            node_store_slot[ref Node](@addr(nmr.d0), cond)
            node_store_string_slot(@addr(nmr.d1), is_bind)
            node_store_slot[ref Node](@addr(nmr.d2), is_ok_body)
            node_store_string_slot(@addr(nmr.d3), none)
            node_store_slot[ref Node](@addr(nmr.d4), is_err_body)
            nmr.d6 = 1
            return ok nmr
        }

        if peek_next_err {
            p_advance(p)
            p_advance(p)
            val is_bind = p_expect_ident(p)?
            p_expect_lbrace(p)?
            val is_err_stmts = parse_stmts(p)?
            p_expect_rbrace(p)?

            val is_ebl: list[ref Node] = is_err_stmts
            val is_err_body: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
            node_store_slot[list[ref Node]](@addr(is_err_body.d0), is_ebl)

            val is_elif_list: mut list[ref Node] = mem.new[ref Node]()
            for {
                if !kind_is_elif(p_peek_kind(p)) {
                    break
                }
                val iel: i64 = p_line(p)
                p_advance(p)
                val iecond = parse_expr(p)?
                p_expect_lbrace(p)?
                val iebody = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iep: mut ref Node = make_node(p.arena, NK_IF, iel)
                node_store_slot[ref Node](@addr(iep.d0), iecond)
                val iebl: list[ref Node] = iebody
                node_store_slot[list[ref Node]](@addr(iep.d1), iebl)
                @append(is_elif_list, iep)
            }
            val is_else_node: mut ref Node = none
            if p_eat_fn(p, kind_is_else) {
                p_expect_lbrace(p)?
                val ieb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val iebl2: list[ref Node] = ieb
                val ien: mut ref Node = make_node(p.arena, NK_IF, line)
                node_store_slot[list[ref Node]](@addr(ien.d0), iebl2)
                is_else_node = ien
            }

            val is_ok_body: mut ref Node = none
            val is_elif_count: i64 = @len(is_elif_list) as i64
            if is_elif_count > 0 {
                val ife0_opt = @get(is_elif_list, 0 as usize)
                if ife0_opt is some ife0 {
                    val ife0n: ref Node = ife0 as ref Node
                    val irest: mut list[ref Node] = mem.new[ref Node]()
                    val iri: mut i64 = 1
                    for {
                        if iri >= is_elif_count {
                            break
                        }
                        val ire_opt = @get(is_elif_list, iri as usize)
                        if ire_opt is some ire {
                            @append(irest, ire as ref Node)
                        }
                        iri++
                    }
                    val isyn: mut ref Node = make_node(p.arena, NK_IF, ife0n.line)
                    isyn.d0 = ife0n.d0
                    isyn.d1 = ife0n.d1
                    val irestl: list[ref Node] = irest
                    node_store_slot[list[ref Node]](@addr(isyn.d2), irestl)
                    node_store_slot[ref Node](@addr(isyn.d3), is_else_node)
                    val instmts: mut list[ref Node] = mem.new[ref Node]()
                    @append(instmts, isyn)
                    val instl: list[ref Node] = instmts
                    val inc: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
                    node_store_slot[list[ref Node]](@addr(inc.d0), instl)
                    is_ok_body = inc
                }
            } elif is_else_node != none {
                is_ok_body = is_else_node
            }

            val nmr: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
            node_store_slot[ref Node](@addr(nmr.d0), cond)
            node_store_string_slot(@addr(nmr.d1), none)
            node_store_slot[ref Node](@addr(nmr.d2), is_ok_body)
            node_store_string_slot(@addr(nmr.d3), is_bind)
            node_store_slot[ref Node](@addr(nmr.d4), is_err_body)
            nmr.d6 = 2
            return ok nmr
        }

        p_expect_lbrace(p)?
        val then_body = parse_stmts(p)?
        p_expect_rbrace(p)?
        val elif_list: mut list[ref Node] = mem.new[ref Node]()
        for {
            if !kind_is_elif(p_peek_kind(p)) {
                break
            }
            val el: i64 = p_line(p)
            p_advance(p)
            val econd = parse_expr(p)?
            p_expect_lbrace(p)?
            val ebody = parse_stmts(p)?
            p_expect_rbrace(p)?
            val ep: mut ref Node = make_node(p.arena, NK_IF, el)
            node_store_slot[ref Node](@addr(ep.d0), econd)
            val tb: list[ref Node] = ebody
            node_store_slot[list[ref Node]](@addr(ep.d1), tb)
            @append(elif_list, ep)
        }
        val else_body: mut ref Node = none
        if p_eat_fn(p, kind_is_else) {
            p_expect_lbrace(p)?
            val eb = parse_stmts(p)?
            p_expect_rbrace(p)?
            val ebl: list[ref Node] = eb
            val ebnode: mut ref Node = make_node(p.arena, NK_IF, line)
            node_store_slot[list[ref Node]](@addr(ebnode.d0), ebl)
            else_body = ebnode
        }
        val nif: mut ref Node = make_node(p.arena, NK_IF, line)
        node_store_slot[ref Node](@addr(nif.d0), cond)
        val tbl: list[ref Node] = then_body
        node_store_slot[list[ref Node]](@addr(nif.d1), tbl)
        val ell: list[ref Node] = elif_list
        node_store_slot[list[ref Node]](@addr(nif.d2), ell)
        node_store_slot[ref Node](@addr(nif.d3), else_body)
        return ok nif
    }

    if kind_is_for(k) {
        p_advance(p)
        if lexer.kind_is_lbrace(p_peek_kind(p)) {
            p_advance(p)
            val body = parse_stmts(p)?
            p_expect_rbrace(p)?
            val nf: mut ref Node = make_node(p.arena, NK_FOR, line)
            val bl: list[ref Node] = body
            node_store_slot[list[ref Node]](@addr(nf.d4), bl)
            return ok nf
        }
        val has_paren2: bool = p_eat_fn(p, lexer.kind_is_lparen)
        val for_start: i64 = p.pos
        if kind_is_ident(p_peek_kind(p)) {
            val first_name = p_expect_ident(p)?
            if p_eat_fn(p, kind_is_in) {
                val iter = parse_expr(p)?
                if has_paren2 {
                    p_expect_rparen(p)?
                }
                p_expect_lbrace(p)?
                val fi_body = parse_stmts(p)?
                p_expect_rbrace(p)?
                val nfi: mut ref Node = make_node(p.arena, NK_FORIN, line)
                node_store_string_slot(@addr(nfi.d0), first_name)
                node_store_slot[ref Node](@addr(nfi.d1), iter)
                val fibl: list[ref Node] = fi_body
                node_store_slot[list[ref Node]](@addr(nfi.d2), fibl)
                return ok nfi
            }
            if p_eat_fn(p, kind_is_eq) {
                val init_expr = parse_expr(p)?
                p_expect_comma(p)?
                val cond2 = parse_expr(p)?
                p_expect_comma(p)?
                val post_target = parse_expr(p)?
                val post_kind: lexer.TokenKind = p_peek_kind(p)
                val post_node: mut ref Node = none
                if lexer.kind_is_plusplus(post_kind) {
                    p_advance(p)
                    val pn: mut ref Node = make_node(p.arena, NK_INCREMENT, line)
                    node_store_slot[ref Node](@addr(pn.d0), post_target)
                    post_node = pn
                } elif lexer.kind_is_minusminus(post_kind) {
                    p_advance(p)
                    val pn2: mut ref Node = make_node(p.arena, NK_DECREMENT, line)
                    node_store_slot[ref Node](@addr(pn2.d0), post_target)
                    post_node = pn2
                } elif kind_is_pluseq(post_kind) {
                    p_advance(p)
                    val pv = parse_expr(p)?
                    val pn3: mut ref Node = make_node(p.arena, NK_ADD_ASSIGN, line)
                    node_store_slot[ref Node](@addr(pn3.d0), post_target)
                    node_store_slot[ref Node](@addr(pn3.d1), pv)
                    post_node = pn3
                } elif kind_is_minuseq(post_kind) {
                    p_advance(p)
                    val pv2 = parse_expr(p)?
                    val pn4: mut ref Node = make_node(p.arena, NK_SUB_ASSIGN, line)
                    node_store_slot[ref Node](@addr(pn4.d0), post_target)
                    node_store_slot[ref Node](@addr(pn4.d1), pv2)
                    post_node = pn4
                } else {
                    return err p_error(p, c"expected '++', '--', '+=', or '-=' in for loop")
                }
                if has_paren2 {
                    p_expect_rparen(p)?
                }
                p_expect_lbrace(p)?
                val for_body = parse_stmts(p)?
                p_expect_rbrace(p)?
                val nfor: mut ref Node = make_node(p.arena, NK_FOR, line)
                node_store_string_slot(@addr(nfor.d0), first_name)
                node_store_slot[ref Node](@addr(nfor.d1), init_expr)
                node_store_slot[ref Node](@addr(nfor.d2), cond2)
                node_store_slot[ref Node](@addr(nfor.d3), post_node)
                val fbl: list[ref Node] = for_body
                node_store_slot[list[ref Node]](@addr(nfor.d4), fbl)
                return ok nfor
            }
            p.pos = for_start
        }

        val cond_only = parse_expr(p)?
        if has_paren2 {
            p_expect_rparen(p)?
        }
        p_expect_lbrace(p)?
        val for_body = parse_stmts(p)?
        p_expect_rbrace(p)?
        val nfor2: mut ref Node = make_node(p.arena, NK_FOR, line)
        node_store_slot[ref Node](@addr(nfor2.d2), cond_only)
        val fbl2: list[ref Node] = for_body
        node_store_slot[list[ref Node]](@addr(nfor2.d4), fbl2)
        return ok nfor2
    }

    if kind_is_defer(k) {
        p_advance(p)
        p_expect_lbrace(p)?
        val db = parse_stmts(p)?
        p_expect_rbrace(p)?
        val nd: mut ref Node = make_node(p.arena, NK_DEFER, line)
        val dbl: list[ref Node] = db
        node_store_slot[list[ref Node]](@addr(nd.d0), dbl)
        return ok nd
    }

    if kind_is_break(k) {
        p_advance(p)
        return ok make_node(p.arena, NK_BREAK, line)
    }
    if kind_is_continue(k) {
        p_advance(p)
        return ok make_node(p.arena, NK_CONTINUE, line)
    }

    if kind_is_assert(k) {
        p_advance(p)
        val ae = parse_expr(p)?
        val na: mut ref Node = make_node(p.arena, NK_ASSERT, line)
        node_store_slot[ref Node](@addr(na.d0), ae)
        return ok na
    }

    if kind_is_when(k) {
        p_advance(p)
        val ident_text = parse_when_selector(p)?
        val next_k: lexer.TokenKind = p_peek_kind(p)

        if lexer.kind_is_bang(next_k) {
            p_advance(p)
            val next_k2: lexer.TokenKind = p_peek_kind(p)
            if kind_is_in(next_k2) {
                p_advance(p)
                p_expect_lparen(p)?
                val gtypes: mut list[ref Node] = mem.new[ref Node]()
                for {
                    if lexer.kind_is_rparen(p_peek_kind(p)) {
                        break
                    }
                    val gty = parse_type(p)?
                    @append(gtypes, gty)
                    if !p_eat_fn(p, lexer.kind_is_comma) {
                        break
                    }
                }
                p_expect_rparen(p)?
                p_expect_lbrace(p)?
                val gwb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val gcond: mut ref Node = make_node(p.arena, NK_GWHEN_COND, line)
                node_store_string_slot(@addr(gcond.d0), ident_text)
                gcond.d1 = 3
                val gtl: list[ref Node] = gtypes
                node_store_slot[list[ref Node]](@addr(gcond.d2), gtl)
                val gconds: mut list[ref Node] = mem.new[ref Node]()
                @append(gconds, gcond)
                val gnw: mut ref Node = make_node(p.arena, NK_GENERIC_WHEN, line)
                val gcl: list[ref Node] = gconds
                node_store_slot[list[ref Node]](@addr(gnw.d0), gcl)
                val gbl: list[ref Node] = gwb
                node_store_slot[list[ref Node]](@addr(gnw.d1), gbl)
                return ok gnw
            }
        }

        if kind_is_in(next_k) {
            p_advance(p)
            p_expect_lparen(p)?
            val gtypes: mut list[ref Node] = mem.new[ref Node]()
            for {
                if lexer.kind_is_rparen(p_peek_kind(p)) {
                    break
                }
                val gty = parse_type(p)?
                @append(gtypes, gty)
                if !p_eat_fn(p, lexer.kind_is_comma) {
                    break
                }
            }
            p_expect_rparen(p)?
            p_expect_lbrace(p)?
            val gwb = parse_stmts(p)?
            p_expect_rbrace(p)?
            val gcond: mut ref Node = make_node(p.arena, NK_GWHEN_COND, line)
            node_store_string_slot(@addr(gcond.d0), ident_text)
            gcond.d1 = 1
            val gtl: list[ref Node] = gtypes
            node_store_slot[list[ref Node]](@addr(gcond.d2), gtl)
            val gconds: mut list[ref Node] = mem.new[ref Node]()
            @append(gconds, gcond)
            val gnw: mut ref Node = make_node(p.arena, NK_GENERIC_WHEN, line)
            val gcl: list[ref Node] = gconds
            node_store_slot[list[ref Node]](@addr(gnw.d0), gcl)
            val gbl: list[ref Node] = gwb
            node_store_slot[list[ref Node]](@addr(gnw.d1), gbl)
            return ok gnw
        }

        if kind_is_ident(next_k) {
            val next_txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if cstr.eql(next_txt, c"is") {
                val gconds2: mut list[ref Node] = mem.new[ref Node]()
                val cur_tparam: mut ref u8 = ident_text
                for {
                    p_advance(p)
                    val gty2 = parse_type(p)?
                    val gcond2: mut ref Node = make_node(p.arena, NK_GWHEN_COND, line)
                    node_store_string_slot(@addr(gcond2.d0), cur_tparam)
                    gcond2.d1 = 2
                    val stl: mut list[ref Node] = mem.new[ref Node]()
                    @append(stl, gty2)
                    val stl_ref: list[ref Node] = stl
                    node_store_slot[list[ref Node]](@addr(gcond2.d2), stl_ref)
                    @append(gconds2, gcond2)
                    if !lexer.kind_is_and(p_peek_kind(p)) {
                        break
                    }
                    p_advance(p)
                    if !kind_is_ident(p_peek_kind(p)) {
                        break
                    }
                    cur_tparam = p_advance_text(p)
                    if !kind_is_ident(p_peek_kind(p)) {
                        break
                    }
                    val nis_txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
                    if !cstr.eql(nis_txt, c"is") {
                        break
                    }
                }
                p_expect_lbrace(p)?
                val gwb2 = parse_stmts(p)?
                p_expect_rbrace(p)?
                val gnw2: mut ref Node = make_node(p.arena, NK_GENERIC_WHEN, line)
                val gcl2: list[ref Node] = gconds2
                node_store_slot[list[ref Node]](@addr(gnw2.d0), gcl2)
                val gbl2: list[ref Node] = gwb2
                node_store_slot[list[ref Node]](@addr(gnw2.d1), gbl2)
                return ok gnw2
            }
        }

        if cstr.eql(ident_text, c"_") {
            p_expect_lbrace(p)?
            val gwb3 = parse_stmts(p)?
            p_expect_rbrace(p)?
            val gwc: mut ref Node = make_node(p.arena, NK_GWHEN_COND, line)
            gwc.d0 = 0
            gwc.d1 = 0
            gwc.d2 = 0
            val gwcs: mut list[ref Node] = mem.new[ref Node]()
            @append(gwcs, gwc)
            val gnw3: mut ref Node = make_node(p.arena, NK_GENERIC_WHEN, line)
            val gwcl: list[ref Node] = gwcs
            node_store_slot[list[ref Node]](@addr(gnw3.d0), gwcl)
            val gwbl3: list[ref Node] = gwb3
            node_store_slot[list[ref Node]](@addr(gnw3.d1), gwbl3)
            return ok gnw3
        }

        val plat: ref u8 = ident_text
        p_expect_lbrace(p)?
        val wb = parse_stmts(p)?
        p_expect_rbrace(p)?
        val or_when_branches: mut list[ref Node] = mem.new[ref Node]()
        for {
            val k2: lexer.TokenKind = p_peek_kind(p)
            if !kind_is_ident(k2) {
                break
            }
            val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if !cstr.eql(txt, c"or") {
                break
            }
            val k3: lexer.TokenKind = p_peek2_kind(p)
            if !kind_is_when(k3) {
                break
            }
            p_advance(p)
            p_advance(p)
            val ow_plat = parse_when_selector(p)?
            p_expect_lbrace(p)?
            val ow_body = parse_stmts(p)?
            p_expect_rbrace(p)?
            val ow_node: mut ref Node = make_node(p.arena, NK_WHEN_STMT, line)
            node_store_string_slot(@addr(ow_node.d0), ow_plat)
            val ow_bl: list[ref Node] = ow_body
            node_store_slot[list[ref Node]](@addr(ow_node.d1), ow_bl)
            @append(or_when_branches, ow_node)
        }
        val otherwise_stmts: mut list[ref Node] = mem.new[ref Node]()
        val k4: lexer.TokenKind = p_peek_kind(p)
        if kind_is_ident(k4) {
            val txt2: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if cstr.eql(txt2, c"otherwise") {
                p_advance(p)
                p_expect_lbrace(p)?
                val ow2 = parse_stmts(p)?
                p_expect_rbrace(p)?
                otherwise_stmts = ow2
            }
        }
        val nw: mut ref Node = make_node(p.arena, NK_WHEN_STMT, line)
        node_store_string_slot(@addr(nw.d0), plat)
        val wbl: list[ref Node] = wb
        node_store_slot[list[ref Node]](@addr(nw.d1), wbl)
        val owbl: list[ref Node] = or_when_branches
        node_store_slot[list[ref Node]](@addr(nw.d2), owbl)
        val owsl: list[ref Node] = otherwise_stmts
        node_store_slot[list[ref Node]](@addr(nw.d3), owsl)
        return ok nw
    }

    if kind_is_match(k) {
        return parse_match_stmt(p, line)
    }

    if kind_is_trust(k) && lexer.kind_is_lbrace(p_peek2_kind(p)) {
        p_advance(p)
        p_expect_lbrace(p)?
        val tb = parse_stmts(p)?
        p_expect_rbrace(p)?
        val ntb: mut ref Node = make_node(p.arena, NK_TRUST_BLOCK, line)
        val tbl: list[ref Node] = tb
        node_store_slot[list[ref Node]](@addr(ntb.d0), tbl)
        return ok ntb
    }

    val expr3 = parse_expr(p)?
    if p_eat_fn(p, kind_is_eq) {
        val rhs = parse_expr(p)?
        if rhs.kind == NK_IDENT && lexer.kind_is_lbrace(p_peek_kind(p)) {
            return err p_error(p, c"type-prefixed initialization is not valid")
        }
        val na2: mut ref Node = make_node(p.arena, NK_ASSIGN, line)
        node_store_slot[ref Node](@addr(na2.d0), expr3)
        node_store_slot[ref Node](@addr(na2.d1), rhs)
        return ok na2
    }
    if p_eat_fn(p, lexer.kind_is_plusplus) {
        val ni: mut ref Node = make_node(p.arena, NK_INCREMENT, line)
        node_store_slot[ref Node](@addr(ni.d0), expr3)
        return ok ni
    }
    if p_eat_fn(p, lexer.kind_is_minusminus) {
        val nd2: mut ref Node = make_node(p.arena, NK_DECREMENT, line)
        node_store_slot[ref Node](@addr(nd2.d0), expr3)
        return ok nd2
    }
    if p_eat_fn(p, kind_is_pluseq) {
        val rv = parse_expr(p)?
        val naa: mut ref Node = make_node(p.arena, NK_ADD_ASSIGN, line)
        node_store_slot[ref Node](@addr(naa.d0), expr3)
        node_store_slot[ref Node](@addr(naa.d1), rv)
        return ok naa
    }
    if p_eat_fn(p, kind_is_minuseq) {
        val rv2 = parse_expr(p)?
        val nsa: mut ref Node = make_node(p.arena, NK_SUB_ASSIGN, line)
        node_store_slot[ref Node](@addr(nsa.d0), expr3)
        node_store_slot[ref Node](@addr(nsa.d1), rv2)
        return ok nsa
    }
    val nes: mut ref Node = make_node(p.arena, NK_EXPR_STMT, line)
    node_store_slot[ref Node](@addr(nes.d0), expr3)
    return ok nes
}

fn parse_match_stmt(p: mut ref Parser, line: i64) result[ref Node, ref u8] = trust {
    p_advance(p)
    val expr = parse_expr(p)?
    p_expect_lbrace(p)?

    if kind_is_ok(p_peek_kind(p)) || kind_is_err(p_peek_kind(p)) {
        val ok_bind: mut ref u8 = none
        val ok_body: mut ref Node = none
        val err_bind: mut ref u8 = none
        val err_body: mut ref Node = none
        for i = 0, i < 2, i++ {
            val ck: lexer.TokenKind = p_peek_kind(p)
            if kind_is_ok(ck) {
                p_advance(p)
                ok_bind = p_expect_ident(p)?
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val ob = parse_stmts(p)?
                p_expect_rbrace(p)?
                val obl: list[ref Node] = ob
                val obn: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
                node_store_slot[list[ref Node]](@addr(obn.d0), obl)
                ok_body = obn
            } elif kind_is_err(ck) {
                p_advance(p)
                err_bind = p_expect_ident(p)?
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val eb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val ebl: list[ref Node] = eb
                val ebn: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
                node_store_slot[list[ref Node]](@addr(ebn.d0), ebl)
                err_body = ebn
            }
        }
        p_expect_rbrace(p)?
        val nm: mut ref Node = make_node(p.arena, NK_MATCH_RES, line)
        node_store_slot[ref Node](@addr(nm.d0), expr)
        node_store_string_slot(@addr(nm.d1), ok_bind)
        node_store_slot[ref Node](@addr(nm.d2), ok_body)
        node_store_string_slot(@addr(nm.d3), err_bind)
        node_store_slot[ref Node](@addr(nm.d4), err_body)
        return ok nm
    }

    if kind_is_some(p_peek_kind(p)) || kind_is_none(p_peek_kind(p)) {
        val some_bind: mut ref u8 = none
        val some_body: mut ref Node = none
        val none_body: mut ref Node = none
        for i = 0, i < 2, i++ {
            val ck2: lexer.TokenKind = p_peek_kind(p)
            if kind_is_some(ck2) {
                p_advance(p)
                some_bind = p_expect_ident(p)?
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val sb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val sbl: list[ref Node] = sb
                val sbn: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
                node_store_slot[list[ref Node]](@addr(sbn.d0), sbl)
                some_body = sbn
            } elif kind_is_none(ck2) {
                p_advance(p)
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val nb = parse_stmts(p)?
                p_expect_rbrace(p)?
                val nbl: list[ref Node] = nb
                val nbn: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
                node_store_slot[list[ref Node]](@addr(nbn.d0), nbl)
                none_body = nbn
            }
        }
        p_expect_rbrace(p)?
        val nmo: mut ref Node = make_node(p.arena, NK_MATCH_OPT, line)
        node_store_slot[ref Node](@addr(nmo.d0), expr)
        node_store_string_slot(@addr(nmo.d1), some_bind)
        node_store_slot[ref Node](@addr(nmo.d2), some_body)
        node_store_slot[ref Node](@addr(nmo.d3), none_body)
        return ok nmo
    }

    if kind_is_ident(p_peek_kind(p)) && lexer.kind_is_dot(p_peek2_kind(p)) {
        val arms: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            val el: i64 = p_line(p)
            val enum_type_name = p_expect_ident(p)?
            p_expect_dot(p)?
            val variant = p_expect_ident(p)?
            p_expect_fatarrow(p)?
            p_expect_lbrace(p)?
            val ab = parse_stmts(p)?
            p_expect_rbrace(p)?
            val arm: mut ref Node = make_node(p.arena, NK_MATCH_ENUM, el)
            node_store_string_slot(@addr(arm.d0), variant)
            node_store_string_slot(@addr(arm.d2), enum_type_name)
            val abl: list[ref Node] = ab
            node_store_slot[list[ref Node]](@addr(arm.d1), abl)
            @append(arms, arm)
        }
        p_expect_rbrace(p)?
        val nme: mut ref Node = make_node(p.arena, NK_MATCH_ENUM, line)
        node_store_slot[ref Node](@addr(nme.d0), expr)
        val al: list[ref Node] = arms
        node_store_slot[list[ref Node]](@addr(nme.d1), al)
        return ok nme
    }

    if kind_is_str(p_peek_kind(p)) {
        val sarms: mut list[ref Node] = mem.new[ref Node]()
        val else_body: mut ref Node = none
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            if kind_is_else(p_peek_kind(p)) {
                p_advance(p)
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val eb2 = parse_stmts(p)?
                p_expect_rbrace(p)?
                val ebl2: list[ref Node] = eb2
                val ebn2: mut ref Node = make_node(p.arena, NK_MATCH_STR, line)
                node_store_slot[list[ref Node]](@addr(ebn2.d0), ebl2)
                else_body = ebn2
                break
            }
            val sv: ref u8 = p_advance_text(p)
            p_expect_fatarrow(p)?
            p_expect_lbrace(p)?
            val sab = parse_stmts(p)?
            p_expect_rbrace(p)?
            val sarm: mut ref Node = make_node(p.arena, NK_MATCH_STR, p_line(p))
            node_store_string_slot(@addr(sarm.d0), sv)
            val sabl: list[ref Node] = sab
            node_store_slot[list[ref Node]](@addr(sarm.d1), sabl)
            @append(sarms, sarm)
        }
        p_expect_rbrace(p)?
        val nms: mut ref Node = make_node(p.arena, NK_MATCH_STR, line)
        node_store_slot[ref Node](@addr(nms.d0), expr)
        val sal: list[ref Node] = sarms
        node_store_slot[list[ref Node]](@addr(nms.d1), sal)
        node_store_slot[ref Node](@addr(nms.d2), else_body)
        return ok nms
    }

    if kind_is_int(p_peek_kind(p)) || kind_is_float(p_peek_kind(p)) ||
    kind_is_true(p_peek_kind(p)) || kind_is_false(p_peek_kind(p)) ||
    (kind_is_minus(p_peek_kind(p)) && (kind_is_int(p_peek2_kind(p)) || kind_is_float(p_peek2_kind(p)))) {
        val varms: mut list[ref Node] = mem.new[ref Node]()
        val else_body: mut ref Node = none
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            if kind_is_else(p_peek_kind(p)) {
                p_advance(p)
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val eb3 = parse_stmts(p)?
                p_expect_rbrace(p)?
                val ebl3: list[ref Node] = eb3
                val ebn3: mut ref Node = make_node(p.arena, NK_MATCH_VALUE, line)
                node_store_slot[list[ref Node]](@addr(ebn3.d0), ebl3)
                else_body = ebn3
                break
            }
            val pat = parse_expr(p)?
            p_expect_fatarrow(p)?
            p_expect_lbrace(p)?
            val vab = parse_stmts(p)?
            p_expect_rbrace(p)?
            val varm: mut ref Node = make_node(p.arena, NK_MATCH_VALUE, pat.line)
            node_store_slot[ref Node](@addr(varm.d0), pat)
            val vabl: list[ref Node] = vab
            node_store_slot[list[ref Node]](@addr(varm.d1), vabl)
            @append(varms, varm)
        }
        p_expect_rbrace(p)?
        val nmv: mut ref Node = make_node(p.arena, NK_MATCH_VALUE, line)
        node_store_slot[ref Node](@addr(nmv.d0), expr)
        val value: list[ref Node] = varms
        node_store_slot[list[ref Node]](@addr(nmv.d1), value)
        node_store_slot[ref Node](@addr(nmv.d2), else_body)
        return ok nmv
    }

    val uarms: mut list[ref Node] = mem.new[ref Node]()
    val u_else: mut ref Node = none
    val is_tagged_union_match: bool = kind_is_ident(p_peek_kind(p)) &&
    (kind_is_ident(p_peek2_kind(p)) || lexer.kind_is_lparen(p_peek2_kind(p)))

    if is_tagged_union_match {
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            if kind_is_else(p_peek_kind(p)) {
                p_advance(p)
                p_expect_fatarrow(p)?
                p_expect_lbrace(p)?
                val ueb2 = parse_stmts(p)?
                p_expect_rbrace(p)?
                val uebl2: list[ref Node] = ueb2
                val uebn2: mut ref Node = make_node(p.arena, NK_MATCH_TAGGED_UNION, line)
                node_store_slot[list[ref Node]](@addr(uebn2.d0), uebl2)
                u_else = uebn2
                break
            }
            val tline: i64 = p_line(p)
            val vname = p_expect_ident(p)?
            val bindings: mut list[ref u8] = mem.new[ref u8]()

            if lexer.kind_is_lparen(p_peek_kind(p)) {
                p_advance(p)
                p_expect_rparen(p)?
            } else {
                for {
                    if lexer.kind_is_fatarrow(p_peek_kind(p)) {
                        break
                    }
                    if lexer.kind_is_rbrace(p_peek_kind(p)) {
                        break
                    }
                    val b = p_expect_ident(p)?
                    @append(bindings, b)
                    if !p_eat_fn(p, lexer.kind_is_comma) {
                        break
                    }
                }
            }
            p_expect_fatarrow(p)?
            p_expect_lbrace(p)?
            val tab = parse_stmts(p)?
            p_expect_rbrace(p)?
            val tarm: mut ref Node = make_node(p.arena, NK_MATCH_TAGGED_UNION, tline)
            node_store_string_slot(@addr(tarm.d0), vname)
            val bl: list[ref u8] = bindings
            node_store_slot[list[ref Node]](@addr(tarm.d1), bl)
            val tabl: list[ref Node] = tab
            node_store_slot[list[ref Node]](@addr(tarm.d2), tabl)
            @append(uarms, tarm)
        }
        p_expect_rbrace(p)?
        val ntmu: mut ref Node = make_node(p.arena, NK_MATCH_TAGGED_UNION, line)
        node_store_slot[ref Node](@addr(ntmu.d0), expr)
        val tual: list[ref Node] = uarms
        node_store_slot[list[ref Node]](@addr(ntmu.d1), tual)
        node_store_slot[ref Node](@addr(ntmu.d2), u_else)
        return ok ntmu
    }

    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        if kind_is_else(p_peek_kind(p)) {
            p_advance(p)
            p_expect_fatarrow(p)?
            p_expect_lbrace(p)?
            val ueb = parse_stmts(p)?
            p_expect_rbrace(p)?
            val uebl: list[ref Node] = ueb
            val uebn: mut ref Node = make_node(p.arena, NK_MATCH_UNION, line)
            node_store_slot[list[ref Node]](@addr(uebn.d0), uebl)
            u_else = uebn
            break
        }
        val uty = parse_type(p)?
        p_expect_fatarrow(p)?
        p_expect_lbrace(p)?
        val uab = parse_stmts(p)?
        p_expect_rbrace(p)?
        val uarm: mut ref Node = make_node(p.arena, NK_MATCH_UNION, p_line(p))
        node_store_slot[ref Node](@addr(uarm.d0), uty)
        val uabl: list[ref Node] = uab
        node_store_slot[list[ref Node]](@addr(uarm.d1), uabl)
        @append(uarms, uarm)
    }

    p_expect_rbrace(p)?
    val nmu: mut ref Node = make_node(p.arena, NK_MATCH_UNION, line)
    node_store_slot[ref Node](@addr(nmu.d0), expr)
    val ual: list[ref Node] = uarms
    node_store_slot[list[ref Node]](@addr(nmu.d1), ual)
    node_store_slot[ref Node](@addr(nmu.d2), u_else)
    return ok nmu
}

pub fn parse_stmts(p: mut ref Parser) result[list[ref Node], ref u8] = trust {
    val stmts: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        if kind_is_eof(p_peek_kind(p)) {
            break
        }
        val s = parse_stmt(p)?
        @append(stmts, s)
    }
    return ok stmts
}

fn parse_fn_item(
    p: mut ref Parser,
    public: i64,
    suppress_unused: bool
) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_kind(p, kind_is_fn, c"fn")?
    val ns: mut ref u8 = none
    if lexer.kind_is_lparen(p_peek_kind(p)) {
        if kind_is_ident(p_peek2_kind(p)) && lexer.kind_is_rparen(p_peek3_kind(p)) {
            p_advance(p)
            ns = p_expect_ident(p)?
            p_expect_rparen(p)?
        }
    }
    val name = p_expect_ident(p)?
    val type_params: mut list[ref Node] = mem.new[ref Node]()
    if lexer.kind_is_lbracket(p_peek_kind(p)) {
        p_advance(p)
        for {
            if lexer.kind_is_rbracket(p_peek_kind(p)) {
                break
            }
            val tp_name = p_expect_ident(p)?
            val tp_constraint: mut ref Node = none
            if p_eat_fn(p, lexer.kind_is_colon) {
                tp_constraint = parse_type(p)?
                if ns != none {
                    tp_constraint = substitute_self_type(tp_constraint, ns)
                }
            }
            val tp_node: mut ref Node = make_node(p.arena, NK_VAL, line)
            node_store_string_slot(@addr(tp_node.d0), tp_name)
            node_store_slot[ref Node](@addr(tp_node.d1), tp_constraint)
            @append(type_params, tp_node)
            if !p_eat_fn(p, lexer.kind_is_comma) {
                break
            }
        }
        p_expect_rbracket(p)?
    }
    p_expect_lparen(p)?
    val params: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rparen(p_peek_kind(p)) {
            break
        }
        val pname = p_expect_ident(p)?
        p_expect_colon(p)?
        val is_mut: bool = p_eat_fn(p, kind_is_mut)
        val pty = parse_type(p)?
        val actual_ty: mut ref Node = pty
        if ns != none {
            actual_ty = substitute_self_type(actual_ty, ns)
        }
        if is_mut {
            val mt: mut ref Node = make_node(p.arena, TY_MUT, line)
            node_store_slot[ref Node](@addr(mt.d0), actual_ty)
            actual_ty = mt
        }
        val param: mut ref Node = make_node(p.arena, NK_VAL, line)
        node_store_string_slot(@addr(param.d0), pname)
        node_store_slot[ref Node](@addr(param.d1), actual_ty)
        @append(params, param)
        if !p_eat_fn(p, lexer.kind_is_comma) {
            break
        }
    }
    p_expect_rparen(p)?
    val ret_ty: mut ref Node = parse_type(p)?
    if ns != none {
        ret_ty = substitute_self_type(ret_ty, ns)
    }
    val is_unsafe: mut i64 = 0
    val is_inline: mut i64 = 0
    val suppress_flag: mut i64 = 0
    if suppress_unused {
        suppress_flag = 1
    }
    val body: mut list[ref Node] = mem.new[ref Node]()
    if p_eat_fn(p, kind_is_eq) {
        for {
            if p_eat_fn(p, kind_is_inline) {
                is_inline = 1
                continue
            }
            if p_eat_fn(p, kind_is_trust) {
                is_unsafe = 1
                continue
            }
            break
        }
        p_expect_lbrace(p)?
        body = parse_stmts(p)?
        p_expect_rbrace(p)?
    }
    if @len(type_params) as i64 > 0 {
        val nfn: mut ref Node = make_node(p.arena, NK_GENERIC_FN, line)
        nfn.d0 = public | (is_unsafe << 1) | (is_inline << 2) | (suppress_flag << 3)
        node_store_string_slot(@addr(nfn.d1), ns)
        node_store_string_slot(@addr(nfn.d2), name)
        val pl: list[ref Node] = params
        node_store_slot[list[ref Node]](@addr(nfn.d3), pl)
        node_store_slot[ref Node](@addr(nfn.d4), ret_ty)
        val bl: list[ref Node] = body
        node_store_slot[list[ref Node]](@addr(nfn.d5), bl)
        val tpl: list[ref Node] = type_params
        node_store_slot[list[ref Node]](@addr(nfn.d6), tpl)
        return ok nfn
    }
    val nfn: mut ref Node = make_node(p.arena, NK_FN, line)
    nfn.d0 = public
    node_store_string_slot(@addr(nfn.d1), ns)
    node_store_string_slot(@addr(nfn.d2), name)
    val pl: list[ref Node] = params
    node_store_slot[list[ref Node]](@addr(nfn.d3), pl)
    node_store_slot[ref Node](@addr(nfn.d4), ret_ty)
    val bl: list[ref Node] = body
    node_store_slot[list[ref Node]](@addr(nfn.d5), bl)
    nfn.d6 = (is_unsafe * FN_FLAG_UNSAFE) | (is_inline * FN_FLAG_INLINE) | (suppress_flag * FN_FLAG_SUPPRESS_UNUSED)
    return ok nfn
}

fn parse_type_def_item(
    p: mut ref Parser,
    public: i64,
    is_extern: i64
) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_kind(p, kind_is_type, c"type")?
    val spec_name: mut ref u8 = none
    if lexer.kind_is_lparen(p_peek_kind(p)) {
        p_advance(p)
        val spec_first = p_expect_ident(p)?
        val sb: ref void = builder.StringBuilder.new()
        builder.StringBuilder.append_cstr(sb, spec_first)
        for {
            if !lexer.kind_is_dot(p_peek_kind(p)) {
                break
            }
            p_advance(p)
            val seg = p_expect_ident(p)?
            builder.StringBuilder.append_char(sb, 46 as u8)
            builder.StringBuilder.append_cstr(sb, seg)
        }
        val full_spec: ref void = builder.StringBuilder.build(sb)
        spec_name = p_arena_str(p, ostr.as_cstr(full_spec))
        builder.StringBuilder.free(sb)
        @free(@load(full_spec))
        @free(full_spec)
        p_expect_rparen(p)?
    }
    val name = p_expect_ident(p)?
    p_expect_eq(p)?
    p_expect_lbrace(p)?
    val fields: mut list[ref Node] = mem.new[ref Node]()
    val inv_exprs: mut list[ref Node] = mem.new[ref Node]()
    val has_invariant: mut bool = false
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        if lexer.kind_is_invariant(p_peek_kind(p)) {
            if has_invariant {
                return err p_error(p, c"duplicate invariant block in type definition")
            }
            has_invariant = true
            p_advance(p)
            p_expect_lbrace(p)?
            for {
                if lexer.kind_is_rbrace(p_peek_kind(p)) {
                    break
                }
                val iexpr = parse_expr(p)?
                @append(inv_exprs, iexpr)
            }
            p_expect_rbrace(p)?
            continue
        }
        val fname = p_expect_ident(p)?
        p_expect_colon(p)?
        val fmut: mut i64 = 0
        if p_eat_fn(p, kind_is_mut) {
            fmut = 1
        }
        val fty = parse_type(p)?
        val fnode: mut ref Node = make_node(p.arena, NK_VAL, line)
        node_store_string_slot(@addr(fnode.d0), fname)
        fnode.d1 = fmut
        node_store_slot[ref Node](@addr(fnode.d2), fty)
        @append(fields, fnode)
        p_eat_fn(p, lexer.kind_is_comma)
    }
    p_expect_rbrace(p)?
    val nk: mut i64 = NK_TYPEDEF
    if is_extern == 1 {
        nk = NK_EXTERN_TYPE
    }
    val nt: mut ref Node = make_node(p.arena, nk, line)
    nt.d0 = public
    node_store_string_slot(@addr(nt.d1), name)
    val fl: list[ref Node] = fields
    node_store_slot[list[ref Node]](@addr(nt.d2), fl)
    if has_invariant {
        val il: list[ref Node] = inv_exprs
        node_store_slot[list[ref Node]](@addr(nt.d3), il)
    }
    node_store_string_slot(@addr(nt.d4), spec_name)
    return ok nt
}

fn parse_spec_item(p: mut ref Parser, public: i64) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_kind(p, lexer.kind_is_spec, c"spec")?
    val name = p_expect_ident(p)?
    p_expect_eq(p)?
    p_expect_lbrace(p)?
    val methods: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        val method_suppress_unused: bool = p_suppress_unused(p)
        val method_public: mut i64 = 0
        if p_eat_fn(p, kind_is_pub) {
            method_public = 1
        }
        val method = parse_fn_item(p, method_public, method_suppress_unused)?
        @append(methods, method)
    }
    p_expect_rbrace(p)?
    val ns: mut ref Node = make_node(p.arena, NK_SPEC, line)
    ns.d0 = public
    node_store_string_slot(@addr(ns.d1), name)
    val ml: list[ref Node] = methods
    node_store_slot[list[ref Node]](@addr(ns.d2), ml)
    return ok ns
}

fn parse_enum_def_item(p: mut ref Parser, public: i64) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_kind(p, kind_is_enum, c"enum")?
    val name = p_expect_ident(p)?
    p_expect_eq(p)?
    p_expect_lbrace(p)?
    val variants: mut list[ref u8] = mem.new[ref u8]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        val v = p_expect_ident(p)?
        @append(variants, v)
        // Enum variants may be comma-separated or newline-delimited.
        p_eat_fn(p, lexer.kind_is_comma)
    }
    p_expect_rbrace(p)?
    val ne: mut ref Node = make_node(p.arena, NK_ENUMDEF, line)
    ne.d0 = public
    node_store_string_slot(@addr(ne.d1), name)
    val vl: list[ref u8] = variants
    node_store_slot[list[ref u8]](@addr(ne.d2), vl)
    return ok ne
}

fn parse_union_def_item(p: mut ref Parser, public: i64) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_kind(p, kind_is_union, c"union")?
    val name = p_expect_ident(p)?
    p_expect_eq(p)?
    p_expect_lbrace(p)?

    val is_tagged: bool = kind_is_ident(p_peek_kind(p)) && lexer.kind_is_lparen(p_peek2_kind(p))

    if !is_tagged {
        return err p_error(p, c"untagged unions are not supported, declare variants as Name(type)")
    }

    if is_tagged {
        val variants: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            val vline: i64 = p_line(p)
            val vname = p_expect_ident(p)?
            p_expect_lparen(p)?
            val vtypes: mut list[ref Node] = mem.new[ref Node]()
            for {
                if lexer.kind_is_rparen(p_peek_kind(p)) {
                    break
                }
                val vty = parse_type(p)?
                @append(vtypes, vty)
                if !p_eat_fn(p, lexer.kind_is_comma) {
                    break
                }
            }
            p_expect_rparen(p)?
            val vnode: mut ref Node = make_node(p.arena, NK_VAL, vline)
            node_store_string_slot(@addr(vnode.d0), vname)
            val vtl: list[ref Node] = vtypes
            node_store_slot[list[ref Node]](@addr(vnode.d1), vtl)
            @append(variants, vnode)
            if !p_eat_fn(p, kind_is_bitor) {
                break
            }
        }
        p_expect_rbrace(p)?
        val ntu: mut ref Node = make_node(p.arena, NK_TAGGED_UNIONDEF, line)
        ntu.d0 = public
        node_store_string_slot(@addr(ntu.d1), name)
        val vl: list[ref Node] = variants
        node_store_slot[list[ref Node]](@addr(ntu.d2), vl)
        return ok ntu
    }

    val variants: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rbrace(p_peek_kind(p)) {
            break
        }
        val vty = parse_type(p)?
        @append(variants, vty)
        if !p_eat_fn(p, kind_is_bitor) {
            break
        }
    }
    p_expect_rbrace(p)?
    val nu: mut ref Node = make_node(p.arena, NK_UNIONDEF, line)
    nu.d0 = public
    node_store_string_slot(@addr(nu.d1), name)
    val vl2: list[ref Node] = variants
    node_store_slot[list[ref Node]](@addr(nu.d2), vl2)
    return ok nu
}

fn parse_extern_fn_item(p: mut ref Parser, public: i64) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    p_expect_lparen(p)?
    val conv = p_expect_ident(p)?
    val use_header_decl: mut i64 = 0
    for {
        if lexer.kind_is_rparen(p_peek_kind(p)) {
            break
        }
        p_expect_comma(p)?
        val modifier = p_expect_ident(p)?
        if cstr.eql(modifier, c"header") {
            use_header_decl = 1
        } else {
            return err arenafmt.format(p.arena,
                "{s}:{lld}: unknown extern modifier '{s}'",
                {p.filename, p_line(p), modifier}
            ).ptr
        }
    }
    p_expect_rparen(p)?
    p_expect_kind(p, kind_is_fn, c"fn")?
    val name = p_expect_ident(p)?
    p_expect_lparen(p)?
    val params: mut list[ref Node] = mem.new[ref Node]()
    val is_variadic: mut i64 = 0
    for {
        if lexer.kind_is_rparen(p_peek_kind(p)) {
            break
        }
        if kind_is_dotdotdot(p_peek_kind(p)) {
            p_advance(p)
            is_variadic = 1
            break
        }
        val pname = p_expect_ident(p)?
        p_expect_colon(p)?
        val pty = parse_type(p)?
        val param: mut ref Node = make_node(p.arena, NK_VAL, line)
        node_store_string_slot(@addr(param.d0), pname)
        node_store_slot[ref Node](@addr(param.d1), pty)
        @append(params, param)
        if !p_eat_fn(p, lexer.kind_is_comma) {
            break
        }
    }
    p_expect_rparen(p)?
    val ret_ty = parse_type(p)?
    val is_unsafe: i64 = 0
    p_expect_eq(p)?
    val symbol = p_expect_string(p)?
    val nef: mut ref Node = make_node(p.arena, NK_EXTERN_FN, line)
    nef.d0 = public
    node_store_string_slot(@addr(nef.d1), name)
    node_store_string_slot(@addr(nef.d2), symbol)
    node_store_string_slot(@addr(nef.d3), conv)
    val pl: list[ref Node] = params
    node_store_slot[list[ref Node]](@addr(nef.d4), pl)
    node_store_slot[ref Node](@addr(nef.d5), ret_ty)
    nef.d6 = (is_unsafe * FN_FLAG_UNSAFE) | (is_variadic * EXTERN_FLAG_VARIADIC) | (use_header_decl * EXTERN_FLAG_HEADER)
    return ok nef
}

fn parse_extern_header_item(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val header = p_expect_string(p)?
    val neh: mut ref Node = make_node(p.arena, NK_EXTERN_HEADER, line)
    node_store_string_slot(@addr(neh.d0), header)
    return ok neh
}

fn parse_bulk_val_entry(p: mut ref Parser, public: i64) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val name = p_expect_ident(p)?
    val is_mut: mut i64 = 0
    val ty: mut ref Node = none
    if p_eat_fn(p, lexer.kind_is_colon) {
        if p_eat_fn(p, kind_is_mut) {
            is_mut = 1
        }
        ty = parse_type(p)?
    }
    p_expect_eq(p)?
    if kind_is_use(p_peek_kind(p)) {
        return err p_error(p, c"use directives cannot be grouped in val (...)")
    }
    val expr = parse_expr(p)?
    if is_mut != 0 {
        val nv: mut ref Node = make_node(p.arena, NK_VAL, line)
        node_store_string_slot(@addr(nv.d0), name)
        nv.d1 = 1
        node_store_slot[ref Node](@addr(nv.d2), ty)
        node_store_slot[ref Node](@addr(nv.d3), expr)
        return ok nv
    }
    val nc: mut ref Node = make_node(p.arena, NK_CONST, line)
    nc.d0 = public
    node_store_string_slot(@addr(nc.d1), name)
    node_store_slot[ref Node](@addr(nc.d2), expr)
    node_store_slot[ref Node](@addr(nc.d3), ty)
    return ok nc
}

fn parse_bulk_val(p: mut ref Parser, line: i64, public: i64) result[ref Node, ref u8] = trust {
    p_expect_lparen(p)?
    val entries: mut list[ref Node] = mem.new[ref Node]()
    for {
        if lexer.kind_is_rparen(p_peek_kind(p)) {
            break
        }
        val entry = parse_bulk_val_entry(p, public)?
        @append(entries, entry)
        p_eat_fn(p, lexer.kind_is_comma)
    }
    p_expect_rparen(p)?
    val nb: mut ref Node = make_node(p.arena, NK_VAL_BULK, line)
    val elist: list[ref Node] = entries
    node_store_slot[list[ref Node]](@addr(nb.d0), elist)
    return ok nb
}

fn p_append_item(items: mut list[ref Node], item: ref Node) void = trust {
    if item.kind == NK_VAL_BULK {
        for child in val_bulk_items(item) {
            @append(items, child)
        }
        return
    }
    @append(items, item)
}

pub fn parse_item(p: mut ref Parser) result[ref Node, ref u8] = trust {
    val line: i64 = p_line(p)
    val suppress_unused: bool = p_suppress_unused(p)
    val k: lexer.TokenKind = p_peek_kind(p)

    if kind_is_link(k) {
        p_advance(p)
        val link_arg = p_expect_string(p)?
        val nl: mut ref Node = make_node(p.arena, NK_LINK, line)
        node_store_string_slot(@addr(nl.d0), link_arg)
        return ok nl
    }

    if kind_is_lib(k) {
        p_advance(p)
        val lib_name = p_expect_string(p)?
        val nl: mut ref Node = make_node(p.arena, NK_LIB, line)
        node_store_string_slot(@addr(nl.d0), lib_name)
        return ok nl
    }

    if kind_is_test(k) {
        p_advance(p)
        val tname: mut ref u8 = none
        if kind_is_str(p_peek_kind(p)) {
            tname = p_expect_string(p)?
        }
        p_expect_lbrace(p)?
        val tbody = parse_stmts(p)?
        p_expect_rbrace(p)?
        val nt: mut ref Node = make_node(p.arena, NK_TEST, line)
        val tlist: list[ref Node] = tbody
        node_store_slot[list[ref Node]](@addr(nt.d0), tlist)
        if tname != none {
            node_store_string_slot(@addr(nt.d1), tname)
        }
        return ok nt
    }

    if kind_is_when(k) {
        p_advance(p)
        val plat = parse_when_selector(p)?
        p_expect_lbrace(p)?
        val witems: mut list[ref Node] = mem.new[ref Node]()
        for {
            if lexer.kind_is_rbrace(p_peek_kind(p)) {
                break
            }
            val wi = parse_item(p)?
            p_append_item(witems, wi)
        }
        p_expect_rbrace(p)?
        val or_when_item_branches: mut list[ref Node] = mem.new[ref Node]()
        for {
            val k2: lexer.TokenKind = p_peek_kind(p)
            if !kind_is_ident(k2) {
                break
            }
            val txt: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if !cstr.eql(txt, c"or") {
                break
            }
            val k3: lexer.TokenKind = p_peek2_kind(p)
            if !kind_is_when(k3) {
                break
            }
            p_advance(p)
            p_advance(p)
            val ow_plat = parse_when_selector(p)?
            p_expect_lbrace(p)?
            val ow_items: mut list[ref Node] = mem.new[ref Node]()
            for {
                if lexer.kind_is_rbrace(p_peek_kind(p)) {
                    break
                }
                val owi = parse_item(p)?
                p_append_item(ow_items, owi)
            }
            p_expect_rbrace(p)?
            val ow_node: mut ref Node = make_node(p.arena, NK_WHEN_ITEMS, line)
            node_store_string_slot(@addr(ow_node.d0), ow_plat)
            val ow_il: list[ref Node] = ow_items
            node_store_slot[list[ref Node]](@addr(ow_node.d1), ow_il)
            @append(or_when_item_branches, ow_node)
        }
        val otherwise_items: mut list[ref Node] = mem.new[ref Node]()
        val k4: lexer.TokenKind = p_peek_kind(p)
        if kind_is_ident(k4) {
            val txt2: ref u8 = lexer.tok_text_raw(p.tokens, p.pos)
            if cstr.eql(txt2, c"otherwise") {
                p_advance(p)
                p_expect_lbrace(p)?
                for {
                    if lexer.kind_is_rbrace(p_peek_kind(p)) {
                        break
                    }
                    val owi2 = parse_item(p)?
                    p_append_item(otherwise_items, owi2)
                }
                p_expect_rbrace(p)?
            }
        }
        val nwi: mut ref Node = make_node(p.arena, NK_WHEN_ITEMS, line)
        node_store_string_slot(@addr(nwi.d0), plat)
        val wil: list[ref Node] = witems
        node_store_slot[list[ref Node]](@addr(nwi.d1), wil)
        val owil: list[ref Node] = or_when_item_branches
        node_store_slot[list[ref Node]](@addr(nwi.d2), owil)
        val owsl2: list[ref Node] = otherwise_items
        node_store_slot[list[ref Node]](@addr(nwi.d3), owsl2)
        return ok nwi
    }

    val public: mut i64 = 0
    if p_eat_fn(p, kind_is_pub) {
        public = 1
    }
    val k2: lexer.TokenKind = p_peek_kind(p)

    if kind_is_extern(k2) {
        p_advance(p)
        if kind_is_str(p_peek_kind(p)) {
            return parse_extern_header_item(p)
        }
        if kind_is_type(p_peek_kind(p)) {
            return parse_type_def_item(p, public, 1)
        }
        return parse_extern_fn_item(p, public)
    }
    if lexer.kind_is_spec(k2) {
        return parse_spec_item(p, public)
    }
    if kind_is_fn(k2) {
        return parse_fn_item(p, public, suppress_unused)
    }
    if kind_is_type(k2) {
        return parse_type_def_item(p, public, 0)
    }
    if kind_is_enum(k2) {
        return parse_enum_def_item(p, public)
    }
    if kind_is_union(k2) {
        return parse_union_def_item(p, public)
    }

    if kind_is_val(k2) {
        p_advance(p)
        if lexer.kind_is_lparen(p_peek_kind(p)) {
            return parse_bulk_val(p, line, public)
        }
        val vname = p_expect_ident(p)?
        val vmut: mut i64 = 0
        val vty: mut ref Node = none
        if p_eat_fn(p, lexer.kind_is_colon) {
            if p_eat_fn(p, kind_is_mut) {
                vmut = 1
            }
            vty = parse_type(p)?
        }
        p_expect_eq(p)?
        if kind_is_use(p_peek_kind(p)) {
            p_advance(p)
            p_expect_lparen(p)?
            val path = p_expect_string(p)?
            p_expect_rparen(p)?
            val nu: mut ref Node = make_node(p.arena, NK_USE, line)
            nu.d0 = public
            node_store_string_slot(@addr(nu.d1), vname)
            node_store_string_slot(@addr(nu.d2), path)
            node_store_slot[ref Node](@addr(nu.d3), vty)
            return ok nu
        }
        val vexpr = parse_expr(p)?
        if vmut != 0 {
            val nv: mut ref Node = make_node(p.arena, NK_VAL, line)
            node_store_string_slot(@addr(nv.d0), vname)
            nv.d1 = 1
            node_store_slot[ref Node](@addr(nv.d2), vty)
            node_store_slot[ref Node](@addr(nv.d3), vexpr)
            return ok nv
        }
        val nc: mut ref Node = make_node(p.arena, NK_CONST, line)
        nc.d0 = public
        node_store_string_slot(@addr(nc.d1), vname)
        node_store_slot[ref Node](@addr(nc.d2), vexpr)
        node_store_slot[ref Node](@addr(nc.d3), vty)
        return ok nc
    }

    return err p_error(p, c"unexpected token at top level")
}

pub fn parse_module_with(
    arena: allocators.ScopedArenaAllocator,
    tokens: list[ref lexer.Token],
    filename: ref u8
) result[list[ref Node], ref u8] = trust {
    val p: mut ref Parser = parser_new(arena, tokens, filename)
    val items: mut list[ref Node] = mem.new[ref Node]()
    for {
        if kind_is_eof(p_peek_kind(p)) {
            break
        }
        val item = parse_item(p)?
        p_append_item(items, item)
    }
    return ok items
}

/// Convenience form that owns an AST arena for the returned nodes.
pub fn parse_module(
    tokens: list[ref lexer.Token],
    filename: ref u8
) result[list[ref Node], ref u8] = trust {
    val arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(4194304 as usize)?
    return parse_module_with(arena, tokens, filename)
}

fn parse_src(src: ref u8) result[list[ref Node], ref u8] = {
    val a: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(1048576 as usize)?
    val r = trust lexer.tokenize_with(a, src)
    match r {
        err e => {
            return err e
        }
        ok toks => {
            return trust parse_module_with(a, toks, c"<test>")
        }
    }
}

fn parse_expr_src(src: ref u8) result[ref Node, ref u8] = {
    val a: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(1048576 as usize)?
    val r = trust lexer.tokenize_with(a, src)
    match r {
        err e => {
            return err e
        }
        ok toks => {
            val p: mut ref Parser = trust parser_new(a, toks, c"<test>")
            return trust parse_expr(p)
        }
    }
}

test "parser parses expressions, statements and top-level items" {
    val r1 = parse_expr_src(c"42")
    match r1 {
        err e => {
            trust stdio.print("{s}", {e})
            assert false
        }
        ok n => {
            assert n.kind == NK_INT_LIT
            assert cstr.cmp(int_lit_text_raw(n), c"42") == 0
        }
    }

    val r2 = parse_expr_src(c"3.14")
    match r2 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_FLOAT_LIT
        }
    }

    val r3 = parse_expr_src(c"\"hello\"")
    match r3 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_STR_LIT
            assert cstr.cmp(str_lit_text_raw(n), c"hello") == 0
        }
    }

    val r4t = parse_expr_src(c"true")
    match r4t {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_BOOL
            assert n.d0 == 1
        }
    }
    val r4f = parse_expr_src(c"false")
    match r4f {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_BOOL
            assert n.d0 == 0
        }
    }

    val r5 = parse_expr_src(c"foo")
    match r5 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_IDENT
            assert cstr.cmp(node_str_raw(n.d0), c"foo") == 0
        }
    }

    val r6 = parse_expr_src(c"1 + 2")
    match r6 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_BINOP
            assert binop_op(n) == OP_ADD
            val lhs: ref Node = binop_left(n)
            val rhs: ref Node = binop_right(n)
            assert lhs.kind == NK_INT_LIT
            assert rhs.kind == NK_INT_LIT
        }
    }

    val r7 = parse_expr_src(c"a == b")
    match r7 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_BINOP
            assert binop_op(n) == OP_EQ
        }
    }

    val r8 = parse_expr_src(c"-x")
    match r8 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_UNOP
            assert unop_op(n) == UOP_NEG
        }
    }

    val r9 = parse_expr_src(c"!flag")
    match r9 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_UNOP
            assert unop_op(n) == UOP_NOT
        }
    }

    val r10 = parse_expr_src(c"obj.field")
    match r10 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_FIELD
            val base: ref Node = field_base(n)
            assert base.kind == NK_IDENT
            assert cstr.cmp(field_name_raw(n), c"field") == 0
            val fname_view: str.StringView = field_name(n)
            assert fname_view.len == 5
            assert trust str.eql_cstr(fname_view, c"field")
        }
    }

    val r11 = parse_expr_src(c"foo(1, 2)")
    match r11 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_CALL
        }
    }

    val r12 = parse_expr_src(c"x as i64")
    match r12 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_CAST
        }
    }

    val r13 = parse_expr_src(c"[1, 2, 3]")
    match r13 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_LIST_LIT
        }
    }

    val r14 = parse_expr_src(c"none")
    match r14 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_NONE
        }
    }

    val r15 = parse_src(c"val x = 10")
    match r15 {
        err _ => {
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
            val opt15 = @get(items, 0 as usize)
            match opt15 {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_CONST
                }
            }
        }
    }

    val r16 = parse_src(c"fn add(a: i64, b: i64) i64 = trust { return a + b }")
    match r16 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
            val opt16 = @get(items, 0 as usize)
            match opt16 {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_FN
                    assert item.d0 == 0  // not public
                }
            }
        }
    }

    val r17 = parse_src(c"pub fn greet() void = trust { }")
    match r17 {
        err _ => {
            assert false
        }
        ok items => {
            val opt17 = @get(items, 0 as usize)
            match opt17 {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_FN
                    assert item.d0 == 1  // public
                }
            }
        }
    }

    val r18 = parse_src(c"type Point = { x: i64, y: i64 }")
    match r18 {
        err _ => {
            assert false
        }
        ok items => {
            val opt18 = @get(items, 0 as usize)
            match opt18 {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_TYPEDEF
                }
            }
        }
    }

    val r18b = parse_src(c"type Token = { kind: mut i64 invariant { kind > 0 } }")
    match r18b {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            val opt18b = @get(items, 0 as usize)
            match opt18b {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_TYPEDEF
                    assert item.d3 != 0
                    assert @len(item.d3 as list[ref Node]) as i64 == 1
                }
            }
        }
    }

    val r18c = parse_src(c"type Token = { kind: mut i64 } invariant { kind > 0 }")
    match r18c {
        ok _ => {
            assert false
        }
        err _ => {
            assert true
        }
    }

    val r18d = parse_src(c"pub enum Color = {\n    Red\n    Green\n    Blue\n}")
    match r18d {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            val opt18d = @get(items, 0 as usize)
            match opt18d {
                none => {
                    assert false
                }
                some v => {
                    val item: ref Node = v as ref Node
                    assert item.kind == NK_ENUMDEF
                    assert @len(item.d2 as list[ref u8]) as i64 == 3
                }
            }
        }
    }

    val r19 = parse_expr_src(c"2 + 3 * 4")
    match r19 {
        err _ => {
            assert false
        }
        ok n => {
            assert n.kind == NK_BINOP
            assert binop_op(n) == OP_ADD
            val rhs: ref Node = binop_right(n)
            assert rhs.kind == NK_BINOP
            assert binop_op(rhs) == OP_MUL
        }
    }

    val r20 = parse_src(c"fn (")
    match r20 {
        ok _ => {
            assert false
        }
        err _ => {
            assert true
        }
    }

    val r21 = parse_src(c"fn f() void = { for i = 0, i < 10, i++ { } }")
    match r21 {
        err _ => {
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
        }
    }

    val r22 = parse_src(c"fn f() void = { for i = 0; i < 10; i++ { } }")
    match r22 {
        ok _ => {
            assert false
        }
        err _ => {
            assert true
        }
    }

    val r23 = parse_src(c"fn f(x: i64) void = { if (x & 1) == 0 { } else { } }")
    match r23 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
        }
    }

    val r24 = parse_src(c"val p = Point{x: 10, y: 20}")
    match r24 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
            val item_opt = @get(items, 0 as usize)
            match item_opt {
                none => {
                    assert false
                }
                some item_val => {
                    val item: ref Node = item_val as ref Node
                    assert item.kind == NK_CONST
                    val lit: ref Node = item.d2 as ref Node
                    assert lit.kind == NK_STRUCT_LIT
                    val lit_name: ref u8 = struct_lit_type_name_raw(lit)
                    assert lit_name != none
                    assert cstr.cmp(lit_name, c"Point") == 0
                    assert @len(lit.d0 as list[ref Node]) as i64 == 2
                }
            }
        }
    }

    val r25 = parse_src(c"test \"addition works\" { assert 1 + 1 == 2 }")
    match r25 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 1
            val item_opt = @get(items, 0 as usize)
            match item_opt {
                none => {
                    assert false
                }
                some item_val => {
                    val item: ref Node = item_val as ref Node
                    assert item.kind == NK_TEST
                    val name: ref u8 = test_name_raw(item)
                    assert name != none
                    assert cstr.cmp(name, c"addition works") == 0
                }
            }
        }
    }

    val r26 = parse_src(c"val (\n    a: i32 = 1\n    b: i32 = 2\n)")
    match r26 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 2
            val a_opt = @get(items, 0 as usize)
            val b_opt = @get(items, 1 as usize)
            if a_opt is some a_val {
                val a: ref Node = a_val as ref Node
                assert a.kind == NK_CONST
                assert cstr.cmp(node_str_raw(a.d1), c"a") == 0
            } else {
                assert false
            }
            if b_opt is some b_val {
                val b: ref Node = b_val as ref Node
                assert b.kind == NK_CONST
                assert cstr.cmp(node_str_raw(b.d1), c"b") == 0
            } else {
                assert false
            }
        }
    }

    val r26b = parse_src(c"pub val (\n    a: i32 = 1\n    b: i32 = 2\n)")
    match r26b {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            assert @len(items) as i64 == 2
            val a_opt = @get(items, 0 as usize)
            val b_opt = @get(items, 1 as usize)
            if a_opt is some a_val {
                val a: ref Node = a_val as ref Node
                assert a.kind == NK_CONST
                assert a.d0 == 1
            } else {
                assert false
            }
            if b_opt is some b_val {
                val b: ref Node = b_val as ref Node
                assert b.kind == NK_CONST
                assert b.d0 == 1
            } else {
                assert false
            }
        }
    }

    val r27 = parse_src(c"fn f() void = { val (\n    a: i32 = 1\n) }")
    match r27 {
        ok _ => {
            assert false
        }
        err _ => {
            assert true
        }
    }

    val r28 = parse_src(c"val (\n    stdio = use(\"std/stdio\")\n)")
    match r28 {
        ok _ => {
            assert false
        }
        err _ => {
            assert true
        }
    }

    val r29 = parse_src(c"test { assert true }")
    match r29 {
        err e => {
            trust stdio.print("{s}\n", {e})
            assert false
        }
        ok items => {
            val item_opt = @get(items, 0 as usize)
            match item_opt {
                none => {
                    assert false
                }
                some item_val => {
                    val item: ref Node = item_val as ref Node
                    assert item.kind == NK_TEST
                    assert test_name_raw(item) == none
                }
            }
        }
    }
}
