    NK_INT_LIT: i64                      = 60
    NK_FLOAT_LIT: i64                    = 61
    NK_STR_LIT: i64                      = 62
    NK_IDENT: i64                        = 63
    NK_BOOL: i64                         = 64
    NK_SOME: i64                         = 65
