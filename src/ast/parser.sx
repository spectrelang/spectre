    NK_ARGS_PACK: i64                    = 78
    NK_ZERO_INIT: i64                    = 79
    NK_CAST: i64                         = 80
    NK_ADDR: i64                         = 81
    NK_DEREF: i64                        = 82
    TY_NAMED: i64                        = 100
    TY_REF: i64                          = 101
    TY_MUT: i64                          = 102
    TY_OPTION: i64                       = 103
    TY_LIST: i64                         = 104
    TY_RESULT: i64                       = 105
    TY_SLICE: i64                        = 106
    TY_FIXED_ARR: i64                    = 107
    TY_FNPTR: i64                        = 108
    TY_VOID: i64                         = 109
    TY_ARGSPACK: i64                     = 110
    TY_INFER: i64                        = 111
    OP_ADD: i64                          = 1
    OP_SUB: i64                          = 2
    OP_MUL: i64                          = 3
    OP_DIV: i64                          = 4
    OP_REM: i64                          = 5
    OP_EQ: i64                           = 6
    OP_NE: i64                           = 7
    OP_LT: i64                           = 8
    OP_GT: i64                           = 9
    OP_LE: i64                           = 10
    OP_GE: i64                           = 11
