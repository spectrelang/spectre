val str     = use("std/string")
val ostr    = use("std/string/owned")
val builder = use("std/string/builder")
val ascii   = use("std/ascii")

/// Convert PascalCase, camelCase, and upper-case identifiers to snake_case.
///
/// Acronym runs are treated as a single word, so `SDL_Init` becomes
/// `sdl_init` and `HTMLParser` becomes `html_parser`. Existing underscores
/// are normalized to single separators.
pub fn to_snake(value: str.StringView) str.StringView = trust {
    val sb: ref void = builder.StringBuilder.new()
    val n: i64 = value.len
    val i: mut i64 = 0
    val has_output: mut bool = false
    val prev_underscore: mut bool = true
    val prev_lower_or_digit: mut bool = false
    val prev_upper: mut bool = false
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(value.ptr, i))
        if c == 95 {
            if !prev_underscore && has_output {
                builder.StringBuilder.append_char(sb, 95 as u8)
            }
            prev_underscore = true
            prev_lower_or_digit = false
            prev_upper = false
            i++
            continue
        }
        if ascii.is_upper(c) {
            val next_lower: bool = i + 1 < n && ascii.is_lower(
                @load8(@ptradd(value.ptr, i + 1))
            )
            if !prev_underscore && has_output {
                if prev_lower_or_digit || (prev_upper && next_lower) {
                    builder.StringBuilder.append_char(sb, 95 as u8)
                }
            }
            builder.StringBuilder.append_char(sb, ascii.lower(c))
            has_output = true
            prev_underscore = false
            prev_lower_or_digit = false
            prev_upper = true
            i++
            continue
        }
        builder.StringBuilder.append_char(sb, c)
        has_output = true
        prev_underscore = false
        prev_lower_or_digit = ascii.is_lower(c) || ascii.is_digit(c)
        prev_upper = false
        i++
    }
    val built: ref void = builder.StringBuilder.build(sb)
    builder.StringBuilder.free(sb)
    val owned: str.String = built as str.String
    return str.view(ostr.as_cstr(owned), ostr.len(owned))
}

/// Convert identifiers to PascalCase while keeping acronyms readable.
///
/// `audio_stream` and `AudioStream` both become `AudioStream`, while
/// `SDL_Window` becomes `SdlWindow`.
/// Convert identifiers to SCREAMING_SNAKE_CASE.
pub fn to_screaming_snake(value: str.StringView) str.StringView = trust {
    val already_upper: mut bool = true
    val check_i: mut i64 = 0
    for {
        if check_i >= value.len {
            break
        }
        val check_c: u8 = @load8(@ptradd(value.ptr, check_i))
        if ascii.is_lower(check_c) {
            already_upper = false
            break
        }
        check_i++
    }
    if already_upper {
        return value
    }
    val snake: str.StringView = to_snake(value)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= snake.len {
            break
        }
        val c: u8 = @load8(@ptradd(snake.ptr, i))
        builder.StringBuilder.append_char(sb, ascii.upper(c))
        i++
    }
    val built: ref void = builder.StringBuilder.build(sb)
    builder.StringBuilder.free(sb)
    val owned: str.String = built as str.String
    return str.view(ostr.as_cstr(owned), ostr.len(owned))
}

pub fn to_pascal(value: str.StringView) str.StringView = trust {
    val snake: str.StringView = to_snake(value)
    val sb: ref void = builder.StringBuilder.new()
    val new_word: mut bool = true
    val i: mut i64 = 0
    for {
        if i >= snake.len {
            break
        }
        val c: u8 = @load8(@ptradd(snake.ptr, i))
        if c == 95 {
            new_word = true
            i++
            continue
        }
        if new_word {
            builder.StringBuilder.append_char(sb, ascii.upper(c))
            new_word = false
        } else {
            builder.StringBuilder.append_char(sb, c)
        }
        i++
    }
    val built: ref void = builder.StringBuilder.build(sb)
    builder.StringBuilder.free(sb)
    val owned: str.String = built as str.String
    return str.view(ostr.as_cstr(owned), ostr.len(owned))
}
