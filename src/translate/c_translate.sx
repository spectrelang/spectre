val stdio      = use("std/stdio")
val mem        = use("../meta/mem.sx")
val str        = use("std/string")
val cstr       = use("std/string/cstr")
val ostr       = use("std/string/owned")
val builder    = use("std/string/builder")
val path       = use("std/path")
val os         = use("std/os")
val fs         = use("std/fs")
val allocators = use("std/allocators")
val arenafmt   = use("../meta/arenafmt.sx")
val naming     = use("naming.sx")

val bind_normalize_enabled: mut bool = false
val bind_normalize_sources: mut list[ref u8] = none
val bind_normalize_results: mut list[ref u8] = none
val bind_normalize_type_sources: mut list[ref u8] = none
val bind_normalize_type_results: mut list[ref u8] = none

fn talloc(size: usize) ref void = trust {
    return mem.alloc(size)
}

fn tfmt(format: str.StringView, args: argspack) ref u8 = trust {
    return arenafmt.format(mem.allocator().arena, format, args).ptr
}

fn tsubstr(src: ref u8, start: i64, len: i64) ref u8 = trust {
    val out: ref u8 = talloc((len + 1) as usize) as ref u8
    if out == none {
        return c""
    }
    if len > 0 {
        @memcpy(out, @ptradd(src, start), len as usize)
    }
    @store8(@ptradd(out, len), 0)
    return out
}

fn take_cstr(value: str.String) ref u8 = trust {
    val source: ref u8 = ostr.as_cstr(value)
    val len: i64 = cstr.len(source)
    val out: ref u8 = talloc((len + 1) as usize) as ref u8
    if out != none {
        if len > 0 {
            @memcpy(out, source, len as usize)
        }
        @store8(@ptradd(out, len), 0)
    }
    ostr.free(value)
    return out
}

fn arena_copy_cstr(src: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(src)
    val out: ref u8 = talloc((len + 1) as usize) as ref u8
    if out != none {
        if len > 0 {
            @memcpy(out, src, len as usize)
        }
        @store8(@ptradd(out, len), 0)
    }
    return out
}

fn tdir(p: ref u8) ref u8 = trust {
    val dir: mut ref u8 = path.dir_cstr(p)
    val out = arena_copy_cstr(dir)
    if cstr.cmp(dir, c".") != 0 {
        @free(dir)
    }
    return out
}

fn tjoin(a: ref u8, b: ref u8) ref u8 = trust {
    val joined: mut ref u8 = path.join_cstr(a, b)
    val out = arena_copy_cstr(joined)
    @free(joined)
    return out
}

fn tconcat(a: ref u8, b: ref u8) ref u8 = trust {
    val joined: mut ref u8 = cstr.concat(a, b)
    val out = arena_copy_cstr(joined)
    @free(joined)
    return out
}

pub val (
    STOP_EOF: i64       = 0
    STOP_ELSE: i64      = 1
    STOP_ENDIF: i64     = 2
    STOP_ELIF: i64      = 3
    COND_NONE: i64      = 0
    COND_WIN_TRUE: i64  = 1
    COND_WIN_FALSE: i64 = 2
)

type BlockResult = {
    next_index: mut i64
    stop_kind: mut i64
    stop_line: mut ref u8
}

type DeclInfo = {
    its_ok: mut bool
    name: mut ref u8
    raw_name: mut ref u8
    type_name: mut ref u8
    type_src: mut ref u8
}

type LoweredExpr = {
    expr: mut ref u8
    changed: mut bool
}

type FnPtrInfo = {
    is_ok: mut bool
    name: mut ref u8
    type_name: mut ref u8
}

type SwitchCase = {
    labels: mut list[ref u8]
    body_lines: mut list[ref u8]
    is_default: mut bool
}

type TranslationCtx = {
    defined_names: mut list[ref u8]
    called_names: mut list[ref u8]
    called_sig_names: mut list[ref u8]
    called_sig_params: mut list[ref u8]
    extern_names: mut list[ref u8]
    fnptr_names: mut list[ref u8]
    translated_type_names: mut list[ref u8]
    enum_constant_names: mut list[ref u8]
    enum_constant_types: mut list[ref u8]
    local_names: mut list[ref u8]
    local_types: mut list[ref u8]
    local_array_names: mut list[ref u8]
    local_array_types: mut list[ref u8]
    global_names: mut list[ref u8]
    global_types: mut list[ref u8]
    global_array_names: mut list[ref u8]
    global_array_types: mut list[ref u8]
    mutable_names: mut list[ref u8]
    address_taken_names: mut list[ref u8]
    flex_struct_names: mut list[ref u8]
    flex_field_names: mut list[ref u8]
    flex_field_types: mut list[ref u8]
    typedef_alias_names: mut list[ref u8]
    typedef_alias_types: mut list[ref u8]
    main_prelude_lines: mut list[ref u8]
    bind_macro_names: mut list[ref u8]
    bind_enum_type_names: mut list[ref u8]
    bind_mode: mut bool
    normalize: mut bool
    target_platform: mut ref u8
    target_arch: mut ref u8
    temp_counter: mut i64
    union_counter: mut i64
}

fn make_block_result(next_index: i64, stop_kind: i64, stop_line: ref u8) ref BlockResult = {
    val result: mut ref BlockResult = trust talloc(@sizeof(BlockResult) as usize) as ref BlockResult
    result.next_index = next_index
    result.stop_kind = stop_kind
    result.stop_line = stop_line
    return result
}

fn new_translation_ctx() ref TranslationCtx = {
    val ctx: mut ref TranslationCtx = trust talloc(@sizeof(TranslationCtx) as usize) as ref TranslationCtx
    ctx.defined_names = mem.new[ref u8]()
    ctx.called_names = mem.new[ref u8]()
    ctx.called_sig_names = mem.new[ref u8]()
    ctx.called_sig_params = mem.new[ref u8]()
    ctx.extern_names = mem.new[ref u8]()
    ctx.fnptr_names = mem.new[ref u8]()
    ctx.translated_type_names = mem.new[ref u8]()
    ctx.enum_constant_names = mem.new[ref u8]()
    ctx.enum_constant_types = mem.new[ref u8]()
    ctx.local_names = mem.new[ref u8]()
    ctx.local_types = mem.new[ref u8]()
    ctx.local_array_names = mem.new[ref u8]()
    ctx.local_array_types = mem.new[ref u8]()
    ctx.global_names = mem.new[ref u8]()
    ctx.global_types = mem.new[ref u8]()
    ctx.global_array_names = mem.new[ref u8]()
    ctx.global_array_types = mem.new[ref u8]()
    ctx.mutable_names = mem.new[ref u8]()
    ctx.address_taken_names = mem.new[ref u8]()
    ctx.flex_struct_names = mem.new[ref u8]()
    ctx.flex_field_names = mem.new[ref u8]()
    ctx.flex_field_types = mem.new[ref u8]()
    ctx.typedef_alias_names = mem.new[ref u8]()
    ctx.typedef_alias_types = mem.new[ref u8]()
    ctx.main_prelude_lines = mem.new[ref u8]()
    ctx.bind_macro_names = mem.new[ref u8]()
    ctx.bind_enum_type_names = mem.new[ref u8]()
    ctx.bind_mode = false
    ctx.normalize = false
    ctx.target_platform = c""
    ctx.target_arch = c""
    ctx.temp_counter = 0
    ctx.union_counter = 0
    return ctx
}

fn make_lowered_expr(expr: ref u8, changed: bool) ref LoweredExpr = {
    val lowered: mut ref LoweredExpr = trust talloc(@sizeof(LoweredExpr) as usize) as ref LoweredExpr
    lowered.expr = expr
    lowered.changed = changed
    return lowered
}

fn make_switch_case() ref SwitchCase = {
    val item: mut ref SwitchCase = trust talloc(@sizeof(SwitchCase) as usize) as ref SwitchCase
    item.labels = mem.new[ref u8]()
    item.body_lines = mem.new[ref u8]()
    item.is_default = false
    return item
}

fn is_space(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn is_ident_start(c: u8) bool = {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_part(c: u8) bool = {
    return is_ident_start(c) || (c >= 48 && c <= 57)
}

fn reset_bind_normalization(enabled: bool) void = trust {
    bind_normalize_enabled = enabled
    bind_normalize_sources = mem.new[ref u8]()
    bind_normalize_results = mem.new[ref u8]()
    bind_normalize_type_sources = mem.new[ref u8]()
    bind_normalize_type_results = mem.new[ref u8]()
}

fn view_to_cstr(value: str.StringView) ref u8 = trust {
    val out: ref u8 = talloc((value.len + 1) as usize) as ref u8
    if out == none {
        return c""
    }
    if value.len > 0 {
        @memcpy(out, value.ptr, value.len as usize)
    }
    @store8(@ptradd(out, value.len), 0)
    return out
}

fn bind_normalize_with(
    name: ref u8,
    sources: mut list[ref u8],
    results: mut list[ref u8]
) ref u8 = trust {
    val nlen: i64 = @len(sources) as i64
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        val source_opt = @get(sources, i as usize)
        val result_opt = @get(results, i as usize)
        if source_opt is some source {
            if cstr.cmp(source as ref u8, name) == 0 {
                if result_opt is some result {
                    return result as ref u8
                }
            }
        }
        i++
    }
    val snake: str.StringView = naming.to_snake(str.from_cstr(name))
    val base: ref u8 = view_to_cstr(snake)
    val candidate: mut ref u8 = base
    val suffix: mut i64 = 2
    for {
        if !list_contains(results, candidate) {
            break
        }
        candidate = tfmt("{s}_{lld}", {base, suffix})
        suffix++
    }
    @append(sources, name)
    @append(results, candidate)
    return candidate
}

fn bind_normalize_identifier(name: ref u8) ref u8 = trust {
    return bind_normalize_with(
        name,
        bind_normalize_sources,
        bind_normalize_results
    )
}

fn bind_normalize_type_identifier(name: ref u8) ref u8 = trust {
    return bind_normalize_with(
        name,
        bind_normalize_type_sources,
        bind_normalize_type_results
    )
}

fn sanitize_type_identifier(name: ref u8) ref u8 = {
    if bind_normalize_enabled {
        return trust bind_normalize_type_identifier(name)
    }
    return sanitize_identifier(name)
}

fn sanitize_identifier(name: ref u8) ref u8 = {
    if cstr.cmp(name, c"fn") == 0 {
        return c"func"
    }
    if cstr.cmp(name, c"val") == 0 {
        return c"value"
    }
    if cstr.cmp(name, c"mut") == 0 {
        return c"mutable"
    }
    if cstr.cmp(name, c"pub") == 0 {
        return c"public"
    }
    if cstr.cmp(name, c"type") == 0 {
        return c"type_value"
    }
    if cstr.cmp(name, c"pre") == 0 {
        return c"precond"
    }
    if cstr.cmp(name, c"post") == 0 {
        return c"postcond"
    }
    if cstr.cmp(name, c"returnc") == 0 {
        return c"return_value"
    }
    if cstr.cmp(name, c"if") == 0 {
        return c"if_value"
    }
    if cstr.cmp(name, c"else") == 0 {
        return c"else_value"
    }
    if cstr.cmp(name, c"elif") == 0 {
        return c"elif_value"
    }
    if cstr.cmp(name, c"trust") == 0 {
        return c"trusted_value"
    }
    if cstr.cmp(name, c"use") == 0 {
        return c"used_value"
    }
    if cstr.cmp(name, c"ref") == 0 {
        return c"reference"
    }
    if cstr.cmp(name, c"for") == 0 {
        return c"loop_value"
    }
    if cstr.cmp(name, c"in") == 0 {
        return c"in_value"
    }
    if cstr.cmp(name, c"some") == 0 {
        return c"some_value"
    }
    if cstr.cmp(name, c"none") == 0 {
        return c"none_value"
    }
    if cstr.cmp(name, c"ok") == 0 {
        return c"ok_value"
    }
    if cstr.cmp(name, c"err") == 0 {
        return c"error_value"
    }
    if cstr.cmp(name, c"match") == 0 {
        return c"match_value"
    }
    if cstr.cmp(name, c"true") == 0 {
        return c"true_value"
    }
    if cstr.cmp(name, c"false") == 0 {
        return c"false_value"
    }
    if cstr.cmp(name, c"defer") == 0 {
        return c"deferred_value"
    }
    if cstr.cmp(name, c"break") == 0 {
        return c"break_value"
    }
    if cstr.cmp(name, c"continue") == 0 {
        return c"continue_value"
    }
    if cstr.cmp(name, c"as") == 0 {
        return c"as_value"
    }
    if cstr.cmp(name, c"assert") == 0 {
        return c"assert_value"
    }
    if cstr.cmp(name, c"when") == 0 {
        return c"when_value"
    }
    if cstr.cmp(name, c"union") == 0 {
        return c"union_value"
    }
    if cstr.cmp(name, c"enum") == 0 {
        return c"enum_value"
    }
    if cstr.cmp(name, c"extern") == 0 {
        return c"external_value"
    }
    if cstr.cmp(name, c"link") == 0 {
        return c"link_value"
    }
    if cstr.cmp(name, c"lib") == 0 {
        return c"lib_value"
    }
    if cstr.cmp(name, c"guarded") == 0 {
        return c"guarded_value"
    }
    if cstr.cmp(name, c"not") == 0 {
        return c"not_value"
    }
    if cstr.cmp(name, c"test") == 0 {
        return c"test_value"
    }
    if cstr.cmp(name, c"guard") == 0 {
        return c"guard_value"
    }
    if cstr.cmp(name, c"invariant") == 0 {
        return c"invariant_value"
    }
    if bind_normalize_enabled {
        return trust bind_normalize_identifier(name)
    }
    return name
}

fn str_contains(haystack: ref u8, needle: ref u8) bool = {
    val hlen: i64 = cstr.len(haystack)
    val nlen: i64 = cstr.len(needle)
    if nlen == 0 {
        return true
    }
    if nlen > hlen {
        return false
    }
    val i: mut i64 = 0
    for {
        if i > hlen - nlen {
            break
        }
        val matched: mut bool = true
        val j: mut i64 = 0
        for {
            if j >= nlen {
                break
            }
            val a: u8 = trust @load8(@ptradd(haystack, i + j)) as u8
            val b: u8 = trust @load8(@ptradd(needle, j)) as u8
            if a != b {
                matched = false
                break
            }
            j++
        }
        if matched {
            return true
        }
        i++
    }
    return false
}

fn find_char(text: ref u8, target: u8) i64 = {
    val len: i64 = cstr.len(text)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == target {
            return i
        }
        i++
    }
    return -1
}

fn find_last_char(text: ref u8, target: u8) i64 = {
    val len: i64 = cstr.len(text)
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == target {
            return i
        }
        i--
    }
    return -1
}

fn trim_cstr(text: ref u8) ref u8 = {
    val len: i64 = cstr.len(text)
    if len == 0 {
        return c""
    }
    val start: mut i64 = 0
    for {
        if start >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, start)) as u8
        if !is_space(c) {
            break
        }
        start++
    }
    val end: mut i64 = len - 1
    for {
        if end < start {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, end)) as u8
        if !is_space(c) {
            break
        }
        end--
    }
    if end < start {
        return c""
    }
    return trust tsubstr(text, start, end - start + 1)
}

fn flatten_ws(text: ref u8) ref u8 = {
    val sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(text)
    val last_space: mut bool = true
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if is_space(c) {
            if !last_space {
                trust builder.StringBuilder.append_char(sb, 32 as u8)
                last_space = true
            }
        } else {
            trust builder.StringBuilder.append_char(sb, c)
            last_space = false
        }
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust trim_cstr(take_cstr(built))
}

fn starts_keyword_paren(text: ref u8, keyword: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val kw_len: i64 = cstr.len(keyword)
    val len: i64 = cstr.len(trimmed)
    if len <= kw_len {
        return false
    }
    if !cstr.starts_with(trimmed, keyword) {
        return false
    }
    val i: mut i64 = kw_len
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if !is_space(c) {
            break
        }
        i++
    }
    if i >= len {
        return false
    }
    return (trust @load8(@ptradd(trimmed, i)) as u8) == 40
}

fn starts_do_statement(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    if !cstr.starts_with(trimmed, c"do") {
        return false
    }
    val len: i64 = cstr.len(trimmed)
    if len == 2 {
        return true
    }
    val next: u8 = trust @load8(@ptradd(trimmed, 2)) as u8
    return is_space(next) || next == 123
}

fn split_lines(text: ref u8) list[ref u8] = {
    val lines: mut list[ref u8] = mem.new[ref u8]()
    val len: i64 = cstr.len(text)
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        val at_end: bool = i == len
        val c: mut u8 = 0
        if !at_end {
            c = trust @load8(@ptradd(text, i)) as u8
        }
        if at_end || c == 10 {
            val line_len: i64 = i - start
            val trimmed_len: mut i64 = line_len
            if trimmed_len > 0 {
                val last: u8 = trust @load8(@ptradd(text, start + trimmed_len - 1)) as u8
                if last == 13 {
                    trimmed_len--
                }
            }
            @append(lines, trust tsubstr(text, start, trimmed_len))
            start = i + 1
        }
        i++
    }
    return lines
}

fn join_lines(lines: list[ref u8], start: i64, end_exclusive: i64) ref u8 = {
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = start
    for {
        if i >= end_exclusive {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            trust builder.StringBuilder.append_cstr(sb, line_val as ref u8)
            if i + 1 < end_exclusive {
                trust builder.StringBuilder.append_char(sb, 10 as u8)
            }
        }
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn push_indent(sb: ref void, indent: i64) void = {
    val i: mut i64 = 0
    for {
        if i >= indent {
            break
        }
        trust builder.StringBuilder.append_cstr(sb, c"    ")
        i++
    }
}

fn append_line(sb: ref void, indent: i64, line: ref u8) void = {
    push_indent(sb, indent)
    trust builder.StringBuilder.append_cstr(sb, line)
    trust builder.StringBuilder.append_char(sb, 10 as u8)
}

fn append_blank_line(sb: ref void) void = {
    trust builder.StringBuilder.append_char(sb, 10 as u8)
}

fn append_comment_line(sb: ref void, indent: i64, line: ref u8) void = {
    val trimmed: ref u8 = trim_cstr(line)
    if cstr.cmp(trimmed, c"") == 0 {
        append_blank_line(sb)
        return
    }
    push_indent(sb, indent)
    trust builder.StringBuilder.append_cstr(sb, c"// ")
    trust builder.StringBuilder.append_cstr(sb, trimmed)
    trust builder.StringBuilder.append_char(sb, 10 as u8)
}

fn list_contains(items: list[ref u8], value: ref u8) bool = {
    for item in items {
        if cstr.cmp(item, value) == 0 {
            return true
        }
    }
    return false
}

fn push_unique(items: mut list[ref u8], value: ref u8) void = {
    if list_contains(items, value) {
        return
    }
    @append(items, value)
}

fn clear_local_types(ctx: mut ref TranslationCtx) void = {
    ctx.local_names = mem.new[ref u8]()
    ctx.local_types = mem.new[ref u8]()
    ctx.local_array_names = mem.new[ref u8]()
    ctx.local_array_types = mem.new[ref u8]()
    ctx.mutable_names = mem.new[ref u8]()
    ctx.address_taken_names = mem.new[ref u8]()
    ctx.temp_counter = 0
}

fn register_typedef_alias(
    ctx: mut ref TranslationCtx,
    alias_name: ref u8,
    spectre_type: ref u8
) void = {
    val len: i64 = @len(ctx.typedef_alias_names) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val existing_opt = @get(ctx.typedef_alias_names, i as usize)
        if existing_opt is some existing_name {
            if cstr.cmp(existing_name as ref u8, alias_name) == 0 {
                @set(ctx.typedef_alias_types, i as usize, spectre_type)
                return
            }
        }
        i++
    }
    @append(ctx.typedef_alias_names, alias_name)
    @append(ctx.typedef_alias_types, spectre_type)
    push_unique(ctx.translated_type_names, alias_name)
}

fn lookup_typedef_alias(ctx: ref TranslationCtx, alias_name: ref u8) option[ref u8] = {
    val normalized: ref u8 = sanitize_identifier(alias_name)
    val normalized_type: ref u8 = sanitize_type_identifier(alias_name)
    val len: i64 = @len(ctx.typedef_alias_names) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val name_opt = @get(ctx.typedef_alias_names, i as usize)
        if name_opt is some name_val {
            if cstr.cmp(name_val as ref u8, alias_name) == 0
            || cstr.cmp(name_val as ref u8, normalized) == 0
            || cstr.cmp(name_val as ref u8, normalized_type) == 0 {
                val type_opt = @get(ctx.typedef_alias_types, i as usize)
                if type_opt is some type_val {
                    return some type_val as ref u8
                }
            }
        }
        i++
    }
    return none
}

