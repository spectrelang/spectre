fn mark_mutable_name(ctx: mut ref TranslationCtx, name: ref u8) void = {
    if cstr.cmp(name, c"") == 0 {
        return
    }
    push_unique(ctx.mutable_names, name)
}

fn mark_address_taken_name(ctx: mut ref TranslationCtx, name: ref u8) void = {
    if cstr.cmp(name, c"") == 0 {
        return
    }
    push_unique(ctx.address_taken_names, name)
}

fn is_mutable_name(ctx: ref TranslationCtx, name: ref u8) bool = {
    return list_contains(ctx.mutable_names, name)
}

fn is_address_taken_name(ctx: ref TranslationCtx, name: ref u8) bool = {
    return list_contains(ctx.address_taken_names, name)
}

fn render_binding_type(ctx: ref TranslationCtx, name: ref u8, type_name: ref u8) ref u8 = {
    return render_parameter_type(ctx, name, type_name)
}

fn render_parameter_type(ctx: ref TranslationCtx, name: ref u8, type_name: ref u8) ref u8 = {
    if !is_mutable_name(ctx, name) {
        return type_name
    }
    if cstr.starts_with(type_name, c"mut ") {
        return type_name
    }
    return trust tfmt("mut {s}", {type_name})
}

fn render_mutable_type(type_name: ref u8) ref u8 = {
    if cstr.starts_with(type_name, c"mut ") {
        return type_name
    }
    return trust tfmt("mut {s}", {type_name})
}

fn append_main_prelude_line(ctx: ref TranslationCtx, line: ref u8) void = {
    @append(ctx.main_prelude_lines, line)
}

fn append_main_prelude_builder(ctx: ref TranslationCtx, sb: ref void) void = {
    val built: ref void = trust builder.StringBuilder.build(sb)
    val lines = trust split_lines(take_cstr(built))
    for line in lines {
        val trimmed: ref u8 = trim_cstr(line)
        if cstr.cmp(trimmed, c"") == 0 {
            continue
        }
        append_main_prelude_line(ctx, trimmed)
    }
}

fn is_array_type_name(type_name: ref u8) bool = {
    return cstr.starts_with(type_name, c"[")
}

fn array_type_close_index(type_name: ref u8) i64 = {
    return find_char(type_name, 93 as u8)
}

fn array_type_len_expr(type_name: ref u8) ref u8 = {
    val close_i: i64 = array_type_close_index(type_name)
    if close_i <= 1 {
        return c""
    }
    return trust tsubstr(type_name, 1, close_i - 1)
}

fn array_type_elem(type_name: ref u8) ref u8 = {
    val close_i: i64 = array_type_close_index(type_name)
    val len: i64 = cstr.len(type_name)
    if close_i < 0 || close_i + 1 >= len {
        return c"void"
    }
    return trust tsubstr(type_name, close_i + 1, len - close_i - 1)
}

fn decay_array_type(type_name: ref u8) ref u8 = {
    return trust tfmt("ref {s}", {array_type_elem(type_name)})
}

fn array_alloc_expr(type_name: ref u8) ref u8 = {
    val len_expr: ref u8 = array_type_len_expr(type_name)
    val elem_type: ref u8 = array_type_elem(type_name)
    return trust tfmt("{s} * @sizeof({s})", {len_expr, elem_type})
}

fn is_string_literal_text(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 2 {
        return false
    }
    val first: u8 = trust @load8(trimmed) as u8
    val last: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    return first == 34 && last == 34
}

fn is_unsized_char_array(type_name: ref u8) bool = {
    return cstr.cmp(array_type_len_expr(type_name), c"") == 0
    && cstr.cmp(array_type_elem(type_name), c"u8") == 0
}

fn string_literal_storage_len(text: ref u8) i64 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 2 {
        return 0
    }
    val i: mut i64 = 1
    val count: mut i64 = 0
    for {
        if i >= len - 1 {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 92 && i + 1 < len - 1 {
            val esc: u8 = trust @load8(@ptradd(trimmed, i + 1)) as u8
            if esc == 120 || esc == 88 {
                i += 2
                for {
                    if i >= len - 1 {
                        break
                    }
                    val hc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    val is_hex: bool = (hc >= 48 && hc <= 57) || (hc >= 65 && hc <= 70) || (hc >= 97 && hc <= 102)
                    if !is_hex {
                        break
                    }
                    i++
                }
            } elif esc >= 48 && esc <= 55 {
                i += 2
                val oct_count: mut i64 = 1
                for {
                    if i >= len - 1 || oct_count >= 3 {
                        break
                    }
                    val oc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    if !(oc >= 48 && oc <= 55) {
                        break
                    }
                    i++
                    oct_count++
                }
            } else {
                i += 2
            }
            count++
            continue
        }
        count++
        i++
    }
    return count + 1
}

fn is_brace_initializer_text(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 2 {
        return false
    }
    val first: u8 = trust @load8(trimmed) as u8
    val last: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    return first == 123 && last == 125
}

fn parse_brace_initializer_items(text: ref u8) list[ref u8] = {
    val trimmed: ref u8 = trim_cstr(text)
    if !is_brace_initializer_text(trimmed) {
        return mem.new[ref u8]()
    }
    val inner: ref u8 = trim_cstr(trust tsubstr(trimmed, 1, cstr.len(trimmed) - 2))
    if cstr.cmp(inner, c"") == 0 {
        return mem.new[ref u8]()
    }
    val raw_items = split_top_level(inner, 44 as u8)
    val items: mut list[ref u8] = mem.new[ref u8]()
    for raw_item in raw_items {
        val item: ref u8 = trim_cstr(raw_item)
        if cstr.cmp(item, c"") == 0 {
            continue
        }
        @append(items, item)
    }
    return items
}

fn emit_array_initializer_stores(
    ctx: mut ref TranslationCtx,
    out: ref void,
    indent: i64,
    name: ref u8,
    items: list[ref u8]
) void = {
    val init_len: i64 = @len(items) as i64
    val init_i: mut i64 = 0
    for {
        if init_i >= init_len {
            break
        }
        val item_opt = @get(items, init_i as usize)
        if item_opt is some item_val {
            val lowered_item: ref LoweredExpr = lower_incdec_expr(
                ctx,
                item_val as ref u8,
                indent,
                out
            )
            val item_expr: ref u8 = lowered_item.expr
            val item_ptr: ref u8 = render_index_ptr_expr(
                ctx,
                name,
                trust tfmt("{d}", {init_i})
            )
            track_called_expr(ctx, item_expr)
            append_line(out, indent, trust tfmt("@store({s}, {s})", {item_ptr, item_expr}))
        }
        init_i++
    }
}

fn zero_init_expr(type_name: ref u8) ref u8 = {
    if cstr.cmp(type_name, c"f32") == 0 || cstr.cmp(type_name, c"f64") == 0 {
        return c"0.0"
    }
    if cstr.cmp(type_name, c"bool") == 0 {
        return c"false"
    }
    if cstr.starts_with(type_name, c"ref ")
    || cstr.starts_with(type_name, c"mut ref ") {
        return c"none"
    }
    return trust tfmt("0 as {s}", {type_name})
}

fn extract_assignment_base(lhs: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(lhs)
    if cstr.cmp(trimmed, c"") == 0 {
        return c""
    }
    val lhs_arrow: ref u8 = replace_arrow_access(trimmed)
    val dot_i: i64 = find_char(lhs_arrow, 46 as u8)
    if dot_i > 0 {
        val base: ref u8 = trim_cstr(trust tsubstr(lhs_arrow, 0, dot_i))
        if is_ident_text(base) {
            return rewrite_identifiers(base)
        }
        return c""
    }
    if str_contains(lhs_arrow, c"[") {
        return c""
    }
    if is_ident_text(trimmed) {
        return rewrite_identifiers(trimmed)
    }
    return c""
}

fn find_top_level_else(text: ref u8) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif paren == 0 && brace == 0 && bracket == 0 && i + 4 <= len {
            val frag: ref u8 = trust tsubstr(text, i, 4)
            if cstr.cmp(frag, c"else") == 0 {
                val prev_ok: bool = i == 0 || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i - 1
                        )) as u8)
                val next_ok: bool = i + 4 >= len || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i + 4
                        )) as u8)
                if prev_ok && next_ok {
                    return i
                }
            }
        }
        i++
    }
    return -1
}

fn write_follows_operand(text: ref u8, start: i64) bool = {
    val len: i64 = cstr.len(text)
    val k: mut i64 = start
    for {
        if k >= len {
            break
        }
        val ws: u8 = trust @load8(@ptradd(text, k)) as u8
        if !is_space(ws) {
            break
        }
        k++
    }
    if k >= len {
        return false
    }
    val c: u8 = trust @load8(@ptradd(text, k)) as u8
    val next: mut u8 = 0
    if k + 1 < len {
        next = trust @load8(@ptradd(text, k + 1)) as u8
    }
    if c == 61 && next != 61 {
        return true
    }
    if (c == 43 && next == 43) || (c == 45 && next == 45) {
        return true
    }
    if next == 61
    && (c == 43 || c == 45 || c == 42 || c == 47 || c == 37
        || c == 38 || c == 124 || c == 94) {
        return true
    }
    return false
}

fn incdec_precedes(text: ref u8, start: i64) bool = {
    val len: i64 = cstr.len(text)
    val k: mut i64 = start - 1
    for {
        if k < 0 {
            break
        }
        val ws: u8 = trust @load8(@ptradd(text, k)) as u8
        if !is_space(ws) {
            break
        }
        k--
    }
    if k < 1 || k >= len {
        return false
    }
    val c1: u8 = trust @load8(@ptradd(text, k)) as u8
    val c0: u8 = trust @load8(@ptradd(text, k - 1)) as u8
    return (c0 == 43 && c1 == 43) || (c0 == 45 && c1 == 45)
}

fn analyze_deref_writes(ctx: mut ref TranslationCtx, text: ref u8) void = {
    val stripped: ref u8 = strip_trailing_semicolon(trim_cstr(text))
    val len: i64 = cstr.len(stripped)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(stripped, i)) as u8
        if c == 42 && is_unary_deref_context(stripped, i) {
            val j: mut i64 = i + 1
            for {
                if j >= len {
                    break
                }
                val ws: u8 = trust @load8(@ptradd(stripped, j)) as u8
                if !is_space(ws) {
                    break
                }
                j++
            }
            if j < len {
                val operand_end: i64 = scan_deref_operand_end(stripped, j)
                if operand_end > j {
                    val after_start: mut i64 = operand_end
                    if after_start < len
                    && (trust @load8(@ptradd(stripped, after_start)) as u8) == 41 {
                        after_start++
                    }
                    if write_follows_operand(stripped, after_start)
                    || incdec_precedes(stripped, i) {
                        val operand: ref u8 = trim_cstr(trust tsubstr(
                                stripped,
                                j,
                                operand_end - j
                            ))
                        val target: ref u8 = trim_cstr(unwrap_outer_parens(operand))
                        if is_ident_text(target) {
                            mark_mutable_name(ctx, rewrite_identifiers(target))
                        }
                    }
                    i = operand_end
                    continue
                }
            }
        }
        i++
    }
}

fn analyze_mutations_in_statement(ctx: mut ref TranslationCtx, line: ref u8) void = {
    val stripped: ref u8 = strip_trailing_semicolon(trim_cstr(line))
    if cstr.cmp(stripped, c"") == 0 {
        return
    }
    analyze_deref_writes(ctx, stripped)
    if cstr.starts_with(stripped, c"else") {
        val tail: ref u8 = trim_cstr(trust tsubstr(stripped, 4, cstr.len(stripped) - 4))
        if cstr.cmp(tail, c"") != 0 {
            analyze_mutations_in_statement(ctx, tail)
        }
        return
    }
    if starts_keyword_paren(stripped, c"if") {
        val open_i: i64 = find_char(stripped, 40 as u8)
        val close_i: i64 = find_matching_delim(stripped, open_i, 40 as u8, 41 as u8)
        if open_i >= 0 && close_i > open_i {
            val tail: ref u8 = trim_cstr(trust tsubstr(
                    stripped,
                    close_i + 1,
                    cstr.len(stripped) - close_i - 1
                ))
            if cstr.cmp(tail, c"") != 0 {
                val else_i: i64 = find_top_level_else(tail)
                if else_i >= 0 {
                    val then_text: ref u8 = trim_cstr(trust tsubstr(tail, 0, else_i))
                    val else_text: ref u8 = trim_cstr(trust tsubstr(
                            tail,
                            else_i + 4,
                            cstr.len(tail) - else_i - 4
                        ))
                    if cstr.cmp(then_text, c"") != 0 {
                        analyze_mutations_in_statement(ctx, then_text)
                    }
                    if cstr.cmp(else_text, c"") != 0 {
                        analyze_mutations_in_statement(ctx, else_text)
                    }
                    return
                }
                analyze_mutations_in_statement(ctx, tail)
                return
            }
        }
    }
    val compound_i: i64 = find_top_level_compound_assign(stripped)
    if compound_i > 0 {
        mark_mutable_name(
            ctx,
            extract_assignment_base(trust tsubstr(stripped, 0, compound_i))
        )
    }
    val assign_i: i64 = find_top_level_assign(stripped)
    if assign_i > 0 {
        val lhs: ref u8 = trim_cstr(trust tsubstr(stripped, 0, assign_i))
        val can_be_decl: bool = str_contains(lhs, c" ") || str_contains(lhs, c"*")
        || cstr.starts_with(lhs, c"struct ") || cstr.starts_with(lhs, c"enum ")
        if !can_be_decl {
            mark_mutable_name(ctx, extract_assignment_base(lhs))
        }
    }
    val len: i64 = cstr.len(stripped)
    val i: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(stripped, i)) as u8
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if is_ident_start(c) {
            val start_i: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(stripped, i)) as u8
                if !is_ident_part(cc) {
                    break
                }
                i++
            }
            val ident: ref u8 = trust tsubstr(stripped, start_i, i - start_i)
            val j: mut i64 = i
            for {
                if j >= len {
                    break
                }
                val ws: u8 = trust @load8(@ptradd(stripped, j)) as u8
                if !is_space(ws) {
                    break
                }
                j++
            }
            if j + 1 < len {
                val c1: u8 = trust @load8(@ptradd(stripped, j)) as u8
                val c2: u8 = trust @load8(@ptradd(stripped, j + 1)) as u8
                if ((c1 == 43 && c2 == 43) || (c1 == 45 && c2 == 45)) {
                    mark_mutable_name(ctx, rewrite_identifiers(ident))
                }
            }
            continue
        }
        if i + 1 < len && ((c == 43 && (trust @load8(@ptradd(stripped, i + 1)) as u8) == 43)
            || (c == 45 && (trust @load8(@ptradd(stripped, i + 1)) as u8) == 45)) {
            val j: mut i64 = i + 2
            for {
                if j >= len {
                    break
                }
                val ws: u8 = trust @load8(@ptradd(stripped, j)) as u8
                if !is_space(ws) {
                    break
                }
                j++
            }
            if j < len {
                val first: u8 = trust @load8(@ptradd(stripped, j)) as u8
                if is_ident_start(first) {
                    val start_i2: i64 = j
                    j++
                    for {
                        if j >= len {
                            break
                        }
                        val cc2: u8 = trust @load8(@ptradd(stripped, j)) as u8
                        if !is_ident_part(cc2) {
                            break
                        }
                        j++
                    }
                    val ident2: ref u8 = trust tsubstr(stripped, start_i2, j - start_i2)
                    mark_mutable_name(ctx, rewrite_identifiers(ident2))
                    i = j
                    continue
                }
            }
        }
        if c == 123 {
            val close_i: i64 = find_matching_delim(stripped, i, 123 as u8, 125 as u8)
            if close_i > i {
                val inner: ref u8 = trust tsubstr(stripped, i + 1, close_i - i - 1)
                val statements = split_top_level(inner, 59 as u8)
                for stmt in statements {
                    analyze_mutations_in_statement(ctx, stmt)
                }
                i = close_i + 1
                continue
            }
        }
        i++
    }
}

fn emit_incdec_stmt(raw_name: ref u8, op: ref u8, indent: i64, out: ref void) void = {
    val name: ref u8 = rewrite_identifiers(raw_name)
    append_line(out, indent, trust tfmt("{s}{s}{s}", {name, op, op}))
}

fn fresh_union_name(ctx: mut ref TranslationCtx) ref u8 = {
    val union_name: ref u8 = trust tfmt("union{d}", {ctx.union_counter})
    ctx.union_counter++
    return union_name
}

fn normalize_simple_incdec_stmt(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 3 {
        return c""
    }
    val first: u8 = trust @load8(@ptradd(trimmed, 0)) as u8
    val second: u8 = trust @load8(@ptradd(trimmed, 1)) as u8
    if ((first == 43 && second == 43) || (first == 45 && second == 45)) {
        val ident: ref u8 = trim_cstr(trust tsubstr(trimmed, 2, len - 2))
        if is_ident_text(ident) {
            val op: mut ref u8 = c"+"
            if first == 45 {
                op = c"-"
            }
            return trust tfmt("{s}{s}{s}", {rewrite_identifiers(ident), op, op})
        }
    }
    val last2: u8 = trust @load8(@ptradd(trimmed, len - 2)) as u8
    val last1: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    if ((last2 == 43 && last1 == 43) || (last2 == 45 && last1 == 45)) {
        val ident2: ref u8 = trim_cstr(trust tsubstr(trimmed, 0, len - 2))
        if is_ident_text(ident2) {
            val op2: mut ref u8 = c"+"
            if last2 == 45 {
                op2 = c"-"
            }
            return trust tfmt("{s}{s}{s}", {rewrite_identifiers(ident2), op2, op2})
        }
    }
    return c""
}

fn normalize_deref_incdec_stmt(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 6 {
        return c""
    }
    val first: u8 = trust @load8(trimmed) as u8
    if first == 40 {
        val close_i: i64 = find_matching_delim(trimmed, 0, 40 as u8, 41 as u8)
        if close_i > 0 {
            val inner: ref u8 = trim_cstr(trust tsubstr(trimmed, 1, close_i - 1))
            val tail: ref u8 = trim_cstr(trust tsubstr(
                    trimmed,
                    close_i + 1,
                    len - close_i - 1
                ))
            if cstr.starts_with(inner, c"*")
            && (cstr.cmp(tail, c"++") == 0 || cstr.cmp(tail, c"--") == 0) {
                val target: ref u8 = trim_cstr(unwrap_outer_parens(trim_cstr(trust tsubstr(
                                inner,
                                1,
                                cstr.len(inner) - 1
                            ))))
                if is_ident_text(target) {
                    val op: mut ref u8 = c"+"
                    if cstr.cmp(tail, c"--") == 0 {
                        op = c"-"
                    }
                    val name: ref u8 = rewrite_identifiers(target)
                    return trust tfmt(
                        "@deref({s}) = @deref({s}) {s} 1",
                        {name, name, op}
                    )
                }
            }
        }
        return c""
    }
    if len > 2 {
        val second: u8 = trust @load8(@ptradd(trimmed, 1)) as u8
        if ((first == 43 && second == 43) || (first == 45 && second == 45)) {
            val rest: ref u8 = trim_cstr(trust tsubstr(trimmed, 2, len - 2))
            val rest_len: i64 = cstr.len(rest)
            if rest_len > 2
            && (trust @load8(rest) as u8) == 40
            && (trust @load8(@ptradd(rest, rest_len - 1)) as u8) == 41 {
                val inner2: ref u8 = trim_cstr(trust tsubstr(rest, 1, rest_len - 2))
                if cstr.starts_with(inner2, c"*") {
                    val target2: ref u8 = trim_cstr(unwrap_outer_parens(trim_cstr(trust tsubstr(
                                    inner2,
                                    1,
                                    cstr.len(inner2) - 1
                                ))))
                    if is_ident_text(target2) {
                        val op2: mut ref u8 = c"+"
                        if first == 45 {
                            op2 = c"-"
                        }
                        val name2: ref u8 = rewrite_identifiers(target2)
                        return trust tfmt(
                            "@deref({s}) = @deref({s}) {s} 1",
                            {name2, name2, op2}
                        )
                    }
                }
            }
        }
    }
    return c""
}

fn lower_incdec_text(
    _: ref TranslationCtx,
    text: ref u8,
    indent: i64,
    out: ref void
) ref LoweredExpr = {
    val trimmed: ref u8 = strip_trailing_semicolon(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val changed: mut bool = false
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if in_string {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if c == 39 {
            in_char = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if i + 1 < len {
            val next: u8 = trust @load8(@ptradd(trimmed, i + 1)) as u8
            if ((c == 43 && next == 43) || (c == 45 && next == 45)) {
                val op: mut ref u8 = c"+"
                if c == 45 {
                    op = c"-"
                }
                val j: mut i64 = i + 2
                for {
                    if j >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                    if !is_space(ws) {
                        break
                    }
                    j++
                }
                if j < len {
                    val first: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                    if is_ident_start(first) {
                        val start_name: i64 = j
                        j++
                        for {
                            if j >= len {
                                break
                            }
                            val cc: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                            if !is_ident_part(cc) {
                                break
                            }
                            j++
                        }
                        val ident: ref u8 = trust tsubstr(trimmed, start_name, j - start_name)
                        emit_incdec_stmt(ident, op, indent, out)
                        trust builder.StringBuilder.append_cstr(sb, rewrite_identifiers(ident))
                        changed = true
                        i = j
                        continue
                    }
                }
            }
        }
        if is_ident_start(c) {
            val start_name2: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc2: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if !is_ident_part(cc2) {
                    break
                }
                i++
            }
            val ident2: ref u8 = trust tsubstr(trimmed, start_name2, i - start_name2)
            val j2: mut i64 = i
            for {
                if j2 >= len {
                    break
                }
                val ws2: u8 = trust @load8(@ptradd(trimmed, j2)) as u8
                if !is_space(ws2) {
                    break
                }
                j2++
            }
            if j2 + 1 < len {
                val c1: u8 = trust @load8(@ptradd(trimmed, j2)) as u8
                val c2: u8 = trust @load8(@ptradd(trimmed, j2 + 1)) as u8
                if ((c1 == 43 && c2 == 43) || (c1 == 45 && c2 == 45)) {
                    val op2: mut ref u8 = c"+"
                    if c1 == 45 {
                        op2 = c"-"
                    }
                    emit_incdec_stmt(ident2, op2, indent, out)
                    trust builder.StringBuilder.append_cstr(sb, ident2)
                    changed = true
                    i = j2 + 2
                    continue
                }
            }
            trust builder.StringBuilder.append_cstr(sb, ident2)
            continue
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return make_lowered_expr(trust take_cstr(built), changed)
}

fn lower_incdec_expr(
    ctx: ref TranslationCtx,
    text: ref u8,
    indent: i64,
    out: ref void
) ref LoweredExpr = {
    val lowered_text: ref LoweredExpr = lower_incdec_text(ctx, text, indent, out)
    return make_lowered_expr(translate_expr_text(ctx, lowered_text.expr), lowered_text.changed)
}

fn body_has_explicit_return(lines: list[ref u8]) bool = {
    for line in lines {
        val trimmed: ref u8 = trim_cstr(line)
        if cstr.starts_with(trimmed, c"return") {
            return true
        }
    }
    return false
}

fn contains_incdec_ops(text: ref u8) bool = {
    return str_contains(text, c"++") || str_contains(text, c"--")
}

fn analyze_address_taken_in_statement(ctx: mut ref TranslationCtx, line: ref u8) void = {
    val stripped: ref u8 = strip_trailing_semicolon(trim_cstr(line))
    if cstr.cmp(stripped, c"") == 0 {
        return
    }
    val len: i64 = cstr.len(stripped)
    val i: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(stripped, i)) as u8
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if c == 38 {
            val prev: mut u8 = 0
            val next: mut u8 = 0
            if i > 0 {
                prev = trust @load8(@ptradd(stripped, i - 1)) as u8
            }
            if i + 1 < len {
                next = trust @load8(@ptradd(stripped, i + 1)) as u8
            }
            if prev != 38 && next != 38 {
                val j: mut i64 = i + 1
                for {
                    if j >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(stripped, j)) as u8
                    if !is_space(ws) {
                        break
                    }
                    j++
                }
                if j < len {
                    val first: u8 = trust @load8(@ptradd(stripped, j)) as u8
                    if is_ident_start(first) {
                        val start_i: i64 = j
                        j++
                        for {
                            if j >= len {
                                break
                            }
                            val cc: u8 = trust @load8(@ptradd(stripped, j)) as u8
                            if !is_ident_part(cc) {
                                break
                            }
                            j++
                        }
                        val address_name: ref u8 = rewrite_identifiers(trust tsubstr(
                                stripped,
                                start_i,
                                j - start_i
                            ))
                        mark_address_taken_name(ctx, address_name)
                        mark_mutable_name(ctx, address_name)
                        i = j
                        continue
                    }
                }
            }
        }
        i++
    }
}

fn analyze_local_decl_types(ctx: mut ref TranslationCtx, lines: list[ref u8], start: i64) void = {
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val stripped: ref u8 = strip_trailing_semicolon(trim_cstr(line_val as ref u8))
            if !cstr.starts_with(stripped, c"if")
            && !cstr.starts_with(stripped, c"for")
            && !cstr.starts_with(stripped, c"while")
            && !cstr.starts_with(stripped, c"switch")
            && !cstr.starts_with(stripped, c"return")
            && !cstr.starts_with(stripped, c"else")
            && !cstr.starts_with(stripped, c"case")
            && !cstr.starts_with(stripped, c"break")
            && !cstr.starts_with(stripped, c"continue") {
                val assign_i: i64 = find_top_level_assign(stripped)
                val lhs: mut ref u8 = stripped
                if assign_i > 0 {
                    lhs = trim_cstr(trust tsubstr(stripped, 0, assign_i))
                }
                val looks_like_decl: bool = (str_contains(lhs, c" ")
                    || cstr.starts_with(lhs, c"struct ")
                    || cstr.starts_with(lhs, c"enum ")
                    || cstr.starts_with(lhs, c"union "))
                && !str_contains(lhs, c"(")
                if looks_like_decl && cstr.cmp(lhs, c"") != 0 {
                    val decl: ref DeclInfo = parse_named_decl(ctx, lhs, c"")
                    if decl.its_ok && cstr.cmp(decl.name, c"") != 0 {
                        val type_name: mut ref u8 = decl.type_name
                        if is_array_type_name(type_name) {
                            type_name = decay_array_type(type_name)
                        }
                        if cstr.starts_with(type_name, c"ref ") {
                            remember_local_type(ctx, decl.name, type_name)
                        }
                    }
                }
            }
        }
        i++
    }
}

fn analyze_call_arg_mutations(ctx: mut ref TranslationCtx, text: ref u8) void = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if is_ident_start(c) {
            val start_i: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if !is_ident_part(cc) {
                    break
                }
                i++
            }
            val ident: ref u8 = trust tsubstr(trimmed, start_i, i - start_i)
            val j: mut i64 = i
            for {
                if j >= len {
                    break
                }
                val ws: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                if !is_space(ws) {
                    break
                }
                j++
            }
            if j < len && (trust @load8(@ptradd(trimmed, j)) as u8) == 40
            && !cstr.starts_with(ident, c"if")
            && !cstr.starts_with(ident, c"for")
            && !cstr.starts_with(ident, c"while")
            && !cstr.starts_with(ident, c"switch")
            && !cstr.starts_with(ident, c"sizeof") {
                val call_text: ref u8 = trust tsubstr(trimmed, start_i, len - start_i)
                val args = trust extract_call_args_text(call_text)
                for arg in args {
                    val arg_text: ref u8 = trim_cstr(arg)
                    if is_ident_text(arg_text) {
                        if lookup_local_type(ctx, arg_text) is some type_name {
                            if cstr.starts_with(type_name as ref u8, c"ref ")
                            || cstr.starts_with(type_name as ref u8, c"mut ref ") {
                                mark_mutable_name(ctx, rewrite_identifiers(arg_text))
                            }
                        }
                    }
                }
            }
            continue
        }
        i++
    }
}

fn analyze_mutable_names(ctx: mut ref TranslationCtx, lines: list[ref u8], start: i64) void = {
    analyze_local_decl_types(ctx, lines, start)
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            analyze_mutations_in_statement(ctx, line_val as ref u8)
            analyze_call_arg_mutations(ctx, line_val as ref u8)
        }
        i++
    }
}

fn analyze_address_taken_names(
    ctx: mut ref TranslationCtx,
    lines: list[ref u8],
    start: i64
) void = {
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            analyze_address_taken_in_statement(ctx, line_val as ref u8)
        }
        i++
    }
}

fn is_system_include(line: ref u8) bool = {
    val open_i: i64 = find_char(line, 60 as u8)
    val close_i: i64 = find_char(line, 62 as u8)
    return open_i >= 0 && close_i > open_i
}

fn strip_trailing_semicolon(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len <= 0 {
        return trimmed
    }
    val last: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    if last == 59 {
        return trim_cstr(trust tsubstr(trimmed, 0, len - 1))
    }
    return trimmed
}

fn find_matching_delim(text: ref u8, start: i64, open: u8, close: u8) i64 = {
    val len: i64 = cstr.len(text)
    if start < 0 || start >= len {
        return -1
    }
    val first: u8 = trust @load8(@ptradd(text, start)) as u8
    if first != open {
        return -1
    }
    val depth: mut i64 = 0
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == open {
            depth++
        } elif c == close {
            depth--
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn strip_system_includes(text: ref u8) ref u8 = {
    val lines = split_lines(text)
    val sb: ref void = builder.StringBuilder.new()
    val first: mut bool = true
    for line in lines {
        val trimmed: ref u8 = trim_cstr(line)
        if cstr.starts_with(trimmed, c"#include") && is_system_include(trimmed) {
            continue
        }
        if !first {
            trust builder.StringBuilder.append_char(sb, 10 as u8)
        }
        trust builder.StringBuilder.append_cstr(sb, line)
        first = false
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn preprocess_source(path: ref u8) option[ref u8] = trust {
    val size_opt = fs.file_size_cstr(path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all_cstr[allocators.Arena](arena, path)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return none
        }
        some content_val => {
            val original: ref u8 = content_val as ref u8
            val filtered: ref u8 = strip_system_includes(original)
            val current_dir: ref u8 = tdir(path)
            val temp_path: ref u8 = tjoin(current_dir, c"__spectre_translate_tmp__.c")
            val pp_path: ref u8 = tjoin(current_dir, c"__spectre_translate_tmp__.pp")
            val wrote: bool = fs.write_all_cstr(temp_path, filtered)
            if !wrote {
                allocators.Arena.free(arena)
                return some filtered
            }
            val cmd: ref u8 = tfmt(
                "cc -E -P {s} > {s} 2>/dev/null && cat {s} || clang -E -P {s} 2>/dev/null",
                {temp_path, pp_path, pp_path, temp_path}
            )
            val result = os.exec(cmd)
            fs.delete_cstr(temp_path)
            fs.delete_cstr(pp_path)
            match result {
                ok out => {
                    val text: ref u8 = take_cstr(out)
                    allocators.Arena.free(arena)
                    if cstr.cmp(trim_cstr(text), c"") == 0 {
                        return some filtered
                    }
                    return some text
                }
                err _ => {
                    allocators.Arena.free(arena)
                    return some filtered
                }
            }
        }
    }
}

fn extract_call_name(text: ref u8) ref u8 = {
    val open_i: i64 = find_char(text, 40 as u8)
    if open_i <= 0 {
        return c""
    }
    return extract_identifier_before(text, open_i)
}

fn extract_call_args_text(text: ref u8) list[ref u8] = trust {
    val open_i: i64 = find_char(text, 40 as u8)
    val close_i: i64 = find_matching_delim(text, open_i, 40 as u8, 41 as u8)
    if open_i <= 0 || close_i <= open_i {
        return mem.new[ref u8]()
    }
    val args_raw: ref u8 = trim_cstr(tsubstr(text, open_i + 1, close_i - open_i - 1))
    if cstr.cmp(args_raw, c"") == 0 {
        return mem.new[ref u8]()
    }
    return split_top_level(args_raw, 44 as u8)
}

fn is_integer_literal_text(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len == 0 {
        return false
    }
    val i: mut i64 = 0
    val first: u8 = trust @load8(trimmed) as u8
    if first == 45 || first == 43 {
        i = 1
    }
    if i >= len {
        return false
    }
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if !(c >= 48 && c <= 57) {
            return false
        }
        i++
    }
    return true
}

fn is_float_literal_text(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    return str_contains(trimmed, c".") && !is_string_literal_text(trimmed)
}

fn infer_called_arg_type(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    if cstr.cmp(trimmed, c"NULL") == 0 || cstr.cmp(trimmed, c"0") == 0 {
        return c"ref void"
    }
    if cstr.starts_with(trimmed, c"@addr(") {
        return c"ref void"
    }
    if is_string_literal_text(trimmed) {
        return c"ref u8"
    }
    if is_integer_literal_text(trimmed) {
        return c"i32"
    }
    if is_float_literal_text(trimmed) {
        return c"f64"
    }
    if is_ident_text(trimmed) {
        if lookup_local_type(ctx, trimmed) is some type_name {
            return type_name as ref u8
        }
        return c"ref void"
    }
    val index_target: ref u8 = parse_index_target(trimmed)
    if cstr.cmp(index_target, c"") != 0 {
        val elem_type: ref u8 = lookup_index_element_type(ctx, index_target)
        if cstr.cmp(elem_type, c"") != 0 {
            return elem_type
        }
    }
    return c"ref void"
}

fn remember_called_signature(
    ctx: ref TranslationCtx,
    call_name: ref u8,
    args: list[ref u8]
) void = {
    val sb: ref void = builder.StringBuilder.new()
    val first: mut bool = true
    val len: i64 = @len(args) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val arg_opt = @get(args, i as usize)
        if arg_opt is some arg_val {
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            val arg_type: ref u8 = infer_called_arg_type(ctx, arg_val as ref u8)
            trust builder.StringBuilder.append_cstr(sb, tfmt("arg{d}: {s}", {i, arg_type}))
            first = false
        }
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    val params_text: ref u8 = trust take_cstr(built)
    val sig_len: i64 = @len(ctx.called_sig_names) as i64
    val sig_i: mut i64 = 0
    for {
        if sig_i >= sig_len {
            break
        }
        val name_opt = @get(ctx.called_sig_names, sig_i as usize)
        if name_opt is some name_val {
            if cstr.cmp(name_val as ref u8, call_name) == 0 {
                val existing_opt = @get(ctx.called_sig_params, sig_i as usize)
                if existing_opt is some existing_val {
                    if cstr.len(existing_val as ref u8) < cstr.len(params_text) {
                        @set(ctx.called_sig_params, sig_i as usize, params_text)
                    }
                } else {
                    @set(ctx.called_sig_params, sig_i as usize, params_text)
                }
                return
            }
        }
        sig_i++
    }
    @append(ctx.called_sig_names, call_name)
    @append(ctx.called_sig_params, params_text)
}

fn lookup_called_signature(ctx: ref TranslationCtx, call_name: ref u8) option[ref u8] = {
    val len: i64 = @len(ctx.called_sig_names) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val name_opt = @get(ctx.called_sig_names, i as usize)
        if name_opt is some name_val {
            if cstr.cmp(name_val as ref u8, call_name) == 0 {
                val params_opt = @get(ctx.called_sig_params, i as usize)
                if params_opt is some params_val {
                    return some params_val as ref u8
                }
            }
        }
        i++
    }
    return none
}

fn track_called_expr(ctx: mut ref TranslationCtx, expr: ref u8) void = {
    val call_name: ref u8 = extract_call_name(expr)
    if cstr.cmp(call_name, c"") != 0 && !cstr.starts_with(expr, c"@") {
        push_unique(ctx.called_names, call_name)
        remember_called_signature(ctx, call_name, trust extract_call_args_text(expr))
    }
}

fn qualify_enum_constants(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if is_ident_start(c) {
            val start: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if !is_ident_part(cc) {
                    break
                }
                i++
            }
            val ident: ref u8 = trust tsubstr(trimmed, start, i - start)
            val prev_non_space: mut u8 = 0
            val j: mut i64 = start - 1
            for {
                if j < 0 {
                    break
                }
                val pc: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                if !is_space(pc) {
                    prev_non_space = pc
                    break
                }
                j--
            }
            val sanitized_ident: ref u8 = sanitize_identifier(ident)
            if prev_non_space != 46 {
                if lookup_local_type(ctx, sanitized_ident) is some _ {
                } else {
                    if lookup_enum_constant_type(ctx, ident) is some enum_type {
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tfmt("{s}.{s}", {enum_type as ref u8, sanitized_ident})
                        )
                        continue
                    }
                }
            }
            trust builder.StringBuilder.append_cstr(sb, ident)
            continue
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn rewrite_identifiers(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if is_ident_start(c) {
            val start: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if !is_ident_part(cc) {
                    break
                }
                i++
            }
            val ident: ref u8 = trust tsubstr(trimmed, start, i - start)
            val preceded_by_at: bool = start > 0
            && (trust @load8(@ptradd(trimmed, start - 1)) as u8) == 64
            if preceded_by_at && cstr.cmp(ident, c"sizeof") == 0 {
                val j: mut i64 = i
                for {
                    if j >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                    if !is_space(ws) {
                        break
                    }
                    j++
                }
                if j < len && (trust @load8(@ptradd(trimmed, j)) as u8) == 40 {
                    val close_j: i64 = find_matching_delim(trimmed, j, 40 as u8, 41 as u8)
                    if close_j > j {
                        trust builder.StringBuilder.append_cstr(sb, ident)
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tsubstr(trimmed, j, close_j - j + 1)
                        )
                        i = close_j + 1
                        continue
                    }
                }
            }
            if cstr.cmp(ident, c"NULL") == 0 {
                trust builder.StringBuilder.append_cstr(sb, c"0")
                continue
            }
            trust builder.StringBuilder.append_cstr(sb, sanitize_identifier(ident))
            continue
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn replace_arrow_access(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 45 && i + 1 < len {
            val next: u8 = trust @load8(@ptradd(trimmed, i + 1)) as u8
            if next == 62 {
                trust builder.StringBuilder.append_char(sb, 46 as u8)
                i += 2
                continue
            }
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn is_probable_c_type(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len == 0 {
        return false
    }
    val first: u8 = trust @load8(@ptradd(trimmed, 0)) as u8
    if !is_ident_start(first) {
        return false
    }
    val saw_ident: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if is_ident_part(c) {
            saw_ident = true
            i++
            continue
        }
        if is_space(c) || c == 42 {
            i++
            continue
        }
        return false
    }
    return saw_ident
}

fn is_known_c_type_name(ctx: ref TranslationCtx, text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    if cstr.cmp(trimmed, c"") == 0 {
        return false
    }
    val no_stars_sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(trimmed)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c != 42 {
            trust builder.StringBuilder.append_char(no_stars_sb, c)
        }
        i++
    }
    val no_stars_built: ref void = trust builder.StringBuilder.build(no_stars_sb)
    trust builder.StringBuilder.free(no_stars_sb)
    val base: ref u8 = trim_cstr(trust take_cstr(no_stars_built))
    if cstr.cmp(base, c"void") == 0 {
        return true
    }
    if cstr.cmp(base, c"u8") == 0 {
        return true
    }
    if cstr.cmp(base, c"short") == 0 {
        return true
    }
    if cstr.cmp(base, c"int") == 0 {
        return true
    }
    if cstr.cmp(base, c"long") == 0 {
        return true
    }
    if cstr.cmp(base, c"long long") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned u8") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned short") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned int") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned long") == 0 {
        return true
    }
    if cstr.cmp(base, c"unsigned long long") == 0 {
        return true
    }
    if cstr.cmp(base, c"float") == 0 {
        return true
    }
    if cstr.cmp(base, c"double") == 0 {
        return true
    }
    if cstr.cmp(base, c"_Bool") == 0 {
        return true
    }
    if cstr.cmp(base, c"bool") == 0 {
        return true
    }
    if cstr.cmp(base, c"size_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"ssize_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"int8_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"uint8_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"int16_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"uint16_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"int32_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"uint32_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"int64_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"uint64_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"intptr_t") == 0 {
        return true
    }
    if cstr.cmp(base, c"uintptr_t") == 0 {
        return true
    }
    if cstr.starts_with(base, c"struct ") {
        return true
    }
    if cstr.starts_with(base, c"enum ") {
        return true
    }
    if cstr.starts_with(base, c"union ") {
        return true
    }
    return list_contains(ctx.translated_type_names, base)
}

fn is_ident_text(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len == 0 {
        return false
    }
    val first: u8 = trust @load8(@ptradd(trimmed, 0)) as u8
    if !is_ident_start(first) {
        return false
    }
    val i: mut i64 = 1
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if !is_ident_part(c) {
            return false
        }
        i++
    }
    return true
}

fn parse_index_target(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val open_i: i64 = find_char(trimmed, 91 as u8)
    val close_i: i64 = find_last_char(trimmed, 93 as u8)
    if open_i <= 0 || close_i <= open_i {
        return c""
    }
    return trim_cstr(trust tsubstr(trimmed, 0, open_i))
}

fn parse_index_expr(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val open_i: i64 = find_char(trimmed, 91 as u8)
    val close_i: i64 = find_last_char(trimmed, 93 as u8)
    if open_i <= 0 || close_i <= open_i {
        return c""
    }
    return trim_cstr(trust tsubstr(trimmed, open_i + 1, close_i - open_i - 1))
}

fn lookup_index_element_type(ctx: ref TranslationCtx, base: ref u8) ref u8 = {
    if !is_ident_text(base) {
        return c""
    }
    if lookup_local_type(ctx, base) is some type_name {
        val t: ref u8 = trim_cstr(type_name as ref u8)
        if cstr.starts_with(t, c"ref ") {
            return trim_cstr(trust tsubstr(t, 4, cstr.len(t) - 4))
        }
        if is_array_type_name(t) {
            return decay_array_type(t)
        }
    }
    return c""
}

fn render_index_ptr_expr(ctx: ref TranslationCtx, base: ref u8, index_expr: ref u8) ref u8 = {
    val elem_type: ref u8 = lookup_index_element_type(ctx, base)
    if cstr.cmp(elem_type, c"") == 0 {
        return trust tfmt("@ptradd({s}, {s})", {base, index_expr})
    }
    return trust tfmt("@ptradd({s}, ({s}) * @sizeof({s}))", {base, index_expr, elem_type})
}

fn replace_pointer_indexing(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if is_ident_start(c) {
            val start: i64 = i
            i++
            for {
                if i >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if !is_ident_part(cc) {
                    break
                }
                i++
            }
            val chain_end: mut i64 = i
            for {
                if chain_end >= len {
                    break
                }
                val dot: u8 = trust @load8(@ptradd(trimmed, chain_end)) as u8
                if dot != 46 || chain_end + 1 >= len {
                    break
                }
                val next0: u8 = trust @load8(@ptradd(trimmed, chain_end + 1)) as u8
                if !is_ident_start(next0) {
                    break
                }
                chain_end += 2
                for {
                    if chain_end >= len {
                        break
                    }
                    val cc_chain: u8 = trust @load8(@ptradd(trimmed, chain_end)) as u8
                    if !is_ident_part(cc_chain) {
                        break
                    }
                    chain_end++
                }
            }
            val ident: ref u8 = trust tsubstr(trimmed, start, chain_end - start)
            i = chain_end
            if i < len {
                val next: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if next == 91 {
                    val close_i: mut i64 = i + 1
                    val depth: mut i64 = 1
                    for {
                        if close_i >= len {
                            break
                        }
                        val bc: u8 = trust @load8(@ptradd(trimmed, close_i)) as u8
                        if bc == 91 {
                            depth++
                        } elif bc == 93 {
                            depth--
                            if depth == 0 {
                                break
                            }
                        }
                        close_i++
                    }
                    if close_i < len {
                        val inner: ref u8 = trim_cstr(trust tsubstr(
                                trimmed,
                                i + 1,
                                close_i - i - 1
                            ))
                        val index_ptr: ref u8 = render_index_ptr_expr(ctx, ident, inner)
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tfmt("@load({s})", {index_ptr})
                        )
                        i = close_i + 1
                        continue
                    }
                }
            }
            trust builder.StringBuilder.append_cstr(sb, ident)
            continue
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn ensure_intrinsic_prefixes(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val names: list[ref u8] = mem.from6[ref u8](
        c"load",
        c"store",
        c"ptradd",
        c"sizeof",
        c"alloc",
        c"free"
    )
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val matched: mut bool = false
        for name in names {
            val nlen: i64 = cstr.len(name)
            if i + nlen + 1 > len {
                continue
            }
            val frag: ref u8 = trust tsubstr(trimmed, i, nlen)
            if cstr.cmp(frag, name) != 0 {
                continue
            }
            val prev_ok: bool = i == 0 || !is_ident_part(trust @load8(@ptradd(
                        trimmed,
                        i - 1
                    )) as u8)
            val nextc: u8 = trust @load8(@ptradd(trimmed, i + nlen)) as u8
            val already_intrinsic: bool = i > 0 && (trust @load8(@ptradd(
                        trimmed,
                        i - 1
                    )) as u8) == 64
            if prev_ok && !already_intrinsic && nextc == 40 {
                trust builder.StringBuilder.append_char(sb, 64 as u8)
                trust builder.StringBuilder.append_cstr(sb, name)
                i += nlen
                matched = true
                break
            }
        }
        if matched {
            continue
        }
        trust builder.StringBuilder.append_char(sb, @load8(@ptradd(trimmed, i)) as u8)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn normalize_intrinsic_prefixes(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val names: list[ref u8] = mem.from6[ref u8](
        c"load",
        c"store",
        c"ptradd",
        c"sizeof",
        c"alloc",
        c"free"
    )
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 64 {
            val at_start: i64 = i
            for {
                if i < len && (trust @load8(@ptradd(trimmed, i)) as u8) == 64 {
                    i++
                    continue
                }
                break
            }
            val matched: mut bool = false
            for name in names {
                val nlen: i64 = cstr.len(name)
                if i + nlen > len {
                    continue
                }
                val frag: ref u8 = trust tsubstr(trimmed, i, nlen)
                if cstr.cmp(frag, name) != 0 {
                    continue
                }
                if i + nlen < len && (trust @load8(@ptradd(trimmed, i + nlen)) as u8) == 40 {
                    trust builder.StringBuilder.append_char(sb, 64 as u8)
                    trust builder.StringBuilder.append_cstr(sb, name)
                    i += nlen
                    matched = true
                    break
                }
            }
            if matched {
                continue
            }
            val j: mut i64 = at_start
            for {
                if j >= i {
                    break
                }
                trust builder.StringBuilder.append_char(sb, 64 as u8)
                j++
            }
            continue
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn scan_deref_operand_end(text: ref u8, start: i64) i64 = {
    val len: i64 = cstr.len(text)
    if start < 0 || start >= len {
        return start
    }
    val first: u8 = trust @load8(@ptradd(text, start)) as u8
    val i: mut i64 = start
    if is_ident_start(first) {
        i++
        for {
            if i >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(text, i)) as u8
            if !is_ident_part(c) {
                break
            }
            i++
        }
    } elif first == 40 {
        val close_i: i64 = find_matching_delim(text, start, 40 as u8, 41 as u8)
        if close_i <= start {
            return start
        }
        i = close_i + 1
    } else {
        return start
    }
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == 91 {
            val close_b: i64 = find_matching_delim(text, i, 91 as u8, 93 as u8)
            if close_b <= i {
                break
            }
            i = close_b + 1
            continue
        }
        if c == 46 {
            val j: mut i64 = i + 1
            if j >= len {
                break
            }
            val first2: u8 = trust @load8(@ptradd(text, j)) as u8
            if !is_ident_start(first2) {
                break
            }
            j++
            for {
                if j >= len {
                    break
                }
                val cc: u8 = trust @load8(@ptradd(text, j)) as u8
                if !is_ident_part(cc) {
                    break
                }
                j++
            }
            i = j
            continue
        }
        if i + 1 < len {
            val c2: u8 = trust @load8(@ptradd(text, i + 1)) as u8
            if c == 45 && c2 == 62 {
                val j2: mut i64 = i + 2
                if j2 >= len {
                    break
                }
                val first3: u8 = trust @load8(@ptradd(text, j2)) as u8
                if !is_ident_start(first3) {
                    break
                }
                j2++
                for {
                    if j2 >= len {
                        break
                    }
                    val cc2: u8 = trust @load8(@ptradd(text, j2)) as u8
                    if !is_ident_part(cc2) {
                        break
                    }
                    j2++
                }
                i = j2
                continue
            }
            if ((c == 43 && c2 == 43) || (c == 45 && c2 == 45)) {
                i += 2
                continue
            }
        }
        break
    }
    return i
}

fn is_unary_deref_context(text: ref u8, star_i: i64) bool = {
    val j: mut i64 = star_i - 1
    for {
        if j < 0 {
            return true
        }
        val c: u8 = trust @load8(@ptradd(text, j)) as u8
        if !is_space(c) {
            break
        }
        j--
    }
    if j < 0 {
        return true
    }
    val prev: u8 = trust @load8(@ptradd(text, j)) as u8
    if prev == 40 || prev == 44 || prev == 61 || prev == 33 || prev == 126 || prev == 63 || prev == 58 {
        return true
    }
    if prev == 43 || prev == 45 || prev == 42 || prev == 47 || prev == 37 || prev == 38 || prev == 124 || prev == 94 {
        return true
    }
    if prev == 60 || prev == 62 || prev == 123 || prev == 91 {
        return true
    }
    if is_ident_part(prev) {
        val end_i: i64 = j
        for {
            if j < 0 {
                break
            }
            val c2: u8 = trust @load8(@ptradd(text, j)) as u8
            if !is_ident_part(c2) {
                break
            }
            j--
        }
        val word: ref u8 = trust tsubstr(text, j + 1, end_i - j)
        if cstr.cmp(word, c"return") == 0 {
            return true
        }
        if cstr.cmp(word, c"if") == 0 {
            return true
        }
        if cstr.cmp(word, c"while") == 0 {
            return true
        }
        if cstr.cmp(word, c"for") == 0 {
            return true
        }
        if cstr.cmp(word, c"case") == 0 {
            return true
        }
        if cstr.cmp(word, c"switch") == 0 {
            return true
        }
        if cstr.cmp(word, c"sizeof") == 0 {
            return true
        }
    }
    return false
}

fn translate_addr_deref_expr(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if in_string {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if c == 39 {
            in_char = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if c == 40 {
            val close_group: i64 = find_matching_delim(trimmed, i, 40 as u8, 41 as u8)
            val j0: mut i64 = i + 1
            for {
                if j0 >= len {
                    break
                }
                val ws0: u8 = trust @load8(@ptradd(trimmed, j0)) as u8
                if !is_space(ws0) {
                    break
                }
                j0++
            }
            if j0 < len && (trust @load8(@ptradd(trimmed, j0)) as u8) == 42 && close_group > j0 {
                val inner_start: mut i64 = j0 + 1
                for {
                    if inner_start >= close_group {
                        break
                    }
                    val ws1: u8 = trust @load8(@ptradd(trimmed, inner_start)) as u8
                    if !is_space(ws1) {
                        break
                    }
                    inner_start++
                }
                val inner_text: ref u8 = trim_cstr(trust tsubstr(
                        trimmed,
                        inner_start,
                        close_group - inner_start
                    ))
                val translated_inner: ref u8 = translate_addr_deref_expr(ctx, inner_text)
                val after_group: mut i64 = close_group + 1
                for {
                    if after_group >= len {
                        break
                    }
                    val ws2: u8 = trust @load8(@ptradd(trimmed, after_group)) as u8
                    if !is_space(ws2) {
                        break
                    }
                    after_group++
                }
                if after_group + 1 < len {
                    val p1: u8 = trust @load8(@ptradd(trimmed, after_group)) as u8
                    val p2: u8 = trust @load8(@ptradd(trimmed, after_group + 1)) as u8
                    if ((p1 == 43 && p2 == 43) || (p1 == 45 && p2 == 45)) {
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tfmt("@deref({s}){c}{c}", {translated_inner, p1, p2})
                        )
                        i = after_group + 2
                        continue
                    }
                }
                trust builder.StringBuilder.append_cstr(
                    sb,
                    tfmt("@deref({s})", {translated_inner})
                )
                i = close_group + 1
                continue
            }
        }
        if c == 38 {
            val prev: mut u8 = 0
            val next: mut u8 = 0
            if i > 0 {
                prev = trust @load8(@ptradd(trimmed, i - 1)) as u8
            }
            if i + 1 < len {
                next = trust @load8(@ptradd(trimmed, i + 1)) as u8
            }
            if prev != 38 && next != 38 {
                val j: mut i64 = i + 1
                for {
                    if j >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                    if !is_space(ws) {
                        break
                    }
                    j++
                }
                if j < len {
                    val first: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                    if is_ident_start(first) {
                        val start_i: i64 = j
                        j++
                        for {
                            if j >= len {
                                break
                            }
                            val cc: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                            if !is_ident_part(cc) {
                                break
                            }
                            j++
                        }
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            rewrite_identifiers(tsubstr(trimmed, start_i, j - start_i))
                        )
                        i = j
                        continue
                    }
                }
            }
        }
        if c == 42 {
            if is_unary_deref_context(trimmed, i) {
                val j2: mut i64 = i + 1
                for {
                    if j2 >= len {
                        break
                    }
                    val ws2: u8 = trust @load8(@ptradd(trimmed, j2)) as u8
                    if !is_space(ws2) {
                        break
                    }
                    j2++
                }
                if j2 < len {
                    val operand_end: i64 = scan_deref_operand_end(trimmed, j2)
                    if operand_end > j2 {
                        val operand_text: ref u8 = translate_addr_deref_expr(
                            ctx,
                            trim_cstr(trust tsubstr(trimmed, j2, operand_end - j2))
                        )
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tfmt("@deref({s})", {operand_text})
                        )
                        i = operand_end
                        continue
                    }
                }
            }
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn is_printf_length_char(c: u8) bool = {
    return c == 104 || c == 108 || c == 122 || c == 116 || c == 106 || c == 76
}

fn map_printf_specifier(length_mod: ref u8, specifier: u8) ref u8 = {
    val is_size_mod: bool = cstr.cmp(length_mod, c"z") == 0
    || cstr.cmp(length_mod, c"t") == 0
    || cstr.cmp(length_mod, c"j") == 0
    if is_size_mod && (specifier == 105 || specifier == 100 || specifier == 117) {
        return c"d"
    }
    if is_size_mod && (specifier == 120 || specifier == 88 || specifier == 111) {
        return trust tfmt("{c}", {specifier})
    }
    if specifier == 105 {
        return trust tfmt("{s}d", {length_mod})
    }
    if specifier == 100 {
        return trust tfmt("{s}d", {length_mod})
    }
    if specifier == 117 {
        return trust tfmt("{s}u", {length_mod})
    }
    if specifier == 120 {
        return trust tfmt("{s}x", {length_mod})
    }
    if specifier == 88 {
        return trust tfmt("{s}X", {length_mod})
    }
    if specifier == 111 {
        return trust tfmt("{s}o", {length_mod})
    }
    if specifier == 99 {
        return c"c"
    }
    if specifier == 115 {
        return c"s"
    }
    if specifier == 112 {
        return c"p"
    }
    if specifier == 102 || specifier == 70 || specifier == 101 || specifier == 69 || specifier == 103 || specifier == 71 || specifier == 97 || specifier == 65 {
        return c"f"
    }
    return trust tfmt("{c}", {specifier})
}

fn translate_printf_format(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 2 {
        return trimmed
    }
    val first: u8 = trust @load8(@ptradd(trimmed, 0)) as u8
    val last: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    if first != 34 || last != 34 {
        return trimmed
    }
    val sb: ref void = builder.StringBuilder.new()
    trust builder.StringBuilder.append_char(sb, 34 as u8)
    val i: mut i64 = 1
    for {
        if i >= len - 1 {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 37 && i + 1 < len - 1 {
            val next: u8 = trust @load8(@ptradd(trimmed, i + 1)) as u8
            if next == 37 {
                trust builder.StringBuilder.append_char(sb, 37 as u8)
                i += 2
                continue
            }
            val spec_i: mut i64 = i + 1
            for {
                if spec_i >= len - 1 {
                    break
                }
                val flag: u8 = trust @load8(@ptradd(trimmed, spec_i)) as u8
                if flag != 45 && flag != 43 && flag != 32 && flag != 35 && flag != 48 {
                    break
                }
                spec_i++
            }
            for {
                if spec_i >= len - 1 {
                    break
                }
                val width: u8 = trust @load8(@ptradd(trimmed, spec_i)) as u8
                if !((width >= 48 && width <= 57) || width == 42) {
                    break
                }
                spec_i++
            }
            if spec_i < len - 1 && (trust @load8(@ptradd(trimmed, spec_i)) as u8) == 46 {
                spec_i++
                for {
                    if spec_i >= len - 1 {
                        break
                    }
                    val prec: u8 = trust @load8(@ptradd(trimmed, spec_i)) as u8
                    if !((prec >= 48 && prec <= 57) || prec == 42) {
                        break
                    }
                    spec_i++
                }
            }
            val length_sb: ref void = builder.StringBuilder.new()
            for {
                if spec_i >= len - 1 {
                    break
                }
                val lm: u8 = trust @load8(@ptradd(trimmed, spec_i)) as u8
                if !is_printf_length_char(lm) {
                    break
                }
                trust builder.StringBuilder.append_char(length_sb, lm)
                spec_i++
            }
            if spec_i < len - 1 {
                val specifier: u8 = trust @load8(@ptradd(trimmed, spec_i)) as u8
                val length_built: ref void = trust builder.StringBuilder.build(length_sb)
                trust builder.StringBuilder.free(length_sb)
                val mapped: ref u8 = map_printf_specifier(
                    trust take_cstr(length_built),
                    specifier
                )
                trust builder.StringBuilder.append_char(sb, 123 as u8)
                trust builder.StringBuilder.append_cstr(sb, mapped)
                trust builder.StringBuilder.append_char(sb, 125 as u8)
                i = spec_i + 1
                continue
            }
            trust builder.StringBuilder.free(length_sb)
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    trust builder.StringBuilder.append_char(sb, 34 as u8)
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn translate_printf_call(ctx: ref TranslationCtx, args: list[ref u8]) ref u8 = {
    val fmt_opt = @get(args, 0)
    val fmt_expr: mut ref u8 = c"\"\""
    if fmt_opt is some fmt_val {
        fmt_expr = translate_printf_format(translate_expr_text(ctx, fmt_val as ref u8))
    }
    val sb: ref void = builder.StringBuilder.new()
    trust builder.StringBuilder.append_char(sb, 123 as u8)
    val first: mut bool = true
    val idx: mut i64 = 1
    val len: i64 = @len(args) as i64
    for {
        if idx >= len {
            break
        }
        val arg_opt = @get(args, idx as usize)
        if arg_opt is some arg_val {
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(sb, translate_expr_text(ctx, arg_val as ref u8))
            first = false
        }
        idx++
    }
    trust builder.StringBuilder.append_char(sb, 125 as u8)
    val args_built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust tfmt("@print({s}, {s})", {fmt_expr, take_cstr(args_built)})
}

fn translate_variadic_args(ctx: ref TranslationCtx, args: list[ref u8], start_index: i64) ref u8 = {
    val sb: ref void = builder.StringBuilder.new()
    trust builder.StringBuilder.append_char(sb, 123 as u8)
    val first: mut bool = true
    val idx: mut i64 = start_index
    val len: i64 = @len(args) as i64
    for {
        if idx >= len {
            break
        }
        val arg_opt = @get(args, idx as usize)
        if arg_opt is some arg_val {
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(sb, translate_expr_text(ctx, arg_val as ref u8))
            first = false
        }
        idx++
    }
    trust builder.StringBuilder.append_char(sb, 125 as u8)
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn translate_stream_fd_expr(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    if cstr.cmp(trimmed, c"stdin") == 0 {
        return c"0"
    }
    if cstr.cmp(trimmed, c"stdout") == 0 {
        return c"1"
    }
    if cstr.cmp(trimmed, c"stderr") == 0 {
        return c"2"
    }
    return translate_expr_text(ctx, trimmed)
}

fn translate_fprintf_call(ctx: ref TranslationCtx, args: list[ref u8]) ref u8 = {
    val stream_opt = @get(args, 0)
    val fmt_opt = @get(args, 1)
    match stream_opt {
        none => {
            return c"/* unsupported fprintf */"
        }
        some stream_val => {
            match fmt_opt {
                none => {
                    return c"/* unsupported fprintf */"
                }
                some fmt_val => {
                    val fd_expr: ref u8 = translate_stream_fd_expr(ctx, stream_val as ref u8)
                    val fmt_expr: ref u8 = translate_printf_format(translate_expr_text(
                            ctx,
                            fmt_val as ref u8
                        ))
                    val varargs: ref u8 = translate_variadic_args(ctx, args, 2)
                    return trust tfmt("@dprintf({s}, {s}, {s})", {fd_expr, fmt_expr, varargs})
                }
            }
        }
    }
}

fn transform_call_expr(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val open_i: i64 = find_char(trimmed, 40 as u8)
    val close_i: i64 = find_matching_delim(trimmed, open_i, 40 as u8, 41 as u8)
    if open_i <= 0 || close_i <= open_i {
        return trimmed
    }
    val call_name: ref u8 = extract_identifier_before(trimmed, open_i)
    if cstr.cmp(call_name, c"") == 0 {
        return trimmed
    }
    val call_start: i64 = open_i - cstr.len(call_name)
    if call_start < 0 {
        return trimmed
    }
    val prefix_text: ref u8 = trim_cstr(trust tsubstr(trimmed, 0, call_start))
    if !(cstr.cmp(prefix_text, c"") == 0 || cstr.cmp(prefix_text, c"@") == 0) {
        return trimmed
    }
    if close_i != cstr.len(trimmed) - 1 {
        return trimmed
    }
    val intrinsic_prefix: mut ref u8 = c""
    if cstr.starts_with(trimmed, c"@") {
        intrinsic_prefix = c"@"
    }
    val args_raw: ref u8 = trim_cstr(trust tsubstr(trimmed, open_i + 1, close_i - open_i - 1))
    val args = split_top_level(args_raw, 44 as u8)
    if cstr.cmp(call_name, c"printf") == 0 {
        return translate_printf_call(ctx, args)
    }
    if cstr.cmp(call_name, c"fprintf") == 0 {
        return translate_fprintf_call(ctx, args)
    }
    val sb: ref void = builder.StringBuilder.new()
    val first: mut bool = true
    for arg in args {
        val arg_trimmed: ref u8 = trim_cstr(arg)
        if !first {
            trust builder.StringBuilder.append_cstr(sb, c", ")
        }
        if is_ident_text(arg_trimmed) && list_contains(ctx.defined_names, arg_trimmed) {
            trust builder.StringBuilder.append_cstr(sb, tfmt("@addr({s})", {arg_trimmed}))
        } else {
            trust builder.StringBuilder.append_cstr(sb, translate_expr_text(ctx, arg_trimmed))
        }
        first = false
    }
    val args_built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    val args_text: ref u8 = trust take_cstr(args_built)
    if cstr.cmp(call_name, c"sizeof") == 0 {
        return trust tfmt("@sizeof({s})", {args_text})
    }
    if cstr.cmp(call_name, c"malloc") == 0 {
        return trust tfmt("@alloc({s})", {args_text})
    }
    if list_contains(ctx.fnptr_names, call_name) {
        return trust tfmt("@call({s}, {s})", {call_name, args_text})
    }
    return trust tfmt("{s}{s}({s})", {intrinsic_prefix, call_name, args_text})
}

fn find_top_level_ternary(text: ref u8) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif c == 63 && paren == 0 && brace == 0 && bracket == 0 {
            return i
        }
        i++
    }
    return -1
}

fn find_matching_colon_for_ternary(text: ref u8, q_index: i64) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val ternary_depth: mut i64 = 0
    val i: mut i64 = q_index + 1
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif c == 63 && paren == 0 && brace == 0 && bracket == 0 {
            ternary_depth++
        } elif c == 58 && paren == 0 && brace == 0 && bracket == 0 {
            if ternary_depth == 0 {
                return i
            }
            ternary_depth--
        }
        i++
    }
    return -1
}

fn is_wrapped_in_parens(text: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    if len < 2 {
        return false
    }
    val first: u8 = trust @load8(@ptradd(trimmed, 0)) as u8
    val last: u8 = trust @load8(@ptradd(trimmed, len - 1)) as u8
    if first != 40 || last != 41 {
        return false
    }
    val depth: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 40 {
            depth++
        } elif c == 41 {
            depth--
            if depth == 0 && i != len - 1 {
                return false
            }
        }
        i++
    }
    return depth == 0
}

fn unwrap_outer_parens(text: ref u8) ref u8 = {
    val current: mut ref u8 = trim_cstr(text)
    for {
        if !is_wrapped_in_parens(current) {
            break
        }
        val len: i64 = cstr.len(current)
        current = trim_cstr(trust tsubstr(current, 1, len - 2))
    }
    return current
}

fn collect_brace_block(lines: list[ref u8], start: i64) ref BlockResult = {
    val len: i64 = @len(lines) as i64
    val brace_depth: mut i64 = 0
    val seen_open: mut bool = false
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val line: ref u8 = line_val as ref u8
            val llen: i64 = cstr.len(line)
            val j: mut i64 = 0
            for {
                if j >= llen {
                    break
                }
                val c: u8 = trust @load8(@ptradd(line, j)) as u8
                if c == 123 {
                    brace_depth++
                    seen_open = true
                } elif c == 125 && brace_depth > 0 {
                    brace_depth--
                    if seen_open && brace_depth == 0 {
                        return make_block_result(i + 1, STOP_EOF, c"")
                    }
                }
                j++
            }
        }
        i++
    }
    return make_block_result(i, STOP_EOF, c"")
}

fn translate_for_loop(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    match line_opt {
        none => {
            return make_block_result(start + 1, STOP_EOF, c"")
        }
        some line_val => {
            val line: ref u8 = trim_cstr(line_val as ref u8)
            val open_i: i64 = find_char(line, 40 as u8)
            val close_i: i64 = find_matching_delim(line, open_i, 40 as u8, 41 as u8)
            if open_i < 0 || close_i <= open_i {
                append_comment_line(out, indent, line)
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            val inside: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    open_i + 1,
                    close_i - open_i - 1
                ))
            val tail: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    close_i + 1,
                    cstr.len(line) - close_i - 1
                ))
            val parts = split_top_level(inside, 59 as u8)
            val init: mut ref u8 = c""
            val cond: mut ref u8 = c""
            val postc: mut ref u8 = c""
            val p0 = @get(parts, 0)
            if p0 is some v {
                init = trim_cstr(v as ref u8)
            }
            val p1 = @get(parts, 1)
            if p1 is some v {
                cond = trim_cstr(v as ref u8)
            }
            val p2 = @get(parts, 2)
            if p2 is some v {
                postc = trim_cstr(v as ref u8)
            }
            if cstr.cmp(init, c"") != 0 {
                translate_inline_statement(ctx, init, indent, out)
            }
            append_line(out, indent, c"for {")
            val body_indent: mut i64 = indent + 1
            val next_i: mut i64 = start + 1
            if cstr.cmp(cond, c"") != 0 {
                val cond_out: ref void = builder.StringBuilder.new()
                val cond_text: ref u8 = translate_condition_text(ctx, cond, indent + 1, cond_out)
                append_builder(out, cond_out)
                append_line(out, indent + 1, trust tfmt("if ({s}) {", {cond_text}))
                body_indent = indent + 2
            }
            if cstr.cmp(tail, c"") != 0 {
                if cstr.starts_with(tail, c"{") {
                    val body_span: ref BlockResult = translate_brace_block(
                        lines,
                        start,
                        body_indent,
                        out,
                        ctx
                    )
                    next_i = body_span.next_index
                } else {
                    translate_inline_statement(ctx, tail, body_indent, out)
                }
            } else {
                val next_body_i: i64 = next_significant_line(lines, start + 1)
                if next_body_i >= 0 {
                    val next_opt = @get(lines, next_body_i as usize)
                    if next_opt is some next_line {
                        val next_trimmed: ref u8 = trim_cstr(next_line as ref u8)
                        if cstr.starts_with(next_trimmed, c"{") {
                            val body_span2: ref BlockResult = translate_brace_block(
                                lines,
                                next_body_i,
                                body_indent,
                                out,
                                ctx
                            )
                            next_i = body_span2.next_index
                        } else {
                            val stmt_result: ref BlockResult = translate_statement_at(
                                lines,
                                current_dir,
                                next_body_i,
                                body_indent,
                                out,
                                ctx
                            )
                            next_i = stmt_result.next_index
                        }
                    }
                }
            }
            if cstr.cmp(postc, c"") != 0 {
                translate_inline_statement(ctx, postc, body_indent, out)
            }
            if cstr.cmp(cond, c"") != 0 {
                append_line(out, indent + 1, c"} else {")
                append_line(out, indent + 2, c"break")
                append_line(out, indent + 1, c"}")
            }
            append_line(out, indent, c"}")
            return make_block_result(next_i, STOP_EOF, c"")
        }
    }
}

fn translate_while_loop(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    match line_opt {
        none => {
            return make_block_result(start + 1, STOP_EOF, c"")
        }
        some line_val => {
            val line: ref u8 = trim_cstr(line_val as ref u8)
            val open_i: i64 = find_char(line, 40 as u8)
            val close_i: i64 = find_matching_delim(line, open_i, 40 as u8, 41 as u8)
            if open_i < 0 || close_i <= open_i {
                append_comment_line(out, indent, line)
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            val cond_src: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    open_i + 1,
                    close_i - open_i - 1
                ))
            val tail: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    close_i + 1,
                    cstr.len(line) - close_i - 1
                ))
            val cond_out: ref void = builder.StringBuilder.new()
            val cond_text: ref u8 = translate_condition_text(ctx, cond_src, indent + 1, cond_out)
            append_line(out, indent, c"for {")
            append_builder(out, cond_out)
            append_line(out, indent + 1, trust tfmt("if ({s}) {", {cond_text}))
            val next_i: mut i64 = start + 1
            if cstr.cmp(tail, c"") != 0 {
                if cstr.starts_with(tail, c"{") {
                    val body_span: ref BlockResult = translate_brace_block(
                        lines,
                        start,
                        indent + 2,
                        out,
                        ctx
                    )
                    next_i = body_span.next_index
                } else {
                    translate_inline_statement(ctx, tail, indent + 2, out)
                }
            } else {
                val next_body_i: i64 = next_significant_line(lines, start + 1)
                if next_body_i >= 0 {
                    val next_opt = @get(lines, next_body_i as usize)
                    if next_opt is some next_line {
                        val next_trimmed: ref u8 = trim_cstr(next_line as ref u8)
                        if cstr.starts_with(next_trimmed, c"{") {
                            val body_span2: ref BlockResult = translate_brace_block(
                                lines,
                                next_body_i,
                                indent + 2,
                                out,
                                ctx
                            )
                            next_i = body_span2.next_index
                        } else {
                            val stmt_result: ref BlockResult = translate_statement_at(
                                lines,
                                current_dir,
                                next_body_i,
                                indent + 2,
                                out,
                                ctx
                            )
                            next_i = stmt_result.next_index
                        }
                    }
                }
            }
            append_line(out, indent + 1, c"} else {")
            append_line(out, indent + 2, c"break")
            append_line(out, indent + 1, c"}")
            append_line(out, indent, c"}")
            return make_block_result(next_i, STOP_EOF, c"")
        }
    }
}

fn translate_brace_block(
    lines: list[ref u8],
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val span: ref BlockResult = collect_brace_block(lines, start)
    val full_text: ref u8 = join_lines(lines, start, span.next_index)
    val open_i: i64 = find_char(full_text, 123 as u8)
    val close_i: i64 = find_last_char(full_text, 125 as u8)
    if open_i < 0 || close_i <= open_i {
        append_comment_line(out, indent, trim_cstr(full_text))
        return span
    }
    val body_text: ref u8 = trust tsubstr(full_text, open_i + 1, close_i - open_i - 1)
    val body_lines = split_lines(body_text)
    translate_body_lines(body_lines, c"", 0, indent, out, ctx)
    return span
}

fn translate_inline_statement(
    ctx: mut ref TranslationCtx,
    text: ref u8,
    indent: i64,
    out: ref void
) void = {
    val trimmed: ref u8 = strip_trailing_semicolon(trim_cstr(text))
    if cstr.cmp(trimmed, c"") == 0 {
        return
    }
    if translate_body_statement(ctx, trimmed, indent, out) {
        return
    }
    append_comment_line(out, indent, trimmed)
}

fn translate_if_text(
    lines: list[ref u8],
    current_dir: ref u8,
    line_index: i64,
    if_text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val trimmed: ref u8 = trim_cstr(if_text)
    val open_i: i64 = find_char(trimmed, 40 as u8)
    val close_i: i64 = find_matching_delim(trimmed, open_i, 40 as u8, 41 as u8)
    if open_i < 0 || close_i <= open_i {
        append_comment_line(out, indent, trimmed)
        return make_block_result(line_index + 1, STOP_EOF, c"")
    }
    val cond_src: ref u8 = trim_cstr(trust tsubstr(trimmed, open_i + 1, close_i - open_i - 1))
    val cond_text: ref u8 = translate_condition_text(ctx, cond_src, indent, out)
    val tail: ref u8 = trim_cstr(trust tsubstr(
            trimmed,
            close_i + 1,
            cstr.len(trimmed) - close_i - 1
        ))
    append_line(out, indent, trust tfmt("if ({s}) {", {cond_text}))
    val next_i: mut i64 = line_index + 1
    if cstr.cmp(tail, c"") != 0 {
        if cstr.starts_with(tail, c"{") {
            val then_span: ref BlockResult = translate_brace_block(
                lines,
                line_index,
                indent + 1,
                out,
                ctx
            )
            next_i = then_span.next_index
        } else {
            translate_inline_statement(ctx, tail, indent + 1, out)
        }
    } else {
        val next_body_i: i64 = next_significant_line(lines, line_index + 1)
        if next_body_i >= 0 {
            val next_opt = @get(lines, next_body_i as usize)
            if next_opt is some next_line {
                val next_trimmed: ref u8 = trim_cstr(next_line as ref u8)
                if cstr.starts_with(next_trimmed, c"{") {
                    val then_span2: ref BlockResult = translate_brace_block(
                        lines,
                        next_body_i,
                        indent + 1,
                        out,
                        ctx
                    )
                    next_i = then_span2.next_index
                } else {
                    val stmt_result: ref BlockResult = translate_statement_at(
                        lines,
                        current_dir,
                        next_body_i,
                        indent + 1,
                        out,
                        ctx
                    )
                    next_i = stmt_result.next_index
                }
            }
        }
    }
    val else_i: i64 = next_significant_line(lines, next_i)
    if else_i >= 0 {
        val else_opt = @get(lines, else_i as usize)
        if else_opt is some else_line {
            val else_trimmed: ref u8 = trim_cstr(else_line as ref u8)
            if cstr.starts_with(else_trimmed, c"else") {
                val else_tail: ref u8 = trim_cstr(trust tsubstr(
                        else_trimmed,
                        4,
                        cstr.len(else_trimmed) - 4
                    ))
                append_line(out, indent, c"} else {")
                if starts_keyword_paren(else_tail, c"if") {
                    val nested_result: ref BlockResult = translate_if_text(
                        lines,
                        current_dir,
                        else_i,
                        else_tail,
                        indent + 1,
                        out,
                        ctx
                    )
                    append_line(out, indent, c"}")
                    return make_block_result(nested_result.next_index, STOP_EOF, c"")
                }
                if cstr.cmp(else_tail, c"") != 0 {
                    if cstr.starts_with(else_tail, c"{") {
                        val else_span: ref BlockResult = translate_brace_block(
                            lines,
                            else_i,
                            indent + 1,
                            out,
                            ctx
                        )
                        append_line(out, indent, c"}")
                        return make_block_result(else_span.next_index, STOP_EOF, c"")
                    }
                    translate_inline_statement(ctx, else_tail, indent + 1, out)
                    append_line(out, indent, c"}")
                    return make_block_result(else_i + 1, STOP_EOF, c"")
                }
                val else_body_i: i64 = next_significant_line(lines, else_i + 1)
                if else_body_i >= 0 {
                    val else_body_opt = @get(lines, else_body_i as usize)
                    if else_body_opt is some else_body_line {
                        val else_body_trimmed: ref u8 = trim_cstr(else_body_line as ref u8)
                        if cstr.starts_with(else_body_trimmed, c"{") {
                            val else_span2: ref BlockResult = translate_brace_block(
                                lines,
                                else_body_i,
                                indent + 1,
                                out,
                                ctx
                            )
                            append_line(out, indent, c"}")
                            return make_block_result(else_span2.next_index, STOP_EOF, c"")
                        }
                        val else_stmt_result: ref BlockResult = translate_statement_at(
                            lines,
                            current_dir,
                            else_body_i,
                            indent + 1,
                            out,
                            ctx
                        )
                        append_line(out, indent, c"}")
                        return make_block_result(else_stmt_result.next_index, STOP_EOF, c"")
                    }
                }
                append_line(out, indent, c"}")
                return make_block_result(else_i + 1, STOP_EOF, c"")
            }
        }
    }
    append_line(out, indent, c"}")
    return make_block_result(next_i, STOP_EOF, c"")
}

fn translate_if_statement(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    if line_opt is some line_val {
        return translate_if_text(
            lines,
            current_dir,
            start,
            trim_cstr(line_val as ref u8),
            indent,
            out,
            ctx
        )
    } else {
        return make_block_result(start + 1, STOP_EOF, c"")
    }
}

fn is_switch_break_line(text: ref u8) bool = {
    val trimmed: ref u8 = strip_trailing_semicolon(trim_cstr(text))
    return cstr.cmp(trimmed, c"break") == 0
}

fn render_switch_case_condition(
    ctx: ref TranslationCtx,
    switch_expr: ref u8,
    labels: list[ref u8]
) ref u8 = {
    val sb: ref void = builder.StringBuilder.new()
    val first: mut bool = true
    for label in labels {
        if !first {
            trust builder.StringBuilder.append_cstr(sb, c" || ")
        }
        trust builder.StringBuilder.append_cstr(
            sb,
            tfmt("{s} == {s}", {switch_expr, translate_expr_text(ctx, label)})
        )
        first = false
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn translate_switch_statement(
    lines: list[ref u8],
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    match line_opt {
        none => {
            return make_block_result(start + 1, STOP_EOF, c"")
        }
        some line_val => {
            val line: ref u8 = trim_cstr(line_val as ref u8)
            val open_i: i64 = find_char(line, 40 as u8)
            val close_i: i64 = find_matching_delim(line, open_i, 40 as u8, 41 as u8)
            if open_i < 0 || close_i <= open_i {
                append_comment_line(out, indent, line)
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            val switch_expr: ref u8 = lower_incdec_expr(
                ctx,
                trim_cstr(trust tsubstr(line, open_i + 1, close_i - open_i - 1)),
                indent,
                out
            ).expr
            val body_start: mut i64 = start
            val tail: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    close_i + 1,
                    cstr.len(line) - close_i - 1
                ))
            if !cstr.starts_with(tail, c"{") {
                body_start = next_significant_line(lines, start + 1)
            }
            if body_start < 0 {
                append_comment_line(out, indent, line)
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            val span: ref BlockResult = collect_brace_block(lines, body_start)
            val full_text: ref u8 = join_lines(lines, body_start, span.next_index)
            val brace_i: i64 = find_char(full_text, 123 as u8)
            val close_b: i64 = find_last_char(full_text, 125 as u8)
            if brace_i < 0 || close_b <= brace_i {
                append_comment_line(out, indent, line)
                return span
            }
            val body_text: ref u8 = trust tsubstr(
                full_text,
                brace_i + 1,
                close_b - brace_i - 1
            )
            val body_lines = split_lines(body_text)
            val cases: mut list[ref SwitchCase] = mem.new[ref SwitchCase]()
            val current: mut ref SwitchCase = none
            for raw_line in body_lines {
                val trimmed: ref u8 = trim_cstr(raw_line)
                if cstr.cmp(trimmed, c"") == 0 {
                    if (current != none) {
                        if ((@len(current.body_lines) as i64) > 0) {
                            @append(current.body_lines, raw_line)
                        }
                    }
                    continue
                }
                if cstr.starts_with(trimmed, c"case ") {
                    val colon_i: i64 = find_char(trimmed, 58 as u8)
                    if colon_i > 5 {
                        val label: ref u8 = trim_cstr(trust tsubstr(trimmed, 5, colon_i - 5))
                        val tail2: ref u8 = trim_cstr(trust tsubstr(
                                trimmed,
                                colon_i + 1,
                                cstr.len(trimmed) - colon_i - 1
                            ))
                        if current != none {
                            if !current.is_default && (@len(current.body_lines) as i64) == 0 {
                                @append(current.labels, label)
                                if cstr.cmp(tail2, c"") != 0 && !is_switch_break_line(tail2) {
                                    @append(current.body_lines, tail2)
                                }
                                continue
                            }
                        }
                        if current != none {
                            @append(cases, current)
                        }
                        current = make_switch_case()
                        @append(current.labels, label)
                        if cstr.cmp(tail2, c"") != 0 && !is_switch_break_line(tail2) {
                            @append(current.body_lines, tail2)
                        }
                        continue
                    }
                }
                if cstr.starts_with(trimmed, c"default:") {
                    val tail3: ref u8 = trim_cstr(trust tsubstr(
                            trimmed,
                            8,
                            cstr.len(trimmed) - 8
                        ))
                    if current != none {
                        @append(cases, current)
                    }
                    current = make_switch_case()
                    current.is_default = true
                    if cstr.cmp(tail3, c"") != 0 && !is_switch_break_line(tail3) {
                        @append(current.body_lines, tail3)
                    }
                    continue
                }
                if current != none {
                    if is_switch_break_line(trimmed) {
                        continue
                    }
                    @append(current.body_lines, raw_line)
                }
            }
            if current != none {
                @append(cases, current)
            }
            val emitted_any: mut bool = false
            for case_item in cases {
                if case_item.is_default {
                    if emitted_any {
                        append_line(out, indent, c"} else {")
                    } else {
                        append_line(out, indent, c"if (true) {")
                    }
                } else {
                    val cond_text: ref u8 = render_switch_case_condition(
                        ctx,
                        switch_expr,
                        case_item.labels
                    )
                    if emitted_any {
                        append_line(out, indent, trust tfmt("} elif ({s}) {", {cond_text}))
                    } else {
                        append_line(out, indent, trust tfmt("if ({s}) {", {cond_text}))
                    }
                }
                translate_body_lines(case_item.body_lines, c"", 0, indent + 1, out, ctx)
                emitted_any = true
            }
            if emitted_any {
                append_line(out, indent, c"}")
            } else {
                append_comment_line(out, indent, line)
            }
            return span
        }
    }
}

fn translate_do_while_loop(
    lines: list[ref u8],
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    match line_opt {
        none => {
            return make_block_result(start + 1, STOP_EOF, c"")
        }
        some line_val => {
            val line: ref u8 = trim_cstr(line_val as ref u8)
            val body_start: mut i64 = start
            val tail_after_do: ref u8 = trim_cstr(trust tsubstr(
                    line,
                    2,
                    cstr.len(line) - 2
                ))
            if !cstr.starts_with(tail_after_do, c"{") {
                body_start = next_significant_line(lines, start + 1)
            }
            if body_start < 0 {
                append_comment_line(out, indent, line)
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            val body_span: ref BlockResult = collect_brace_block(lines, body_start)
            val body_full: ref u8 = join_lines(lines, body_start, body_span.next_index)
            val brace_i: i64 = find_char(body_full, 123 as u8)
            val close_b: i64 = find_last_char(body_full, 125 as u8)
            if brace_i < 0 || close_b <= brace_i {
                append_comment_line(out, indent, line)
                return body_span
            }
            val while_line: mut ref u8 = trim_cstr(trust tsubstr(
                    body_full,
                    close_b + 1,
                    cstr.len(body_full) - close_b - 1
                ))
            val next_i: mut i64 = body_span.next_index
            if !starts_keyword_paren(while_line, c"while") {
                val while_i: i64 = next_significant_line(lines, body_span.next_index)
                if while_i < 0 {
                    append_comment_line(out, indent, line)
                    return body_span
                }
                val while_opt = @get(lines, while_i as usize)
                if while_opt is some while_val {
                    while_line = trim_cstr(while_val as ref u8)
                    next_i = while_i + 1
                }
            }
            val open_i: i64 = find_char(while_line, 40 as u8)
            val close_i: i64 = find_matching_delim(while_line, open_i, 40 as u8, 41 as u8)
            if open_i < 0 || close_i <= open_i {
                append_comment_line(out, indent, line)
                return make_block_result(next_i, STOP_EOF, c"")
            }
            val cond_out: ref void = builder.StringBuilder.new()
            val cond_text: ref u8 = translate_condition_text(
                ctx,
                trim_cstr(trust tsubstr(while_line, open_i + 1, close_i - open_i - 1)),
                indent + 1,
                cond_out
            )
            val body_text: ref u8 = trust tsubstr(
                body_full,
                brace_i + 1,
                close_b - brace_i - 1
            )
            val body_lines = split_lines(body_text)
            append_line(out, indent, c"for {")
            translate_body_lines(body_lines, c"", 0, indent + 1, out, ctx)
            append_builder(out, cond_out)
            append_line(out, indent + 1, trust tfmt("if ({s}) {", {cond_text}))
            append_line(out, indent + 1, c"} else {")
            append_line(out, indent + 2, c"break")
            append_line(out, indent + 1, c"}")
            append_line(out, indent, c"}")
            return make_block_result(next_i, STOP_EOF, c"")
        }
    }
}

fn translate_statement_at(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val line_opt = @get(lines, start as usize)
    match line_opt {
        none => {
            return make_block_result(start + 1, STOP_EOF, c"")
        }
        some line_val => {
            val trimmed: ref u8 = trim_cstr(line_val as ref u8)
            if starts_keyword_paren(trimmed, c"for") {
                return translate_for_loop(lines, current_dir, start, indent, out, ctx)
            }
            if starts_keyword_paren(trimmed, c"while") {
                return translate_while_loop(lines, current_dir, start, indent, out, ctx)
            }
            if starts_keyword_paren(trimmed, c"if") {
                return translate_if_statement(lines, current_dir, start, indent, out, ctx)
            }
            if starts_keyword_paren(trimmed, c"switch") {
                return translate_switch_statement(lines, start, indent, out, ctx)
            }
            if starts_do_statement(trimmed) {
                return translate_do_while_loop(lines, start, indent, out, ctx)
            }
            if translate_body_statement(ctx, trimmed, indent, out) {
                return make_block_result(start + 1, STOP_EOF, c"")
            }
            append_comment_line(out, indent, trimmed)
            return make_block_result(start + 1, STOP_EOF, c"")
        }
    }
}

fn parse_function_pointer_param_name(text: ref u8, fallback_name: ref u8) ref u8 = {
    val open_i: i64 = find_char(text, 40 as u8)
    if open_i < 0 {
        return fallback_name
    }
    val star_i: mut i64 = open_i + 1
    val len: i64 = cstr.len(text)
    for {
        if star_i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, star_i)) as u8
        if c == 42 {
            break
        }
        if !is_space(c) {
            return fallback_name
        }
        star_i++
    }
    if star_i >= len {
        return fallback_name
    }
    val name_start: mut i64 = star_i + 1
    for {
        if name_start >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, name_start)) as u8
        if is_ident_start(c) {
            break
        }
        name_start++
    }
    if name_start >= len {
        return fallback_name
    }
    val name_end: mut i64 = name_start
    for {
        if name_end >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, name_end)) as u8
        if !is_ident_part(c) {
            break
        }
        name_end++
    }
    return sanitize_identifier(trust tsubstr(text, name_start, name_end - name_start))
}

fn find_top_level_assign(text: ref u8) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif c == 61 && paren == 0 && brace == 0 && bracket == 0 {
            val prev: mut u8 = 0
            val next: mut u8 = 0
            if i > 0 {
                prev = trust @load8(@ptradd(text, i - 1)) as u8
            }
            if i + 1 < len {
                next = trust @load8(@ptradd(text, i + 1)) as u8
            }
            if prev != 61 && prev != 33 && prev != 60 && prev != 62
            && prev != 43 && prev != 45 && prev != 42 && prev != 47
            && prev != 37 && prev != 38 && prev != 124 && prev != 94
            && next != 61 {
                return i
            }
        }
        i++
    }
    return -1
}

fn find_top_level_compound_assign(text: ref u8) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i + 1 >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        val next: u8 = trust @load8(@ptradd(text, i + 1)) as u8
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif next == 61 && paren == 0 && brace == 0 && bracket == 0
        && (c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124 || c == 94) {
            return i
        }
        i++
    }
    return -1
}

fn translate_designated_initializer(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    if !cstr.starts_with(trimmed, c"{") {
        return trimmed
    }
    if !str_contains(trimmed, c".") {
        return trimmed
    }
    val sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(trimmed)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if c == 46 && i + 1 < len {
            val next: u8 = trust @load8(@ptradd(trimmed, i + 1)) as u8
            if is_ident_start(next) {
                i++
                val start: i64 = i
                for {
                    if i >= len {
                        break
                    }
                    val cc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    if !is_ident_part(cc) {
                        break
                    }
                    i++
                }
                val field: ref u8 = trust tsubstr(trimmed, start, i - start)
                trust builder.StringBuilder.append_cstr(sb, field)
                for {
                    if i >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    if !is_space(ws) {
                        break
                    }
                    i++
                }
                if i < len {
                    val eq: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    if eq == 61 {
                        trust builder.StringBuilder.append_cstr(sb, c": ")
                        i++
                        continue
                    }
                }
                continue
            }
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn translate_sizeof_expr(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if i + 7 <= len {
            val maybe_kw: ref u8 = trust tsubstr(trimmed, i, 6)
            if cstr.cmp(maybe_kw, c"sizeof") == 0 {
                val after_kw: mut i64 = i + 6
                for {
                    if after_kw >= len {
                        break
                    }
                    val ws: u8 = trust @load8(@ptradd(trimmed, after_kw)) as u8
                    if !is_space(ws) {
                        break
                    }
                    after_kw++
                }
                if after_kw < len && (trust @load8(@ptradd(trimmed, after_kw)) as u8) == 40 {
                    val close_i: mut i64 = after_kw + 1
                    val depth: mut i64 = 1
                    for {
                        if close_i >= len {
                            break
                        }
                        val cc: u8 = trust @load8(@ptradd(trimmed, close_i)) as u8
                        if cc == 40 {
                            depth++
                        } elif cc == 41 {
                            depth--
                            if depth == 0 {
                                break
                            }
                        }
                        close_i++
                    }
                    if close_i < len {
                        val inner: ref u8 = trim_cstr(trust tsubstr(
                                trimmed,
                                after_kw + 1,
                                close_i - after_kw - 1
                            ))
                        if is_ident_text(inner) {
                            if lookup_local_array_type(ctx, inner) is some array_size_expr {
                                trust builder.StringBuilder.append_cstr(
                                    sb,
                                    array_size_expr as ref u8
                                )
                                i = close_i + 1
                                continue
                            }
                        }
                        val index_target: ref u8 = parse_index_target(inner)
                        if cstr.cmp(index_target, c"") != 0 {
                            val elem_type: ref u8 = lookup_index_element_type(ctx, index_target)
                            if cstr.cmp(elem_type, c"") != 0 {
                                trust builder.StringBuilder.append_cstr(
                                    sb,
                                    tfmt("@sizeof({s})", {elem_type})
                                )
                                i = close_i + 1
                                continue
                            }
                        }
                        val mapped: ref u8 = translate_c_type_ctx(ctx, inner, c"")
                        trust builder.StringBuilder.append_cstr(
                            sb,
                            tfmt("@sizeof({s})", {mapped})
                        )
                        i = close_i + 1
                        continue
                    }
                }
            }
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn scan_cast_operand_end(text: ref u8, start: i64) i64 = {
    val len: i64 = cstr.len(text)
    if start < 0 || start >= len {
        return start
    }
    val first: u8 = trust @load8(@ptradd(text, start)) as u8
    if first >= 48 && first <= 57 {
        val i: mut i64 = start + 1
        for {
            if i >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(text, i)) as u8
            if !is_ident_part(c) && c != 46 {
                break
            }
            i++
        }
        return i
    }
    val base_end: i64 = scan_deref_operand_end(text, start)
    if base_end <= start {
        return start
    }
    val j: mut i64 = base_end
    for {
        if j >= len {
            break
        }
        val ws: u8 = trust @load8(@ptradd(text, j)) as u8
        if !is_space(ws) {
            break
        }
        j++
    }
    if j < len && (trust @load8(@ptradd(text, j)) as u8) == 40 {
        val call_close: i64 = find_matching_delim(text, j, 40 as u8, 41 as u8)
        if call_close > j {
            return call_close + 1
        }
    }
    return base_end
}

fn translate_c_casts_in_expr(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        if in_string {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            trust builder.StringBuilder.append_char(sb, c)
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if c == 39 {
            in_char = true
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        if c == 40 {
            val prev_is_ident: mut bool = false
            val j: mut i64 = i - 1
            for {
                if j < 0 {
                    break
                }
                val pc: u8 = trust @load8(@ptradd(trimmed, j)) as u8
                if !is_space(pc) {
                    prev_is_ident = is_ident_part(pc)
                    break
                }
                j--
            }
            if !prev_is_ident {
                val close_i: i64 = find_matching_delim(trimmed, i, 40 as u8, 41 as u8)
                if close_i > i {
                    val inner: ref u8 = trim_cstr(trust tsubstr(
                            trimmed,
                            i + 1,
                            close_i - i - 1
                        ))
                    if is_probable_c_type(inner) && is_known_c_type_name(
                        ctx,
                        normalize_type_phrase(inner)
                    ) {
                        val op_start: mut i64 = close_i + 1
                        for {
                            if op_start >= len {
                                break
                            }
                            val ws: u8 = trust @load8(@ptradd(trimmed, op_start)) as u8
                            if !is_space(ws) {
                                break
                            }
                            op_start++
                        }
                        if op_start < len {
                            val op_end: i64 = scan_cast_operand_end(trimmed, op_start)
                            if op_end > op_start {
                                val operand: ref u8 = trim_cstr(trust tsubstr(
                                        trimmed,
                                        op_start,
                                        op_end - op_start
                                    ))
                                val mapped: ref u8 = translate_c_type_ctx(ctx, inner, c"")
                                val translated_op: ref u8 = translate_expr_text(ctx, operand)
                                if (cstr.starts_with(mapped, c"ref ")
                                    || cstr.starts_with(mapped, c"mut ref "))
                                && cstr.cmp(trim_cstr(operand), c"0") == 0 {
                                    trust builder.StringBuilder.append_cstr(sb, c"none")
                                } else {
                                    trust builder.StringBuilder.append_cstr(sb, translated_op)
                                    trust builder.StringBuilder.append_cstr(
                                        sb,
                                        tfmt(" as {s}", {mapped})
                                    )
                                }
                                i = op_end
                                continue
                            }
                        }
                    }
                }
            }
        }
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trim_cstr(trust take_cstr(built))
}

fn find_top_level_equality(text: ref u8) i64 = {
    val len: i64 = cstr.len(text)
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i + 1 >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        val next: u8 = trust @load8(@ptradd(text, i + 1)) as u8
        if c == 40 {
            paren++
        } elif c == 41 && paren > 0 {
            paren--
        } elif c == 123 {
            brace++
        } elif c == 125 && brace > 0 {
            brace--
        } elif c == 91 {
            bracket++
        } elif c == 93 && bracket > 0 {
            bracket--
        } elif paren == 0 && brace == 0 && bracket == 0
        && ((c == 61 && next == 61) || (c == 33 && next == 61)) {
            return i
        }
        i++
    }
    return -1
}

fn is_null_pointer_text(text: ref u8) bool = {
    val current: ref u8 = trim_cstr(unwrap_outer_parens(text))
    val flat: ref u8 = flatten_ws(current)
    if cstr.cmp(flat, c"NULL") == 0
    || cstr.cmp(flat, c"nullptr") == 0 {
        return true
    }
    val sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(flat)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(flat, i)) as u8
        if !is_space(c) {
            trust builder.StringBuilder.append_char(sb, c)
        }
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    val compact: ref u8 = trust take_cstr(built)
    return cstr.cmp(compact, c"(void*)0") == 0
}

fn rewrite_null_comparison(ctx: ref TranslationCtx, text: ref u8) option[ref u8] = {
    val trimmed: ref u8 = trim_cstr(text)
    val cmp_i: i64 = find_top_level_equality(trimmed)
    if cmp_i < 0 {
        return none
    }
    val lhs_raw: ref u8 = trim_cstr(trust tsubstr(trimmed, 0, cmp_i))
    val rhs_raw: ref u8 = trim_cstr(trust tsubstr(
            trimmed,
            cmp_i + 2,
            cstr.len(trimmed) - cmp_i - 2
        ))
    val expr_side: mut ref u8 = c""
    if is_null_pointer_text(lhs_raw) {
        expr_side = rhs_raw
    } elif is_null_pointer_text(rhs_raw) {
        expr_side = lhs_raw
    } else {
        return none
    }
    val translated_expr: ref u8 = translate_expr_text(ctx, expr_side)
    val op: u8 = trust @load8(@ptradd(trimmed, cmp_i)) as u8
    if op == 61 {
        return some trust tfmt("{s} == none", {translated_expr})
    }
    return some trust tfmt("{s} != none", {translated_expr})
}

fn emit_condition_assignment(
    ctx: mut ref TranslationCtx,
    lhs: ref u8,
    rhs: ref u8,
    indent: i64,
    out: ref void
) ref u8 = {
    val lhs_arrow: ref u8 = replace_arrow_access(lhs)
    val lhs_rewritten: ref u8 = rewrite_identifiers(translate_addr_deref_expr(ctx, lhs_arrow))
    val lowered_rhs: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
    val rhs_expr0: ref u8 = lowered_rhs.expr
    val rhs_expr: mut ref u8 = rhs_expr0
    if is_null_pointer_text(rhs) {
        rhs_expr = c"none"
    }
    val index_target: ref u8 = parse_index_target(lhs_rewritten)
    if cstr.cmp(index_target, c"") != 0 {
        val index_expr: ref u8 = parse_index_expr(lhs_rewritten)
        val index_ptr: ref u8 = render_index_ptr_expr(ctx, index_target, index_expr)
        track_called_expr(ctx, rhs_expr)
        append_line(out, indent, trust tfmt("@store({s}, {s})", {index_ptr, rhs_expr}))
        return trust tfmt("@load({s})", {index_ptr})
    }
    track_called_expr(ctx, rhs_expr)
    append_line(out, indent, trust tfmt("{s} = {s}", {lhs_rewritten, rhs_expr}))
    return lhs_rewritten
}

fn rewrite_condition_assignments(
    ctx: mut ref TranslationCtx,
    text: ref u8,
    indent: i64,
    out: ref void
) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val inner: ref u8 = unwrap_outer_parens(trimmed)
    val cmp_i: i64 = find_top_level_equality(inner)
    if cmp_i >= 0 {
        val lhs: ref u8 = trim_cstr(trust tsubstr(inner, 0, cmp_i))
        val rhs: ref u8 = trim_cstr(trust tsubstr(
                inner,
                cmp_i + 2,
                cstr.len(inner) - cmp_i - 2
            ))
        val lhs_rewritten: ref u8 = rewrite_condition_assignments(ctx, lhs, indent, out)
        val rhs_rewritten: ref u8 = rewrite_condition_assignments(ctx, rhs, indent, out)
        val op: ref u8 = trust tsubstr(inner, cmp_i, 2)
        return trust tfmt("{s} {s} {s}", {lhs_rewritten, op, rhs_rewritten})
    }
    val assign_i: i64 = find_top_level_assign(inner)
    if assign_i > 0 {
        val lhs_assign: ref u8 = trim_cstr(trust tsubstr(inner, 0, assign_i))
        val rhs_assign: ref u8 = trim_cstr(trust tsubstr(
                inner,
                assign_i + 1,
                cstr.len(inner) - assign_i - 1
            ))
        if !str_contains(lhs_assign, c" ") {
            return emit_condition_assignment(ctx, lhs_assign, rhs_assign, indent, out)
        }
    }
    return trimmed
}

fn translate_expr_text(ctx: ref TranslationCtx, text: ref u8) ref u8 = {
    val no_semicolon: ref u8 = strip_trailing_semicolon(text)
    val with_init: ref u8 = translate_designated_initializer(no_semicolon)
    val with_sizeof: ref u8 = translate_sizeof_expr(ctx, with_init)
    val with_arrow: ref u8 = replace_arrow_access(with_sizeof)
    val with_qualified_enums: ref u8 = qualify_enum_constants(ctx, with_arrow)
    val with_rewritten: ref u8 = rewrite_identifiers(with_qualified_enums)
    val with_addr_deref: ref u8 = translate_addr_deref_expr(ctx, with_rewritten)
    val with_casts: ref u8 = translate_c_casts_in_expr(ctx, with_addr_deref)
    val with_indexing2: ref u8 = replace_pointer_indexing(ctx, with_casts)
    val with_intrinsics: ref u8 = ensure_intrinsic_prefixes(with_indexing2)
    val normalized_intrinsics: ref u8 = normalize_intrinsic_prefixes(with_intrinsics)
    if str_contains(normalized_intrinsics, c"(") {
        return transform_call_expr(ctx, normalized_intrinsics)
    }
    return normalized_intrinsics
}

fn translate_condition_text(
    ctx: mut ref TranslationCtx,
    text: ref u8,
    indent: i64,
    out: ref void
) ref u8 = {
    val condition_src: mut ref u8 = text
    if contains_incdec_ops(text) {
        val lowered_text: ref LoweredExpr = lower_incdec_text(ctx, text, indent, out)
        condition_src = lowered_text.expr
    }
    val rewritten_assigns: ref u8 = rewrite_condition_assignments(ctx, condition_src, indent, out)
    if rewrite_null_comparison(ctx, rewritten_assigns) is some translated {
        return translated as ref u8
    }
    return translate_expr_text(ctx, rewritten_assigns)
}

fn translate_body_statement(
    ctx: mut ref TranslationCtx,
    line: ref u8,
    indent: i64,
    out: ref void
) bool = {
    val stripped: ref u8 = strip_trailing_semicolon(line)
    if cstr.cmp(stripped, c"") == 0 {
        append_blank_line(out)
        return true
    }
    val multi_decls = split_multi_decl(ctx, stripped)
    if ((@len(multi_decls) as i64) > 1) {
        for decl_text in multi_decls {
            translate_body_statement(ctx, decl_text, indent, out)
        }
        return true
    }
    if cstr.starts_with(stripped, c"return") {
        val tail: ref u8 = trim_cstr(trust tsubstr(stripped, 6, cstr.len(stripped) - 6))
        if cstr.cmp(tail, c"") == 0 {
            append_line(out, indent, c"return")
        } else {
            if contains_incdec_ops(tail) {
                append_blank_line(out)
            }
            val lowered_ret: ref LoweredExpr = lower_incdec_expr(ctx, tail, indent, out)
            if lowered_ret.changed {
                append_blank_line(out)
            }
            append_line(out, indent, trust tfmt("return {s}", {lowered_ret.expr}))
        }
        return true
    }
    val simple_incdec_stmt: ref u8 = normalize_simple_incdec_stmt(stripped)
    if cstr.cmp(simple_incdec_stmt, c"") != 0 {
        append_line(out, indent, simple_incdec_stmt)
        return true
    }
    val deref_incdec_stmt: ref u8 = normalize_deref_incdec_stmt(stripped)
    if cstr.cmp(deref_incdec_stmt, c"") != 0 {
        append_line(out, indent, deref_incdec_stmt)
        return true
    }
    val compound_i: i64 = find_top_level_compound_assign(stripped)
    if compound_i > 0 {
        val lhs: ref u8 = trim_cstr(trust tsubstr(stripped, 0, compound_i))
        val op: ref u8 = trust tsubstr(stripped, compound_i, 1)
        val rhs: ref u8 = trim_cstr(trust tsubstr(
                stripped,
                compound_i + 2,
                cstr.len(stripped) - compound_i - 2
            ))
        val rhs_expr_compound: ref u8 = lower_incdec_expr(ctx, rhs, indent, out).expr
        append_line(out, indent, trust tfmt("{s} {s}= {s}", {
                    translate_expr_text(ctx, lhs),
                    op,
                    rhs_expr_compound
                }))
        return true
    }
    val assign_i: i64 = find_top_level_assign(stripped)
    if assign_i > 0 {
        val lhs: ref u8 = trim_cstr(trust tsubstr(stripped, 0, assign_i))
        val rhs: ref u8 = trim_cstr(trust tsubstr(
                stripped,
                assign_i + 1,
                cstr.len(stripped) - assign_i - 1
            ))
        val can_be_decl: bool = str_contains(lhs, c" ")
        || cstr.starts_with(lhs, c"struct ") || cstr.starts_with(lhs, c"enum ")
        if can_be_decl {
            val decl: ref DeclInfo = parse_named_decl(ctx, lhs, c"")
            if decl.its_ok && cstr.cmp(
                decl.name,
                c""
            ) != 0 && cstr.cmp(trim_cstr(decl.type_src), c"") != 0 {
                if is_array_type_name(decl.type_name) {
                    if is_unsized_char_array(decl.type_name) && is_string_literal_text(rhs) {
                        val decayed_type0: ref u8 = decay_array_type(decl.type_name)
                        val lowered_rhs0: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
                        val rhs_expr0: ref u8 = lowered_rhs0.expr
                        remember_local_type(ctx, decl.name, decayed_type0)
                        track_called_expr(ctx, rhs_expr0)
                        append_line(
                            out,
                            indent,
                            trust tfmt(
                                "val {s}: {s} = {s}",
                                {
                                    decl.name,
                                    render_binding_type(ctx, decl.name, decayed_type0),
                                    rhs_expr0
                                }
                            )
                        )
                        return true
                    }
                    val array_init_items = parse_brace_initializer_items(rhs)
                    val elem_type: ref u8 = array_type_elem(decl.type_name)
                    val alloc_expr: mut ref u8 = array_alloc_expr(decl.type_name)
                    if cstr.cmp(
                        array_type_len_expr(decl.type_name),
                        c""
                    ) == 0 && (@len(array_init_items) as i64) > 0 {
                        alloc_expr = trust tfmt(
                            "{d} * @sizeof({s})",
                            {@len(array_init_items) as i64, elem_type}
                        )
                    }
                    val decayed_type: ref u8 = decay_array_type(decl.type_name)
                    val is_char_array_literal: bool = cstr.cmp(
                        array_type_elem(decl.type_name),
                        c"u8"
                    ) == 0 && is_string_literal_text(rhs)
                    remember_local_type(ctx, decl.name, decayed_type)
                    remember_local_array_type(ctx, decl.name, alloc_expr)
                    append_line(
                        out,
                        indent,
                        trust tfmt(
                            "val {s}: {s} = @alloc({s})",
                            {
                                decl.name,
                                render_binding_type(ctx, decl.name, decayed_type),
                                alloc_expr
                            }
                        )
                    )
                    if is_char_array_literal {
                        val lowered_rhs_char: ref LoweredExpr = lower_incdec_expr(
                            ctx,
                            rhs,
                            indent,
                            out
                        )
                        val rhs_expr_char: ref u8 = lowered_rhs_char.expr
                        val copy_len: i64 = string_literal_storage_len(rhs)
                        append_line(
                            out,
                            indent,
                            trust tfmt(
                                "@memset({s} as ref void, 0, {s})",
                                {decl.name, alloc_expr}
                            )
                        )
                        append_line(
                            out,
                            indent,
                            trust tfmt(
                                "@memcpy({s} as ref void, {s} as ref void, {d} as usize)",
                                {decl.name, rhs_expr_char, copy_len}
                            )
                        )
                        track_called_expr(ctx, rhs_expr_char)
                    }
                    if ((@len(array_init_items) as i64) > 0) {
                        emit_array_initializer_stores(ctx, out, indent, decl.name, array_init_items)
                    }
                    return true
                }
                if is_address_taken_name(
                    ctx,
                    decl.name
                ) && !cstr.starts_with(decl.type_name, c"ref ") {
                    val ref_type: ref u8 = trust tfmt("ref {s}", {decl.type_name})
                    remember_local_type(ctx, decl.name, ref_type)
                    append_line(
                        out,
                        indent,
                        trust tfmt(
                            "val {s}: {s} = @alloc(@sizeof({s}))",
                            {
                                decl.name,
                                render_binding_type(ctx, decl.name, ref_type),
                                decl.type_name
                            }
                        )
                    )
                    val lowered_rhs_addr: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
                    val rhs_expr_addr: mut ref u8 = lowered_rhs_addr.expr
                    if is_null_pointer_text(rhs) {
                        rhs_expr_addr = c"none"
                    }
                    track_called_expr(ctx, rhs_expr_addr)
                    append_line(
                        out,
                        indent,
                        trust tfmt("@deref({s}) = {s}", {decl.name, rhs_expr_addr})
                    )
                    return true
                }
                val has_incdec_rhs: bool = contains_incdec_ops(rhs)
                if has_incdec_rhs {
                    append_blank_line(out)
                    append_comment_line(out, indent, trust tfmt("{s} = {s}", {decl.name, rhs}))
                }
                val lowered_rhs: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
                val rhs_expr0: ref u8 = lowered_rhs.expr
                val rhs_expr: mut ref u8 = rhs_expr0
                if is_null_pointer_text(rhs) {
                    rhs_expr = c"none"
                }
                remember_local_type(ctx, decl.name, decl.type_name)
                val rendered_type: ref u8 = render_binding_type(ctx, decl.name, decl.type_name)
                val ternary_src: ref u8 = unwrap_outer_parens(rhs_expr)
                val q_i: i64 = find_top_level_ternary(ternary_src)
                if q_i >= 0 {
                    val colon_i: i64 = find_matching_colon_for_ternary(ternary_src, q_i)
                    if colon_i > q_i {
                        mark_mutable_name(ctx, decl.name)
                        val cond: ref u8 = unwrap_outer_parens(trim_cstr(trust tsubstr(
                                    ternary_src,
                                    0,
                                    q_i
                                )))
                        val if_true: ref u8 = unwrap_outer_parens(trim_cstr(trust tsubstr(
                                    ternary_src,
                                    q_i + 1,
                                    colon_i - q_i - 1
                                )))
                        val if_false: ref u8 = unwrap_outer_parens(trim_cstr(trust tsubstr(
                                    ternary_src,
                                    colon_i + 1,
                                    cstr.len(ternary_src) - colon_i - 1
                                )))
                        append_line(
                            out,
                            indent,
                            trust tfmt(
                                "val {s}: {s} = {s}",
                                {decl.name, render_mutable_type(decl.type_name), if_false}
                            )
                        )
                        val if_line1: ref u8 = trust tfmt("if ({s}) ", {cond})
                        val if_line2: ref u8 = trust tconcat(if_line1, c"{ ")
                        val if_line3: ref u8 = trust tfmt("{s} = {s}", {decl.name, if_true})
                        val if_line4: ref u8 = trust tconcat(if_line2, if_line3)
                        val if_line5: ref u8 = trust tconcat(if_line4, c" }")
                        append_line(out, indent, if_line5)
                        return true
                    }
                }
                track_called_expr(ctx, rhs_expr)
                append_line(
                    out,
                    indent,
                    trust tfmt("val {s}: {s} = {s}", {decl.name, rendered_type, rhs_expr})
                )
                if cstr.starts_with(decl.type_name, c"ref ")
                && cstr.starts_with(rhs_expr, c"@alloc(") {
                    val struct_name: ref u8 = trust @ptradd(decl.type_name, 4)
                    if lookup_flex_field_name(ctx, struct_name) is some flex_field {
                        if lookup_flex_field_type(ctx, struct_name) is some flex_type {
                            append_blank_line(out)
                            append_line(out, indent, trust tfmt("{s}.{s} = @ptradd({s} as ref i8, @sizeof({s})) as {s}",
                                    {
                                        decl.name,
                                        flex_field as ref u8,
                                        decl.name,
                                        struct_name,
                                        flex_type as ref u8
                                    }))
                        }
                    }
                }
                if lowered_rhs.changed {
                    append_blank_line(out)
                }
                return true
            }
        }
        val lhs_arrow: ref u8 = replace_arrow_access(lhs)
        val lhs_rewritten: ref u8 = rewrite_identifiers(translate_addr_deref_expr(ctx, lhs_arrow))
        val index_target: ref u8 = parse_index_target(lhs_rewritten)
        if cstr.cmp(index_target, c"") != 0 {
            val index_expr: ref u8 = parse_index_expr(lhs_rewritten)
            val index_ptr: ref u8 = render_index_ptr_expr(ctx, index_target, index_expr)
            val has_incdec_rhs2: bool = contains_incdec_ops(rhs)
            if has_incdec_rhs2 {
                append_blank_line(out)
                append_comment_line(out, indent, trust tfmt("{s} = {s}", {lhs_rewritten, rhs}))
            }
            val lowered_rhs2: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
            val rhs_expr2: ref u8 = lowered_rhs2.expr
            track_called_expr(ctx, rhs_expr2)
            append_line(out, indent, trust tfmt("@store({s}, {s})", {index_ptr, rhs_expr2}))
            if lowered_rhs2.changed {
                append_blank_line(out)
            }
            return true
        }
        val has_incdec_rhs3: bool = contains_incdec_ops(rhs)
        if has_incdec_rhs3 {
            append_blank_line(out)
            append_comment_line(out, indent, trust tfmt("{s} = {s}", {lhs_rewritten, rhs}))
        }
        val lowered_rhs3: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
        val rhs_expr3_0: ref u8 = lowered_rhs3.expr
        val rhs_expr3: mut ref u8 = rhs_expr3_0
        if is_null_pointer_text(rhs) {
            rhs_expr3 = c"none"
        }
        track_called_expr(ctx, rhs_expr3)
        append_line(out, indent, trust tfmt("{s} = {s}", {lhs_rewritten, rhs_expr3}))
        if lowered_rhs3.changed {
            append_blank_line(out)
        }
        return true
    }
    val can_be_bare_decl: bool = (str_contains(stripped, c" ") || str_contains(stripped, c"*")
        || cstr.starts_with(stripped, c"struct ") || cstr.starts_with(stripped, c"enum "))
    && !str_contains(stripped, c"(")
    if can_be_bare_decl {
        val decl2: ref DeclInfo = parse_named_decl(ctx, stripped, c"")
        if decl2.its_ok && cstr.cmp(decl2.name, c"") != 0 {
            if is_array_type_name(decl2.type_name) {
                val alloc_expr2: ref u8 = array_alloc_expr(decl2.type_name)
                val decayed_type2: ref u8 = decay_array_type(decl2.type_name)
                remember_local_type(ctx, decl2.name, decayed_type2)
                remember_local_array_type(ctx, decl2.name, alloc_expr2)
                append_line(
                    out,
                    indent,
                    trust tfmt(
                        "val {s}: {s} = @alloc({s})",
                        {
                            decl2.name,
                            render_binding_type(ctx, decl2.name, decayed_type2),
                            alloc_expr2
                        }
                    )
                )
                return true
            }
            if is_address_taken_name(
                ctx,
                decl2.name
            ) && !cstr.starts_with(decl2.type_name, c"ref ") {
                val ref_type2: ref u8 = trust tfmt("ref {s}", {decl2.type_name})
                remember_local_type(ctx, decl2.name, ref_type2)
                append_line(
                    out,
                    indent,
                    trust tfmt(
                        "val {s}: {s} = @alloc(@sizeof({s}))",
                        {
                            decl2.name,
                            render_binding_type(ctx, decl2.name, ref_type2),
                            decl2.type_name
                        }
                    )
                )
                return true
            }
            remember_local_type(ctx, decl2.name, decl2.type_name)
            append_line(
                out,
                indent,
                trust tfmt(
                    "val {s}: {s}",
                    {decl2.name, render_binding_type(ctx, decl2.name, decl2.type_name)}
                )
            )
            return true
        }
    }
    if starts_keyword_paren(stripped, c"for") {
        return false
    }
    if starts_keyword_paren(stripped, c"assert") {
        val open_i: i64 = find_char(stripped, 40 as u8)
        val close_i: i64 = find_matching_delim(stripped, open_i, 40 as u8, 41 as u8)
        if open_i >= 0 && close_i > open_i {
            val cond_text: ref u8 = trim_cstr(trust tsubstr(
                    stripped,
                    open_i + 1,
                    close_i - open_i - 1
                ))
            val lowered_cond: ref LoweredExpr = lower_incdec_expr(ctx, cond_text, indent, out)
            append_line(out, indent, trust tfmt("assert {s}", {lowered_cond.expr}))
            return true
        }
    }
    if contains_incdec_ops(stripped) {
        append_line(out, indent, translate_expr_text(ctx, stripped))
        return true
    }
    if str_contains(stripped, c"(")
    && !cstr.starts_with(stripped, c"if")
    && !cstr.starts_with(stripped, c"for")
    && !cstr.starts_with(stripped, c"while")
    && !cstr.starts_with(stripped, c"switch") {
        val lowered_expr: ref LoweredExpr = lower_incdec_expr(ctx, stripped, indent, out)
        val expr: ref u8 = lowered_expr.expr
        track_called_expr(ctx, expr)
        append_line(out, indent, expr)
        return true
    }
    return false
}

fn append_open_block_line(sb: ref void, indent: i64, prefix: ref u8) void = {
    val line: ref u8 = trust tconcat(prefix, c"{")
    append_line(sb, indent, line)
}

fn emit_known_extern(name: ref u8, out: ref void) bool = {
    if cstr.cmp(name, c"assert") == 0 {
        return true
    }
    if cstr.cmp(name, c"assert_value") == 0 {
        return true
    }
    if cstr.cmp(name, c"fprintf") == 0 {
        return true
    }
    if cstr.cmp(name, c"sprintf") == 0 {
        append_line(
            out,
            0,
            c"extern (C, header) fn sprintf(dst: ref u8, fmt: ref u8, ...) i32 = \"sprintf\""
        )
        return true
    }
    if cstr.cmp(name, c"puts") == 0 {
        append_line(out, 0, c"extern (C, header) fn puts(s: ref u8) i32 = \"puts\"")
        return true
    }
    if cstr.cmp(name, c"putchar") == 0 {
        append_line(out, 0, c"extern (C, header) fn putchar(c: i32) i32 = \"putchar\"")
        return true
    }
    if cstr.cmp(name, c"strlen") == 0 {
        append_line(out, 0, c"extern (C, header) fn strlen(s: ref u8) i64 = \"strlen\"")
        return true
    }
    if cstr.cmp(name, c"fgets") == 0 {
        append_line(
            out,
            0,
            c"extern (C, header) fn fgets(dst: ref u8, n: i32, stream: ref void) ref u8 = \"fgets\""
        )
        return true
    }
    if cstr.cmp(name, c"malloc") == 0 {
        append_line(out, 0, c"extern (C, header) fn malloc(size: usize) ref void = \"malloc\"")
        return true
    }
    if cstr.cmp(name, c"free") == 0 {
        append_line(out, 0, c"extern (C, header) fn free(ptr: ref void) void = \"free\"")
        return true
    }
    return false
}

fn emit_generic_extern(ctx: ref TranslationCtx, name: ref u8, out: ref void) bool = {
    val params_text: mut ref u8 = c""
    if lookup_called_signature(ctx, name) is some params_val {
        params_text = params_val as ref u8
    }
    append_line(
        out,
        0,
        trust tfmt("extern (C) fn {s}({s}) i32 = \"{s}\"", {name, params_text, name})
    )
    return true
}

fn append_synthesized_externs(ctx: mut ref TranslationCtx, out: ref void) void = {
    val emitted_any: mut bool = false
    for name in ctx.called_names {
        if list_contains(ctx.defined_names, name) {
            continue
        }
        if list_contains(ctx.extern_names, name) {
            continue
        }
        if emit_known_extern(name, out) || emit_generic_extern(ctx, name, out) {
            push_unique(ctx.extern_names, name)
            emitted_any = true
        }
    }
    if emitted_any {
        append_blank_line(out)
    }
}

fn file_exists(path: ref u8) bool = {
    val file_opt = trust fs.open_cstr(path, c"r")
    if file_opt is some f {
        trust fs.close(f)
        return true
    } else {
        return false
    }
}

fn resolve_include_path(name: ref u8, current_dir: ref u8) option[ref u8] = {
    if cstr.starts_with(name, c"/") {
        if file_exists(name) {
            return some name
        }
        return none
    }
    val local = trust tjoin(current_dir, name)
    if file_exists(local) {
        return some local
    }
    val cwd_candidate = trust tjoin(c".", name)
    if file_exists(cwd_candidate) {
        return some cwd_candidate
    }
    val usr_local = trust tjoin(c"/usr/local/include", name)
    if file_exists(usr_local) {
        return some usr_local
    }
    val usr = trust tjoin(c"/usr/include", name)
    if file_exists(usr) {
        return some usr
    }
    return none
}

fn keyword_ignored(word: ref u8) bool = {
    if cstr.cmp(word, c"const") == 0 {
        return true
    }
    if cstr.cmp(word, c"__const") == 0 {
        return true
    }
    if cstr.cmp(word, c"__const__") == 0 {
        return true
    }
    if cstr.cmp(word, c"volatile") == 0 {
        return true
    }
    if cstr.cmp(word, c"__volatile__") == 0 {
        return true
    }
    if cstr.cmp(word, c"restrict") == 0 {
        return true
    }
    if cstr.cmp(word, c"__restrict") == 0 {
        return true
    }
    if cstr.cmp(word, c"__restrict__") == 0 {
        return true
    }
    if cstr.cmp(word, c"register") == 0 {
        return true
    }
    if cstr.cmp(word, c"static") == 0 {
        return true
    }
    if cstr.cmp(word, c"extern") == 0 {
        return true
    }
    if cstr.cmp(word, c"inline") == 0 {
        return true
    }
    if cstr.cmp(word, c"__inline") == 0 {
        return true
    }
    if cstr.cmp(word, c"__inline__") == 0 {
        return true
    }
    if cstr.cmp(word, c"typedef") == 0 {
        return true
    }
    if cstr.cmp(word, c"signed") == 0 {
        return true
    }
    if cstr.cmp(word, c"__signed__") == 0 {
        return true
    }
    if cstr.cmp(word, c"__extension__") == 0 {
        return true
    }
    return false
}

fn normalize_type_phrase(text: ref u8) ref u8 = {
    val flat: ref u8 = flatten_ws(text)
    val sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(flat)
    val i: mut i64 = 0
    val first: mut bool = true
    for {
        if i >= len {
            break
        }
        for {
            if i >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(flat, i)) as u8
            if !is_space(c) {
                break
            }
            i++
        }
        if i >= len {
            break
        }
        val c0: u8 = trust @load8(@ptradd(flat, i)) as u8
        if c0 == 42 {
            if !first {
                trust builder.StringBuilder.append_char(sb, 32 as u8)
            }
            trust builder.StringBuilder.append_char(sb, 42 as u8)
            first = false
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(flat, i)) as u8
            if is_space(c) || c == 42 {
                break
            }
            i++
        }
        val word: ref u8 = trust tsubstr(flat, start, i - start)
        if !keyword_ignored(word) {
            if !first {
                trust builder.StringBuilder.append_char(sb, 32 as u8)
            }
            trust builder.StringBuilder.append_cstr(sb, word)
            first = false
        }
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trim_cstr(trust take_cstr(built))
}

fn bind_long_type(base: ref u8, target_platform: ref u8, unsigned: bool) ref u8 = {
    val is_ll: bool = str_contains(base, c"long long")
    val is_long: bool = !is_ll && str_contains(base, c"long")
    if !is_long && !is_ll {
        return c""
    }
    if cstr.cmp(base, c"long double") == 0 {
        return c"f64"
    }
    val use_32: bool = is_long && cstr.cmp(target_platform, c"windows") == 0
    if unsigned {
        if use_32 {
            return c"u32"
        }
        return c"u64"
    }
    if use_32 {
        return c"i32"
    }
    return c"i64"
}

fn map_bind_base_type(ctx: ref TranslationCtx, base: ref u8) ref u8 = {
    if cstr.cmp(base, c"char") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"signed char") == 0 {
        return c"i8"
    }
    if cstr.cmp(base, c"unsigned char") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"_Bool") == 0 || cstr.cmp(base, c"bool") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"long double") == 0 {
        return c"f64"
    }
    if cstr.cmp(base, c"wchar_t") == 0 {
        if cstr.cmp(ctx.target_platform, c"windows") == 0 {
            return c"u16"
        }
        return c"i32"
    }
    if cstr.cmp(base, c"ptrdiff_t") == 0 || cstr.cmp(base, c"intptr_t") == 0 {
        return c"isize"
    }
    if cstr.cmp(base, c"uintptr_t") == 0 {
        return c"usize"
    }
    val has_unsigned: bool = str_contains(base, c"unsigned")
    val long_type: ref u8 = bind_long_type(
        base,
        ctx.target_platform,
        has_unsigned
    )
    if cstr.cmp(long_type, c"") != 0 {
        return long_type
    }
    if cstr.starts_with(base, c"enum ") {
        return c"i32"
    }
    if list_contains(ctx.bind_enum_type_names, base) {
        return c"i32"
    }
    return c""
}

fn map_base_type(ctx: ref TranslationCtx, base: ref u8) ref u8 = {
    if cstr.cmp(base, c"") == 0 {
        return c"void"
    }
    if ctx != none && ctx.bind_mode {
        val bind_mapped: ref u8 = map_bind_base_type(ctx, base)
        if cstr.cmp(bind_mapped, c"") != 0 {
            return bind_mapped
        }
    }
    if cstr.cmp(base, c"void") == 0 {
        return c"void"
    }
    if cstr.cmp(base, c"u8") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"short") == 0 {
        return c"i16"
    }
    if cstr.cmp(base, c"int") == 0 {
        return c"i32"
    }
    if cstr.cmp(base, c"long") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"long long") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"unsigned u8") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"unsigned short") == 0 {
        return c"u16"
    }
    if cstr.cmp(base, c"unsigned") == 0 {
        return c"u32"
    }
    if cstr.cmp(base, c"unsigned int") == 0 {
        return c"u32"
    }
    if cstr.cmp(base, c"unsigned long") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"unsigned long long") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"long unsigned") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"long unsigned int") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"unsigned long int") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"long long unsigned") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"long long unsigned int") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"unsigned long long int") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"long int") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"long long int") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"signed long") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"signed long int") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"signed long long") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"signed long long int") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"short int") == 0 {
        return c"i16"
    }
    if cstr.cmp(base, c"signed short") == 0 {
        return c"i16"
    }
    if cstr.cmp(base, c"signed short int") == 0 {
        return c"i16"
    }
    if cstr.cmp(base, c"short unsigned int") == 0 {
        return c"u16"
    }
    if cstr.cmp(base, c"unsigned short int") == 0 {
        return c"u16"
    }
    if cstr.cmp(base, c"signed int") == 0 {
        return c"i32"
    }
    if cstr.cmp(base, c"signed") == 0 {
        return c"i32"
    }
    if cstr.cmp(base, c"signed u8") == 0 {
        return c"i8"
    }
    if cstr.cmp(base, c"float") == 0 {
        return c"f32"
    }
    if cstr.cmp(base, c"double") == 0 {
        return c"f64"
    }
    if cstr.cmp(base, c"_Bool") == 0 {
        return c"bool"
    }
    if cstr.cmp(base, c"bool") == 0 {
        return c"bool"
    }
    if cstr.cmp(base, c"size_t") == 0 {
        return c"usize"
    }
    if cstr.cmp(base, c"ssize_t") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"int8_t") == 0 {
        return c"i8"
    }
    if cstr.cmp(base, c"uint8_t") == 0 {
        return c"u8"
    }
    if cstr.cmp(base, c"int16_t") == 0 {
        return c"i16"
    }
    if cstr.cmp(base, c"uint16_t") == 0 {
        return c"u16"
    }
    if cstr.cmp(base, c"int32_t") == 0 {
        return c"i32"
    }
    if cstr.cmp(base, c"uint32_t") == 0 {
        return c"u32"
    }
    if cstr.cmp(base, c"int64_t") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"uint64_t") == 0 {
        return c"u64"
    }
    if cstr.cmp(base, c"intptr_t") == 0 {
        return c"i64"
    }
    if cstr.cmp(base, c"uintptr_t") == 0 {
        return c"usize"
    }
    if cstr.starts_with(base, c"struct ") {
        return sanitize_type_identifier(trim_cstr(trust tsubstr(base, 7, cstr.len(base) - 7)))
    }
    if cstr.starts_with(base, c"enum ") {
        return sanitize_type_identifier(trim_cstr(trust tsubstr(base, 5, cstr.len(base) - 5)))
    }
    if cstr.starts_with(base, c"union ") {
        return sanitize_type_identifier(trim_cstr(trust tsubstr(base, 6, cstr.len(base) - 6)))
    }
    return sanitize_type_identifier(base)
}

fn translate_c_type(ctx: ref TranslationCtx, type_src: ref u8, array_prefix: ref u8) ref u8 = {
    val normalized: ref u8 = normalize_type_phrase(type_src)
    val len: i64 = cstr.len(normalized)
    val no_stars_sb: ref void = builder.StringBuilder.new()
    val star_count: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(normalized, i)) as u8
        if c == 42 {
            star_count++
        } else {
            trust builder.StringBuilder.append_char(no_stars_sb, c)
        }
        i++
    }
    val no_stars_built: ref void = trust builder.StringBuilder.build(no_stars_sb)
    trust builder.StringBuilder.free(no_stars_sb)
    val base: ref u8 = trim_cstr(trust take_cstr(no_stars_built))
    val mapped0: mut ref u8 = c""
    if is_ident_text(base) {
        val aliased = lookup_typedef_alias(ctx, base)
        match aliased {
            some alias_type => {
                mapped0 = alias_type as ref u8
            }
            none => {
                mapped0 = map_base_type(ctx, base)
            }
        }
    } else {
        mapped0 = map_base_type(ctx, base)
    }
    val mapped: mut ref u8 = mapped0
    val j: mut i64 = 0
    for {
        if j >= star_count {
            break
        }
        mapped = trust tfmt("ref {s}", {mapped})
        j++
    }
    if cstr.cmp(array_prefix, c"") != 0 {
        mapped = trust tfmt("{s}{s}", {array_prefix, mapped})
    }
    return mapped
}

fn translate_c_type_ctx(ctx: ref TranslationCtx, type_src: ref u8, array_prefix: ref u8) ref u8 = {
    val normalized: ref u8 = normalize_type_phrase(type_src)
    if is_ident_text(normalized) {
        if lookup_typedef_alias(ctx, normalized) is some mapped {
            if cstr.cmp(array_prefix, c"") != 0 {
                return trust tfmt("{s}{s}", {array_prefix, mapped as ref u8})
            }
            return mapped as ref u8
        }
    }
    return translate_c_type(ctx, type_src, array_prefix)
}

fn strip_initializer(text: ref u8) ref u8 = {
    val len: i64 = cstr.len(text)
    val i: mut i64 = 0
    val depth_paren: mut i64 = 0
    val depth_bracket: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if c == 40 {
            depth_paren++
        } elif c == 41 && depth_paren > 0 {
            depth_paren--
        } elif c == 91 {
            depth_bracket++
        } elif c == 93 && depth_bracket > 0 {
            depth_bracket--
        } elif c == 61 && depth_paren == 0 && depth_bracket == 0 {
            return trim_cstr(trust tsubstr(text, 0, i))
        }
        i++
    }
    return trim_cstr(text)
}

fn parse_named_decl(ctx: ref TranslationCtx, text: ref u8, fallback_name: ref u8) ref DeclInfo = {
    val info: mut ref DeclInfo = trust talloc(@sizeof(DeclInfo) as usize) as ref DeclInfo
    info.its_ok = false
    info.name = fallback_name
    info.raw_name = fallback_name
    info.type_name = c""
    info.type_src = c""
    val trimmed0: ref u8 = trim_cstr(strip_initializer(text))
    val len0: i64 = cstr.len(trimmed0)
    if len0 == 0 {
        return info
    }
    val array_prefix: mut ref u8 = c""
    val i: mut i64 = len0 - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed0, i)) as u8
        if is_space(c) {
            i--
            continue
        }
        if c != 93 {
            break
        }
        val close_i: i64 = i
        val open_i: mut i64 = i - 1
        for {
            if open_i < 0 {
                break
            }
            val inner: u8 = trust @load8(@ptradd(trimmed0, open_i)) as u8
            if inner == 91 {
                break
            }
            open_i--
        }
        if open_i < 0 {
            break
        }
        val array_len_txt: ref u8 = trim_cstr(trust tsubstr(
                trimmed0,
                open_i + 1,
                close_i - open_i - 1
            ))
        val effective_len: mut ref u8 = array_len_txt
        if !is_integer_literal_text(array_len_txt) && !is_ident_text(array_len_txt) {
            effective_len = c"32"
        }
        array_prefix = trust tfmt("[{s}]{s}", {effective_len, array_prefix})
        i = open_i - 1
    }
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed0, i)) as u8
        if !is_space(c) {
            break
        }
        i--
    }
    val name_end: i64 = i
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed0, i)) as u8
        if !is_ident_part(c) {
            break
        }
        i--
    }
    val name_start: i64 = i + 1
    if name_end >= name_start && name_start > 0 {
        info.raw_name = trust tsubstr(
            trimmed0,
            name_start,
            name_end - name_start + 1
        )
        info.name = sanitize_identifier(info.raw_name)
        info.type_src = trim_cstr(trust tsubstr(trimmed0, 0, name_start))
    } else {
        info.raw_name = fallback_name
        info.name = sanitize_identifier(fallback_name)
        info.type_src = trimmed0
    }
    info.type_name = translate_c_type_ctx(ctx, info.type_src, array_prefix)
    info.its_ok = cstr.cmp(info.type_name, c"") != 0
    return info
}

fn split_multi_decl(ctx: ref TranslationCtx, text: ref u8) list[ref u8] = {
    val trimmed: ref u8 = strip_trailing_semicolon(trim_cstr(text))
    if str_contains(trimmed, c"(") {
        return mem.new[ref u8]()
    }
    val parts = split_top_level(trimmed, 44 as u8)
    if ((@len(parts) as i64) <= 1) {
        return mem.new[ref u8]()
    }
    val first_opt = @get(parts, 0)
    if first_opt is some first_part {
        val first_trimmed: ref u8 = trim_cstr(first_part as ref u8)
        val first_decl: ref DeclInfo = parse_named_decl(ctx, first_trimmed, c"")
        val first_type_src: ref u8 = trim_cstr(first_decl.type_src)
        if !first_decl.its_ok || cstr.cmp(first_type_src, c"") == 0 {
            return mem.new[ref u8]()
        }
        val items: mut list[ref u8] = mem.new[ref u8]()
        @append(items, first_trimmed)
        val len: i64 = @len(parts) as i64
        val i: mut i64 = 1
        for {
            if i >= len {
                break
            }
            val part_opt = @get(parts, i as usize)
            if part_opt is some part_val {
                val part_trimmed: ref u8 = trim_cstr(part_val as ref u8)
                if cstr.cmp(part_trimmed, c"") != 0 {
                    @append(items, trust tfmt("{s} {s}", {first_type_src, part_trimmed}))
                }
            }
            i++
        }
        return items
    } else {
        return mem.new[ref u8]()
    }
}

fn split_top_level(text: ref u8, delim: u8) list[ref u8] = {
    val items: mut list[ref u8] = mem.new[ref u8]()
    val len: i64 = cstr.len(text)
    val start: mut i64 = 0
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val bracket: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        val at_end: bool = i == len
        val c: mut u8 = 0
        if !at_end {
            c = trust @load8(@ptradd(text, i)) as u8
            if in_string {
                if escaped {
                    escaped = false
                } elif c == 92 {
                    escaped = true
                } elif c == 34 {
                    in_string = false
                }
            } elif in_char {
                if escaped {
                    escaped = false
                } elif c == 92 {
                    escaped = true
                } elif c == 39 {
                    in_char = false
                }
            } else {
                if c == 34 {
                    in_string = true
                } elif c == 39 {
                    in_char = true
                } elif c == 40 {
                    paren++
                } elif c == 41 && paren > 0 {
                    paren--
                } elif c == 123 {
                    brace++
                } elif c == 125 && brace > 0 {
                    brace--
                } elif c == 91 {
                    bracket++
                } elif c == 93 && bracket > 0 {
                    bracket--
                }
            }
        }
        if at_end || (c == delim && !in_string && !in_char && paren == 0 && brace == 0 && bracket == 0) {
            @append(items, trim_cstr(trust tsubstr(text, start, i - start)))
            start = i + 1
        }
        i++
    }
    return items
}

fn extract_identifier_before(text: ref u8, end_exclusive: i64) ref u8 = {
    val i: mut i64 = end_exclusive - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if !is_space(c) && c != 59 {
            break
        }
        i--
    }
    val end_i: i64 = i
    for {
        if i < 0 {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        if !is_ident_part(c) {
            break
        }
        i--
    }
    if end_i < i + 1 {
        return c""
    }
    return trust tsubstr(text, i + 1, end_i - i)
}

fn next_significant_line(lines: list[ref u8], start: i64) i64 = {
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val opt = @get(lines, i as usize)
        if opt is some line_val {
            val trimmed: ref u8 = trim_cstr(line_val as ref u8)
            if cstr.cmp(trimmed, c"") != 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn parse_include_name(line: ref u8) ref u8 = {
    val q1: i64 = find_char(line, 34 as u8)
    if q1 >= 0 {
        val q2: mut i64 = q1 + 1
        val len: i64 = cstr.len(line)
        for {
            if q2 >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(line, q2)) as u8
            if c == 34 {
                break
            }
            q2++
        }
        if q2 < len {
            return trust tsubstr(line, q1 + 1, q2 - q1 - 1)
        }
    }
    val a1: i64 = find_char(line, 60 as u8)
    if a1 >= 0 {
        val a2: mut i64 = a1 + 1
        val len: i64 = cstr.len(line)
        for {
            if a2 >= len {
                break
            }
            val c: u8 = trust @load8(@ptradd(line, a2)) as u8
            if c == 62 {
                break
            }
            a2++
        }
        if a2 < len {
            return trust tsubstr(line, a1 + 1, a2 - a1 - 1)
        }
    }
    return c""
}

fn parse_macro_name(line: ref u8, keyword: ref u8) ref u8 = {
    val flat: ref u8 = flatten_ws(line)
    val prefix: ref u8 = trust tfmt("{s} ", {keyword})
    if !cstr.starts_with(flat, prefix) {
        return c""
    }
    return trim_cstr(trust tsubstr(
            flat,
            cstr.len(prefix),
            cstr.len(flat) - cstr.len(prefix)
        ))
}

fn detect_condition(line: ref u8) i64 = {
    val flat: ref u8 = flatten_ws(line)
    if cstr.cmp(flat, c"#ifdef _WIN32") == 0 {
        return COND_WIN_TRUE
    }
    if cstr.cmp(flat, c"#if defined(_WIN32)") == 0 {
        return COND_WIN_TRUE
    }
    if cstr.cmp(flat, c"#if defined( _WIN32 )") == 0 {
        return COND_WIN_TRUE
    }
    if cstr.cmp(flat, c"#ifndef _WIN32") == 0 {
        return COND_WIN_FALSE
    }
    if cstr.cmp(flat, c"#if !defined(_WIN32)") == 0 {
        return COND_WIN_FALSE
    }
    if cstr.cmp(flat, c"#if ! defined(_WIN32)") == 0 {
        return COND_WIN_FALSE
    }
    return COND_NONE
}

fn is_header_guard(lines: list[ref u8], line_index: i64, macro_name: ref u8) bool = {
    if cstr.cmp(macro_name, c"") == 0 {
        return false
    }
    val next_i: i64 = next_significant_line(lines, line_index + 1)
    if next_i < 0 {
        return false
    }
    val opt = @get(lines, next_i as usize)
    if opt is some next_line {
        val def_name: ref u8 = parse_macro_name(next_line as ref u8, c"#define")
        return cstr.cmp(def_name, macro_name) == 0
    } else {
        return false
    }
}

fn append_builder(dst: ref void, src: ref void) void = {
    val built: ref void = trust builder.StringBuilder.build(src)
    val text: ref u8 = trust take_cstr(built)
    trust builder.StringBuilder.append_cstr(dst, text)
}

fn translate_body_lines(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val line: ref u8 = line_val as ref u8
            val trimmed: ref u8 = trim_cstr(line)
            if cstr.cmp(trimmed, c"") == 0 {
                append_blank_line(out)
                i++
                continue
            }
            if cstr.starts_with(trimmed, c"#else") {
                return make_block_result(i + 1, STOP_ELSE, trimmed)
            }
            if cstr.starts_with(trimmed, c"#endif") {
                return make_block_result(i + 1, STOP_ENDIF, trimmed)
            }
            if cstr.starts_with(trimmed, c"#elif") {
                return make_block_result(i + 1, STOP_ELIF, trimmed)
            }
            if cstr.starts_with(trimmed, c"#include") {
                i++
                continue
            }
            val ifndef_name: ref u8 = parse_macro_name(trimmed, c"#ifndef")
            if is_header_guard(lines, i, ifndef_name) {
                val define_i: i64 = next_significant_line(lines, i + 1)
                val inner = translate_body_lines(lines, current_dir, define_i + 1, indent, out, ctx)
                i = inner.next_index
                continue
            }
            val cond: i64 = detect_condition(trimmed)
            if cond == COND_WIN_TRUE {
                append_line(out, indent, c"when windows {")
                val then_result = translate_body_lines(
                    lines,
                    current_dir,
                    i + 1,
                    indent + 1,
                    out,
                    ctx
                )
                if then_result.stop_kind == STOP_ELSE {
                    append_line(out, indent, c"} otherwise {")
                    val else_result = translate_body_lines(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        ctx
                    )
                    append_line(out, indent, c"}")
                    i = else_result.next_index
                } elif then_result.stop_kind == STOP_ELIF {
                    append_line(out, indent, c"} otherwise {")
                    append_comment_line(out, indent + 1, then_result.stop_line)
                    val elif_result = translate_body_lines(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        ctx
                    )
                    append_line(out, indent, c"}")
                    i = elif_result.next_index
                } else {
                    append_line(out, indent, c"}")
                    i = then_result.next_index
                }
                continue
            }
            if cond == COND_WIN_FALSE {
                val non_windows: ref void = builder.StringBuilder.new()
                val then_result = translate_body_lines(
                    lines,
                    current_dir,
                    i + 1,
                    indent + 1,
                    non_windows,
                    ctx
                )
                append_line(out, indent, c"when windows {")
                if then_result.stop_kind == STOP_ELSE {
                    val else_result = translate_body_lines(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        ctx
                    )
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = else_result.next_index
                } elif then_result.stop_kind == STOP_ELIF {
                    append_comment_line(out, indent + 1, then_result.stop_line)
                    val elif_result = translate_body_lines(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        ctx
                    )
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = elif_result.next_index
                } else {
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = then_result.next_index
                }
                continue
            }
            val stmt_result: ref BlockResult = translate_statement_at(
                lines,
                current_dir,
                i,
                indent,
                out,
                ctx
            )
            i = stmt_result.next_index
        } else {
            i++
        }
    }
    return make_block_result(i, STOP_EOF, c"")
}

fn collect_struct(lines: list[ref u8], start: i64) ref BlockResult = {
    val len: i64 = @len(lines) as i64
    val brace_depth: mut i64 = 0
    val started: mut bool = false
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val line: ref u8 = line_val as ref u8
            val l: i64 = cstr.len(line)
            val j: mut i64 = 0
            for {
                if j >= l {
                    break
                }
                val c: u8 = trust @load8(@ptradd(line, j)) as u8
                if c == 123 {
                    brace_depth++
                    started = true
                } elif c == 125 && brace_depth > 0 {
                    brace_depth--
                } elif c == 59 && started && brace_depth == 0 {
                    return make_block_result(i + 1, STOP_EOF, c"")
                }
                j++
            }
        }
        i++
    }
    return make_block_result(i, STOP_EOF, c"")
}

fn collect_function(lines: list[ref u8], start: i64) ref BlockResult = {
    val len: i64 = @len(lines) as i64
    val paren_depth: mut i64 = 0
    val brace_depth: mut i64 = 0
    val seen_body: mut bool = false
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val line: ref u8 = line_val as ref u8
            val l: i64 = cstr.len(line)
            val j: mut i64 = 0
            for {
                if j >= l {
                    break
                }
                val c: u8 = trust @load8(@ptradd(line, j)) as u8
                if c == 40 {
                    paren_depth++
                } elif c == 41 && paren_depth > 0 {
                    paren_depth--
                } elif c == 123 && paren_depth == 0 {
                    brace_depth++
                    seen_body = true
                } elif c == 125 && brace_depth > 0 {
                    brace_depth--
                    if seen_body && brace_depth == 0 {
                        return make_block_result(i + 1, STOP_EOF, c"")
                    }
                } elif c == 59 && paren_depth == 0 && !seen_body {
                    return make_block_result(i + 1, STOP_EOF, c"")
                }
                j++
            }
        }
        i++
    }
    return make_block_result(i, STOP_EOF, c"")
}

fn translate_struct_decl(
    text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) bool = {
    val flat: ref u8 = flatten_ws(text)
    val open_i: i64 = find_char(flat, 123 as u8)
    val close_i: i64 = find_last_char(flat, 125 as u8)
    if open_i < 0 || close_i <= open_i {
        return false
    }
    val header: ref u8 = trim_cstr(trust tsubstr(flat, 0, open_i))
    val after: ref u8 = strip_trailing_semicolon(trim_cstr(trust tsubstr(
                flat,
                close_i + 1,
                cstr.len(flat) - close_i - 1
            )))
    val before_body_name: mut ref u8 = c""
    if cstr.starts_with(header, c"typedef struct") {
        val tail_len: i64 = cstr.len(header) - 14
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 14, tail_len))
        }
    } elif cstr.starts_with(header, c"struct") {
        val tail_len: i64 = cstr.len(header) - 6
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 6, tail_len))
        }
    } else {
        return false
    }
    val alias0: ref u8 = extract_identifier_before(after, cstr.len(after))
    val alias: mut ref u8 = alias0
    if cstr.cmp(alias, c"") == 0 {
        alias = before_body_name
    }
    if cstr.cmp(alias, c"") == 0 {
        return false
    }
    alias = sanitize_type_identifier(alias)
    if list_contains(ctx.translated_type_names, alias) {
        return true
    }
    push_unique(ctx.translated_type_names, alias)
    val body: ref u8 = trust tsubstr(flat, open_i + 1, close_i - open_i - 1)
    val prelude_out: ref void = builder.StringBuilder.new()
    val fields_out: ref void = builder.StringBuilder.new()
    val fields = split_top_level(body, 59 as u8)
    for field in fields {
        val trimmed: ref u8 = trim_cstr(field)
        if cstr.cmp(trimmed, c"") == 0 {
            continue
        }
        if ctx.bind_mode && str_contains(trimmed, c"(*") {
            val info: ref FnPtrInfo = parse_c_fnptr_type(ctx, trimmed, c"")
            if info.is_ok && cstr.cmp(info.name, c"") != 0 {
                append_line(
                    fields_out,
                    indent + 1,
                    trust tfmt("{s}: {s}", {info.name, info.type_name})
                )
                continue
            }
        }
        if translate_anonymous_union_field(trimmed, indent, prelude_out, ctx) is some field_line {
            append_line(fields_out, indent + 1, field_line as ref u8)
            continue
        }
        val field_items = split_multi_decl(ctx, trimmed)
        val decl_items: mut list[ref u8] = mem.new[ref u8]()
        if ((@len(field_items) as i64) > 1) {
            decl_items = field_items
        } else {
            @append(decl_items, trimmed)
        }
        for decl_text in decl_items {
            val decl: ref DeclInfo = parse_named_decl(ctx, decl_text, c"")
            if !decl.its_ok || cstr.cmp(decl.name, c"") == 0 {
                append_comment_line(
                    fields_out,
                    indent + 1,
                    trust tfmt("unsupported field declaration: {s};", {decl_text})
                )
                continue
            }
            val field_type: mut ref u8 = decl.type_name
            if cstr.starts_with(field_type, c"[]") {
                field_type = trust tfmt("ref {s}", {@ptradd(field_type, 2)})
                remember_flex_field(ctx, alias, decl.name, field_type)
            }
            append_line(
                fields_out,
                indent + 1,
                trust tfmt("{s}: {s}", {decl.name, render_mutable_type(field_type)})
            )
        }
    }
    append_builder(out, prelude_out)
    append_open_block_line(out, indent, trust tfmt("extern type {s} = ", {alias}))
    append_builder(out, fields_out)
    append_line(out, indent, c"}")
    append_blank_line(out)
    return true
}

fn translate_enum_decl(
    text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) bool = {
    val flat: ref u8 = flatten_ws(text)
    val open_i: i64 = find_char(flat, 123 as u8)
    val close_i: i64 = find_last_char(flat, 125 as u8)
    if open_i < 0 || close_i <= open_i {
        return false
    }
    val header: ref u8 = trim_cstr(trust tsubstr(flat, 0, open_i))
    val after: ref u8 = strip_trailing_semicolon(trim_cstr(trust tsubstr(
                flat,
                close_i + 1,
                cstr.len(flat) - close_i - 1
            )))
    val before_body_name: mut ref u8 = c""
    if cstr.starts_with(header, c"typedef enum") {
        val tail_len: i64 = cstr.len(header) - 12
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 12, tail_len))
        }
    } elif cstr.starts_with(header, c"enum") {
        val tail_len: i64 = cstr.len(header) - 4
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 4, tail_len))
        }
    } else {
        return false
    }
    val alias0: ref u8 = extract_identifier_before(after, cstr.len(after))
    val alias: mut ref u8 = alias0
    if cstr.cmp(alias, c"") == 0 {
        alias = before_body_name
    }
    val raw_alias: ref u8 = alias
    if ctx.bind_mode && cstr.cmp(raw_alias, c"") != 0 {
        push_unique(ctx.bind_enum_type_names, raw_alias)
    }
    alias = sanitize_type_identifier(alias)
    val body: ref u8 = trust tsubstr(flat, open_i + 1, close_i - open_i - 1)
    val items = split_top_level(body, 44 as u8)
    if ctx.bind_mode {
        val next_value: mut ref u8 = c"0"
        for item in items {
            val trimmed: ref u8 = trim_cstr(item)
            if cstr.cmp(trimmed, c"") == 0 {
                continue
            }
            val assign_i: i64 = find_top_level_assign(trimmed)
            val name_src: mut ref u8 = trimmed
            val value_expr: mut ref u8 = next_value
            if assign_i > 0 {
                name_src = trim_cstr(trust tsubstr(trimmed, 0, assign_i))
                value_expr = translate_expr_text(
                    ctx,
                    trim_cstr(trust tsubstr(
                            trimmed,
                            assign_i + 1,
                            cstr.len(trimmed) - assign_i - 1
                        ))
                )
            }
            val member: ref u8 = sanitize_identifier(trim_cstr(name_src))
            if cstr.cmp(member, c"") == 0 {
                continue
            }
            append_line(
                out,
                indent,
                trust tfmt("pub val {s}: i32 = {s}", {member, value_expr})
            )
            remember_enum_constant(ctx, member, c"i32")
            next_value = trust tfmt("({s}) + 1", {value_expr})
        }
        append_blank_line(out)
        return true
    }
    if cstr.cmp(alias, c"") == 0 {
        val next_value: mut ref u8 = c"0"
        for item in items {
            val trimmed: ref u8 = trim_cstr(item)
            if cstr.cmp(trimmed, c"") == 0 {
                continue
            }
            val assign_i: i64 = find_top_level_assign(trimmed)
            val name_src: mut ref u8 = trimmed
            val value_expr: mut ref u8 = next_value
            if assign_i > 0 {
                name_src = trim_cstr(trust tsubstr(trimmed, 0, assign_i))
                value_expr = translate_expr_text(
                    ctx,
                    trim_cstr(trust tsubstr(
                            trimmed,
                            assign_i + 1,
                            cstr.len(trimmed) - assign_i - 1
                        ))
                )
            }
            val member: ref u8 = sanitize_identifier(trim_cstr(name_src))
            if cstr.cmp(member, c"") == 0 {
                continue
            }
            append_line(out, indent, trust tfmt("val {s}: i32 = {s}", {member, value_expr}))
            next_value = trust tfmt("({s}) + 1", {value_expr})
        }
        append_blank_line(out)
        return true
    }
    if list_contains(ctx.translated_type_names, alias) {
        return true
    }
    push_unique(ctx.translated_type_names, alias)
    val members: mut list[ref u8] = mem.new[ref u8]()
    for item in items {
        val trimmed: ref u8 = trim_cstr(item)
        if cstr.cmp(trimmed, c"") == 0 {
            continue
        }
        val member: ref u8 = sanitize_identifier(trim_cstr(strip_initializer(trimmed)))
        if cstr.cmp(member, c"") == 0 {
            continue
        }
        @append(members, member)
    }
    append_open_block_line(out, indent, trust tfmt("pub enum {s} = ", {alias}))
    val member_count: i64 = @len(members) as i64
    val member_i: mut i64 = 0
    for {
        if member_i >= member_count {
            break
        }
        val member_opt = @get(members, member_i as usize)
        if member_opt is some member_val {
            val member: ref u8 = member_val as ref u8
            remember_enum_constant(ctx, member, alias)
            if member_i + 1 < member_count {
                append_line(out, indent + 1, trust tfmt("{s},", {member}))
            } else {
                append_line(out, indent + 1, member)
            }
        }
        member_i++
    }
    append_line(out, indent, c"}")
    append_blank_line(out)
    return true
}

fn emit_union_type(
    alias: ref u8,
    body: ref u8,
    indent: i64,
    out: ref void,
    ctx: ref TranslationCtx
) void = {
    append_open_block_line(out, indent, trust tfmt("pub union {s} = ", {alias}))
    val fields = split_top_level(body, 59 as u8)
    val first_variant: mut bool = true
    for field in fields {
        val trimmed: ref u8 = trim_cstr(field)
        if cstr.cmp(trimmed, c"") == 0 {
            continue
        }
        val field_items = split_multi_decl(ctx, trimmed)
        val decl_items: mut list[ref u8] = mem.new[ref u8]()
        if ((@len(field_items) as i64) > 1) {
            decl_items = field_items
        } else {
            @append(decl_items, trimmed)
        }
        for decl_text in decl_items {
            val decl: ref DeclInfo = parse_named_decl(ctx, decl_text, c"")
            if !decl.its_ok || cstr.cmp(decl.name, c"") == 0 {
                continue
            }
            val variant_name: ref u8 = sanitize_identifier(decl.name)
            val payload_type0: ref u8 = decl.type_name
            val payload_type: mut ref u8 = payload_type0
            if is_array_type_name(payload_type0) {
                payload_type = decay_array_type(payload_type0)
            }
            val line_text: mut ref u8 = c""
            if cstr.cmp(payload_type, c"void") == 0 {
                line_text = trust tfmt("{s}()", {variant_name})
            } else {
                line_text = trust tfmt("{s}({s})", {variant_name, payload_type})
            }
            if first_variant {
                append_line(out, indent + 1, line_text)
                first_variant = false
            } else {
                append_line(out, indent + 1, trust tfmt("| {s}", {line_text}))
            }
        }
    }
    append_line(out, indent, c"}")
    append_blank_line(out)
}

fn translate_anonymous_union_field(
    field_text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) option[ref u8] = {
    val trimmed: ref u8 = trim_cstr(field_text)
    if !cstr.starts_with(trimmed, c"union") {
        return none
    }
    val open_i: i64 = find_char(trimmed, 123 as u8)
    val close_i: i64 = find_last_char(trimmed, 125 as u8)
    if open_i < 0 || close_i <= open_i {
        return none
    }
    val header: ref u8 = trim_cstr(trust tsubstr(trimmed, 0, open_i))
    val after: ref u8 = trim_cstr(trust tsubstr(
            trimmed,
            close_i + 1,
            cstr.len(trimmed) - close_i - 1
        ))
    val header_tail: ref u8 = trim_cstr(trust tsubstr(header, 5, cstr.len(header) - 5))
    if cstr.cmp(header_tail, c"") != 0 {
        return none
    }
    val field_name: ref u8 = sanitize_identifier(extract_identifier_before(
            after,
            cstr.len(after)
        ))
    if cstr.cmp(field_name, c"") == 0 {
        return none
    }
    val union_name: ref u8 = fresh_union_name(ctx)
    push_unique(ctx.translated_type_names, union_name)
    val union_body: ref u8 = trust tsubstr(trimmed, open_i + 1, close_i - open_i - 1)
    emit_union_type(union_name, union_body, indent, out, ctx)
    return some trust tfmt("{s}: {s}", {field_name, render_mutable_type(union_name)})
}

fn translate_union_decl(
    text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) bool = {
    val flat: ref u8 = flatten_ws(text)
    val open_i: i64 = find_char(flat, 123 as u8)
    val close_i: i64 = find_last_char(flat, 125 as u8)
    if open_i < 0 || close_i <= open_i {
        return false
    }
    val header: ref u8 = trim_cstr(trust tsubstr(flat, 0, open_i))
    val after: ref u8 = strip_trailing_semicolon(trim_cstr(trust tsubstr(
                flat,
                close_i + 1,
                cstr.len(flat) - close_i - 1
            )))
    val before_body_name: mut ref u8 = c""
    if cstr.starts_with(header, c"typedef union") {
        val tail_len: i64 = cstr.len(header) - 13
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 13, tail_len))
        }
    } elif cstr.starts_with(header, c"union") {
        val tail_len: i64 = cstr.len(header) - 5
        if tail_len > 0 {
            before_body_name = trim_cstr(trust tsubstr(header, 5, tail_len))
        }
    } else {
        return false
    }
    val alias0: ref u8 = extract_identifier_before(after, cstr.len(after))
    val alias: mut ref u8 = alias0
    if cstr.cmp(alias, c"") == 0 {
        alias = before_body_name
    }
    alias = sanitize_type_identifier(alias)
    if cstr.cmp(alias, c"") == 0 {
        return false
    }
    if list_contains(ctx.translated_type_names, alias) {
        return true
    }
    push_unique(ctx.translated_type_names, alias)
    val body: ref u8 = trust tsubstr(flat, open_i + 1, close_i - open_i - 1)
    emit_union_type(alias, body, indent, out, ctx)
    return true
}

fn parse_c_fnptr_type(
    ctx: ref TranslationCtx,
    text: ref u8,
    fallback_name: ref u8
) ref FnPtrInfo = {
    val info: mut ref FnPtrInfo = trust talloc(@sizeof(FnPtrInfo) as usize) as ref FnPtrInfo
    info.is_ok = false
    info.name = fallback_name
    info.type_name = c""
    val len: i64 = cstr.len(text)
    val open_i: mut i64 = -1
    val star_i: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if (trust @load8(@ptradd(text, i)) as u8) == 40 {
            val j: mut i64 = i + 1
            for {
                if j >= len {
                    break
                }
                val c: u8 = trust @load8(@ptradd(text, j)) as u8
                if !is_space(c) {
                    break
                }
                j++
            }
            if j < len && (trust @load8(@ptradd(text, j)) as u8) == 42 {
                open_i = i
                star_i = j
                break
            }
        }
        i++
    }
    if open_i < 0 {
        return info
    }
    val close_i: i64 = find_matching_delim(text, open_i, 40 as u8, 41 as u8)
    if close_i <= star_i {
        return info
    }
    val name_src: ref u8 = trim_cstr(trust tsubstr(
        text,
        star_i + 1,
        close_i - star_i - 1
    ))
    if cstr.cmp(name_src, c"") != 0 {
        info.name = sanitize_identifier(extract_identifier_before(
            name_src,
            cstr.len(name_src)
        ))
    }
    val params_open: mut i64 = close_i + 1
    for {
        if params_open >= len {
            return info
        }
        if !is_space(trust @load8(@ptradd(text, params_open)) as u8) {
            break
        }
        params_open++
    }
    if (trust @load8(@ptradd(text, params_open)) as u8) != 40 {
        return info
    }
    val params_close: i64 = find_matching_delim(text, params_open, 40 as u8, 41 as u8)
    if params_close <= params_open {
        return info
    }
    val params_src: ref u8 = trim_cstr(trust tsubstr(
        text,
        params_open + 1,
        params_close - params_open - 1
    ))
    val ret_src: ref u8 = trim_cstr(trust tsubstr(text, 0, open_i))
    val ret_ty: ref u8 = translate_c_type_ctx(ctx, ret_src, c"")
    val params_sb: ref void = builder.StringBuilder.new()
    if cstr.cmp(params_src, c"") != 0 && cstr.cmp(params_src, c"void") != 0 {
        val params = split_top_level(params_src, 44 as u8)
        val first: mut bool = true
        val arg_index: mut i64 = 0
        for param in params {
            val p: ref u8 = trim_cstr(param)
            if cstr.cmp(p, c"") == 0 {
                continue
            }
            if cstr.cmp(p, c"...") == 0 || str_contains(p, c"(*") {
                trust builder.StringBuilder.free(params_sb)
                return info
            }
            val fallback: ref u8 = trust tfmt("arg{d}", {arg_index})
            val decl: ref DeclInfo = parse_named_decl(ctx, p, fallback)
            if !decl.its_ok {
                trust builder.StringBuilder.free(params_sb)
                return info
            }
            val pty: mut ref u8 = decl.type_name
            if is_array_type_name(pty) {
                pty = decay_array_type(pty)
            }
            if !first {
                trust builder.StringBuilder.append_cstr(params_sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(params_sb, pty)
            first = false
            arg_index++
        }
    }
    val params_built: ref void = trust builder.StringBuilder.build(params_sb)
    trust builder.StringBuilder.free(params_sb)
    val params_text: ref u8 = trust take_cstr(params_built)
    info.type_name = trust tfmt("fn({s}) {s}", {params_text, ret_ty})
    info.is_ok = true
    return info
}

fn translate_params(ctx: mut ref TranslationCtx, params_text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(params_text)
    if cstr.cmp(trimmed, c"") == 0 {
        return c""
    }
    if cstr.cmp(trimmed, c"void") == 0 {
        return c""
    }
    val params = split_top_level(trimmed, 44 as u8)
    val sb: ref void = builder.StringBuilder.new()
    val arg_index: mut i64 = 0
    val first: mut bool = true
    for param in params {
        val p: ref u8 = trim_cstr(param)
        if cstr.cmp(p, c"") == 0 {
            continue
        }
        if cstr.cmp(p, c"...") == 0 {
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(sb, c"...")
            first = false
            continue
        }
        val fallback: ref u8 = trust tfmt("arg{d}", {arg_index})
        if str_contains(p, c"(*") {
            val fallback_ptr: ref u8 = parse_function_pointer_param_name(p, fallback)
            val pname: mut ref u8 = fallback_ptr
            val ptype: mut ref u8 = c"ref void"
            if ctx.bind_mode {
                val info: ref FnPtrInfo = parse_c_fnptr_type(ctx, p, fallback_ptr)
                if info.is_ok {
                    pname = info.name
                    ptype = info.type_name
                }
            }
            push_unique(ctx.fnptr_names, pname)
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(sb, tfmt("{s}: {s}", {pname, ptype}))
            first = false
            arg_index++
            continue
        }
        val decl: ref DeclInfo = parse_named_decl(ctx, p, fallback)
        if !decl.its_ok {
            if !first {
                trust builder.StringBuilder.append_cstr(sb, c", ")
            }
            trust builder.StringBuilder.append_cstr(sb, tfmt("{s}: void", {fallback}))
            first = false
            arg_index++
            continue
        }
        val param_type: mut ref u8 = decl.type_name
        if is_array_type_name(decl.type_name) {
            param_type = decay_array_type(decl.type_name)
        }
        remember_local_type(ctx, decl.name, param_type)
        val rendered_type: ref u8 = render_parameter_type(ctx, decl.name, param_type)
        if !first {
            trust builder.StringBuilder.append_cstr(sb, c", ")
        }
        trust builder.StringBuilder.append_cstr(
            sb,
            tfmt("{s}: {s}", {decl.name, rendered_type})
        )
        first = false
        arg_index++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trust take_cstr(built)
}

fn extract_main_param_name(ctx: ref TranslationCtx, params_text: ref u8, index: i64) ref u8 = {
    val trimmed: ref u8 = trim_cstr(params_text)
    if cstr.cmp(trimmed, c"") == 0 || cstr.cmp(trimmed, c"void") == 0 {
        return c""
    }
    val params = split_top_level(trimmed, 44 as u8)
    val param_opt = @get(params, index as usize)
    if param_opt is some param_val {
        val fallback: ref u8 = trust tfmt("arg{d}", {index})
        val decl: ref DeclInfo = parse_named_decl(ctx, trim_cstr(param_val as ref u8), fallback)
        if decl.its_ok {
            return decl.name
        }
        return sanitize_identifier(fallback)
    } else {
        return c""
    }
}

fn text_uses_ident(text: ref u8, name: ref u8) bool = {
    if cstr.cmp(name, c"") == 0 {
        return false
    }
    val len: i64 = cstr.len(text)
    val nlen: i64 = cstr.len(name)
    if len == 0 || nlen == 0 || nlen > len {
        return false
    }
    val i: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    val in_line_comment: mut bool = false
    val in_block_comment: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        val next: mut u8 = 0
        if i + 1 < len {
            next = trust @load8(@ptradd(text, i + 1)) as u8
        }
        if in_line_comment {
            if c == 10 || c == 13 {
                in_line_comment = false
            }
            i++
            continue
        }
        if in_block_comment {
            if c == 42 && next == 47 {
                in_block_comment = false
                i += 2
                continue
            }
            i++
            continue
        }
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 47 && next == 47 {
            in_line_comment = true
            i += 2
            continue
        }
        if c == 47 && next == 42 {
            in_block_comment = true
            i += 2
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if i + nlen <= len {
            val candidate: ref u8 = trust tsubstr(text, i, nlen)
            if cstr.cmp(candidate, name) == 0 {
                val prev_ok: bool = i == 0 || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i - 1
                        )) as u8)
                val next_ok: bool = i + nlen >= len || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i + nlen
                        )) as u8)
                if prev_ok && next_ok {
                    return true
                }
            }
        }
        i++
    }
    return false
}

fn emit_main_args_prelude(
    ctx: ref TranslationCtx,
    params_text: ref u8,
    body_text: ref u8,
    indent: i64,
    out: ref void
) bool = {
    val argc_name: ref u8 = extract_main_param_name(ctx, params_text, 0)
    val argv_name: ref u8 = extract_main_param_name(ctx, params_text, 1)
    val needs_argc: bool = text_uses_ident(
        body_text,
        c"argc"
    ) || text_uses_ident(body_text, argc_name)
    val needs_argv: bool = text_uses_ident(
        body_text,
        c"args"
    ) || text_uses_ident(body_text, argv_name)
    if !needs_argc && !needs_argv {
        return false
    }
    remember_local_type(ctx, c"args", c"list[ref u8]")
    append_line(out, indent, c"val args: list[ref u8] = @args()")
    if needs_argc {
        remember_local_type(ctx, c"argc", c"usize")
        append_line(out, indent, c"val argc: usize = @len(args)")
    }
    if cstr.cmp(
        argc_name,
        c""
    ) != 0 && cstr.cmp(argc_name, c"argc") != 0 && text_uses_ident(body_text, argc_name) {
        remember_local_type(ctx, argc_name, c"usize")
        append_line(out, indent, trust tfmt("val {s}: usize = @len(args)", {argc_name}))
    }
    if cstr.cmp(
        argv_name,
        c""
    ) != 0 && cstr.cmp(argv_name, c"args") != 0 && text_uses_ident(body_text, argv_name) {
        remember_local_type(ctx, argv_name, c"list[ref u8]")
        append_line(out, indent, trust tfmt("val {s}: list[ref u8] = args", {argv_name}))
    }
    return true
}

fn strip_gnu_attributes(text: ref u8) ref u8 = {
    val len: i64 = cstr.len(text)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if i + 13 <= len {
            val frag: ref u8 = trust tsubstr(text, i, 13)
            if cstr.cmp(frag, c"__attribute__") == 0 {
                val prev_ok: bool = i == 0 || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i - 1
                        )) as u8)
                val next_ok: bool = i + 13 >= len || !is_ident_part(trust @load8(@ptradd(
                            text,
                            i + 13
                        )) as u8)
                if prev_ok && next_ok {
                    val j: mut i64 = i + 13
                    for {
                        if j >= len {
                            break
                        }
                        val ws: u8 = trust @load8(@ptradd(text, j)) as u8
                        if !is_space(ws) {
                            break
                        }
                        j++
                    }
                    if j < len && (trust @load8(@ptradd(text, j)) as u8) == 40 {
                        val close_j: i64 = find_matching_delim(text, j, 40 as u8, 41 as u8)
                        if close_j > j {
                            i = close_j + 1
                            continue
                        }
                    }
                    i = j
                    continue
                }
            }
        }
        val c: u8 = trust @load8(@ptradd(text, i)) as u8
        trust builder.StringBuilder.append_char(sb, c)
        i++
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trim_cstr(trust take_cstr(built))
}

fn translate_function_decl(
    text: ref u8,
    current_dir: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) bool = {
    val has_body: bool = find_char(text, 123 as u8) >= 0
    val signature_src: mut ref u8 = c""
    val body_src: mut ref u8 = c""
    if has_body {
        val open_i: i64 = find_char(text, 123 as u8)
        val close_i: i64 = find_last_char(text, 125 as u8)
        if close_i <= open_i {
            return false
        }
        signature_src = trim_cstr(trust tsubstr(text, 0, open_i))
        body_src = trust tsubstr(text, open_i + 1, close_i - open_i - 1)
    } else {
        val semi_i: i64 = find_last_char(text, 59 as u8)
        if semi_i < 0 {
            return false
        }
        signature_src = trim_cstr(trust tsubstr(text, 0, semi_i))
        body_src = c""
    }
    val signature: ref u8 = flatten_ws(strip_gnu_attributes(signature_src))
    val open_paren: i64 = find_char(signature, 40 as u8)
    val close_paren: i64 = find_matching_delim(signature, open_paren, 40 as u8, 41 as u8)
    if open_paren < 0 || close_paren <= open_paren {
        return false
    }
    val head: ref u8 = trim_cstr(trust tsubstr(signature, 0, open_paren))
    val params_raw: ref u8 = trim_cstr(trust tsubstr(
            signature,
            open_paren + 1,
            close_paren - open_paren - 1
        ))
    val raw_name: ref u8 = extract_identifier_before(head, cstr.len(head))
    val name: ref u8 = sanitize_identifier(raw_name)
    if cstr.cmp(name, c"") == 0 {
        return false
    }
    val head_len: i64 = cstr.len(head)
    val raw_name_len: i64 = cstr.len(raw_name)
    if head_len < raw_name_len {
        return false
    }
    if head_len == raw_name_len {
        return false
    }
    val return_src: ref u8 = trim_cstr(trust tsubstr(head, 0, head_len - raw_name_len))
    val return_type: ref u8 = translate_c_type_ctx(ctx, return_src, c"")
    clear_local_types(ctx)
    val is_static: bool = str_contains(signature, c"static ")
    val handle_body: mut bool = has_body
    if ctx.bind_mode && has_body {
        if is_static {
            append_comment_line(
                out,
                indent,
                trust tfmt("static function skipped: {s};", {signature})
            )
            return true
        }
        handle_body = false
    }
    if handle_body {
        val body_lines0 = split_lines(body_src)
        analyze_mutable_names(ctx, body_lines0, 0)
        analyze_address_taken_names(ctx, body_lines0, 0)
    }
    val is_main: bool = cstr.cmp(name, c"main") == 0
    val params_text: mut ref u8 = c""
    if !is_main {
        params_text = translate_params(ctx, params_raw)
    }
    val line: mut ref u8 = c""
    if handle_body {
        push_unique(ctx.defined_names, name)
        val fn_kw: mut ref u8 = c"pub fn"
        if is_static {
            fn_kw = c"fn"
        }
        line = trust tfmt("{s} {s}({s}) {s} = trust ", {fn_kw, name, params_text, return_type})
        append_open_block_line(out, indent, line)
        if is_main {
            val body_lines = split_lines(body_src)
            emit_main_args_prelude(ctx, params_raw, body_src, indent + 1, out)
            if ((@len(ctx.main_prelude_lines) as i64) > 0) {
                append_blank_line(out)
            }
            for prelude_line in ctx.main_prelude_lines {
                append_line(out, indent + 1, prelude_line)
            }
            if ((@len(body_lines) as i64) > 0) {
                append_blank_line(out)
            }
            translate_body_lines(body_lines, current_dir, 0, indent + 1, out, ctx)
            if cstr.cmp(return_type, c"i32") == 0
            && !body_has_explicit_return(body_lines) {
                append_blank_line(out)
                append_line(out, indent + 1, c"return 0")
            }
        } else {
            val body_lines = split_lines(body_src)
            translate_body_lines(body_lines, current_dir, 0, indent + 1, out, ctx)
        }
        append_line(out, indent, c"}")
        append_blank_line(out)
        return true
    }
    if is_static {
        append_comment_line(
            out,
            indent,
            trust tfmt("static prototype omitted: {s};", {signature})
        )
        return true
    }
    if list_contains(ctx.extern_names, name) {
        return true
    }
    push_unique(ctx.extern_names, name)
    val extern_kw: mut ref u8 = c"extern"
    if ctx.bind_mode {
        extern_kw = c"pub extern"
    }
    line = trust tfmt(
        "{s} (C) fn {s}({s}) {s} = \"{s}\"",
        {extern_kw, name, params_text, return_type, raw_name}
    )
    append_line(out, indent, line)
    return true
}

fn translate_top_level_decl(
    text: ref u8,
    indent: i64,
    out: ref void,
    ctx: mut ref TranslationCtx
) bool = {
    val stripped: ref u8 = strip_trailing_semicolon(trim_cstr(text))
    if cstr.cmp(stripped, c"") == 0 {
        return false
    }
    val multi_decls = split_multi_decl(ctx, stripped)
    if ((@len(multi_decls) as i64) > 1) {
        val any_ok: mut bool = false
        for decl_text in multi_decls {
            if translate_top_level_decl(decl_text, indent, out, ctx) {
                any_ok = true
            }
        }
        return any_ok
    }
    if ctx.bind_mode && cstr.starts_with(stripped, c"typedef ")
    && str_contains(stripped, c"(*") {
        val info: ref FnPtrInfo = parse_c_fnptr_type(ctx, stripped, c"")
        if info.is_ok && cstr.cmp(info.name, c"") != 0 {
            register_typedef_alias(
                ctx,
                sanitize_type_identifier(info.name),
                info.type_name
            )
            return true
        }
    }
    if ctx.bind_mode && cstr.starts_with(stripped, c"extern ") {
        val after_extern: ref u8 = trim_cstr(trust tsubstr(
            stripped,
            7,
            cstr.len(stripped) - 7
        ))
        val is_const: bool = text_uses_ident(after_extern, c"const")
        || text_uses_ident(after_extern, c"__const")
        val decl_ev: ref DeclInfo = parse_named_decl(ctx, after_extern, c"")
        if decl_ev.its_ok && cstr.cmp(decl_ev.name, c"") != 0 {
            val mut_kw: mut ref u8 = c""
            if !is_const {
                mut_kw = c"mut "
            }
            append_line(
                out,
                indent,
                trust tfmt(
                    "pub extern val {s}: {s}{s} = \"{s}\"",
                    {decl_ev.name, mut_kw, decl_ev.type_name, decl_ev.raw_name}
                )
            )
            return true
        }
    }
    if ctx.bind_mode && cstr.starts_with(stripped, c"typedef ")
    && !str_contains(stripped, c"(") && !str_contains(stripped, c"{") {
        val after_typedef: ref u8 = trim_cstr(trust tsubstr(
            stripped,
            8,
            cstr.len(stripped) - 8
        ))
        val alias_decl: ref DeclInfo = parse_named_decl(ctx, after_typedef, c"")
        if alias_decl.its_ok && cstr.cmp(alias_decl.name, c"") != 0
        && cstr.cmp(alias_decl.type_name, alias_decl.name) != 0 {
            register_typedef_alias(
                ctx,
                sanitize_type_identifier(alias_decl.name),
                alias_decl.type_name
            )
        }
        return true
    }
    if cstr.starts_with(stripped, c"typedef ")
    && !cstr.starts_with(stripped, c"typedef struct")
    && !cstr.starts_with(stripped, c"typedef enum")
    && !cstr.starts_with(stripped, c"typedef union")
    && !str_contains(stripped, c"(") {
        val after_typedef: ref u8 = trim_cstr(trust tsubstr(
                stripped,
                8,
                cstr.len(stripped) - 8
            ))
        val alias_decl: ref DeclInfo = parse_named_decl(ctx, after_typedef, c"")
        if alias_decl.its_ok && cstr.cmp(alias_decl.name, c"") != 0
        && cstr.cmp(alias_decl.type_name, alias_decl.name) != 0 {
            register_typedef_alias(
                ctx,
                sanitize_type_identifier(alias_decl.name),
                alias_decl.type_name
            )
        }
        return true
    }
    val assign_i: i64 = find_top_level_assign(stripped)
    if assign_i > 0 {
        val lhs: ref u8 = trim_cstr(trust tsubstr(stripped, 0, assign_i))
        val rhs: ref u8 = trim_cstr(trust tsubstr(
                stripped,
                assign_i + 1,
                cstr.len(stripped) - assign_i - 1
            ))
        val can_be_decl: bool = str_contains(lhs, c" ")
        || cstr.starts_with(lhs, c"struct ")
        || cstr.starts_with(lhs, c"enum ")
        || cstr.starts_with(lhs, c"union ")
        if !can_be_decl {
            return false
        }
        val decl: ref DeclInfo = parse_named_decl(ctx, lhs, c"")
        if !decl.its_ok || cstr.cmp(
            decl.name,
            c""
        ) == 0 || cstr.cmp(trim_cstr(decl.type_src), c"") == 0 {
            return false
        }
        if is_array_type_name(decl.type_name) {
            val array_init_items = parse_brace_initializer_items(rhs)
            val elem_type: ref u8 = array_type_elem(decl.type_name)
            val alloc_expr: mut ref u8 = array_alloc_expr(decl.type_name)
            if cstr.cmp(
                array_type_len_expr(decl.type_name),
                c""
            ) == 0 && (@len(array_init_items) as i64) > 0 {
                alloc_expr = trust tfmt(
                    "{d} * @sizeof({s})",
                    {@len(array_init_items) as i64, elem_type}
                )
            }
            val decayed_type: ref u8 = decay_array_type(decl.type_name)
            val is_char_array_literal: bool = cstr.cmp(
                elem_type,
                c"u8"
            ) == 0 && is_string_literal_text(rhs)
            remember_global_type(ctx, decl.name, decayed_type)
            remember_global_array_type(ctx, decl.name, alloc_expr)
            append_line(
                out,
                indent,
                trust tfmt(
                    "val {s}: {s} = @alloc({s})",
                    {decl.name, render_mutable_type(decayed_type), alloc_expr}
                )
            )
            if is_char_array_literal {
                val prelude_sb: ref void = builder.StringBuilder.new()
                val lowered_rhs_char: ref LoweredExpr = lower_incdec_expr(ctx, rhs, 0, prelude_sb)
                val rhs_expr_char: ref u8 = lowered_rhs_char.expr
                val copy_len: i64 = string_literal_storage_len(rhs)
                append_line(
                    prelude_sb,
                    0,
                    trust tfmt("@memset({s} as ref void, 0, {s})", {decl.name, alloc_expr})
                )
                append_line(
                    prelude_sb,
                    0,
                    trust tfmt(
                        "@memcpy({s} as ref void, {s} as ref void, {d} as usize)",
                        {decl.name, rhs_expr_char, copy_len}
                    )
                )
                track_called_expr(ctx, rhs_expr_char)
                append_main_prelude_builder(ctx, prelude_sb)
            }
            if ((@len(array_init_items) as i64) > 0) {
                val prelude_sb2: ref void = builder.StringBuilder.new()
                emit_array_initializer_stores(ctx, prelude_sb2, 0, decl.name, array_init_items)
                append_main_prelude_builder(ctx, prelude_sb2)
            }
            return true
        }
        remember_global_type(ctx, decl.name, decl.type_name)
        val lowered_rhs: ref LoweredExpr = lower_incdec_expr(ctx, rhs, indent, out)
        val rhs_expr: mut ref u8 = lowered_rhs.expr
        if is_null_pointer_text(rhs) {
            rhs_expr = c"none"
        }
        track_called_expr(ctx, rhs_expr)
        append_line(
            out,
            indent,
            trust tfmt(
                "val {s}: {s} = {s}",
                {decl.name, render_mutable_type(decl.type_name), rhs_expr}
            )
        )
        return true
    }
    val can_be_bare_decl: bool = (str_contains(stripped, c" ") || str_contains(stripped, c"*")
        || cstr.starts_with(stripped, c"struct ") || cstr.starts_with(stripped, c"enum ")
        || cstr.starts_with(stripped, c"union "))
    && !str_contains(stripped, c"(")
    if can_be_bare_decl {
        val decl2: ref DeclInfo = parse_named_decl(ctx, stripped, c"")
        if decl2.its_ok && cstr.cmp(decl2.name, c"") != 0 {
            if is_array_type_name(decl2.type_name) {
                val alloc_expr2: ref u8 = array_alloc_expr(decl2.type_name)
                val decayed_type2: ref u8 = decay_array_type(decl2.type_name)
                remember_global_type(ctx, decl2.name, decayed_type2)
                remember_global_array_type(ctx, decl2.name, alloc_expr2)
                append_line(
                    out,
                    indent,
                    trust tfmt(
                        "val {s}: {s} = @alloc({s})",
                        {decl2.name, render_mutable_type(decayed_type2), alloc_expr2}
                    )
                )
                return true
            }
            remember_global_type(ctx, decl2.name, decl2.type_name)
            append_line(
                out,
                indent,
                trust tfmt(
                    "val {s}: {s} = {s}",
                    {
                        decl2.name,
                        render_mutable_type(decl2.type_name),
                        zero_init_expr(decl2.type_name)
                    }
                )
            )
            return true
        }
    }
    return false
}

fn strip_c_numeric_suffixes(text: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(text)
    val len: i64 = cstr.len(trimmed)
    val sb: ref void = builder.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(trimmed, i)) as u8
        val starts_number: bool = (c >= 48 && c <= 57)
        val dotted_number: bool = c == 46 && i + 1 < len
        && (trust @load8(@ptradd(trimmed, i + 1)) as u8) >= 48
        && (trust @load8(@ptradd(trimmed, i + 1)) as u8) <= 57
        if !starts_number && !dotted_number {
            trust builder.StringBuilder.append_char(sb, c)
            i++
            continue
        }
        val start: i64 = i
        val is_hex: bool = c == 48 && i + 1 < len
        && ((trust @load8(@ptradd(trimmed, i + 1)) as u8) == 120
            || (trust @load8(@ptradd(trimmed, i + 1)) as u8) == 88)
        if is_hex {
            i += 2
            for {
                if i >= len {
                    break
                }
                val hc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                val is_hex_digit: bool = (hc >= 48 && hc <= 57)
                || (hc >= 97 && hc <= 102) || (hc >= 65 && hc <= 70)
                if !is_hex_digit {
                    break
                }
                i++
            }
        } else {
            for {
                if i >= len {
                    break
                }
                val dc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if dc < 48 || dc > 57 {
                    break
                }
                i++
            }
            if i < len && (trust @load8(@ptradd(trimmed, i)) as u8) == 46 {
                i++
                for {
                    if i >= len {
                        break
                    }
                    val dc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                    if dc < 48 || dc > 57 {
                        break
                    }
                    i++
                }
            }
            if i < len {
                val ec: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                if ec == 101 || ec == 69 {
                    i++
                    if i < len {
                        val sc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                        if sc == 43 || sc == 45 {
                            i++
                        }
                    }
                    for {
                        if i >= len {
                            break
                        }
                        val dc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
                        if dc < 48 || dc > 57 {
                            break
                        }
                        i++
                    }
                }
            }
        }
        val suffix_start: i64 = i
        for {
            if i >= len {
                break
            }
            val sc: u8 = trust @load8(@ptradd(trimmed, i)) as u8
            if sc != 117 && sc != 85 && sc != 108 && sc != 76 && sc != 102 && sc != 70 {
                break
            }
            i++
        }
        if suffix_start > start {
            trust builder.StringBuilder.append_cstr(
                sb,
                tsubstr(trimmed, start, suffix_start - start)
            )
        }
    }
    val built: ref void = trust builder.StringBuilder.build(sb)
    trust builder.StringBuilder.free(sb)
    return trim_cstr(trust take_cstr(built))
}

fn bind_macro_type(value: ref u8) ref u8 = {
    val trimmed: ref u8 = trim_cstr(value)
    if cstr.cmp(trimmed, c"") == 0 {
        return c"i32"
    }
    val first: u8 = trust @load8(trimmed) as u8
    if first == 34 {
        return c"ref u8"
    }
    if first == 39 {
        return c"i32"
    }
    if cstr.cmp(trimmed, c"true") == 0 || cstr.cmp(trimmed, c"false") == 0 {
        return c"bool"
    }
    val is_hex: bool = cstr.starts_with(trimmed, c"0x")
    || cstr.starts_with(trimmed, c"0X")
    val has_float: bool = str_contains(trimmed, c".")
    || (!is_hex && (str_contains(trimmed, c"e") || str_contains(trimmed, c"E")))
    if has_float {
        return c"f64"
    }
    val has_unsigned: bool = str_contains(trimmed, c"u") || str_contains(trimmed, c"U")
    val has_long: bool = str_contains(trimmed, c"l") || str_contains(trimmed, c"L")
    if has_unsigned {
        if has_long {
            return c"u64"
        }
        return c"u32"
    }
    if has_long {
        return c"i64"
    }
    return c"i32"
}

fn bind_macro_has_call(value: ref u8) bool = {
    val len: i64 = cstr.len(value)
    val i: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(value, i)) as u8
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if is_ident_start(c) {
            for {
                if i >= len {
                    break
                }
                if !is_ident_part(trust @load8(@ptradd(value, i)) as u8) {
                    break
                }
                i++
            }
            for {
                if i >= len {
                    break
                }
                val ws: u8 = trust @load8(@ptradd(value, i)) as u8
                if !is_space(ws) {
                    break
                }
                i++
            }
            if i < len && (trust @load8(@ptradd(value, i)) as u8) == 40 {
                return true
            }
            continue
        }
        i++
    }
    return false
}

fn bind_macro_identifiers_known(ctx: ref TranslationCtx, value: ref u8) bool = {
    val len: i64 = cstr.len(value)
    val i: mut i64 = 0
    val in_string: mut bool = false
    val in_char: mut bool = false
    val escaped: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(value, i)) as u8
        if in_string {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 34 {
                in_string = false
            }
            i++
            continue
        }
        if in_char {
            if escaped {
                escaped = false
            } elif c == 92 {
                escaped = true
            } elif c == 39 {
                in_char = false
            }
            i++
            continue
        }
        if c == 34 {
            in_string = true
            i++
            continue
        }
        if c == 39 {
            in_char = true
            i++
            continue
        }
        if is_ident_start(c) {
            val prev_digit: bool = i > 0
            && (trust @load8(@ptradd(value, i - 1)) as u8) >= 48
            && (trust @load8(@ptradd(value, i - 1)) as u8) <= 57
            val start: i64 = i
            for {
                if i >= len {
                    break
                }
                if !is_ident_part(trust @load8(@ptradd(value, i)) as u8) {
                    break
                }
                i++
            }
            if prev_digit {
                continue
            }
            val ident: ref u8 = trust tsubstr(value, start, i - start)
            if cstr.cmp(ident, c"true") == 0 || cstr.cmp(ident, c"false") == 0
            || cstr.cmp(ident, c"none") == 0 {
                continue
            }
            if list_contains(ctx.bind_macro_names, ident) {
                continue
            }
            if lookup_enum_constant_type(ctx, ident) is some _ {
                continue
            }
            return false
        }
        i++
    }
    return true
}

fn bind_macro_is_constant(ctx: ref TranslationCtx, value: ref u8) bool = {
    val trimmed: ref u8 = trim_cstr(value)
    if cstr.cmp(trimmed, c"") == 0 {
        return false
    }
    val first: u8 = trust @load8(trimmed) as u8
    if (first >= 48 && first <= 57) || first == 34 || first == 39 {
        return true
    }
    return bind_macro_identifiers_known(ctx, trimmed)
}

fn emit_bind_macro(
    ctx: mut ref TranslationCtx,
    line: ref u8,
    out: ref void
) bool = {
    val trimmed: ref u8 = trim_cstr(line)
    if !cstr.starts_with(trimmed, c"#define") {
        return false
    }
    val rest: ref u8 = trim_cstr(trust tsubstr(
        trimmed,
        7,
        cstr.len(trimmed) - 7
    ))
    val rest_len: i64 = cstr.len(rest)
    if rest_len == 0 {
        return true
    }
    val name_end: mut i64 = 0
    for {
        if name_end >= rest_len {
            break
        }
        if !is_ident_part(trust @load8(@ptradd(rest, name_end)) as u8) {
            break
        }
        name_end++
    }
    if name_end == 0 {
        return true
    }
    val raw_name: ref u8 = trust tsubstr(rest, 0, name_end)
    val name: ref u8 = sanitize_identifier(raw_name)
    if list_contains(ctx.bind_macro_names, name) {
        return true
    }
    val function_like: bool = name_end < rest_len
    && (trust @load8(@ptradd(rest, name_end)) as u8) == 40
    val value: ref u8 = trim_cstr(trust tsubstr(
        rest,
        name_end,
        rest_len - name_end
    ))
    if function_like {
        append_comment_line(
            out,
            0,
            trust tfmt("skipped function-like macro: {s}", {raw_name})
        )
        return true
    }
    if cstr.cmp(value, c"") == 0 {
        return true
    }
    if bind_macro_has_call(value) {
        append_comment_line(
            out,
            0,
            trust tfmt("skipped call-like macro: {s}", {raw_name})
        )
        return true
    }
    if !bind_macro_is_constant(ctx, value) {
        append_comment_line(
            out,
            0,
            trust tfmt("skipped non-constant macro: {s}", {raw_name})
        )
        return true
    }
    if str_contains(value, c"{") || str_contains(value, c"}")
    || str_contains(value, c"__attribute__") || str_contains(value, c"__declspec") {
        append_comment_line(
            out,
            0,
            trust tfmt("skipped unsupported macro: {s}", {raw_name})
        )
        return true
    }
    val macro_ty: ref u8 = bind_macro_type(value)
    val cleaned: ref u8 = strip_c_numeric_suffixes(value)
    val expr: ref u8 = translate_expr_text(ctx, cleaned)
    push_unique(ctx.bind_macro_names, name)
    append_line(
        out,
        0,
        trust tfmt("pub val {s}: {s} = {s}", {name, macro_ty, expr})
    )
    return true
}

fn translate_file(
    path: ref u8,
    out: ref void,
    seen: mut list[ref u8],
    ctx: mut ref TranslationCtx
) bool = {
    if list_contains(seen, path) {
        return true
    }
    @append(seen, path)
    val content_opt = trust preprocess_source(path)
    match content_opt {
        none => {
            append_comment_line(out, 0, trust tfmt("failed to read include: {s}", {path}))
            return false
        }
        some content_val => {
            val content: ref u8 = content_val as ref u8
            val lines = split_lines(content)
            val current_dir: ref u8 = trust tdir(path)
            val result = translate_top_level(lines, current_dir, 0, 0, out, seen, ctx)
            if result.stop_kind != STOP_EOF {
                append_comment_line(
                    out,
                    0,
                    trust tfmt("unterminated preprocessor block in {s}", {path})
                )
            }
            return true
        }
    }
}

pub fn translate_top_level(
    lines: list[ref u8],
    current_dir: ref u8,
    start: i64,
    indent: i64,
    out: ref void,
    seen: mut list[ref u8],
    ctx: mut ref TranslationCtx
) ref BlockResult = {
    val len: i64 = @len(lines) as i64
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        val line_opt = @get(lines, i as usize)
        if line_opt is some line_val {
            val line: ref u8 = line_val as ref u8
            val trimmed: ref u8 = trim_cstr(line)
            if cstr.cmp(trimmed, c"") == 0 {
                i++
                continue
            }
            if cstr.starts_with(trimmed, c"#else") {
                return make_block_result(i + 1, STOP_ELSE, trimmed)
            }
            if cstr.starts_with(trimmed, c"#endif") {
                return make_block_result(i + 1, STOP_ENDIF, trimmed)
            }
            if cstr.starts_with(trimmed, c"#elif") {
                return make_block_result(i + 1, STOP_ELIF, trimmed)
            }
            if cstr.starts_with(trimmed, c"#pragma once") {
                i++
                continue
            }
            if cstr.starts_with(trimmed, c"#include") {
                val include_name: ref u8 = parse_include_name(trimmed)
                if cstr.cmp(include_name, c"") == 0 {
                    append_comment_line(out, indent, trimmed)
                } elif is_system_include(trimmed) {
                    i++
                    continue
                } else {
                    val include_path_opt = resolve_include_path(include_name, current_dir)
                    if include_path_opt is some include_path {
                        translate_file(include_path as ref u8, out, seen, ctx)
                    } else {
                        append_comment_line(
                            out,
                            indent,
                            trust tfmt("unresolved include: {s}", {include_name})
                        )
                    }
                }
                i++
                continue
            }
            val ifndef_name: ref u8 = parse_macro_name(trimmed, c"#ifndef")
            if is_header_guard(lines, i, ifndef_name) {
                val define_i: i64 = next_significant_line(lines, i + 1)
                val inner = translate_top_level(
                    lines,
                    current_dir,
                    define_i + 1,
                    indent,
                    out,
                    seen,
                    ctx
                )
                i = inner.next_index
                continue
            }
            val cond: i64 = detect_condition(trimmed)
            if cond == COND_WIN_TRUE {
                append_line(out, indent, c"when windows {")
                val then_result = translate_top_level(
                    lines,
                    current_dir,
                    i + 1,
                    indent + 1,
                    out,
                    seen,
                    ctx
                )
                if then_result.stop_kind == STOP_ELSE {
                    append_line(out, indent, c"} otherwise {")
                    val else_result = translate_top_level(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        seen,
                        ctx
                    )
                    append_line(out, indent, c"}")
                    i = else_result.next_index
                } elif then_result.stop_kind == STOP_ELIF {
                    append_line(out, indent, c"} otherwise {")
                    append_comment_line(out, indent + 1, then_result.stop_line)
                    val elif_result = translate_top_level(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        seen,
                        ctx
                    )
                    append_line(out, indent, c"}")
                    i = elif_result.next_index
                } else {
                    append_line(out, indent, c"}")
                    i = then_result.next_index
                }
                continue
            }
            if cond == COND_WIN_FALSE {
                val non_windows: ref void = builder.StringBuilder.new()
                val then_result = translate_top_level(
                    lines,
                    current_dir,
                    i + 1,
                    indent + 1,
                    non_windows,
                    seen,
                    ctx
                )
                append_line(out, indent, c"when windows {")
                if then_result.stop_kind == STOP_ELSE {
                    val else_result = translate_top_level(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        seen,
                        ctx
                    )
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = else_result.next_index
                } elif then_result.stop_kind == STOP_ELIF {
                    append_comment_line(out, indent + 1, then_result.stop_line)
                    val elif_result = translate_top_level(
                        lines,
                        current_dir,
                        then_result.next_index,
                        indent + 1,
                        out,
                        seen,
                        ctx
                    )
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = elif_result.next_index
                } else {
                    append_line(out, indent, c"} otherwise {")
                    append_builder(out, non_windows)
                    append_line(out, indent, c"}")
                    i = then_result.next_index
                }
                continue
            }
            if ctx.bind_mode && cstr.starts_with(trimmed, c"#define") {
                if emit_bind_macro(ctx, trimmed, out) {
                    i++
                    continue
                }
            }
            if cstr.starts_with(trimmed, c"#define")
            || cstr.starts_with(trimmed, c"#undef")
            || cstr.starts_with(trimmed, c"#pragma")
            || cstr.starts_with(trimmed, c"#error")
            || cstr.starts_with(trimmed, c"#if")
            || cstr.starts_with(trimmed, c"#ifndef")
            || cstr.starts_with(trimmed, c"#ifdef") {
                append_comment_line(out, indent, trimmed)
                i++
                continue
            }
            val starts_struct_decl: bool = cstr.starts_with(trimmed, c"typedef struct")
            || cstr.starts_with(trimmed, c"struct ")
            val starts_enum_decl: bool = cstr.starts_with(trimmed, c"typedef enum")
            || cstr.starts_with(trimmed, c"enum ")
            val starts_union_decl: bool = cstr.starts_with(trimmed, c"typedef union")
            || cstr.starts_with(trimmed, c"union ")
            val type_decl_has_brace: mut bool = str_contains(trimmed, c"{")
            if ((starts_struct_decl || starts_enum_decl || starts_union_decl) && !type_decl_has_brace) {
                val next_i_struct: i64 = next_significant_line(lines, i + 1)
                if next_i_struct >= 0 {
                    val next_struct_opt = @get(lines, next_i_struct as usize)
                    if next_struct_opt is some next_struct_line {
                        val next_struct_trimmed: ref u8 = trim_cstr(next_struct_line as ref u8)
                        if cstr.cmp(next_struct_trimmed, c"{") == 0 {
                            type_decl_has_brace = true
                        }
                    }
                }
            }
            if starts_struct_decl && type_decl_has_brace {
                val span = collect_struct(lines, i)
                val full_text: ref u8 = join_lines(lines, i, span.next_index)
                if !translate_struct_decl(full_text, indent, out, ctx) {
                    append_comment_line(
                        out,
                        indent,
                        trust tfmt("unsupported struct declaration: {s}", {trimmed})
                    )
                }
                i = span.next_index
                continue
            }
            if starts_enum_decl && type_decl_has_brace {
                val span_enum = collect_struct(lines, i)
                val full_text_enum: ref u8 = join_lines(lines, i, span_enum.next_index)
                if !translate_enum_decl(full_text_enum, indent, out, ctx) {
                    append_comment_line(
                        out,
                        indent,
                        trust tfmt("unsupported enum declaration: {s}", {trimmed})
                    )
                }
                i = span_enum.next_index
                continue
            }
            if starts_union_decl && type_decl_has_brace {
                val span_union = collect_struct(lines, i)
                val full_text_union: ref u8 = join_lines(lines, i, span_union.next_index)
                if !translate_union_decl(full_text_union, indent, out, ctx) {
                    append_comment_line(
                        out,
                        indent,
                        trust tfmt("unsupported union declaration: {s}", {trimmed})
                    )
                }
                i = span_union.next_index
                continue
            }
            if ctx.bind_mode && (starts_struct_decl || starts_union_decl || starts_enum_decl)
            && !type_decl_has_brace && !str_contains(trimmed, c"(")
            && !cstr.starts_with(trimmed, c"typedef ") {
                val prefix_len: mut i64 = 7
                if starts_union_decl {
                    prefix_len = 6
                } elif starts_enum_decl {
                    prefix_len = 5
                }
                val raw_name: ref u8 = trim_cstr(trust tsubstr(
                    strip_trailing_semicolon(trimmed),
                    prefix_len,
                    cstr.len(strip_trailing_semicolon(trimmed)) - prefix_len
                ))
                val opaque_name: ref u8 = sanitize_type_identifier(raw_name)
                if cstr.cmp(opaque_name, c"") != 0
                && !list_contains(ctx.translated_type_names, opaque_name) {
                    push_unique(ctx.translated_type_names, opaque_name)
                    append_open_block_line(
                        out,
                        indent,
                        trust tfmt("pub extern type {s} = ", {opaque_name})
                    )
                    append_line(out, indent, c"}")
                    append_blank_line(out)
                }
                i++
                continue
            }
            if ctx.bind_mode && cstr.starts_with(trimmed, c"typedef ")
            && str_contains(trimmed, c"(*") {
                val span_ptr = collect_function(lines, i)
                val full_ptr: ref u8 = join_lines(lines, i, span_ptr.next_index)
                val info: ref FnPtrInfo = parse_c_fnptr_type(ctx, full_ptr, c"")
                if info.is_ok && cstr.cmp(info.name, c"") != 0 {
                    register_typedef_alias(
                        ctx,
                        sanitize_type_identifier(info.name),
                        info.type_name
                    )
                    i = span_ptr.next_index
                    continue
                }
            }
            if str_contains(trimmed, c"(")
            && !cstr.starts_with(trimmed, c"if")
            && !cstr.starts_with(trimmed, c"for")
            && !cstr.starts_with(trimmed, c"while")
            && !cstr.starts_with(trimmed, c"switch")
            && !cstr.starts_with(trimmed, c"return") {
                val span2 = collect_function(lines, i)
                val full_text2: ref u8 = join_lines(lines, i, span2.next_index)
                if translate_function_decl(full_text2, current_dir, indent, out, ctx) {
                    i = span2.next_index
                    continue
                }
            }
            if translate_top_level_decl(trimmed, indent, out, ctx) {
                i++
                continue
            }
            append_comment_line(out, indent, trimmed)
            i++
        } else {
            i++
        }
    }
    return make_block_result(i, STOP_EOF, c"")
}

/// Translate preprocessed C header text into a Spectre binding module.
pub fn translate_bind_text(
    display_path: ref u8,
    content: ref u8,
    output_path: ref u8,
    normalize: bool,
    target_platform: ref u8,
    target_arch: ref u8,
    link_name: ref u8
) i32 = {
    trust reset_bind_normalization(normalize)
    val body: ref void = builder.StringBuilder.new()
    defer {
        trust builder.StringBuilder.free(body)
    }
    val seen: mut list[ref u8] = mem.new[ref u8]()
    val ctx: mut ref TranslationCtx = new_translation_ctx()
    ctx.bind_mode = true
    ctx.normalize = normalize
    ctx.target_platform = target_platform
    ctx.target_arch = target_arch
    val lines = split_lines(content)
    val result = translate_top_level(
        lines,
        trust tdir(display_path),
        0,
        0,
        body,
        seen,
        ctx
    )
    val out: ref void = builder.StringBuilder.new()
    defer {
        trust builder.StringBuilder.free(out)
    }
    append_comment_line(
        out,
        0,
        trust tfmt("Generated by spectre bind-c from {s}", {display_path})
    )
    append_blank_line(out)
    if cstr.cmp(link_name, c"") != 0 {
        append_line(out, 0, trust tfmt("lib \"{s}\"", {link_name}))
        append_blank_line(out)
    }
    append_builder(out, body)
    if result.stop_kind != STOP_EOF {
        append_comment_line(
            out,
            0,
            trust tfmt("unterminated preprocessor block in {s}", {display_path})
        )
    }
    val built: ref void = trust builder.StringBuilder.build(out)
    val out_dir: ref u8 = trust tdir(output_path)
    if cstr.cmp(out_dir, c"") != 0 && cstr.cmp(out_dir, c".") != 0 {
        match trust os.exec(tfmt("mkdir -p {s}", {out_dir})) {
            ok s => {
                trust take_cstr(s)
            }
            err _ => {}
        }
    }
    val written: bool = trust fs.write_all_cstr(output_path, take_cstr(built))
    if !written {
        trust stdio.print("error: could not write '{s}'\n", {output_path})
        return 1
    }
    return 0
}

pub fn translate_c(input_path: ref u8, output_path: ref u8) i32 = {
    trust reset_bind_normalization(false)
    val body: ref void = builder.StringBuilder.new()
    defer {
        trust builder.StringBuilder.free(body)
    }
    val seen: mut list[ref u8] = mem.new[ref u8]()
    val ctx: mut ref TranslationCtx = new_translation_ctx()
    val its_ok: bool = translate_file(input_path, body, seen, ctx)
    if !its_ok {
        trust stdio.print("error: failed to translate '{s}'\n", {input_path})
        return 1
    }
    val out: ref void = builder.StringBuilder.new()
    defer {
        trust builder.StringBuilder.free(out)
    }
    append_comment_line(
        out,
        0,
        trust tfmt("Generated by spectre -port-c from {s}", {input_path})
    )
    append_blank_line(out)
    append_synthesized_externs(ctx, out)
    append_builder(out, body)
    val built: ref void = trust builder.StringBuilder.build(out)
    val out_dir: ref u8 = trust tdir(output_path)
    if cstr.cmp(out_dir, c"") != 0 && cstr.cmp(out_dir, c".") != 0 {
        match trust os.exec(tfmt("mkdir -p {s}", {out_dir})) {
            ok s => {
                trust take_cstr(s)
            }
            err _ => {}
        }
    }
    val written: bool = trust fs.write_all_cstr(output_path, take_cstr(built))
    if !written {
        trust stdio.print("error: could not write '{s}'\n", {output_path})
        return 1
    }
    trust stdio.print("wrote {s}\n", {output_path})
    return 0
}
