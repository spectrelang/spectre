val str        = use("std/string")
val cstr       = use("std/string/cstr")
val ostr       = use("std/string/owned")
val mem        = use("../meta/mem.sx")
val path       = use("std/path")
val fs         = use("std/fs")
val reflection = use("std/reflection")
val allocators = use("std/allocators")
val parser     = use("../ast/parser.sx")
val lexer      = use("../ast/lexer.sx")
val defines    = use("../meta/defines.sx")
val libfind    = use("../meta/libfind.sx")
val commands   = use("../meta/commands.sx")

/// Runtime mode used by `when freestanding` / `when hosted` selectors.  The
/// compiler front end sets this before module resolution and updates it if a
/// program has to fall back to the hosted toolchain.
val module_runtime_mode: mut ref u8 = c"hosted"

pub fn set_runtime_mode(mode: ref u8) void = {
    if mode == none || cstr.cmp(mode, c"") == 0 {
        module_runtime_mode = c"hosted"
    } else {
        module_runtime_mode = mode
    }
}

pub fn runtime_is_freestanding() bool = {
    return cstr.cmp(module_runtime_mode, c"freestanding") == 0
}

/// A resolved module: its parsed items plus a map of named child imports.
/// Stored as parallel lists: import_names[i] <-> import_modules[i].
pub type ResolvedModule = {
    items: mut list[ref parser.Node]
    import_names: mut list[ref u8]
    import_modules: mut list[ref ResolvedModule]
    filename: mut String
    dir: mut String
}

pub fn new_resolved(
    arena: allocators.ScopedArenaAllocator,
    items: list[ref parser.Node],
    filename: String,
    dir: String
) ref ResolvedModule = trust {
    val m: mut ref ResolvedModule = allocators.ScopedArena.alloc_or_none(
        arena,
        @sizeof(ResolvedModule) as usize
    ) as ref ResolvedModule
    @memset(m, 0, @sizeof(ResolvedModule) as usize)
    m.items = items
    m.filename = filename
    m.dir = dir
    m.import_names = mem.new[ref u8]()
    m.import_modules = mem.new[ref ResolvedModule]()
    return m
}

/// Copy a C string into an arena-backed `String`.
fn arena_string(arena: allocators.ScopedArenaAllocator, src: ref u8) String = trust {
    val len: i64 = cstr.len(src)
    val buf: ref void = allocators.ScopedArena.alloc_or_none(arena, (len + 1) as usize)
    if buf == none {
        return none
    }
    if len > 0 {
        @memcpy(buf, src, len as usize)
    }
    @store8(@ptradd(buf, len), 0)
    val out: ref void = allocators.ScopedArena.alloc_or_none(
        arena,
        @sizeof(String) as usize
    )
    if out == none {
        return none
    }
    @store(out, buf)
    @store(@ptradd(out, 8), len)
    @store(@ptradd(out, 16), len + 1)
    return out as String
}

/// Check if a file exists by trying to open it.
fn file_exists(path: ref u8) bool = trust {
    val f = fs.open_cstr(path, c"r")
    if f is some h {
        fs.close(h)
        return true
    } else {
        return false
    }
}

/// Walk up from `start_dir` looking for a directory containing "Cargo.toml".
/// Returns the workspace root, or `start_dir` if not found.
fn find_workspace_root(start_dir: ref u8) ref u8 = trust {
    val cur: mut ref u8 = start_dir
    val limit: mut i64 = 32
    for {
        if limit <= 0 {
            break
        }
        limit--
        val spectre_mod: mut ref u8 = path.join_cstr(cur, c"sx.mod")
        val found_here: bool = file_exists(spectre_mod) &&
        commands.is_project_sxmod_at(cur)
        @free(spectre_mod)
        if found_here {
            return cur
        }
        val parent: mut ref u8 = path.dir_cstr(cur)
        if cstr.cmp(parent, cur) == 0 {
            if cstr.cmp(parent, c".") != 0 {
                @free(parent)
            }
            break
        }
        if cstr.cmp(parent, c".") == 0 {
            break
        }
        if cur != start_dir {
            @free(cur)
        }
        cur = parent
    }
    return start_dir
}

/// Join a candidate suffix onto `base`, taking ownership of `suffix`.
fn join_owned_suffix(base: ref u8, suffix: ref u8) ref u8 = trust {
    val joined = path.join_cstr(base, suffix)
    @free(suffix)
    return joined
}

/// Return the canonical form of an existing candidate, or none.
fn resolve_existing_candidate(base: ref u8, suffix: ref u8) ref u8 = trust {
    val joined: mut ref u8 = join_owned_suffix(base, suffix)
    if !file_exists(joined) {
        @free(joined)
        return none
    }
    val resolved = path.canonicalize_path_cstr(joined)
    @free(joined)
    return resolved
}

/// Return the canonical form of a candidate even if it does not exist.
fn canonical_candidate(base: ref u8, suffix: ref u8) ref u8 = trust {
    val joined: mut ref u8 = join_owned_suffix(base, suffix)
    val resolved = path.canonicalize_path_cstr(joined)
    @free(joined)
    return resolved
}

/// Resolve a use-path string relative to the current file's directory.
/// The workspace param must be the pre-computed workspace root (from find_workspace_root).
pub fn resolve_use_path(
    use_path: mut ref u8,
    file_dir: ref u8,
    exe_dir: ref u8,
    workspace: ref u8
) ref u8 = trust {
    val owned_use: mut ref u8 = none
    if cstr.starts_with(use_path, c"std/") {
        owned_use = @fmtalloc("spectrelib/{s}", {@ptradd(use_path, 4) as ref u8})
        use_path = owned_use
    }
    defer {
        if owned_use != none {
            @free(owned_use)
        }
    }
    val plen: i64 = cstr.len(use_path)

    if plen >= 3 {
        val c0: u8 = @load8(@ptradd(use_path, plen - 3))
        val c1: u8 = @load8(@ptradd(use_path, plen - 2))
        val c2: u8 = @load8(@ptradd(use_path, plen - 1))
        if c0 == 46 && c1 == 115 && c2 == 120 {
            val joined: mut ref u8 = path.join_cstr(file_dir, use_path)
            val resolved = path.canonicalize_path_cstr(joined)
            @free(joined)
            return resolved
        }
    }
    val has_slash: mut bool = false
    val si: mut i64 = 0

    for {
        if si >= plen {
            break
        }
        val c: u8 = @load8(@ptradd(use_path, si))
        if c == 47 {
            has_slash = true
            break
        }
        si++
    }

    if has_slash {
        val core_exe = resolve_existing_candidate(
            exe_dir,
            @fmtalloc("{s}/core.sx", {use_path})
        )
        if core_exe != none {
            return core_exe
        }
        val core_ws = resolve_existing_candidate(
            workspace,
            @fmtalloc("{s}/core.sx", {use_path})
        )
        if core_ws != none {
            return core_ws
        }

        val candidate_exe = resolve_existing_candidate(
            exe_dir,
            @fmtalloc("{s}.sx", {use_path})
        )
        if candidate_exe != none {
            return candidate_exe
        }
        val candidate_ws = resolve_existing_candidate(
            workspace,
            @fmtalloc("{s}.sx", {use_path})
        )
        if candidate_ws != none {
            return candidate_ws
        }
        return canonical_candidate(workspace, @fmtalloc("{s}.sx", {use_path}))
    }

    val core1_exe = resolve_existing_candidate(
        exe_dir,
        @fmtalloc("{s}/core.sx", {use_path})
    )
    if core1_exe != none {
        return core1_exe
    }
    val core1_ws = resolve_existing_candidate(
        workspace,
        @fmtalloc("{s}/core.sx", {use_path})
    )
    if core1_ws != none {
        return core1_ws
    }

    val candidate2_exe = resolve_existing_candidate(
        exe_dir,
        @fmtalloc("{s}/{s}.sx", {use_path, use_path})
    )
    if candidate2_exe != none {
        return candidate2_exe
    }
    val candidate2_ws = resolve_existing_candidate(
        workspace,
        @fmtalloc("{s}/{s}.sx", {use_path, use_path})
    )
    if candidate2_ws != none {
        return candidate2_ws
    }
    return canonical_candidate(workspace, @fmtalloc("{s}/{s}.sx", {use_path, use_path}))
}

fn in_progress_contains(in_progress: list[ref u8], path: ref u8) bool = trust {
    for p in in_progress {
        if cstr.cmp(p, path) == 0 {
            return true
        }
    }
    return false
}

/// Check if an import name is referenced anywhere in the items (functions, tests, globals).
/// This is used to determine if we should actually load an import or skip it.
fn import_is_referenced(items: list[ref parser.Node], import_name: ref u8) bool = trust {
    val items_len: i64 = @len(items) as i64
    val ii: mut i64 = 0
    for {
        if ii >= items_len {
            break
        }
        val item_opt = @get(items, ii as usize)
        if item_opt is some item_val {
            val item: ref parser.Node = item_val as ref parser.Node
            if item.kind == parser.NK_FN || item.kind == parser.NK_GENERIC_FN {
                val params: ref void = item.d3 as ref void
                if params != none {
                    for param in params as list[ref parser.Node] {
                        if type_references_import_shallow(
                            (param as ref parser.Node).d1 as ref parser.Node,
                            import_name
                        ) {
                            return true
                        }
                    }
                }
                if type_references_import_shallow(item.d4 as ref parser.Node, import_name) {
                    return true
                }
                if item.kind == parser.NK_GENERIC_FN {
                    val tparams: ref void = item.d6 as ref void
                    if tparams != none {
                        for tparam in tparams as list[ref parser.Node] {
                            val constraint: ref parser.Node = parser.tparam_constraint(tparam as ref parser.Node)
                            if type_references_import_shallow(constraint, import_name) {
                                return true
                            }
                        }
                    }
                }
                val body: ref void = item.d5 as ref void
                if body != none {
                    if item_references_import_shallow(body, import_name) {
                        return true
                    }
                }
            } elif item.kind == parser.NK_TEST {
                val body: ref void = item.d0 as ref void
                if body != none {
                    if item_references_import_shallow(body, import_name) {
                        return true
                    }
                }
            } elif item.kind == parser.NK_VAL {
                if type_references_import_shallow(item.d2 as ref parser.Node, import_name) {
                    return true
                }
                val init_expr: ref parser.Node = item.d3 as ref parser.Node
                if init_expr != none && expr_references_import_shallow(init_expr, import_name) {
                    return true
                }
            } elif item.kind == parser.NK_CONST {
                val expr: ref parser.Node = item.d2 as ref parser.Node
                if expr != none && expr_references_import_shallow(expr, import_name) {
                    return true
                }
            } elif item.kind == parser.NK_EXTERN_VAL {
                if type_references_import_shallow(item.d3 as ref parser.Node, import_name) {
                    return true
                }
            }
        }
        ii++
    }

    return false
}

fn type_name_references_import(type_name: ref u8, import_name: ref u8) bool = trust {
    if type_name == none || import_name == none {
        return false
    }
    val import_len: i64 = cstr.len(import_name)
    val i: mut i64 = 0
    for {
        if i >= import_len {
            break
        }
        val tc: u8 = @load8(@ptradd(type_name, i))
        val ic: u8 = @load8(@ptradd(import_name, i))
        if tc != ic {
            return false
        }
        i++
    }
    val next: u8 = @load8(@ptradd(type_name, import_len))
    return next == 46
}

fn type_references_import_shallow(ty: ref parser.Node, import_name: ref u8) bool = trust {
    if ty == none {
        return false
    }
    if ty.kind == parser.TY_NAMED {
        val type_name: ref u8 = parser.node_str_raw(ty.d0)
        return type_name_references_import(type_name, import_name)
    }
    if ty.kind == parser.TY_MUT || ty.kind == parser.TY_REF || ty.kind == parser.TY_LIST {
        return type_references_import_shallow(ty.d0 as ref parser.Node, import_name)
    }
    if ty.kind == parser.TY_RESULT {
        if type_references_import_shallow(ty.d0 as ref parser.Node, import_name) {
            return true
        }
        return type_references_import_shallow(ty.d1 as ref parser.Node, import_name)
    }
    return false
}

/// Shallow check if a statement list references an import (just checks identifiers and fields).
fn item_references_import_shallow(stmts_ptr: ref void, import_name: ref u8) bool = trust {
    if stmts_ptr == none {
        return false
    }

    val stmts: list[ref parser.Node] = stmts_ptr as list[ref parser.Node]
    val slen: i64 = @len(stmts) as i64

    if slen < 0 || slen > 100000 {
        return false
    }

    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }

        val stmt_opt = @get(stmts, si as usize)

        if stmt_opt is some stmt_val {
            val stmt: ref parser.Node = stmt_val as ref parser.Node
            if stmt != none {
                if stmt_references_import_shallow(stmt, import_name) {
                    return true
                }
            }
        }
        si++
    }
    return false
}

/// Shallow check if a statement references an import.
fn stmt_references_import_shallow(node: ref parser.Node, import_name: ref u8) bool = trust {
    if node == none {
        return false
    }

    if node.kind == parser.NK_VAL {
        if type_references_import_shallow(node.d2 as ref parser.Node, import_name) {
            return true
        }
        return expr_references_import_shallow(node.d3 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_ASSIGN {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        return expr_references_import_shallow(node.d1 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_RETURN {
        return expr_references_import_shallow(node.d0 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_EXPR_STMT {
        return expr_references_import_shallow(node.d0 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_TRUST_BLOCK {
        val block_body: ref void = node.d0 as ref void
        if block_body != none {
            for block_stmt in block_body as list[ref parser.Node] {
                if stmt_references_import_shallow(block_stmt, import_name) {
                    return true
                }
            }
        }
    } elif node.kind == parser.NK_ASSERT {
        return expr_references_import_shallow(node.d0 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_WHEN_STMT {
        val when_body: ref void = node.d1 as ref void
        if when_body != none {
            val wlen: i64 = @len(when_body) as i64
            val wi: mut i64 = 0
            for {
                if wi >= wlen {
                    break
                }
                val stmt_opt = @get(when_body, wi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                wi++
            }
        }
        val or_branches: ref void = node.d2 as ref void
        if or_branches != none {
            val olen: i64 = @len(or_branches) as i64
            val oi: mut i64 = 0
            for {
                if oi >= olen {
                    break
                }
                val or_opt = @get(or_branches, oi as usize)
                if or_opt is some or_node {
                    val or_body: ref void = (or_node as ref parser.Node).d1 as ref void
                    if or_body != none {
                        val orlen: i64 = @len(or_body) as i64
                        val ori: mut i64 = 0
                        for {
                            if ori >= orlen {
                                break
                            }
                            val or_stmt_opt = @get(or_body, ori as usize)
                            if or_stmt_opt is some or_stmt {
                                if stmt_references_import_shallow(
                                    or_stmt as ref parser.Node,
                                    import_name
                                ) {
                                    return true
                                }
                            }
                            ori++
                        }
                    }
                }
                oi++
            }
        }
        val owise: ref void = node.d3 as ref void
        if owise != none {
            val olen: i64 = @len(owise) as i64
            val oi: mut i64 = 0
            for {
                if oi >= olen {
                    break
                }
                val o_stmt_opt = @get(owise, oi as usize)
                if o_stmt_opt is some o_stmt {
                    if stmt_references_import_shallow(o_stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                oi++
            }
        }
    } elif node.kind == parser.NK_GUARD {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val guard_body: ref void = node.d1 as ref void
        if guard_body != none {
            val gblen: i64 = @len(guard_body) as i64
            val gbi: mut i64 = 0
            for {
                if gbi >= gblen {
                    break
                }
                val stmt_opt = @get(guard_body, gbi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                gbi++
            }
        }
    } elif node.kind == parser.NK_IF {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val then_body: ref void = node.d1 as ref void
        if then_body != none {
            val tlen: i64 = @len(then_body) as i64
            val ti: mut i64 = 0
            for {
                if ti >= tlen {
                    break
                }
                val stmt_opt = @get(then_body, ti as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                ti++
            }
        }
        val elif_list: ref void = node.d2 as ref void
        if elif_list != none {
            val elen: i64 = @len(elif_list) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val elif_opt = @get(elif_list, ei as usize)
                if elif_opt is some elif_node {
                    if stmt_references_import_shallow(elif_node as ref parser.Node, import_name) {
                        return true
                    }
                }
                ei++
            }
        }
        val else_body_node: ref parser.Node = node.d3 as ref parser.Node
        if else_body_node != none {
            val else_stmts: ref void = else_body_node.d0 as ref void
            if else_stmts != none {
                val eslen: i64 = @len(else_stmts) as i64
                val esi: mut i64 = 0
                for {
                    if esi >= eslen {
                        break
                    }
                    val stmt_opt = @get(else_stmts, esi as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    esi++
                }
            }
        }
    } elif node.kind == parser.NK_FOR {
        val init: ref parser.Node = node.d1 as ref parser.Node
        if init != none && expr_references_import_shallow(init, import_name) {
            return true
        }
        val cond: ref parser.Node = node.d2 as ref parser.Node
        if cond != none && expr_references_import_shallow(cond, import_name) {
            return true
        }
        val post_n: ref parser.Node = node.d3 as ref parser.Node
        if post_n != none && stmt_references_import_shallow(post_n, import_name) {
            return true
        }
        val body: ref void = node.d4 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_FORIN {
        val iter: ref parser.Node = node.d1 as ref parser.Node
        if iter != none && expr_references_import_shallow(iter, import_name) {
            return true
        }
        val body: ref void = node.d2 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_MATCH_OPT {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val some_body_node: ref parser.Node = node.d2 as ref parser.Node
        if some_body_node != none {
            val some_body: ref void = some_body_node.d0 as ref void
            if some_body != none {
                val slen: i64 = @len(some_body) as i64
                val si: mut i64 = 0
                for {
                    if si >= slen {
                        break
                    }
                    val stmt_opt = @get(some_body, si as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    si++
                }
            }
        }
        val none_body_node: ref parser.Node = node.d3 as ref parser.Node
        if none_body_node != none {
            val none_body: ref void = none_body_node.d0 as ref void
            if none_body != none {
                val nlen: i64 = @len(none_body) as i64
                val ni: mut i64 = 0
                for {
                    if ni >= nlen {
                        break
                    }
                    val stmt_opt = @get(none_body, ni as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    ni++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_RES {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val ok_body_node: ref parser.Node = node.d2 as ref parser.Node
        if ok_body_node != none {
            val ok_body: ref void = ok_body_node.d0 as ref void
            if ok_body != none {
                val olen: i64 = @len(ok_body) as i64
                val oi: mut i64 = 0
                for {
                    if oi >= olen {
                        break
                    }
                    val stmt_opt = @get(ok_body, oi as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    oi++
                }
            }
        }
        val err_body_node: ref parser.Node = node.d4 as ref parser.Node
        if err_body_node != none {
            val err_body: ref void = err_body_node.d0 as ref void
            if err_body != none {
                val elen: i64 = @len(err_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(err_body, ei as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_ENUM {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val arms: ref void = node.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d1 as ref void
                    if body != none {
                        val blen: i64 = @len(body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(body, bi as usize)
                            if stmt_opt is some stmt {
                                if stmt_references_import_shallow(
                                    stmt as ref parser.Node,
                                    import_name
                                ) {
                                    return true
                                }
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
    } elif node.kind == parser.NK_MATCH_VALUE {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val arms: ref void = node.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    if expr_references_import_shallow(
                        parser.match_value_arm_pattern(arm_node),
                        import_name
                    ) {
                        return true
                    }
                    val body: ref void = parser.match_value_arm_body(arm_node) as ref void
                    if body != none {
                        val blen: i64 = @len(body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(body, bi as usize)
                            if stmt_opt is some stmt {
                                if stmt_references_import_shallow(
                                    stmt as ref parser.Node,
                                    import_name
                                ) {
                                    return true
                                }
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = parser.match_value_else(node)
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                val elen: i64 = @len(else_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_body, ei as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_TAGGED_UNION {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val arms: ref void = node.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d2 as ref void
                    if body != none {
                        val blen: i64 = @len(body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(body, bi as usize)
                            if stmt_opt is some stmt {
                                if stmt_references_import_shallow(
                                    stmt as ref parser.Node,
                                    import_name
                                ) {
                                    return true
                                }
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = node.d2 as ref parser.Node
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                val elen: i64 = @len(else_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_body, ei as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_UNION {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val arms: ref void = node.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d1 as ref void
                    if body != none {
                        val blen: i64 = @len(body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(body, bi as usize)
                            if stmt_opt is some stmt {
                                if stmt_references_import_shallow(
                                    stmt as ref parser.Node,
                                    import_name
                                ) {
                                    return true
                                }
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = node.d2 as ref parser.Node
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                val elen: i64 = @len(else_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_body, ei as usize)
                    if stmt_opt is some stmt {
                        if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                            return true
                        }
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_GENERIC_WHEN {
        val gbody: ref void = node.d1 as ref void
        if gbody != none {
            val gblen: i64 = @len(gbody) as i64
            val gbi: mut i64 = 0
            for {
                if gbi >= gblen {
                    break
                }
                val stmt_opt = @get(gbody, gbi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                gbi++
            }
        }
    } elif node.kind == parser.NK_DEFER {
        val dbody: ref void = node.d0 as ref void
        if dbody != none {
            val dblen: i64 = @len(dbody) as i64
            val dbi: mut i64 = 0
            for {
                if dbi >= dblen {
                    break
                }
                val stmt_opt = @get(dbody, dbi as usize)
                if stmt_opt is some stmt {
                    if stmt_references_import_shallow(stmt as ref parser.Node, import_name) {
                        return true
                    }
                }
                dbi++
            }
        }
    } elif node.kind == parser.NK_INCREMENT || node.kind == parser.NK_DECREMENT {
        return expr_references_import_shallow(node.d0 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_ADD_ASSIGN || node.kind == parser.NK_SUB_ASSIGN {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
        return expr_references_import_shallow(node.d1 as ref parser.Node, import_name)
    } elif node.kind == parser.NK_PRE || node.kind == parser.NK_POST {
        val clist: ref void = node.d0 as ref void
        if clist != none {
            for c in clist as list[ref parser.Node] {
                if expr_references_import_shallow(c.d1 as ref parser.Node, import_name) {
                    return true
                }
            }
        }
    }
    return false
}

/// Shallow check if an expression references an import (only checks ident and field).
fn expr_references_import_shallow(node: ref parser.Node, import_name: ref u8) bool = trust {
    if node == none {
        return false
    }

    if node.kind == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(node.d0)
        if cstr.cmp(name, import_name) == 0 {
            return true
        }
    } elif node.kind == parser.NK_FIELD {
        val base: ref parser.Node = parser.field_base(node)
        if base != none {
            if base.kind == parser.NK_IDENT {
                val base_name: ref u8 = parser.node_str_raw(base.d0)
                if cstr.cmp(base_name, import_name) == 0 {
                    return true
                }
            } elif base.kind == parser.NK_FIELD {
                if expr_references_import_shallow(base, import_name) {
                    return true
                }
            }
        }
    } elif node.kind == parser.NK_CALL {
        if expr_references_import_shallow(parser.call_callee(node), import_name) {
            return true
        }
        val args: ref void = parser.call_args(node) as ref void
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg_opt = @get(args, ai as usize)
                if arg_opt is some arg {
                    if expr_references_import_shallow(arg as ref parser.Node, import_name) {
                        return true
                    }
                }
                ai++
            }
        }
    } elif node.kind == parser.NK_BUILTIN {
        val args: ref void = node.d1 as ref void
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg_opt = @get(args, ai as usize)
                if arg_opt is some arg {
                    if expr_references_import_shallow(arg as ref parser.Node, import_name) {
                        return true
                    }
                }
                ai++
            }
        }
    } elif node.kind == parser.NK_ARGS_PACK {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val e_opt = @get(elems, ei as usize)
                if e_opt is some e {
                    if expr_references_import_shallow(e as ref parser.Node, import_name) {
                        return true
                    }
                }
                ei++
            }
        }
    } elif node.kind == parser.NK_BINOP {
        if expr_references_import_shallow(parser.binop_left(node), import_name) {
            return true
        }
        if expr_references_import_shallow(parser.binop_right(node), import_name) {
            return true
        }
    } elif node.kind == parser.NK_UNOP {
        if expr_references_import_shallow(parser.unop_inner(node), import_name) {
            return true
        }
    } elif node.kind == parser.NK_CAST || node.kind == parser.NK_ADDR || node.kind == parser.NK_DEREF || node.kind == parser.NK_TRY || node.kind == parser.NK_TRUST {
        if node.kind == parser.NK_CAST && type_references_import_shallow(
            node.d1 as ref parser.Node,
            import_name
        ) {
            return true
        }
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
    } elif node.kind == parser.NK_SOME || node.kind == parser.NK_OK_VAL || node.kind == parser.NK_ERR_VAL {
        if expr_references_import_shallow(node.d0 as ref parser.Node, import_name) {
            return true
        }
    } elif node.kind == parser.NK_STRUCT_LIT {
        val fields: ref void = node.d1 as ref void
        if fields != none {
            val flen: i64 = @len(fields) as i64
            val fi: mut i64 = 0
            for {
                if fi >= flen {
                    break
                }
                val f_opt = @get(fields, fi as usize)
                if f_opt is some f {
                    if expr_references_import_shallow(
                        (f as ref parser.Node).d1 as ref parser.Node,
                        import_name
                    ) {
                        return true
                    }
                }
                fi++
            }
        }
    } elif node.kind == parser.NK_GENERIC_INST {
        val targs: list[ref parser.Node] = parser.generic_inst_type_args(node)
        for targ in targs {
            if type_references_import_shallow(targ, import_name) {
                return true
            }
        }
        return expr_references_import_shallow(node.d0 as ref parser.Node, import_name)
    }

    return false
}

/// Recursively resolve a module from its source path.
/// needed_children: optional list of child import names that must be loaded (for DCE)
fn items_have_external_links(items: list[ref parser.Node]) bool = trust {
    for item in items {
        if item.kind == parser.NK_LINK || item.kind == parser.NK_LIB {
            return true
        } elif item.kind == parser.NK_WHEN_ITEMS {
            val witems: list[ref parser.Node] = item.d1 as list[ref parser.Node]
            if items_have_external_links(witems) {
                return true
            }
            val or_when_branches3: ref void = item.d2 as ref void
            if or_when_branches3 != none {
                for ow3 in or_when_branches3 as list[ref parser.Node] {
                    val ow_items3: list[ref parser.Node] = ow3.d1 as list[ref parser.Node]
                    if items_have_external_links(ow_items3) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

fn resolve_module_impl(
    arena: allocators.ScopedArenaAllocator,
    path: ref u8,
    in_progress: list[ref u8],
    exe_dir: ref u8,
    needed_children: ref void,
    cache_keys: mut list[ref u8],
    cache_vals: mut list[ref void]
) result[ref ResolvedModule, ref u8] = trust {
    val canonical_path: ref u8 = path.canonicalize_path_cstr(path)
    if in_progress_contains(in_progress, canonical_path) {
        return err @fmtalloc("cyclic import: {s}", {canonical_path})
    }

    val cn: i64 = @len(cache_keys) as i64
    val ci: mut i64 = 0
    for {
        if ci >= cn {
            break
        }
        val ck_opt = @get(cache_keys, ci as usize)
        if ck_opt is some ck {
            if cstr.cmp(ck as ref u8, canonical_path) == 0 {
                val cv_opt = @get(cache_vals, ci as usize)
                if cv_opt is some cv {
                    return ok (cv as ref ResolvedModule)
                }
            }
        }
        ci++
    }

    val src_size_opt = fs.file_size_cstr(canonical_path)
    val src_arena_cap: mut i64 = 4096
    if src_size_opt is some sz {
        if ((sz as i64) > src_arena_cap) {
            src_arena_cap = sz as i64
        }
    } else {
        return err @fmtalloc("cannot read module: {s}", {canonical_path})
    }
    val src_arena: allocators.Arena = allocators.Arena.new((src_arena_cap + 8) as usize)?
    val src_opt = fs.read_all_cstr[allocators.Arena](src_arena, canonical_path)
    val src: mut ref u8 = c""
    if src_opt is some s {
        src = s as ref u8
    } else {
        allocators.Arena.free(src_arena)
        return err @fmtalloc("cannot read module: {s}", {canonical_path})
    }

    val lex_result = lexer.tokenize_with_view(arena, str.from_cstr(src))
    allocators.Arena.free(src_arena)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match lex_result {
        ok t => {
            tokens = t
        }
        err e => {
            return err @fmtalloc("{s}: lex error: {s}", {canonical_path, e})
        }
    }

    val parse_result = parser.parse_module_with(arena, tokens, canonical_path)
    lexer.free_tokens(tokens)
    val items: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    match parse_result {
        ok i => {
            items = i
        }
        err e => {
            return err @fmtalloc("{s}: parse error: {s}", {canonical_path, e})
        }
    }

    val dir_part: mut ref u8 = path.dir_cstr(canonical_path)
    val file_dir = arena_string(arena, dir_part)
    if cstr.cmp(dir_part, c".") != 0 {
        @free(dir_part)
    }
    val file_dir_c = ostr.as_cstr(file_dir)
    val workspace = find_workspace_root(file_dir_c)
    val module_path = arena_string(arena, canonical_path)
    val m: ref ResolvedModule = new_resolved(arena, items, module_path, file_dir)

    val cur_progress: mut list[ref u8] = in_progress
    @append(cur_progress, canonical_path)

    val is_std_module: bool = cstr.cmp(canonical_path, c"std/sx") == 0 ||
    (cstr.len(canonical_path) >= 10 &&
        cstr.cmp(
            @ptradd(canonical_path, cstr.len(canonical_path) - 10) as ref u8,
            c"std/sx"
        ) == 0)

    for item in items {
        val node: ref parser.Node = item
        if node.kind == parser.NK_USE {
            val import_name: ref u8 = parser.node_str_raw(node.d1)
            val use_path: mut ref u8 = parser.node_str_raw(node.d2)
            val is_json_or_net: bool = cstr.cmp(import_name, c"json") == 0 ||
            cstr.cmp(import_name, c"net") == 0
            val skip_std_dce: bool = is_std_module && !is_json_or_net
            val needed_subs: list[ref u8] = collect_needed_subnames_transitive(
                items,
                import_name,
                use_path,
                file_dir_c,
                exe_dir,
                cur_progress
            )
            val is_directly_referenced: bool = @len(needed_subs) > 0 || import_is_referenced(
                items,
                import_name
            )
            val is_needed_by_parent: mut bool = false

            if needed_children != none {
                val needed_list: list[ref u8] = needed_children as list[ref u8]
                is_needed_by_parent = import_in_list(needed_list, import_name)
            }

            if !skip_std_dce && !is_directly_referenced && !is_needed_by_parent {
                continue
            }

            if is_std_module && is_json_or_net {
                if !is_directly_referenced && !is_needed_by_parent {
                    continue
                }
            }

            val resolved_path: mut ref u8 = resolve_use_path(
                use_path,
                file_dir_c,
                exe_dir,
                workspace
            )
            if defines.is_env_module_path(str.from_cstr(resolved_path)) {
                defines.register_env_alias(str.from_cstr(import_name))
            }
            val needed_grandchildren: mut ref void = none
            if @len(needed_subs) > 0 {
                needed_grandchildren = needed_subs as ref void
            }
            val child_result = resolve_module_impl(
                arena,
                resolved_path,
                cur_progress,
                exe_dir,
                needed_grandchildren,
                cache_keys,
                cache_vals
            )

            match child_result {
                ok child => {
                    @append(m.import_names, import_name)
                    @append(m.import_modules, child as ref void)
                }
                err e => {
                    return err @fmtalloc(
                        "could not resolve import '{s}': {s}",
                        {import_name, e}
                    )
                }
            }
        }
    }

    @remove(cur_progress, @len(cur_progress) - 1)
    @append(cache_keys, canonical_path)
    @append(cache_vals, m)
    return ok m
}

pub fn resolve_module(
    arena: allocators.ScopedArenaAllocator,
    path: ref u8,
    in_progress: list[ref u8],
    exe_dir: ref u8,
    needed_children: ref void
) result[ref ResolvedModule, ref u8] = trust {
    val cache_keys: mut list[ref u8] = mem.new[ref u8]()
    val cache_vals: mut list[ref void] = mem.new[ref void]()
    val resolved = resolve_module_impl(
        arena,
        path,
        in_progress,
        exe_dir,
        needed_children,
        cache_keys,
        cache_vals
    )
    val key_count: i64 = @len(cache_keys) as i64
    val ki: mut i64 = 0
    for ki < key_count {
        val key_opt = @get(cache_keys, ki as usize)
        if key_opt is some key {
            val key_ptr: mut ref u8 = key as ref u8
            if key_ptr != path {
                @free(key_ptr)
            }
        }
        ki++
    }
    return resolved
}

/// Look up a direct import of `m` by its alias name.
/// Returns the child ResolvedModule if found, or null if not found.
pub fn find_import_by_name(m: ref ResolvedModule, name: ref u8) ref ResolvedModule = trust {
    val nlen: i64 = @len(m.import_names) as i64
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        val n_opt = @get(m.import_names, i as usize)
        if n_opt is some n {
            if cstr.cmp(n as ref u8, name) == 0 {
                val mod_opt = @get(m.import_modules, i as usize)
                if mod_opt is some child {
                    return child as ref ResolvedModule
                }
            }
        }
        i++
    }
    return none
}

/// Check whether a function named `fn_name` is declared `pub` in module `m`.
/// Returns true if public (or not found — conservative default for external fns).
pub fn fn_is_public_in_module(m: ref ResolvedModule, fn_name: ref u8) bool = trust {
    val ilen: i64 = @len(m.items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(m.items, i as usize)
        if item_opt is some item_raw {
            val item: ref parser.Node = item_raw as ref parser.Node
            if item.kind == parser.NK_FN || item.kind == parser.NK_GENERIC_FN {
                val iname: ref u8 = parser.node_str_raw(item.d2)
                if iname != none {
                    if cstr.cmp(iname, fn_name) == 0 {
                        return (item.d0 & 1) != 0
                    }
                }
            } elif item.kind == parser.NK_EXTERN_FN {
                val iname: ref u8 = parser.node_str_raw(item.d1)
                if iname != none {
                    if cstr.cmp(iname, fn_name) == 0 {
                        return item.d0 == 1
                    }
                }
            }
        }
        i++
    }
    return true
}

pub fn fn_is_unsafe_in_module(m: ref ResolvedModule, fn_name: ref u8) bool = trust {
    val ilen: i64 = @len(m.items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(m.items, i as usize)
        if item_opt is some item_raw {
            val item: ref parser.Node = item_raw as ref parser.Node
            if item.kind == parser.NK_FN || item.kind == parser.NK_GENERIC_FN {
                val iname: ref u8 = parser.node_str_raw(item.d2)
                if iname != none {
                    if cstr.cmp(iname, fn_name) == 0 {
                        return parser.fn_is_unsafe(item)
                    }
                }
            }
        }
        i++
    }
    return false
}

/// Number of direct imports in module `m`.
pub fn import_count(m: ref ResolvedModule) i64 = trust {
    return @len(m.import_names) as i64
}

/// Return the i-th imported child module, or null.
pub fn import_module_at(m: ref ResolvedModule, i: usize) ref ResolvedModule = trust {
    val opt = @get(m.import_modules, i)
    if opt is some child {
        return child as ref ResolvedModule
    } else {
        return none
    }
}

/// Return the i-th import name, or null.
pub fn import_name_at(m: ref ResolvedModule, i: usize) ref u8 = trust {
    val opt = @get(m.import_names, i)
    if opt is some name {
        return name as ref u8
    } else {
        return none
    }
}

/// Return the filename of module `m` as a raw C str.
pub fn module_filename(m: ref ResolvedModule) ref u8 = trust {
    return ostr.as_cstr(m.filename)
}

/// Return the top-level items list of module `m`.
pub fn module_items(m: ref ResolvedModule) list[ref parser.Node] = trust {
    return m.items
}

/// Collect all unique filenames in the resolved module tree (depth-first).
/// Used to avoid emitting the same module twice.
fn collect_seen(m: ref ResolvedModule, seen: ref void) void = trust {
    val mlen: i64 = @len(seen as list[String]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= mlen {
            break
        }
        val s_opt = @get(seen as list[String], fi as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return
            }
        }
        fi++
    }
    val clen: i64 = @len(m.import_modules) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val c_opt = @get(m.import_modules, ci as usize)
        if c_opt is some c {
            collect_seen(c as ref ResolvedModule, seen)
        }
        ci++
    }
    @append(seen as list[String], m.filename)
}

/// Flatten the resolved module tree into an ordered list of (prefix, items) pairs,
/// children before parents, no duplicates.
/// `prefix` is the mangled module prefix (e.g. "std__stdio"), empty for root.
pub fn flatten_modules(
    arena: allocators.ScopedArenaAllocator,
    m: ref ResolvedModule,
    prefix: ref u8,
    out_prefixes: mut list[ref u8],
    out_items: mut list[ref void],
    seen: mut list[String]
) void = trust {
    val slen: i64 = @len(seen as list[String]) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(seen as list[String], si as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return
            }
        }
        si++
    }

    val clen: i64 = @len(m.import_modules) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val name_opt = @get(m.import_names, ci as usize)
        val mod_opt = @get(m.import_modules, ci as usize)
        if name_opt is some name {
            if mod_opt is some child {
                val child_prefix: ref u8 = name as ref u8
                flatten_modules(
                    arena,
                    child as ref ResolvedModule,
                    child_prefix,
                    out_prefixes,
                    out_items,
                    seen
                )
            }
        }
        ci++
    }

    @append(seen as list[String], m.filename)
    @append(out_prefixes as list[ref u8], prefix)
    @append(out_items as list[ref void], m.items)
}

pub fn flatten_modules_with_files(
    arena: allocators.ScopedArenaAllocator,
    m: ref ResolvedModule,
    prefix: ref u8,
    out_prefixes: mut list[ref u8],
    out_items: mut list[ref void],
    out_filenames: mut list[ref u8],
    seen: mut list[String]
) void = trust {
    val slen: i64 = @len(seen as list[String]) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(seen as list[String], si as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return
            }
        }
        si++
    }
    val clen: i64 = @len(m.import_modules) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val name_opt = @get(m.import_names, ci as usize)
        val mod_opt = @get(m.import_modules, ci as usize)
        if name_opt is some name {
            if mod_opt is some child {
                flatten_modules_with_files(
                    arena,
                    child as ref ResolvedModule,
                    name as ref u8,
                    out_prefixes,
                    out_items,
                    out_filenames,
                    seen
                )
            }
        }
        ci++
    }
    @append(seen as list[String], m.filename)
    @append(out_prefixes as list[ref u8], prefix)
    @append(out_items as list[ref void], m.items)
    @append(out_filenames as list[ref u8], ostr.as_cstr(m.filename))
}

fn link_path_is_absolute(flag: ref u8) bool = trust {
    if flag == none {
        return false
    }
    val n: i64 = cstr.len(flag)
    if n <= 0 {
        return false
    }
    val c0: u8 = @load8(flag)
    if c0 == 47 || c0 == 92 {
        return true
    }
    when windows {
        if n >= 2 && @load8(@ptradd(flag, 1)) == 58 {
            return true
        }
    }
    return false
}

fn link_workspace_root() ref u8 = trust {
    val cwd_opt = fs.cwd_cstr()
    match cwd_opt {
        some cwd => {
            return find_workspace_root(cwd)
        }
        none => {
            return c"."
        }
    }
}

/// Workspace root that owns the module declaring a link directive.
///
/// Link paths such as "./src/stb_image_shim.c" are package-relative, not
/// consumer-relative. Resolving them against this root lets a project import a
/// dependency whose manifest lives in lib/<name>/ while still finding C sources
/// that belong to that dependency.
///
/// `path.dir_cstr()` preserves a trailing separator, so normalize before walking
/// upward; otherwise the first parent lookup compares equal to the current
/// directory and the walk stops immediately.
fn module_link_root(m: ref ResolvedModule) ref u8 = trust {
    val start_dir: ref u8 = ostr.as_cstr(m.dir)
    val cur: mut ref u8 = path.canonicalize_path_cstr(start_dir)
    val limit: mut i64 = 32
    for {
        if limit <= 0 {
            break
        }
        limit--
        val spectre_mod: ref u8 = path.join_cstr(cur, c"sx.mod")
        if file_exists(spectre_mod) && commands.is_project_sxmod_at(cur) {
            return cur
        }
        val parent: ref u8 = path.canonicalize_path_cstr(path.dir_cstr(cur))
        if cstr.cmp(parent, cur) == 0 {
            break
        }
        cur = parent
    }
    return start_dir
}

fn link_path_has_separator(flag: ref u8) bool = trust {
    val n: i64 = cstr.len(flag)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(flag, i))
        if c == 47 || c == 92 {
            return true
        }
        i++
    }
    return false
}

fn resolve_link_path(flag: ref u8, workspace: ref u8) ref u8 = trust {
    if flag == none {
        return flag
    }
    val n: i64 = cstr.len(flag)
    if n <= 0 {
        return flag
    }
    if @load8(flag) == 45 {
        return flag
    }
    if link_path_is_absolute(flag) {
        return flag
    }
    if file_exists(flag) {
        return flag
    }
    if !link_path_has_separator(flag) {
        return flag
    }
    if workspace == none || cstr.cmp(workspace, c"") == 0 || cstr.cmp(workspace, c".") == 0 {
        return flag
    }
    val name: mut ref u8 = flag
    if n >= 2 && @load8(flag) == 46 && @load8(@ptradd(flag, 1)) == 47 {
        name = @ptradd(flag, 2) as ref u8
    }
    val candidate: ref u8 = path.join_cstr(workspace, name)
    if file_exists(candidate) {
        return candidate
    }
    return flag
}

fn resolve_link_directive(
    item: ref parser.Node,
    platform: ref u8,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val flags: mut list[ref u8] = mem.new[ref u8]()
    if item.kind == parser.NK_LINK {
        @append(flags, parser.node_str_raw(item.d0))
    } elif item.kind == parser.NK_LIB {
        return libfind.resolve(parser.node_str(item.d0), str.from_cstr(platform), static_link)
    }
    return ok flags
}

/// Collect all link statements from a module's items, resolving package-local
/// paths against `link_root`.
/// Returns a list of link flags (strings like "-lcurl" or full paths).
fn collect_links_with_root(
    items: list[ref parser.Node],
    link_root: ref u8,
    exe_dir: ref u8,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val links: mut list[ref u8] = mem.new[ref u8]()
    val p: i64 = reflection.get_current_platform[allocators.Arena](arena) as i64
    val platform: mut ref u8 = c"unknown"
    if p == 0 {
        platform = c"windows"
    } elif p == 1 {
        platform = c"linux"
    } elif p == 2 {
        platform = c"darwin"
    } elif p == 3 {
        platform = c"netbsd"
    } elif p == 4 {
        platform = c"dragonflybsd"
    } elif p == 5 {
        platform = c"freebsd"
    } elif p == 6 {
        platform = c"openbsd"
    } elif p == 7 {
        platform = c"android"
    } elif p == 8 {
        platform = c"haiku"
    }

    for item in items {
        if item.kind == parser.NK_LINK || item.kind == parser.NK_LIB {
            val resolved = resolve_link_directive(item, platform, static_link)?
            for flag in resolved {
                @append(links, flag)
            }
        } elif item.kind == parser.NK_WHEN_ITEMS {
            val when_platform: ref u8 = parser.node_str_raw(item.d0)
            val matched: mut bool = false
            if platform_matches(platform, when_platform) {
                matched = true
                val when_items: list[ref parser.Node] = item.d1 as list[ref parser.Node]
                for wnode in when_items {
                    val resolved = resolve_link_directive(wnode, platform, static_link)?
                    for flag in resolved {
                        @append(links, flag)
                    }
                }
            }
            if !matched {
                val or_branches: ref void = item.d2 as ref void
                if or_branches != none {
                    for ob in or_branches as list[ref parser.Node] {
                        if !matched {
                            val ob_plat: ref u8 = parser.node_str_raw(ob.d0)
                            if platform_matches(platform, ob_plat) {
                                matched = true
                                val ob_items: list[ref parser.Node] = ob.d1 as list[ref parser.Node]
                                for obnode in ob_items {
                                    val resolved = resolve_link_directive(
                                        obnode,
                                        platform,
                                        static_link
                                    )?
                                    for flag in resolved {
                                        @append(links, flag)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if !matched {
                val otherwise: ref void = item.d3 as ref void
                if otherwise != none {
                    for ow in otherwise as list[ref parser.Node] {
                        val resolved = resolve_link_directive(ow, platform, static_link)?
                        for flag in resolved {
                            @append(links, flag)
                        }
                    }
                }
            }
        }
    }

    val result: mut list[ref u8] = mem.new[ref u8]()
    val workspace: ref u8 = link_root
    for the_link in links {
        if cstr.cmp(the_link, c"__sx__internal__json__") == 0 {
            val shim_c: ref u8 = path.join_cstr(exe_dir, c"spectrelib/csources/yyjson_shim.c")
            val shim_o: ref u8 = path.join_cstr(exe_dir, c"spectrelib/csources/yyjson_shim.o")

            if file_exists(shim_c) {
                @append(result, shim_c)
            } elif file_exists(shim_o) {
                @append(result, shim_o)
            } else {
                @append(result, the_link)
            }
        } else {
            @append(result, resolve_link_path(the_link, workspace))
        }
    }

    allocators.Arena.free(arena)
    return ok result
}

/// Collect all link statements from a module's items using the current project
/// workspace as the link root.
pub fn collect_links(
    items: list[ref parser.Node],
    exe_dir: ref u8,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    return collect_links_with_root(items, link_workspace_root(), exe_dir, static_link)
}

/// Collect links only from modules that match the given used_prefixes list.
pub fn collect_links_filtered(
    m: ref ResolvedModule,
    prefix: ref u8,
    used_prefixes: list[ref u8],
    exe_dir: ref u8,
    seen: mut list[String],
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val slen: i64 = @len(seen) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(seen, si as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return ok mem.new[ref u8]()
            }
        }
        si++
    }

    @append(seen, m.filename)

    val result: mut list[ref u8] = mem.new[ref u8]()

    val is_used: mut bool = false
    val ulen: i64 = @len(used_prefixes) as i64
    val ui: mut i64 = 0
    for {
        if ui >= ulen {
            break
        }
        val u_opt = @get(used_prefixes, ui as usize)
        if u_opt is some u {
            if cstr.cmp(u as ref u8, prefix) == 0 {
                is_used = true
                break
            }
        }
        ui++
    }

    if is_used {
        val my_links: list[ref u8] = collect_links_with_root(
            m.items,
            module_link_root(m),
            exe_dir,
            static_link
        )?
        for lnk in my_links {
            @append(result, lnk)
        }
    }

    val clen: i64 = @len(m.import_modules) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val name_opt = @get(m.import_names, ci as usize)
        val mod_opt = @get(m.import_modules, ci as usize)
        if name_opt is some name {
            if mod_opt is some child {
                val child_prefix: mut ref u8 = c""
                if cstr.cmp(prefix, c"") == 0 {
                    child_prefix = name as ref u8
                } else {
                    child_prefix = @fmtalloc("{s}__{s}", {prefix, name as ref u8})
                }
                val child_links: list[ref u8] = collect_links_filtered(
                    child as ref ResolvedModule,
                    child_prefix,
                    used_prefixes,
                    exe_dir,
                    seen,
                    static_link
                )?
                for clink in child_links {
                    @append(result, clink)
                }
            }
        }
        ci++
    }

    return ok result
}

/// Collect links from all modules in the tree.
pub fn collect_links_all(
    m: ref ResolvedModule,
    prefix: ref u8,
    exe_dir: ref u8,
    seen: mut list[String],
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val slen: i64 = @len(seen) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(seen, si as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return ok mem.new[ref u8]()
            }
        }
        si++
    }

    @append(seen, m.filename)

    val result: mut list[ref u8] = mem.new[ref u8]()

    val my_links: list[ref u8] = collect_links_with_root(
        m.items,
        module_link_root(m),
        exe_dir,
        static_link
    )?
    for lnk in my_links {
        @append(result, lnk)
    }

    val clen: i64 = @len(m.import_modules) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val name_opt = @get(m.import_names, ci as usize)
        val mod_opt = @get(m.import_modules, ci as usize)
        if name_opt is some name {
            if mod_opt is some child {
                val child_prefix: mut ref u8 = c""
                if cstr.cmp(prefix, c"") == 0 {
                    child_prefix = name as ref u8
                } else {
                    child_prefix = @fmtalloc("{s}__{s}", {prefix, name as ref u8})
                }
                val child_links: list[ref u8] = collect_links_all(
                    child as ref ResolvedModule,
                    child_prefix,
                    exe_dir,
                    seen,
                    static_link
                )?
                for clink in child_links {
                    @append(result, clink)
                }
            }
        }
        ci++
    }

    return ok result
}

/// Compare a length-delimited selector segment with a NUL-terminated literal.
fn selector_segment_eq(seg: ref u8, seg_len: i64, lit: ref u8) bool = trust {
    if cstr.len(lit) != seg_len {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= seg_len {
            break
        }
        if @load8(@ptradd(seg, i)) != @load8(@ptradd(lit, i)) {
            return false
        }
        i++
    }
    return true
}

fn platform_is_posix(current: ref u8) bool = trust {
    if cstr.cmp(current, c"linux") == 0 {
        return true
    }
    if cstr.cmp(current, c"darwin") == 0 {
        return true
    }
    if cstr.cmp(current, c"freebsd") == 0 {
        return true
    }
    if cstr.cmp(current, c"openbsd") == 0 {
        return true
    }
    if cstr.cmp(current, c"netbsd") == 0 {
        return true
    }
    if cstr.cmp(current, c"dragonflybsd") == 0 {
        return true
    }
    if cstr.cmp(current, c"haiku") == 0 {
        return true
    }
    if cstr.cmp(current, c"android") == 0 {
        return true
    }
    if cstr.cmp(current, c"redox") == 0 {
        return true
    }
    return false
}

fn platform_is_bsd(current: ref u8) bool = trust {
    return cstr.cmp(current, c"freebsd") == 0 ||
    cstr.cmp(current, c"openbsd") == 0 ||
    cstr.cmp(current, c"netbsd") == 0 ||
    cstr.cmp(current, c"dragonflybsd") == 0
}

/// Match a platform segment that may be a concrete OS or a group alias.
fn platform_segment_matches(current: ref u8, seg: ref u8, seg_len: i64) bool = trust {
    if selector_segment_eq(seg, seg_len, current) {
        return true
    }
    if selector_segment_eq(seg, seg_len, c"posix") ||
    selector_segment_eq(seg, seg_len, c"unix") {
        return platform_is_posix(current)
    }
    if selector_segment_eq(seg, seg_len, c"bsd") {
        return platform_is_bsd(current)
    }
    return false
}

fn is_arch_selector(name: ref u8) bool = trust {
    return cstr.cmp(name, c"x86_64") == 0 ||
    cstr.cmp(name, c"amd64") == 0 ||
    cstr.cmp(name, c"aarch64") == 0 ||
    cstr.cmp(name, c"arm64") == 0 ||
    cstr.cmp(name, c"riscv64") == 0 ||
    cstr.cmp(name, c"riscv32") == 0 ||
    cstr.cmp(name, c"riscv") == 0 ||
    cstr.cmp(name, c"x86") == 0 ||
    cstr.cmp(name, c"i386") == 0 ||
    cstr.cmp(name, c"i686") == 0 ||
    cstr.cmp(name, c"arm") == 0 ||
    cstr.cmp(name, c"armv7") == 0 ||
    cstr.cmp(name, c"mips") == 0 ||
    cstr.cmp(name, c"mips64") == 0 ||
    cstr.cmp(name, c"ppc64") == 0 ||
    cstr.cmp(name, c"powerpc64") == 0 ||
    cstr.cmp(name, c"s390x") == 0 ||
    cstr.cmp(name, c"wasm32") == 0 ||
    cstr.cmp(name, c"wasm64") == 0
}

fn normalize_arch_name(name: ref u8) ref u8 = trust {
    if cstr.cmp(name, c"amd64") == 0 {
        return c"x86_64"
    }
    if cstr.cmp(name, c"arm64") == 0 {
        return c"aarch64"
    }
    if cstr.cmp(name, c"i386") == 0 || cstr.cmp(name, c"i686") == 0 {
        return c"x86"
    }
    if cstr.cmp(name, c"powerpc64") == 0 {
        return c"ppc64"
    }
    return name
}

/// Check whether an architecture selector matches the host architecture.
pub fn arch_matches(name: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val current: ref u8 = reflection.current_arch_name[allocators.Arena](arena)
    val matched: bool = cstr.cmp(normalize_arch_name(name), normalize_arch_name(current)) == 0
    allocators.Arena.free(arena)
    return matched
}

/// Check whether an architecture selector matches the supplied architecture.
fn arch_matches_named(name: ref u8, current: ref u8) bool = trust {
    return cstr.cmp(normalize_arch_name(name), normalize_arch_name(current)) == 0
}

/// Check whether a when selector matches the current platform (and host
/// architecture when the selector names or includes one).
///
/// Accepted forms:
///   - platform or platform group: `linux`, `windows`, `posix`, `bsd`
///   - architecture: `x86_64`, `aarch64`, `riscv64`
///   - platform.architecture: `linux.x86_64`, `posix.aarch64`
pub fn when_selector_matches(current: ref u8, name: ref u8) bool = trust {
    if cstr.cmp(name, c"freestanding") == 0 {
        return cstr.cmp(module_runtime_mode, c"freestanding") == 0
    }
    if cstr.cmp(name, c"hosted") == 0 {
        return cstr.cmp(module_runtime_mode, c"hosted") == 0
    }
    val nlen: i64 = cstr.len(name)
    val dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        if @load8(@ptradd(name, i)) == 46 {
            dot = i
            break
        }
        i++
    }

    val cur_len: i64 = cstr.len(current)
    val cur_dot: mut i64 = -1
    val ci: mut i64 = 0
    for {
        if ci >= cur_len {
            break
        }
        if @load8(@ptradd(current, ci)) == 46 {
            cur_dot = ci
            break
        }
        ci++
    }
    val cur_platform: mut ref u8 = current
    val cur_arch: mut ref u8 = c""
    if cur_dot > 0 && cur_dot + 1 < cur_len {
        cur_platform = cstr.substr(current, 0, cur_dot)
        cur_arch = cstr.substr(current, cur_dot + 1, cur_len - cur_dot - 1)
    }

    if dot >= 0 {
        if dot == 0 || dot + 1 >= nlen {
            return false
        }
        if !platform_segment_matches(cur_platform, name, dot) {
            return false
        }
        val wanted_arch: ref u8 = @ptradd(name, dot + 1)
        if cstr.cmp(cur_arch, c"") != 0 {
            return arch_matches_named(wanted_arch, cur_arch)
        }
        return arch_matches(wanted_arch)
    }
    if is_arch_selector(name) {
        if cstr.cmp(cur_arch, c"") != 0 {
            return arch_matches_named(name, cur_arch)
        }
        return arch_matches(name)
    }
    return platform_segment_matches(cur_platform, name, nlen)
}

/// Check if a platform/architecture selector matches the current platform.
/// Handles group aliases like "posix" matching linux/darwin/bsd/etc.
pub fn platform_matches(current: ref u8, name: ref u8) bool = trust {
    return when_selector_matches(current, name)
}

/// Check if an import name is in the list.
fn import_in_list(import_names: list[ref u8], name: ref u8) bool = trust {
    val len: i64 = @len(import_names) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val opt = @get(import_names, i as usize)
        if opt is some n {
            if cstr.cmp(n as ref u8, name) == 0 {
                return true
            }
        }
        i++
    }
    return false
}

/// Collect sub-module names accessed via <import_name>.<sub> in items.
/// e.g. for import_name="std", finds "stdio" and returns ["stdio"]
fn collect_needed_subnames(items: list[ref parser.Node], import_name: ref u8) list[ref u8] = trust {
    val needed: mut list[ref u8] = mem.new[ref u8]()
    val items_len: i64 = @len(items) as i64
    val ii: mut i64 = 0
    for {
        if ii >= items_len {
            break
        }
        val item_opt = @get(items, ii as usize)
        if item_opt is some item_val {
            val item: ref parser.Node = item_val as ref parser.Node
            if item.kind == parser.NK_FN || item.kind == parser.NK_GENERIC_FN {
                val body: ref void = item.d5 as ref void
                if body != none {
                    collect_needed_subnames_in_stmts(body, import_name, needed)
                }
            } elif item.kind == parser.NK_TEST {
                val body: ref void = item.d0 as ref void
                if body != none {
                    collect_needed_subnames_in_stmts(body, import_name, needed)
                }
            } elif item.kind == parser.NK_CONST {
                val expr: ref parser.Node = item.d2 as ref parser.Node
                if expr != none {
                    collect_needed_subnames_in_expr(expr, import_name, needed)
                }
            }
        }
        ii++
    }
    return needed
}

fn collect_needed_subnames_in_stmts(
    stmts_ptr: ref void,
    import_name: ref u8,
    needed: mut list[ref u8]
) void = trust {
    if stmts_ptr == none {
        return
    }
    val stmts: list[ref parser.Node] = stmts_ptr as list[ref parser.Node]
    val slen: i64 = @len(stmts) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val stmt_opt = @get(stmts, si as usize)
        if stmt_opt is some stmt_val {
            val stmt: ref parser.Node = stmt_val as ref parser.Node
            if stmt != none {
                collect_needed_subnames_in_stmt(stmt, import_name, needed)
            }
        }
        si++
    }
}

fn collect_needed_subnames_in_stmt(
    stmt: ref parser.Node,
    import_name: ref u8,
    needed: mut list[ref u8]
) void = trust {
    if stmt == none {
        return
    }

    if stmt.kind == parser.NK_VAL {
        collect_needed_subnames_in_expr(stmt.d3 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_ASSIGN {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        collect_needed_subnames_in_expr(stmt.d1 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_RETURN {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_EXPR_STMT {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_TRUST_BLOCK {
        val block_body: ref void = stmt.d0 as ref void
        if block_body != none {
            collect_needed_subnames_in_stmts(block_body, import_name, needed)
        }
    } elif stmt.kind == parser.NK_GUARD {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val guard_body2: ref void = stmt.d1 as ref void
        if guard_body2 != none {
            collect_needed_subnames_in_stmts(guard_body2, import_name, needed)
        }
    } elif stmt.kind == parser.NK_IF {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val then_body: ref void = stmt.d1 as ref void
        if then_body != none {
            collect_needed_subnames_in_stmts(then_body, import_name, needed)
        }
        val elif_list: ref void = stmt.d2 as ref void
        if elif_list != none {
            val elen: i64 = @len(elif_list) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val elif_opt = @get(elif_list, ei as usize)
                if elif_opt is some elif_node {
                    val elif_stmt_node: ref parser.Node = elif_node as ref parser.Node
                    collect_needed_subnames_in_expr(
                        elif_stmt_node.d0 as ref parser.Node,
                        import_name,
                        needed
                    )
                    val elif_body: ref void = elif_stmt_node.d1 as ref void
                    if elif_body != none {
                        collect_needed_subnames_in_stmts(elif_body, import_name, needed)
                    }
                }
                ei++
            }
        }
        val else_node: ref parser.Node = stmt.d3 as ref parser.Node
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                collect_needed_subnames_in_stmts(else_body, import_name, needed)
            }
        }
    } elif stmt.kind == parser.NK_FOR {
        val init: ref parser.Node = stmt.d1 as ref parser.Node
        if init != none {
            collect_needed_subnames_in_expr(init, import_name, needed)
        }
        val cond: ref parser.Node = stmt.d2 as ref parser.Node
        if cond != none {
            collect_needed_subnames_in_expr(cond, import_name, needed)
        }
        val post_n: ref parser.Node = stmt.d3 as ref parser.Node
        if post_n != none {
            collect_needed_subnames_in_stmt(post_n, import_name, needed)
        }
        val body: ref void = stmt.d4 as ref void
        if body != none {
            collect_needed_subnames_in_stmts(body, import_name, needed)
        }
    } elif stmt.kind == parser.NK_FORIN {
        val iter: ref parser.Node = stmt.d1 as ref parser.Node
        if iter != none {
            collect_needed_subnames_in_expr(iter, import_name, needed)
        }
        val body: ref void = stmt.d2 as ref void
        if body != none {
            collect_needed_subnames_in_stmts(body, import_name, needed)
        }
    } elif stmt.kind == parser.NK_MATCH_OPT {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val some_body_node: ref parser.Node = stmt.d2 as ref parser.Node
        if some_body_node != none {
            val some_body: ref void = some_body_node.d0 as ref void
            if some_body != none {
                collect_needed_subnames_in_stmts(some_body, import_name, needed)
            }
        }
        val none_body_node: ref parser.Node = stmt.d3 as ref parser.Node
        if none_body_node != none {
            val none_body: ref void = none_body_node.d0 as ref void
            if none_body != none {
                collect_needed_subnames_in_stmts(none_body, import_name, needed)
            }
        }
    } elif stmt.kind == parser.NK_MATCH_RES {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val ok_body_node: ref parser.Node = stmt.d2 as ref parser.Node
        if ok_body_node != none {
            val ok_body: ref void = ok_body_node.d0 as ref void
            if ok_body != none {
                collect_needed_subnames_in_stmts(ok_body, import_name, needed)
            }
        }
        val err_body_node: ref parser.Node = stmt.d4 as ref parser.Node
        if err_body_node != none {
            val err_body: ref void = err_body_node.d0 as ref void
            if err_body != none {
                collect_needed_subnames_in_stmts(err_body, import_name, needed)
            }
        }
    } elif stmt.kind == parser.NK_MATCH_ENUM {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d1 as ref void
                    if body != none {
                        collect_needed_subnames_in_stmts(body, import_name, needed)
                    }
                }
                ai++
            }
        }
    } elif stmt.kind == parser.NK_MATCH_UNION {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d1 as ref void
                    if body != none {
                        collect_needed_subnames_in_stmts(body, import_name, needed)
                    }
                }
                ai++
            }
        }
    } elif stmt.kind == parser.NK_MATCH_TAGGED_UNION {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d2 as ref void
                    if body != none {
                        collect_needed_subnames_in_stmts(body, import_name, needed)
                    }
                }
                ai++
            }
        }
    } elif stmt.kind == parser.NK_MATCH_STR {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val body: ref void = arm_node.d1 as ref void
                    if body != none {
                        collect_needed_subnames_in_stmts(body, import_name, needed)
                    }
                }
                ai++
            }
        }
    } elif stmt.kind == parser.NK_MATCH_VALUE {
        collect_needed_subnames_in_expr(parser.match_value_expr(stmt), import_name, needed)
        val arms: ref void = parser.match_value_arms(stmt) as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    collect_needed_subnames_in_expr(
                        parser.match_value_arm_pattern(arm_node),
                        import_name,
                        needed
                    )
                    val body: ref void = parser.match_value_arm_body(arm_node) as ref void
                    if body != none {
                        collect_needed_subnames_in_stmts(body, import_name, needed)
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = parser.match_value_else(stmt)
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                collect_needed_subnames_in_stmts(else_body, import_name, needed)
            }
        }
    } elif stmt.kind == parser.NK_ASSERT {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_WHEN_STMT {
        val when_body: ref void = stmt.d1 as ref void
        if when_body != none {
            collect_needed_subnames_in_stmts(when_body, import_name, needed)
        }
    } elif stmt.kind == parser.NK_DEFER {
        val defer_body: ref parser.Node = stmt.d0 as ref parser.Node
        if defer_body != none {
            collect_needed_subnames_in_stmt(defer_body, import_name, needed)
        }
    } elif stmt.kind == parser.NK_BREAK || stmt.kind == parser.NK_CONTINUE {
    } elif stmt.kind == parser.NK_TRY {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_PRE || stmt.kind == parser.NK_POST {
        val contracts: ref void = stmt.d0 as ref void
        if contracts != none {
            val clen: i64 = @len(contracts) as i64
            val ci: mut i64 = 0
            for {
                if ci >= clen {
                    break
                }
                val c_opt = @get(contracts, ci as usize)
                if c_opt is some c {
                    val cnode: ref parser.Node = c as ref parser.Node
                    collect_needed_subnames_in_expr(
                        cnode.d1 as ref parser.Node,
                        import_name,
                        needed
                    )
                }
                ci++
            }
        }
    } elif stmt.kind == parser.NK_GENERIC_WHEN {
        val gbody: ref void = stmt.d1 as ref void
        if gbody != none {
            collect_needed_subnames_in_stmts(gbody, import_name, needed)
        }
    } elif stmt.kind == parser.NK_INCREMENT || stmt.kind == parser.NK_DECREMENT {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
    } elif stmt.kind == parser.NK_ADD_ASSIGN || stmt.kind == parser.NK_SUB_ASSIGN {
        collect_needed_subnames_in_expr(stmt.d0 as ref parser.Node, import_name, needed)
        collect_needed_subnames_in_expr(stmt.d1 as ref parser.Node, import_name, needed)
    }
}

fn collect_needed_subnames_in_expr(
    expr: ref parser.Node,
    import_name: ref u8,
    needed: mut list[ref u8]
) void = trust {
    if expr == none {
        return
    }

    if expr.kind == parser.NK_FIELD {
        val base: ref parser.Node = parser.field_base(expr)
        val field_name: ref u8 = parser.field_name_raw(expr)

        if base != none && base.kind == parser.NK_IDENT {
            val base_name: ref u8 = parser.node_str_raw(base.d0)
            if cstr.cmp(base_name, import_name) == 0 {
                if !import_in_list(needed, field_name) {
                    @append(needed, field_name)
                }
            }
        }
        collect_needed_subnames_in_expr(base, import_name, needed)
    } elif expr.kind == parser.NK_CALL {
        collect_needed_subnames_in_expr(parser.call_callee(expr), import_name, needed)
        val args: ref void = parser.call_args(expr) as ref void
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg_opt = @get(args, ai as usize)
                if arg_opt is some arg {
                    collect_needed_subnames_in_expr(arg as ref parser.Node, import_name, needed)
                }
                ai++
            }
        }
    } elif expr.kind == parser.NK_BUILTIN {
        val args: ref void = expr.d1 as ref void
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg_opt = @get(args, ai as usize)
                if arg_opt is some arg {
                    collect_needed_subnames_in_expr(arg as ref parser.Node, import_name, needed)
                }
                ai++
            }
        }
    } elif expr.kind == parser.NK_BINOP {
        collect_needed_subnames_in_expr(parser.binop_left(expr), import_name, needed)
        collect_needed_subnames_in_expr(parser.binop_right(expr), import_name, needed)
    } elif expr.kind == parser.NK_UNOP {
        collect_needed_subnames_in_expr(parser.unop_inner(expr), import_name, needed)
    } elif expr.kind == parser.NK_CAST || expr.kind == parser.NK_ADDR || expr.kind == parser.NK_DEREF || expr.kind == parser.NK_TRY || expr.kind == parser.NK_TRUST {
        collect_needed_subnames_in_expr(expr.d0 as ref parser.Node, import_name, needed)
    } elif expr.kind == parser.NK_SOME || expr.kind == parser.NK_OK_VAL || expr.kind == parser.NK_ERR_VAL {
        collect_needed_subnames_in_expr(expr.d0 as ref parser.Node, import_name, needed)
    } elif expr.kind == parser.NK_ARGS_PACK {
        val elems: ref void = expr.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val e_opt = @get(elems, ei as usize)
                if e_opt is some e {
                    collect_needed_subnames_in_expr(e as ref parser.Node, import_name, needed)
                }
                ei++
            }
        }
    } elif expr.kind == parser.NK_STRUCT_LIT {
        val fields: ref void = expr.d0 as ref void
        if fields != none {
            val flen: i64 = @len(fields) as i64
            val fi: mut i64 = 0
            for {
                if fi >= flen {
                    break
                }
                val f_opt = @get(fields, fi as usize)
                if f_opt is some f {
                    val fnode: ref parser.Node = f as ref parser.Node
                    collect_needed_subnames_in_expr(
                        fnode.d1 as ref parser.Node,
                        import_name,
                        needed
                    )
                }
                fi++
            }
        }
    } elif expr.kind == parser.NK_LIST_LIT {
        val elems: ref void = expr.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val e_opt = @get(elems, ei as usize)
                if e_opt is some e {
                    collect_needed_subnames_in_expr(e as ref parser.Node, import_name, needed)
                }
                ei++
            }
        }
    } elif expr.kind == parser.NK_GENERIC_INST {
        collect_needed_subnames_in_expr(expr.d0 as ref parser.Node, import_name, needed)
    }
}

/// Collect all unique sub-module names accessed via <import_name>.<sub> in items.
pub fn collect_needed_subnames_transitive(
    items: list[ref parser.Node],
    import_name: ref u8,
    _: ref u8,
    _: ref u8,
    _: ref u8,
    _: list[ref u8]
) list[ref u8] = trust {
    return collect_needed_subnames(items, import_name)
}

/// Collect used import names from an expression.
fn mark_import_used(import_names: list[ref u8], used: mut list[ref u8], name: ref u8) void = trust {
    if name == none {
        return
    }
    if import_in_list(import_names, name) && !import_in_list(used, name) {
        @append(used, name)
    }
}

fn collect_used_imports_type(
    ty: ref parser.Node,
    import_names: list[ref u8],
    used: mut list[ref u8]
) void = trust {
    if ty == none {
        return
    }

    if ty.kind == parser.TY_NAMED {
        for import_name in import_names {
            if type_name_references_import(parser.node_str_raw(ty.d0), import_name) {
                mark_import_used(import_names, used, import_name)
                return
            }
        }
    } elif ty.kind == parser.TY_MUT || ty.kind == parser.TY_REF || ty.kind == parser.TY_OPTION || ty.kind == parser.TY_LIST || ty.kind == parser.TY_SLICE {
        collect_used_imports_type(ty.d0 as ref parser.Node, import_names, used)
    } elif ty.kind == parser.TY_RESULT {
        collect_used_imports_type(ty.d0 as ref parser.Node, import_names, used)
        collect_used_imports_type(ty.d1 as ref parser.Node, import_names, used)
    } elif ty.kind == parser.TY_FIXED_ARR {
        collect_used_imports_type(ty.d1 as ref parser.Node, import_names, used)
    } elif ty.kind == parser.TY_FNPTR {
        val params: ref void = ty.d0 as ref void
        if params != none {
            for param_ty in params as list[ref parser.Node] {
                collect_used_imports_type(param_ty as ref parser.Node, import_names, used)
            }
        }
        collect_used_imports_type(ty.d1 as ref parser.Node, import_names, used)
    }
}

fn collect_used_imports_expr(
    node: ref parser.Node,
    import_names: list[ref u8],
    used: mut list[ref u8]
) void = trust {
    if node == none {
        return
    }

    if node.kind == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(node.d0)
        mark_import_used(import_names, used, name)
    } elif node.kind == parser.NK_FIELD {
        val base: ref parser.Node = parser.field_base(node)
        if base != none && base.kind == parser.NK_IDENT {
            val name: ref u8 = parser.node_str_raw(base.d0)
            mark_import_used(import_names, used, name)
        }
        collect_used_imports_expr(base, import_names, used)
    } elif node.kind == parser.NK_CALL {
        collect_used_imports_expr(parser.call_callee(node), import_names, used)
        val args: ref void = parser.call_args(node) as ref void
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg_opt = @get(args, ai as usize)
                if arg_opt is some arg {
                    collect_used_imports_expr(arg as ref parser.Node, import_names, used)
                }
                ai++
            }
        }
    } elif node.kind == parser.NK_BINOP {
        collect_used_imports_expr(parser.binop_left(node), import_names, used)
        collect_used_imports_expr(parser.binop_right(node), import_names, used)
    } elif node.kind == parser.NK_UNOP {
        collect_used_imports_expr(parser.unop_inner(node), import_names, used)
    } elif node.kind == parser.NK_CAST {
        collect_used_imports_type(node.d1 as ref parser.Node, import_names, used)
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_SOME || node.kind == parser.NK_OK_VAL || node.kind == parser.NK_ERR_VAL || node.kind == parser.NK_TRY || node.kind == parser.NK_TRUST || node.kind == parser.NK_ADDR || node.kind == parser.NK_DEREF {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_STRUCT_LIT {
        val fields: ref void = node.d1 as ref void
        if fields != none {
            val flen: i64 = @len(fields) as i64
            val fi: mut i64 = 0
            for {
                if fi >= flen {
                    break
                }
                val field_opt = @get(fields, fi as usize)
                if field_opt is some field {
                    collect_used_imports_expr(field as ref parser.Node, import_names, used)
                }
                fi++
            }
        }
    } elif node.kind == parser.NK_LIST_LIT {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val e_opt = @get(elems, ei as usize)
                if e_opt is some e {
                    collect_used_imports_expr(e as ref parser.Node, import_names, used)
                }
                ei++
            }
        }
    } elif node.kind == parser.NK_BUILTIN {
        val bargs: ref void = node.d1 as ref void
        if bargs != none {
            val blen: i64 = @len(bargs) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val b_opt = @get(bargs, bi as usize)
                if b_opt is some b {
                    collect_used_imports_expr(b as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_ARGS_PACK {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val e_opt = @get(elems, ei as usize)
                if e_opt is some e {
                    collect_used_imports_expr(e as ref parser.Node, import_names, used)
                }
                ei++
            }
        }
    } elif node.kind == parser.NK_GENERIC_INST {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val targs: list[ref parser.Node] = parser.generic_inst_type_args(node)
        for targ in targs {
            collect_used_imports_type(targ as ref parser.Node, import_names, used)
        }
    }
}

/// Collect used import names from a statement.
fn collect_used_imports_stmt(
    node: ref parser.Node,
    import_names: list[ref u8],
    used: mut list[ref u8]
) void = trust {
    if node == none {
        return
    }

    if node.kind == parser.NK_VAL {
        collect_used_imports_type(node.d2 as ref parser.Node, import_names, used)
        collect_used_imports_expr(node.d3 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_ASSIGN {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        collect_used_imports_expr(node.d1 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_RETURN {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_EXPR_STMT {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_TRUST_BLOCK {
        val block_body: ref void = node.d0 as ref void
        if block_body != none {
            for block_stmt in block_body as list[ref parser.Node] {
                collect_used_imports_stmt(block_stmt, import_names, used)
            }
        }
    } elif node.kind == parser.NK_ASSERT {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_ADD_ASSIGN || node.kind == parser.NK_SUB_ASSIGN {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        collect_used_imports_expr(node.d1 as ref parser.Node, import_names, used)
    } elif node.kind == parser.NK_WHEN_STMT {
        val when_body: ref void = node.d1 as ref void
        if when_body != none {
            val wlen: i64 = @len(when_body) as i64
            val wi: mut i64 = 0
            for {
                if wi >= wlen {
                    break
                }
                val stmt_opt = @get(when_body, wi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                wi++
            }
        }
        val or_branches: ref void = node.d2 as ref void
        if or_branches != none {
            val olen: i64 = @len(or_branches) as i64
            val oi: mut i64 = 0
            for {
                if oi >= olen {
                    break
                }
                val or_opt = @get(or_branches, oi as usize)
                if or_opt is some or_node {
                    val or_body: ref void = (or_node as ref parser.Node).d1 as ref void
                    if or_body != none {
                        val orlen: i64 = @len(or_body) as i64
                        val ori: mut i64 = 0
                        for {
                            if ori >= orlen {
                                break
                            }
                            val or_stmt_opt = @get(or_body, ori as usize)
                            if or_stmt_opt is some or_stmt {
                                collect_used_imports_stmt(
                                    or_stmt as ref parser.Node,
                                    import_names,
                                    used
                                )
                            }
                            ori++
                        }
                    }
                }
                oi++
            }
        }
        val owise: ref void = node.d3 as ref void
        if owise != none {
            val olen: i64 = @len(owise) as i64
            val oi: mut i64 = 0
            for {
                if oi >= olen {
                    break
                }
                val o_stmt_opt = @get(owise, oi as usize)
                if o_stmt_opt is some o_stmt {
                    collect_used_imports_stmt(o_stmt as ref parser.Node, import_names, used)
                }
                oi++
            }
        }
    } elif node.kind == parser.NK_DEFER {
        val body: ref void = node.d0 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_GUARD {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val guard_body3: ref void = node.d1 as ref void
        if guard_body3 != none {
            val gb3len: i64 = @len(guard_body3) as i64
            val gb3i: mut i64 = 0
            for {
                if gb3i >= gb3len {
                    break
                }
                val stmt_opt = @get(guard_body3, gb3i as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                gb3i++
            }
        }
    } elif node.kind == parser.NK_IF {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val then_body: ref void = node.d1 as ref void
        if then_body != none {
            val tlen: i64 = @len(then_body) as i64
            val ti: mut i64 = 0
            for {
                if ti >= tlen {
                    break
                }
                val stmt_opt = @get(then_body, ti as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                ti++
            }
        }
        val elif_list: ref void = node.d2 as ref void
        if elif_list != none {
            val e2len: i64 = @len(elif_list) as i64
            val e2i: mut i64 = 0
            for {
                if e2i >= e2len {
                    break
                }
                val elif_opt = @get(elif_list, e2i as usize)
                if elif_opt is some elif_node {
                    collect_used_imports_stmt(elif_node as ref parser.Node, import_names, used)
                }
                e2i++
            }
        }
        val else_body_node: ref parser.Node = node.d3 as ref parser.Node
        if else_body_node != none {
            val else_stmts: ref void = else_body_node.d0 as ref void
            if else_stmts != none {
                val elen: i64 = @len(else_stmts) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_stmts, ei as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_FOR {
        val init: ref parser.Node = node.d1 as ref parser.Node
        if init != none {
            collect_used_imports_expr(init, import_names, used)
        }
        val cond: ref parser.Node = node.d2 as ref parser.Node
        if cond != none {
            collect_used_imports_expr(cond, import_names, used)
        }
        val post_n: ref parser.Node = node.d3 as ref parser.Node
        if post_n != none {
            collect_used_imports_stmt(post_n, import_names, used)
        }
        val body: ref void = node.d4 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_FORIN {
        collect_used_imports_expr(node.d1 as ref parser.Node, import_names, used)
        val body: ref void = node.d2 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif node.kind == parser.NK_MATCH_OPT {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val some_body_node: ref parser.Node = node.d2 as ref parser.Node
        if some_body_node != none {
            val some_body: ref void = some_body_node.d0 as ref void
            if some_body != none {
                val slen: i64 = @len(some_body) as i64
                val si: mut i64 = 0
                for {
                    if si >= slen {
                        break
                    }
                    val stmt_opt = @get(some_body, si as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    si++
                }
            }
        }
        val none_body_node: ref parser.Node = node.d3 as ref parser.Node
        if none_body_node != none {
            val none_body: ref void = none_body_node.d0 as ref void
            if none_body != none {
                val nlen: i64 = @len(none_body) as i64
                val ni: mut i64 = 0
                for {
                    if ni >= nlen {
                        break
                    }
                    val stmt_opt = @get(none_body, ni as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    ni++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_RES {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val ok_body_node: ref parser.Node = node.d2 as ref parser.Node
        if ok_body_node != none {
            val ok_body: ref void = ok_body_node.d0 as ref void
            if ok_body != none {
                val olen: i64 = @len(ok_body) as i64
                val oi: mut i64 = 0
                for {
                    if oi >= olen {
                        break
                    }
                    val stmt_opt = @get(ok_body, oi as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    oi++
                }
            }
        }
        val err_body_node: ref parser.Node = node.d4 as ref parser.Node
        if err_body_node != none {
            val err_body: ref void = err_body_node.d0 as ref void
            if err_body != none {
                val elen: i64 = @len(err_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(err_body, ei as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_ENUM || node.kind == parser.NK_MATCH_STR || node.kind == parser.NK_MATCH_UNION || node.kind == parser.NK_MATCH_TAGGED_UNION {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
        val arms: ref void = node.d1 as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    val arm_body: mut ref void = none
                    if node.kind == parser.NK_MATCH_TAGGED_UNION {
                        arm_body = arm_node.d2 as ref void
                    } else {
                        arm_body = arm_node.d1 as ref void
                    }
                    if arm_body != none {
                        val blen: i64 = @len(arm_body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(arm_body, bi as usize)
                            if stmt_opt is some stmt {
                                collect_used_imports_stmt(
                                    stmt as ref parser.Node,
                                    import_names,
                                    used
                                )
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = node.d2 as ref parser.Node
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                val elen: i64 = @len(else_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_body, ei as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_MATCH_VALUE {
        collect_used_imports_expr(parser.match_value_expr(node), import_names, used)
        val arms: ref void = parser.match_value_arms(node) as ref void
        if arms != none {
            val alen: i64 = @len(arms) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm_opt = @get(arms, ai as usize)
                if arm_opt is some arm {
                    val arm_node: ref parser.Node = arm as ref parser.Node
                    collect_used_imports_expr(
                        parser.match_value_arm_pattern(arm_node),
                        import_names,
                        used
                    )
                    val value_body: ref void = parser.match_value_arm_body(arm_node) as ref void
                    if value_body != none {
                        val blen: i64 = @len(value_body) as i64
                        val bi: mut i64 = 0
                        for {
                            if bi >= blen {
                                break
                            }
                            val stmt_opt = @get(value_body, bi as usize)
                            if stmt_opt is some stmt {
                                collect_used_imports_stmt(
                                    stmt as ref parser.Node,
                                    import_names,
                                    used
                                )
                            }
                            bi++
                        }
                    }
                }
                ai++
            }
        }
        val else_node: ref parser.Node = parser.match_value_else(node)
        if else_node != none {
            val else_body: ref void = else_node.d0 as ref void
            if else_body != none {
                val elen: i64 = @len(else_body) as i64
                val ei: mut i64 = 0
                for {
                    if ei >= elen {
                        break
                    }
                    val stmt_opt = @get(else_body, ei as usize)
                    if stmt_opt is some stmt {
                        collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                    }
                    ei++
                }
            }
        }
    } elif node.kind == parser.NK_PRE || node.kind == parser.NK_POST {
        val clist: ref void = node.d0 as ref void
        if clist != none {
            val clen: i64 = @len(clist) as i64
            val ci: mut i64 = 0
            for {
                if ci >= clen {
                    break
                }
                val c_opt = @get(clist, ci as usize)
                if c_opt is some c {
                    collect_used_imports_expr(
                        (c as ref parser.Node).d1 as ref parser.Node,
                        import_names,
                        used
                    )
                }
                ci++
            }
        }
    } elif node.kind == parser.NK_GENERIC_WHEN {
        val gbody: ref void = node.d1 as ref void
        if gbody != none {
            val gblen: i64 = @len(gbody) as i64
            val gbi: mut i64 = 0
            for {
                if gbi >= gblen {
                    break
                }
                val stmt_opt = @get(gbody, gbi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                gbi++
            }
        }
    } elif node.kind == parser.NK_INCREMENT || node.kind == parser.NK_DECREMENT {
        collect_used_imports_expr(node.d0 as ref parser.Node, import_names, used)
    }
}

fn collect_used_imports_item(
    item: ref parser.Node,
    import_names: list[ref u8],
    used: mut list[ref u8]
) void = trust {
    if item == none {
        return
    }

    if item.kind == parser.NK_FN || item.kind == parser.NK_GENERIC_FN {
        val params: ref void = item.d3 as ref void
        if params != none {
            for param in params as list[ref parser.Node] {
                collect_used_imports_type(
                    (param as ref parser.Node).d1 as ref parser.Node,
                    import_names,
                    used
                )
            }
        }
        collect_used_imports_type(item.d4 as ref parser.Node, import_names, used)
        if item.kind == parser.NK_GENERIC_FN {
            val tparams: ref void = item.d6 as ref void
            if tparams != none {
                for tparam in tparams as list[ref parser.Node] {
                    collect_used_imports_type(
                        parser.tparam_constraint(tparam as ref parser.Node),
                        import_names,
                        used
                    )
                }
            }
        }
        val body: ref void = item.d5 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            if blen < 0 || blen > 100000 {
                return
            }
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif item.kind == parser.NK_EXTERN_FN {
        val params: ref void = item.d4 as ref void
        if params != none {
            for param in params as list[ref parser.Node] {
                collect_used_imports_type(
                    (param as ref parser.Node).d1 as ref parser.Node,
                    import_names,
                    used
                )
            }
        }
        collect_used_imports_type(item.d5 as ref parser.Node, import_names, used)
    } elif item.kind == parser.NK_TEST {
        val body: ref void = item.d0 as ref void
        if body != none {
            val blen: i64 = @len(body) as i64
            if blen < 0 || blen > 100000 {
                return
            }
            val bi: mut i64 = 0
            for {
                if bi >= blen {
                    break
                }
                val stmt_opt = @get(body, bi as usize)
                if stmt_opt is some stmt {
                    collect_used_imports_stmt(stmt as ref parser.Node, import_names, used)
                }
                bi++
            }
        }
    } elif item.kind == parser.NK_VAL {
        collect_used_imports_type(item.d2 as ref parser.Node, import_names, used)
        collect_used_imports_expr(item.d3 as ref parser.Node, import_names, used)
    } elif item.kind == parser.NK_CONST {
        collect_used_imports_expr(item.d2 as ref parser.Node, import_names, used)
    } elif item.kind == parser.NK_EXTERN_VAL {
        collect_used_imports_type(item.d3 as ref parser.Node, import_names, used)
    } elif item.kind == parser.NK_TYPEDEF || item.kind == parser.NK_EXTERN_TYPE {
        val derived_spec_name: ref u8 = parser.node_str_raw(item.d4)
        if derived_spec_name != none {
            for import_name in import_names {
                if type_name_references_import(derived_spec_name, import_name) {
                    mark_import_used(import_names, used, import_name)
                    break
                }
            }
        }
        val fields: ref void = item.d2 as ref void
        if fields != none {
            for field in fields as list[ref parser.Node] {
                collect_used_imports_type(
                    (field as ref parser.Node).d2 as ref parser.Node,
                    import_names,
                    used
                )
            }
        }
        val invariants: ref void = item.d3 as ref void
        if invariants != none {
            for inv in invariants as list[ref parser.Node] {
                collect_used_imports_expr(inv as ref parser.Node, import_names, used)
            }
        }
    } elif item.kind == parser.NK_UNIONDEF {
        val variants: ref void = item.d2 as ref void
        if variants != none {
            for variant in variants as list[ref parser.Node] {
                collect_used_imports_type(variant as ref parser.Node, import_names, used)
            }
        }
    } elif item.kind == parser.NK_TAGGED_UNIONDEF {
        val variants: ref void = item.d2 as ref void
        if variants != none {
            for variant in variants as list[ref parser.Node] {
                val vtypes: ref void = (variant as ref parser.Node).d1 as ref void
                if vtypes != none {
                    for vtype in vtypes as list[ref parser.Node] {
                        collect_used_imports_type(vtype as ref parser.Node, import_names, used)
                    }
                }
            }
        }
    } elif item.kind == parser.NK_SPEC {
        val methods: ref void = item.d2 as ref void
        if methods != none {
            for method in methods as list[ref parser.Node] {
                collect_used_imports_item(method as ref parser.Node, import_names, used)
            }
        }
    } elif item.kind == parser.NK_WHEN_ITEMS {
        val when_items: ref void = item.d1 as ref void
        if when_items != none {
            collect_used_imports_items(when_items as list[ref parser.Node], import_names, used)
        }
        val or_branches: ref void = item.d2 as ref void
        if or_branches != none {
            for or_node in or_branches as list[ref parser.Node] {
                val or_items: ref void = (or_node as ref parser.Node).d1 as ref void
                if or_items != none {
                    collect_used_imports_items(
                        or_items as list[ref parser.Node],
                        import_names,
                        used
                    )
                }
            }
        }
        val otherwise_items: ref void = item.d3 as ref void
        if otherwise_items != none {
            collect_used_imports_items(otherwise_items as list[ref parser.Node], import_names, used)
        }
    }
}

/// Collect used import names from a list of items.
fn collect_used_imports_items(
    items: list[ref parser.Node],
    import_names: list[ref u8],
    used: mut list[ref u8]
) void = trust {
    val items_len: i64 = @len(items) as i64

    if items_len < 0 || items_len > 100000 {
        return
    }

    val ii: mut i64 = 0
    for {
        if ii >= items_len {
            break
        }
        val item_opt = @get(items, ii as usize)
        if item_opt is some item_val {
            collect_used_imports_item(item_val as ref parser.Node, import_names, used)
        }
        ii++
    }
}

fn append_import_aliases(items: list[ref parser.Node], aliases: mut list[ref u8]) void = trust {
    for item in items {
        if item == none {
            continue
        }
        if item.kind == parser.NK_USE {
            val import_name: ref u8 = parser.node_str_raw(item.d1)
            if import_name != none && !import_in_list(aliases, import_name) {
                @append(aliases, import_name)
            }
        } elif item.kind == parser.NK_WHEN_ITEMS {
            val when_items: ref void = item.d1 as ref void
            if when_items != none {
                append_import_aliases(when_items as list[ref parser.Node], aliases)
            }
            val or_branches: ref void = item.d2 as ref void
            if or_branches != none {
                for or_node in or_branches as list[ref parser.Node] {
                    val or_items: ref void = (or_node as ref parser.Node).d1 as ref void
                    if or_items != none {
                        append_import_aliases(or_items as list[ref parser.Node], aliases)
                    }
                }
            }
            val otherwise_items: ref void = item.d3 as ref void
            if otherwise_items != none {
                append_import_aliases(otherwise_items as list[ref parser.Node], aliases)
            }
        }
    }
}

pub fn collect_unused_import_names_in_items(items: list[ref parser.Node]) list[ref u8] = trust {
    val import_names: mut list[ref u8] = mem.new[ref u8]()
    append_import_aliases(items, import_names)
    if @len(import_names) == 0 {
        return mem.new[ref u8]()
    }

    val used_imports: mut list[ref u8] = mem.new[ref u8]()
    collect_used_imports_items(items, import_names, used_imports)

    val unused_imports: mut list[ref u8] = mem.new[ref u8]()
    for import_name in import_names {
        if !import_in_list(used_imports, import_name) {
            @append(unused_imports, import_name)
        }
    }
    return unused_imports
}

/// Collect links only from modules that are actually used.
/// Mirrors the reference compiler's collect_used_libs logic.
pub fn collect_used_links(
    m: ref ResolvedModule,
    exe_dir: ref u8,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val result: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[String] = mem.new[String]()

    val my_links: list[ref u8] = collect_links_with_root(
        m.items,
        module_link_root(m),
        exe_dir,
        static_link
    )?
    for lnk in my_links {
        @append(result, lnk)
    }

    val used_imports: mut list[ref u8] = mem.new[ref u8]()
    collect_used_imports_items(m.items, m.import_names, used_imports)

    for used_name in used_imports {
        val clen: i64 = @len(m.import_modules) as i64
        val ci: mut i64 = 0
        for {
            if ci >= clen {
                break
            }
            val name_opt = @get(m.import_names, ci as usize)
            val mod_opt = @get(m.import_modules, ci as usize)
            if name_opt is some name {
                if cstr.cmp(name as ref u8, used_name) == 0 {
                    if mod_opt is some child {
                        val child_links: list[ref u8] = collect_used_links_recursive(
                            child as ref ResolvedModule,
                            exe_dir,
                            seen,
                            static_link
                        )?
                        for clink in child_links {
                            @append(result, clink)
                        }
                    }
                    break
                }
            }
            ci++
        }
    }

    val deduped: mut list[ref u8] = mem.new[ref u8]()
    for lnk in result {
        val dlen: i64 = @len(deduped) as i64
        val di: mut i64 = 0
        val already: mut bool = false
        for {
            if di >= dlen {
                break
            }
            val d_opt = @get(deduped, di as usize)
            if d_opt is some d {
                if cstr.cmp(d as ref u8, lnk) == 0 {
                    already = true
                    break
                }
            }
            di++
        }
        if !already {
            @append(deduped, lnk)
        }
    }

    return ok deduped
}

/// Recursively collect links from a module and its used imports.
fn collect_used_links_recursive(
    m: ref ResolvedModule,
    exe_dir: ref u8,
    seen: mut list[String],
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val slen: i64 = @len(seen) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(seen, si as usize)
        if s_opt is some s {
            if s == 0 {
                continue
            }
            if ostr.equals(s, m.filename) {
                return ok mem.new[ref u8]()
            }
        }
        si++
    }

    @append(seen, m.filename)

    val result: mut list[ref u8] = mem.new[ref u8]()

    val my_links: list[ref u8] = collect_links_with_root(
        m.items,
        module_link_root(m),
        exe_dir,
        static_link
    )?
    for lnk in my_links {
        @append(result, lnk)
    }

    val used_imports: mut list[ref u8] = mem.new[ref u8]()
    collect_used_imports_items(m.items, m.import_names, used_imports)

    for used_name in used_imports {
        val clen: i64 = @len(m.import_modules) as i64
        val ci: mut i64 = 0
        for {
            if ci >= clen {
                break
            }
            val name_opt = @get(m.import_names, ci as usize)
            val mod_opt = @get(m.import_modules, ci as usize)
            if name_opt is some name {
                if cstr.cmp(name as ref u8, used_name) == 0 {
                    if mod_opt is some child {
                        val child_links: list[ref u8] = collect_used_links_recursive(
                            child as ref ResolvedModule,
                            exe_dir,
                            seen,
                            static_link
                        )?
                        for clink in child_links {
                            @append(result, clink)
                        }
                    }
                    break
                }
            }
            ci++
        }
    }

    return ok result
}
