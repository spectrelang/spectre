val mem        = use("meta/mem.sx")
val os         = use("std/os")
val allocators = use("std/allocators")
val cli        = use("entry/cli.sx")

when windows {
    extern (C, header) fn SetConsoleOutputCP(codepage_id: u32) bool = "SetConsoleOutputCP"
}

pub fn main() i32 = trust {
    val arena = allocators.Arena.new(65536 as usize)?
    val frontend_arena = allocators.ScopedArena.new(
        67108864 as usize
    )?
    defer {
        allocators.ScopedArena.free(frontend_arena)
    }
    mem.init()
    defer {
        mem.close()
    }
    val args = os.get_args()
    defer {
        @listfree(args)
    }
    val argc: i64 = @len(args) as i64
    val exe_path: mut ref u8 = c"./spectre"
    val exe_opt = @get(args, 0)

    when windows {
        SetConsoleOutputCP(65001 as u32)
    }

    if exe_opt is some v {
        exe_path = v as ref u8
    }

    val code: i32 = cli.run(args, argc, exe_path, arena, frontend_arena)
    allocators.Arena.free(arena)
    return code
}
