/// The Spectre Compiler
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val fs          = use("std/fs")
val string      = use("std/string")
val stdio       = use("std/stdio")
val os          = use("std/os")
val allocators  = use("std/allocators")
val path        = use("std/path")
val reflection  = use("std/reflection")
val parser      = use("ast/parser.sx")
val ast_printer = use("ast/ast_printer.sx")
val sema        = use("sema/sema.sx")
val codegen     = use("codegen/codegen.sx")
val alt_codegen = use("codegen/alt_codegen.sx")
val module      = use("module/module.sx")
val meta        = use("meta/meta.sx")
val defines     = use("meta/defines.sx")
val commands    = use("meta/commands.sx")
val docs        = use("meta/docs.sx")
val formatter   = use("meta/fmt.sx")
val critic      = use("meta/critic.sx")
val c_translate = use("translate/c_translate.sx")
val builds      = use("meta/builds.sx")

when windows {
    extern (C) fn SetConsoleOutputCP(codepage_id: u32) bool = "SetConsoleOutputCP"
}

pub fn main() i32 = trust {
    val arena: mut allocators.Arena = allocators.Arena.new(65536 as usize)?
    val args = os.get_args()
    val argc: i64 = @len(args) as i64
    val exe_path: mut ref u8 = "./spectre"
    val exe_opt = @get(args, 0)

    when windows {
        SetConsoleOutputCP(65001 as u32)
    }

    if exe_opt is some v {
        exe_path = v as ref u8
    }

    val quiet: mut bool = true
    val run_mode: mut bool = false

    if argc < 2 {
        stdio.puts("error: no input file provided\n")
        meta.print_usage()
        allocators.Arena.free(arena)
        return 1
    }

    val input_arg_i: mut i64 = 1
    for {
        val pre_opt = @get(args, input_arg_i)
        if pre_opt is some pre_val {
            val pre_arg: ref u8 = pre_val as ref u8
            if string.raw_cmp(pre_arg, "-d") == 0 {
                val spec_i: i64 = input_arg_i + 1
                val spec_opt = @get(args, spec_i)
                if spec_opt is some spec_val {
                    val def_spec: ref u8 = spec_val as ref u8
                    if !defines.add_spec(def_spec) {
                        stdio.print("error: invalid define '{s}', expected NAME=VALUE\n", {def_spec})
                        allocators.Arena.free(arena)
                        return 1
                    }
                    input_arg_i = spec_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_starts_with(pre_arg, "-d") {
                val def_spec: ref u8 = string.substr(pre_arg, 2, string.len_raw(pre_arg) - 2)
                if !defines.add_spec(def_spec) {
                    stdio.print("error: invalid define '{s}', expected -dNAME=VALUE\n", {pre_arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                input_arg_i++
            } else {
                break
            }
        } else {
            break
        }
    }
    val input_opt = @get(args, input_arg_i)
    val input: mut ref u8 = ""
    if input_opt is some a {
        input = a as ref u8
    } else {
        stdio.puts("error: no input file")
        allocators.Arena.free(arena)
        return 1
    }

    if string.raw_cmp(input, "run") == 0 {
        run_mode = true
        input_arg_i = input_arg_i + 1
        val run_input_opt = @get(args, input_arg_i)
        if run_input_opt is some a {
            input = a as ref u8
        } else {
            stdio.puts("error: run requires an input file\n")
            meta.print_usage()
            allocators.Arena.free(arena)
            return 1
        }
    }

    val flag_first_translate_c: bool = string.raw_cmp(input, "--translate-c") == 0

    if string.raw_cmp(input, "-h") == 0 || string.raw_cmp(input, "--help") == 0 {
        meta.print_usage()
        allocators.Arena.free(arena)
        return 0
    }

    if string.raw_cmp(input, "-v") == 0 || string.raw_cmp(input, "--version") == 0 {
        meta.print_version()
        allocators.Arena.free(arena)
        return 0
    }

    if string.raw_cmp(input, "help") == 0 {
        val topic: mut ref u8 = ""
        val topic_opt = @get(args, 2)
        if topic_opt is some t {
            topic = t as ref u8
        }
        val code: i32 = meta.print_help(topic)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "doctor") == 0 {
        val code: i32 = commands.cmd_doctor()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "ref") == 0 {
        val code: i32 = commands.cmd_ref()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "init") == 0 {
        val name_arg: mut ref u8 = ""
        val name_opt = @get(args, 2)
        if name_opt is some v {
            name_arg = v as ref u8
        }
        val code: i32 = commands.cmd_init(name_arg)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "fmt") == 0 {
        val fmt_paths: mut list[ref u8] = []
        val fmt_stdout: mut bool = false
        val fmt_arg_i: mut i64 = 2
        for {
            val fmt_arg_opt = @get(args, fmt_arg_i)
            if fmt_arg_opt is some fv {
                val arg: ref u8 = fv as ref u8
                if string.raw_cmp(arg, "-h") == 0 || string.raw_cmp(arg, "--help") == 0 {
                    val code: i32 = meta.print_help("fmt")
                    allocators.Arena.free(arena)
                    return code
                } elif string.raw_cmp(arg, "--stdio") == 0 {
                    fmt_stdout = true
                } else {
                    @append(fmt_paths, arg)
                }
            } else {
                break
            }
            fmt_arg_i++
        }
        val code: i32 = formatter.cmd_fmt(fmt_paths, fmt_stdout)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "critic") == 0 {
        val critic_paths: mut list[ref u8] = []
        val critic_fix: mut bool = false
        val critic_arg_i: mut i64 = 2
        for {
            val critic_arg_opt = @get(args, critic_arg_i)
            if critic_arg_opt is some cv {
                val arg: ref u8 = cv as ref u8
                if string.raw_cmp(arg, "-h") == 0 || string.raw_cmp(arg, "--help") == 0 {
                    val code: i32 = meta.print_help("critic")
                    allocators.Arena.free(arena)
                    return code
                } elif string.raw_cmp(arg, "--fix") == 0 {
                    critic_fix = true
                } else {
                    @append(critic_paths, arg)
                }
            } else {
                break
            }
            critic_arg_i++
        }
        val code: i32 = critic.cmd_critic(critic_paths, critic_fix)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "build") == 0 {
        val config_name: mut ref u8 = "dev"
        val cfg_opt = @get(args, 2)
        if cfg_opt is some v {
            config_name = v as ref u8
        }
        val code: i32 = commands.cmd_build(config_name, exe_path)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "doc") == 0 {
        val target_arg: mut ref u8 = "."
        val md_mode: mut bool = false
        val doc_arg_i: mut i64 = 2
        for {
            val arg_opt = @get(args, doc_arg_i)
            if arg_opt is some dv {
                val arg: ref u8 = dv as ref u8
                if string.raw_cmp(arg, "--md") == 0 {
                    md_mode = true
                } elif string.raw_starts_with(arg, "-") {
                    stdio.print("error: unknown doc option '{s}'\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    target_arg = arg
                }
            } else {
                break
            }
            doc_arg_i++
        }
        val code: i32 = docs.cmd_doc(target_arg, md_mode)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "add") == 0 {
        val url_opt = @get(args, 2)
        if url_opt is some v {
            val code: i32 = commands.cmd_add(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: add requires a git repository URL")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if string.raw_cmp(input, "remove") == 0 {
        val dep_opt = @get(args, 2)
        if dep_opt is some v {
            val code: i32 = commands.cmd_remove(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: remove requires a dependency name")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if string.raw_cmp(input, "restore") == 0 {
        val code: i32 = commands.cmd_restore()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "graph") == 0 {
        val code: i32 = commands.cmd_graph()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "clean") == 0 {
        val code: i32 = commands.cmd_clean()
        allocators.Arena.free(arena)
        return code
    }

    if flag_first_translate_c {
        val next_opt = @get(args, 2)
        if next_opt is some next_arg {
            input = next_arg as ref u8
        } else {
            stdio.puts("error: --translate-c requires an input .c or .h file")
            allocators.Arena.free(arena)
            return 1
        }
    }

    val src_size_opt = fs.file_size(input)
    if src_size_opt is some _ {
    } else {
        stdio.print("error: could not read '{s}'\n", {input})
        allocators.Arena.free(arena)
        return 1
    }

    val emit_qbe: mut bool = false
    val emit_ll: mut bool = false
    val emit_asm: mut bool = false
    val emit_alt: mut bool = false
    val show_cmd: mut bool = false
    val test_mode: mut bool = false
    val release_mode: mut bool = false
    val output_name: mut ref u8 = ""
    val build_dll: mut bool = false
    val compile_obj: mut bool = false
    val syntax_check: mut bool = false
    val print_ast: mut bool = false
    val use_alt: mut bool = false
    val alt_compiler: mut ref u8 = ""
    val translate_c_flag: mut bool = flag_first_translate_c
    val extra_includes: mut list[ref u8] = []
    val inc_paths: mut list[ref u8] = []
    val src_target: mut ref u8 = ""
    val bootstrap_mode: mut bool = false
    val arg_i: mut i64 = input_arg_i + 1

    if flag_first_translate_c {
        arg_i = input_arg_i + 2
    }

    when windows {
        use_alt = true
    }

    for {
        if (arg_i >= argc) {
            break
        }
        val arg_opt = @get(args, arg_i)
        if arg_opt is some arg_val {
            val arg: ref u8 = arg_val as ref u8

            if string.raw_cmp(arg, "-o") == 0 || string.raw_cmp(arg, "--output") == 0 {
                val next_i: i64 = arg_i + 1
                if (next_i < argc) {
                    val next_opt = @get(args, next_i)
                    if next_opt is some v {
                        output_name = v as ref u8
                    } else {
                        stdio.puts("error: -o requires a value")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -o requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_cmp(arg, "-d") == 0 {
                val next_i: i64 = arg_i + 1
                if next_i < argc {
                    val next_opt = @get(args, next_i)
                    if next_opt is some dv {
                        val def_spec: ref u8 = dv as ref u8
                        if !defines.add_spec(def_spec) {
                            stdio.print("error: invalid define '{s}', expected NAME=VALUE\n", {def_spec})
                            allocators.Arena.free(arena)
                            return 1
                        }
                    } else {
                        stdio.puts("error: -d requires a NAME=VALUE argument")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_starts_with(arg, "-d") {
                val def_spec: ref u8 = string.substr(arg, 2, string.len_raw(arg) - 2)
                if !defines.add_spec(def_spec) {
                    stdio.print("error: invalid define '{s}', expected -dNAME=VALUE\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                arg_i++
            } elif string.raw_cmp(arg, "--translate-c") == 0 {
                translate_c_flag = true
                arg_i++
            } elif string.raw_cmp(arg, "--emit-ssa") == 0 {
                emit_qbe = true
                arg_i++
            } elif string.raw_cmp(arg, "--emit-ll") == 0 {
                emit_ll = true
                arg_i++
            } elif string.raw_cmp(arg, "--emit-asm") == 0 {
                emit_asm = true
                arg_i++
            } elif string.raw_cmp(arg, "--emit-alt") == 0 {
                emit_alt = true
                arg_i++
            } elif string.raw_cmp(arg, "--show-cmd") == 0 {
                show_cmd = true
                arg_i++
            } elif string.raw_cmp(arg, "--test") == 0 {
                test_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "--loud") == 0 || string.raw_cmp(arg, "-l") == 0 {
                quiet = false
                arg_i++
            } elif string.raw_cmp(arg, "--release") == 0 {
                release_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "--dll") == 0 {
                build_dll = true
                arg_i++
            } elif string.raw_cmp(arg, "-c") == 0 || string.raw_cmp(arg, "--compile") == 0 {
                compile_obj = true
                arg_i++
            } elif string.raw_cmp(arg, "--syntax-check") == 0 {
                syntax_check = true
                arg_i++
            } elif string.raw_cmp(arg, "--ast") == 0 {
                print_ast = true
                arg_i++
            } elif string.raw_cmp(arg, "-b") == 0 || string.raw_cmp(arg, "--bootstrap") == 0 {
                bootstrap_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "--alt") == 0 || string.raw_cmp(arg, "-a") == 0 {
                use_alt = true
                arg_i++
            } elif string.raw_starts_with(arg, "--alt=") {
                use_alt = true
                val compiler_str = builds.parse_alt_compiler_arg(arg)
                if string.raw_cmp(compiler_str, "") != 0 {
                    alt_compiler = compiler_str
                }
                arg_i++
            } elif string.raw_starts_with(arg, "--src-target=") {
                val tgt_len: i64 = string.len_raw(arg) as i64 - 13
                if tgt_len > 0 {
                    src_target = string.substr(arg, 13, tgt_len)
                }
                arg_i++
            } elif string.raw_starts_with(arg, "--inc-path=") {
                val path_str: ref u8 = string.substr(arg, 11, string.len_raw(arg) - 11)
                if string.raw_cmp(path_str, "") == 0 {
                    stdio.puts("error: --inc-path requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
                @append(inc_paths, path_str)
                arg_i++
            } else {
                stdio.print("error: unknown flag: {s}\n", {arg})
                allocators.Arena.free(arena)
                return 1
            }
        } else {
            arg_i++
        }
    }

    if string.raw_cmp(src_target, "") != 0 && !emit_alt && !emit_qbe {
        stdio.puts("error: --src-target requires --emit-alt or --emit-ssa")
        allocators.Arena.free(arena)
        return 1
    }

    if run_mode && (translate_c_flag || emit_qbe || emit_ll || emit_asm || emit_alt || build_dll || compile_obj || syntax_check || print_ast) {
        stdio.puts("error: run requires flags that produce a runnable executable")
        allocators.Arena.free(arena)
        return 1
    }

    if translate_c_flag {
        if string.raw_cmp(output_name, "") == 0 {
            output_name = @fmt("./src-out/{s}.sx", {path.get_name_without_ext(arena, input)})
        }
        val code: i32 = c_translate.translate_c(input, output_name)
        allocators.Arena.free(arena)
        return code
    }

    val exe_path2: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
    val exe_dir: mut ref u8 = "."
    if string.raw_cmp(exe_path2, ".") != 0 {
        exe_dir = path.dir(exe_path2)
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt && !print_ast {
        stdio.puts("[I  ]│ Resolving module")
    }

    val resolve_result = module.resolve_module(input, [], exe_dir, none)
    val root_mod: mut ref module.ResolvedModule = none

    match resolve_result {
        ok m => {
            root_mod = m
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            allocators.Arena.free(arena)
            return 1
        }
    }

    if print_ast {
        val items: list[ref parser.Node] = module.module_items(root_mod)
        ast_printer.print_ast_items(items)
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[II ]│ Semantic analysis")
    }

    val quiet_flag: mut bool = false
    if quiet {
        quiet_flag = true
    }
    val errors: list[ref u8] = sema.check_module_tree(root_mod, quiet_flag)
    val nerrors: i64 = @len(errors) as i64
    if nerrors > 0 {
        for e in errors {
            stdio.print("error: {s}\n", {e})
        }
        allocators.Arena.free(arena)
        return 1
    }

    if syntax_check {
        stdio.puts("Syntax OK")
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[III]│ CG pass")
    }

    if ((@len(extra_includes) as i64) > 0 && !use_alt && !emit_alt) {
        stdio.puts("error: -I<headers> requires the alt backend (--alt)")
        allocators.Arena.free(arena)
        return 1
    }

    if use_alt || emit_alt {
        val c_ir: mut ref u8 = ""
        val emit_ld: bool = !bootstrap_mode
        if test_mode {
            c_ir = alt_codegen.gen_module_c_test(root_mod, release_mode, extra_includes, src_target, emit_ld)
        }
        else {
            c_ir = alt_codegen.gen_module_c(root_mod, release_mode, extra_includes, src_target, emit_ld)
        }

        if emit_alt != false {
            stdio.puts(c_ir)
            allocators.Arena.free(arena)
            return 0
        }

        val binary_name_alt: mut ref u8 = ""
        if string.raw_cmp(output_name, "") == 0 {
            binary_name_alt = path.get_name_without_ext(arena, input)
        } else {
            binary_name_alt = output_name
        }

        val c_file = builds.get_tmp_path("spectre_output.c")
        val c_f = os.open(c_file, "w")
        if c_f is some f {
            os.write(f, c_ir as ref void, string.len_raw(c_ir) as i64)
            os.close(f)
        } else {
            stdio.puts("\nerror: could not write C code")
            allocators.Arena.free(arena)
            return 1
        }

        val output_specified_alt: bool = string.raw_cmp(output_name, "") != 0
        val final_output_alt: mut ref u8 = ""
        if output_specified_alt != 0 {
            final_output_alt = binary_name_alt
        } else {
            os.exec("mkdir -p ./s-out")
            final_output_alt = @fmt("./s-out/{s}", {binary_name_alt})
        }

        val links_alt: mut list[ref u8] = module.collect_used_links(root_mod, exe_dir)
        builds.append_debug_runtime_links(links_alt, exe_dir, quiet, release_mode, arena)
        val link_flags_alt: mut ref u8 = ""
        for lib in links_alt {
            link_flags_alt = @fmt("{s} {s}", {link_flags_alt, lib})
        }
        val include_flags_alt: mut ref u8 = ""
        for inc_path in inc_paths {
            include_flags_alt = @fmt("{s} -I{s}", {include_flags_alt, inc_path})
        }

        val selected_compiler: mut ref u8 = builds.pick_alt_backend(alt_compiler, release_mode, input, root_mod.items, arena)

        val warn_flag: ref u8 = builds.compiler_warn_flag(selected_compiler)
        val cc_flags_alt: mut ref u8 = @fmt("-std=c99 {s} -O3", {warn_flag})
        if !release_mode {
            cc_flags_alt = @fmt("-std=c99 {s} -g", {warn_flag})
        }
        val test_output_alt: ref u8 = builds.get_tmp_path("spectre_test_bin_alt")
        val compile_output: mut ref u8 = test_output_alt
        if !test_mode {
            compile_output = final_output_alt
        }

        val alt_cmd: mut ref u8 = ""
        if string.raw_cmp(selected_compiler, "tcc") == 0 {
            if test_mode {
                alt_cmd = @fmt("tcc {s} -o {s} -w -std=c99{s} {s} 2>&1", {c_file, test_output_alt, include_flags_alt, link_flags_alt})
            } else {
                alt_cmd = @fmt("tcc {s} -o {s} -w -std=c99{s} {s} 2>&1", {c_file, final_output_alt, include_flags_alt, link_flags_alt})
            }
        } else {
            if string.raw_cmp(cc_flags_alt, "") == 0 {
                alt_cmd = @fmt("{s}{s} -o {s} {s}{s} 2>&1", {selected_compiler, include_flags_alt, compile_output, c_file, link_flags_alt})
            } else {
                alt_cmd = @fmt("{s} {s}{s} -o {s} {s}{s} 2>&1", {selected_compiler, cc_flags_alt, include_flags_alt, compile_output, c_file, link_flags_alt})
            }
        }

        if !quiet && !emit_alt {
            stdio.puts("[IV ]│ AMCS")
        }
        if show_cmd != 0 {
            stdio.print("{s}\n", {alt_cmd})
        }

        val alt_res = os.exec(alt_cmd)
        match alt_res {
            ok v => {
                val vstr: ref u8 = string.cstr(v)
                val error_prefix = string.from[allocators.Arena](arena, "error:")
                val has_error: bool = string.contains(v, error_prefix)
                if has_error {
                    val display: mut ref u8 = vstr
                    if !bootstrap_mode {
                        display = builds.filter_c_diagnostics(vstr)
                    }
                    stdio.print("{s}", {display})
                    os.delete(c_file)
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    if string.len_raw(vstr) > 0 {
                        val display: mut ref u8 = vstr
                        if !bootstrap_mode {
                            display = builds.filter_c_diagnostics(vstr)
                        }
                        stdio.print("{s}", {display})
                    }
                    if test_mode {
                        val run_res_alt = os.run(test_output_alt)
                        if run_res_alt != 0 {
                            stdio.puts("Test binary failed.")
                            os.delete(c_file)
                            allocators.Arena.free(arena)
                            return 1
                        }
                        os.delete(test_output_alt)
                    }
                    if run_mode {
                        val run_res_alt: i32 = os.run(final_output_alt)
                        os.delete(c_file)
                        allocators.Arena.free(arena)
                        return run_res_alt
                    }
                    if !quiet {
                        stdio.print("Compiled (ALT): {s}\n", {final_output_alt})
                    }
                }
            }
            err _ => {
                stdio.print("error: {s} stage failed\n", {selected_compiler})
                os.delete(c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }

        os.delete(c_file)
        allocators.Arena.free(arena)
        return 0
    }

    val qbe_ir: mut ref u8 = ""

    if test_mode {
        qbe_ir = codegen.gen_module_resolved_test(root_mod, release_mode, src_target)
    } else {
        qbe_ir = codegen.gen_module_resolved(root_mod, release_mode, src_target)
    }

    if !quiet && !emit_qbe && !emit_ll {
        stdio.puts("[IV ]│ Module used-links collection")
    }

    val links: mut list[ref u8] = module.collect_used_links(root_mod, exe_dir)
    builds.append_debug_runtime_links(links, exe_dir, quiet, release_mode, arena)

    if emit_qbe != 0 {
        stdio.puts(qbe_ir)
        allocators.Arena.free(arena)
        return 0
    }

    val binary_name: mut ref u8 = ""

    if string.raw_cmp(output_name, "") == 0 {
        binary_name = path.get_name_without_ext(arena, input)
    } else {
        binary_name = output_name
    }

    val qbe_file = builds.get_tmp_path("spectre_output.ssa")
    val asm_file = builds.get_tmp_path("spectre_output.s")
    val qbe_f = os.open(qbe_file, "w")

    if qbe_f is some f {
        os.write(f, qbe_ir as ref void, string.len_raw(qbe_ir) as i64)
        os.close(f)
    } else {
        stdio.puts("\nerror: could not write QBE IR")
        allocators.Arena.free(arena)
        return 1
    }

    val qbe_cmd = @fmt("qbe -o {s} {s} 2>&1", {asm_file, qbe_file})
    val qbe_res = os.exec(qbe_cmd)
    if show_cmd != 0 {
        stdio.print("{s}\n", {qbe_cmd})
    }
    match qbe_res {
        ok v => {
            val vstr: ref u8 = string.cstr(v)
            if string.len_raw(vstr) > 0 {
                stdio.print("{s}", {vstr})
            }
            if string.raw_starts_with(vstr, "qbe:") {
                stdio.puts("error: qbe stage failed")
                os.delete(qbe_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        err _ => {
            stdio.puts("\nerror: failed to run qbe")
            os.delete(qbe_file)
            allocators.Arena.free(arena)
            return 1
        }
    }

    if emit_asm != 0 {
        val asm_size_opt = fs.file_size(asm_file)
        val asm_arena_cap: mut i64 = 4096
        if asm_size_opt is some sz {
            if ((sz as i64) > asm_arena_cap) {
                asm_arena_cap = sz as i64
            }
        } else {
            stdio.puts("error: could not read assembly output")
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }
        val asm_arena: mut allocators.Arena = allocators.Arena.new((asm_arena_cap + 8) as usize)?
        val asm_opt = fs.read_all[allocators.Arena](asm_arena, asm_file)
        if asm_opt is some asm_content {
            stdio.puts(asm_content as ref u8)
        } else {
            stdio.puts("error: could not read assembly output")
        }
        allocators.Arena.free(asm_arena)
        os.delete(qbe_file)
        os.delete(asm_file)
        allocators.Arena.free(arena)
        return 0
    }

    val output_specified: bool = string.raw_cmp(output_name, "") != 0
    val cc_cmd: mut ref u8 = ""
    val success_msg: mut ref u8 = ""
    val exit_code: mut i32 = 0
    val link_flags: mut ref u8 = ""
    val run_output: mut ref u8 = ""
    val platform: ref u8 = reflection.current_platform_name[allocators.Arena](arena)

    for lib in links {
        link_flags = @fmt("{s} {s}", {link_flags, lib})
    }

    val cc_flags: mut ref u8 = ""
    if !release_mode {
        cc_flags = "-g"
    }
    val output_ext: mut ref u8 = ""

    if compile_obj {
        cc_flags = @fmt("{s} -c", {cc_flags})
        if string.raw_cmp(platform, "windows") == 0 {
            output_ext = ".obj"
        } else {
            output_ext = ".o"
        }
    } elif build_dll {
        if string.raw_cmp(platform, "macos") == 0 {
            cc_flags = @fmt("{s} -dynamiclib", {cc_flags})
            output_ext = ".dylib"
        } elif string.raw_cmp(platform, "windows") == 0 {
            cc_flags = @fmt("{s} -shared", {cc_flags})
            output_ext = ".dll"
        } else {
            cc_flags = @fmt("{s} -shared", {cc_flags})
            output_ext = ".so"
        }
    } else {
        output_ext = ""
    }

    if test_mode {
        val test_bin: ref u8 = builds.get_tmp_path("spectre_test_bin")
        cc_cmd = @fmt("cc -o {s} {s}{s}", {test_bin, asm_file, link_flags})
        val cc_res2 = os.exec(cc_cmd)
        match cc_res2 {
            ok _ => {
                if !quiet && !emit_qbe {
                    stdio.print("[spectre] running tests for: {s}\n", {input})
                }
                val run_res = os.run(test_bin)
                if run_res != 0 {
                    if !quiet && !emit_qbe {
                        stdio.print("[spectre] test binary exited with: {s}\n", {"non-zero exit"})
                    }
                    exit_code = 1
                }
            }
            err _ => {
                stdio.puts("error: cc compilation failed")
                exit_code = 1
            }
        }
        os.delete(qbe_file)
        os.delete(asm_file)
        allocators.Arena.free(arena)
        return exit_code
    }

    if output_specified != 0 {
        val final_output: mut ref u8 = binary_name
        if string.raw_cmp(output_ext, "") != 0 {
            final_output = @fmt("{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if string.raw_cmp(cc_flags, "") == 0 {
            cc_cmd = @fmt("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmt("cc {s} -o {s} {s}{s}", {cc_flags, final_output, asm_file, link_flags})
        }
        success_msg = @fmt("Compiled: {s}\n", {final_output})
    } else {
        os.exec("mkdir -p ./s-out")
        val final_output: mut ref u8 = @fmt("./s-out/{s}", {binary_name})
        if string.raw_cmp(output_ext, "") != 0 {
            final_output = @fmt("./s-out/{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if string.raw_cmp(cc_flags, "") == 0 {
            cc_cmd = @fmt("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmt("cc {s} -o {s} {s}{s}", {cc_flags, final_output, asm_file, link_flags})
        }
        success_msg = @fmt("Compiled: {s}\n", {final_output})
    }

    if show_cmd != 0 {
        stdio.print("{s}\n", {cc_cmd})
    }

    val cc_res = os.exec(@fmt("{s} {s}", {cc_cmd, " 2>&1"}))
    match cc_res {
        ok v => {
            val error_text = string.from[allocators.Arena](arena, "error")
            val has_error: bool = string.contains(v, error_text)
            if has_error {
                stdio.print("{s}\n", {string.cstr(v)})
                stdio.puts("linking failed.")
                exit_code = 1
            } else {
                if !quiet && !emit_qbe {
                    stdio.print("{s}", {success_msg})
                }
                if run_mode {
                    exit_code = os.run(run_output)
                }
            }
        }
        err _ => {
            stdio.puts("\nerror: cc compilation failed")
        }
    }

    os.delete(qbe_file)
    os.delete(asm_file)
    allocators.Arena.free(arena)

    return exit_code
}
