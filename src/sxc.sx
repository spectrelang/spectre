/// The Spectre Compiler
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val fs          = use("std/fs")
val mem         = use("meta/mem.sx")
val str         = use("std/string")
val cstr        = use("std/string/cstr")
val ostr        = use("std/string/owned")
val stdio       = use("std/stdio")
val os          = use("std/os")
val allocators  = use("std/allocators")
val path        = use("std/path")
val reflection  = use("std/reflection")
val fmt         = use("std/fmt")
val parser      = use("ast/parser.sx")
val ast_printer = use("ast/ast_printer.sx")
val sema        = use("sema/sema.sx")
val codegen     = use("codegen/codegen.sx")
val alt_codegen = use("codegen/alt_codegen.sx")
val module      = use("module/module.sx")
val meta        = use("meta/meta.sx")
val defines     = use("meta/defines.sx")
val commands    = use("meta/commands.sx")
val docs        = use("meta/docs.sx")
val formatter   = use("meta/fmt.sx")
val critic      = use("meta/critic.sx")
val c_translate = use("translate/c_translate.sx")
val c_bind      = use("translate/c_bind.sx")
val builds      = use("meta/builds.sx")
val install     = use("meta/install.sx")

when windows {
    extern (C, header) fn SetConsoleOutputCP(codepage_id: u32) bool = "SetConsoleOutputCP"
}

pub fn main() i32 = trust {
    val arena: allocators.Arena = allocators.Arena.new(65536 as usize)?
    val frontend_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
        67108864 as usize
    )?
    defer {
        allocators.ScopedArena.free(frontend_arena)
    }
    mem.init()
    defer {
        mem.close()
    }
    val args = os.get_args()
    defer {
        @listfree(args)
    }
    val argc: i64 = @len(args) as i64
    val exe_path: mut ref u8 = c"./spectre"
    val exe_opt = @get(args, 0)

    when windows {
        SetConsoleOutputCP(65001 as u32)
    }

    if exe_opt is some v {
        exe_path = v as ref u8
    }

    val quiet: mut bool = true
    val run_mode: mut bool = false

    if argc < 2 {
        stdio.puts("error: no input file provided\n")
        meta.print_usage()
        allocators.Arena.free(arena)
        return 1
    }

    val input_arg_i: mut i64 = 1
    for {
        val pre_opt = @get(args, input_arg_i)
        if pre_opt is some pre_val {
            val pre_arg: ref u8 = pre_val as ref u8
            if cstr.cmp(pre_arg, c"-d") == 0 {
                val spec_i: i64 = input_arg_i + 1
                val spec_opt = @get(args, spec_i)
                if spec_opt is some spec_val {
                    val def_spec: ref u8 = spec_val as ref u8
                    if !defines.add_spec(str.from_cstr(def_spec)) {
                        stdio.print(
                            "error: invalid define '{s}', expected NAME=VALUE\n",
                            {def_spec}
                        )
                        allocators.Arena.free(arena)
                        return 1
                    }
                    input_arg_i = spec_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif cstr.starts_with(pre_arg, c"-d:") {
                val def_spec: ref u8 = cstr.substr(pre_arg, 3, cstr.len(pre_arg) - 3)
                if !defines.add_spec(str.from_cstr(def_spec)) {
                    stdio.print("error: invalid define '{s}', expected -d:NAME=VALUE\n", {pre_arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                input_arg_i++
            } else {
                break
            }
        } else {
            break
        }
    }
    val input_opt = @get(args, input_arg_i)
    val input: mut ref u8 = c""
    if input_opt is some a {
        input = a as ref u8
    } else {
        stdio.puts("error: no input file")
        allocators.Arena.free(arena)
        return 1
    }

    if cstr.cmp(input, c"run") == 0 {
        run_mode = true
        input_arg_i++
        val run_input_opt = @get(args, input_arg_i)
        if run_input_opt is some a {
            input = a as ref u8
        } else {
            stdio.puts("error: run requires an input file\n")
            meta.print_usage()
            allocators.Arena.free(arena)
            return 1
        }
    }

    if cstr.cmp(input, c"-test-all") == 0 {
        val root: mut ref u8 = c"."
        val max_depth: mut i64 = 25
        val extra_flags: mut list[ref u8] = mem.new[ref u8]()
        val ti: mut i64 = input_arg_i + 1
        for {
            val opt = @get(args, ti)
            if opt is some av {
                val a: ref u8 = av as ref u8
                if cstr.cmp(a, c"-test-depth") == 0 {
                    ti++
                    val next_opt = @get(args, ti)
                    if next_opt is some nv {
                        val next_val: ref u8 = nv as ref u8
                        val parsed = fmt.string_to_i64(next_val)
                        match parsed {
                            ok v => {
                                max_depth = v
                            }
                            err _ => {
                                stdio.print("error: invalid test depth '{s}'\n", {
                                        next_val
                                    })
                                allocators.Arena.free(arena)
                                return 1
                            }
                        }
                    } else {
                        stdio.puts("error: -test-depth requires a number")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(a, c"-test-depth:") {
                    val text: ref u8 = cstr.substr(
                        a,
                        12,
                        cstr.len(a) - 12
                    )
                    val parsed = fmt.string_to_i64(text)
                    match parsed {
                        ok v => {
                            max_depth = v
                        }
                        err _ => {
                            stdio.print("error: invalid test depth '{s}'\n", {text})
                            allocators.Arena.free(arena)
                            return 1
                        }
                    }
                } elif cstr.starts_with(a, c"-") {
                    @append(extra_flags, a)
                } else {
                    root = a
                }
            } else {
                break
            }
            ti++
        }
        if max_depth < 0 {
            stdio.puts("error: -test-depth must be zero or greater")
            allocators.Arena.free(arena)
            return 1
        }
        val code: i32 = commands.cmd_test_all(
            exe_path,
            root,
            max_depth,
            extra_flags
        )
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"-h") == 0 || cstr.cmp(input, c"-help") == 0 {
        meta.print_usage()
        allocators.Arena.free(arena)
        return 0
    }

    if cstr.cmp(input, c"-v") == 0 || cstr.cmp(input, c"-version") == 0 {
        meta.print_version()
        allocators.Arena.free(arena)
        return 0
    }

    if cstr.cmp(input, c"help") == 0 {
        val topic: mut ref u8 = c""
        val topic_opt = @get(args, 2)
        if topic_opt is some t {
            topic = t as ref u8
        }
        val code: i32 = meta.print_help(str.from_cstr(topic))
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"doctor") == 0 {
        val code: i32 = commands.cmd_doctor()
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"ref") == 0 {
        val code: i32 = commands.cmd_ref()
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"init") == 0 {
        val name_arg: mut ref u8 = c""
        val name_opt = @get(args, 2)
        if name_opt is some v {
            name_arg = v as ref u8
        }
        val code: i32 = commands.cmd_init(name_arg)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"fmt") == 0 {
        val fmt_paths: mut list[ref u8] = mem.new[ref u8]()
        val fmt_stdout: mut bool = false
        val fmt_arg_i: mut i64 = 2
        for {
            val fmt_arg_opt = @get(args, fmt_arg_i)
            if fmt_arg_opt is some fv {
                val arg: ref u8 = fv as ref u8
                if cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("fmt")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-stdio") == 0 {
                    fmt_stdout = true
                } else {
                    @append(fmt_paths, arg)
                }
            } else {
                break
            }
            fmt_arg_i++
        }
        val code: i32 = formatter.cmd_fmt(fmt_paths, fmt_stdout)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"critic") == 0 {
        val critic_paths: mut list[ref u8] = mem.new[ref u8]()
        val critic_fix: mut bool = false
        val critic_arg_i: mut i64 = 2
        for {
            val critic_arg_opt = @get(args, critic_arg_i)
            if critic_arg_opt is some cv {
                val arg: ref u8 = cv as ref u8
                if cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("critic")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-fix") == 0 {
                    critic_fix = true
                } else {
                    @append(critic_paths, arg)
                }
            } else {
                break
            }
            critic_arg_i++
        }
        val code: i32 = critic.cmd_critic(critic_paths, critic_fix)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"build") == 0 {
        val config_name: mut ref u8 = c"dev"
        val cfg_opt = @get(args, 2)
        if cfg_opt is some v {
            config_name = v as ref u8
        }
        val code: i32 = commands.cmd_build(config_name, exe_path)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"install") == 0 {
        val install_url: mut ref u8 = c""
        val install_config: mut ref u8 = c""
        val install_shell: mut ref u8 = c""
        val install_bin_dir: mut ref u8 = c""
        val install_arg_i: mut i64 = 2
        for {
            val install_arg_opt = @get(args, install_arg_i)
            if install_arg_opt is some iv {
                val arg: ref u8 = iv as ref u8
                if cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("install")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-config") == 0
                || cstr.cmp(arg, c"--config") == 0
                || cstr.cmp(arg, c"-build") == 0 {
                    val next_i: i64 = install_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some nv {
                        install_config = nv as ref u8
                        install_arg_i = next_i
                    } else {
                        stdio.puts("error: -config requires a build configuration name")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-config:") {
                    install_config = cstr.substr(arg, 8, cstr.len(arg) - 8)
                } elif cstr.cmp(arg, c"-shell") == 0
                || cstr.cmp(arg, c"--shell") == 0 {
                    val next_i: i64 = install_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some nv {
                        install_shell = nv as ref u8
                        install_arg_i = next_i
                    } else {
                        stdio.puts("error: -shell requires a shell name")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-shell:") {
                    install_shell = cstr.substr(arg, 7, cstr.len(arg) - 7)
                } elif cstr.cmp(arg, c"-bin-dir") == 0
                || cstr.cmp(arg, c"--bin-dir") == 0 {
                    val next_i: i64 = install_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some nv {
                        install_bin_dir = nv as ref u8
                        install_arg_i = next_i
                    } else {
                        stdio.puts("error: -bin-dir requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-bin-dir:") {
                    install_bin_dir = cstr.substr(arg, 9, cstr.len(arg) - 9)
                } elif cstr.starts_with(arg, c"-") {
                    stdio.print("error: unknown install option '{s}'\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    if cstr.len(install_url) == 0 {
                        install_url = arg
                    } else {
                        stdio.puts("error: install accepts a single repository URL")
                        allocators.Arena.free(arena)
                        return 1
                    }
                }
            } else {
                break
            }
            install_arg_i++
        }
        if cstr.len(install_url) == 0 {
            stdio.puts("error: install requires a git repository URL")
            stdio.puts("usage: spectre install <git-url> [-config <name>] [-shell <shell>]")
            allocators.Arena.free(arena)
            return 1
        }
        val code: i32 = install.cmd_install(
            install_url,
            install_config,
            install_shell,
            install_bin_dir
        )
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"doc") == 0 {
        val target_arg: mut ref u8 = c"."
        val md_mode: mut bool = false
        val output_arg: mut ref u8 = c""
        val read_arg: mut ref u8 = c""
        val doc_arg_i: mut i64 = 2
        for {
            val arg_opt = @get(args, doc_arg_i)
            if arg_opt is some dv {
                val arg: ref u8 = dv as ref u8
                if cstr.cmp(arg, c"-md") == 0 {
                    md_mode = true
                } elif cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("doc")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-o") == 0 || cstr.cmp(arg, c"-output") == 0 {
                    val next_i: i64 = doc_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some ov {
                        output_arg = ov as ref u8
                        doc_arg_i = next_i
                    } else {
                        stdio.puts("error: -o requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-o:") {
                    val out_len: i64 = cstr.len(arg) as i64 - 3
                    if out_len <= 0 {
                        stdio.puts("error: -o requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    output_arg = cstr.substr(arg, 3, out_len)
                } elif cstr.cmp(arg, c"-read") == 0 {
                    val next_i: i64 = doc_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some rv {
                        read_arg = rv as ref u8
                        doc_arg_i = next_i
                    } else {
                        stdio.puts("error: -read requires a markdown file")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-read:") {
                    val read_len: i64 = cstr.len(arg) as i64 - 6
                    if read_len <= 0 {
                        stdio.puts("error: -read requires a markdown file")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    read_arg = cstr.substr(arg, 6, read_len)
                } elif cstr.starts_with(arg, c"-") {
                    stdio.print("error: unknown doc option '{s}'\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    target_arg = arg
                }
            } else {
                break
            }
            doc_arg_i++
        }
        val code: i32 = docs.cmd_doc(target_arg, md_mode, output_arg, read_arg)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"add") == 0 {
        val url_opt = @get(args, 2)
        if url_opt is some v {
            val code: i32 = commands.cmd_add(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: add requires a git repository URL")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if cstr.cmp(input, c"remove") == 0 {
        val dep_opt = @get(args, 2)
        if dep_opt is some v {
            val code: i32 = commands.cmd_remove(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: remove requires a dependency name")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if cstr.cmp(input, c"upgrade") == 0 {
        val dep_name: mut ref u8 = c""
        val upgrade_opt = @get(args, 2)
        if upgrade_opt is some v {
            dep_name = v as ref u8
        }
        val code: i32 = commands.cmd_upgrade(dep_name)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"restore") == 0 {
        val code: i32 = commands.cmd_restore()
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"graph") == 0 {
        val code: i32 = commands.cmd_graph()
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"clean") == 0 {
        val code: i32 = commands.cmd_clean()
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"transl-c") == 0 {
        val tc_input: mut ref u8 = c""
        val tc_output: mut ref u8 = c""
        val ti: mut i64 = input_arg_i + 1
        for {
            val opt = @get(args, ti)
            if opt is some tv {
                val arg: ref u8 = tv as ref u8
                if cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("transl-c")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-o") == 0 || cstr.cmp(arg, c"-output") == 0 {
                    ti++
                    val next_opt = @get(args, ti)
                    if next_opt is some ov {
                        tc_output = ov as ref u8
                    } else {
                        stdio.puts("error: transl-c -o requires a value")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-") {
                    stdio.print("error: unknown transl-c flag: {s}\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    tc_input = arg
                }
            } else {
                break
            }
            ti++
        }
        if cstr.cmp(tc_input, c"") == 0 {
            stdio.puts("error: transl-c requires an input .c or .h file")
            allocators.Arena.free(arena)
            return 1
        }
        if cstr.cmp(tc_output, c"") == 0 {
            tc_output = @fmtalloc(
                "./src-out/{s}.sx",
                {path.get_name_without_ext_cstr(arena, tc_input)}
            )
        }
        val code: i32 = c_translate.translate_c(tc_input, tc_output)
        allocators.Arena.free(arena)
        return code
    }

    if cstr.cmp(input, c"bind-c") == 0 {
        val bind_inputs: mut list[ref u8] = mem.new[ref u8]()
        val bind_includes: mut list[ref u8] = mem.new[ref u8]()
        val bind_defines: mut list[ref u8] = mem.new[ref u8]()
        val bind_undefines: mut list[ref u8] = mem.new[ref u8]()
        val bind_output_dir: mut ref u8 = c"./src-out"
        val bind_link: mut ref u8 = c""
        val bind_target: mut ref u8 = c""
        val bind_normalize: mut bool = false
        val bi: mut i64 = input_arg_i + 1
        for {
            val opt = @get(args, bi)
            if opt is some bv {
                val arg: ref u8 = bv as ref u8
                if cstr.cmp(arg, c"-h") == 0 || cstr.cmp(arg, c"-help") == 0 {
                    val code: i32 = meta.print_help("bind-c")
                    allocators.Arena.free(arena)
                    return code
                } elif cstr.cmp(arg, c"-normalize") == 0 {
                    bind_normalize = true
                } elif cstr.cmp(arg, c"-o") == 0 || cstr.cmp(arg, c"-output") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some ov {
                        bind_output_dir = ov as ref u8
                    } else {
                        stdio.puts("error: bind-c -o requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.cmp(arg, c"-link") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some lv {
                        bind_link = lv as ref u8
                    } else {
                        stdio.puts("error: bind-c -link requires a library name")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.cmp(arg, c"-target") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some tv2 {
                        bind_target = tv2 as ref u8
                    } else {
                        stdio.puts("error: bind-c -target requires <os>.<arch>")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-target:") {
                    bind_target = cstr.substr(arg, 8, cstr.len(arg) - 8)
                } elif cstr.cmp(arg, c"-I") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some iv {
                        @append(bind_includes, iv as ref u8)
                    } else {
                        stdio.puts("error: bind-c -I requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-I:") {
                    @append(bind_includes, cstr.substr(arg, 3, cstr.len(arg) - 3))
                } elif cstr.starts_with(arg, c"-inc-path:") {
                    @append(bind_includes, cstr.substr(arg, 10, cstr.len(arg) - 10))
                } elif cstr.starts_with(arg, c"-I") && cstr.len(arg) > 2 {
                    @append(bind_includes, cstr.substr(arg, 2, cstr.len(arg) - 2))
                } elif cstr.cmp(arg, c"-D") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some dv {
                        @append(bind_defines, dv as ref u8)
                    } else {
                        stdio.puts("error: bind-c -D requires NAME or NAME=VALUE")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-D") && cstr.len(arg) > 2 {
                    @append(bind_defines, cstr.substr(arg, 2, cstr.len(arg) - 2))
                } elif cstr.starts_with(arg, c"-d:") {
                    @append(bind_defines, cstr.substr(arg, 3, cstr.len(arg) - 3))
                } elif cstr.cmp(arg, c"-U") == 0 {
                    bi++
                    val next_opt = @get(args, bi)
                    if next_opt is some uv {
                        @append(bind_undefines, uv as ref u8)
                    } else {
                        stdio.puts("error: bind-c -U requires a macro name")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif cstr.starts_with(arg, c"-U") && cstr.len(arg) > 2 {
                    @append(bind_undefines, cstr.substr(arg, 2, cstr.len(arg) - 2))
                } elif cstr.starts_with(arg, c"-") {
                    stdio.print("error: unknown bind-c flag: {s}\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    @append(bind_inputs, arg)
                }
            } else {
                break
            }
            bi++
        }
        if (@len(bind_inputs) as i64) == 0 {
            stdio.puts("error: bind-c requires at least one .h or .c input")
            allocators.Arena.free(arena)
            return 1
        }
        val bind_platform: mut ref u8 = reflection.current_platform_name[allocators.Arena](arena)
        val bind_arch: mut ref u8 = reflection.current_arch_name[allocators.Arena](arena)
        if cstr.len(bind_target) > 0 {
            bind_platform = builds.target_platform_of(bind_target)
            bind_arch = builds.target_arch_of(bind_target)
            if cstr.cmp(bind_platform, c"") == 0 || cstr.cmp(bind_arch, c"") == 0 {
                stdio.print(
                    "error: invalid bind-c target '{s}', expected <os>.<arch>\n",
                    {bind_target}
                )
                allocators.Arena.free(arena)
                return 1
            }
        }
        val bind_opts: mut c_bind.BindOptions = c_bind.BindOptions{
            output_dir: str.from_cstr(bind_output_dir),
            link_name: str.from_cstr(bind_link),
            target_platform: str.from_cstr(bind_platform),
            target_arch: str.from_cstr(bind_arch),
            normalize: bind_normalize,
            include_paths: bind_includes,
            defines: bind_defines,
            undefines: bind_undefines
        }
        val code: i32 = c_bind.bind_c(bind_inputs, bind_opts)
        allocators.Arena.free(arena)
        return code
    }

    if fs.is_directory_cstr(input) {
        stdio.print("error: '{s}' is a directory, not a source file\n", {input})
        stdio.puts(
            "-> run 'spectre build <config>' in a project with sx.mod, or compile a file with 'spectre <file.sx> -o <output>'"
        )
        allocators.Arena.free(arena)
        return 1
    }

    val src_size_opt = fs.file_size_cstr(input)
    if src_size_opt is some _ {
    } else {
        stdio.print("error: could not read '{s}'\n", {input})
        allocators.Arena.free(arena)
        return 1
    }

    val emit_qbe: mut bool = false
    val emit_ll: mut bool = false
    val emit_asm: mut bool = false
    val emit_alt: mut bool = false
    val show_cmd: mut bool = false
    val test_mode: mut bool = false
    val leak_check: mut bool = false
    val release_mode: mut bool = false
    val native_mode: mut bool = false
    val unroll_mode: mut bool = false
    val simd_disabled: mut bool = false
    val output_name: mut ref u8 = c""
    val build_dll: mut bool = false
    val compile_obj: mut bool = false
    val dynamic_linking: mut bool = false
    val syntax_check: mut bool = false
    val print_ast: mut bool = false
    val use_alt: mut bool = false
    val alt_compiler: mut ref u8 = c""
    val extra_includes: mut list[ref u8] = mem.new[ref u8]()
    val inc_paths: mut list[ref u8] = mem.new[ref u8]()
    val src_target: mut ref u8 = c""
    val target_spec: mut ref u8 = c""
    val runtime_spec: mut ref u8 = c""
    val xwin_dir: mut ref u8 = c""
    val no_xwin: mut bool = false
    val import_map_spec: mut ref u8 = c""
    val sysroot_spec: mut ref u8 = c""
    val rt_lib_spec: mut ref u8 = c""
    val shim_output: mut ref u8 = c""
    val bootstrap_mode: mut bool = false
    val arg_i: mut i64 = input_arg_i + 1

    // Note on this:
    //
    // spectre build passes -no-single-flags so project builds are not
    // affected by an sx.mod sitting next to the entry file.
    val no_single_flags: mut bool = false
    val scan_i: mut i64 = input_arg_i + 1
    for {
        if scan_i >= argc {
            break
        }
        val scan_opt = @get(args, scan_i)
        if scan_opt is some scan_arg {
            if cstr.cmp(scan_arg as ref u8, c"-no-single-flags") == 0 {
                no_single_flags = true
                break
            }
        }
        scan_i++
    }

    val mod_version: ref u8 = commands.load_version_for(input)
    if cstr.len(mod_version) > 0 {
        defines.set("SPECTRE_MOD_VERSION", str.from_cstr(mod_version))
    }

    val parse_args: mut list[ref u8] = args
    val parse_argc: mut i64 = argc
    if !no_single_flags {
        val single_flags_result = commands.load_single_flags_for(input)
        match single_flags_result {
            ok single_flags => {
                if cstr.len(single_flags) > 0 {
                    val extra_flags: list[ref u8] = commands.split_single_flags(single_flags)
                    val merged: mut list[ref u8] = mem.new[ref u8]()
                    val mi: mut i64 = 0
                    for {
                        if mi > input_arg_i {
                            break
                        }
                        val item = @get(args, mi)
                        if item is some v {
                            @append(merged, v as ref u8)
                        }
                        mi++
                    }
                    for extra in extra_flags {
                        @append(merged, extra)
                    }
                    mi = input_arg_i + 1
                    for {
                        if mi >= argc {
                            break
                        }
                        val item = @get(args, mi)
                        if item is some v {
                            @append(merged, v as ref u8)
                        }
                        mi++
                    }
                    parse_args = merged
                    parse_argc = @len(merged) as i64
                }
            }
            err e => {
                if cstr.len(e) > 0 {
                    stdio.print("error: {s}\n", {e})
                }
                allocators.Arena.free(arena)
                return 1
            }
        }
    }

    // Explicit -target selections may use QBE on any host.  Keep the
    // automatic fallback below for hosts where QBE is unavailable.
    for {
        if (arg_i >= parse_argc) {
            break
        }
        val arg_opt = @get(parse_args, arg_i)
        if arg_opt is some arg_val {
            val arg: ref u8 = arg_val as ref u8

            if cstr.cmp(arg, c"-o") == 0 || cstr.cmp(arg, c"-output") == 0 {
                val next_i: i64 = arg_i + 1
                if (next_i < parse_argc) {
                    val next_opt = @get(parse_args, next_i)
                    if next_opt is some v {
                        output_name = v as ref u8
                    } else {
                        stdio.puts("error: -o requires a value")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -o requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif cstr.cmp(arg, c"-d") == 0 {
                val next_i: i64 = arg_i + 1
                if next_i < parse_argc {
                    val next_opt = @get(parse_args, next_i)
                    if next_opt is some dv {
                        val def_spec: ref u8 = dv as ref u8
                        if !defines.add_spec(str.from_cstr(def_spec)) {
                            stdio.print(
                                "error: invalid define '{s}', expected NAME=VALUE\n",
                                {def_spec}
                            )
                            allocators.Arena.free(arena)
                            return 1
                        }
                    } else {
                        stdio.puts("error: -d requires a NAME=VALUE argument")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif cstr.starts_with(arg, c"-d:") {
                val def_spec: ref u8 = cstr.substr(arg, 3, cstr.len(arg) - 3)
                if !defines.add_spec(str.from_cstr(def_spec)) {
                    stdio.print("error: invalid define '{s}', expected -d:NAME=VALUE\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                arg_i++
            } elif cstr.cmp(arg, c"-emit-ssa") == 0 {
                emit_qbe = true
                arg_i++
            } elif cstr.cmp(arg, c"-emit-ll") == 0 {
                emit_ll = true
                arg_i++
            } elif cstr.cmp(arg, c"-emit-asm") == 0 {
                emit_asm = true
                arg_i++
            } elif cstr.cmp(arg, c"-emit-alt") == 0 {
                emit_alt = true
                arg_i++
            } elif cstr.cmp(arg, c"-show-cmd") == 0 {
                show_cmd = true
                arg_i++
            } elif cstr.cmp(arg, c"-test") == 0 {
                test_mode = true
                arg_i++
            } elif cstr.cmp(arg, c"-leak-check") == 0 {
                leak_check = true
                arg_i++
            } elif cstr.cmp(arg, c"-loud") == 0 || cstr.cmp(arg, c"-l") == 0 {
                quiet = false
                arg_i++
            } elif cstr.cmp(arg, c"-release") == 0 {
                release_mode = true
                arg_i++
            } elif cstr.cmp(arg, c"-native") == 0 {
                native_mode = true
                arg_i++
            } elif cstr.cmp(arg, c"-unroll") == 0 {
                unroll_mode = true
                arg_i++
            } elif cstr.cmp(arg, c"-no-simd") == 0 {
                simd_disabled = true
                arg_i++
            } elif cstr.cmp(arg, c"-dynamic") == 0 {
                dynamic_linking = true
                arg_i++
            } elif cstr.cmp(arg, c"-no-single-flags") == 0 {
                arg_i++
            } elif cstr.cmp(arg, c"-dll") == 0 {
                build_dll = true
                arg_i++
            } elif cstr.cmp(arg, c"-c") == 0 || cstr.cmp(arg, c"-compile") == 0 {
                compile_obj = true
                arg_i++
            } elif cstr.cmp(arg, c"-syntax-check") == 0 {
                syntax_check = true
                arg_i++
            } elif cstr.cmp(arg, c"-ast") == 0 {
                print_ast = true
                arg_i++
            } elif cstr.cmp(arg, c"-b") == 0 || cstr.cmp(arg, c"-bootstrap") == 0 {
                bootstrap_mode = true
                arg_i++
            } elif cstr.cmp(arg, c"-alt") == 0 || cstr.cmp(arg, c"-a") == 0 {
                use_alt = true
                arg_i++
            } elif cstr.starts_with(arg, c"-alt:") {
                use_alt = true
                val compiler_str = builds.parse_alt_compiler_arg(arg)
                if cstr.cmp(compiler_str, c"") != 0 {
                    alt_compiler = compiler_str
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-target:") {
                val tgt_len: i64 = cstr.len(arg) as i64 - 8
                if tgt_len <= 0 {
                    stdio.puts("error: -target requires <os>.<arch>, e.g. -target:windows.x86_64")
                    allocators.Arena.free(arena)
                    return 1
                }
                target_spec = cstr.substr(arg, 8, tgt_len)
                arg_i++
            } elif cstr.starts_with(arg, c"-src-target:") {
                val tgt_len: i64 = cstr.len(arg) as i64 - 12
                if tgt_len > 0 {
                    src_target = cstr.substr(arg, 12, tgt_len)
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-runtime:") {
                val rt_len: i64 = cstr.len(arg) as i64 - 9
                if rt_len <= 0 {
                    stdio.puts("error: -runtime requires hosted or freestanding")
                    allocators.Arena.free(arena)
                    return 1
                }
                runtime_spec = cstr.substr(arg, 9, rt_len)
                if cstr.cmp(runtime_spec, c"hosted") != 0
                && cstr.cmp(runtime_spec, c"freestanding") != 0 {
                    stdio.print(
                        "error: unknown runtime mode '{s}'; expected hosted or freestanding\n",
                        {runtime_spec}
                    )
                    allocators.Arena.free(arena)
                    return 1
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-xwin:") {
                val xwin_len: i64 = cstr.len(arg) as i64 - 6
                if xwin_len <= 0 {
                    stdio.puts("error: -xwin requires a directory, e.g. -xwin:$HOME/.xwin")
                    allocators.Arena.free(arena)
                    return 1
                }
                xwin_dir = cstr.substr(arg, 6, xwin_len)
                arg_i++
            } elif cstr.cmp(arg, c"-no-xwin") == 0 {
                no_xwin = true
                arg_i++
            } elif cstr.starts_with(arg, c"-import-map:") {
                val n: i64 = cstr.len(arg) as i64 - 12
                if n > 0 {
                    import_map_spec = cstr.substr(arg, 12, n)
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-sysroot:") {
                val n: i64 = cstr.len(arg) as i64 - 9
                if n > 0 {
                    sysroot_spec = cstr.substr(arg, 9, n)
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-rt-lib:") {
                val n: i64 = cstr.len(arg) as i64 - 8
                if n > 0 {
                    rt_lib_spec = cstr.substr(arg, 8, n)
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-emit-shim:") {
                val shim_len: i64 = cstr.len(arg) as i64 - 11
                if shim_len > 0 {
                    shim_output = cstr.substr(arg, 11, shim_len)
                }
                arg_i++
            } elif cstr.starts_with(arg, c"-inc-path:") {
                val path_str: ref u8 = cstr.substr(arg, 10, cstr.len(arg) - 10)
                if cstr.cmp(path_str, c"") == 0 {
                    stdio.puts("error: -inc-path requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
                @append(inc_paths, path_str)
                arg_i++
            } else {
                stdio.print("error: unknown flag: {s}\n", {arg})
                allocators.Arena.free(arena)
                return 1
            }
        } else {
            arg_i++
        }
    }

    val host_platform: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    val host_arch: ref u8 = reflection.current_arch_name[allocators.Arena](arena)
    val target_platform: mut ref u8 = host_platform
    val target_arch: mut ref u8 = host_arch
    val explicit_target: bool = cstr.cmp(target_spec, c"") != 0
    if explicit_target {
        target_platform = builds.target_platform_of(target_spec)
        target_arch = builds.target_arch_of(target_spec)
        if cstr.cmp(target_platform, c"") == 0 || cstr.cmp(target_arch, c"") == 0 {
            stdio.print(
                "error: invalid target '{s}', expected <os>.<arch> (for example windows.x86_64)\n",
                {target_spec}
            )
            allocators.Arena.free(arena)
            return 1
        }
        if cstr.cmp(target_platform, c"darwin") == 0 {
            stdio.puts("error: cross compilation to macOS is not supported")
            allocators.Arena.free(arena)
            return 1
        }
        if !builds.target_is_supported(target_platform, target_arch) {
            stdio.print(
                "error: unsupported target '{s}'; supported: linux.x86_64, linux.aarch64, windows.x86_64, windows.aarch64\n",
                {target_spec}
            )
            allocators.Arena.free(arena)
            return 1
        }
        if cstr.cmp(src_target, c"") == 0 {
            src_target = target_spec
        }
    }
    val cross_target: bool = builds.target_needs_cross(
        target_platform,
        target_arch,
        host_platform,
        host_arch
    )

    // Runtime selection.  Freestanding is the default for the supported
    // Linux/Windows targets; other hosts keep the hosted runtime unless the
    // user explicitly asks for a mode that the target cannot provide.
    val runtime_mode: mut ref u8 = c"freestanding"
    if cstr.len(runtime_spec) > 0 {
        runtime_mode = runtime_spec
    }
    if !builds.runtime_supported(target_platform, target_arch, runtime_mode) {
        if cstr.len(runtime_spec) > 0 {
            stdio.print(
                "error: runtime mode '{s}' is not implemented for {s}.{s}\n",
                {runtime_mode, target_platform, target_arch}
            )
            allocators.Arena.free(arena)
            return 1
        }
        runtime_mode = c"hosted"
    }
    // Dynamic/shared output and the bootstrap path still use the hosted C
    // runtime; freestanding mode is a fully static link.
    if dynamic_linking || build_dll || bootstrap_mode {
        runtime_mode = c"hosted"
    }
    val freestanding_runtime: mut bool = builds.runtime_is_freestanding(runtime_mode)
    module.set_runtime_mode(runtime_mode)
    codegen.set_runtime_mode(runtime_mode)
    alt_codegen.set_runtime_mode(runtime_mode)

    // Hosted Windows cross links need the MSVC CRT and Windows SDK import
    // libraries. Resolve xwin once, before any compilation starts, so a
    // missing toolchain produces one actionable error instead of a pile of
    // missing `.lib` diagnostics from the linker.
    val wants_windows_link: bool = cross_target
    && builds.target_is_windows(target_platform)
    && !freestanding_runtime
    && !compile_obj
    && !emit_alt
    && !emit_qbe
    && !emit_ll
    && !emit_asm
    && !syntax_check
    && !print_ast
    val xwin_root: mut ref u8 = c""
    if cross_target && builds.target_is_windows(target_platform) {
        if cstr.len(xwin_dir) > 0 {
            xwin_root = xwin_dir
        } elif !no_xwin {
            xwin_root = builds.xwin_find_root()
        }
        if wants_windows_link && !builds.xwin_available_in(xwin_root, target_arch) {
            if cstr.len(xwin_root) > 0 {
                stdio.print(
                    "error: xwin at '{s}' is missing CRT/SDK libraries for {s}\n",
                    {xwin_root, target_arch}
                )
            } else {
                stdio.print(
                    "error: windows.{s} requires xwin or a compatible Windows SDK\n",
                    {target_arch}
                )
            }
            stdio.print("  install: cargo install xwin --locked\n", {})
            stdio.print(
                "           xwin --arch {s} --accept-license splat --output ~/.xwin\n",
                {target_arch}
            )
            stdio.print("  or pass: -xwin:<dir>\n", {})
            allocators.Arena.free(arena)
            return 1
        }
        if wants_windows_link && !quiet {
            stdio.print("[I  ]│ xwin root: {s}\n", {xwin_root})
        }
    }

    if cstr.cmp(src_target, c"") != 0 && !explicit_target && !emit_alt && !emit_qbe && !emit_asm {
        stdio.puts("error: -src-target requires -emit-alt or -emit-ssa")
        allocators.Arena.free(arena)
        return 1
    }

    if run_mode && (emit_qbe || emit_ll || emit_asm || emit_alt || build_dll || compile_obj || syntax_check || print_ast) {
        stdio.puts("error: run requires flags that produce a runnable executable")
        allocators.Arena.free(arena)
        return 1
    }

    val exe_path2: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
    val exe_dir: mut ref u8 = c"."
    if cstr.cmp(exe_path2, c".") != 0 {
        exe_dir = path.dir_cstr(exe_path2)
    }

    if !use_alt && !emit_alt && !emit_qbe && !emit_ll && !emit_asm &&
    !syntax_check && !print_ast {
        if !builds.is_compiler_available(c"qbe") {
            use_alt = true
            if !quiet {
                stdio.puts("[I  ]│ QBE not found - using fallback C backend")
            }
        }
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt && !print_ast {
        stdio.puts("[I  ]│ Resolving module")
    }

    val resolve_result = module.resolve_module(
        frontend_arena,
        input,
        mem.new[ref u8](),
        exe_dir,
        none
    )
    val root_mod: mut ref module.ResolvedModule = none

    match resolve_result {
        ok m => {
            root_mod = m
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            allocators.Arena.free(arena)
            return 1
        }
    }

    // Programs that explicitly link a non-system C library cannot be made
    // freestanding without that library being rebuilt for the target.  Fall
    // back to the hosted runtime unless the user requested freestanding.
    if freestanding_runtime && cstr.len(runtime_spec) == 0
    && !dynamic_linking && !build_dll && !compile_obj {
        match module.collect_used_links(root_mod, exe_dir, true) {
            ok detected_links => {
                if builds.links_require_hosted(detected_links) {
                    runtime_mode = c"hosted"
                    freestanding_runtime = false
                    module.set_runtime_mode(runtime_mode)
                    codegen.set_runtime_mode(runtime_mode)
                    alt_codegen.set_runtime_mode(runtime_mode)
                    stdio.eprint(
                        "warning: external C library detected; using hosted runtime (pass -runtime:freestanding to force)\n",
                        {}
                    )
                }
            }
            err _ => { }
        }
    }

    if !freestanding_runtime && cross_target && builds.target_is_windows(target_platform)
    && !compile_obj && !emit_alt && !emit_qbe && !emit_ll && !emit_asm
    && !syntax_check && !print_ast {
        if !builds.xwin_available_in(xwin_root, target_arch) {
            stdio.print(
                "error: windows.{s} requires xwin or a compatible Windows SDK\n",
                {target_arch}
            )
            stdio.print("  install: cargo install xwin --locked\n", {})
            stdio.print("  or pass: -xwin:<dir>\n", {})
            stdio.print("  or use:  -runtime:freestanding\n", {})
            allocators.Arena.free(arena)
            return 1
        }
    }

    if print_ast {
        val items: list[ref parser.Node] = module.module_items(root_mod)
        ast_printer.print_ast_items(items)
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[II ]│ Semantic analysis")
    }

    val quiet_flag: mut bool = false
    if quiet {
        quiet_flag = true
    }
    val errors: list[ref u8] = sema.check_module_tree(
        frontend_arena,
        root_mod,
        quiet_flag,
        src_target
    )
    val nerrors: i64 = @len(errors) as i64
    if nerrors > 0 {
        for e in errors {
            stdio.print("error: {s}\n", {e})
        }
        allocators.Arena.free(arena)
        return 1
    }

    if syntax_check {
        stdio.puts("Syntax OK")
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[III]│ CG pass")
    }

    if ((@len(extra_includes) as i64) > 0 && !use_alt && !emit_alt) {
        stdio.puts("error: -I<headers> requires the alt backend (-alt)")
        allocators.Arena.free(arena)
        return 1
    }

    if use_alt || emit_alt {
        if cross_target && !builds.cross_toolchain_available(target_platform) {
            val linker_hint: mut ref u8 = c"ld.lld"
            if cstr.cmp(target_platform, c"windows") == 0 {
                linker_hint = c"lld-link"
            }
            stdio.print(
                "error: cross compilation to {s}.{s} requires clang and {s}\n",
                {target_platform, target_arch, linker_hint}
            )
            allocators.Arena.free(arena)
            return 1
        }

        val static_flag_alt: mut ref u8 = c""
        val strip_flag_alt: mut ref u8 = c""
        if !compile_obj && !build_dll {
            static_flag_alt = builds.static_link_flag(target_platform, dynamic_linking)
        }

        val selected_compiler: mut ref u8 = builds.pick_alt_backend(
            alt_compiler,
            release_mode,
            input,
            root_mod.items,
            arena
        )
        if cross_target && cstr.cmp(alt_compiler, c"") == 0 {
            selected_compiler = c"clang"
        }
        if cstr.cmp(
            static_flag_alt,
            c""
        ) != 0 && !builds.compiler_supports_static_linking(selected_compiler) {
            if cstr.cmp(alt_compiler, c"") == 0 {
                if builds.is_compiler_available(c"clang") {
                    selected_compiler = c"clang"
                } elif builds.is_compiler_available(c"cc") {
                    selected_compiler = c"cc"
                } else {
                    static_flag_alt = c""
                }
            } else {
                if !quiet {
                    stdio.puts("warning: tcc does not support static linking, thus, linking dynamically")
                }
                static_flag_alt = c""
            }
        }

        val compiler_kind: ref u8 = builds.alt_compiler_kind(selected_compiler)
        if builds.compiler_uses_msvc_flags(compiler_kind) {
            static_flag_alt = c""
        }
        if !compile_obj && !build_dll {
            strip_flag_alt = builds.compiler_strip_flag(compiler_kind, release_mode)
            if cstr.cmp(target_platform, c"windows") == 0 {
                strip_flag_alt = c""
            }
        }
        val simd_backend: mut i64 = 2
        if !simd_disabled {
            simd_backend = builds.alt_simd_backend(
                selected_compiler,
                target_platform,
                target_arch
            )
        }
        val alt_runtime_obj: mut ref u8 = c""
        val alt_start_obj: mut ref u8 = c""
        if freestanding_runtime && !compile_obj {
            val rt_c: ref u8 = builds.freestanding_runtime_source(exe_dir)
            val rt_name: mut ref u8 = c"spectre_runtime.o"
            if cstr.cmp(target_platform, c"windows") == 0 {
                rt_name = c"spectre_runtime.obj"
            }
            val _rt_size: mut i64 = 0
            val _rt_size_opt = fs.file_size_cstr(rt_c)
            match _rt_size_opt {
                some sz => {
                    _rt_size = sz as i64
                }
                none => {
                    _rt_size = 0
                }
            }
            val rt_cache_name: ref u8 = @fmtalloc("{s}_{lld}_fs2", {rt_name, _rt_size})
            alt_runtime_obj = builds.freestanding_cache_path(
                target_platform,
                target_arch,
                rt_cache_name
            )
            if !os.exists(alt_runtime_obj) {
                val alt_triple: ref u8 = builds.target_triple(target_platform, target_arch)
                val rt_tmp: ref u8 = @fmtalloc("{s}.tmp", {alt_runtime_obj})
                val rt_cmd_alt: ref u8 = @fmtalloc(
                    "clang --target={s} {s} -c {s} -o {s} 2>&1",
                    {alt_triple, builds.freestanding_c_flags(), rt_c, rt_tmp}
                )
                if show_cmd {
                    stdio.print("{s}\n", {rt_cmd_alt})
                }
                val rt_res_alt = os.exec(rt_cmd_alt)
                match rt_res_alt {
                    ok v => {
                        val vstr: ref u8 = ostr.as_cstr(v)
                        if cstr.len(vstr) > 0 {
                            stdio.print("{s}", {vstr})
                        }
                    }
                    err _ => { }
                }
                if os.exists(alt_runtime_obj) {
                    os.delete(alt_runtime_obj)
                }
                fs.rename_path_cstr(rt_tmp, alt_runtime_obj)
            }
            val start_src_alt: ref u8 = builds.freestanding_start_source(
                exe_dir,
                target_platform,
                target_arch
            )
            if cstr.len(start_src_alt) > 0 {
                val _st_size: mut i64 = 0
                val _st_size_opt = fs.file_size_cstr(start_src_alt)
                match _st_size_opt {
                    some sz => {
                        _st_size = sz as i64
                    }
                    none => {
                        _st_size = 0
                    }
                }
                val st_cache_name: ref u8 = @fmtalloc("spectre_start_{lld}.o", {_st_size})
                alt_start_obj = builds.freestanding_cache_path(
                    target_platform,
                    target_arch,
                    st_cache_name
                )
                if !os.exists(alt_start_obj) {
                    val alt_triple2: ref u8 = builds.target_triple(target_platform, target_arch)
                    val st_tmp: ref u8 = @fmtalloc("{s}.tmp", {alt_start_obj})
                    val st_cmd_alt: ref u8 = @fmtalloc(
                        "clang --target={s} -c {s} -o {s} 2>&1",
                        {alt_triple2, start_src_alt, st_tmp}
                    )
                    if show_cmd {
                        stdio.print("{s}\n", {st_cmd_alt})
                    }
                    val st_res_alt = os.exec(st_cmd_alt)
                    match st_res_alt {
                        ok v => {
                            val vstr: ref u8 = ostr.as_cstr(v)
                            if cstr.len(vstr) > 0 {
                                stdio.print("{s}", {vstr})
                            }
                        }
                        err _ => { }
                    }
                    if os.exists(alt_start_obj) {
                        os.delete(alt_start_obj)
                    }
                    fs.rename_path_cstr(st_tmp, alt_start_obj)
                }
            }
        }

        if cstr.len(rt_lib_spec) > 0 {
            alt_runtime_obj = rt_lib_spec
        }

        val alt_sys_rt_obj: mut ref u8 = c""
        if freestanding_runtime && !compile_obj
        && !cstr.ends_with(input, c"runtime/sys.sx") {
            val sys_src_alt: ref u8 = path.join_cstr(
                exe_dir,
                c"spectrelib/runtime/sys.sx"
            )
            if os.exists(sys_src_alt) {
                val sys_size_alt: mut i64 = 0
                val sys_size_alt_opt = fs.file_size_cstr(sys_src_alt)
                match sys_size_alt_opt {
                    some sz => {
                        sys_size_alt = sz as i64
                    }
                    none => {
                        sys_size_alt = 0
                    }
                }
                val sys_ext_alt: mut ref u8 = c".o"
                if cstr.cmp(target_platform, c"windows") == 0 {
                    sys_ext_alt = c".obj"
                }
                val sys_base_alt: ref u8 = builds.freestanding_cache_path(
                    target_platform,
                    target_arch,
                    @fmtalloc("spectre_sys_runtime_fs_{lld}", {sys_size_alt})
                )
                alt_sys_rt_obj = @fmtalloc("{s}{s}", {sys_base_alt, sys_ext_alt})
                if !os.exists(alt_sys_rt_obj) {
                    val self_exe: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
                    val sys_cmd_alt: ref u8 = @fmtalloc(
                        "{s} {s} -c -runtime:freestanding -target:{s}.{s} -o {s} 2>&1",
                        {self_exe, sys_src_alt, target_platform, target_arch, sys_base_alt}
                    )
                    if show_cmd {
                        stdio.print("{s}\n", {sys_cmd_alt})
                    }
                    val sys_res_alt = os.exec(sys_cmd_alt)
                    match sys_res_alt {
                        ok v => {
                            val vstr: ref u8 = ostr.as_cstr(v)
                            if cstr.len(vstr) > 0 {
                                stdio.print("{s}", {vstr})
                            }
                        }
                        err _ => { }
                    }
                }
            }
        }

        val alt_win_compat: mut ref u8 = c""
        if cstr.cmp(target_platform, c"windows") == 0
        && !freestanding_runtime && !compile_obj {
            val compat_c: ref u8 = path.join_cstr(
                exe_dir,
                c"spectrelib/csources/hosted_windows_compat.c"
            )
            if os.exists(compat_c) {
                val compat_obj: ref u8 = builds.get_unique_tmp_path(c"spectre_hosted_win_compat.obj")
                val compat_cmd: ref u8 = @fmtalloc(
                    "clang --target={s} -std=c99 -c {s} -o {s}{s} 2>&1",
                    {
                        builds.target_triple(target_platform, target_arch),
                        compat_c,
                        compat_obj,
                        builds.xwin_include_flags(xwin_root, target_arch)
                    }
                )
                if show_cmd {
                    stdio.print("{s}\n", {compat_cmd})
                }
                val compat_res = os.exec(compat_cmd)
                match compat_res {
                    ok v => {
                        val vstr: ref u8 = ostr.as_cstr(v)
                        val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                        if ostr.contains(v, err_mark) {
                            stdio.print("{s}", {vstr})
                            os.delete(compat_obj)
                        } else {
                            alt_win_compat = compat_obj
                        }
                    }
                    err _ => { }
                }
            }
        }

        val c_ir: mut ref u8 = c""
        val emit_ld: bool = !bootstrap_mode
        if test_mode {
            c_ir = alt_codegen.gen_module_c_test(
                root_mod,
                release_mode,
                extra_includes,
                src_target,
                emit_ld,
                simd_backend,
                leak_check
            )
        } else {
            c_ir = alt_codegen.gen_module_c(
                root_mod,
                release_mode,
                extra_includes,
                src_target,
                emit_ld,
                simd_backend,
                leak_check
            )
        }

        if emit_alt != false {
            stdio.puts(str.from_cstr(c_ir))
            @free(c_ir)
            allocators.Arena.free(arena)
            return 0
        }

        val binary_name_alt: mut ref u8 = c""
        if cstr.cmp(output_name, c"") == 0 {
            binary_name_alt = path.get_name_without_ext_cstr(arena, input)
        } else {
            binary_name_alt = output_name
        }

        val c_file = builds.get_unique_tmp_path(c"spectre_output.c")
        val c_f = os.open(c_file, c"w")
        if c_f is some f {
            os.write(f, c_ir, cstr.len(c_ir) as i64)
            os.close(f)
            @free(c_ir)
        } else {
            stdio.puts("\nerror: could not write C code")
            allocators.Arena.free(arena)
            return 1
        }

        val output_specified_alt: bool = cstr.cmp(output_name, c"") != 0
        val final_output_alt: mut ref u8 = c""
        if output_specified_alt {
            final_output_alt = binary_name_alt
        } else {
            fs.mkdir_path_cstr(c"./s-out")
            if cstr.cmp(target_platform, c"windows") == 0
            && !compile_obj
            && !build_dll {
                final_output_alt = @fmtalloc("./s-out/{s}.exe", {binary_name_alt})
            } else {
                final_output_alt = @fmtalloc("./s-out/{s}", {binary_name_alt})
            }
        }
        if compile_obj {
            final_output_alt = @fmtalloc(
                "{s}{s}",
                {final_output_alt, builds.target_object_ext(target_platform)}
            )
        } elif build_dll {
            if cstr.cmp(target_platform, c"windows") == 0 {
                final_output_alt = @fmtalloc("{s}.dll", {final_output_alt})
            } else {
                final_output_alt = @fmtalloc("{s}.so", {final_output_alt})
            }
        }

        val links_alt_result = module.collect_used_links(
            root_mod,
            exe_dir,
            cstr.cmp(static_flag_alt, c"") != 0
        )
        val links_alt: mut list[ref u8] = mem.new[ref u8]()
        match links_alt_result {
            ok resolved => {
                links_alt = resolved
            }
            err e => {
                stdio.print("error: {s}\n", {e})
                os.delete(c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        if !compile_obj && !freestanding_runtime {
            builds.append_debug_runtime_links(
                links_alt,
                exe_dir,
                quiet,
                release_mode,
                selected_compiler,
                target_platform
            )
        }
        val windows_cross_link: bool = cross_target
        && builds.target_is_windows(target_platform)
        val link_flags_alt: mut ref u8 = c""
        if cstr.cmp(static_flag_alt, c"") != 0 {
            link_flags_alt = @fmtalloc(" {s}", {static_flag_alt})
        }
        if cstr.cmp(strip_flag_alt, c"") != 0 {
            link_flags_alt = @fmtalloc("{s} {s}", {link_flags_alt, strip_flag_alt})
        }
        for link_flag in links_alt {
            val translated_link: mut ref u8 = c""
            if windows_cross_link {
                if cstr.starts_with(link_flag, c"-l") {
                    translated_link = @fmtalloc(
                        "-Wl,{s}",
                        {builds.translate_lld_link_flag(link_flag)}
                    )
                } elif cstr.ends_with(link_flag, c".lib") {
                    translated_link = @fmtalloc("-Wl,{s}", {link_flag})
                } else {
                    translated_link = link_flag
                }
            } else {
                translated_link = builds.translate_link_flag(
                    compiler_kind,
                    link_flag
                )
            }
            if cstr.len(translated_link) > 0 {
                link_flags_alt = @fmtalloc("{s} {s}", {link_flags_alt, translated_link})
            }
        }
        if windows_cross_link && !freestanding_runtime {
            link_flags_alt = @fmtalloc(
                "{s} {s} -Wl,/ignore:4099",
                {
                    link_flags_alt,
                    builds.xwin_lib_path_flags_clang(xwin_root, target_arch)
                }
            )
            if cstr.len(alt_win_compat) > 0 {
                link_flags_alt = @fmtalloc("{s} {s}", {link_flags_alt, alt_win_compat})
            }
        }
        if freestanding_runtime && !compile_obj {
            if cstr.cmp(target_platform, c"windows") == 0 {
                link_flags_alt = @fmtalloc(
                    "{s} {s} {s} {s} {s} {s}",
                    {
                        link_flags_alt,
                        builds.freestanding_windows_link_flags(compiler_kind),
                        builds.freestanding_windows_import_flags(target_arch),
                        alt_runtime_obj,
                        alt_sys_rt_obj,
                        alt_start_obj
                    }
                )
            } else {
                link_flags_alt = @fmtalloc(
                    "{s} -nostdlib -static {s} {s} {s}",
                    {link_flags_alt, alt_runtime_obj, alt_sys_rt_obj, alt_start_obj}
                )
            }
        }
        if compile_obj {
            link_flags_alt = c""
        }
        val include_flags_alt: mut ref u8 = c""
        for inc_path in inc_paths {
            include_flags_alt = @fmtalloc(
                "{s} {s}",
                {include_flags_alt, builds.compiler_include_flag(compiler_kind, inc_path)}
            )
        }
        if windows_cross_link && !freestanding_runtime {
            include_flags_alt = @fmtalloc(
                "{s} {s}",
                {include_flags_alt, builds.xwin_include_flags(xwin_root, target_arch)}
            )
        }

        val warn_flag: ref u8 = builds.compiler_warn_flag(selected_compiler)
        val perf_flags: mut ref u8 = c""
        if cstr.cmp(selected_compiler, c"tcc") != 0 {
            val native_flags: ref u8 = builds.compiler_native_flags(
                compiler_kind,
                target_platform,
                target_arch,
                native_mode
            )
            if cstr.len(native_flags) > 0 {
                perf_flags = @fmtalloc("{s} {s}", {perf_flags, native_flags})
            }
            val unroll_flags: ref u8 = builds.compiler_unroll_flag(
                compiler_kind,
                unroll_mode
            )
            if cstr.len(unroll_flags) > 0 {
                perf_flags = @fmtalloc("{s} {s}", {perf_flags, unroll_flags})
            }
        }
        val cc_flags_alt: mut ref u8 = c""
        if builds.compiler_uses_msvc_flags(compiler_kind) {
            cc_flags_alt = @fmtalloc(
                "/nologo {s} {s} {s}{s}",
                {
                    builds.compiler_std_flag(compiler_kind),
                    warn_flag,
                    builds.compiler_opt_flag(compiler_kind, release_mode),
                    perf_flags
                }
            )
            if freestanding_runtime {
                cc_flags_alt = @fmtalloc("{s} /GS-", {cc_flags_alt})
            }
            if cstr.cmp(compiler_kind, c"clang-cl") == 0 {
                cc_flags_alt = @fmtalloc(
                    "{s} -Wno-error=int-conversion",
                    {cc_flags_alt}
                )
            }
        } else {
            cc_flags_alt = @fmtalloc(
                "{s} {s} {s} -Wno-error=int-conversion{s}",
                {
                    builds.compiler_std_flag(compiler_kind),
                    warn_flag,
                    builds.compiler_opt_flag(compiler_kind, release_mode),
                    perf_flags
                }
            )
            if cross_target {
                cc_flags_alt = @fmtalloc(
                    "--target={s} -fuse-ld=lld {s}",
                    {builds.target_triple(target_platform, target_arch), cc_flags_alt}
                )
            }
            if freestanding_runtime {
                cc_flags_alt = @fmtalloc(
                    "{s} {s}",
                    {cc_flags_alt, builds.freestanding_c_flags()}
                )
            }
            if windows_cross_link {
                cc_flags_alt = @fmtalloc("{s} -g0", {cc_flags_alt})
            }
            if compile_obj {
                cc_flags_alt = @fmtalloc("{s} -c", {cc_flags_alt})
            }
        }
        val test_output_alt: ref u8 = builds.get_unique_tmp_path(c"spectre_test_bin_alt")
        val compile_output: mut ref u8 = test_output_alt
        if !test_mode {
            compile_output = final_output_alt
        }

        val alt_cmd: mut ref u8 = c""
        if cstr.cmp(selected_compiler, c"tcc") == 0 {
            val tcc_compile: mut ref u8 = c""
            if compile_obj {
                tcc_compile = c" -c"
            }
            if test_mode {
                alt_cmd = @fmtalloc(
                    "tcc {s} -o {s} -w -std=c99{s}{s} {s} 2>&1",
                    {c_file, test_output_alt, tcc_compile, include_flags_alt, link_flags_alt}
                )
            } else {
                alt_cmd = @fmtalloc(
                    "tcc {s} -o {s} -w -std=c99{s}{s} {s} 2>&1",
                    {c_file, final_output_alt, tcc_compile, include_flags_alt, link_flags_alt}
                )
            }
        } elif builds.compiler_uses_msvc_flags(compiler_kind) {
            if compile_obj {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} /c {s} /Fo:{s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        c_file,
                        compile_output
                    }
                )
            } else {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} {s} /Fe:{s} {s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        c_file,
                        compile_output,
                        link_flags_alt
                    }
                )
            }
        } else {
            if cstr.cmp(cc_flags_alt, c"") == 0 {
                alt_cmd = @fmtalloc(
                    "{s}{s} -o {s} {s}{s} 2>&1",
                    {selected_compiler, include_flags_alt, compile_output, c_file, link_flags_alt}
                )
            } else {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} -o {s} {s}{s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        compile_output,
                        c_file,
                        link_flags_alt
                    }
                )
            }
        }

        if !quiet && !emit_alt {
            stdio.puts("[IV ]│ AMCS")
        }
        if show_cmd {
            stdio.print("{s}\n", {alt_cmd})
        }

        val alt_res = os.exec(alt_cmd)
        match alt_res {
            ok v => {
                val vstr: ref u8 = ostr.as_cstr(v)
                val error_prefix = ostr.from_cstr[allocators.Arena](arena, c"error:")
                val msvc_error = ostr.from_cstr[allocators.Arena](arena, c"error")
                val has_error: bool = ostr.contains(v, error_prefix)
                || (builds.compiler_uses_msvc_flags(compiler_kind)
                    && ostr.contains(v, msvc_error))
                if has_error {
                    val display: mut ref u8 = vstr
                    if !bootstrap_mode {
                        display = builds.filter_c_diagnostics(vstr)
                    }
                    stdio.print("{s}", {display})
                    os.delete(c_file)
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    if cstr.len(vstr) > 0 {
                        val display: mut ref u8 = vstr
                        if !bootstrap_mode {
                            display = builds.filter_c_diagnostics(vstr)
                        }
                        stdio.print("{s}", {display})
                    }
                    if test_mode {
                        val run_res_alt = os.run(test_output_alt)
                        if run_res_alt != 0 {
                            stdio.puts("Test binary failed.")
                            os.delete(c_file)
                            allocators.Arena.free(arena)
                            return 1
                        }
                        os.delete(test_output_alt)
                    }
                    if run_mode {
                        val run_res_alt: i32 = os.run(final_output_alt)
                        os.delete(c_file)
                        allocators.Arena.free(arena)
                        return run_res_alt
                    }
                    if !quiet {
                        stdio.print("Compiled (ALT): {s}\n", {final_output_alt})
                    }
                }
            }
            err _ => {
                stdio.print("error: {s} stage failed\n", {selected_compiler})
                os.delete(c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }

        if cstr.len(alt_win_compat) > 0 {
            os.delete(alt_win_compat)
        }
        os.delete(c_file)
        allocators.Arena.free(arena)
        return 0
    }

    val qbe_ir: mut ref u8 = c""
    val c_shim_source: mut ref u8 = c""

    if test_mode {
        val cg_out = codegen.gen_module_resolved_test(
            root_mod,
            release_mode,
            src_target,
            leak_check
        )
        qbe_ir = cg_out.qbe
        c_shim_source = cg_out.shim
    } else {
        val cg_out = codegen.gen_module_resolved(
            root_mod,
            release_mode,
            src_target,
            leak_check
        )
        qbe_ir = cg_out.qbe
        c_shim_source = cg_out.shim
    }

    if !quiet && !emit_qbe && !emit_ll {
        stdio.puts("[IV ]│ Module used-links collection")
    }

    if emit_qbe {
        if cstr.len(shim_output) > 0 && cstr.len(c_shim_source) > 0 {
            val shim_f = os.open(shim_output, c"w")
            if shim_f is some f {
                os.write(f, c_shim_source, cstr.len(c_shim_source) as i64)
                os.close(f)
            } else {
                stdio.print("error: could not write C shim to '{s}'\n", {shim_output})
                @free(qbe_ir)
                allocators.Arena.free(arena)
                return 1
            }
        }
        stdio.puts(str.from_cstr(qbe_ir))
        @free(qbe_ir)
        allocators.Arena.free(arena)
        return 0
    }

    val binary_name: mut ref u8 = c""

    if cstr.cmp(output_name, c"") == 0 {
        binary_name = path.get_name_without_ext_cstr(arena, input)
    } else {
        binary_name = output_name
    }

    val qbe_file = builds.get_unique_tmp_path(c"spectre_output.ssa")
    val asm_file = builds.get_unique_tmp_path(c"spectre_output.s")
    val qbe_f = os.open(qbe_file, c"w")

    if qbe_f is some f {
        os.write(f, qbe_ir, cstr.len(qbe_ir) as i64)
        os.close(f)
        @free(qbe_ir)
    } else {
        stdio.puts("\nerror: could not write QBE IR")
        allocators.Arena.free(arena)
        return 1
    }

    val qbe_target_name: mut ref u8 = c""
    if explicit_target {
        qbe_target_name = builds.target_qbe_name(target_platform, target_arch)
    } elif cstr.cmp(host_platform, c"windows") == 0 {
        qbe_target_name = builds.target_qbe_name(host_platform, host_arch)
    }
    val qbe_cmd: mut ref u8 = c""
    if cstr.cmp(qbe_target_name, c"") != 0 {
        qbe_cmd = @fmtalloc(
            "qbe -t {s} -o {s} {s} 2>&1",
            {qbe_target_name, asm_file, qbe_file}
        )
    } else {
        qbe_cmd = @fmtalloc("qbe -o {s} {s} 2>&1", {asm_file, qbe_file})
    }
    val qbe_res = os.exec(qbe_cmd)
    if show_cmd {
        stdio.print("{s}\n", {qbe_cmd})
    }
    match qbe_res {
        ok v => {
            val vstr: ref u8 = ostr.as_cstr(v)
            if cstr.len(vstr) > 0 {
                stdio.print("{s}", {vstr})
            }
            if cstr.starts_with(vstr, c"qbe:") {
                stdio.puts("error: qbe stage failed")
                os.delete(qbe_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        err _ => {
            stdio.puts("\nerror: failed to run qbe")
            os.delete(qbe_file)
            allocators.Arena.free(arena)
            return 1
        }
    }

    if emit_asm {
        val asm_size_opt = fs.file_size_cstr(asm_file)
        val asm_arena_cap: mut i64 = 4096
        if asm_size_opt is some sz {
            if ((sz as i64) > asm_arena_cap) {
                asm_arena_cap = sz as i64
            }
        } else {
            stdio.puts("error: could not read assembly output")
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }
        val asm_arena: allocators.Arena = allocators.Arena.new((asm_arena_cap + 8) as usize)?
        val asm_opt = fs.read_all_cstr[allocators.Arena](asm_arena, asm_file)
        if asm_opt is some asm_content {
            stdio.puts(str.from_cstr(asm_content as ref u8))
        } else {
            stdio.puts("error: could not read assembly output")
        }
        allocators.Arena.free(asm_arena)
        os.delete(qbe_file)
        os.delete(asm_file)
        allocators.Arena.free(arena)
        return 0
    }

    if cross_target || freestanding_runtime {
        val binary_name_x: mut ref u8 = c""
        if cstr.cmp(output_name, c"") == 0 {
            binary_name_x = path.get_name_without_ext_cstr(arena, input)
        } else {
            binary_name_x = output_name
        }
        val final_output_x: mut ref u8 = c""
        if cstr.cmp(output_name, c"") != 0 {
            final_output_x = binary_name_x
        } else {
            fs.mkdir_path_cstr(c"./s-out")
            if cstr.cmp(target_platform, c"windows") == 0
            && !compile_obj
            && !build_dll {
                final_output_x = @fmtalloc("./s-out/{s}.exe", {binary_name_x})
            } else {
                final_output_x = @fmtalloc("./s-out/{s}", {binary_name_x})
            }
        }
        if compile_obj {
            final_output_x = @fmtalloc(
                "{s}{s}",
                {final_output_x, builds.target_object_ext(target_platform)}
            )
        } elif build_dll {
            if cstr.cmp(target_platform, c"windows") == 0 {
                final_output_x = @fmtalloc("{s}.dll", {final_output_x})
            } else {
                final_output_x = @fmtalloc("{s}.so", {final_output_x})
            }
        }
        if test_mode {
            final_output_x = builds.get_unique_tmp_path(c"spectre_test_bin")
        }

        val static_link_x: mut ref u8 = c""
        val strip_link_x: mut ref u8 = c""
        if !compile_obj && !build_dll {
            static_link_x = builds.static_link_flag(target_platform, dynamic_linking)
            strip_link_x = builds.strip_link_flag(release_mode)
        }

        val links_result_x = module.collect_used_links(
            root_mod,
            exe_dir,
            cstr.cmp(static_link_x, c"") != 0
        )
        val links_x: mut list[ref u8] = mem.new[ref u8]()
        match links_result_x {
            ok resolved => {
                links_x = resolved
            }
            err e => {
                stdio.print("error: {s}\n", {e})
                os.delete(qbe_file)
                os.delete(asm_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        if !compile_obj && !freestanding_runtime {
            builds.append_debug_runtime_links(
                links_x,
                exe_dir,
                quiet,
                release_mode,
                c"clang",
                target_platform
            )
        }

        val triple_x: ref u8 = builds.target_triple(target_platform, target_arch)
        val xwin_inc_x: mut ref u8 = c""
        if cstr.len(xwin_root) > 0 {
            xwin_inc_x = builds.xwin_include_flags(xwin_root, target_arch)
        }
        val asm_obj_name: mut ref u8 = c"spectre_output.o"
        if cstr.cmp(target_platform, c"windows") == 0 {
            asm_obj_name = c"spectre_output.obj"
        }
        val asm_obj_x: mut ref u8 = final_output_x
        if !compile_obj {
            asm_obj_x = builds.get_unique_tmp_path(asm_obj_name)
        }
        val asm_cc_cmd: ref u8 = @fmtalloc(
            "clang --target={s} -c {s} -o {s} 2>&1",
            {triple_x, asm_file, asm_obj_x}
        )
        if show_cmd {
            stdio.print("{s}\n", {asm_cc_cmd})
        }
        val asm_cc_res = os.exec(asm_cc_cmd)
        match asm_cc_res {
            ok v => {
                val vstr: ref u8 = ostr.as_cstr(v)
                val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                if ostr.contains(v, err_mark) {
                    stdio.print("{s}", {vstr})
                    stdio.puts("error: target assembly failed")
                    os.delete(qbe_file)
                    os.delete(asm_file)
                    os.delete(asm_obj_x)
                    allocators.Arena.free(arena)
                    return 1
                }
            }
            err _ => {
                stdio.puts("error: failed to run clang for target assembly")
                os.delete(qbe_file)
                os.delete(asm_file)
                allocators.Arena.free(arena)
                return 1
            }
        }

        if compile_obj {
            os.delete(qbe_file)
            os.delete(asm_file)
            if !quiet {
                stdio.print("Compiled (target object): {s}\n", {final_output_x})
            }
            allocators.Arena.free(arena)
            return 0
        }

        val runtime_obj_x: mut ref u8 = c""
        val start_obj_x: mut ref u8 = c""
        val runtime_obj_cached: mut bool = false
        val start_obj_cached: mut bool = false
        val sys_rt_obj_x: mut ref u8 = c""
        val sys_rt_cached: mut bool = false
        val skip_sys_runtime: bool = cstr.ends_with(input, c"runtime/sys.sx")
        if freestanding_runtime {
            val runtime_c: ref u8 = builds.freestanding_runtime_source(exe_dir)
            val runtime_obj_name: mut ref u8 = c"spectre_runtime.o"
            if cstr.cmp(target_platform, c"windows") == 0 {
                runtime_obj_name = c"spectre_runtime.obj"
            }
            val rt_source_size: mut i64 = 0
            val rt_size_opt = fs.file_size_cstr(runtime_c)
            match rt_size_opt {
                some sz => {
                    rt_source_size = sz as i64
                }
                none => {
                    rt_source_size = 0
                }
            }
            val cached_name: ref u8 = @fmtalloc(
                "{s}_{lld}_fs2",
                {runtime_obj_name, rt_source_size}
            )
            runtime_obj_x = builds.freestanding_cache_path(
                target_platform,
                target_arch,
                cached_name
            )
            if os.exists(runtime_obj_x) {
                runtime_obj_cached = true
            } else {
                val rt_flags: ref u8 = builds.freestanding_c_flags()
                val rt_arch_flags: ref u8 = builds.freestanding_arch_flags(target_arch)
                val rt_tmp: ref u8 = @fmtalloc("{s}.tmp", {runtime_obj_x})
                val rt_cmd: ref u8 = @fmtalloc(
                    "clang --target={s} {s}{s} -c {s} -o {s} 2>&1",
                    {triple_x, rt_flags, rt_arch_flags, runtime_c, rt_tmp}
                )
                if show_cmd {
                    stdio.print("{s}\n", {rt_cmd})
                }
                val rt_res = os.exec(rt_cmd)
                val rt_ok: mut bool = true
                match rt_res {
                    ok v => {
                        val vstr: ref u8 = ostr.as_cstr(v)
                        if cstr.len(vstr) > 0 {
                            stdio.print("{s}", {vstr})
                        }
                        val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                        if ostr.contains(v, err_mark) || !os.exists(rt_tmp) {
                            rt_ok = false
                        }
                    }
                    err _ => {
                        rt_ok = false
                    }
                }
                if !rt_ok {
                    stdio.print(
                        "error: freestanding runtime compilation failed for '{s}'\n",
                        {runtime_c}
                    )
                    os.delete(rt_tmp)
                    os.delete(qbe_file)
                    os.delete(asm_file)
                    os.delete(asm_obj_x)
                    allocators.Arena.free(arena)
                    return 1
                }
                if os.exists(runtime_obj_x) {
                    os.delete(runtime_obj_x)
                }
                fs.rename_path_cstr(rt_tmp, runtime_obj_x)
                runtime_obj_cached = true
            }

            val start_source: ref u8 = builds.freestanding_start_source(
                exe_dir,
                target_platform,
                target_arch
            )
            if cstr.len(start_source) > 0 {
                val start_size: mut i64 = 0
                val start_size_opt = fs.file_size_cstr(start_source)
                match start_size_opt {
                    some sz => {
                        start_size = sz as i64
                    }
                    none => {
                        start_size = 0
                    }
                }
                val start_cached_name: ref u8 = @fmtalloc(
                    "spectre_start_{lld}.o",
                    {start_size}
                )
                start_obj_x = builds.freestanding_cache_path(
                    target_platform,
                    target_arch,
                    start_cached_name
                )
                if os.exists(start_obj_x) {
                    start_obj_cached = true
                } else {
                    val start_tmp: ref u8 = @fmtalloc("{s}.tmp", {start_obj_x})
                    val start_cmd: ref u8 = @fmtalloc(
                        "clang --target={s} -c {s} -o {s} 2>&1",
                        {triple_x, start_source, start_tmp}
                    )
                    if show_cmd {
                        stdio.print("{s}\n", {start_cmd})
                    }
                    val start_res = os.exec(start_cmd)
                    val start_ok: mut bool = true
                    match start_res {
                        ok v => {
                            val vstr: ref u8 = ostr.as_cstr(v)
                            if cstr.len(vstr) > 0 {
                                stdio.print("{s}", {vstr})
                            }
                            val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                            if ostr.contains(v, err_mark) || !os.exists(start_tmp) {
                                start_ok = false
                            }
                        }
                        err _ => {
                            start_ok = false
                        }
                    }
                    if !start_ok {
                        stdio.print(
                            "error: freestanding entry compilation failed for '{s}'\n",
                            {start_source}
                        )
                        os.delete(start_tmp)
                        if !runtime_obj_cached {
                            os.delete(runtime_obj_x)
                        }
                        os.delete(qbe_file)
                        os.delete(asm_file)
                        os.delete(asm_obj_x)
                        allocators.Arena.free(arena)
                        return 1
                    }
                    if os.exists(start_obj_x) {
                        os.delete(start_obj_x)
                    }
                    fs.rename_path_cstr(start_tmp, start_obj_x)
                    start_obj_cached = true
                }
            }

            val sys_src: ref u8 = path.join_cstr(
                exe_dir,
                c"spectrelib/runtime/sys.sx"
            )
            if os.exists(sys_src) && !skip_sys_runtime {
                val sys_size: mut i64 = 0
                val sys_size_opt = fs.file_size_cstr(sys_src)
                match sys_size_opt {
                    some sz => {
                        sys_size = sz as i64
                    }
                    none => {
                        sys_size = 0
                    }
                }
                val sys_ext: mut ref u8 = c".o"
                if cstr.cmp(target_platform, c"windows") == 0 {
                    sys_ext = c".obj"
                }
                val sys_base: ref u8 = builds.freestanding_cache_path(
                    target_platform,
                    target_arch,
                    @fmtalloc("spectre_sys_runtime_fs_{lld}", {sys_size})
                )
                sys_rt_obj_x = @fmtalloc("{s}{s}", {sys_base, sys_ext})
                if os.exists(sys_rt_obj_x) {
                    sys_rt_cached = true
                } else {
                    val self_exe: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
                    val sys_cmd: ref u8 = @fmtalloc(
                        "{s} {s} -c -runtime:freestanding -target:{s}.{s} -o {s} 2>&1",
                        {self_exe, sys_src, target_platform, target_arch, sys_base}
                    )
                    if show_cmd {
                        stdio.print("{s}\n", {sys_cmd})
                    }
                    val sys_res = os.exec(sys_cmd)
                    val sys_ok: mut bool = true
                    match sys_res {
                        ok v => {
                            val vstr: ref u8 = ostr.as_cstr(v)
                            if cstr.len(vstr) > 0 {
                                stdio.print("{s}", {vstr})
                            }
                            val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                            if ostr.contains(v, err_mark) || !os.exists(sys_rt_obj_x) {
                                sys_ok = false
                            }
                        }
                        err _ => {
                            sys_ok = false
                        }
                    }
                    if !sys_ok {
                        stdio.print(
                            "error: Spectre runtime compilation failed for '{s}'\n",
                            {sys_src}
                        )
                        allocators.Arena.free(arena)
                        return 1
                    }
                    sys_rt_cached = true
                }
            }
        }

        if cstr.len(rt_lib_spec) > 0 {
            runtime_obj_x = rt_lib_spec
            runtime_obj_cached = true
        }

        val shim_obj_x: mut ref u8 = c""
        if cstr.len(c_shim_source) > 0 {
            val shim_c_file_x: ref u8 = builds.get_unique_tmp_path(c"spectre_c_shim.c")
            val shim_f_x = os.open(shim_c_file_x, c"w")
            if shim_f_x is some f {
                os.write(f, c_shim_source, cstr.len(c_shim_source) as i64)
                os.close(f)
            } else {
                stdio.puts("error: could not write C shim")
                os.delete(qbe_file)
                os.delete(asm_file)
                os.delete(asm_obj_x)
                allocators.Arena.free(arena)
                return 1
            }
            val include_flags_x: mut ref u8 = c" -I."
            for inc_path in inc_paths {
                include_flags_x = @fmtalloc("{s} -I{s}", {include_flags_x, inc_path})
            }
            if cstr.len(xwin_root) > 0 && !freestanding_runtime {
                include_flags_x = @fmtalloc(
                    "{s} {s}",
                    {include_flags_x, xwin_inc_x}
                )
            }
            val shim_obj_name: mut ref u8 = c"spectre_c_shim.o"
            if cstr.cmp(target_platform, c"windows") == 0 {
                shim_obj_name = c"spectre_c_shim.obj"
            }
            shim_obj_x = builds.get_unique_tmp_path(shim_obj_name)
            val shim_extra_flags: mut ref u8 = c""
            if freestanding_runtime {
                shim_extra_flags = @fmtalloc(
                    " -DSX_FREESTANDING {s}",
                    {builds.freestanding_c_flags()}
                )
            }
            val shim_cmd_x: ref u8 = @fmtalloc(
                "clang --target={s} -std=c99 -Wno-error=int-conversion{s} -c -o {s} {s}{s} 2>&1",
                {triple_x, shim_extra_flags, shim_obj_x, shim_c_file_x, include_flags_x}
            )
            if show_cmd {
                stdio.print("{s}\n", {shim_cmd_x})
            }
            val shim_res_x = os.exec(shim_cmd_x)
            match shim_res_x {
                ok v => {
                    val vstr: ref u8 = ostr.as_cstr(v)
                    val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                    if ostr.contains(v, err_mark) {
                        stdio.print("{s}", {vstr})
                        stdio.puts("error: target C shim compilation failed")
                        os.delete(qbe_file)
                        os.delete(asm_file)
                        os.delete(asm_obj_x)
                        os.delete(shim_c_file_x)
                        allocators.Arena.free(arena)
                        return 1
                    }
                }
                err _ => {
                    stdio.puts("error: failed to run clang for the C shim")
                    os.delete(qbe_file)
                    os.delete(asm_file)
                    os.delete(asm_obj_x)
                    os.delete(shim_c_file_x)
                    allocators.Arena.free(arena)
                    return 1
                }
            }
            os.delete(shim_c_file_x)
        }

        val win_compat_obj: mut ref u8 = c""
        if cstr.cmp(target_platform, c"windows") == 0 && !freestanding_runtime {
            val compat_c: ref u8 = path.join_cstr(
                exe_dir,
                c"spectrelib/csources/hosted_windows_compat.c"
            )
            if os.exists(compat_c) {
                val compat_obj: ref u8 = builds.get_unique_tmp_path(c"spectre_hosted_win_compat.obj")
                val compat_cmd: ref u8 = @fmtalloc(
                    "clang --target={s} -std=c99 -c {s} -o {s}{s} 2>&1",
                    {triple_x, compat_c, compat_obj, xwin_inc_x}
                )
                if show_cmd {
                    stdio.print("{s}\n", {compat_cmd})
                }
                val compat_res = os.exec(compat_cmd)
                match compat_res {
                    ok v => {
                        val vstr: ref u8 = ostr.as_cstr(v)
                        val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error:")
                        if ostr.contains(v, err_mark) {
                            stdio.print("{s}", {vstr})
                            os.delete(compat_obj)
                        } else {
                            win_compat_obj = compat_obj
                        }
                    }
                    err _ => { }
                }
            }
        }

        val link_cmd_x: mut ref u8 = c""
        if cstr.cmp(target_platform, c"windows") == 0 {
            val win_inputs: mut ref u8 = c""
            for link_flag in links_x {
                if cstr.starts_with(link_flag, c"-l") {
                    win_inputs = @fmtalloc(
                        "{s} {s}",
                        {win_inputs, builds.translate_lld_link_flag(link_flag)}
                    )
                } elif cstr.ends_with(link_flag, c".c") {
                    val extra_obj: ref u8 = builds.get_unique_tmp_path(c"spectre_link.obj")
                    val extra_cmd: ref u8 = @fmtalloc(
                        "clang --target={s} -std=c99 -Wno-error=int-conversion -c {s} -o {s}{s} 2>&1",
                        {triple_x, link_flag, extra_obj, xwin_inc_x}
                    )
                    if show_cmd {
                        stdio.print("{s}\n", {extra_cmd})
                    }
                    val extra_res = os.exec(extra_cmd)
                    val extra_ok: mut bool = true
                    match extra_res {
                        ok v => {
                            val vstr: ref u8 = ostr.as_cstr(v)
                            val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error")
                            if ostr.contains(v, err_mark) || !os.exists(extra_obj) {
                                stdio.print("{s}", {vstr})
                                extra_ok = false
                            }
                        }
                        err _ => {
                            extra_ok = false
                        }
                    }
                    if !extra_ok {
                        stdio.print(
                            "error: target C compilation failed for '{s}'\n",
                            {link_flag}
                        )
                        os.delete(extra_obj)
                        os.delete(qbe_file)
                        os.delete(asm_file)
                        os.delete(asm_obj_x)
                        if cstr.len(shim_obj_x) > 0 {
                            os.delete(shim_obj_x)
                        }
                        allocators.Arena.free(arena)
                        return 1
                    }
                    win_inputs = @fmtalloc("{s} {s}", {win_inputs, extra_obj})
                } elif cstr.ends_with(link_flag, c".o") {
                    if !quiet {
                        stdio.print(
                            "warning: ignoring host object '{s}' for windows target; provide a target object or library instead\n",
                            {link_flag}
                        )
                    }
                } elif cstr.len(link_flag) > 0 {
                    win_inputs = @fmtalloc("{s} {s}", {win_inputs, link_flag})
                }
            }
            if cstr.len(shim_obj_x) > 0 {
                win_inputs = @fmtalloc("{s} {s}", {win_inputs, shim_obj_x})
            }
            if cstr.len(runtime_obj_x) > 0 {
                win_inputs = @fmtalloc("{s} {s}", {win_inputs, runtime_obj_x})
            }
            if cstr.len(sys_rt_obj_x) > 0 {
                win_inputs = @fmtalloc("{s} {s}", {win_inputs, sys_rt_obj_x})
            }
            if cstr.len(start_obj_x) > 0 {
                win_inputs = @fmtalloc("{s} {s}", {win_inputs, start_obj_x})
            }
            if cstr.len(win_compat_obj) > 0 {
                win_inputs = @fmtalloc("{s} {s}", {win_inputs, win_compat_obj})
            }
            val subsystem_x: mut ref u8 = c"/subsystem:console"
            if build_dll {
                subsystem_x = c"/dll"
            }
            val win_libs: mut ref u8 = c""
            val win_lib_paths: mut ref u8 = c""
            val entry_flag: mut ref u8 = c""
            if freestanding_runtime {
                win_libs = builds.freestanding_windows_import_flags(target_arch)
                if cstr.len(win_libs) == 0 {
                    win_libs = builds.freestanding_windows_import_libs()
                    win_lib_paths = builds.xwin_lib_path_flags(xwin_root, target_arch)
                }
                entry_flag = c"/nodefaultlib /entry:mainCRTStartup /opt:ref"
            } else {
                win_libs = builds.xwin_default_libs()
                val win_env_libs: ref u8 = os.getenv(c"SPECTRE_WIN_LIBS")
                if win_env_libs != none {
                    win_libs = win_env_libs
                }
                win_lib_paths = builds.xwin_lib_path_flags(
                    xwin_root,
                    target_arch
                )
            }
            link_cmd_x = @fmtalloc(
                "lld-link /nologo /out:{s} {s} {s} {s} {s} {s} {s} 2>&1",
                {
                    final_output_x,
                    subsystem_x,
                    entry_flag,
                    win_lib_paths,
                    asm_obj_x,
                    win_inputs,
                    win_libs
                }
            )
        } else {
            val link_flags_x: mut ref u8 = c""
            if cstr.cmp(static_link_x, c"") != 0 {
                link_flags_x = @fmtalloc(" {s}", {static_link_x})
            }
            if cstr.cmp(strip_link_x, c"") != 0 {
                link_flags_x = @fmtalloc("{s} {s}", {link_flags_x, strip_link_x})
            }
            for link_flag in links_x {
                if cstr.len(link_flag) > 0 {
                    link_flags_x = @fmtalloc("{s} {s}", {link_flags_x, link_flag})
                }
            }
            if cstr.len(shim_obj_x) > 0 {
                link_flags_x = @fmtalloc("{s} {s}", {link_flags_x, shim_obj_x})
            }
            if freestanding_runtime {
                val fs_link_flags: mut ref u8 = c" -nostdlib -static -Wl,--gc-sections"
                if cstr.len(runtime_obj_x) > 0 {
                    fs_link_flags = @fmtalloc("{s} {s}", {fs_link_flags, runtime_obj_x})
                }
                if cstr.len(sys_rt_obj_x) > 0 {
                    fs_link_flags = @fmtalloc("{s} {s}", {fs_link_flags, sys_rt_obj_x})
                }
                if cstr.len(start_obj_x) > 0 {
                    fs_link_flags = @fmtalloc("{s} {s}", {fs_link_flags, start_obj_x})
                }
                link_flags_x = @fmtalloc("{s}{s}", {fs_link_flags, link_flags_x})
            }
            link_cmd_x = @fmtalloc(
                "clang --target={s} -fuse-ld=lld {s} -o {s}{s} 2>&1",
                {triple_x, asm_obj_x, final_output_x, link_flags_x}
            )
        }

        if show_cmd {
            stdio.print("{s}\n", {link_cmd_x})
        }
        val link_res_x = os.exec(link_cmd_x)
        val link_ok: mut bool = true
        match link_res_x {
            ok v => {
                val vstr: ref u8 = ostr.as_cstr(v)
                if cstr.len(vstr) > 0 {
                    stdio.print("{s}", {builds.filter_c_diagnostics(vstr)})
                }
                val err_mark = ostr.from_cstr[allocators.Arena](arena, c"error")
                if ostr.contains(v, err_mark) {
                    link_ok = false
                }
            }
            err _ => {
                link_ok = false
            }
        }

        os.delete(qbe_file)
        os.delete(asm_file)
        os.delete(asm_obj_x)
        if cstr.len(shim_obj_x) > 0 {
            os.delete(shim_obj_x)
        }
        if cstr.len(runtime_obj_x) > 0 && !runtime_obj_cached {
            os.delete(runtime_obj_x)
        }
        if cstr.len(start_obj_x) > 0 && !start_obj_cached {
            os.delete(start_obj_x)
        }
        if cstr.len(win_compat_obj) > 0 {
            os.delete(win_compat_obj)
        }
        if !link_ok {
            stdio.puts("error: target link failed")
            allocators.Arena.free(arena)
            return 1
        }
        if run_mode {
            val run_res: i32 = os.run(final_output_x)
            allocators.Arena.free(arena)
            return run_res
        }
        if test_mode {
            val test_res: i32 = os.run(final_output_x)
            os.delete(final_output_x)
            allocators.Arena.free(arena)
            return test_res
        }
        if !quiet {
            stdio.print("Compiled ({s}.{s}): {s}\n", {
                    target_platform,
                    target_arch,
                    final_output_x
                })
        }
        allocators.Arena.free(arena)
        return 0
    }

    val platform: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    val static_link: mut ref u8 = c""
    val strip_link: mut ref u8 = c""
    if !compile_obj && !build_dll {
        static_link = builds.static_link_flag(platform, dynamic_linking)
        strip_link = builds.strip_link_flag(release_mode)
    }

    val links_result = module.collect_used_links(
        root_mod,
        exe_dir,
        cstr.cmp(static_link, c"") != 0
    )
    val links: mut list[ref u8] = mem.new[ref u8]()
    match links_result {
        ok resolved => {
            links = resolved
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }
    }
    if !compile_obj && !freestanding_runtime {
        builds.append_debug_runtime_links(links, exe_dir, quiet, release_mode, c"cc", platform)
    }

    val output_specified: bool = cstr.cmp(output_name, c"") != 0
    val cc_cmd: mut ref u8 = c""
    val success_msg: mut ref u8 = c""
    val exit_code: mut i32 = 0
    val link_flags: mut ref u8 = c""
    val run_output: mut ref u8 = c""

    val shim_c_file: mut ref u8 = c""
    val shim_obj: mut ref u8 = c""

    if cstr.len(c_shim_source) > 0 {
        shim_c_file = builds.get_unique_tmp_path(c"spectre_c_shim.c")
        val shim_f = os.open(shim_c_file, c"w")
        if shim_f is some f {
            os.write(f, c_shim_source, cstr.len(c_shim_source) as i64)
            os.close(f)
        } else {
            stdio.puts("error: could not write C shim")
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }

        val include_flags: mut ref u8 = c" -I."
        for inc_path in inc_paths {
            include_flags = @fmtalloc("{s} -I{s}", {include_flags, inc_path})
        }

        shim_obj = builds.get_unique_tmp_path(c"spectre_c_shim.o")
        val shim_cmd = @fmtalloc(
            "cc -std=c99 -Wno-error=int-conversion -c -o {s} {s}{s} 2>&1",
            {shim_obj, shim_c_file, include_flags}
        )
        if show_cmd {
            stdio.print("{s}\n", {shim_cmd})
        }
        val shim_res = os.exec(shim_cmd)
        match shim_res {
            ok v => {
                val vstr: ref u8 = ostr.as_cstr(v)
                if cstr.len(vstr) > 0 {
                    stdio.print("{s}", {vstr})
                }
                val shim_error_text = ostr.from_cstr[allocators.Arena](arena, c"error:")
                if ostr.contains(v, shim_error_text) {
                    stdio.puts("error: C shim compilation failed")
                    os.delete(qbe_file)
                    os.delete(asm_file)
                    os.delete(shim_c_file)
                    allocators.Arena.free(arena)
                    return 1
                }
            }
            err _ => {
                stdio.puts("error: failed to run C compiler for C shim")
                os.delete(qbe_file)
                os.delete(asm_file)
                os.delete(shim_c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
    }

    if cstr.cmp(static_link, c"") != 0 {
        link_flags = @fmtalloc(" {s}", {static_link})
    }
    if cstr.cmp(strip_link, c"") != 0 {
        link_flags = @fmtalloc("{s} {s}", {link_flags, strip_link})
    }
    for link_flag in links {
        link_flags = @fmtalloc("{s} {s}", {link_flags, link_flag})
    }
    if compile_obj {
        link_flags = c""
    }

    if cstr.len(shim_obj) > 0 && !compile_obj {
        link_flags = @fmtalloc("{s} {s}", {link_flags, shim_obj})
    }

    val cc_flags: mut ref u8 = c""
    if !release_mode {
        cc_flags = c"-g"
    }
    val output_ext: mut ref u8 = c""

    if compile_obj {
        cc_flags = @fmtalloc("{s} -c", {cc_flags})
        if cstr.cmp(platform, c"windows") == 0 {
            output_ext = c".obj"
        } else {
            output_ext = c".o"
        }
    } elif build_dll {
        if cstr.cmp(platform, c"macos") == 0 {
            cc_flags = @fmtalloc("{s} -dynamiclib", {cc_flags})
            output_ext = c".dylib"
        } elif cstr.cmp(platform, c"windows") == 0 {
            cc_flags = @fmtalloc("{s} -shared", {cc_flags})
            output_ext = c".dll"
        } else {
            cc_flags = @fmtalloc("{s} -shared", {cc_flags})
            output_ext = c".so"
        }
    } else {
        output_ext = c""
    }

    if test_mode {
        val test_bin: ref u8 = builds.get_unique_tmp_path(c"spectre_test_bin")
        cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {test_bin, asm_file, link_flags})
        val cc_res2 = os.exec(cc_cmd)
        match cc_res2 {
            ok _ => {
                val run_res = os.run(test_bin)
                if run_res != 0 {
                    if !quiet && !emit_qbe {
                        stdio.print("warning: test binary exited with: {s}\n", {"non-zero exit"})
                    }
                    exit_code = 1
                }
            }
            err _ => {
                stdio.puts("error: cc compilation failed")
                exit_code = 1
            }
        }
        os.delete(qbe_file)
        os.delete(asm_file)
        if cstr.len(shim_c_file) > 0 {
            os.delete(shim_c_file)
        }
        if cstr.len(shim_obj) > 0 {
            os.delete(shim_obj)
        }
        allocators.Arena.free(arena)
        return exit_code
    }

    if output_specified {
        val final_output: mut ref u8 = binary_name
        if cstr.cmp(output_ext, c"") != 0 {
            final_output = @fmtalloc("{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if cstr.cmp(cc_flags, c"") == 0 {
            cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmtalloc(
                "cc {s} -o {s} {s}{s}",
                {cc_flags, final_output, asm_file, link_flags}
            )
        }
        success_msg = @fmtalloc("Compiled: {s}\n", {final_output})
    } else {
        fs.mkdir_path_cstr(c"./s-out")
        val final_output: mut ref u8 = @fmtalloc("./s-out/{s}", {binary_name})
        if cstr.cmp(output_ext, c"") != 0 {
            final_output = @fmtalloc("./s-out/{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if cstr.cmp(cc_flags, c"") == 0 {
            cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmtalloc(
                "cc {s} -o {s} {s}{s}",
                {cc_flags, final_output, asm_file, link_flags}
            )
        }
        success_msg = @fmtalloc("Compiled: {s}\n", {final_output})
    }

    if show_cmd {
        stdio.print("{s}\n", {cc_cmd})
    }

    val cc_res = os.exec(@fmtalloc("{s} {s}", {cc_cmd, c" 2>&1"}))
    match cc_res {
        ok v => {
            val error_text = ostr.from_cstr[allocators.Arena](arena, c"error")
            val has_error: bool = ostr.contains(v, error_text)
            if has_error {
                stdio.print("{s}\n", {ostr.as_cstr(v)})
                stdio.puts("linking failed.")
                exit_code = 1
            } else {
                if !quiet && !emit_qbe {
                    stdio.print("{s}", {success_msg})
                }
                if run_mode {
                    exit_code = os.run(run_output)
                }
            }
        }
        err _ => {
            stdio.puts("\nerror: cc compilation failed")
        }
    }

    os.delete(qbe_file)
    os.delete(asm_file)
    if cstr.len(shim_c_file) > 0 {
        os.delete(shim_c_file)
    }
    if cstr.len(shim_obj) > 0 {
        os.delete(shim_obj)
    }
    allocators.Arena.free(arena)

    return exit_code
}
