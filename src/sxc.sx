/// The Spectre Compiler
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val fs          = use("std/fs")
val mem         = use("meta/mem.sx")
val string      = use("std/string")
val stdio       = use("std/stdio")
val os          = use("std/os")
val allocators  = use("std/allocators")
val path        = use("std/path")
val reflection  = use("std/reflection")
val parser      = use("ast/parser.sx")
val ast_printer = use("ast/ast_printer.sx")
val sema        = use("sema/sema.sx")
val codegen     = use("codegen/codegen.sx")
val alt_codegen = use("codegen/alt_codegen.sx")
val module      = use("module/module.sx")
val meta        = use("meta/meta.sx")
val defines     = use("meta/defines.sx")
val commands    = use("meta/commands.sx")
val docs        = use("meta/docs.sx")
val formatter   = use("meta/fmt.sx")
val critic      = use("meta/critic.sx")
val c_translate = use("translate/c_translate.sx")
val builds      = use("meta/builds.sx")

when windows {
    extern (C, header) fn SetConsoleOutputCP(codepage_id: u32) bool = "SetConsoleOutputCP"
}

pub fn main() i32 = trust {
    val arena: mut allocators.Arena = allocators.Arena.new(65536 as usize)?
    val frontend_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
        67108864 as usize
    )?
    defer {
        allocators.ScopedArena.free(frontend_arena)
    }
    mem.init()
    defer {
        mem.close()
    }
    val args = os.get_args()
    val argc: i64 = @len(args) as i64
    val exe_path: mut ref u8 = "./spectre"
    val exe_opt = @get(args, 0)

    when windows {
        SetConsoleOutputCP(65001 as u32)
    }

    if exe_opt is some v {
        exe_path = v as ref u8
    }

    val quiet: mut bool = true
    val run_mode: mut bool = false

    if argc < 2 {
        stdio.puts("error: no input file provided\n")
        meta.print_usage()
        allocators.Arena.free(arena)
        return 1
    }

    val input_arg_i: mut i64 = 1
    for {
        val pre_opt = @get(args, input_arg_i)
        if pre_opt is some pre_val {
            val pre_arg: ref u8 = pre_val as ref u8
            if string.raw_cmp(pre_arg, "-d") == 0 {
                val spec_i: i64 = input_arg_i + 1
                val spec_opt = @get(args, spec_i)
                if spec_opt is some spec_val {
                    val def_spec: ref u8 = spec_val as ref u8
                    if !defines.add_spec(def_spec) {
                        stdio.print(
                            "error: invalid define '{s}', expected NAME=VALUE\n",
                            {def_spec}
                        )
                        allocators.Arena.free(arena)
                        return 1
                    }
                    input_arg_i = spec_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_starts_with(pre_arg, "-d:") {
                val def_spec: ref u8 = string.substr(pre_arg, 3, string.len_raw(pre_arg) - 3)
                if !defines.add_spec(def_spec) {
                    stdio.print("error: invalid define '{s}', expected -d:NAME=VALUE\n", {pre_arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                input_arg_i++
            } else {
                break
            }
        } else {
            break
        }
    }
    val input_opt = @get(args, input_arg_i)
    val input: mut ref u8 = ""
    if input_opt is some a {
        input = a as ref u8
    } else {
        stdio.puts("error: no input file")
        allocators.Arena.free(arena)
        return 1
    }

    if string.raw_cmp(input, "run") == 0 {
        run_mode = true
        input_arg_i++
        val run_input_opt = @get(args, input_arg_i)
        if run_input_opt is some a {
            input = a as ref u8
        } else {
            stdio.puts("error: run requires an input file\n")
            meta.print_usage()
            allocators.Arena.free(arena)
            return 1
        }
    }

    val flag_first_translate_c: bool = string.raw_cmp(input, "-translate-c") == 0

    if string.raw_cmp(input, "-h") == 0 || string.raw_cmp(input, "-help") == 0 {
        meta.print_usage()
        allocators.Arena.free(arena)
        return 0
    }

    if string.raw_cmp(input, "-v") == 0 || string.raw_cmp(input, "-version") == 0 {
        meta.print_version()
        allocators.Arena.free(arena)
        return 0
    }

    if string.raw_cmp(input, "help") == 0 {
        val topic: mut ref u8 = ""
        val topic_opt = @get(args, 2)
        if topic_opt is some t {
            topic = t as ref u8
        }
        val code: i32 = meta.print_help(topic)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "doctor") == 0 {
        val code: i32 = commands.cmd_doctor()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "ref") == 0 {
        val code: i32 = commands.cmd_ref()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "init") == 0 {
        val name_arg: mut ref u8 = ""
        val name_opt = @get(args, 2)
        if name_opt is some v {
            name_arg = v as ref u8
        }
        val code: i32 = commands.cmd_init(name_arg)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "fmt") == 0 {
        val fmt_paths: mut list[ref u8] = mem.new[ref u8]()
        val fmt_stdout: mut bool = false
        val fmt_arg_i: mut i64 = 2
        for {
            val fmt_arg_opt = @get(args, fmt_arg_i)
            if fmt_arg_opt is some fv {
                val arg: ref u8 = fv as ref u8
                if string.raw_cmp(arg, "-h") == 0 || string.raw_cmp(arg, "-help") == 0 {
                    val code: i32 = meta.print_help("fmt")
                    allocators.Arena.free(arena)
                    return code
                } elif string.raw_cmp(arg, "-stdio") == 0 {
                    fmt_stdout = true
                } else {
                    @append(fmt_paths, arg)
                }
            } else {
                break
            }
            fmt_arg_i++
        }
        val code: i32 = formatter.cmd_fmt(fmt_paths, fmt_stdout)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "critic") == 0 {
        val critic_paths: mut list[ref u8] = mem.new[ref u8]()
        val critic_fix: mut bool = false
        val critic_arg_i: mut i64 = 2
        for {
            val critic_arg_opt = @get(args, critic_arg_i)
            if critic_arg_opt is some cv {
                val arg: ref u8 = cv as ref u8
                if string.raw_cmp(arg, "-h") == 0 || string.raw_cmp(arg, "-help") == 0 {
                    val code: i32 = meta.print_help("critic")
                    allocators.Arena.free(arena)
                    return code
                } elif string.raw_cmp(arg, "-fix") == 0 {
                    critic_fix = true
                } else {
                    @append(critic_paths, arg)
                }
            } else {
                break
            }
            critic_arg_i++
        }
        val code: i32 = critic.cmd_critic(critic_paths, critic_fix)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "build") == 0 {
        val config_name: mut ref u8 = "dev"
        val cfg_opt = @get(args, 2)
        if cfg_opt is some v {
            config_name = v as ref u8
        }
        val code: i32 = commands.cmd_build(config_name, exe_path)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "doc") == 0 {
        val target_arg: mut ref u8 = "."
        val md_mode: mut bool = false
        val output_arg: mut ref u8 = ""
        val read_arg: mut ref u8 = ""
        val doc_arg_i: mut i64 = 2
        for {
            val arg_opt = @get(args, doc_arg_i)
            if arg_opt is some dv {
                val arg: ref u8 = dv as ref u8
                if string.raw_cmp(arg, "-md") == 0 {
                    md_mode = true
                } elif string.raw_cmp(arg, "-h") == 0 || string.raw_cmp(arg, "-help") == 0 {
                    val code: i32 = meta.print_help("doc")
                    allocators.Arena.free(arena)
                    return code
                } elif string.raw_cmp(arg, "-o") == 0 || string.raw_cmp(arg, "-output") == 0 {
                    val next_i: i64 = doc_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some ov {
                        output_arg = ov as ref u8
                        doc_arg_i = next_i
                    } else {
                        stdio.puts("error: -o requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif string.raw_starts_with(arg, "-o:") {
                    val out_len: i64 = string.len_raw(arg) as i64 - 3
                    if out_len <= 0 {
                        stdio.puts("error: -o requires a directory")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    output_arg = string.substr(arg, 3, out_len)
                } elif string.raw_cmp(arg, "-read") == 0 {
                    val next_i: i64 = doc_arg_i + 1
                    val next_opt = @get(args, next_i)
                    if next_opt is some rv {
                        read_arg = rv as ref u8
                        doc_arg_i = next_i
                    } else {
                        stdio.puts("error: -read requires a markdown file")
                        allocators.Arena.free(arena)
                        return 1
                    }
                } elif string.raw_starts_with(arg, "-read:") {
                    val read_len: i64 = string.len_raw(arg) as i64 - 6
                    if read_len <= 0 {
                        stdio.puts("error: -read requires a markdown file")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    read_arg = string.substr(arg, 6, read_len)
                } elif string.raw_starts_with(arg, "-") {
                    stdio.print("error: unknown doc option '{s}'\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    target_arg = arg
                }
            } else {
                break
            }
            doc_arg_i++
        }
        val code: i32 = docs.cmd_doc(target_arg, md_mode, output_arg, read_arg)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "add") == 0 {
        val url_opt = @get(args, 2)
        if url_opt is some v {
            val code: i32 = commands.cmd_add(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: add requires a git repository URL")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if string.raw_cmp(input, "remove") == 0 {
        val dep_opt = @get(args, 2)
        if dep_opt is some v {
            val code: i32 = commands.cmd_remove(v as ref u8)
            allocators.Arena.free(arena)
            return code
        } else {
            stdio.puts("error: remove requires a dependency name")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if string.raw_cmp(input, "upgrade") == 0 {
        val dep_name: mut ref u8 = ""
        val upgrade_opt = @get(args, 2)
        if upgrade_opt is some v {
            dep_name = v as ref u8
        }
        val code: i32 = commands.cmd_upgrade(dep_name)
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "restore") == 0 {
        val code: i32 = commands.cmd_restore()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "graph") == 0 {
        val code: i32 = commands.cmd_graph()
        allocators.Arena.free(arena)
        return code
    }

    if string.raw_cmp(input, "clean") == 0 {
        val code: i32 = commands.cmd_clean()
        allocators.Arena.free(arena)
        return code
    }

    if flag_first_translate_c {
        val next_opt = @get(args, 2)
        if next_opt is some next_arg {
            input = next_arg as ref u8
        } else {
            stdio.puts("error: -translate-c requires an input .c or .h file")
            allocators.Arena.free(arena)
            return 1
        }
    }

    if fs.is_directory(input) {
        stdio.print("error: '{s}' is a directory, not a source file\n", {input})
        stdio.puts(
            "-> run 'spectre build <config>' in a project with sx.mod, or compile a file with 'spectre <file.sx> -o <output>'"
        )
        allocators.Arena.free(arena)
        return 1
    }

    val src_size_opt = fs.file_size(input)
    if src_size_opt is some _ {
    } else {
        stdio.print("error: could not read '{s}'\n", {input})
        allocators.Arena.free(arena)
        return 1
    }

    val emit_qbe: mut bool = false
    val emit_ll: mut bool = false
    val emit_asm: mut bool = false
    val emit_alt: mut bool = false
    val show_cmd: mut bool = false
    val test_mode: mut bool = false
    val leak_check: mut bool = false
    val release_mode: mut bool = false
    val native_mode: mut bool = false
    val unroll_mode: mut bool = false
    val simd_disabled: mut bool = false
    val output_name: mut ref u8 = ""
    val build_dll: mut bool = false
    val compile_obj: mut bool = false
    val dynamic_linking: mut bool = false
    val syntax_check: mut bool = false
    val print_ast: mut bool = false
    val use_alt: mut bool = false
    val alt_compiler: mut ref u8 = ""
    val translate_c_flag: mut bool = flag_first_translate_c
    val extra_includes: mut list[ref u8] = mem.new[ref u8]()
    val inc_paths: mut list[ref u8] = mem.new[ref u8]()
    val src_target: mut ref u8 = ""
    val shim_output: mut ref u8 = ""
    val bootstrap_mode: mut bool = false
    val arg_i: mut i64 = input_arg_i + 1

    if flag_first_translate_c {
        arg_i = input_arg_i + 2
    }

    // Note on this:
    //
    // spectre build passes -no-single-flags so project builds are not
    // affected by an sx.mod sitting next to the entry file.
    val no_single_flags: mut bool = false
    val scan_i: mut i64 = input_arg_i + 1
    for {
        if scan_i >= argc {
            break
        }
        val scan_opt = @get(args, scan_i)
        if scan_opt is some scan_arg {
            if string.raw_cmp(scan_arg as ref u8, "-no-single-flags") == 0 {
                no_single_flags = true
                break
            }
        }
        scan_i++
    }

    if !flag_first_translate_c {
        val mod_version: ref u8 = commands.load_version_for(input)
        if string.len_raw(mod_version) > 0 {
            defines.set("SPECTRE_MOD_VERSION", mod_version)
        }
    }

    val parse_args: mut list[ref u8] = args
    val parse_argc: mut i64 = argc
    if !flag_first_translate_c && !no_single_flags {
        val single_flags_result = commands.load_single_flags_for(input)
        match single_flags_result {
            ok single_flags => {
                if string.len_raw(single_flags) > 0 {
                    val extra_flags: list[ref u8] = commands.split_single_flags(single_flags)
                    val merged: mut list[ref u8] = mem.new[ref u8]()
                    val mi: mut i64 = 0
                    for {
                        if mi > input_arg_i {
                            break
                        }
                        val item = @get(args, mi)
                        if item is some v {
                            @append(merged, v as ref u8)
                        }
                        mi++
                    }
                    for extra in extra_flags {
                        @append(merged, extra)
                    }
                    mi = input_arg_i + 1
                    for {
                        if mi >= argc {
                            break
                        }
                        val item = @get(args, mi)
                        if item is some v {
                            @append(merged, v as ref u8)
                        }
                        mi++
                    }
                    parse_args = merged
                    parse_argc = @len(merged) as i64
                }
            }
            err e => {
                if string.len_raw(e) > 0 {
                    stdio.print("error: {s}\n", {e})
                }
                allocators.Arena.free(arena)
                return 1
            }
        }
    }

    when windows {
        use_alt = true
    }

    for {
        if (arg_i >= parse_argc) {
            break
        }
        val arg_opt = @get(parse_args, arg_i)
        if arg_opt is some arg_val {
            val arg: ref u8 = arg_val as ref u8

            if string.raw_cmp(arg, "-o") == 0 || string.raw_cmp(arg, "-output") == 0 {
                val next_i: i64 = arg_i + 1
                if (next_i < parse_argc) {
                    val next_opt = @get(parse_args, next_i)
                    if next_opt is some v {
                        output_name = v as ref u8
                    } else {
                        stdio.puts("error: -o requires a value")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -o requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_cmp(arg, "-d") == 0 {
                val next_i: i64 = arg_i + 1
                if next_i < parse_argc {
                    val next_opt = @get(parse_args, next_i)
                    if next_opt is some dv {
                        val def_spec: ref u8 = dv as ref u8
                        if !defines.add_spec(def_spec) {
                            stdio.print(
                                "error: invalid define '{s}', expected NAME=VALUE\n",
                                {def_spec}
                            )
                            allocators.Arena.free(arena)
                            return 1
                        }
                    } else {
                        stdio.puts("error: -d requires a NAME=VALUE argument")
                        allocators.Arena.free(arena)
                        return 1
                    }
                    arg_i = next_i + 1
                } else {
                    stdio.puts("error: -d requires a NAME=VALUE argument")
                    allocators.Arena.free(arena)
                    return 1
                }
            } elif string.raw_starts_with(arg, "-d:") {
                val def_spec: ref u8 = string.substr(arg, 3, string.len_raw(arg) - 3)
                if !defines.add_spec(def_spec) {
                    stdio.print("error: invalid define '{s}', expected -d:NAME=VALUE\n", {arg})
                    allocators.Arena.free(arena)
                    return 1
                }
                arg_i++
            } elif string.raw_cmp(arg, "-translate-c") == 0 {
                translate_c_flag = true
                arg_i++
            } elif string.raw_cmp(arg, "-emit-ssa") == 0 {
                emit_qbe = true
                arg_i++
            } elif string.raw_cmp(arg, "-emit-ll") == 0 {
                emit_ll = true
                arg_i++
            } elif string.raw_cmp(arg, "-emit-asm") == 0 {
                emit_asm = true
                arg_i++
            } elif string.raw_cmp(arg, "-emit-alt") == 0 {
                emit_alt = true
                arg_i++
            } elif string.raw_cmp(arg, "-show-cmd") == 0 {
                show_cmd = true
                arg_i++
            } elif string.raw_cmp(arg, "-test") == 0 {
                test_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "-leak-check") == 0 {
                leak_check = true
                arg_i++
            } elif string.raw_cmp(arg, "-loud") == 0 || string.raw_cmp(arg, "-l") == 0 {
                quiet = false
                arg_i++
            } elif string.raw_cmp(arg, "-release") == 0 {
                release_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "-native") == 0 {
                native_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "-unroll") == 0 {
                unroll_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "-no-simd") == 0 {
                simd_disabled = true
                arg_i++
            } elif string.raw_cmp(arg, "-dynamic") == 0 {
                dynamic_linking = true
                arg_i++
            } elif string.raw_cmp(arg, "-no-single-flags") == 0 {
                arg_i++
            } elif string.raw_cmp(arg, "-dll") == 0 {
                build_dll = true
                arg_i++
            } elif string.raw_cmp(arg, "-c") == 0 || string.raw_cmp(arg, "-compile") == 0 {
                compile_obj = true
                arg_i++
            } elif string.raw_cmp(arg, "-syntax-check") == 0 {
                syntax_check = true
                arg_i++
            } elif string.raw_cmp(arg, "-ast") == 0 {
                print_ast = true
                arg_i++
            } elif string.raw_cmp(arg, "-b") == 0 || string.raw_cmp(arg, "-bootstrap") == 0 {
                bootstrap_mode = true
                arg_i++
            } elif string.raw_cmp(arg, "-alt") == 0 || string.raw_cmp(arg, "-a") == 0 {
                use_alt = true
                arg_i++
            } elif string.raw_starts_with(arg, "-alt:") {
                use_alt = true
                val compiler_str = builds.parse_alt_compiler_arg(arg)
                if string.raw_cmp(compiler_str, "") != 0 {
                    alt_compiler = compiler_str
                }
                arg_i++
            } elif string.raw_starts_with(arg, "-src-target:") {
                val tgt_len: i64 = string.len_raw(arg) as i64 - 12
                if tgt_len > 0 {
                    src_target = string.substr(arg, 12, tgt_len)
                }
                arg_i++
            } elif string.raw_starts_with(arg, "-emit-shim:") {
                val shim_len: i64 = string.len_raw(arg) as i64 - 11
                if shim_len > 0 {
                    shim_output = string.substr(arg, 11, shim_len)
                }
                arg_i++
            } elif string.raw_starts_with(arg, "-inc-path:") {
                val path_str: ref u8 = string.substr(arg, 10, string.len_raw(arg) - 10)
                if string.raw_cmp(path_str, "") == 0 {
                    stdio.puts("error: -inc-path requires a value")
                    allocators.Arena.free(arena)
                    return 1
                }
                @append(inc_paths, path_str)
                arg_i++
            } else {
                stdio.print("error: unknown flag: {s}\n", {arg})
                allocators.Arena.free(arena)
                return 1
            }
        } else {
            arg_i++
        }
    }

    if string.raw_cmp(src_target, "") != 0 && !emit_alt && !emit_qbe {
        stdio.puts("error: -src-target requires -emit-alt or -emit-ssa")
        allocators.Arena.free(arena)
        return 1
    }

    if run_mode && (translate_c_flag || emit_qbe || emit_ll || emit_asm || emit_alt || build_dll || compile_obj || syntax_check || print_ast) {
        stdio.puts("error: run requires flags that produce a runnable executable")
        allocators.Arena.free(arena)
        return 1
    }

    if translate_c_flag {
        if string.raw_cmp(output_name, "") == 0 {
            output_name = @fmtalloc("./src-out/{s}.sx", {path.get_name_without_ext(arena, input)})
        }
        val code: i32 = c_translate.translate_c(input, output_name)
        allocators.Arena.free(arena)
        return code
    }

    val exe_path2: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
    val exe_dir: mut ref u8 = "."
    if string.raw_cmp(exe_path2, ".") != 0 {
        exe_dir = path.dir(exe_path2)
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt && !print_ast {
        stdio.puts("[I  ]│ Resolving module")
    }

    val resolve_result = module.resolve_module(
        frontend_arena,
        input,
        mem.new[ref u8](),
        exe_dir,
        none
    )
    val root_mod: mut ref module.ResolvedModule = none

    match resolve_result {
        ok m => {
            root_mod = m
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            allocators.Arena.free(arena)
            return 1
        }
    }

    if print_ast {
        val items: list[ref parser.Node] = module.module_items(root_mod)
        ast_printer.print_ast_items(items)
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[II ]│ Semantic analysis")
    }

    val quiet_flag: mut bool = false
    if quiet {
        quiet_flag = true
    }
    val errors: list[ref u8] = sema.check_module_tree(
        frontend_arena,
        root_mod,
        quiet_flag,
        src_target
    )
    val nerrors: i64 = @len(errors) as i64
    if nerrors > 0 {
        for e in errors {
            stdio.print("error: {s}\n", {e})
        }
        allocators.Arena.free(arena)
        return 1
    }

    if syntax_check {
        stdio.puts("Syntax OK")
        allocators.Arena.free(arena)
        return 0
    }

    if !quiet && !emit_qbe && !emit_ll && !emit_alt {
        stdio.puts("[III]│ CG pass")
    }

    if ((@len(extra_includes) as i64) > 0 && !use_alt && !emit_alt) {
        stdio.puts("error: -I<headers> requires the alt backend (-alt)")
        allocators.Arena.free(arena)
        return 1
    }

    if use_alt || emit_alt {
        val platform_alt: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
        val arch_alt: ref u8 = reflection.current_arch_name[allocators.Arena](arena)
        val target_platform: mut ref u8 = platform_alt
        if string.raw_cmp(src_target, "") != 0 {
            target_platform = src_target
        }

        val static_flag_alt: mut ref u8 = ""
        val strip_flag_alt: mut ref u8 = ""
        if !compile_obj && !build_dll {
            static_flag_alt = builds.static_link_flag(platform_alt, dynamic_linking)
        }

        val selected_compiler: mut ref u8 = builds.pick_alt_backend(
            alt_compiler,
            release_mode,
            input,
            root_mod.items,
            arena
        )
        if string.raw_cmp(
            static_flag_alt,
            ""
        ) != 0 && !builds.compiler_supports_static_linking(selected_compiler) {
            if string.raw_cmp(alt_compiler, "") == 0 {
                if builds.is_compiler_available("clang") {
                    selected_compiler = "clang"
                } elif builds.is_compiler_available("cc") {
                    selected_compiler = "cc"
                } else {
                    static_flag_alt = ""
                }
            } else {
                if !quiet {
                    stdio.puts("warning: tcc does not support static linking, thus, linking dynamically")
                }
                static_flag_alt = ""
            }
        }

        val compiler_kind: ref u8 = builds.alt_compiler_kind(selected_compiler)
        if builds.compiler_uses_msvc_flags(compiler_kind) {
            static_flag_alt = ""
        }
        if !compile_obj && !build_dll {
            strip_flag_alt = builds.compiler_strip_flag(compiler_kind, release_mode)
            if string.raw_cmp(platform_alt, "windows") == 0 {
                strip_flag_alt = ""
            }
        }
        val simd_backend: mut i64 = 2
        if !simd_disabled {
            simd_backend = builds.alt_simd_backend(
                selected_compiler,
                target_platform,
                arch_alt
            )
        }

        val c_ir: mut ref u8 = ""
        val emit_ld: bool = !bootstrap_mode
        if test_mode {
            c_ir = alt_codegen.gen_module_c_test(
                root_mod,
                release_mode,
                extra_includes,
                src_target,
                emit_ld,
                simd_backend,
                leak_check
            )
        } else {
            c_ir = alt_codegen.gen_module_c(
                root_mod,
                release_mode,
                extra_includes,
                src_target,
                emit_ld,
                simd_backend,
                leak_check
            )
        }

        if emit_alt != false {
            stdio.puts(c_ir)
            @free(c_ir)
            allocators.Arena.free(arena)
            return 0
        }

        val binary_name_alt: mut ref u8 = ""
        if string.raw_cmp(output_name, "") == 0 {
            binary_name_alt = path.get_name_without_ext(arena, input)
        } else {
            binary_name_alt = output_name
        }

        val c_file = builds.get_unique_tmp_path("spectre_output.c")
        val c_f = os.open(c_file, "w")
        if c_f is some f {
            os.write(f, c_ir, string.len_raw(c_ir) as i64)
            os.close(f)
            @free(c_ir)
        } else {
            stdio.puts("\nerror: could not write C code")
            allocators.Arena.free(arena)
            return 1
        }

        val output_specified_alt: bool = string.raw_cmp(output_name, "") != 0
        val final_output_alt: mut ref u8 = ""
        if output_specified_alt != 0 {
            final_output_alt = binary_name_alt
        } else {
            fs.mkdir_path("./s-out")
            final_output_alt = @fmtalloc("./s-out/{s}", {binary_name_alt})
        }

        val links_alt_result = module.collect_used_links(
            root_mod,
            exe_dir,
            string.raw_cmp(static_flag_alt, "") != 0
        )
        val links_alt: mut list[ref u8] = mem.new[ref u8]()
        match links_alt_result {
            ok resolved => {
                links_alt = resolved
            }
            err e => {
                stdio.print("error: {s}\n", {e})
                os.delete(c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        builds.append_debug_runtime_links(
            links_alt,
            exe_dir,
            quiet,
            release_mode,
            selected_compiler,
            arena
        )
        val link_flags_alt: mut ref u8 = ""
        if string.raw_cmp(static_flag_alt, "") != 0 {
            link_flags_alt = @fmtalloc(" {s}", {static_flag_alt})
        }
        if string.raw_cmp(strip_flag_alt, "") != 0 {
            link_flags_alt = @fmtalloc("{s} {s}", {link_flags_alt, strip_flag_alt})
        }
        for link_flag in links_alt {
            val translated_link: ref u8 = builds.translate_link_flag(
                compiler_kind,
                link_flag
            )
            if string.len_raw(translated_link) > 0 {
                link_flags_alt = @fmtalloc("{s} {s}", {link_flags_alt, translated_link})
            }
        }
        val include_flags_alt: mut ref u8 = ""
        for inc_path in inc_paths {
            include_flags_alt = @fmtalloc(
                "{s} {s}",
                {include_flags_alt, builds.compiler_include_flag(compiler_kind, inc_path)}
            )
        }

        val warn_flag: ref u8 = builds.compiler_warn_flag(selected_compiler)
        val perf_flags: mut ref u8 = ""
        if string.raw_cmp(selected_compiler, "tcc") != 0 {
            val native_flags: ref u8 = builds.compiler_native_flags(
                compiler_kind,
                platform_alt,
                arch_alt,
                native_mode
            )
            if string.len_raw(native_flags) > 0 {
                perf_flags = @fmtalloc("{s} {s}", {perf_flags, native_flags})
            }
            val unroll_flags: ref u8 = builds.compiler_unroll_flag(
                compiler_kind,
                unroll_mode
            )
            if string.len_raw(unroll_flags) > 0 {
                perf_flags = @fmtalloc("{s} {s}", {perf_flags, unroll_flags})
            }
        }
        val cc_flags_alt: mut ref u8 = ""
        if builds.compiler_uses_msvc_flags(compiler_kind) {
            cc_flags_alt = @fmtalloc(
                "/nologo {s} {s} {s}{s}",
                {
                    builds.compiler_std_flag(compiler_kind),
                    warn_flag,
                    builds.compiler_opt_flag(compiler_kind, release_mode),
                    perf_flags
                }
            )
            if string.raw_cmp(compiler_kind, "clang-cl") == 0 {
                cc_flags_alt = @fmtalloc(
                    "{s} -Wno-error=int-conversion",
                    {cc_flags_alt}
                )
            }
        } else {
            cc_flags_alt = @fmtalloc(
                "{s} {s} {s} -Wno-error=int-conversion{s}",
                {
                    builds.compiler_std_flag(compiler_kind),
                    warn_flag,
                    builds.compiler_opt_flag(compiler_kind, release_mode),
                    perf_flags
                }
            )
        }
        val test_output_alt: ref u8 = builds.get_unique_tmp_path("spectre_test_bin_alt")
        val compile_output: mut ref u8 = test_output_alt
        if !test_mode {
            compile_output = final_output_alt
        }

        val alt_cmd: mut ref u8 = ""
        if string.raw_cmp(selected_compiler, "tcc") == 0 {
            if test_mode {
                alt_cmd = @fmtalloc(
                    "tcc {s} -o {s} -w -std=c99{s} {s} 2>&1",
                    {c_file, test_output_alt, include_flags_alt, link_flags_alt}
                )
            } else {
                alt_cmd = @fmtalloc(
                    "tcc {s} -o {s} -w -std=c99{s} {s} 2>&1",
                    {c_file, final_output_alt, include_flags_alt, link_flags_alt}
                )
            }
        } elif builds.compiler_uses_msvc_flags(compiler_kind) {
            if compile_obj {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} /c {s} /Fo:{s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        c_file,
                        compile_output
                    }
                )
            } else {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} {s} /Fe:{s} {s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        c_file,
                        compile_output,
                        link_flags_alt
                    }
                )
            }
        } else {
            if string.raw_cmp(cc_flags_alt, "") == 0 {
                alt_cmd = @fmtalloc(
                    "{s}{s} -o {s} {s}{s} 2>&1",
                    {selected_compiler, include_flags_alt, compile_output, c_file, link_flags_alt}
                )
            } else {
                alt_cmd = @fmtalloc(
                    "{s} {s}{s} -o {s} {s}{s} 2>&1",
                    {
                        selected_compiler,
                        cc_flags_alt,
                        include_flags_alt,
                        compile_output,
                        c_file,
                        link_flags_alt
                    }
                )
            }
        }

        if !quiet && !emit_alt {
            stdio.puts("[IV ]│ AMCS")
        }
        if show_cmd != 0 {
            stdio.print("{s}\n", {alt_cmd})
        }

        val alt_res = os.exec(alt_cmd)
        match alt_res {
            ok v => {
                val vstr: ref u8 = string.cstr(v)
                val error_prefix = string.from[allocators.Arena](arena, "error:")
                val msvc_error = string.from[allocators.Arena](arena, "error")
                val has_error: bool = string.contains(v, error_prefix)
                || (builds.compiler_uses_msvc_flags(compiler_kind)
                    && string.contains(v, msvc_error))
                if has_error {
                    val display: mut ref u8 = vstr
                    if !bootstrap_mode {
                        display = builds.filter_c_diagnostics(vstr)
                    }
                    stdio.print("{s}", {display})
                    os.delete(c_file)
                    allocators.Arena.free(arena)
                    return 1
                } else {
                    if string.len_raw(vstr) > 0 {
                        val display: mut ref u8 = vstr
                        if !bootstrap_mode {
                            display = builds.filter_c_diagnostics(vstr)
                        }
                        stdio.print("{s}", {display})
                    }
                    if test_mode {
                        val run_res_alt = os.run(test_output_alt)
                        if run_res_alt != 0 {
                            stdio.puts("Test binary failed.")
                            os.delete(c_file)
                            allocators.Arena.free(arena)
                            return 1
                        }
                        os.delete(test_output_alt)
                    }
                    if run_mode {
                        val run_res_alt: i32 = os.run(final_output_alt)
                        os.delete(c_file)
                        allocators.Arena.free(arena)
                        return run_res_alt
                    }
                    if !quiet {
                        stdio.print("Compiled (ALT): {s}\n", {final_output_alt})
                    }
                }
            }
            err _ => {
                stdio.print("error: {s} stage failed\n", {selected_compiler})
                os.delete(c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }

        os.delete(c_file)
        allocators.Arena.free(arena)
        return 0
    }

    val qbe_ir: mut ref u8 = ""
    val c_shim_source: mut ref u8 = ""

    if test_mode {
        val cg_out = codegen.gen_module_resolved_test(
            root_mod,
            release_mode,
            src_target,
            leak_check
        )
        qbe_ir = cg_out.qbe
        c_shim_source = cg_out.shim
    } else {
        val cg_out = codegen.gen_module_resolved(
            root_mod,
            release_mode,
            src_target,
            leak_check
        )
        qbe_ir = cg_out.qbe
        c_shim_source = cg_out.shim
    }

    if !quiet && !emit_qbe && !emit_ll {
        stdio.puts("[IV ]│ Module used-links collection")
    }

    if emit_qbe != 0 {
        if string.len_raw(shim_output) > 0 && string.len_raw(c_shim_source) > 0 {
            val shim_f = os.open(shim_output, "w")
            if shim_f is some f {
                os.write(f, c_shim_source, string.len_raw(c_shim_source) as i64)
                os.close(f)
            } else {
                stdio.print("error: could not write C shim to '{s}'\n", {shim_output})
                @free(qbe_ir)
                allocators.Arena.free(arena)
                return 1
            }
        }
        stdio.puts(qbe_ir)
        @free(qbe_ir)
        allocators.Arena.free(arena)
        return 0
    }

    val binary_name: mut ref u8 = ""

    if string.raw_cmp(output_name, "") == 0 {
        binary_name = path.get_name_without_ext(arena, input)
    } else {
        binary_name = output_name
    }

    val qbe_file = builds.get_unique_tmp_path("spectre_output.ssa")
    val asm_file = builds.get_unique_tmp_path("spectre_output.s")
    val qbe_f = os.open(qbe_file, "w")

    if qbe_f is some f {
        os.write(f, qbe_ir, string.len_raw(qbe_ir) as i64)
        os.close(f)
        @free(qbe_ir)
    } else {
        stdio.puts("\nerror: could not write QBE IR")
        allocators.Arena.free(arena)
        return 1
    }

    val qbe_cmd = @fmtalloc("qbe -o {s} {s} 2>&1", {asm_file, qbe_file})
    val qbe_res = os.exec(qbe_cmd)
    if show_cmd != 0 {
        stdio.print("{s}\n", {qbe_cmd})
    }
    match qbe_res {
        ok v => {
            val vstr: ref u8 = string.cstr(v)
            if string.len_raw(vstr) > 0 {
                stdio.print("{s}", {vstr})
            }
            if string.raw_starts_with(vstr, "qbe:") {
                stdio.puts("error: qbe stage failed")
                os.delete(qbe_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
        err _ => {
            stdio.puts("\nerror: failed to run qbe")
            os.delete(qbe_file)
            allocators.Arena.free(arena)
            return 1
        }
    }

    if emit_asm != 0 {
        val asm_size_opt = fs.file_size(asm_file)
        val asm_arena_cap: mut i64 = 4096
        if asm_size_opt is some sz {
            if ((sz as i64) > asm_arena_cap) {
                asm_arena_cap = sz as i64
            }
        } else {
            stdio.puts("error: could not read assembly output")
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }
        val asm_arena: mut allocators.Arena = allocators.Arena.new((asm_arena_cap + 8) as usize)?
        val asm_opt = fs.read_all[allocators.Arena](asm_arena, asm_file)
        if asm_opt is some asm_content {
            stdio.puts(asm_content as ref u8)
        } else {
            stdio.puts("error: could not read assembly output")
        }
        allocators.Arena.free(asm_arena)
        os.delete(qbe_file)
        os.delete(asm_file)
        allocators.Arena.free(arena)
        return 0
    }

    val platform: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    val static_link: mut ref u8 = ""
    val strip_link: mut ref u8 = ""
    if !compile_obj && !build_dll {
        static_link = builds.static_link_flag(platform, dynamic_linking)
        strip_link = builds.strip_link_flag(release_mode)
    }

    val links_result = module.collect_used_links(
        root_mod,
        exe_dir,
        string.raw_cmp(static_link, "") != 0
    )
    val links: mut list[ref u8] = mem.new[ref u8]()
    match links_result {
        ok resolved => {
            links = resolved
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }
    }
    builds.append_debug_runtime_links(links, exe_dir, quiet, release_mode, "cc", arena)

    val output_specified: bool = string.raw_cmp(output_name, "") != 0
    val cc_cmd: mut ref u8 = ""
    val success_msg: mut ref u8 = ""
    val exit_code: mut i32 = 0
    val link_flags: mut ref u8 = ""
    val run_output: mut ref u8 = ""

    val shim_c_file: mut ref u8 = ""
    val shim_obj: mut ref u8 = ""

    if string.len_raw(c_shim_source) > 0 {
        shim_c_file = builds.get_unique_tmp_path("spectre_c_shim.c")
        val shim_f = os.open(shim_c_file, "w")
        if shim_f is some f {
            os.write(f, c_shim_source, string.len_raw(c_shim_source) as i64)
            os.close(f)
        } else {
            stdio.puts("error: could not write C shim")
            os.delete(qbe_file)
            os.delete(asm_file)
            allocators.Arena.free(arena)
            return 1
        }

        val include_flags: mut ref u8 = " -I."
        for inc_path in inc_paths {
            include_flags = @fmtalloc("{s} -I{s}", {include_flags, inc_path})
        }

        shim_obj = builds.get_unique_tmp_path("spectre_c_shim.o")
        val shim_cmd = @fmtalloc(
            "cc -std=c99 -Wno-error=int-conversion -c -o {s} {s}{s} 2>&1",
            {shim_obj, shim_c_file, include_flags}
        )
        if show_cmd != 0 {
            stdio.print("{s}\n", {shim_cmd})
        }
        val shim_res = os.exec(shim_cmd)
        match shim_res {
            ok v => {
                val vstr: ref u8 = string.cstr(v)
                if string.len_raw(vstr) > 0 {
                    stdio.print("{s}", {vstr})
                }
                val shim_error_text = string.from[allocators.Arena](arena, "error:")
                if string.contains(v, shim_error_text) {
                    stdio.puts("error: C shim compilation failed")
                    os.delete(qbe_file)
                    os.delete(asm_file)
                    os.delete(shim_c_file)
                    allocators.Arena.free(arena)
                    return 1
                }
            }
            err _ => {
                stdio.puts("error: failed to run C compiler for C shim")
                os.delete(qbe_file)
                os.delete(asm_file)
                os.delete(shim_c_file)
                allocators.Arena.free(arena)
                return 1
            }
        }
    }

    if string.raw_cmp(static_link, "") != 0 {
        link_flags = @fmtalloc(" {s}", {static_link})
    }
    if string.raw_cmp(strip_link, "") != 0 {
        link_flags = @fmtalloc("{s} {s}", {link_flags, strip_link})
    }
    for link_flag in links {
        link_flags = @fmtalloc("{s} {s}", {link_flags, link_flag})
    }

    if string.len_raw(shim_obj) > 0 && !compile_obj {
        link_flags = @fmtalloc("{s} {s}", {link_flags, shim_obj})
    }

    val cc_flags: mut ref u8 = ""
    if !release_mode {
        cc_flags = "-g"
    }
    val output_ext: mut ref u8 = ""

    if compile_obj {
        cc_flags = @fmtalloc("{s} -c", {cc_flags})
        if string.raw_cmp(platform, "windows") == 0 {
            output_ext = ".obj"
        } else {
            output_ext = ".o"
        }
    } elif build_dll {
        if string.raw_cmp(platform, "macos") == 0 {
            cc_flags = @fmtalloc("{s} -dynamiclib", {cc_flags})
            output_ext = ".dylib"
        } elif string.raw_cmp(platform, "windows") == 0 {
            cc_flags = @fmtalloc("{s} -shared", {cc_flags})
            output_ext = ".dll"
        } else {
            cc_flags = @fmtalloc("{s} -shared", {cc_flags})
            output_ext = ".so"
        }
    } else {
        output_ext = ""
    }

    if test_mode {
        val test_bin: ref u8 = builds.get_unique_tmp_path("spectre_test_bin")
        cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {test_bin, asm_file, link_flags})
        val cc_res2 = os.exec(cc_cmd)
        match cc_res2 {
            ok _ => {
                if !quiet && !emit_qbe {
                    stdio.print("[spectre] running tests for: {s}\n", {input})
                }
                val run_res = os.run(test_bin)
                if run_res != 0 {
                    if !quiet && !emit_qbe {
                        stdio.print("[spectre] test binary exited with: {s}\n", {"non-zero exit"})
                    }
                    exit_code = 1
                }
            }
            err _ => {
                stdio.puts("error: cc compilation failed")
                exit_code = 1
            }
        }
        os.delete(qbe_file)
        os.delete(asm_file)
        if string.len_raw(shim_c_file) > 0 {
            os.delete(shim_c_file)
        }
        if string.len_raw(shim_obj) > 0 {
            os.delete(shim_obj)
        }
        allocators.Arena.free(arena)
        return exit_code
    }

    if output_specified != 0 {
        val final_output: mut ref u8 = binary_name
        if string.raw_cmp(output_ext, "") != 0 {
            final_output = @fmtalloc("{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if string.raw_cmp(cc_flags, "") == 0 {
            cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmtalloc(
                "cc {s} -o {s} {s}{s}",
                {cc_flags, final_output, asm_file, link_flags}
            )
        }
        success_msg = @fmtalloc("Compiled: {s}\n", {final_output})
    } else {
        fs.mkdir_path("./s-out")
        val final_output: mut ref u8 = @fmtalloc("./s-out/{s}", {binary_name})
        if string.raw_cmp(output_ext, "") != 0 {
            final_output = @fmtalloc("./s-out/{s}{s}", {binary_name, output_ext})
        }
        run_output = final_output
        if string.raw_cmp(cc_flags, "") == 0 {
            cc_cmd = @fmtalloc("cc -o {s} {s}{s}", {final_output, asm_file, link_flags})
        } else {
            cc_cmd = @fmtalloc(
                "cc {s} -o {s} {s}{s}",
                {cc_flags, final_output, asm_file, link_flags}
            )
        }
        success_msg = @fmtalloc("Compiled: {s}\n", {final_output})
    }

    if show_cmd != 0 {
        stdio.print("{s}\n", {cc_cmd})
    }

    val cc_res = os.exec(@fmtalloc("{s} {s}", {cc_cmd, " 2>&1"}))
    match cc_res {
        ok v => {
            val error_text = string.from[allocators.Arena](arena, "error")
            val has_error: bool = string.contains(v, error_text)
            if has_error {
                stdio.print("{s}\n", {string.cstr(v)})
                stdio.puts("linking failed.")
                exit_code = 1
            } else {
                if !quiet && !emit_qbe {
                    stdio.print("{s}", {success_msg})
                }
                if run_mode {
                    exit_code = os.run(run_output)
                }
            }
        }
        err _ => {
            stdio.puts("\nerror: cc compilation failed")
        }
    }

    os.delete(qbe_file)
    os.delete(asm_file)
    if string.len_raw(shim_c_file) > 0 {
        os.delete(shim_c_file)
    }
    if string.len_raw(shim_obj) > 0 {
        os.delete(shim_obj)
    }
    allocators.Arena.free(arena)

    return exit_code
}
