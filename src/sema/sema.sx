val string     = use("std/string")
val mem        = use("../meta/mem.sx")
val fmt        = use("std/fmt")
val stdio      = use("std/stdio")
val math       = use("std/math")
val allocators = use("std/allocators")
val reflection = use("std/reflection")
val fs         = use("std/fs")
val path       = use("std/path")
val parser     = use("../ast/parser.sx")
val modinfo    = use("../module/module.sx")

type ScopeEntry = {
    name: mut ref u8
    mutable: mut i64
    type_name: mut ref u8
    is_ref: mut i64
    line: mut i64
    used: mut i64
    mutated: mut i64
    implicit_mut: mut i64
    wrap_kind: mut i64
}

/// Result of a compile-time constant evaluation. Unlike option[i64], this can
/// represent every i64 value, including -1.
type SemaConstVal = {
    known: mut bool
    is_float: mut bool
    value: mut i64
    fvalue: mut f64
}

/// Parallel storage for named constant arguments. Keeping the components in
/// separate primitive lists avoids relying on aggregate option payloads.
type SemaConstEnv = {
    names: mut list[ref u8]
    known: mut list[i64]
    is_float: mut list[i64]
    value: mut list[i64]
    fvalue: mut list[i64]
}

type SemaCtx = {
    errors: mut list[ref u8]
    warnings: mut list[ref u8]
    fn_names: mut list[ref u8]
    used_fns: mut list[ref u8]
    type_names: mut list[ref u8]
    spec_names: mut list[ref u8]
    spec_impls: mut list[ref u8]
    global_names: mut list[ref u8]
    use_names: mut list[ref u8]
    use_lines: mut list[i64]
    scopes: mut list[ref void]
    type_defs: mut list[ref void]
    fn_defs: mut list[ref void]
    fn_map_names: mut list[ref u8]
    fn_map_params: mut list[ref void]
    variant_names: mut list[ref u8]
    root_mod: mut ref modinfo.ResolvedModule
    src_target: mut ref u8
    in_unsafe_fn: mut i64
    in_trust: mut i64
    trust_used: mut i64
    type_params: mut list[ref u8]
    argspack_params: mut list[ref u8]
    var_origin_names: mut list[ref u8]
    var_origin_types: mut list[ref u8]
    arena: mut allocators.ScopedArenaAllocator
}

fn sema_new(arena: allocators.ScopedArenaAllocator) ref SemaCtx = trust {
    val ctx: mut ref SemaCtx = allocators.ScopedArena.alloc_or_none(
        arena,
        @sizeof(SemaCtx) as usize
    ) as ref SemaCtx
    @memset(ctx, 0, @sizeof(SemaCtx) as usize)
    ctx.arena = arena
    return ctx
}

fn sema_platform_matches(ctx: ref SemaCtx, name: ref u8) bool = trust {
    if string.raw_cmp(ctx.src_target, c"") != 0 {
        return modinfo.platform_matches(ctx.src_target, name)
    }
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val current: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    val matched: bool = modinfo.platform_matches(current, name)
    allocators.Arena.free(arena)
    return matched
}

/// Return the item/statement list of the active `when` branch, or none.
fn sema_select_when_branch(ctx: ref SemaCtx, node: ref parser.Node) ref void = trust {
    if node == none {
        return none
    }
    if sema_platform_matches(ctx, parser.node_str_raw(node.d0)) {
        return node.d1 as ref void
    }
    val or_branches: ref void = node.d2 as ref void
    if or_branches != none {
        for ow in or_branches as list[ref parser.Node] {
            if sema_platform_matches(ctx, parser.node_str_raw(ow.d0)) {
                return ow.d1 as ref void
            }
        }
    }
    return node.d3 as ref void
}

fn add_error(ctx: ref SemaCtx, msg: ref u8) void = trust {
    for existing in ctx.errors {
        if string.raw_cmp(existing as ref u8, msg) == 0 {
            return
        }
    }
    @append(ctx.errors, msg)
}

fn canonicalize_path(ctx: ref SemaCtx, path: ref u8) ref u8 = trust {
    if path == none {
        return path
    }
    val len: i64 = string.len_raw(path)
    val segs: mut list[ref u8] = mem.new[ref u8]()
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(path, i))
        if c == 47 {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= len {
                break
            }
            val c2: u8 = @load8(@ptradd(path, i))
            if c2 == 47 {
                break
            }
            i++
        }
        val seg_len: i64 = i - start
        val seg: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            ((seg_len + 1) as usize) as usize
        ) as ref u8
        @memcpy(seg, @ptradd(path, start), seg_len as usize)
        @store8(@ptradd(seg, seg_len), 0)
        if string.raw_cmp(seg, c"..") == 0 {
            if @len(segs) as i64 > 0 {
                @remove(segs, @len(segs) - 1)
            }
        } elif string.raw_cmp(seg, c".") != 0 {
            @append(segs, seg)
        }
    }
    val sb: ref void = string.StringBuilder.new()
    val c0: u8 = @load8(@ptradd(path, 0))
    if c0 == 47 {
        string.StringBuilder.append_char(sb, 47 as u8)
    }
    val si: mut i64 = 0
    for {
        if si >= @len(segs) as i64 {
            break
        }
        val s_opt = @get(segs, si as usize)
        if s_opt is some s {
            if si > 0 {
                string.StringBuilder.append_char(sb, 47 as u8)
            }
            string.StringBuilder.append_cstr(sb, s as ref u8)
        }
        si++
    }
    val built: ref void = string.StringBuilder.build(sb)
    val src_cstr: ref u8 = string.cstr(built)
    val n: i64 = string.len_raw(src_cstr) + 1
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (n) as usize) as ref u8
    @memcpy(out, src_cstr, n as usize)
    string.StringBuilder.free(sb)
    @free(@load(built))
    @free(built)
    return out
}

fn normalize_path(arena: allocators.ScopedArenaAllocator, path: ref u8) ref u8 = trust {
    if path == none {
        return path
    }
    val sb: ref void = string.StringBuilder.new()
    val len: i64 = string.len_raw(path)
    val prev_slash: mut bool = false
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: i64 = @load8(@ptradd(path, i)) as i64
        if c == 47 {
            if !prev_slash {
                string.StringBuilder.append_char(sb, 47 as u8)
            }
            prev_slash = true
        } else {
            string.StringBuilder.append_char(sb, c as u8)
            prev_slash = false
        }
        i++
    }
    val built: ref void = string.StringBuilder.build(sb)
    val source: ref u8 = string.cstr(built)
    val n: i64 = string.len_raw(source) + 1
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(arena, n as usize) as ref u8
    if out != none {
        @memcpy(out, source, n as usize)
    }
    string.StringBuilder.free(sb)
    @free(source)
    @free(built)
    return out
}

fn builtin_min_arity(name: ref u8) i64 = trust {
    if string.str_eql(
        name,
        c"get"
    ) || string.str_eql(name, c"getref") || string.str_eql(name, c"getmut") {
        return 2
    }
    if string.str_eql(name, c"set") {
        return 3
    }
    if string.str_eql(name, c"len") {
        return 1
    }
    if string.str_eql(name, c"append") {
        return 2
    }
    if string.str_eql(name, c"insert") {
        return 3
    }
    if string.str_eql(name, c"remove") {
        return 2
    }
    if string.str_eql(name, c"reserve") {
        return 2
    }
    if string.str_eql(name, c"capacity") {
        return 1
    }
    if string.str_eql(name, c"embed") {
        return 1
    }
    if string.str_eql(name, c"embedlen") {
        return 1
    }
    if string.str_eql(name, c"alloc") {
        return 1
    }
    if string.str_eql(name, c"free") {
        return 1
    }
    if string.str_eql(name, c"realloc") {
        return 2
    }
    if string.str_eql(name, c"load") {
        return 1
    }
    if string.str_eql(name, c"load8") {
        return 1
    }
    if string.str_eql(name, c"load16") {
        return 1
    }
    if string.str_eql(name, c"load32") {
        return 1
    }
    if string.str_eql(name, c"load64") {
        return 1
    }
    if string.str_eql(name, c"store") {
        return 2
    }
    if string.str_eql(name, c"store8") {
        return 2
    }
    if string.str_eql(name, c"store16") {
        return 2
    }
    if string.str_eql(name, c"store32") {
        return 2
    }
    if string.str_eql(name, c"store64") {
        return 2
    }
    if string.str_eql(name, c"ptradd") {
        return 2
    }
    if string.str_eql(name, c"memcpy") {
        return 3
    }
    if string.str_eql(name, c"memset") {
        return 3
    }
    if string.str_eql(name, c"memmove") {
        return 3
    }
    if string.str_eql(name, c"sizeof") {
        return 1
    }
    if string.str_eql(name, c"bitcast") {
        return 2
    }
    if string.str_eql(name, c"print") {
        return 1
    }
    if string.str_eql(name, c"dprintf") {
        return 2
    }
    if string.str_eql(name, c"snprintf") {
        return 3
    }
    if string.str_eql(name, c"fmtalloc") {
        return 1
    }
    if string.str_eql(name, c"argsalloc") {
        return 1
    }
    if string.str_eql(name, c"listalloc") {
        return 1
    }
    if string.str_eql(name, c"list") {
        return 1
    }
    if string.str_eql(name, c"listfree") {
        return 1
    }
    if string.str_eql(name, c"puts") {
        return 1
    }
    if string.str_eql(name, c"fgets") {
        return 3
    }
    if string.str_eql(name, c"strlen") {
        return 1
    }
    if string.str_eql(name, c"strcmp") {
        return 2
    }
    if string.str_eql(name, c"atoi") {
        return 1
    }
    if string.str_eql(name, c"staticerror") {
        return 1
    }
    if string.str_eql(name, c"call") {
        return 1
    }
    return 0
}

/// Validate @embed/@embedlen and attach the resolved file path and size to
/// the builtin node. Paths are relative to the file containing the builtin.
fn resolve_embed_builtin(
    ctx: mut ref SemaCtx,
    expr: ref parser.Node,
    bargs: ref void,
    filename: ref u8,
    bname: ref u8
) void = trust {
    val argc: mut i64 = 0
    if bargs != none {
        argc = @len(bargs as list[ref parser.Node]) as i64
    }
    if argc != 1 {
        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' expects exactly 1 argument, got {lld}",
            {filename, expr.line, bname, argc})
        add_error(ctx, ebuf)
        return
    }

    val arg_opt = @get(bargs as list[ref parser.Node], 0 as usize)
    if arg_opt is some arg_raw {
        val arg: ref parser.Node = arg_raw as ref parser.Node
        if arg.kind != parser.NK_STR_LIT {
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' expects a string literal path",
                {filename, expr.line, bname})
            add_error(ctx, ebuf)
            return
        }
        val rel: ref u8 = parser.node_str_raw(arg.d0)
        if rel == none || string.len_raw(rel) == 0 {
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' requires a non-empty path",
                {filename, expr.line, bname})
            add_error(ctx, ebuf)
            return
        }
        val base_dir: ref u8 = path.dir_raw(filename)
        val joined: ref u8 = path.join_raw(base_dir, rel)
        val canonical: ref u8 = canonicalize_path(ctx, joined)
        @free(base_dir)
        @free(joined)
        val size_opt = fs.file_size_raw(canonical)
        match size_opt {
            some size => {
                parser.node_store_string_slot(@addr(expr.d2), canonical)
                parser.node_store_slot[i64](@addr(expr.d3), size)
            }
            none => {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (1024) as usize
                ) as ref u8
                @snprintf(ebuf, 1024, "{s}:{lld}: cannot embed '{s}': file not found or unreadable",
                    {filename, expr.line, canonical})
                add_error(ctx, ebuf)
            }
        }
    } else {
        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' expects exactly 1 argument",
            {filename, expr.line, bname})
        add_error(ctx, ebuf)
    }
}

fn is_known_builtin(name: ref u8) bool = trust {
    val builtins: mut list[ref u8] = mem.new[ref u8]()
    @append(builtins, c"alloc")
    @append(builtins, c"free")
    @append(builtins, c"realloc")
    @append(builtins, c"sizeof")
    @append(builtins, c"memcpy")
    @append(builtins, c"memset")
    @append(builtins, c"memmove")
    @append(builtins, c"ptradd")
    @append(builtins, c"fgets")
    @append(builtins, c"stdin")
    @append(builtins, c"stderr")
    @append(builtins, c"load")
    @append(builtins, c"load64")
    @append(builtins, c"load8")
    @append(builtins, c"load16")
    @append(builtins, c"load32")
    @append(builtins, c"addr")
    @append(builtins, c"deref")
    @append(builtins, c"store")
    @append(builtins, c"store64")
    @append(builtins, c"store8")
    @append(builtins, c"store16")
    @append(builtins, c"store32")
    @append(builtins, c"append")
    @append(builtins, c"remove")
    @append(builtins, c"insert")
    @append(builtins, c"get")
    @append(builtins, c"getref")
    @append(builtins, c"getmut")
    @append(builtins, c"set")
    @append(builtins, c"len")
    @append(builtins, c"reserve")
    @append(builtins, c"capacity")
    @append(builtins, c"fmtalloc")
    @append(builtins, c"argsalloc")
    @append(builtins, c"listalloc")
    @append(builtins, c"list")
    @append(builtins, c"listfree")
    @append(builtins, c"snprintf")
    @append(builtins, c"print")
    @append(builtins, c"dprintf")
    @append(builtins, c"puts")
    @append(builtins, c"args")
    @append(builtins, c"call")
    @append(builtins, c"stdin")
    @append(builtins, c"stdout")
    @append(builtins, c"stderr")
    @append(builtins, c"fgets")
    @append(builtins, c"getchar")
    @append(builtins, c"strlen")
    @append(builtins, c"strcmp")
    @append(builtins, c"atoi")
    @append(builtins, c"staticerror")
    @append(builtins, c"dumpmemleaks")
    @append(builtins, c"flush")
    @append(builtins, c"bitcast")
    @append(builtins, c"embed")
    @append(builtins, c"embedlen")

    for builtin in builtins {
        if string.str_eql(name, builtin) {
            return true
        }
    }
    return false
}

fn push_scope(ctx: ref SemaCtx) void = trust {
    guarded pre {
        ctx_not_null: ctx != none
    }

    val frame: list[ref ScopeEntry] = mem.new[ref ScopeEntry]()
    @append(ctx.scopes, frame as ref void)

    guarded post {
        scope_created: @len(ctx.scopes) > 0
    }
}

fn pop_scope(ctx: ref SemaCtx, filename: ref u8, _: i64) void = trust {
    guarded pre {
        ctx_not_null: ctx != none
        has_scopes: @len(ctx.scopes) > 0
    }

    val len: usize = @len(ctx.scopes)
    if len > 0 {
        val frame_opt = @get(ctx.scopes, len - 1)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val i: mut i64 = 0
            for {
                if i >= flen {
                    break
                }
                val e_opt = @get(frame, i as usize)
                if e_opt is some e {
                    val entry: ref ScopeEntry = e as ref ScopeEntry
                    if entry.name != none {
                        if string.raw_cmp(entry.name, c"_") != 0 {
                            if entry.used == 0 {
                                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (512) as usize
                                ) as ref u8
                                @snprintf(
                                    buf,
                                    512,
                                    "{s}:{lld}: variable '{s}' declared but never used",
                                    {filename, entry.line, entry.name}
                                )
                                add_error(ctx, buf)
                            } elif entry.mutable == 1 && entry.mutated == 0 && entry.implicit_mut == 0 {
                                val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (512) as usize
                                ) as ref u8
                                @snprintf(
                                    buf2,
                                    512,
                                    "{s}:{lld}: mutable variable '{s}' declared mutable but never mutated",
                                    {filename, entry.line, entry.name}
                                )
                                add_error(ctx, buf2)
                            }
                        }
                    }
                }
                i++
            }
        }
        if frame_opt is some frame {
            @listfree(frame)
        }
        @remove(ctx.scopes, len - 1)
    }

    guarded post {
        scope_removed: true
    }
}

fn scope_define(
    ctx: ref SemaCtx,
    name: ref u8,
    mutable: i64,
    type_name: ref u8,
    is_ref: i64,
    decl_line: i64
) void = trust {
    guarded pre {
        ctx_not_null: ctx != none
        name_not_null: name != none
        has_scope: @len(ctx.scopes) > 0
    }

    val len: usize = @len(ctx.scopes)
    if len == 0 {
        return
    }
    val frame_opt = @get(ctx.scopes, len - 1)
    if frame_opt is some frame {
        val entry: mut ref ScopeEntry = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (@sizeof(ScopeEntry)) as usize
        ) as ref ScopeEntry
        entry.name = name
        entry.mutable = mutable
        entry.type_name = type_name
        entry.is_ref = is_ref
        entry.line = decl_line
        entry.used = 0
        entry.mutated = 0
        entry.wrap_kind = 0
        @append(frame, entry)

        guarded post {
            entry_added: @len(frame) > 0
        }
    }
}

fn scope_set_implicit_mut(ctx: ref SemaCtx, name: ref u8) void = trust {
    val len: usize = @len(ctx.scopes)
    if len == 0 {
        return
    }
    val frame_opt = @get(ctx.scopes, len - 1)
    if frame_opt is some frame {
        val flen: i64 = @len(frame) as i64
        val i: mut i64 = 0
        for {
            if i >= flen {
                break
            }
            val e_opt = @get(frame, i as usize)
            if e_opt is some e {
                val entry: mut ref ScopeEntry = e as ref ScopeEntry
                if entry.name != none {
                    if string.raw_cmp(entry.name, name) == 0 {
                        entry.implicit_mut = 1
                    }
                }
            }
            i++
        }
    }
}

/// Walks a chain of NK_FIELD nodes down to the root NK_IDENT, returning it (or null if none).
fn find_root_ident(node: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = node
    for {
        if cur.kind == parser.NK_IDENT {
            return cur
        }
        if cur.kind == parser.NK_FIELD {
            cur = parser.field_base(cur)
        } else {
            return none
        }
    }
    return none
}

fn is_c_escape_expr(node: ref parser.Node) bool = trust {
    if node == none || node.kind != parser.NK_FIELD {
        return false
    }
    val root: ref parser.Node = find_root_ident(node)
    if root == none {
        return false
    }
    return string.str_eql(parser.node_str_raw(root.d0), c"C")
}

/// Strips NK_CAST and NK_TRUST wrappers, then delegates to find_root_ident.
fn unwrap_and_find_root(node: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = node
    for {
        if cur == none {
            return none
        }
        if cur.kind == parser.NK_CAST || cur.kind == parser.NK_TRUST {
            cur = cur.d0 as ref parser.Node
        } else {
            return find_root_ident(cur)
        }
    }
    return none
}


/// Look up an imported module by its alias name.
/// Returns the ResolvedModule for that alias, or 0 if not found.
fn find_imported_module(
    mod: ref modinfo.ResolvedModule,
    alias: ref u8
) ref modinfo.ResolvedModule = trust {
    if mod == none {
        return none
    }
    if alias == none {
        return none
    }
    val n: i64 = modinfo.import_count(mod)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val mname: ref u8 = modinfo.import_name_at(mod, i as usize)
        if mname != none && string.str_eql(mname, alias) {
            return modinfo.import_module_at(mod, i as usize)
        }
        i++
    }
    return none
}

/// Returns true if `mod`'s items contain a top-level `val name = use(...)` alias.
fn module_has_use_alias(mod: ref modinfo.ResolvedModule, name: ref u8) bool = trust {
    if mod == none {
        return false
    }
    if name == none {
        return false
    }
    val items: list[ref parser.Node] = modinfo.module_items(mod)
    for item in items {
        if item.kind == parser.NK_USE {
            val alias: ref u8 = parser.node_str_raw(item.d1)
            if alias != none && string.str_eql(alias, name) {
                return true
            }
        }
    }
    return false
}

/// Reject dotted type names like `math.numerics.Mat4x4` where the first
/// two dotted segments form a module-to-module access. Only `module.Type` is
/// allowed.
fn check_no_module_to_module_type(
    ctx: ref SemaCtx,
    ty_node: ref parser.Node,
    line: i64,
    filename: ref u8
) void = trust {
    if ty_node == none {
        return
    }
    val k: i64 = ty_node.kind
    if k == parser.TY_REF || k == parser.TY_OPTION || k == parser.TY_LIST || k == parser.TY_MUT || k == parser.TY_SLICE {
        check_no_module_to_module_type(ctx, ty_node.d0 as ref parser.Node, line, filename)
        return
    }
    if k == parser.TY_RESULT {
        check_no_module_to_module_type(ctx, ty_node.d0 as ref parser.Node, line, filename)
        check_no_module_to_module_type(ctx, ty_node.d1 as ref parser.Node, line, filename)
        return
    }
    if k != parser.TY_NAMED {
        return
    }
    val name: ref u8 = parser.node_str_raw(ty_node.d0)
    if name == none {
        return
    }
    val nlen: i64 = string.len_raw(name)
    val first_dot: mut i64 = -1
    val second_dot: mut i64 = -1
    val si: mut i64 = 0
    for {
        if si >= nlen {
            break
        }
        val c: u8 = @load8(@ptradd(name, si))
        if c == 46 {
            if first_dot < 0 {
                first_dot = si
            } elif second_dot < 0 {
                second_dot = si
                break
            }
        }
        si++
    }
    if first_dot < 0 || second_dot < 0 {
        return
    }
    val first_seg: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (first_dot + 1) as usize
    ) as ref u8
    @memcpy(first_seg, name, first_dot as usize)
    @store8(@ptradd(first_seg, first_dot), 0)
    val second_len: i64 = second_dot - first_dot - 1
    val second_seg: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (second_len + 1) as usize
    ) as ref u8
    @memcpy(second_seg, @ptradd(name, first_dot + 1), second_len as usize)
    @store8(@ptradd(second_seg, second_len), 0)
    val rmod: ref modinfo.ResolvedModule = ctx.root_mod
    val imported: ref modinfo.ResolvedModule = find_imported_module(rmod, first_seg)
    if imported == none {
        return
    }
    if module_has_use_alias(imported, second_seg) {
        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(
            ebuf,
            512,
            "{s}:{lld}: chained module access '{s}.{s}' is not allowed in type '{s}'; import '{s}' directly with `use(...)` instead",
            {filename, line, first_seg, second_seg, name, second_seg}
        )
        add_error(ctx, ebuf)
    }
}

/// Reject expressions of the form `module.module(.something...)` where both
/// `module` and the inner field are top-level `use(...)` aliases. Only direct
/// `module.member` access is allowed.
fn check_no_module_to_module_field(
    ctx: ref SemaCtx,
    expr: ref parser.Node,
    line: i64,
    filename: ref u8
) void = trust {
    if expr == none {
        return
    }
    if expr.kind != parser.NK_FIELD {
        return
    }
    val base: ref parser.Node = parser.field_base(expr)
    val field: ref u8 = parser.field_name_raw(expr)
    if base == none || field == none {
        return
    }
    if base.kind != parser.NK_IDENT {
        return
    }
    val root_name: ref u8 = parser.node_str_raw(base.d0)
    if root_name == none {
        return
    }
    val rmod: ref modinfo.ResolvedModule = ctx.root_mod
    val imported: ref modinfo.ResolvedModule = find_imported_module(rmod, root_name)
    if imported == none {
        return
    }
    if module_has_use_alias(imported, field) {
        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(
            ebuf,
            512,
            "{s}:{lld}: chained module access '{s}.{s}' is not allowed, import '{s}' directly with `use(...)` instead",
            {filename, line, root_name, field, field}
        )
        add_error(ctx, ebuf)
    }
}

fn unwrap_generic_callee(callee: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = callee
    for {
        if cur == none {
            return none
        }
        if cur.kind == parser.NK_GENERIC_INST {
            cur = parser.generic_inst_base(cur)
            continue
        }
        return cur
    }
    return none
}

fn callee_has_explicit_type_args(callee: ref parser.Node) bool = trust {
    val cur: mut ref parser.Node = callee
    for {
        if cur == none {
            return false
        }
        if cur.kind != parser.NK_GENERIC_INST {
            return false
        }
        if @len(parser.generic_inst_type_args(cur)) > 0 {
            return true
        }
        cur = parser.generic_inst_base(cur)
    }
    return false
}

/// Returns mutable flag (0 or 1) or -1 if not found.
fn scope_lookup(ctx: ref SemaCtx, name: ref u8) i64 = trust {
    guarded pre {
        ctx_not_null: ctx != none
        name_not_null: name != none
    }

    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        return entry.mutable
                    }
                }
                j--
            }
        }
        i--
    }
    return -1
}

/// Returns the type name of a variable from scope, or null if not found.
fn scope_lookup_type(ctx: ref SemaCtx, name: ref u8) ref u8 = trust {
    guarded pre {
        ctx_not_null: ctx != none
        name_not_null: name != none
    }

    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        return entry.type_name
                    }
                }
                j--
            }
        }
        i--
    }
    return none
}

/// Returns 1 if the variable was declared with a top-level ref type, 0 otherwise.
fn scope_lookup_is_ref(ctx: ref SemaCtx, name: ref u8) i64 = trust {
    guarded pre {
        ctx_not_null: ctx != none
        name_not_null: name != none
    }

    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        return entry.is_ref
                    }
                }
                j--
            }
        }
        i--
    }
    return 0
}


/// Returns the wrap kind (0=none, 1=result, 2=option) recorded for a variable in scope.
fn scope_lookup_wrap_kind(ctx: ref SemaCtx, name: ref u8) i64 = trust {
    if ctx == none {
        return 0
    }
    if name == none {
        return 0
    }
    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        return entry.wrap_kind
                    }
                }
                j--
            }
        }
        i--
    }
    return 0
}

/// Sets the wrap kind (0=none, 1=result, 2=option) on a variable in the current scope.
fn scope_set_wrap_kind(ctx: ref SemaCtx, name: ref u8, kind: i64) void = trust {
    if ctx == none {
        return
    }
    if name == none {
        return
    }
    val len: usize = @len(ctx.scopes)
    if len == 0 {
        return
    }
    val frame_opt = @get(ctx.scopes, len - 1)
    if frame_opt is some frame {
        val flen: i64 = @len(frame) as i64
        val j: mut i64 = 0
        for {
            if j >= flen {
                break
            }
            val e_opt = @get(frame, j as usize)
            if e_opt is some e {
                val entry: mut ref ScopeEntry = e as ref ScopeEntry
                if entry.name != none {
                    if string.raw_cmp(entry.name, name) == 0 {
                        entry.wrap_kind = kind
                        return
                    }
                }
            }
            j++
        }
    }
}

fn mark_name_used(ctx: ref SemaCtx, name: ref u8) void = trust {
    if name == none {
        return
    }
    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: mut ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        entry.used = 1
                        return
                    }
                }
                j--
            }
        }
        i--
    }
}

fn mark_name_mutated(ctx: ref SemaCtx, name: ref u8) void = trust {
    if name == none {
        return
    }
    val len: i64 = @len(ctx.scopes) as i64
    val i: mut i64 = len - 1
    for {
        if i < 0 {
            break
        }
        val frame_opt = @get(ctx.scopes, i as usize)
        if frame_opt is some frame {
            val flen: i64 = @len(frame) as i64
            val j: mut i64 = flen - 1
            for {
                if j < 0 {
                    break
                }
                val e_opt = @get(frame, j as usize)
                if e_opt is some e {
                    val entry: mut ref ScopeEntry = e as ref ScopeEntry
                    if string.raw_cmp(entry.name, name) == 0 {
                        entry.mutated = 1
                        entry.used = 1
                        return
                    }
                }
                j--
            }
        }
        i--
    }
}

/// Checks if a field named field_name is mutable in the typedef named type_name.
/// Returns 1 if mutable, 0 if immutable, -1 if not found.
fn find_field_mutable(ctx: ref SemaCtx, type_name: ref u8, field_name: ref u8) i64 = trust {
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val td_node: ref parser.Node = td as ref parser.Node
            val td_name: ref u8 = parser.node_str_raw(td_node.d1)
            if string.raw_cmp(td_name, type_name) == 0 {
                val fields: ref void = td_node.d2 as ref void
                if fields != none {
                    val flen: i64 = @len(fields) as i64
                    val fi: mut i64 = 0
                    for {
                        if fi >= flen {
                            break
                        }
                        val f_opt = @get(fields, fi as usize)
                        if f_opt is some f {
                            val fnode: ref parser.Node = f as ref parser.Node
                            val fname: ref u8 = parser.node_str_raw(fnode.d0)
                            if string.raw_cmp(fname, field_name) == 0 {
                                return fnode.d1
                            }
                        }
                        fi++
                    }
                }
                return -1
            }
        }
        ti++
    }
    return -1
}

/// Returns the field type node for a named field, or null if not found.
fn find_field_type_node(
    ctx: ref SemaCtx,
    type_name: ref u8,
    field_name: ref u8
) ref parser.Node = trust {
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val td_node: ref parser.Node = td as ref parser.Node
            val td_name: ref u8 = parser.node_str_raw(td_node.d1)
            if string.raw_cmp(td_name, type_name) == 0 {
                val fields: ref void = td_node.d2 as ref void
                if fields != none {
                    val flen: i64 = @len(fields) as i64
                    val fi: mut i64 = 0
                    for {
                        if fi >= flen {
                            break
                        }
                        val f_opt = @get(fields, fi as usize)
                        if f_opt is some f {
                            val fnode: ref parser.Node = f as ref parser.Node
                            val fname: ref u8 = parser.node_str_raw(fnode.d0)
                            if string.raw_cmp(fname, field_name) == 0 {
                                return fnode.d2 as ref parser.Node
                            }
                        }
                        fi++
                    }
                }
                return none
            }
        }
        ti++
    }
    return none
}

/// Extracts the innermost named type string from a type node (strips ref/mut wrappers).
fn extract_type_name(ty_node: ref parser.Node) ref u8 = trust {
    val cur: mut ref parser.Node = ty_node
    for {
        if cur == none {
            return none
        }
        if cur.kind == parser.TY_NAMED {
            return parser.node_str_raw(cur.d0)
        }
        if cur.kind == parser.TY_MUT || cur.kind == parser.TY_REF {
            cur = cur.d0 as ref parser.Node
        } else {
            return none
        }
    }
    return none
}

fn unwrap_mut_type(ty_node: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = ty_node
    for {
        if cur == none {
            return none
        }
        if cur.kind == parser.TY_MUT {
            cur = cur.d0 as ref parser.Node
            continue
        }
        return cur
    }
    return none
}

/// Returns 0 (no wrap), 1 (result), or 2 (option) for a type node,
/// peeling through TY_MUT.
fn ty_wrap_kind(ty: ref parser.Node) i64 = trust {
    val cur: mut ref parser.Node = ty
    for {
        if cur == none {
            return 0
        }
        val k: i64 = cur.kind
        if k == parser.TY_RESULT {
            return 1
        }
        if k == parser.TY_OPTION {
            return 2
        }
        if k == parser.TY_MUT {
            cur = cur.d0 as ref parser.Node
            continue
        }
        return 0
    }
    return 0
}

/// Find a function definition in ctx.fn_defs matching target_name (and optional namespace).
fn find_fn_def_local(
    ctx: ref SemaCtx,
    target_name: ref u8,
    target_ns: ref u8
) ref parser.Node = trust {
    if target_name == none {
        return none
    }
    val lookup_ns: ref u8 = spec_impl_name(ctx, target_ns)
    val flen: i64 = @len(ctx.fn_defs) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(ctx.fn_defs, fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val fname_node1: ref u8 = parser.node_str_raw(fnode.d1)
            val fname_node2: ref u8 = parser.node_str_raw(fnode.d2)
            val is_match: mut bool = false
            if target_ns != none {
                if fname_node1 != none && fname_node2 != none {
                    if string.raw_cmp(fname_node1, lookup_ns) == 0 &&
                    string.raw_cmp(fname_node2, target_name) == 0 {
                        is_match = true
                    }
                }
            } else {
                if fname_node1 != none {
                    if string.raw_cmp(fname_node1, target_name) == 0 {
                        is_match = true
                    }
                }
                if fname_node2 != none {
                    if string.raw_cmp(fname_node2, target_name) == 0 {
                        is_match = true
                    }
                }
            }
            if is_match {
                return fnode
            }
        }
        fi++
    }
    return none
}

/// Find a function in an imported module by name and optional namespace.
fn find_fn_in_module_with_ns(
    mod: ref modinfo.ResolvedModule,
    ns: ref u8,
    name: ref u8
) ref parser.Node = trust {
    if mod == none {
        return none
    }
    if name == none {
        return none
    }
    val items: list[ref parser.Node] = modinfo.module_items(mod)
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
            val item_ns: ref u8 = parser.node_str_raw(item.d1)
            val item_nm: ref u8 = parser.node_str_raw(item.d2)
            if item_nm == none {
                continue
            }
            if !string.str_eql(item_nm, name) {
                continue
            }
            if ns == none {
                return item
            }
            if item_ns != none && string.str_eql(item_ns, ns) {
                return item
            }
        } elif k == parser.NK_EXTERN_FN {
            if ns != none {
                continue
            }
            val ename: ref u8 = parser.node_str_raw(item.d1)
            if ename != none && string.str_eql(ename, name) {
                return item
            }
        }
    }
    return none
}

/// Find an imported module by alias name on root_mod.
fn find_imported_mod(ctx: ref SemaCtx, alias: ref u8) ref modinfo.ResolvedModule = trust {
    if ctx == none {
        return none
    }
    if alias == none {
        return none
    }
    val rmod: ref modinfo.ResolvedModule = ctx.root_mod
    if rmod == none {
        return none
    }
    val n: i64 = modinfo.import_count(rmod)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val mname: ref u8 = modinfo.import_name_at(rmod, i as usize)
        if mname != none && string.str_eql(mname, alias) {
            return modinfo.import_module_at(rmod, i as usize)
        }
        i++
    }
    val j: mut i64 = 0
    for {
        if j >= n {
            break
        }
        val imported: ref modinfo.ResolvedModule = modinfo.import_module_at(rmod, j as usize)
        if imported != none {
            val canonical_prefix: ref u8 = canonical_type_prefix_for_imported_module(ctx, imported)
            val emitted_prefix: ref u8 = emitted_type_prefix_for_imported_module(ctx, imported)
            if ((canonical_prefix != none && string.str_eql(canonical_prefix, alias)) ||
                (emitted_prefix != none && string.str_eql(emitted_prefix, alias))) {
                return imported
            }
        }
        j++
    }
    return none
}

/// Resolve a NK_CALL's callee node to the actual function definition node, if findable.
/// Handles: bare name, Type.fn (local), module.fn, and module.Type.fn forms.
fn resolve_called_fn(ctx: ref SemaCtx, callee: ref parser.Node) ref parser.Node = trust {
    if callee == none {
        return none
    }
    val base: ref parser.Node = unwrap_generic_callee(callee)
    if base == none {
        return none
    }

    if base.kind == parser.NK_IDENT {
        val nm: ref u8 = parser.node_str_raw(base.d0)
        return find_fn_def_local(ctx, nm, none)
    }

    if base.kind == parser.NK_FIELD {
        val fname: ref u8 = parser.field_name_raw(base)
        val fbase: ref parser.Node = parser.field_base(base)
        if fbase == none {
            return none
        }

        if fbase.kind == parser.NK_IDENT {
            val fb_name: ref u8 = parser.node_str_raw(fbase.d0)
            val local: ref parser.Node = find_fn_def_local(ctx, fname, fb_name)
            if local != none {
                return local
            }
            val mm: ref modinfo.ResolvedModule = find_imported_mod(ctx, fb_name)
            if mm != none {
                return find_fn_in_module_with_ns(mm, none, fname)
            }
            return none
        }

        if fbase.kind == parser.NK_FIELD {
            val inner_base: ref parser.Node = parser.field_base(fbase)
            val inner_name: ref u8 = parser.field_name_raw(fbase)
            if inner_base != none && inner_base.kind == parser.NK_IDENT {
                val mod_name: ref u8 = parser.node_str_raw(inner_base.d0)
                val mm2: ref modinfo.ResolvedModule = find_imported_mod(ctx, mod_name)
                if mm2 != none {
                    return find_fn_in_module_with_ns(mm2, inner_name, fname)
                }
            }
        }
    }
    return none
}

/// Returns 0/1/2 for the wrap kind (none/result/option) of a function's return type.
fn fn_return_wrap_kind(fn_node: ref parser.Node) i64 = trust {
    if fn_node == none {
        return 0
    }
    val k: i64 = fn_node.kind
    if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
        return ty_wrap_kind(fn_node.d4 as ref parser.Node)
    }
    if k == parser.NK_EXTERN_FN {
        return ty_wrap_kind(fn_node.d5 as ref parser.Node)
    }
    return 0
}

/// Find a typedef (NK_TYPEDEF or NK_EXTERN_TYPE) by name. Supports module-qualified
/// names like "allocators.Arena" by looking up the module on root_mod.
fn find_typedef_in_items(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    type_name: ref u8
) ref parser.Node = trust {
    for item in items {
        if item == none {
            continue
        }
        if item.kind == parser.NK_TYPEDEF || item.kind == parser.NK_EXTERN_TYPE {
            val nm: ref u8 = parser.node_str_raw(item.d1)
            if nm != none && string.str_eql(nm, type_name) {
                return item
            }
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val selected: ref void = sema_select_when_branch(ctx, item)
            if selected != none {
                val found: ref parser.Node = find_typedef_in_items(
                    ctx,
                    selected as list[ref parser.Node],
                    type_name
                )
                if found != none {
                    return found
                }
            }
        }
    }
    return none
}

fn find_typedef_anywhere(ctx: ref SemaCtx, type_name: ref u8) ref parser.Node = trust {
    if type_name == none {
        return none
    }
    val nlen: i64 = string.len_raw(type_name)
    val dot_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        val c: u8 = @load8(@ptradd(type_name, i))
        if c == 46 {
            dot_idx = i
        }
        i++
    }
    if dot_idx > 0 {
        val mod_name_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            ((dot_idx + 1) as usize) as usize
        ) as ref u8
        @memcpy(mod_name_buf, type_name, dot_idx as usize)
        @store8(@ptradd(mod_name_buf, dot_idx), 0)
        val unqual: ref u8 = @ptradd(type_name, dot_idx + 1) as ref u8
        val mm: ref modinfo.ResolvedModule = find_imported_mod(ctx, mod_name_buf)
        if mm != none {
            val found_mm: ref parser.Node = find_typedef_in_items(
                ctx,
                modinfo.module_items(mm),
                unqual
            )
            if found_mm != none {
                return found_mm
            }
        }
        return none
    }
    val local: ref parser.Node = sema_lookup_typedef(ctx, type_name)
    if local != none {
        return local
    }
    return none
}

/// Returns true for item kinds that declare a named type.
fn sema_is_type_def_kind(k: i64) bool = trust {
    return k == parser.NK_TYPEDEF || k == parser.NK_EXTERN_TYPE ||
    k == parser.NK_ENUMDEF || k == parser.NK_UNIONDEF ||
    k == parser.NK_TAGGED_UNIONDEF || k == parser.NK_SPEC
}

fn find_type_def_in_items(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    type_name: ref u8
) ref parser.Node = trust {
    for item in items {
        if item == none {
            continue
        }
        if sema_is_type_def_kind(item.kind) {
            val nm: ref u8 = parser.node_str_raw(item.d1)
            if nm != none && string.str_eql(nm, type_name) {
                return item
            }
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val selected: ref void = sema_select_when_branch(ctx, item)
            if selected != none {
                val found: ref parser.Node = find_type_def_in_items(
                    ctx,
                    selected as list[ref parser.Node],
                    type_name
                )
                if found != none {
                    return found
                }
            }
        }
    }
    return none
}

fn find_type_def_in_module_tree(
    ctx: ref SemaCtx,
    mod: ref modinfo.ResolvedModule,
    type_name: ref u8
) ref parser.Node = trust {
    if mod == none {
        return none
    }
    val found: ref parser.Node = find_type_def_in_items(
        ctx,
        modinfo.module_items(mod),
        type_name
    )
    if found != none {
        return found
    }
    val n: i64 = modinfo.import_count(mod)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val child: ref modinfo.ResolvedModule = modinfo.import_module_at(mod, i as usize)
        val child_found: ref parser.Node = find_type_def_in_module_tree(ctx, child, type_name)
        if child_found != none {
            return child_found
        }
        i++
    }
    return none
}

/// Resolve whether a named type exists, including types declared in imported
/// modules (both qualified and unqualified through `use`).
fn sema_type_name_known(ctx: ref SemaCtx, type_name: ref u8) bool = trust {
    if type_name == none || string.str_eql(type_name, c"") {
        return true
    }
    if is_builtin_type_name(type_name) || is_type_parameter(ctx, type_name) ||
    string.str_eql(type_name, c"self") {
        return true
    }
    for registered in ctx.type_names {
        if registered != none && string.str_eql(registered as ref u8, type_name) {
            return true
        }
    }
    if sema_lookup_typedef(ctx, type_name) != none ||
    sema_lookup_uniondef(ctx, type_name) != none ||
    sema_lookup_enumdef(ctx, type_name) != none ||
    sema_lookup_tagged_uniondef(ctx, type_name) != none {
        return true
    }

    val nlen: i64 = string.len_raw(type_name)
    val dot_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        if @load8(@ptradd(type_name, i)) == 46 {
            dot_idx = i
            break
        }
        i++
    }
    if dot_idx > 0 {
        val mod_name_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            ((dot_idx + 1) as usize) as usize
        ) as ref u8
        @memcpy(mod_name_buf, type_name, dot_idx as usize)
        @store8(@ptradd(mod_name_buf, dot_idx), 0)
        val unqual: ref u8 = @ptradd(type_name, dot_idx + 1) as ref u8
        val mm: ref modinfo.ResolvedModule = find_imported_mod(ctx, mod_name_buf)
        if mm == none {
            return false
        }
        return find_type_def_in_items(
            ctx,
            modinfo.module_items(mm),
            unqual
        ) != none
    }

    val root: ref modinfo.ResolvedModule = ctx.root_mod
    if root == none {
        return false
    }
    return find_type_def_in_module_tree(ctx, root, type_name) != none
}

fn sema_validate_type_node(
    ctx: ref SemaCtx,
    ty: ref parser.Node,
    filename: ref u8,
    line: i64,
    what: ref u8,
    fn_name: ref u8
) void = trust {
    if ty == none {
        return
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        val name: ref u8 = parser.node_str_raw(ty.d0)
        if !sema_type_name_known(ctx, name) {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(
                buf,
                512,
                "{s}:{lld}: unknown type '{s}' in {s} of function '{s}'",
                {filename, line, name, what, fn_name}
            )
            add_error(ctx, buf)
        }
        return
    }
    if k == parser.TY_REF || k == parser.TY_MUT || k == parser.TY_OPTION ||
    k == parser.TY_LIST || k == parser.TY_SLICE {
        sema_validate_type_node(
            ctx,
            ty.d0 as ref parser.Node,
            filename,
            line,
            what,
            fn_name
        )
        return
    }
    if k == parser.TY_RESULT {
        sema_validate_type_node(
            ctx,
            ty.d0 as ref parser.Node,
            filename,
            line,
            what,
            fn_name
        )
        sema_validate_type_node(
            ctx,
            ty.d1 as ref parser.Node,
            filename,
            line,
            what,
            fn_name
        )
        return
    }
    if k == parser.TY_FIXED_ARR {
        sema_validate_type_node(
            ctx,
            ty.d1 as ref parser.Node,
            filename,
            line,
            what,
            fn_name
        )
        return
    }
    if k == parser.TY_FNPTR {
        val params: ref void = ty.d0 as ref void
        if params != none {
            for p in params as list[ref parser.Node] {
                sema_validate_type_node(ctx, p, filename, line, what, fn_name)
            }
        }
        sema_validate_type_node(
            ctx,
            ty.d1 as ref parser.Node,
            filename,
            line,
            what,
            fn_name
        )
    }
}

fn sema_named_in_list(names: list[ref u8], name: ref u8) bool = trust {
    for n in names {
        if n != none && string.str_eql(n as ref u8, name) {
            return true
        }
    }
    return false
}

/// True when `ty` contains `target` without passing through a ref/list/slice.
fn sema_type_contains_recursive(
    ctx: ref SemaCtx,
    ty: ref parser.Node,
    target: ref u8,
    seen: mut list[ref u8],
    depth: i64
) bool = trust {
    if ty == none || depth > 64 {
        return false
    }
    val k: i64 = ty.kind
    if k == parser.TY_REF || k == parser.TY_LIST || k == parser.TY_SLICE {
        return false
    }
    if k == parser.TY_MUT || k == parser.TY_OPTION || k == parser.TY_RESULT {
        if k == parser.TY_RESULT {
            if sema_type_contains_recursive(
                ctx,
                ty.d0 as ref parser.Node,
                target,
                seen,
                depth + 1
            ) {
                return true
            }
            return sema_type_contains_recursive(
                ctx,
                ty.d1 as ref parser.Node,
                target,
                seen,
                depth + 1
            )
        }
        return sema_type_contains_recursive(ctx, ty.d0 as ref parser.Node, target, seen, depth + 1)
    }
    if k == parser.TY_FIXED_ARR {
        return sema_type_contains_recursive(ctx, ty.d1 as ref parser.Node, target, seen, depth + 1)
    }
    if k != parser.TY_NAMED {
        return false
    }
    val name: ref u8 = parser.node_str_raw(ty.d0)
    if name == none || string.str_eql(name, c"") {
        return false
    }
    if string.str_eql(name, target) {
        return true
    }
    if sema_named_in_list(seen, name) {
        return false
    }
    val td: ref parser.Node = sema_lookup_typedef(ctx, name)
    if td == none || td.kind != parser.NK_TYPEDEF {
        return false
    }
    val fields: ref void = td.d2 as ref void
    if fields == none {
        return false
    }
    @append(seen, name)
    for f in fields as list[ref parser.Node] {
        if f != none {
            if sema_type_contains_recursive(
                ctx,
                f.d2 as ref parser.Node,
                target,
                seen,
                depth + 1
            ) {
                return true
            }
        }
    }
    return false
}

fn sema_check_recursive_types(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    filename: ref u8
) void = trust {
    for item in items {
        if item == none || item.kind != parser.NK_TYPEDEF {
            continue
        }
        val tname: ref u8 = parser.node_str_raw(item.d1)
        val fields: ref void = item.d2 as ref void
        if tname == none || fields == none {
            continue
        }
        for f in fields as list[ref parser.Node] {
            if f == none {
                continue
            }
            val fty: ref parser.Node = f.d2 as ref parser.Node
            if fty == none {
                continue
            }
            val seen: mut list[ref u8] = mem.new[ref u8]()
            if sema_type_contains_recursive(ctx, fty, tname, seen, 0) {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: recursive type '{s}' has infinite size; use a reference, for example 'option[ref {s}]'",
                    {filename, f.line, tname, tname}
                )
                add_error(ctx, buf)
                break
            }
        }
    }
}

/// Validate parameter and return types of a function declaration.
fn sema_validate_fn_types(
    ctx: ref SemaCtx,
    fn_node: ref parser.Node,
    filename: ref u8
) void = trust {
    val fn_name: ref u8 = parser.node_str_raw(fn_node.d2)
    val params: ref void = fn_node.d3 as ref void
    if params != none {
        for p in params as list[ref parser.Node] {
            if p == none {
                continue
            }
            val pname: ref u8 = parser.node_str_raw(p.d0)
            val pty: ref parser.Node = p.d1 as ref parser.Node
            val what: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (128) as usize
            ) as ref u8
            @snprintf(what, 128, "parameter '{s}'", {pname})
            sema_validate_type_node(ctx, pty, filename, p.line, what, fn_name)
        }
    }
    sema_validate_type_node(
        ctx,
        fn_node.d4 as ref parser.Node,
        filename,
        fn_node.line,
        c"return type",
        fn_name
    )
    if fn_node.kind == parser.NK_EXTERN_FN {
        val ret_k: i64 = ty_wrap_kind(fn_node.d4 as ref parser.Node)
        if ret_k == 1 || ret_k == 2 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(
                buf,
                512,
                "{s}:{lld}: extern function '{s}' cannot return option/result across the FFI boundary; return a ref or use an explicit ABI struct",
                {filename, fn_node.line, fn_name}
            )
            add_error(ctx, buf)
        }
    }
}

fn find_spec_in_items(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    spec_name: ref u8
) ref parser.Node = trust {
    for item in items {
        if item == none {
            continue
        }
        if item.kind == parser.NK_SPEC {
            val nm: ref u8 = parser.node_str_raw(item.d1)
            if nm != none && string.str_eql(nm, spec_name) {
                return item
            }
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val selected: ref void = sema_select_when_branch(ctx, item)
            if selected != none {
                val found: ref parser.Node = find_spec_in_items(
                    ctx,
                    selected as list[ref parser.Node],
                    spec_name
                )
                if found != none {
                    return found
                }
            }
        }
    }
    return none
}

fn find_spec_anywhere(ctx: ref SemaCtx, spec_name: ref u8) ref parser.Node = trust {
    if ctx == none || spec_name == none {
        return none
    }
    if ctx.root_mod == none {
        return none
    }
    val nlen: i64 = string.len_raw(spec_name)
    val dot_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        val c: u8 = @load8(@ptradd(spec_name, i))
        if c == 46 {
            dot_idx = i
            break
        }
        i++
    }
    if dot_idx > 0 {
        val mod_name_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            ((dot_idx + 1) as usize) as usize
        ) as ref u8
        @memcpy(mod_name_buf, spec_name, dot_idx as usize)
        @store8(@ptradd(mod_name_buf, dot_idx), 0)
        val unqual: ref u8 = @ptradd(spec_name, dot_idx + 1) as ref u8
        val mm: ref modinfo.ResolvedModule = find_imported_mod(ctx, mod_name_buf)
        if mm == none {
            return none
        }
        return find_spec_in_items(ctx, modinfo.module_items(mm), unqual)
    }
    return find_spec_in_items(ctx, modinfo.module_items(ctx.root_mod), spec_name)
}

/// Returns the wrap kind (0=none, 1=result, 2=option) of an expression's value.
/// Note: if you have just 'none'/'some'/'ok'/'err' literals, they return 0 here because in spectre
/// 'none' is also used as a null-pointer sentinel and can be passed to ref-typed
/// parameters; only values whose wrappedness comes from a function return type
/// or an explicit cast are reported.
fn expr_wrap_kind(ctx: ref SemaCtx, expr: ref parser.Node) i64 = trust {
    if expr == none {
        return 0
    }
    val k: i64 = expr.kind
    if k == parser.NK_TRY {
        return 0
    }
    if k == parser.NK_TRUST {
        return expr_wrap_kind(ctx, expr.d0 as ref parser.Node)
    }
    if k == parser.NK_CAST {
        return ty_wrap_kind(expr.d1 as ref parser.Node)
    }
    if k == parser.NK_BUILTIN {
        val bname: ref u8 = parser.node_str_raw(expr.d0)
        if string.str_eql(
            bname,
            c"get"
        ) || string.str_eql(bname, c"getref") || string.str_eql(bname, c"getmut") {
            return 2
        }
        if string.str_eql(bname, c"argsalloc") || string.str_eql(bname, c"listalloc") ||
        string.str_eql(bname, c"list") {
            return 1
        }
        if string.str_eql(bname, c"fmtalloc") {
            val targs: list[ref parser.Node] = parser.builtin_type_args(expr)
            if (@len(targs) as i64) > 0 {
                return 1
            }
            return 0
        }
        // Transitional: the raw @args form remains until all call sites are
        // migrated to @argsalloc.
        if string.str_eql(bname, c"args") {
            return 3
        }
        return 0
    }
    if k == parser.NK_CALL {
        val callee: ref parser.Node = parser.call_callee(expr)
        val fn_node: ref parser.Node = resolve_called_fn(ctx, callee)
        return fn_return_wrap_kind(fn_node)
    }
    if k == parser.NK_IDENT {
        return scope_lookup_wrap_kind(ctx, parser.node_str_raw(expr.d0))
    }
    return 0
}

fn scope_defined_local(ctx: ref SemaCtx, name: ref u8) bool = trust {
    val len: usize = @len(ctx.scopes)
    if len == 0 {
        return false
    }
    val frame_opt = @get(ctx.scopes, len - 1)
    if frame_opt is some frame {
        val flen: i64 = @len(frame) as i64
        val j: mut i64 = 0
        for {
            if j >= flen {
                break
            }
            val e_opt = @get(frame, j as usize)
            if e_opt is some e {
                val entry: ref ScopeEntry = e as ref ScopeEntry
                if string.raw_cmp(entry.name, name) == 0 {
                    return true
                }
            }
            j++
        }
    }
    return false
}

/// Check if a type name is a type parameter.
fn is_type_parameter(ctx: ref SemaCtx, tname: ref u8) bool = trust {
    if tname == none {
        return false
    }

    for tp in ctx.type_params {
        if string.str_eql(tp as ref u8, tname) {
            return true
        }
    }

    return false
}

fn spec_impl_name(ctx: ref SemaCtx, spec_name: ref u8) ref u8 = trust {
    if spec_name == none {
        return none
    }
    val slen: i64 = @len(ctx.spec_names) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(ctx.spec_names, si as usize)
        if s_opt is some s {
            if string.str_eql(s as ref u8, spec_name) {
                val impl_opt = @get(ctx.spec_impls, si as usize)
                if impl_opt is some impln {
                    return impln as ref u8
                } else {
                    return spec_name
                }
            }
        }
        si++
    }
    return spec_name
}

fn type_node_matches_impl_type(
    spec_ty: ref parser.Node,
    impl_ty: ref parser.Node,
    impl_name: ref u8
) bool = trust {
    if spec_ty == none || impl_ty == none {
        return false
    }
    if spec_ty.kind != impl_ty.kind {
        return false
    }
    if spec_ty.kind == parser.TY_MUT {
        return type_node_matches_impl_type(
            spec_ty.d0 as ref parser.Node,
            impl_ty.d0 as ref parser.Node,
            impl_name
        )
    }
    if spec_ty.kind == parser.TY_NAMED {
        val sname: ref u8 = parser.node_str_raw(spec_ty.d0)
        if string.str_eql(sname, c"self") {
            return string.str_eql(impl_name, parser.node_str_raw(impl_ty.d0))
        }
        return string.str_eql(sname, parser.node_str_raw(impl_ty.d0))
    }
    if spec_ty.kind == parser.TY_REF || spec_ty.kind == parser.TY_OPTION ||
    spec_ty.kind == parser.TY_LIST || spec_ty.kind == parser.TY_SLICE {
        return type_node_matches_impl_type(
            spec_ty.d0 as ref parser.Node,
            impl_ty.d0 as ref parser.Node,
            impl_name
        )
    }
    if spec_ty.kind == parser.TY_RESULT {
        return type_node_matches_impl_type(
            spec_ty.d0 as ref parser.Node,
            impl_ty.d0 as ref parser.Node,
            impl_name
        ) &&
        type_node_matches_impl_type(
            spec_ty.d1 as ref parser.Node,
            impl_ty.d1 as ref parser.Node,
            impl_name
        )
    }
    if spec_ty.kind == parser.TY_VOID {
        return true
    }
    return false
}

fn function_matches_spec_method(
    spec_fn: ref parser.Node,
    impl_fn: ref parser.Node,
    impl_name: ref u8
) bool = trust {
    if spec_fn == none || impl_fn == none {
        return false
    }
    if spec_fn.d0 != impl_fn.d0 {
        return false
    }
    val spec_params: ref void = spec_fn.d3 as ref void
    val impl_params: ref void = impl_fn.d3 as ref void
    if spec_params == none || impl_params == none {
        return spec_params == impl_params
    }
    if @len(spec_params as list[ref parser.Node]) as i64 != @len(impl_params as list[ref parser.Node]) as i64 {
        return false
    }
    val plen: i64 = @len(spec_params as list[ref parser.Node]) as i64
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        val sp_opt = @get(spec_params as list[ref parser.Node], pi as usize)
        val ip_opt = @get(impl_params as list[ref parser.Node], pi as usize)
        if sp_opt is some sp {
            if ip_opt is some ip {
                val spn: ref parser.Node = sp as ref parser.Node
                val ipn: ref parser.Node = ip as ref parser.Node
                if !type_node_matches_impl_type(
                    spn.d1 as ref parser.Node,
                    ipn.d1 as ref parser.Node,
                    impl_name
                ) {
                    return false
                }
            } else {
                return false
            }
        } else {
            return false
        }
        pi++
    }
    return type_node_matches_impl_type(
        spec_fn.d4 as ref parser.Node,
        impl_fn.d4 as ref parser.Node,
        impl_name
    )
}

fn find_top_level_fn(
    items: list[ref parser.Node],
    ns: ref u8,
    name: ref u8
) ref parser.Node = trust {
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
            if string.str_eql(
                parser.node_str_raw(item.d1),
                ns
            ) && string.str_eql(parser.node_str_raw(item.d2), name) {
                return item
            }
        }
    }
    return none
}

fn validate_spec_impls(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    filename: ref u8
) void = trust {
    for item in items {
        if item == none || item.kind != parser.NK_SPEC {
            continue
        }
        val spec_name: ref u8 = parser.node_str_raw(item.d1)
        val methods: ref void = item.d2 as ref void
        if methods == none {
            continue
        }
        val impls: mut list[ref u8] = mem.new[ref u8]()
        for impl_item in items {
            if impl_item != none && impl_item.kind == parser.NK_TYPEDEF {
                if string.str_eql(parser.node_str_raw(impl_item.d4), spec_name) {
                    @append(impls, parser.node_str_raw(impl_item.d1))
                }
            }
        }
        if @len(impls) as i64 == 0 {
            if item.d0 == 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(
                    ebuf,
                    256,
                    "{s}: spec '{s}' has no implementing type",
                    {filename, spec_name}
                )
                add_error(ctx, ebuf)
            }
            continue
        }
        for impl_name in impls {
            for meth in methods as list[ref parser.Node] {
                if meth == none {
                    continue
                }
                val meth_name: ref u8 = parser.node_str_raw(meth.d2)
                val impl_fn: ref parser.Node = find_top_level_fn(items, impl_name, meth_name)
                if impl_fn == none {
                    val ebuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    @snprintf(ebuf2, 512, "{s}: spec '{s}' is unimplemented for '{s}': missing function '{s}'",
                        {filename, spec_name, impl_name, meth_name})
                    add_error(ctx, ebuf2)
                } elif !function_matches_spec_method(meth, impl_fn, impl_name) {
                    val ebuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    @snprintf(ebuf3, 512, "{s}: spec '{s}' is only partially implemented for '{s}': function '{s}' has a mismatched signature",
                        {filename, spec_name, impl_name, meth_name})
                    add_error(ctx, ebuf3)
                }
            }
        }
    }
}

fn validate_derived_specs_in_items(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    filename: ref u8
) void = trust {
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_TYPEDEF || k == parser.NK_EXTERN_TYPE {
            val spec_name: ref u8 = parser.node_str_raw(item.d4)
            if spec_name != none {
                val has_dot: mut bool = false
                val i: mut i64 = 0
                for {
                    val c: u8 = @load8(@ptradd(spec_name, i))
                    if c == 0 {
                        break
                    }
                    if c == 46 {
                        has_dot = true
                        break
                    }
                    i++
                }
                if !has_dot {
                    val spec_def: ref parser.Node = find_spec_anywhere(ctx, spec_name)
                    if spec_def == none {
                        val type_name: ref u8 = parser.node_str_raw(item.d1)
                        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (512) as usize
                        ) as ref u8
                        @snprintf(ebuf, 512, "{s}:{lld}: type '{s}' derives unknown spec '{s}'",
                            {filename, item.line, type_name, spec_name})
                        add_error(ctx, ebuf)
                    }
                }
            }
            continue
        }
        if k == parser.NK_WHEN_ITEMS {
            val selected: ref void = sema_select_when_branch(ctx, item)
            if selected != none {
                validate_derived_specs_in_items(ctx, selected as list[ref parser.Node], filename)
            }
        }
    }
}

fn validate_derived_specs(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    filename: ref u8
) void = trust {
    validate_derived_specs_in_items(ctx, items, filename)
}

/// Extract the unqualified type name from a potentially qualified name.
fn unqualified_type_name(tname: ref u8) ref u8 = trust {
    if tname == none {
        return tname
    }
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(tname, i))
        if c == 0 {
            break
        }
        if c == 46 {
            last_dot = i
        }
        i++
    }
    if last_dot >= 0 {
        return @ptradd(tname, last_dot + 1) as ref u8
    }
    return tname
}

fn qualified_owner_prefix(ctx: ref SemaCtx, name: ref u8) ref u8 = trust {
    if name == none {
        return none
    }
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(name, i))
        if c == 0 {
            break
        }
        if c == 46 {
            last_dot = i
        }
        i++
    }
    if last_dot < 0 {
        return none
    }
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        ((last_dot + 1) as usize) as usize
    ) as ref u8
    @memcpy(out, name, last_dot as usize)
    @store8(@ptradd(out, last_dot), 0)
    return out
}

fn is_builtin_type_name(name: ref u8) bool = trust {
    if name == none {
        return false
    }
    if sema_type_name_is_numeric(name) {
        return true
    }
    return string.str_eql(name, c"char") || string.str_eql(name, c"void")
}

fn imported_owner_prefix_for_callee(ctx: ref SemaCtx, callee: ref parser.Node) ref u8 = trust {
    val base: ref parser.Node = unwrap_generic_callee(callee)
    if base == none {
        return none
    }
    val root: ref parser.Node = find_root_ident(base)
    if root == none || root.kind != parser.NK_IDENT {
        return none
    }
    val root_name: ref u8 = parser.node_str_raw(root.d0)
    if root_name == none {
        return none
    }
    if find_import_module(ctx, root_name) != none {
        return root_name
    }
    return none
}

fn qualify_type_name_for_callee(
    ctx: ref SemaCtx,
    callee: ref parser.Node,
    type_name: ref u8
) ref u8 = trust {
    if type_name == none {
        return none
    }
    if string.str_eql(type_name, c"") {
        return type_name
    }
    if is_type_parameter(ctx, type_name) {
        return type_name
    }
    if is_builtin_type_name(type_name) {
        return type_name
    }
    val tlen: i64 = string.len_raw(type_name)
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val c: u8 = @load8(@ptradd(type_name, ti))
        if c == 46 {
            return type_name
        }
        ti++
    }
    val owner_prefix: ref u8 = imported_owner_prefix_for_callee(ctx, callee)
    if owner_prefix == none {
        return type_name
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
    @snprintf(buf, 512, "{s}.{s}", {owner_prefix, type_name})
    return buf
}

fn canonical_type_prefix_for_imported_module(
    ctx: ref SemaCtx,
    imported: ref modinfo.ResolvedModule
) ref u8 = trust {
    if imported == none {
        return none
    }
    val fname: ref u8 = canonicalize_path(ctx, modinfo.module_filename(imported))
    if fname == none {
        return none
    }
    val len: i64 = string.len_raw(fname)
    if len <= 0 {
        return none
    }

    val end: mut i64 = len
    if len >= 8 {
        val tail_core: ref u8 = @ptradd(fname, len - 8) as ref u8
        if string.str_eql(tail_core, c"/core.sx") {
            end = len - 8
        }
    }
    if end == len >= 3 {
        val c0: u8 = @load8(@ptradd(fname, len - 3))
        val c1: u8 = @load8(@ptradd(fname, len - 2))
        val c2: u8 = @load8(@ptradd(fname, len - 1))
        if c0 == 46 && c1 == 115 && c2 == 120 {
            end = len - 3
        }
    }
    if end <= 0 {
        return none
    }

    val start: mut i64 = end - 1
    for {
        if start < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(fname, start))
        if c == 47 {
            start++
            break
        }
        start--
    }
    if start < 0 {
        start = 0
    }
    val out_len: i64 = end - start
    if out_len <= 0 {
        return none
    }
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        ((out_len + 1) as usize) as usize
    ) as ref u8
    @memcpy(out, @ptradd(fname, start), out_len as usize)
    @store8(@ptradd(out, out_len), 0)
    return out
}

fn path_contains_segment(path: ref u8, segment: ref u8) bool = trust {
    if path == none || segment == none {
        return false
    }
    val plen: i64 = string.len_raw(path)
    val slen: i64 = string.len_raw(segment)
    if slen <= 0 || plen < slen {
        return false
    }
    val i: mut i64 = 0
    for {
        if i + slen > plen {
            break
        }
        val candidate: ref u8 = @ptradd(path, i) as ref u8
        val matched: mut bool = true
        val j: mut i64 = 0
        for {
            if j >= slen {
                break
            }
            val pc: u8 = @load8(@ptradd(candidate, j))
            val sc: u8 = @load8(@ptradd(segment, j))
            if pc != sc {
                matched = false
                break
            }
            j++
        }
        if matched {
            return true
        }
        i++
    }
    return false
}

fn emitted_type_prefix_for_imported_module(
    ctx: ref SemaCtx,
    imported: ref modinfo.ResolvedModule
) ref u8 = trust {
    if imported == none {
        return none
    }
    val fname: ref u8 = canonicalize_path(ctx, modinfo.module_filename(imported))
    if fname == none {
        return none
    }
    if path_contains_segment(fname, c"/spectrelib/") {
        return canonical_type_prefix_for_imported_module(ctx, imported)
    }
    if ctx != none && ctx.root_mod != none {
        val n: i64 = modinfo.import_count(ctx.root_mod)
        val i: mut i64 = 0
        for {
            if i >= n {
                break
            }
            val imported_mod: ref modinfo.ResolvedModule = modinfo.import_module_at(
                ctx.root_mod,
                i as usize
            )
            if imported_mod != none {
                val imported_fname: ref u8 = canonicalize_path(
                    ctx,
                    modinfo.module_filename(imported_mod)
                )
                if imported_fname != none && string.str_eql(imported_fname, fname) {
                    val alias_name: ref u8 = modinfo.import_name_at(ctx.root_mod, i as usize)
                    if alias_name != none {
                        return alias_name
                    }
                }
            }
            i++
        }
    }
    return canonical_type_prefix_for_imported_module(ctx, imported)
}

fn canonicalize_import_alias_type_name(ctx: ref SemaCtx, type_name: ref u8) ref u8 = trust {
    if type_name == none {
        return none
    }
    if string.str_eql(type_name, c"") {
        return type_name
    }
    val owner: ref u8 = qualified_owner_prefix(ctx, type_name)
    if owner == none {
        return type_name
    }
    val imported: ref modinfo.ResolvedModule = find_imported_mod(ctx, owner)
    if imported == none {
        return type_name
    }
    val canonical_prefix: ref u8 = emitted_type_prefix_for_imported_module(ctx, imported)
    if canonical_prefix == none || string.str_eql(canonical_prefix, owner) {
        return type_name
    }
    val inner_name: ref u8 = unqualified_type_name(type_name)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
    @snprintf(buf, 512, "{s}.{s}", {canonical_prefix, inner_name})
    return buf
}

fn canonicalize_import_aliases_in_type_node(
    ctx: ref SemaCtx,
    ty_node: ref parser.Node
) void = trust {
    if ty_node == none {
        return
    }
    val k: i64 = ty_node.kind
    if k == parser.TY_NAMED {
        parser.node_store_string_slot(
            @addr(ty_node.d0),
            canonicalize_import_alias_type_name(ctx, parser.node_str_raw(ty_node.d0))
        )
        return
    }
    if k == parser.TY_MUT || k == parser.TY_REF || k == parser.TY_OPTION || k == parser.TY_LIST || k == parser.TY_SLICE {
        canonicalize_import_aliases_in_type_node(ctx, ty_node.d0 as ref parser.Node)
        return
    }
    if k == parser.TY_RESULT {
        canonicalize_import_aliases_in_type_node(ctx, ty_node.d0 as ref parser.Node)
        canonicalize_import_aliases_in_type_node(ctx, ty_node.d1 as ref parser.Node)
        return
    }
    if k == parser.TY_FIXED_ARR {
        canonicalize_import_aliases_in_type_node(ctx, ty_node.d1 as ref parser.Node)
        return
    }
    if k == parser.TY_FNPTR {
        val params: ref void = ty_node.d0 as ref void
        if params != none {
            for param_ty in params as list[ref parser.Node] {
                canonicalize_import_aliases_in_type_node(ctx, param_ty)
            }
        }
        canonicalize_import_aliases_in_type_node(ctx, ty_node.d1 as ref parser.Node)
    }
}

fn canonicalize_generic_inst_type_args(ctx: ref SemaCtx, callee: ref parser.Node) void = trust {
    if callee == none || callee.kind != parser.NK_GENERIC_INST {
        return
    }
    val targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    for targ in targs {
        canonicalize_import_aliases_in_type_node(ctx, targ)
    }
}

/// Check if two type names are compatible, considering:
///
/// - Safe numeric conversions (i32 -> i64, u8 -> i64, etc.)
fn types_compatible(ctx: ref SemaCtx, param_type: ref u8, arg_type: ref u8) bool = trust {
    if string.str_eql(param_type, arg_type) {
        return true
    }

    val param_unqual: ref u8 = unqualified_type_name(param_type)
    val arg_unqual: ref u8 = unqualified_type_name(arg_type)

    // `StringView` is a compiler-known structural type. A plain string
    // literal has this shape even when std/string is not imported, while an
    // imported `std/string` declaration is qualified as `str.StringView`.
    if string.str_eql(param_unqual, c"StringView") && string.str_eql(arg_unqual, c"StringView") {
        return true
    }

    if string.str_eql(spec_impl_name(ctx, param_type), arg_type) {
        return true
    }
    if string.str_eql(spec_impl_name(ctx, arg_type), param_type) {
        return true
    }
    if string.str_eql(param_type, param_unqual) && string.str_eql(arg_type, arg_unqual) {
        if string.str_eql(spec_impl_name(ctx, param_unqual), arg_unqual) {
            return true
        }
        if string.str_eql(spec_impl_name(ctx, arg_unqual), param_unqual) {
            return true
        }
    }

    if string.str_eql(param_unqual, c"i64") {
        if string.str_eql(
            arg_unqual,
            c"i8"
        ) || string.str_eql(arg_unqual, c"i16") || string.str_eql(arg_unqual, c"i32") ||
        string.str_eql(
            arg_unqual,
            c"u8"
        ) || string.str_eql(arg_unqual, c"u16") || string.str_eql(arg_unqual, c"u32") ||
        string.str_eql(
            arg_unqual,
            c"usize"
        ) || string.str_eql(arg_unqual, c"isize") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"i32") {
        if string.str_eql(arg_unqual, c"i8") || string.str_eql(arg_unqual, c"i16") ||
        string.str_eql(
            arg_unqual,
            c"u8"
        ) || string.str_eql(arg_unqual, c"u16") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"i16") {
        if string.str_eql(
            arg_unqual,
            c"i8"
        ) || string.str_eql(arg_unqual, c"u8") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"u64") {
        if string.str_eql(
            arg_unqual,
            c"u8"
        ) || string.str_eql(arg_unqual, c"u16") || string.str_eql(arg_unqual, c"u32") ||
        string.str_eql(arg_unqual, c"usize") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"u32") {
        if string.str_eql(
            arg_unqual,
            c"u8"
        ) || string.str_eql(arg_unqual, c"u16") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"u16") {
        if string.str_eql(arg_unqual, c"u8") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"f64") {
        if string.str_eql(arg_unqual, c"f32") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"usize") {
        if string.str_eql(
            arg_unqual,
            c"u8"
        ) || string.str_eql(arg_unqual, c"u16") || string.str_eql(arg_unqual, c"u32") ||
        string.str_eql(arg_unqual, c"u64") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    if string.str_eql(param_unqual, c"isize") {
        if string.str_eql(
            arg_unqual,
            c"i8"
        ) || string.str_eql(arg_unqual, c"i16") || string.str_eql(arg_unqual, c"i32") ||
        string.str_eql(
            arg_unqual,
            c"i64"
        ) || string.str_eql(arg_unqual, c"u8") || string.str_eql(arg_unqual, c"u16") ||
        string.str_eql(arg_unqual, c"u32") || string.str_eql(arg_unqual, c"bool") {
            return true
        }
    }

    return false
}

fn is_comparison_op(op: i64) bool = trust {
    return op == parser.OP_EQ || op == parser.OP_NE ||
    op == parser.OP_LT || op == parser.OP_LE ||
    op == parser.OP_GT || op == parser.OP_GE
}

fn format_type_for_error(ctx: ref SemaCtx, type_name: ref u8, is_ref: i64) ref u8 = trust {
    if is_ref == 1 && (type_name == none || string.str_eql(type_name, c"")) {
        return c"ref void"
    }
    if type_name == none || string.str_eql(type_name, c"") {
        return c"unknown"
    }
    if is_ref == 0 {
        return type_name
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (128) as usize) as ref u8
    @snprintf(buf, 128, "ref {s}", {type_name})
    return buf
}

fn expr_is_ref_void(ctx: ref SemaCtx, node: ref parser.Node) bool = trust {
    if node == none {
        return false
    }
    if infer_expr_scope_is_ref(ctx, node) != 1 {
        return false
    }
    val type_name: ref u8 = infer_expr_scope_type_name(ctx, node)
    return type_name == none || string.str_eql(type_name, c"")
}

fn expr_is_numeric_value(ctx: ref SemaCtx, node: ref parser.Node) bool = trust {
    if node == none {
        return false
    }
    val k: i64 = node.kind
    if k == parser.NK_INT_LIT || k == parser.NK_FLOAT_LIT {
        return true
    }
    if k == parser.NK_IDENT {
        val cat: ref u8 = get_expr_type_category(ctx, node)
        return string.str_eql(cat, c"int") || string.str_eql(cat, c"float")
    }
    if k == parser.NK_TRUST {
        return expr_is_numeric_value(ctx, node.d0 as ref parser.Node)
    }
    if k == parser.NK_UNOP {
        return expr_is_numeric_value(ctx, parser.unop_inner(node))
    }
    if k == parser.NK_BINOP {
        val op: i64 = parser.binop_op(node)
        if op == parser.OP_ADD || op == parser.OP_SUB || op == parser.OP_MUL ||
        op == parser.OP_DIV || op == parser.OP_REM || op == parser.OP_BAND ||
        op == parser.OP_BOR || op == parser.OP_BXOR || op == parser.OP_SHL ||
        op == parser.OP_SHR {
            return expr_is_numeric_value(ctx, parser.binop_left(node)) &&
            expr_is_numeric_value(ctx, parser.binop_right(node))
        }
    }
    return false
}

fn sema_type_name_is_numeric(type_name: ref u8) bool = trust {
    if type_name == none || string.str_eql(type_name, c"") {
        return false
    }
    val name: ref u8 = unqualified_type_name(type_name)
    return string.str_eql(
        name,
        c"i8"
    ) || string.str_eql(name, c"i16") || string.str_eql(name, c"i32") ||
    string.str_eql(name, c"i64") || string.str_eql(name, c"u8") || string.str_eql(name, c"u16") ||
    string.str_eql(name, c"u32") || string.str_eql(name, c"u64") || string.str_eql(name, c"usize") ||
    string.str_eql(name, c"isize") || string.str_eql(name, c"f32") || string.str_eql(name, c"f64") ||
    string.str_eql(name, c"bool") || string.str_eql(name, c"i") || string.str_eql(name, c"u") ||
    string.str_eql(name, c"f")
}

fn sema_type_name_proves_not_result(type_name: ref u8) bool = trust {
    if type_name == none || string.str_eql(type_name, c"") {
        return false
    }
    val name: ref u8 = unqualified_type_name(type_name)
    return sema_type_name_is_numeric(name) ||
    string.str_eql(name, c"char") ||
    string.str_eql(name, c"void")
}

fn sema_ty_proves_not_result(ctx: ref SemaCtx, ty: ref parser.Node) bool = trust {
    val resolved: ref parser.Node = unwrap_mut_type(ty)
    if resolved == none {
        return false
    }
    val wrap_kind: i64 = ty_wrap_kind(resolved)
    if wrap_kind == 1 {
        return false
    }
    if wrap_kind == 2 {
        return true
    }
    val k: i64 = resolved.kind
    if k == parser.TY_REF || k == parser.TY_LIST || k == parser.TY_SLICE ||
    k == parser.TY_FIXED_ARR || k == parser.TY_FNPTR || k == parser.TY_VOID {
        return true
    }
    if k != parser.TY_NAMED {
        return false
    }
    val tname: ref u8 = parser.node_str_raw(resolved.d0)
    if is_type_parameter(ctx, tname) {
        return false
    }
    return sema_type_name_proves_not_result(tname)
}

fn sema_try_operand_type_name(ctx: ref SemaCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return none
    }
    val k: i64 = expr.kind
    if k == parser.NK_TRUST {
        return sema_try_operand_type_name(ctx, expr.d0 as ref parser.Node)
    }
    if k == parser.NK_CAST {
        return extract_type_name(expr.d1 as ref parser.Node)
    }
    if k == parser.NK_IDENT {
        return scope_lookup_type(ctx, parser.node_str_raw(expr.d0))
    }
    if k == parser.NK_CALL {
        val fn_node: ref parser.Node = resolve_called_fn(ctx, parser.call_callee(expr))
        if fn_node == none {
            return none
        }
        if fn_node.kind == parser.NK_FN || fn_node.kind == parser.NK_GENERIC_FN {
            return extract_type_name(fn_node.d4 as ref parser.Node)
        }
        if fn_node.kind == parser.NK_EXTERN_FN {
            return extract_type_name(fn_node.d5 as ref parser.Node)
        }
    }
    return none
}

/// Returns the wrap kind used by comparison checking. Unlike `expr_wrap_kind`,
/// this also recognizes `some`/`ok`/`err` literals as wrapped values.
fn comparison_wrap_kind(ctx: ref SemaCtx, expr: ref parser.Node) i64 = trust {
    if expr == none {
        return 0
    }
    if expr.kind == parser.NK_SOME {
        return 2
    }
    if expr.kind == parser.NK_OK_VAL || expr.kind == parser.NK_ERR_VAL {
        return 1
    }
    return expr_wrap_kind(ctx, expr)
}

fn comparison_type_name(ctx: ref SemaCtx, expr: ref parser.Node) ref u8 = trust {
    val wrap_kind: i64 = comparison_wrap_kind(ctx, expr)
    if wrap_kind == 1 {
        return c"result"
    }
    if wrap_kind == 2 {
        return c"option"
    }
    return format_type_for_error(ctx,
        infer_expr_scope_type_name(ctx, expr),
        infer_expr_scope_is_ref(ctx, expr)
    )
}

fn sema_try_operand_proves_not_result(ctx: ref SemaCtx, expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    val k: i64 = expr.kind
    if k == parser.NK_TRUST {
        return sema_try_operand_proves_not_result(ctx, expr.d0 as ref parser.Node)
    }
    if k == parser.NK_CAST {
        return sema_ty_proves_not_result(ctx, expr.d1 as ref parser.Node)
    }
    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        if scope_lookup_wrap_kind(ctx, name) == 1 {
            return false
        }
        return sema_type_name_proves_not_result(scope_lookup_type(ctx, name))
    }
    if k == parser.NK_CALL {
        val fn_node: ref parser.Node = resolve_called_fn(ctx, parser.call_callee(expr))
        if fn_node == none {
            return false
        }
        if fn_node.kind == parser.NK_FN || fn_node.kind == parser.NK_GENERIC_FN {
            return sema_ty_proves_not_result(ctx, fn_node.d4 as ref parser.Node)
        }
        if fn_node.kind == parser.NK_EXTERN_FN {
            return sema_ty_proves_not_result(ctx, fn_node.d5 as ref parser.Node)
        }
        return false
    }
    if k == parser.NK_INT_LIT || k == parser.NK_FLOAT_LIT || k == parser.NK_STR_LIT ||
    k == parser.NK_BOOL || k == parser.NK_CHAR_LIT || k == parser.NK_NONE ||
    k == parser.NK_SOME || k == parser.NK_LIST_LIT || k == parser.NK_STRUCT_LIT {
        return true
    }
    return false
}

fn sema_ty_is_numeric(ty: ref parser.Node) bool = trust {
    val resolved: ref parser.Node = unwrap_mut_type(ty)
    if resolved == none {
        return false
    }
    if resolved.kind != parser.TY_NAMED {
        return false
    }
    return sema_type_name_is_numeric(parser.node_str_raw(resolved.d0))
}

fn sema_ty_is_definitely_non_numeric(ctx: ref SemaCtx, ty: ref parser.Node) bool = trust {
    val resolved: ref parser.Node = unwrap_mut_type(ty)
    if resolved == none {
        return false
    }
    val k: i64 = resolved.kind
    if k == parser.TY_REF || k == parser.TY_LIST || k == parser.TY_SLICE ||
    k == parser.TY_OPTION || k == parser.TY_RESULT || k == parser.TY_FIXED_ARR ||
    k == parser.TY_FNPTR || k == parser.TY_VOID {
        return true
    }
    if k != parser.TY_NAMED {
        return false
    }
    val tname: ref u8 = parser.node_str_raw(resolved.d0)
    if sema_type_name_is_numeric(tname) {
        return false
    }
    if sema_lookup_typedef(ctx, tname) != none {
        return true
    }
    if sema_lookup_uniondef(ctx, tname) != none {
        return true
    }
    return false
}

fn expr_is_definitely_numeric_for_cast(ctx: ref SemaCtx, node: ref parser.Node) bool = trust {
    if node == none {
        return false
    }
    if infer_expr_scope_is_ref(ctx, node) == 1 {
        return false
    }
    if expr_is_numeric_value(ctx, node) {
        return true
    }
    return sema_type_name_is_numeric(infer_expr_scope_type_name(ctx, node))
}

fn expr_is_definitely_ptr_for_cast(ctx: ref SemaCtx, node: ref parser.Node) bool = trust {
    if node == none {
        return false
    }
    if infer_expr_scope_is_ref(ctx, node) == 1 {
        return true
    }
    val k: i64 = node.kind
    if k == parser.NK_ADDR {
        return true
    }
    if k == parser.NK_TRUST || k == parser.NK_UNOP {
        return expr_is_definitely_ptr_for_cast(ctx, node.d0 as ref parser.Node)
    }
    if k == parser.NK_CAST {
        return sema_ty_is_ref(node.d1 as ref parser.Node) == 1
    }
    return false
}

fn check_cast_type_boundary(
    ctx: ref SemaCtx,
    expr: ref parser.Node,
    filename: ref u8,
    line: i64
) void = trust {
    if expr == none || expr.kind != parser.NK_CAST {
        return
    }
    val inner: ref parser.Node = expr.d0 as ref parser.Node
    val target_ty: ref parser.Node = expr.d1 as ref parser.Node
    val target_is_numeric: bool = sema_ty_is_numeric(target_ty)
    val target_is_non_numeric: bool = sema_ty_is_definitely_non_numeric(ctx, target_ty)
    val target_name: ref u8 = format_type_for_error(ctx,
        extract_type_name(target_ty),
        sema_ty_is_ref(target_ty)
    )

    if expr_is_definitely_numeric_for_cast(ctx, inner) && target_is_non_numeric {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (256) as usize) as ref u8
        @snprintf(
            buf,
            256,
            "{s}:{lld}: cannot cast numeric value to non-numeric type '{s}'",
            {filename, line, target_name}
        )
        add_error(ctx, buf)
        return
    }

    if expr_is_definitely_ptr_for_cast(ctx, inner) && target_is_numeric {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (256) as usize) as ref u8
        @snprintf(
            buf,
            256,
            "{s}:{lld}: cannot cast pointer value to numeric type '{s}'",
            {filename, line, target_name}
        )
        add_error(ctx, buf)
    }
}

fn type_nodes_equivalent(a: ref parser.Node, b: ref parser.Node) bool = trust {
    val lhs: ref parser.Node = unwrap_mut_type(a)
    val rhs: ref parser.Node = unwrap_mut_type(b)
    if lhs == none || rhs == none {
        return false
    }
    if lhs.kind != rhs.kind {
        return false
    }
    if lhs.kind == parser.TY_REF || lhs.kind == parser.TY_OPTION || lhs.kind == parser.TY_LIST ||
    lhs.kind == parser.TY_SLICE {
        return type_nodes_equivalent(lhs.d0 as ref parser.Node, rhs.d0 as ref parser.Node)
    }
    if lhs.kind == parser.TY_RESULT {
        return type_nodes_equivalent(lhs.d0 as ref parser.Node, rhs.d0 as ref parser.Node) &&
        type_nodes_equivalent(lhs.d1 as ref parser.Node, rhs.d1 as ref parser.Node)
    }
    if lhs.kind == parser.TY_NAMED {
        return string.str_eql(parser.node_str_raw(lhs.d0), parser.node_str_raw(rhs.d0))
    }
    if lhs.kind == parser.TY_VOID {
        return true
    }
    return false
}

fn ref_type_names_match(expected: ref u8, actual: ref u8) bool = trust {
    if ((expected == none || string.str_eql(expected, c"")) &&
        (actual == none || string.str_eql(actual, c""))) {
        return true
    }
    if expected == none || actual == none {
        return false
    }
    return string.str_eql(expected, actual)
}

fn ref_assignment_rhs_ok(
    ctx: ref SemaCtx,
    target_type_name: ref u8,
    target_is_ref: i64,
    rhs: ref parser.Node
) bool = trust {
    if rhs == none {
        return true
    }
    if rhs.kind == parser.NK_NONE {
        return true
    }
    if target_is_ref == 1 && rhs.kind == parser.NK_STR_LIT &&
    !parser.str_lit_is_cstr(rhs) {
        // A plain string literal is a StringView; C strings are spelled c"...".
        return false
    }
    if rhs.kind == parser.NK_CAST {
        val cast_ty: ref parser.Node = rhs.d1 as ref parser.Node
        if cast_ty == none {
            return false
        }
        if sema_ty_is_ref(cast_ty) != 1 {
            return false
        }
        if target_is_ref != 1 {
            return false
        }
        return ref_type_names_match(target_type_name, extract_type_name(cast_ty))
    }
    if expr_is_numeric_value(ctx, rhs) {
        return false
    }
    return true
}

fn comparison_operands_compatible(
    ctx: ref SemaCtx,
    lhs: ref parser.Node,
    rhs: ref parser.Node,
    _: i64
) bool = trust {
    val lhs_type: ref u8 = infer_expr_scope_type_name(ctx, lhs)
    val rhs_type: ref u8 = infer_expr_scope_type_name(ctx, rhs)
    val lhs_ref: i64 = infer_expr_scope_is_ref(ctx, lhs)
    val rhs_ref: i64 = infer_expr_scope_is_ref(ctx, rhs)
    val lhs_is_ref_void: bool = expr_is_ref_void(ctx, lhs)
    val rhs_is_ref_void: bool = expr_is_ref_void(ctx, rhs)

    if lhs_is_ref_void || rhs_is_ref_void {
        if lhs_is_ref_void && rhs_is_ref_void {
            return true
        }
        if lhs_is_ref_void && rhs.kind == parser.NK_NONE {
            return true
        }
        if rhs_is_ref_void && lhs.kind == parser.NK_NONE {
            return true
        }
        return false
    }

    val lhs_wrap: i64 = comparison_wrap_kind(ctx, lhs)
    val rhs_wrap: i64 = comparison_wrap_kind(ctx, rhs)

    if lhs_wrap == 1 || rhs_wrap == 1 {
        if lhs_wrap != rhs_wrap {
            return false
        }
    }

    if lhs_wrap == 2 || rhs_wrap == 2 {
        if lhs_wrap != rhs_wrap {
            if lhs.kind != parser.NK_NONE && rhs.kind != parser.NK_NONE {
                return false
            }
        }
    }

    if lhs_type == none || rhs_type == none {
        return true
    }
    if string.str_eql(lhs_type, c"") || string.str_eql(rhs_type, c"") {
        return true
    }

    if lhs_ref != rhs_ref {
        return false
    }

    if lhs_ref == 1 {
        return string.str_eql(lhs_type, rhs_type)
    }

    if types_compatible(ctx, lhs_type, rhs_type) || types_compatible(ctx, rhs_type, lhs_type) {
        return true
    }

    val lhs_cat: ref u8 = get_expr_type_category(ctx, lhs)
    val rhs_cat: ref u8 = get_expr_type_category(ctx, rhs)
    if lhs_cat != none && rhs_cat != none &&
    !string.str_eql(lhs_cat, c"unknown") && string.str_eql(lhs_cat, rhs_cat) {
        return true
    }

    return false
}

/// Returns true if `name` is referenced as an identifier anywhere in `stmts`.
fn stmts_use_name(stmts: ref void, name: ref u8) bool = trust {
    if stmts == none {
        return false
    }
    for s in stmts as list[ref parser.Node] {
        if expr_uses_name(s, name) {
            return true
        }
    }
    return false
}

fn expr_uses_name(node: ref parser.Node, name: ref u8) bool = trust {
    if node == none {
        return false
    }
    val k: i64 = node.kind
    if k == parser.NK_IDENT {
        return string.str_eql(parser.node_str_raw(node.d0), name)
    }
    if k == parser.NK_BINOP {
        return expr_uses_name(parser.binop_left(node), name) ||
        expr_uses_name(parser.binop_right(node), name)
    }
    if k == parser.NK_ASSIGN || k == parser.NK_ADD_ASSIGN || k == parser.NK_SUB_ASSIGN {
        return expr_uses_name(node.d0 as ref parser.Node, name) ||
        expr_uses_name(node.d1 as ref parser.Node, name)
    }
    if k == parser.NK_UNOP {
        return expr_uses_name(parser.unop_inner(node), name)
    }
    if k == parser.NK_TRUST || k == parser.NK_SOME ||
    k == parser.NK_OK_VAL || k == parser.NK_ERR_VAL || k == parser.NK_TRY ||
    k == parser.NK_ADDR || k == parser.NK_DEREF || k == parser.NK_CAST ||
    k == parser.NK_RETURN || k == parser.NK_EXPR_STMT || k == parser.NK_ASSERT {
        return expr_uses_name(node.d0 as ref parser.Node, name)
    }
    if k == parser.NK_FIELD {
        return expr_uses_name(parser.field_base(node), name)
    }
    if k == parser.NK_CALL {
        if expr_uses_name(parser.call_callee(node), name) {
            return true
        }
        val cargs: ref void = parser.call_args(node) as ref void
        if cargs != none {
            for carg in cargs as list[ref parser.Node] {
                if expr_uses_name(carg, name) {
                    return true
                }
            }
        }
        return false
    }
    if k == parser.NK_BUILTIN {
        val bargs: ref void = node.d1 as ref void
        if bargs != none {
            for barg in bargs as list[ref parser.Node] {
                if expr_uses_name(barg, name) {
                    return true
                }
            }
        }
        for bta in parser.builtin_type_args(node) {
            if bta != none && bta.kind == parser.TY_NAMED {
                if string.str_eql(parser.node_str_raw(bta.d0), name) {
                    return true
                }
            }
        }
        return false
    }
    if k == parser.NK_VAL {
        return expr_uses_name(node.d3 as ref parser.Node, name)
    }
    if k == parser.NK_GUARD {
        if expr_uses_name(node.d0 as ref parser.Node, name) {
            return true
        }
        return stmts_use_name(node.d1 as ref void, name)
    }
    if k == parser.NK_IF {
        if expr_uses_name(node.d0 as ref parser.Node, name) {
            return true
        }
        if stmts_use_name(node.d1 as ref void, name) {
            return true
        }
        val elif_list2: ref void = node.d2 as ref void
        if elif_list2 != none {
            for ep in elif_list2 as list[ref parser.Node] {
                if expr_uses_name(ep.d0 as ref parser.Node, name) {
                    return true
                }
                if stmts_use_name(ep.d1 as ref void, name) {
                    return true
                }
            }
        }
        val else_node: ref parser.Node = node.d3 as ref parser.Node
        if else_node != none {
            return stmts_use_name(else_node.d0 as ref void, name)
        }
        return false
    }
    if k == parser.NK_FOR {
        if expr_uses_name(node.d1 as ref parser.Node, name) {
            return true
        }
        if expr_uses_name(node.d2 as ref parser.Node, name) {
            return true
        }
        return stmts_use_name(node.d4 as ref void, name)
    }
    if k == parser.NK_FORIN {
        if expr_uses_name(node.d1 as ref parser.Node, name) {
            return true
        }
        return stmts_use_name(node.d2 as ref void, name)
    }
    if k == parser.NK_LIST_LIT || k == parser.NK_ARGS_PACK || k == parser.NK_STRUCT_LIT {
        val elist: ref void = node.d0 as ref void
        if elist != none {
            for e in elist as list[ref parser.Node] {
                if expr_uses_name(e, name) {
                    return true
                }
            }
        }
        return false
    }
    return false
}

/// Returns true if the format string contains any C-style format specifier (bare %).
fn has_c_style_specifier(s: ref u8) bool = trust {
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(s, i))
        if c == 0 {
            break
        }
        if c == 37 {
            return true
        } // any '%' is C-style
        i++
    }
    return false
}

/// Extracts the list of specifier strings from a Spectre format string.
/// E.g. "hello {d} {s}" -> ["d", "s"]
fn parse_fmt_specifiers(ctx: ref SemaCtx, s: ref u8) list[ref u8] = trust {
    val result: mut list[ref u8] = mem.new[ref u8]()
    val i: mut i64 = 0
    for {
        val c: u8 = @load8(@ptradd(s, i))
        if c == 0 {
            break
        }
        if c == 92 { // '\\'
            val next: u8 = @load8(@ptradd(s, i + 1))
            if next != 0 {
                i += 2
            } else {
                i++
            }
        } elif c == 123 { // '{'
            val j: mut i64 = i + 1
            val found: mut bool = false
            for {
                val jc: u8 = @load8(@ptradd(s, j))
                if jc == 0 {
                    break
                }
                if jc == 125 {
                    found = true
                    break
                } // '}'
                j++
            }
            if found {
                val spec_len: i64 = j - i - 1
                if spec_len > 0 {
                    val specifier: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (spec_len + 1) as usize
                    ) as ref u8
                    val si: mut i64 = 0
                    for {
                        if si >= spec_len {
                            break
                        }
                        val sc: u8 = @load8(@ptradd(s, i + 1 + si))
                        @store8(@ptradd(specifier, si), sc)
                        si++
                    }
                    @store8(@ptradd(specifier, spec_len), 0)
                    @append(result, specifier)
                }
                i = j + 1
            } else {
                i++
            }
        } else {
            i++
        }
    }
    return result
}

fn fmt_is_flag(c: u8) bool = {
    return c == 45 || c == 43 || c == 32 || c == 35 || c == 48
}

fn fmt_is_digit(c: u8) bool = {
    return c >= 48 && c <= 57
}

fn fmt_is_conversion(c: u8) bool = {
    return c == 100 || c == 105 || c == 111 || c == 117 || c == 120 || c == 88 ||
    c == 102 || c == 70 || c == 101 || c == 69 || c == 103 || c == 71 ||
    c == 97 || c == 65 || c == 99 || c == 115 || c == 112 || c == 110
}

/// Parses the body of a `{...}` format specifier (without the braces).
/// Returns its conversion character, or 0 when the specifier is not a valid
/// printf conversion. Flags, width, precision, and length modifiers are
/// accepted, so `{d}`, `{08llx}`, `{5000d}`, and `{lf}` are all valid.
fn fmt_specifier_conversion(specifier: ref u8) u8 = trust {
    if specifier == none {
        return 0
    }
    val len: i64 = string.len_raw(specifier)
    if len == 0 {
        return 0
    }

    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(specifier, i))
        if !fmt_is_flag(c) {
            break
        }
        i++
    }

    // A '*' width/precision consumes an additional argument, which the
    // format-string arity check cannot represent.
    if i < len && @load8(@ptradd(specifier, i)) == 42 {
        return 0
    }
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(specifier, i))
        if !fmt_is_digit(c) {
            break
        }
        i++
    }

    if i < len && @load8(@ptradd(specifier, i)) == 46 {
        i++
        if i < len && @load8(@ptradd(specifier, i)) == 42 {
            return 0
        }
        for {
            if i >= len {
                break
            }
            val c: u8 = @load8(@ptradd(specifier, i))
            if !fmt_is_digit(c) {
                break
            }
            i++
        }
    }

    if i < len {
        val c: u8 = @load8(@ptradd(specifier, i))
        if c == 104 { // h / hh
            i++
            if i < len && @load8(@ptradd(specifier, i)) == 104 {
                i++
            }
        } elif c == 108 { // l / ll
            i++
            if i < len && @load8(@ptradd(specifier, i)) == 108 {
                i++
            }
        } elif c == 76 || c == 122 || c == 106 || c == 116 { // L z j t
            i++
        }
    }

    if i >= len {
        return 0
    }
    val conv: u8 = @load8(@ptradd(specifier, i))
    if !fmt_is_conversion(conv) {
        return 0
    }
    i++
    if i != len {
        return 0
    }
    return conv
}

/// Maps a format specifier string to its expected argument category.
/// Returns "int", "str", "u8", "float", "ptr", or "unknown".
fn fmt_specifier_category(specifier: ref u8) ref u8 = trust {
    val conv: u8 = fmt_specifier_conversion(specifier)
    if conv == 115 { // s
        return c"str"
    }
    if conv == 99 { // c
        return c"u8"
    }
    if conv == 102 || conv == 70 || conv == 101 || conv == 69 ||
    conv == 103 || conv == 71 || conv == 97 || conv == 65 {
        return c"float"
    }
    if conv == 100 || conv == 105 || conv == 111 || conv == 117 ||
    conv == 120 || conv == 88 {
        return c"int"
    }
    if conv == 112 || conv == 110 {
        return c"ptr"
    }
    return c"unknown"
}

fn sema_ty_is_ref(ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 0
    }
    if ty.kind == parser.TY_REF {
        return 1
    }
    if ty.kind == parser.TY_MUT {
        val inner: ref parser.Node = ty.d0 as ref parser.Node
        if inner != none && inner.kind == parser.TY_REF {
            return 1
        }
    }
    return 0
}

fn infer_expr_scope_type_name(ctx: ref SemaCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c""
    }
    val k: i64 = node.kind
    if k == parser.NK_INT_LIT {
        return c"i64"
    }
    if k == parser.NK_FLOAT_LIT {
        return c"f64"
    }
    if k == parser.NK_BOOL {
        return c"bool"
    }
    if k == parser.NK_CHAR_LIT {
        return c"u8"
    }
    if k == parser.NK_STR_LIT {
        if parser.str_lit_is_cstr(node) {
            return c"u8"
        }
        return c"StringView"
    }
    if k == parser.NK_IDENT {
        val tname: ref u8 = scope_lookup_type(ctx, parser.node_str_raw(node.d0))
        if tname != none {
            return spec_impl_name(ctx, tname)
        }
        return c""
    }
    if k == parser.NK_TRUST {
        return infer_expr_scope_type_name(ctx, node.d0 as ref parser.Node)
    }
    if k == parser.NK_UNOP {
        return infer_expr_scope_type_name(ctx, parser.unop_inner(node))
    }
    if k == parser.NK_CAST {
        return extract_type_name(node.d1 as ref parser.Node)
    }
    if k == parser.NK_BUILTIN {
        val bname: ref u8 = parser.node_str_raw(node.d0)
        if string.str_eql(bname, c"dumpmemleaks") {
            return c"testing.LeakDiagnostics"
        }
    }
    return c""
}

fn infer_expr_scope_is_ref(ctx: ref SemaCtx, node: ref parser.Node) i64 = trust {
    if node == none {
        return 0
    }
    val k: i64 = node.kind
    if k == parser.NK_STR_LIT {
        if parser.str_lit_is_cstr(node) {
            return 1
        }
        return 0
    }
    if k == parser.NK_IDENT {
        return scope_lookup_is_ref(ctx, parser.node_str_raw(node.d0))
    }
    if k == parser.NK_TRUST {
        return infer_expr_scope_is_ref(ctx, node.d0 as ref parser.Node)
    }
    if k == parser.NK_UNOP {
        return infer_expr_scope_is_ref(ctx, parser.unop_inner(node))
    }
    if k == parser.NK_CAST {
        return sema_ty_is_ref(node.d1 as ref parser.Node)
    }
    return 0
}

/// Maps a declared type node to the broad category used by format checking.
fn type_node_category(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"unknown"
    }
    val k: i64 = ty.kind
    if k == parser.TY_MUT {
        return type_node_category(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_REF {
        val inner: ref parser.Node = ty.d0 as ref parser.Node
        if inner != none && inner.kind == parser.TY_NAMED &&
        string.str_eql(unqualified_type_name(parser.node_str_raw(inner.d0)), c"u8") {
            return c"str"
        }
        return c"ptr"
    }
    if k == parser.TY_LIST || k == parser.TY_SLICE ||
    k == parser.TY_FIXED_ARR || k == parser.TY_FNPTR {
        return c"ptr"
    }
    if k != parser.TY_NAMED {
        return c"unknown"
    }
    val name: ref u8 = unqualified_type_name(parser.node_str_raw(ty.d0))
    if string.str_eql(name, c"String") || string.str_eql(name, c"StringView") {
        return c"str"
    }
    if string.str_eql(name, c"u8") {
        return c"u8"
    }
    if string.str_eql(name, c"i8") || string.str_eql(name, c"i16") || string.str_eql(name, c"i32") ||
    string.str_eql(name, c"i64") || string.str_eql(name, c"u16") || string.str_eql(name, c"u32") ||
    string.str_eql(name, c"u64") || string.str_eql(name, c"usize") || string.str_eql(name, c"isize") ||
    string.str_eql(name, c"i") || string.str_eql(name, c"u") || string.str_eql(name, c"bool") {
        return c"int"
    }
    if string.str_eql(name, c"f32") || string.str_eql(name, c"f64") || string.str_eql(name, c"f") {
        return c"float"
    }
    return c"unknown"
}

/// Infers a broad type category for an expression node.
/// Returns "int", "str", "u8", "float", "ptr", or "unknown".
fn get_expr_type_category(ctx: ref SemaCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c"unknown"
    }
    val k: i64 = node.kind
    if k == parser.NK_INT_LIT {
        return c"int"
    }
    if k == parser.NK_FLOAT_LIT {
        return c"float"
    }
    if k == parser.NK_STR_LIT {
        return c"str"
    }
    if k == parser.NK_CHAR_LIT {
        return c"u8"
    }
    if k == parser.NK_BOOL {
        return c"int"
    }
    if k == parser.NK_CAST {
        return type_node_category(node.d1 as ref parser.Node)
    }
    if k == parser.NK_TRUST {
        return get_expr_type_category(ctx, node.d0 as ref parser.Node)
    }
    if k == parser.NK_UNOP {
        return get_expr_type_category(ctx, parser.unop_inner(node))
    }
    if k == parser.NK_FIELD {
        val root: ref parser.Node = find_root_ident(node)
        if root != none {
            val vname: ref u8 = parser.node_str_raw(root.d0)
            val tname: ref u8 = scope_lookup_type(ctx, vname)
            val fname: ref u8 = parser.field_name_raw(node)
            if tname != none && fname != none {
                val fty: ref parser.Node = find_field_type_node(ctx, tname, fname)
                if fty != none {
                    return type_node_category(fty)
                }
            }
        }
        return c"unknown"
    }
    if k == parser.NK_CALL {
        val fn_node: ref parser.Node = resolve_called_fn(ctx, parser.call_callee(node))
        if fn_node != none {
            if fn_node.kind == parser.NK_FN || fn_node.kind == parser.NK_GENERIC_FN {
                return type_node_category(fn_node.d4 as ref parser.Node)
            }
            if fn_node.kind == parser.NK_EXTERN_FN {
                return type_node_category(fn_node.d5 as ref parser.Node)
            }
        }
        return c"unknown"
    }
    if k == parser.NK_IDENT {
        val vname: ref u8 = parser.node_str_raw(node.d0)
        val tname: ref u8 = scope_lookup_type(ctx, vname)
        val iref: i64 = scope_lookup_is_ref(ctx, vname)
        if tname == none {
            return c"unknown"
        }
        val uname: ref u8 = unqualified_type_name(tname)
        if string.str_eql(uname, c"String") || string.str_eql(uname, c"StringView") {
            return c"str"
        }
        if iref == 1 {
            if string.str_eql(tname, c"u8") {
                return c"str"
            }
            return c"ptr"
        }
        if string.str_eql(tname, c"u8") {
            return c"u8"
        }
        if string.str_eql(tname, c"i8") {
            return c"int"
        }
        if string.str_eql(tname, c"i16") {
            return c"int"
        }
        if string.str_eql(tname, c"i32") {
            return c"int"
        }
        if string.str_eql(tname, c"i64") {
            return c"int"
        }
        if string.str_eql(tname, c"u8") {
            return c"int"
        }
        if string.str_eql(tname, c"u16") {
            return c"int"
        }
        if string.str_eql(tname, c"u32") {
            return c"int"
        }
        if string.str_eql(tname, c"u64") {
            return c"int"
        }
        if string.str_eql(tname, c"usize") {
            return c"int"
        }
        if string.str_eql(tname, c"isize") {
            return c"int"
        }
        if string.str_eql(tname, c"i") {
            return c"int"
        }
        if string.str_eql(tname, c"u") {
            return c"int"
        }
        if string.str_eql(tname, c"bool") {
            return c"int"
        }
        if string.str_eql(tname, c"f32") {
            return c"float"
        }
        if string.str_eql(tname, c"f64") {
            return c"float"
        }
        if string.str_eql(tname, c"f") {
            return c"float"
        }
        return c"unknown"
    }
    return c"unknown"
}

/// Validates a printf/dprintf format string against its argument pack.
/// Reports errors for C-style specifiers, count mismatches, and type mismatches.
/// Validate a printf-family format string.
/// all_args: the full argument list (ref void to list[ref Node]), args_start_idx: where format args begin.
/// Handles both pack-style ({args...}) and individual-arg style (a, b, c).
fn check_printf_fmt(ctx: ref SemaCtx, fmt_str: ref u8, all_args: ref void,
    args_start_idx: i64, filename: ref u8, line: i64) void = trust {
    if has_c_style_specifier(fmt_str) {
        if !string.raw_ends_with(filename, c"codegen.sx") {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(buf, 256, "{s}:{lld}: C-style format specifiers are not allowed, use \{d\}, \{s\} etc...",
                {filename, line})
            add_error(ctx, buf)
            return
        }
    }

    val specs: list[ref u8] = parse_fmt_specifiers(ctx, fmt_str)
    val spec_count: i64 = @len(specs) as i64

    val spec_idx: mut i64 = 0
    for {
        if spec_idx >= spec_count {
            break
        }
        val spec_opt = @get(specs, spec_idx as usize)
        if spec_opt is some spec_raw {
            val specifier: ref u8 = spec_raw as ref u8
            if fmt_specifier_conversion(specifier) == 0 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(buf, 512, "{s}:{lld}: invalid format specifier \{{s}\}",
                    {filename, line, specifier})
                add_error(ctx, buf)
                return
            }
        }
        spec_idx++
    }

    // Determine arg count and whether we have pack-style or individual-style args.
    val total_args: mut i64 = 0
    val pack_style: mut bool = false
    val pack_inner: mut ref void = none
    if all_args != none {
        val alen: i64 = @len(all_args) as i64
        if alen > args_start_idx {
            val first_opt = @get(all_args, args_start_idx as usize)
            if first_opt is some first_raw {
                val first_node: ref parser.Node = first_raw as ref parser.Node
                if first_node.kind == parser.NK_ARGS_PACK {
                    pack_style = true
                    val inner: ref void = first_node.d0 as ref void
                    if inner != none {
                        pack_inner = inner
                        total_args = @len(inner) as i64
                    }
                } else {
                    total_args = alen - args_start_idx
                }
            }
        }
    }

    if all_args != none {
        val alen_fwd: i64 = @len(all_args) as i64
        if alen_fwd > args_start_idx {
            val fwd_opt = @get(all_args, args_start_idx as usize)
            if fwd_opt is some fwd_raw {
                val fwd_node: ref parser.Node = fwd_raw as ref parser.Node
                if fwd_node != none && fwd_node.kind == parser.NK_IDENT {
                    val fwd_name: ref u8 = parser.node_str_raw(fwd_node.d0)
                    for up in ctx.argspack_params {
                        if string.str_eql(up, fwd_name) {
                            return
                        }
                    }
                }
            }
        }
    }

    if spec_count != total_args {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (256) as usize) as ref u8
        @snprintf(buf, 256, "{s}:{lld}: format string has {lld} specifier(s) but {lld} argument(s) provided",
            {filename, line, spec_count, total_args})
        add_error(ctx, buf)
        return
    }

    val idx: mut i64 = 0
    for {
        if idx >= spec_count {
            break
        }
        val spec_opt = @get(specs, idx as usize)
        if spec_opt is some spec_raw {
            val specifier: ref u8 = spec_raw as ref u8
            val exp_cat: ref u8 = fmt_specifier_category(specifier)
            if !string.str_eql(exp_cat, c"unknown") {
                val arg_node: mut ref parser.Node = none
                if pack_style && pack_inner != none {
                    val arg_opt = @get(pack_inner, idx as usize)
                    if arg_opt is some arg_raw {
                        arg_node = arg_raw as ref parser.Node
                    }
                } elif !pack_style && all_args != none {
                    val real_idx: i64 = args_start_idx + idx
                    val arg_opt = @get(all_args, real_idx as usize)
                    if arg_opt is some arg_raw {
                        arg_node = arg_raw as ref parser.Node
                    }
                }
                if arg_node != none {
                    val arg_wrap: i64 = expr_wrap_kind(ctx, arg_node)
                    if arg_wrap != 0 && !string.str_eql(exp_cat, c"ptr") {
                        val wrap_name: mut ref u8 = c"option"
                        if arg_wrap == 1 {
                            wrap_name = c"result"
                        }
                        val buf_wrap: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (512) as usize
                        ) as ref u8
                        @snprintf(buf_wrap, 512,
                            "{s}:{lld}: format specifier \\{{s}\\} does not accept a {s} value; unwrap it first",
                            {filename, line, specifier, wrap_name})
                        add_error(ctx, buf_wrap)
                        idx++
                        continue
                    }
                    val act_cat: ref u8 = get_expr_type_category(ctx, arg_node)
                    if !string.str_eql(act_cat, c"unknown") {
                        val its_ok: mut bool = string.str_eql(exp_cat, act_cat)
                        if string.str_eql(exp_cat, c"u8") && string.str_eql(act_cat, c"int") {
                            its_ok = true
                        }
                        if string.str_eql(exp_cat, c"int") && string.str_eql(act_cat, c"u8") {
                            its_ok = true
                        }
                        if string.str_eql(exp_cat, c"ptr") && string.str_eql(act_cat, c"str") {
                            its_ok = true
                        }
                        if !its_ok {
                            val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                (512) as usize
                            ) as ref u8
                            @snprintf(buf2, 512,
                                "{s}:{lld}: format specifier \{{s}\} expects {s} argument but got {s}",
                                {filename, line, specifier, exp_cat, act_cat})
                            add_error(ctx, buf2)
                        }
                    }
                }
            }
        }
        idx++
    }
}

fn find_import_module(ctx: ref SemaCtx, name: ref u8) ref modinfo.ResolvedModule = trust {
    return find_imported_mod(ctx, name)
}

fn generic_targ_type_compatible(
    ctx: ref SemaCtx,
    expected: ref u8,
    actual: ref u8,
    arg_node: ref parser.Node
) bool = trust {
    val canon_expected: ref u8 = canonicalize_import_alias_type_name(ctx, expected)
    val canon_actual: ref u8 = canonicalize_import_alias_type_name(ctx, actual)
    if string.str_eql(canon_expected, canon_actual) {
        return true
    }
    if arg_node.kind == parser.NK_INT_LIT {
        if string.str_eql(
            canon_expected,
            c"i8"
        ) || string.str_eql(canon_expected, c"i16") || string.str_eql(canon_expected, c"i32") ||
        string.str_eql(
            canon_expected,
            c"i64"
        ) || string.str_eql(canon_expected, c"u8") || string.str_eql(canon_expected, c"u16") ||
        string.str_eql(
            canon_expected,
            c"u32"
        ) || string.str_eql(canon_expected, c"u64") || string.str_eql(canon_expected, c"usize") ||
        string.str_eql(canon_expected, c"isize") || string.str_eql(canon_expected, c"bool") {
            return true
        }
    }
    if arg_node.kind == parser.NK_FLOAT_LIT {
        if string.str_eql(canon_expected, c"f32") || string.str_eql(canon_expected, c"f64") {
            return true
        }
    }
    return false
}

/// Check that explicit type arguments to a generic function satisfy any
/// `[T: SpecName]` constraints declared in the function's type-parameter list.
fn check_generic_call_constraints(ctx: ref SemaCtx, fn_found: ref parser.Node, callee: ref parser.Node,
    filename: ref u8, line: i64) void = trust {
    if fn_found == none || fn_found.kind != parser.NK_GENERIC_FN {
        return
    }
    if callee == none || callee.kind != parser.NK_GENERIC_INST {
        return
    }
    val tparams: ref void = fn_found.d6 as ref void
    if tparams == none {
        return
    }
    val gi_targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val nparms: i64 = @len(tparams as list[ref parser.Node]) as i64
    val nargs: i64 = @len(gi_targs) as i64
    val n: mut i64 = nparms
    if nargs < n {
        n = nargs
    }
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val tp_opt = @get(tparams as list[ref parser.Node], i as usize)
        val ta_opt = @get(gi_targs, i as usize)
        if tp_opt is some tp_raw {
            val tp_node: ref parser.Node = tp_raw as ref parser.Node
            val constraint: ref parser.Node = parser.tparam_constraint(tp_node)
            if constraint != none {
                if ta_opt is some ta_raw {
                    val ta_node: ref parser.Node = ta_raw as ref parser.Node
                    val constraint_name: ref u8 = extract_type_name(constraint)
                    val arg_type_name: ref u8 = extract_type_name(ta_node)
                    if constraint_name != none && arg_type_name != none &&
                    !is_type_parameter(ctx, arg_type_name) {
                        val expected_spec: ref u8 = canonicalize_import_alias_type_name(
                            ctx,
                            qualify_type_name_for_callee(ctx, callee, constraint_name)
                        )
                        val tdef: ref parser.Node = find_typedef_anywhere(ctx, arg_type_name)
                        val impl_spec: mut ref u8 = none
                        if tdef != none {
                            impl_spec = canonicalize_import_alias_type_name(
                                ctx,
                                parser.node_str_raw(tdef.d4)
                            )
                        }
                        val its_ok: mut bool = false
                        if impl_spec != none && string.str_eql(impl_spec, expected_spec) {
                            its_ok = true
                        }
                        if !its_ok && impl_spec != none {
                            val arg_owner: ref u8 = qualified_owner_prefix(ctx, arg_type_name)
                            val expected_owner: ref u8 = qualified_owner_prefix(ctx, expected_spec)
                            if arg_owner != none && expected_owner != none &&
                            string.str_eql(impl_spec, unqualified_type_name(expected_spec)) {
                                if string.str_eql(arg_owner, expected_owner) {
                                    its_ok = true
                                }
                                if !its_ok {
                                    val arg_mod: ref modinfo.ResolvedModule = find_import_module(
                                        ctx,
                                        arg_owner
                                    )
                                    val callee_prefix: ref u8 = imported_owner_prefix_for_callee(
                                        ctx,
                                        callee
                                    )
                                    if callee_prefix != none {
                                        val callee_mod: ref modinfo.ResolvedModule = find_import_module(
                                            ctx,
                                            callee_prefix
                                        )
                                        if callee_mod != none {
                                            val expected_mod: ref modinfo.ResolvedModule = modinfo.find_import_by_name(
                                                callee_mod,
                                                expected_owner
                                            )
                                            val dbg_exp_null: mut ref u8 = c"non-null"
                                            if expected_mod == none {
                                                dbg_exp_null = c"null"
                                            }
                                            if arg_mod != none && expected_mod != none {
                                                val arg_fname: ref u8 = canonicalize_path(
                                                    ctx,
                                                    modinfo.module_filename(arg_mod)
                                                )
                                                val exp_fname: ref u8 = canonicalize_path(
                                                    ctx,
                                                    modinfo.module_filename(expected_mod)
                                                )
                                                if arg_fname != none && exp_fname != none && string.str_eql(
                                                    arg_fname,
                                                    exp_fname
                                                ) {
                                                    its_ok = true
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !its_ok && string.str_eql(arg_type_name, constraint_name) {
                            its_ok = true
                        }
                        if !its_ok {
                            val tp_name: ref u8 = parser.tparam_name_raw(tp_node)
                            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                (512) as usize
                            ) as ref u8
                            @snprintf(ebuf, 512, "{s}:{lld}: type '{s}' does not satisfy constraint '{s}: {s}'",
                                {filename, line, arg_type_name, tp_name, constraint_name})
                            add_error(ctx, ebuf)
                        }
                    }
                }
            }
        }
        i++
    }
}

fn concrete_generic_param_type_name(fn_found: ref parser.Node, callee: ref parser.Node,
    param_type_name: ref u8) ref u8 = trust {
    if fn_found == none || fn_found.kind != parser.NK_GENERIC_FN {
        return none
    }
    if callee == none || callee.kind != parser.NK_GENERIC_INST {
        return none
    }
    if param_type_name == none || string.str_eql(param_type_name, c"") {
        return none
    }
    val tparams: ref void = fn_found.d6 as ref void
    if tparams == none {
        return none
    }
    val targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val ntp: i64 = @len(tparams as list[ref parser.Node]) as i64
    val nta: i64 = @len(targs) as i64
    val n: i64 = math.min_i64(ntp, nta)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val tp_opt = @get(tparams as list[ref parser.Node], i as usize)
        val ta_opt = @get(targs, i as usize)
        if tp_opt is some tp {
            val ftp_name: ref u8 = parser.tparam_name_raw(tp as ref parser.Node)
            if string.str_eql(ftp_name, param_type_name) {
                if ta_opt is some ta {
                    return extract_type_name(ta as ref parser.Node)
                } else {
                    return none
                }
            }
        }
        i++
    }
    return none
}

fn check_generic_call_arg_types(ctx: ref SemaCtx, fn_found: ref parser.Node, callee: ref parser.Node,
    cargs: ref void, filename: ref u8, line: i64) void = trust {
    if fn_found == none || fn_found.kind != parser.NK_GENERIC_FN {
        return
    }
    if callee == none || callee.kind != parser.NK_GENERIC_INST {
        return
    }
    val tparams: ref void = fn_found.d6 as ref void
    val fn_params: ref void = fn_found.d3 as ref void
    if tparams == none || fn_params == none || cargs == none {
        return
    }
    val gi_targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val ntparams: i64 = @len(tparams as list[ref parser.Node]) as i64
    val ntargs: i64 = @len(gi_targs) as i64
    if ntparams == 0 || ntargs == 0 {
        return
    }
    val nfnparams: i64 = @len(fn_params as list[ref parser.Node]) as i64
    val nargs: i64 = @len(cargs as list[ref parser.Node]) as i64
    val min_len: mut i64 = nfnparams
    if nargs < nfnparams {
        min_len = nargs
    }
    val pi: mut i64 = 0
    for {
        if pi >= min_len {
            break
        }
        val param_opt = @get(fn_params as list[ref parser.Node], pi as usize)
        val arg_opt = @get(cargs as list[ref parser.Node], pi as usize)
        if param_opt is some param_raw {
            if arg_opt is some arg_raw {
                val param_node: ref parser.Node = param_raw as ref parser.Node
                val arg_node: ref parser.Node = arg_raw as ref parser.Node
                val pty: ref parser.Node = param_node.d1 as ref parser.Node
                val inner_pty: ref parser.Node = unwrap_mut_type(pty)
                if inner_pty != none && inner_pty.kind == parser.TY_NAMED {
                    val tparam_name: ref u8 = parser.node_str_raw(inner_pty.d0)
                    val ti: mut i64 = 0
                    for {
                        if ti >= ntparams {
                            break
                        }
                        val tp_opt = @get(tparams as list[ref parser.Node], ti as usize)
                        if tp_opt is some tp {
                            val tp_node_check: ref parser.Node = tp as ref parser.Node
                            if string.str_eql(
                                parser.tparam_name_raw(tp_node_check),
                                tparam_name
                            ) && ti < ntargs {
                                val ta_opt = @get(gi_targs, ti as usize)
                                if ta_opt is some ta {
                                    val type_arg_node: ref parser.Node = ta as ref parser.Node
                                    val expected_tname: ref u8 = extract_type_name(type_arg_node)
                                    val arg_tname: ref u8 = infer_expr_scope_type_name(
                                        ctx,
                                        arg_node
                                    )
                                    val expected_is_tparam: mut bool = false
                                    val ck: mut i64 = 0
                                    for {
                                        if ck >= ntparams {
                                            break
                                        }
                                        val ck_opt = @get(
                                            tparams as list[ref parser.Node],
                                            ck as usize
                                        )
                                        if ck_opt is some ckn {
                                            val ckn_node: ref parser.Node = ckn as ref parser.Node
                                            if string.str_eql(
                                                parser.tparam_name_raw(ckn_node),
                                                expected_tname
                                            ) {
                                                expected_is_tparam = true
                                                break
                                            }
                                        }
                                        ck++
                                    }
                                    val generic_int_const_arg_ok: bool =
                                    expected_tname != none &&
                                    !string.str_eql(expected_tname, c"") &&
                                    !expected_is_tparam &&
                                    sema_int_const_arg_compatible(
                                        ctx,
                                        expected_tname,
                                        arg_node,
                                        filename,
                                        line
                                    )
                                    val generic_float_const_arg_ok: bool =
                                    expected_tname != none &&
                                    !string.str_eql(expected_tname, c"") &&
                                    !expected_is_tparam &&
                                    sema_float_const_arg_compatible(
                                        ctx,
                                        expected_tname,
                                        arg_node,
                                        filename,
                                        line
                                    )
                                    if expected_tname != none && !string.str_eql(
                                        expected_tname,
                                        c""
                                    ) &&
                                    !expected_is_tparam &&
                                    arg_tname != none && !string.str_eql(arg_tname, c"") &&
                                    !generic_targ_type_compatible(
                                        ctx,
                                        expected_tname,
                                        arg_tname,
                                        arg_node
                                    ) && !generic_int_const_arg_ok &&
                                    !generic_float_const_arg_ok {
                                        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                            ctx.arena,
                                            (512) as usize
                                        ) as ref u8
                                        @snprintf(ebuf, 512, "{s}:{lld}: type mismatch in generic call: argument has type '{s}' but type parameter '{s}' is '{s}'",
                                            {
                                                filename,
                                                line,
                                                arg_tname,
                                                tparam_name,
                                                expected_tname
                                            })
                                        add_error(ctx, ebuf)
                                    }
                                }
                                break
                            }
                        }
                        ti++
                    }
                }
            }
        }
        pi++
    }
}

/// Records the originating constructor namespace for a local variable so that
/// inference can recover the concrete impl type later (e.g., arena -> "allocators.Arena").
fn record_var_origin(ctx: mut ref SemaCtx, name: ref u8, origin: ref u8) void = trust {
    if name == none || origin == none {
        return
    }
    @append(ctx.var_origin_names, name)
    @append(ctx.var_origin_types, origin)
}

/// Look up the recorded originating type for a variable name, or 0 if none.
fn lookup_var_origin(ctx: ref SemaCtx, name: ref u8) ref u8 = trust {
    if name == none {
        return none
    }
    val n: i64 = @len(ctx.var_origin_names) as i64
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        val n_opt = @get(ctx.var_origin_names, i as usize)
        if n_opt is some nm {
            if string.str_eql(nm as ref u8, name) {
                val t_opt = @get(ctx.var_origin_types, i as usize)
                if t_opt is some t {
                    return t as ref u8
                } else {
                    return none
                }
            }
        }
        i--
    }
    return none
}

/// Build a dotted name string from a NK_FIELD/NK_IDENT chain (e.g., "allocators.Arena").
/// Returns 0 if the chain isn't purely identifiers and field accesses.
fn dotted_chain_name(ctx: ref SemaCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return none
    }
    if node.kind == parser.NK_IDENT {
        return parser.node_str_raw(node.d0)
    }
    if node.kind == parser.NK_FIELD {
        val base: ref parser.Node = parser.field_base(node)
        val fname: ref u8 = parser.field_name_raw(node)
        val base_str: ref u8 = dotted_chain_name(ctx, base)
        if base_str == none {
            return none
        }
        val out: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(out, 512, "{s}.{s}", {base_str, fname})
        return out
    }
    return none
}

/// If init_expr is of the form `(trust)? X.Method(...)(?)`, return the dotted
/// name of X (e.g., "allocators.Arena"); otherwise return 0.
fn extract_constructor_namespace(ctx: ref SemaCtx, expr: ref parser.Node) ref u8 = trust {
    val cur: mut ref parser.Node = expr
    for {
        if cur == none {
            return none
        }
        val ck: i64 = cur.kind
        if ck == parser.NK_TRUST || ck == parser.NK_TRY {
            cur = cur.d0 as ref parser.Node
            continue
        }
        break
    }
    if cur == none {
        return none
    }
    if cur.kind != parser.NK_CALL {
        return none
    }
    val callee: ref parser.Node = parser.call_callee(cur)
    if callee == none {
        return none
    }
    if callee.kind != parser.NK_FIELD {
        return none
    }
    val base: ref parser.Node = parser.field_base(callee)
    return dotted_chain_name(ctx, base)
}

/// Returns true if the type-arg list of a NK_GENERIC_INST callee contains TY_INFER markers.
fn generic_inst_has_infer(callee: ref parser.Node) bool = trust {
    if callee == none {
        return false
    }
    if callee.kind != parser.NK_GENERIC_INST {
        return false
    }
    val targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val n: i64 = @len(targs) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val t_opt = @get(targs, i as usize)
        if t_opt is some t {
            val tn: ref parser.Node = t as ref parser.Node
            if tn.kind == parser.TY_INFER {
                return true
            }
        }
        i++
    }
    return false
}

/// Resolves TY_INFER type-arg markers in a NK_GENERIC_INST callee by inspecting
/// the corresponding actual call arguments. Mutates callee.d1 with the resolved
/// type-arg list. Emits a compile error if any marker cannot be resolved.
fn resolve_generic_inst_inference(ctx: mut ref SemaCtx, callee: mut ref parser.Node,
    fn_found: ref parser.Node, cargs: ref void,
    filename: ref u8, line: i64) void = trust {
    if !generic_inst_has_infer(callee) {
        return
    }
    if fn_found == none || fn_found.kind != parser.NK_GENERIC_FN {
        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(ebuf, 512, "{s}:{lld}: cannot infer generic type argument(s): function definition not found",
            {filename, line})
        add_error(ctx, ebuf)
        return
    }
    val tparams: ref void = fn_found.d6 as ref void
    val fn_params: ref void = fn_found.d3 as ref void
    val nparams: mut i64 = 0
    if tparams != none {
        nparams = @len(tparams as list[ref parser.Node]) as i64
    }
    if nparams == 0 {
        val ebuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (512) as usize
        ) as ref u8
        @snprintf(ebuf2, 512, "{s}:{lld}: cannot infer generic type argument(s): function has no type parameters",
            {filename, line})
        add_error(ctx, ebuf2)
        return
    }
    val raw_targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val nraw: i64 = @len(raw_targs) as i64

    // Expand a single bare [_] to one TY_INFER per type parameter.
    val effective: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    val expand: mut bool = false
    if nraw == 1 && nparams > 1 {
        val first_opt = @get(raw_targs, 0 as usize)
        if first_opt is some first {
            if ((first as ref parser.Node).kind == parser.TY_INFER) {
                expand = true
            }
        }
    }
    if expand {
        val first_opt2 = @get(raw_targs, 0 as usize)
        if first_opt2 is some first2 {
            val ei: mut i64 = 0
            for {
                if ei >= nparams {
                    break
                }
                @append(effective, first2 as ref parser.Node)
                ei++
            }
        }
    } else {
        for ta in raw_targs {
            @append(effective, ta)
        }
    }

    val resolved: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    val neff: i64 = @len(effective) as i64
    val ri: mut i64 = 0
    for {
        if ri >= neff {
            break
        }
        val ea_opt = @get(effective, ri as usize)
        if ea_opt is some ea {
            val ea_node: ref parser.Node = ea as ref parser.Node
            if ea_node.kind == parser.TY_INFER {
                val tp_opt = @get(tparams as list[ref parser.Node], ri as usize)
                val inferred: mut ref parser.Node = none
                if tp_opt is some tp {
                    val tparam_name: ref u8 = parser.tparam_name_raw(tp as ref parser.Node)
                    inferred = infer_targ_for_tparam(ctx, tparam_name, fn_params, cargs)
                }
                if inferred == none {
                    val tname_for_err: mut ref u8 = c"?"
                    if tp_opt is some tp2 {
                        tname_for_err = parser.tparam_name_raw(tp2 as ref parser.Node)
                    }
                    val ebuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    @snprintf(ebuf3, 512, "{s}:{lld}: cannot infer generic type argument for type parameter '{s}'; specify it explicitly",
                        {filename, line, tname_for_err})
                    add_error(ctx, ebuf3)
                    return
                }
                @append(resolved, inferred)
            } else {
                @append(resolved, ea_node)
            }
        }
        ri++
    }

    val rl: list[ref parser.Node] = resolved
    callee.d1 = rl as i64
}

/// For a given type-parameter name, find the first function param whose declared
/// type (after peeling `mut`/`ref`) is exactly that name, then return a TY_NAMED
/// node with the inferred concrete type of the matching call argument.
fn infer_targ_for_tparam(ctx: ref SemaCtx, tparam_name: ref u8,
    fn_params: ref void, cargs: ref void) ref parser.Node = trust {
    if fn_params == none {
        return none
    }
    if cargs == none {
        return none
    }
    val nfp: i64 = @len(fn_params as list[ref parser.Node]) as i64
    val nca: i64 = @len(cargs as list[ref parser.Node]) as i64
    val pi: mut i64 = 0
    for {
        if pi >= nfp {
            break
        }
        val p_opt = @get(fn_params as list[ref parser.Node], pi as usize)
        if p_opt is some pp {
            val pn: ref parser.Node = pp as ref parser.Node
            val pty: ref parser.Node = pn.d1 as ref parser.Node
            val inner: ref parser.Node = peel_mut_ref(pty)
            if inner != none && inner.kind == parser.TY_NAMED {
                if string.str_eql(parser.node_str_raw(inner.d0), tparam_name) && pi < nca {
                    val ca_opt = @get(cargs as list[ref parser.Node], pi as usize)
                    if ca_opt is some ca {
                        val arg_node: ref parser.Node = ca as ref parser.Node
                        val resolved_tn: ref u8 = resolve_arg_originating_type(ctx, arg_node)
                        if resolved_tn != none && !string.str_eql(
                            resolved_tn,
                            c""
                        ) && !string.str_eql(resolved_tn, c"unknown") {
                            val out: mut ref parser.Node = parser.make_node(
                                ctx.arena,
                                parser.TY_NAMED,
                                0
                            )
                            parser.node_store_string_slot(@addr(out.d0), resolved_tn)
                            return out
                        }
                    }
                }
            }
        }
        pi++
    }
    return none
}

/// Determine the most useful "concrete" type name for a call argument used in
/// generic inference. Tries scope-known type, then identifier origin tracking,
/// then a structural walk of the argument expression for a constructor call.
fn resolve_arg_originating_type(ctx: ref SemaCtx, arg: ref parser.Node) ref u8 = trust {
    if arg == none {
        return none
    }
    val cur: mut ref parser.Node = arg
    for {
        if cur == none {
            break
        }
        val ck: i64 = cur.kind
        if ck == parser.NK_TRUST || ck == parser.NK_TRY {
            cur = cur.d0 as ref parser.Node
            continue
        }
        break
    }
    if cur != none && cur.kind == parser.NK_IDENT {
        val ident_name: ref u8 = parser.node_str_raw(cur.d0)
        val origin: ref u8 = lookup_var_origin(ctx, ident_name)
        if origin != none {
            return origin
        }
    }
    val from_expr: ref u8 = extract_constructor_namespace(ctx, arg)
    if from_expr != none {
        return from_expr
    }
    return infer_expr_scope_type_name(ctx, arg)
}

/// Peels TY_MUT and TY_REF wrappers to expose the inner type node.
fn peel_mut_ref(ty: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = ty
    for {
        if cur == none {
            return none
        }
        if cur.kind == parser.TY_MUT || cur.kind == parser.TY_REF {
            cur = cur.d0 as ref parser.Node
            continue
        }
        return cur
    }
    return none
}

fn check_expr(ctx: mut ref SemaCtx, expr: ref parser.Node, filename: ref u8) void = trust {
    if expr == none {
        return
    }

    val k: i64 = expr.kind
    val line: i64 = expr.line

    if k == parser.NK_INT_LIT || k == parser.NK_FLOAT_LIT || k == parser.NK_STR_LIT ||
    k == parser.NK_BOOL || k == parser.NK_NONE || k == parser.NK_CHAR_LIT {
        return
    }

    if k == parser.NK_GENERIC_INST {
        check_expr(ctx, expr.d0 as ref parser.Node, filename)
        return
    }

    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val has_dot: mut bool = false
        val i: mut i64 = 0
        for {
            val c: u8 = @load8(@ptradd(name, i))
            if c == 0 {
                break
            }
            if c == 46 {
                has_dot = true
                break
            }
            i++
        }
        if !has_dot {
            val lkup = scope_lookup(ctx, name)
            if lkup == -1 {
                val is_known: mut bool = false
                for fn_name in ctx.fn_names {
                    if string.str_eql(fn_name, name) {
                        is_known = true
                        @append(ctx.used_fns, name)
                        break
                    }
                }
                if !is_known {
                    for ty_name in ctx.type_names {
                        if string.str_eql(ty_name, name) {
                            is_known = true
                            break
                        }
                    }
                }
                if !is_known {
                    for tp_name in ctx.type_params {
                        if string.str_eql(tp_name, name) {
                            is_known = true
                            break
                        }
                    }
                }
                if !is_known {
                    for gname in ctx.global_names {
                        if string.str_eql(gname, name) {
                            is_known = true
                            break
                        }
                    }
                }
                if !is_known {
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf,
                        256,
                        "{s}:{lld}: undefined variable '{s}'",
                        {filename, line, name}
                    )
                    add_error(ctx, buf)
                }
            } else {
                mark_name_used(ctx, name)
            }
        }
        return
    }

    if k == parser.NK_BINOP {
        check_expr(ctx, parser.binop_left(expr), filename)
        check_expr(ctx, parser.binop_right(expr), filename)
        val op: i64 = parser.binop_op(expr)
        if is_comparison_op(op) {
            val lhs: ref parser.Node = parser.binop_left(expr)
            val rhs: ref parser.Node = parser.binop_right(expr)
            if !comparison_operands_compatible(ctx, lhs, rhs, op) {
                val lhs_type: ref u8 = comparison_type_name(ctx, lhs)
                val rhs_type: ref u8 = comparison_type_name(ctx, rhs)
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                if string.raw_cmp(lhs_type, c"unknown") == 0 {
                    return
                } elif string.raw_cmp(rhs_type, c"unknown") == 0 {
                    return
                }
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot compare values of type '{s}' and '{s}'",
                    {filename, line, lhs_type, rhs_type}
                )
                add_error(ctx, buf)
            }
        }
        return
    }
    if k == parser.NK_UNOP {
        check_expr(ctx, parser.unop_inner(expr), filename)
        return
    }
    if k == parser.NK_TRUST {
        if ctx.in_unsafe_fn != 0 || ctx.in_trust != 0 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            if ctx.in_unsafe_fn != 0 {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: redundant 'trust' statement; already in a trusted function",
                    {filename, line}
                )
            } else {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: redundant 'trust' statement; already inside a 'trust' block",
                    {filename, line}
                )
            }
            add_error(ctx, buf)
        }
        val pt_used: i64 = ctx.trust_used
        ctx.trust_used = 0
        val prev_trust: i64 = ctx.in_trust
        ctx.in_trust = 1
        check_expr(ctx, expr.d0 as ref parser.Node, filename)
        ctx.in_trust = prev_trust
        if ctx.trust_used == 0 && ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(
                buf,
                512,
                "{s}:{lld}: redundant 'trust' statement; the expression is already pure",
                {filename, line}
            )
            add_error(ctx, buf)
        }
        ctx.trust_used = pt_used | ctx.trust_used
        return
    }
    if k == parser.NK_SOME ||
    k == parser.NK_OK_VAL || k == parser.NK_ERR_VAL {
        val alloc_node: ref parser.Node = parser.wrap_allocator(expr)
        if alloc_node != none {
            check_expr(ctx, alloc_node, filename)
        }
        check_expr(ctx, expr.d0 as ref parser.Node, filename)
        return
    }
    if k == parser.NK_TRY {
        val inner: ref parser.Node = expr.d0 as ref parser.Node
        check_expr(ctx, inner, filename)
        if expr_wrap_kind(ctx, inner) != 1 && sema_try_operand_proves_not_result(ctx, inner) {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            val tname: ref u8 = sema_try_operand_type_name(ctx, inner)
            if tname != none && !string.str_eql(tname, c"") {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use '?' on expression of type '{s}', it is not of type result[T, E]",
                    {filename, line, tname}
                )
            } else {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use '?' here, the operand is not of type result[T, E]",
                    {filename, line}
                )
            }
            add_error(ctx, buf)
        }
        return
    }
    if k == parser.NK_FIELD {
        if is_c_escape_expr(expr) {
            return
        }
        check_no_module_to_module_field(ctx, expr, line, filename)
        check_expr(ctx, parser.field_base(expr), filename)
        return
    }
    if k == parser.NK_CALL {
        val callee: mut ref parser.Node = parser.call_callee(expr)
        val base_callee: ref parser.Node = unwrap_generic_callee(callee)
        val has_explicit_targs: bool = callee_has_explicit_type_args(callee)
        check_expr(ctx, callee, filename)
        val cargs: ref void = parser.call_args(expr) as ref void
        if cargs != none {
            for carg in cargs as list[ref parser.Node] {
                check_expr(ctx, carg, filename)
            }
        }
        val resolved_fn: ref parser.Node = resolve_called_fn(ctx, callee)
        parser.call_set_resolved_fn(expr, resolved_fn)
        if base_callee != none {
            if base_callee.kind == parser.NK_IDENT {
                val fname2: ref u8 = parser.node_str_raw(base_callee.d0)
                @append(ctx.used_fns, fname2)
            } elif base_callee.kind == parser.NK_FIELD {
                val fname: ref u8 = parser.field_name_raw(base_callee)
                if fname != none {
                    @append(ctx.used_fns, fname)
                    val fbase: ref parser.Node = parser.field_base(base_callee)
                    if fbase != none {
                        if fbase.kind == parser.NK_IDENT {
                            val base_name: ref u8 = parser.node_str_raw(fbase.d0)
                            if base_name != none {
                                val qbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (256) as usize
                                ) as ref u8
                                @snprintf(qbuf, 256, "{s}.{s}", {base_name, fname})
                                @append(ctx.used_fns, qbuf)
                            }
                        }
                    }
                }
            }
        }

        val fn_found: mut ref parser.Node = resolved_fn

        if fn_found != none {
            if fn_found.kind == parser.NK_GENERIC_FN && !has_explicit_targs {
                val fn_name: mut ref u8 = none
                if base_callee != none {
                    if base_callee.kind == parser.NK_IDENT {
                        fn_name = parser.node_str_raw(base_callee.d0)
                    } elif base_callee.kind == parser.NK_FIELD {
                        fn_name = parser.field_name_raw(base_callee)
                    }
                }
                val gbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                if fn_name != none {
                    @snprintf(
                        gbuf,
                        512,
                        "{s}:{lld}: generic function '{s}' requires explicit type specifiers, call it as '{s}[Type](...)'",
                        {filename, line, fn_name, fn_name}
                    )
                } else {
                    @snprintf(
                        gbuf,
                        512,
                        "{s}:{lld}: generic function calls require explicit type specifiers",
                        {filename, line}
                    )
                }
                add_error(ctx, gbuf)
            }
            val params: mut ref void = fn_found.d3 as ref void
            if fn_found.kind == parser.NK_EXTERN_FN {
                params = fn_found.d4 as ref void
            }
            if params != none && fn_found.kind != parser.NK_EXTERN_FN {
                val arg_len: mut i64 = 0
                if cargs != none {
                    arg_len = @len(cargs) as i64
                }
                val param_len: i64 = @len(params) as i64
                if arg_len != param_len {
                    val fn_name: mut ref u8 = none
                    if base_callee != none {
                        if base_callee.kind == parser.NK_IDENT {
                            fn_name = parser.node_str_raw(base_callee.d0)
                        } elif base_callee.kind == parser.NK_FIELD {
                            fn_name = parser.field_name_raw(base_callee)
                        }
                    }
                    val arity_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    if fn_name != none {
                        @snprintf(
                            arity_buf,
                            512,
                            "{s}:{lld}: function '{s}' expects {lld} argument(s) but got {lld}",
                            {filename, line, fn_name, param_len, arg_len}
                        )
                    } else {
                        @snprintf(
                            arity_buf,
                            512,
                            "{s}:{lld}: function expects {lld} argument(s) but got {lld}",
                            {filename, line, param_len, arg_len}
                        )
                    }
                    add_error(ctx, arity_buf)
                }
            }
            if params != none && cargs != none {
                val arg_len2: i64 = @len(cargs) as i64
                val param_len2: i64 = @len(params) as i64
                val min_len: mut i64 = param_len2
                if arg_len2 < param_len2 {
                    min_len = arg_len2
                }
                val idx: mut i64 = 0
                for {
                    if idx >= min_len {
                        break
                    }
                    val arg_opt = @get(cargs, idx as usize)
                    val param_opt = @get(params, idx as usize)
                    if arg_opt is some arg_raw {
                        val arg_node: ref parser.Node = arg_raw as ref parser.Node
                        if param_opt is some param_raw {
                            val param_node: ref parser.Node = param_raw as ref parser.Node
                            val pty: ref parser.Node = param_node.d1 as ref parser.Node
                            val param_is_ref: mut bool = false
                            if pty.kind == parser.TY_REF {
                                param_is_ref = true
                            } elif pty.kind == parser.TY_LIST {
                                param_is_ref = true
                            } elif pty.kind == parser.TY_MUT {
                                val pty_inner: ref parser.Node = pty.d0 as ref parser.Node
                                if pty_inner != none && pty_inner.kind == parser.TY_REF {
                                    param_is_ref = true
                                } elif pty_inner != none && pty_inner.kind == parser.TY_LIST {
                                    param_is_ref = true
                                } elif pty_inner != none && pty_inner.kind == parser.TY_NAMED {
                                    param_is_ref = true
                                }
                            }
                            if param_is_ref {
                                val root_node: ref parser.Node = unwrap_and_find_root(arg_node)
                                if root_node != none {
                                    mark_name_mutated(ctx, parser.node_str_raw(root_node.d0))
                                }
                            }

                            if pty.kind == parser.TY_MUT {
                                val root_arg: ref parser.Node = unwrap_and_find_root(arg_node)
                                if root_arg != none && root_arg.kind == parser.NK_IDENT {
                                    val aname: ref u8 = parser.node_str_raw(root_arg.d0)
                                    val arg_mutability: i64 = scope_lookup(ctx, aname)
                                    if arg_mutability == 0 {
                                        val mut_err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                            ctx.arena,
                                            (512) as usize
                                        ) as ref u8
                                        val pname_m: ref u8 = parser.node_str_raw(param_node.d0)
                                        val fn_name_m: mut ref u8 = none
                                        if base_callee != none {
                                            if base_callee.kind == parser.NK_IDENT {
                                                fn_name_m = parser.node_str_raw(base_callee.d0)
                                            } elif base_callee.kind == parser.NK_FIELD {
                                                fn_name_m = parser.field_name_raw(base_callee)
                                            }
                                        }
                                        if fn_name_m != none {
                                            @snprintf(mut_err_buf, 512, "{s}:{lld}: cannot pass immutable '{s}' to mut parameter '{s}' of '{s}'",
                                                {filename, line, aname, pname_m, fn_name_m})
                                        } else {
                                            @snprintf(mut_err_buf, 512, "{s}:{lld}: cannot pass immutable '{s}' to mut parameter '{s}'",
                                                {filename, line, aname, pname_m})
                                        }
                                        add_error(ctx, mut_err_buf)
                                    }
                                }
                            }

                            val arg_wrap: i64 = expr_wrap_kind(ctx, arg_node)
                            val param_wrap: i64 = ty_wrap_kind(pty)
                            if arg_wrap != 0 && arg_wrap != param_wrap {
                                val fn_name_w: mut ref u8 = none
                                if base_callee != none {
                                    if base_callee.kind == parser.NK_IDENT {
                                        fn_name_w = parser.node_str_raw(base_callee.d0)
                                    } elif base_callee.kind == parser.NK_FIELD {
                                        fn_name_w = parser.field_name_raw(base_callee)
                                    }
                                }
                                val arg_wrap_str: mut ref u8 = c"option"
                                if arg_wrap == 1 {
                                    arg_wrap_str = c"result"
                                }
                                val pname_w: ref u8 = parser.node_str_raw(param_node.d0)
                                val wbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (512) as usize
                                ) as ref u8
                                if fn_name_w != none {
                                    @snprintf(wbuf, 512, "{s}:{lld}: type mismatch in call to '{s}': parameter '{s}' does not accept a {s} value; unwrap it first",
                                        {filename, line, fn_name_w, pname_w, arg_wrap_str})
                                } else {
                                    @snprintf(wbuf, 512, "{s}:{lld}: type mismatch: parameter '{s}' does not accept a {s} value; unwrap it first",
                                        {filename, line, pname_w, arg_wrap_str})
                                }
                                add_error(ctx, wbuf)
                            }

                            val raw_param_type_name: ref u8 = extract_type_name(pty)
                            val concrete_param_type_name: ref u8 = concrete_generic_param_type_name(
                                fn_found,
                                callee,
                                raw_param_type_name
                            )
                            val effective_param_type_name: mut ref u8 = raw_param_type_name
                            if concrete_param_type_name != none && !string.str_eql(
                                concrete_param_type_name,
                                c""
                            ) {
                                effective_param_type_name = concrete_param_type_name
                            }
                            val param_type_name: ref u8 = qualify_type_name_for_callee(
                                ctx,
                                callee,
                                effective_param_type_name
                            )
                            val arg_type_name: ref u8 = infer_expr_scope_type_name(ctx, arg_node)
                            val arg_is_ref: i64 = infer_expr_scope_is_ref(ctx, arg_node)

                            if param_type_name != none && !string.str_eql(param_type_name, c"") {
                                val skip_type_check: mut bool = false

                                if ((is_type_parameter(
                                            ctx,
                                            raw_param_type_name
                                        ) && concrete_param_type_name == none) || is_type_parameter(
                                        ctx,
                                        arg_type_name
                                    )) {
                                    skip_type_check = true
                                }

                                if !skip_type_check && fn_found != none && fn_found.kind == parser.NK_GENERIC_FN {
                                    val fn_type_params: ref void = fn_found.d6 as ref void
                                    if fn_type_params != none {
                                        for ftp in fn_type_params as list[ref parser.Node] {
                                            val ftp_name: ref u8 = parser.tparam_name_raw(ftp as ref parser.Node)
                                            if string.str_eql(
                                                ftp_name,
                                                raw_param_type_name
                                            ) || string.str_eql(ftp_name, arg_type_name) {
                                                skip_type_check = true
                                                break
                                            }
                                        }
                                    }
                                }

                                if skip_type_check {
                                    if param_is_ref {
                                        val root_node: ref parser.Node = unwrap_and_find_root(arg_node)
                                        if root_node != none {
                                            mark_name_mutated(
                                                ctx,
                                                parser.node_str_raw(root_node.d0)
                                            )
                                        }
                                    }
                                } else {
                                    val type_mismatch: mut bool = false
                                    val param_expects_ref: bool = pty.kind == parser.TY_REF || (pty.kind == parser.TY_MUT && pty.d0 != none && (pty.d0 as ref parser.Node).kind == parser.TY_REF)

                                    val int_const_arg_ok: bool = !param_expects_ref &&
                                    sema_int_const_arg_compatible(
                                        ctx,
                                        param_type_name,
                                        arg_node,
                                        filename,
                                        line
                                    )
                                    val float_const_arg_ok: bool = !param_expects_ref &&
                                    sema_float_const_arg_compatible(
                                        ctx,
                                        param_type_name,
                                        arg_node,
                                        filename,
                                        line
                                    )

                                    if param_expects_ref && string.str_eql(param_type_name, c"u8") {
                                        if arg_node.kind == parser.NK_STR_LIT &&
                                        !parser.str_lit_is_cstr(arg_node) {
                                            // Plain literals are StringView values; raw C
                                            // strings must be written as c"...".
                                            type_mismatch = true
                                        } elif arg_node.kind == parser.NK_INT_LIT || arg_node.kind == parser.NK_FLOAT_LIT || arg_node.kind == parser.NK_BOOL {
                                            type_mismatch = true
                                        } elif arg_node.kind == parser.NK_IDENT && arg_is_ref == 0 {
                                            if arg_type_name != none && !string.str_eql(
                                                arg_type_name,
                                                c""
                                            ) {
                                                if !string.str_eql(
                                                    arg_type_name,
                                                    c"u8"
                                                ) && !string.str_eql(
                                                    arg_type_name,
                                                    param_type_name
                                                ) {
                                                    type_mismatch = true
                                                }
                                            }
                                        }
                                    } elif !param_expects_ref && arg_type_name != none && !string.str_eql(
                                        arg_type_name,
                                        c""
                                    ) {
                                        if arg_is_ref == 1 && is_builtin_type_name(unqualified_type_name(param_type_name)) {
                                            type_mismatch = true
                                        } elif !types_compatible(
                                            ctx,
                                            param_type_name,
                                            arg_type_name
                                        ) {
                                            if !int_const_arg_ok && !float_const_arg_ok {
                                                val union_def: ref parser.Node = sema_lookup_uniondef(
                                                    ctx,
                                                    param_type_name
                                                )
                                                if union_def != none {
                                                    if !type_matches_union_variant(
                                                        ctx,
                                                        union_def,
                                                        arg_type_name
                                                    ) {
                                                        type_mismatch = true
                                                    }
                                                } else {
                                                    type_mismatch = true
                                                }
                                            }
                                        }
                                    }

                                    if type_mismatch {
                                        val fn_name_for_err: mut ref u8 = none
                                        if base_callee != none {
                                            if base_callee.kind == parser.NK_IDENT {
                                                fn_name_for_err = parser.node_str_raw(base_callee.d0)
                                            } elif base_callee.kind == parser.NK_FIELD {
                                                fn_name_for_err = parser.field_name_raw(base_callee)
                                            }
                                        }
                                        val type_err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                            ctx.arena,
                                            (512) as usize
                                        ) as ref u8
                                        val param_name: ref u8 = parser.node_str_raw(param_node.d0)
                                        val param_type_str: mut ref u8 = param_type_name
                                        if param_expects_ref {
                                            val ref_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                (128) as usize
                                            ) as ref u8
                                            @snprintf(ref_buf, 128, "ref {s}", {param_type_name})
                                            param_type_str = ref_buf
                                        }
                                        val arg_type_str: mut ref u8 = arg_type_name
                                        if arg_is_ref == 1 && arg_type_name != none {
                                            val arg_ref_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                (128) as usize
                                            ) as ref u8
                                            @snprintf(arg_ref_buf, 128, "ref {s}", {arg_type_name})
                                            arg_type_str = arg_ref_buf
                                        }
                                        if fn_name_for_err != none {
                                            @snprintf(type_err_buf, 512, "{s}:{lld}: type mismatch in call to '{s}': parameter '{s}' expects type '{s}' but got '{s}'",
                                                {
                                                    filename,
                                                    line,
                                                    fn_name_for_err,
                                                    param_name,
                                                    param_type_str,
                                                    arg_type_str
                                                })
                                        } else {
                                            @snprintf(type_err_buf, 512, "{s}:{lld}: type mismatch: parameter '{s}' expects type '{s}' but got '{s}'",
                                                {
                                                    filename,
                                                    line,
                                                    param_name,
                                                    param_type_str,
                                                    arg_type_str
                                                })
                                        }
                                        add_error(ctx, type_err_buf)
                                    }
                                }
                            }
                        }
                    }
                    idx++
                }
            }
        }

        sema_check_call_preconditions(ctx, fn_found, cargs, filename, line)

        if generic_inst_has_infer(callee) {
            resolve_generic_inst_inference(ctx, callee, fn_found, cargs, filename, line)
        }
        canonicalize_generic_inst_type_args(ctx, callee)

        if fn_found != none && has_explicit_targs && fn_found.kind != parser.NK_GENERIC_FN {
            val fn_name_for_targs: mut ref u8 = none
            if base_callee != none {
                if base_callee.kind == parser.NK_IDENT {
                    fn_name_for_targs = parser.node_str_raw(base_callee.d0)
                } elif base_callee.kind == parser.NK_FIELD {
                    fn_name_for_targs = parser.field_name_raw(base_callee)
                }
            }
            val targs_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            if fn_name_for_targs != none {
                @snprintf(
                    targs_buf,
                    512,
                    "{s}:{lld}: function '{s}' does not take type arguments",
                    {filename, line, fn_name_for_targs}
                )
            } else {
                @snprintf(
                    targs_buf,
                    512,
                    "{s}:{lld}: this function does not take type arguments",
                    {filename, line}
                )
            }
            add_error(ctx, targs_buf)
        }

        if fn_found != none && has_explicit_targs {
            check_generic_call_arg_types(ctx, fn_found, callee, cargs, filename, line)
            check_generic_call_constraints(ctx, fn_found, callee, filename, line)
        }

        if fn_found == none && cargs != none {
            if base_callee != none && base_callee.kind == parser.NK_IDENT {
                val callee_name: ref u8 = parser.node_str_raw(base_callee.d0)
                val union_name_buf: mut ref u8 = none
                val variant_node: ref parser.Node = sema_lookup_tagged_variant(
                    ctx,
                    callee_name,
                    @addr(union_name_buf) as ref void
                )

                if variant_node != none {
                    val expected_types: ref void = variant_node.d1 as ref void
                    val expected_count: mut i64 = 0
                    if expected_types != none {
                        expected_count = @len(expected_types as list[ref parser.Node]) as i64
                    }

                    val arg_count: i64 = @len(cargs) as i64

                    if arg_count != expected_count {
                        val arity_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (512) as usize
                        ) as ref u8
                        @snprintf(arity_buf, 512, "{s}:{lld}: variant constructor '{s}' expects {lld} argument(s) but got {lld}",
                            {filename, line, callee_name, expected_count, arg_count})
                        add_error(ctx, arity_buf)
                    } else {
                        val idx: mut i64 = 0
                        for {
                            if idx >= expected_count {
                                break
                            }
                            val arg_opt = @get(cargs, idx as usize)
                            val expected_ty_opt = @get(
                                expected_types as list[ref parser.Node],
                                idx as usize
                            )

                            if arg_opt is some arg_raw {
                                val arg_node: ref parser.Node = arg_raw as ref parser.Node
                                if expected_ty_opt is some expected_ty_raw {
                                    val expected_ty: ref parser.Node = expected_ty_raw as ref parser.Node
                                    val expected_type_name: ref u8 = extract_type_name(expected_ty)
                                    val arg_type_name: ref u8 = infer_expr_scope_type_name(
                                        ctx,
                                        arg_node
                                    )

                                    if expected_type_name != none && !string.str_eql(
                                        expected_type_name,
                                        c""
                                    ) &&
                                    arg_type_name != none && !string.str_eql(arg_type_name, c"") {
                                        if !types_compatible(
                                            ctx,
                                            expected_type_name,
                                            arg_type_name
                                        ) {
                                            val type_err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                (512) as usize
                                            ) as ref u8
                                            @snprintf(type_err_buf, 512, "{s}:{lld}: type mismatch in variant constructor '{s}': argument {lld} expects type '{s}' but got '{s}'",
                                                {
                                                    filename,
                                                    line,
                                                    callee_name,
                                                    idx + 1,
                                                    expected_type_name,
                                                    arg_type_name
                                                })
                                            add_error(ctx, type_err_buf)
                                        }
                                    }
                                }
                            }
                            idx++
                        }
                    }
                } else {
                    for carg in cargs as list[ref parser.Node] {
                        val root_carg: ref parser.Node = unwrap_and_find_root(carg)
                        if root_carg != none {
                            val aname: ref u8 = parser.node_str_raw(root_carg.d0)
                            if aname != none {
                                if scope_lookup_is_ref(ctx, aname) == 1 {
                                    if scope_lookup(ctx, aname) == 1 {
                                        mark_name_mutated(ctx, aname)
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                for carg in cargs as list[ref parser.Node] {
                    val root_carg: ref parser.Node = unwrap_and_find_root(carg)
                    if root_carg != none {
                        val aname: ref u8 = parser.node_str_raw(root_carg.d0)
                        if aname != none {
                            if scope_lookup_is_ref(ctx, aname) == 1 {
                                if scope_lookup(ctx, aname) == 1 {
                                    mark_name_mutated(ctx, aname)
                                }
                            }
                        }
                    }
                }
            }
        }

        if base_callee != none && base_callee.kind == parser.NK_FIELD {
            val fname: ref u8 = parser.field_name_raw(base_callee)
            val is_print_call: bool = string.str_eql(
                fname,
                c"print"
            ) || string.str_eql(fname, c"eprint")
            if is_print_call && cargs != none && @len(cargs) > 0 {
                val fmt_opt = @get(cargs, 0)
                if fmt_opt is some fmt_raw {
                    val fmt_node: ref parser.Node = fmt_raw as ref parser.Node
                    if fmt_node.kind == parser.NK_STR_LIT {
                        val fmt_str: ref u8 = parser.str_lit_text_raw(fmt_node)
                        check_printf_fmt(ctx, fmt_str, cargs, 1, filename, line)
                    }
                }
            }
        }
        if base_callee != none {
            if base_callee.kind == parser.NK_FIELD {
                val vis_base: ref parser.Node = parser.field_base(base_callee)
                if vis_base != none {
                    if vis_base.kind == parser.NK_IDENT {
                        val vis_mod_name: ref u8 = parser.node_str_raw(vis_base.d0)
                        val vis_fn_name: ref u8 = parser.field_name_raw(base_callee)
                        if vis_mod_name != none {
                            if vis_fn_name != none {
                                val import_mod: ref modinfo.ResolvedModule = find_import_module(
                                    ctx,
                                    vis_mod_name
                                )
                                if import_mod != none {
                                    if !modinfo.fn_is_public_in_module(import_mod, vis_fn_name) {
                                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                            ctx.arena,
                                            (256) as usize
                                        ) as ref u8
                                        @snprintf(buf, 256, "{s}:{lld}: '{s}' is not public in module '{s}'",
                                            {filename, line, vis_fn_name, vis_mod_name})
                                        add_error(ctx, buf)
                                    }
                                    if modinfo.fn_is_unsafe_in_module(
                                        import_mod,
                                        vis_fn_name
                                    ) && ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
                                        val ubuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                            ctx.arena,
                                            (256) as usize
                                        ) as ref u8
                                        @snprintf(ubuf, 256, "{s}:{lld}: cannot call unsafe function '{s}' from module '{s}' in safe context, use a 'trust' block",
                                            {filename, line, vis_fn_name, vis_mod_name})
                                        add_error(ctx, ubuf)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if fn_found != none && fn_found.kind == parser.NK_EXTERN_FN {
            val extern_name: ref u8 = dotted_chain_name(ctx, base_callee)
            if ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                if extern_name != none {
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: extern call to '{s}' requires 'trust'; prepend 'trust' or move the call into a 'trust' block",
                        {filename, line, extern_name}
                    )
                } else {
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: extern calls require 'trust'; prepend 'trust' or move the call into a 'trust' block",
                        {filename, line}
                    )
                }
                add_error(ctx, ebuf)
            } else {
                ctx.trust_used = 1
            }
        }
        if resolved_fn != none && parser.fn_is_unsafe(resolved_fn) {
            if ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
                val fn_name: mut ref u8 = none
                if base_callee != none {
                    if base_callee.kind == parser.NK_IDENT {
                        fn_name = parser.node_str_raw(base_callee.d0)
                    } elif base_callee.kind == parser.NK_FIELD {
                        fn_name = parser.field_name_raw(base_callee)
                    }
                }
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                if fn_name != none {
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: cannot call unsafe function '{s}' from safe context, use a 'trust' block",
                        {filename, line, fn_name}
                    )
                } else {
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: cannot call unsafe function from safe context, use a 'trust' block",
                        {filename, line}
                    )
                }
                add_error(ctx, ebuf)
            } else {
                ctx.trust_used = 1
            }
        }
        return
    }
    if k == parser.NK_BUILTIN {
        val bname: ref u8 = parser.node_str_raw(expr.d0)
        val bargs: ref void = expr.d1 as ref void
        if bargs != none {
            for barg in bargs as list[ref parser.Node] {
                check_expr(ctx, barg, filename)
            }
        }

        if !is_known_builtin(bname) {
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ebuf, 512, "{s}:{lld}: unknown intrinsic '@{s}'", {filename, line, bname})
            add_error(ctx, ebuf)
            return
        }

        val btype_args: list[ref parser.Node] = parser.builtin_type_args(expr)
        val type_argc: i64 = @len(btype_args) as i64
        val actual_argc: mut i64 = 0
        if bargs != none {
            actual_argc = @len(bargs as list[ref parser.Node]) as i64
        }

        if type_argc > 0 && !string.str_eql(
            bname,
            c"fmtalloc"
        ) && !string.str_eql(bname, c"argsalloc") &&
        !string.str_eql(bname, c"listalloc") {
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' does not take type arguments",
                {filename, line, bname})
            add_error(ctx, ebuf)
            return
        }

        if string.str_eql(bname, c"argsalloc") {
            if type_argc != 1 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@argsalloc' requires exactly one allocator type argument",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
            if actual_argc != 1 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@argsalloc' requires exactly 1 argument, got {lld}",
                    {filename, line, actual_argc})
                add_error(ctx, ebuf)
                return
            }
        }

        if string.str_eql(bname, c"listalloc") {
            if type_argc < 1 || type_argc > 2 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@listalloc' requires an allocator type argument and an optional element type argument",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
            if actual_argc != 1 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@listalloc' requires exactly 1 argument, got {lld}",
                    {filename, line, actual_argc})
                add_error(ctx, ebuf)
                return
            }
        }

        if string.str_eql(bname, c"dumpmemleaks") {
            if type_argc != 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@dumpmemleaks' does not take type arguments",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
            if actual_argc != 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@dumpmemleaks' takes no arguments",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
        }

        if string.str_eql(bname, c"listfree") {
            if type_argc != 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@listfree' does not take type arguments",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
            if actual_argc != 1 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@listfree' requires exactly 1 argument, got {lld}",
                    {filename, line, actual_argc})
                add_error(ctx, ebuf)
                return
            }
            if bargs != none {
                val first_opt = @get(bargs as list[ref parser.Node], 0 as usize)
                if first_opt is some first_raw {
                    val arg_ty: ref u8 = infer_expr_scope_type_name(
                        ctx,
                        first_raw as ref parser.Node
                    )
                    if string.raw_cmp(arg_ty, c"") != 0
                    && !string.raw_starts_with(arg_ty, c"list[") {
                        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (640) as usize
                        ) as ref u8
                        @snprintf(ebuf, 640,
                            "{s}:{lld}: builtin '@listfree' requires a list[T] argument, got '{s}'",
                            {filename, line, arg_ty})
                        add_error(ctx, ebuf)
                        return
                    }
                }
            }
        }

        if string.str_eql(bname, c"puts") {
            val valid: mut bool = actual_argc == 1
            if valid && bargs != none {
                val first_opt = @get(bargs as list[ref parser.Node], 0 as usize)
                if first_opt is some first_raw {
                    val first: ref parser.Node = first_raw as ref parser.Node
                    if first.kind != parser.NK_STR_LIT {
                        valid = false
                    }
                } else {
                    valid = false
                }
            }
            if !valid {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@puts' requires exactly one string literal argument",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
        }

        if string.str_eql(bname, c"fmtalloc") && type_argc > 0 {
            if type_argc != 1 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@fmtalloc' requires exactly one allocator type argument",
                    {filename, line})
                add_error(ctx, ebuf)
                return
            }
            if actual_argc < 2 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: allocatorized '@fmtalloc' requires an allocator and a format string, got {lld} argument(s)",
                    {filename, line, actual_argc})
                add_error(ctx, ebuf)
                return
            }
        }

        val min_arity: i64 = builtin_min_arity(bname)
        if min_arity > 0 {
            if actual_argc < min_arity {
                val plural: mut ref u8 = c"s"
                if min_arity == 1 {
                    plural = c""
                }
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(ebuf, 512, "{s}:{lld}: builtin '@{s}' requires at least {lld} argument{s}, got {lld}",
                    {filename, line, bname, min_arity, plural, actual_argc})
                add_error(ctx, ebuf)
                return
            }
        }

        if string.str_eql(bname, c"embed") || string.str_eql(bname, c"embedlen") {
            resolve_embed_builtin(ctx, expr, bargs, filename, bname)
        }

        val is_unsafe_builtin: bool = string.str_eql(
            bname,
            c"store8"
        ) || string.str_eql(
            bname,
            c"store"
        ) || string.str_eql(
            bname,
            c"load8"
        ) || string.str_eql(
            bname,
            c"load"
        ) || string.str_eql(
            bname,
            c"ptradd"
        ) || string.str_eql(
            bname,
            c"dprintf"
        ) || string.str_eql(
            bname,
            c"print"
        ) || string.str_eql(
            bname,
            c"fmtalloc"
        ) || string.str_eql(
            bname,
            c"memset"
        ) || string.str_eql(
            bname,
            c"memcpy"
        ) || string.str_eql(
            bname,
            c"memmove"
        ) || string.str_eql(
            bname,
            c"free"
        ) || string.str_eql(
            bname,
            c"realloc"
        ) || string.str_eql(
            bname,
            c"addr"
        ) || string.str_eql(bname, c"deref") || string.str_eql(bname, c"bitcast")
        if is_unsafe_builtin {
            if ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
                val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(
                    ebuf,
                    512,
                    "{s}:{lld}: unsafe builtin '@{s}' can only be used inside 'trust' blocks",
                    {filename, line, bname}
                )
                add_error(ctx, ebuf)
            } else {
                ctx.trust_used = 1
            }
        }

        val is_printf: bool = string.str_eql(bname, c"print")
        val is_dprintf: bool = string.str_eql(bname, c"dprintf")
        val is_snprintf: bool = string.str_eql(bname, c"snprintf")
        val is_fmtalloc: bool = string.str_eql(bname, c"fmtalloc")
        if is_printf || is_dprintf || is_snprintf || is_fmtalloc {
            val fmt_idx: mut i64 = 0
            val args_start: mut i64 = 1
            if is_dprintf {
                fmt_idx = 1
                args_start = 2
            }
            if is_snprintf {
                fmt_idx = 2
                args_start = 3
            }
            if is_fmtalloc && type_argc > 0 {
                fmt_idx = 1
                args_start = 2
            }
            if bargs != none {
                val blen: i64 = @len(bargs) as i64
                if blen > fmt_idx {
                    val fmt_opt = @get(bargs, fmt_idx as usize)
                    if fmt_opt is some fmt_raw {
                        val fmt_node: ref parser.Node = fmt_raw as ref parser.Node
                        if fmt_node.kind == parser.NK_STR_LIT {
                            val fmt_str: ref u8 = parser.str_lit_text_raw(fmt_node)
                            check_printf_fmt(ctx, fmt_str, bargs, args_start, filename, line)
                        }
                    }
                }
            }
        }
        if string.str_eql(
            bname,
            c"memcpy"
        ) || string.str_eql(
            bname,
            c"store8"
        ) || string.str_eql(
            bname,
            c"memset"
        ) || string.str_eql(
            bname,
            c"addr"
        ) || string.str_eql(
            bname,
            c"memmove"
        ) || string.str_eql(
            bname,
            c"set"
        ) || string.str_eql(
            bname,
            c"insert"
        ) || string.str_eql(
            bname,
            c"realloc"
        ) || string.str_eql(
            bname,
            c"free"
        ) || string.str_eql(
            bname,
            c"store"
        ) || string.str_eql(
            bname,
            c"append"
        ) || string.str_eql(bname, c"remove") || string.str_eql(bname, c"reserve")
        || string.str_eql(bname, c"getmut") {
            if bargs != none {
                val btarget_opt = @get(bargs as list[ref parser.Node], 0)
                if btarget_opt is some btarget {
                    val root_node: ref parser.Node = unwrap_and_find_root(btarget)
                    if root_node != none {
                        val vname: ref u8 = parser.node_str_raw(root_node.d0)
                        val is_mut: i64 = scope_lookup(ctx, vname)
                        val is_ref: i64 = scope_lookup_is_ref(ctx, vname)
                        if is_mut != -1 && is_mut == 0 && is_ref == 0 {
                            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                (512) as usize
                            ) as ref u8
                            @snprintf(
                                ebuf,
                                512,
                                "{s}:{lld}: cannot pass immutable value '{s}' to mutating builtin '@{s}'",
                                {filename, line, vname, bname}
                            )
                            add_error(ctx, ebuf)
                        }
                        mark_name_mutated(ctx, vname)
                    }
                }
            }
        }

        if string.str_eql(bname, c"sizeof") {
            if bargs != none {
                for barg in bargs as list[ref parser.Node] {
                    if barg.kind == parser.NK_IDENT {
                        mark_name_used(ctx, parser.node_str_raw(barg.d0))
                    } elif barg.kind == parser.NK_FIELD {
                        val root_node2: ref parser.Node = find_root_ident(barg)
                        if root_node2 != none {
                            mark_name_used(ctx, parser.node_str_raw(root_node2.d0))
                        }
                    } elif barg.kind == parser.TY_NAMED {
                        val tname2: ref u8 = parser.node_str_raw(barg.d0)
                        if tname2 != none {
                            val lkup2: i64 = scope_lookup(ctx, tname2)
                            if lkup2 != -1 {
                                mark_name_used(ctx, tname2)
                            }
                        }
                    }
                }
            }
        }
        return
    }
    if k == parser.NK_CAST {
        check_expr(ctx, expr.d0 as ref parser.Node, filename)
        check_cast_type_boundary(ctx, expr, filename, line)
        return
    }
    if k == parser.NK_DEREF {
        check_expr(ctx, expr.d0 as ref parser.Node, filename)
        return
    }
    if k == parser.NK_ADDR {
        val inner: ref parser.Node = expr.d0 as ref parser.Node
        check_expr(ctx, inner, filename)
        if inner != none {
            if inner.kind == parser.NK_IDENT {
                val vname: ref u8 = parser.node_str_raw(inner.d0)
                val is_mut: i64 = scope_lookup(ctx, vname)
                val is_ref: i64 = scope_lookup_is_ref(ctx, vname)
                if is_mut != -1 && is_mut == 0 && is_ref == 0 {
                    val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: cannot take address of immutable variable '{s}'; declare it as 'mut'",
                        {filename, line, vname}
                    )
                    add_error(ctx, ebuf)
                }
                mark_name_mutated(ctx, vname)
            } elif inner.kind == parser.NK_FIELD {
                val root: ref parser.Node = find_root_ident(inner)
                if root != none {
                    mark_name_mutated(ctx, parser.node_str_raw(root.d0))
                }
            }
        }
        return
    }
    if k == parser.NK_STRUCT_LIT {
        val flist: ref void = expr.d0 as ref void
        if flist != none {
            for f in flist as list[ref parser.Node] {
                check_expr(ctx, f.d1 as ref parser.Node, filename)
            }
        }
        return
    }
    if k == parser.NK_LIST_LIT || k == parser.NK_ARGS_PACK {
        val elist: ref void = expr.d0 as ref void
        if elist != none {
            for e in elist as list[ref parser.Node] {
                check_expr(ctx, e, filename)
            }
        }
        return
    }
}


/// Look up a NK_TYPEDEF node by type name. Returns 0 if not found.
fn sema_lookup_typedef(ctx: ref SemaCtx, type_name: ref u8) ref parser.Node = trust {
    if type_name == none {
        return none
    }
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val tdnode: ref parser.Node = td as ref parser.Node
            val tdname: ref u8 = parser.node_str_raw(tdnode.d1)
            if tdname != none {
                if string.raw_cmp(tdname, type_name) == 0 {
                    return tdnode
                }
            }
        }
        ti++
    }
    return none
}

fn sema_rewrite_empty_struct_init(expr: ref parser.Node, tdef: ref parser.Node) bool = trust {
    if expr == none || tdef == none {
        return false
    }
    if expr.kind != parser.NK_ARGS_PACK {
        return false
    }
    val init_args: ref void = expr.d0 as ref void
    if init_args != none && @len(init_args as list[ref parser.Node]) as i64 != 0 {
        return false
    }
    val typedef_fields: ref void = tdef.d2 as ref void
    if typedef_fields == none || @len(typedef_fields as list[ref parser.Node]) as i64 != 0 {
        return false
    }
    val lit_expr: mut ref parser.Node = expr
    lit_expr.kind = parser.NK_STRUCT_LIT
    return true
}

/// Look up a NK_UNIONDEF node by type name. Returns 0 if not found.
fn sema_lookup_uniondef(ctx: ref SemaCtx, type_name: ref u8) ref parser.Node = trust {
    if type_name == none {
        return none
    }
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val tdnode: ref parser.Node = td as ref parser.Node
            if tdnode.kind == parser.NK_UNIONDEF {
                val tdname: ref u8 = parser.node_str_raw(tdnode.d1)
                if tdname != none {
                    if string.raw_cmp(tdname, type_name) == 0 {
                        return tdnode
                    }
                }
            }
        }
        ti++
    }
    return none
}

/// Look up a tagged union variant by name.
/// Returns the variant node (NK_VAL with d0=name, d1=list of type nodes) and sets out_union_name.
/// Returns 0 if not found.
fn sema_lookup_tagged_variant(
    ctx: ref SemaCtx,
    variant_name: ref u8,
    out_union_name: ref void
) ref parser.Node = trust {
    if variant_name == none {
        return none
    }
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val tdnode: ref parser.Node = td as ref parser.Node
            if tdnode.kind == parser.NK_TAGGED_UNIONDEF {
                val variants: ref void = tdnode.d2 as ref void
                if variants != none {
                    for variant in variants as list[ref parser.Node] {
                        val vname: ref u8 = parser.node_str_raw(variant.d0)
                        if vname != none && string.raw_cmp(vname, variant_name) == 0 {
                            if out_union_name != none {
                                val union_name: ref u8 = parser.node_str_raw(tdnode.d1)
                                val union_name_usize: mut usize = 0
                                @store(@addr(union_name_usize) as ref void, union_name)
                                @store(out_union_name, union_name_usize)
                            }
                            return variant
                        }
                    }
                }
            }
        }
        ti++
    }
    return none
}

/// Check if arg_type matches any variant in the union definition.
/// Returns true if arg_type is compatible with any union variant.
fn type_matches_union_variant(
    ctx: ref SemaCtx,
    union_def: ref parser.Node,
    arg_type: ref u8
) bool = trust {
    if union_def == none || arg_type == none {
        return false
    }
    if union_def.kind != parser.NK_UNIONDEF {
        return false
    }

    val variants: ref void = union_def.d2 as ref void
    if variants == none {
        return false
    }

    for variant in variants as list[ref parser.Node] {
        val variant_type_name: ref u8 = extract_type_name(variant)
        if variant_type_name != none {
            if types_compatible(ctx, variant_type_name, arg_type) {
                return true
            }
        }
    }

    return false
}

fn sema_const_known(v: i64) SemaConstVal = trust {
    val r: SemaConstVal = {
        known: true
        is_float: false
        value: v
        fvalue: 0.0
    }
    return r
}

/// Copy a constant value into stable storage so it can be held in a list.
fn sema_const_env_new(ctx: ref SemaCtx) ref SemaConstEnv = trust {
    val env: mut ref SemaConstEnv = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        @sizeof(SemaConstEnv) as usize
    ) as ref SemaConstEnv
    env.names = mem.new[ref u8]()
    env.known = mem.new[i64]()
    env.is_float = mem.new[i64]()
    env.value = mem.new[i64]()
    env.fvalue = mem.new[i64]()
    return env
}

fn sema_const_env_push(env: mut ref SemaConstEnv, name: ref u8, v: SemaConstVal) void = trust {
    @append(env.names, name)
    if v.known {
        @append(env.known, 1)
    } else {
        @append(env.known, 0)
    }
    if v.is_float {
        @append(env.is_float, 1)
    } else {
        @append(env.is_float, 0)
    }
    @append(env.value, v.value)
    @append(env.fvalue, @bitcast(v.fvalue, i64))
}

fn sema_const_env_lookup(env: ref SemaConstEnv, name: ref u8) SemaConstVal = trust {
    if env == none {
        return sema_const_unknown()
    }
    val flen: i64 = @len(env.names) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val fn_opt = @get(env.names, fi as usize)
        if fn_opt is some fname {
            if string.raw_cmp(fname as ref u8, name) == 0 {
                val k_opt = @get(env.known, fi as usize)
                val f_opt = @get(env.is_float, fi as usize)
                val v_opt = @get(env.value, fi as usize)
                val d_opt = @get(env.fvalue, fi as usize)
                val out: mut SemaConstVal = sema_const_unknown()
                if k_opt is some kv {
                    out.known = (kv as i64) != 0
                }
                if f_opt is some fv {
                    out.is_float = (fv as i64) != 0
                }
                if v_opt is some vv {
                    out.value = vv as i64
                }
                if d_opt is some dv {
                    out.fvalue = @bitcast(dv as i64, f64)
                }
                return out
            }
        }
        fi++
    }
    return sema_const_unknown()
}

fn sema_const_known_float(v: f64) SemaConstVal = trust {
    val r: SemaConstVal = {
        known: true
        is_float: true
        value: 0
        fvalue: v
    }
    return r
}

fn sema_const_unknown() SemaConstVal = trust {
    val r: SemaConstVal = {
        known: false
        is_float: false
        value: 0
        fvalue: 0.0
    }
    return r
}

fn sema_const_bool(cond: bool) SemaConstVal = trust {
    if cond {
        return sema_const_known(1)
    }
    return sema_const_known(0)
}

fn sema_const_is_false(v: SemaConstVal) bool = {
    if v.is_float {
        return v.fvalue == 0.0
    }
    return v.value == 0
}

fn sema_const_is_true(v: SemaConstVal) bool = {
    if v.is_float {
        return v.fvalue != 0.0
    }
    return v.value != 0
}

/// Return the value as f64, promoting integer constants when needed.
fn sema_const_as_float(v: SemaConstVal) f64 = {
    if v.is_float {
        return v.fvalue
    }
    return v.value as f64
}

/// Parse the text of an integer literal, including hexadecimal literals.
/// Returns an unknown value if the literal does not fit in i64.
fn sema_parse_int_lit_text(text: ref u8) SemaConstVal = trust {
    if text == none {
        return sema_const_unknown()
    }
    if @load8(text) == 48 {
        val marker: i64 = @load8(@ptradd(text, 1)) as i64
        if marker == 120 || marker == 88 {
            val acc: mut i64 = 0
            val i: mut i64 = 2
            val digits: mut i64 = 0
            for {
                val c: i64 = @load8(@ptradd(text, i)) as i64
                if c == 0 {
                    break
                }
                val digit: mut i64 = c - 48
                if c >= 97 && c <= 102 {
                    digit = c - 87
                } elif c >= 65 && c <= 70 {
                    digit = c - 55
                } elif c < 48 || c > 57 {
                    return sema_const_unknown()
                }
                if acc > (9223372036854775807 - digit) / 16 {
                    return sema_const_unknown()
                }
                acc = acc * 16 + digit
                digits++
                i++
            }
            if digits == 0 {
                return sema_const_unknown()
            }
            return sema_const_known(acc)
        }
    }
    val parse_res = fmt.string_to_i64(text)
    match parse_res {
        ok parsed => {
            return sema_const_known(parsed)
        }
        err _ => {
            return sema_const_unknown()
        }
    }
}

fn sema_parse_float_lit_text(text: ref u8) SemaConstVal = trust {
    if text == none {
        return sema_const_unknown()
    }
    match fmt.string_to_f64(text) {
        ok parsed => {
            return sema_const_known_float(parsed)
        }
        err _ => {
            return sema_const_unknown()
        }
    }
}

/// Constant-fold a simple comparison/boolean expression.
fn sema_const_eval(
    expr: ref parser.Node,
    env: ref SemaConstEnv
) SemaConstVal = trust {
    if expr == none {
        return sema_const_unknown()
    }
    val k: i64 = expr.kind
    if k == parser.NK_INT_LIT {
        val s: ref u8 = parser.node_str_raw(expr.d0)
        return sema_parse_int_lit_text(s)
    }
    if k == parser.NK_FLOAT_LIT {
        val s: ref u8 = parser.float_lit_text_raw(expr)
        return sema_parse_float_lit_text(s)
    }
    if k == parser.NK_BOOL {
        return sema_const_known(expr.d0 as i64)
    }
    if k == parser.NK_CHAR_LIT {
        return sema_const_known(expr.d0 as i64)
    }
    if k == parser.NK_CAST || k == parser.NK_TRUST {
        return sema_const_eval(expr.d0 as ref parser.Node, env)
    }
    if k == parser.NK_IDENT {
        return sema_const_env_lookup(env, parser.node_str_raw(expr.d0))
    }
    if k == parser.NK_UNOP {
        val uop: i64 = expr.d0 as i64
        val inner: ref parser.Node = expr.d1 as ref parser.Node
        val iv: SemaConstVal = sema_const_eval(inner, env)
        if !iv.known {
            return sema_const_unknown()
        }
        if uop == parser.UOP_NEG {
            if iv.is_float {
                return sema_const_known_float(-iv.fvalue)
            }
            return sema_const_known(-iv.value)
        }
        if uop == parser.UOP_NOT {
            if iv.is_float {
                return sema_const_unknown()
            }
            if iv.value == 0 {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        return sema_const_unknown()
    }
    if k == parser.NK_BINOP {
        val op: i64 = expr.d0 as i64
        val lv: SemaConstVal = sema_const_eval(
            expr.d1 as ref parser.Node,
            env
        )
        val rv: SemaConstVal = sema_const_eval(
            expr.d2 as ref parser.Node,
            env
        )
        if !lv.known || !rv.known {
            return sema_const_unknown()
        }
        if lv.is_float || rv.is_float {
            val fa: f64 = sema_const_as_float(lv)
            val fb: f64 = sema_const_as_float(rv)
            if op == parser.OP_GT {
                return sema_const_bool(fa > fb)
            }
            if op == parser.OP_GE {
                return sema_const_bool(fa >= fb)
            }
            if op == parser.OP_LT {
                return sema_const_bool(fa < fb)
            }
            if op == parser.OP_LE {
                return sema_const_bool(fa <= fb)
            }
            if op == parser.OP_EQ {
                return sema_const_bool(fa == fb)
            }
            if op == parser.OP_NE {
                return sema_const_bool(fa != fb)
            }
            if op == parser.OP_ADD {
                return sema_const_known_float(fa + fb)
            }
            if op == parser.OP_SUB {
                return sema_const_known_float(fa - fb)
            }
            if op == parser.OP_MUL {
                return sema_const_known_float(fa * fb)
            }
            if op == parser.OP_DIV {
                if fb == 0.0 {
                    return sema_const_unknown()
                }
                return sema_const_known_float(fa / fb)
            }
            return sema_const_unknown()
        }
        val a: i64 = lv.value
        val b: i64 = rv.value
        if op == parser.OP_GT {
            if a > b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_GE {
            if a >= b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_LT {
            if a < b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_LE {
            if a <= b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_EQ {
            if a == b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_NE {
            if a != b {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_AND {
            if a != 0 && b != 0 {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_OR {
            if a != 0 || b != 0 {
                return sema_const_known(1)
            } else {
                return sema_const_known(0)
            }
        }
        if op == parser.OP_ADD {
            return sema_const_known(a + b)
        }
        if op == parser.OP_SUB {
            return sema_const_known(a - b)
        }
        if op == parser.OP_MUL {
            return sema_const_known(a * b)
        }
        return sema_const_unknown()
    }
    return sema_const_unknown()
}

/// Check an invariant list against compile-time-known field values.
/// Adds an error if any invariant is statically violated.
fn sema_check_invariant_lit(ctx: ref SemaCtx, typedef_node: ref parser.Node,
    args: ref void, filename: ref u8, line: i64) void = trust {
    val inv_list: ref void = typedef_node.d3 as ref void
    if inv_list == none {
        return
    }
    val fields: ref void = typedef_node.d2 as ref void
    if fields == none {
        return
    }

    val env: mut ref SemaConstEnv = sema_const_env_new(ctx)
    val flen: i64 = @len(fields as list[ref parser.Node]) as i64
    val alen: i64 = @len(args as list[ref parser.Node]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen || fi >= alen {
            break
        }
        val field_opt = @get(fields as list[ref parser.Node], fi as usize)
        val arg_opt = @get(args as list[ref parser.Node], fi as usize)
        if field_opt is some fld {
            if arg_opt is some arg {
                val fld_node: ref parser.Node = fld as ref parser.Node
                val fname: ref u8 = parser.node_str_raw(fld_node.d0)
                val ftype: ref u8 = extract_type_name(fld_node.d2 as ref parser.Node)
                val anode: ref parser.Node = arg as ref parser.Node
                val aval: mut SemaConstVal = sema_const_eval(anode, env)
                if aval.known && !aval.is_float && sema_is_float_type_name(ftype) {
                    aval = sema_const_known_float(aval.value as f64)
                }
                if aval.known {
                    sema_const_env_push(env, fname, aval)
                }
            }
        }
        fi++
    }

    val ilen: i64 = @len(inv_list as list[ref parser.Node]) as i64
    val ii: mut i64 = 0
    for {
        if ii >= ilen {
            break
        }
        val inv_opt = @get(inv_list as list[ref parser.Node], ii as usize)
        if inv_opt is some inv {
            val inode: ref parser.Node = inv as ref parser.Node
            val result: SemaConstVal = sema_const_eval(inode, env)
            if result.known && sema_const_is_false(result) {
                val type_name: ref u8 = parser.node_str_raw(typedef_node.d1)
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    256,
                    "{s}:{lld}: invariant violated for type '{s}'",
                    {filename, line, type_name}
                )
                add_error(ctx, buf)
            }
        }
        ii++
    }
}

fn sema_const_eval_no_fields(expr: ref parser.Node) SemaConstVal = trust {
    return sema_const_eval(expr, none)
}

fn sema_is_float_type_name(name: ref u8) bool = trust {
    return string.str_eql(name, c"f32") || string.str_eql(name, c"f64")
}

fn sema_is_int_type_name(name: ref u8) bool = trust {
    return string.str_eql(name, c"i8") || string.str_eql(name, c"i16") || string.str_eql(name, c"i32")
    || string.str_eql(name, c"i64") || string.str_eql(name, c"isize")
    || string.str_eql(name, c"u8") || string.str_eql(name, c"u16") || string.str_eql(name, c"u32")
    || string.str_eql(name, c"u64") || string.str_eql(name, c"usize")
}

/// Returns true if `expr` is a compile-time integer constant expression.
/// Restricting implicit integer conversions to constants keeps runtime values
/// type-safe: a variable of one integer type still needs an explicit cast.
fn sema_is_int_const_expr(expr: ref parser.Node) bool = trust {
    val cur: ref parser.Node = sema_unwrap_trust_expr(expr)
    if cur == none {
        return false
    }
    val k: i64 = cur.kind
    if k == parser.NK_INT_LIT {
        return true
    }
    if k == parser.NK_UNOP {
        val op: i64 = parser.unop_op(cur)
        if op != parser.UOP_NEG && op != parser.UOP_BNOT {
            return false
        }
        return sema_is_int_const_expr(parser.unop_inner(cur))
    }
    if k == parser.NK_BINOP {
        val op: i64 = parser.binop_op(cur)
        if op == parser.OP_ADD || op == parser.OP_SUB || op == parser.OP_MUL ||
        op == parser.OP_DIV || op == parser.OP_REM || op == parser.OP_BAND ||
        op == parser.OP_BOR || op == parser.OP_BXOR || op == parser.OP_SHL ||
        op == parser.OP_SHR {
            return sema_is_int_const_expr(parser.binop_left(cur)) &&
            sema_is_int_const_expr(parser.binop_right(cur))
        }
        return false
    }
    return false
}

/// Returns true when an integer constant expression can be passed directly to
/// a parameter of `type_name` without an explicit cast. Values that are known
/// but out of range are reported here as well.
fn sema_int_const_arg_compatible(
    ctx: ref SemaCtx,
    type_name: ref u8,
    expr: ref parser.Node,
    filename: ref u8,
    line: i64
) bool = trust {
    if type_name == none || expr == none {
        return false
    }
    val tn: ref u8 = unqualified_type_name(type_name)
    if !sema_is_int_type_name(tn) || !sema_is_int_const_expr(expr) {
        return false
    }
    if sema_expr_casts_to(expr, tn) {
        return true
    }
    val value: SemaConstVal = sema_const_eval_no_fields(expr)
    if !value.known {
        if string.str_eql(tn, c"u64") || string.str_eql(tn, c"usize") {
            val lit: ref u8 = sema_direct_int_lit_text(expr)
            if string.raw_cmp(lit, c"") != 0 {
                val is_hex: bool = @load8(lit) == 48 &&
                (@load8(@ptradd(lit, 1)) == 120 || @load8(@ptradd(lit, 1)) == 88)
                if is_hex {
                    if !sema_hex_gt(lit, c"FFFFFFFFFFFFFFFF") {
                        return true
                    }
                    sema_emit_int_overflow_error(
                        ctx,
                        filename,
                        line,
                        lit,
                        tn,
                        c"0",
                        c"18446744073709551615"
                    )
                    return true
                }
                if !sema_decimal_gt(lit, c"18446744073709551615") {
                    return true
                }
                sema_check_int_literal_range(ctx, tn, expr, filename, line)
                return true
            }
        }
        sema_check_int_literal_range(ctx, tn, expr, filename, line)
        return false
    }
    val lo: i64 = sema_int_type_lo(tn)
    val hi: i64 = sema_int_type_hi(tn)
    if value.value < lo || value.value > hi {
        sema_check_int_literal_range(ctx, tn, expr, filename, line)
        return true
    }
    return true
}

/// Returns true if `expr` is a compile-time float constant expression.
fn sema_is_float_const_expr(expr: ref parser.Node) bool = trust {
    val cur: ref parser.Node = sema_unwrap_trust_expr(expr)
    if cur == none {
        return false
    }
    if cur.kind == parser.NK_FLOAT_LIT {
        return true
    }
    if cur.kind == parser.NK_UNOP && parser.unop_op(cur) == parser.UOP_NEG {
        return sema_is_float_const_expr(parser.unop_inner(cur))
    }
    return false
}

/// Returns 1 if a float literal text fits in f32, 0 if it is too large, and
/// -1 if the literal could not be parsed. This compares the decimal
/// representation directly so very large exponents never overflow.
fn sema_f32_lit_range_status(ctx: ref SemaCtx, text: ref u8) i64 = trust {
    val len: i64 = string.len_raw(text)
    val epos: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: i64 = @load8(@ptradd(text, i)) as i64
        if c == 101 || c == 69 {
            epos = i
            break
        }
        i++
    }
    val mant_end: mut i64 = len
    if epos >= 0 {
        mant_end = epos
    }

    val digits_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (len + 1) as usize
    ) as ref u8
    val digits: mut i64 = 0
    val dec_pos: mut i64 = 0
    val seen_dot: mut bool = false
    val mi: mut i64 = 0
    for {
        if mi >= mant_end {
            break
        }
        val c: i64 = @load8(@ptradd(text, mi)) as i64
        if c == 46 {
            if seen_dot {
                return -1
            }
            seen_dot = true
            mi++
            continue
        }
        if c < 48 || c > 57 {
            return -1
        }
        if !seen_dot {
            dec_pos++
        }
        @store8(@ptradd(digits_buf, digits), c as u8)
        digits++
        mi++
    }
    if digits == 0 {
        return -1
    }
    @store8(@ptradd(digits_buf, digits), 0)

    val exponent: mut i64 = 0
    if epos >= 0 {
        val et: mut ref u8 = @ptradd(text, epos + 1) as ref u8
        if @load8(et) == 43 {
            et = @ptradd(et, 1) as ref u8
        }
        if @load8(et) == 0 {
            return -1
        }
        match fmt.string_to_i64(et) {
            ok parsed => {
                exponent = parsed
            }
            err _ => {
                return -1
            }
        }
        if exponent > 100000 {
            exponent = 100000
        } elif exponent < -100000 {
            exponent = -100000
        }
    }

    val leading_zeros: mut i64 = 0
    for {
        if leading_zeros >= digits {
            break
        }
        if @load8(@ptradd(digits_buf, leading_zeros)) != 48 {
            break
        }
        leading_zeros++
    }
    if leading_zeros == digits {
        return 1
    }
    val sci_exp: i64 = (dec_pos - leading_zeros - 1) + exponent
    if sci_exp < 38 {
        return 1
    }
    if sci_exp > 38 {
        return 0
    }

    val max_digits: ref u8 = c"340282346638528859811704183484516925440"
    val max_len: i64 = string.len_raw(max_digits)
    val di: mut i64 = 0
    for {
        if di >= max_len {
            break
        }
        val sig_len: i64 = digits - leading_zeros
        val digit: mut i64 = 48
        if di < sig_len {
            digit = @load8(@ptradd(digits_buf, leading_zeros + di)) as i64
        }
        val max_digit: i64 = @load8(@ptradd(max_digits, di)) as i64
        if digit < max_digit {
            return 1
        }
        if digit > max_digit {
            return 0
        }
        di++
    }
    return 1
}

/// Returns true when a float constant expression can be passed directly to a
/// parameter of `type_name` without an explicit cast.
fn sema_float_const_arg_compatible(
    ctx: ref SemaCtx,
    type_name: ref u8,
    expr: ref parser.Node,
    filename: ref u8,
    line: i64
) bool = trust {
    if type_name == none || expr == none {
        return false
    }
    val tn: ref u8 = unqualified_type_name(type_name)
    if !string.str_eql(tn, c"f32") && !string.str_eql(tn, c"f64") {
        return false
    }
    if !sema_is_float_const_expr(expr) {
        return false
    }
    if string.str_eql(tn, c"f64") {
        return true
    }
    val lit: mut ref parser.Node = sema_unwrap_trust_expr(expr)
    if lit.kind == parser.NK_UNOP {
        lit = parser.unop_inner(lit)
    }
    if lit == none || lit.kind != parser.NK_FLOAT_LIT {
        return false
    }
    val text: ref u8 = parser.float_lit_text_raw(lit)
    val range_status: i64 = sema_f32_lit_range_status(ctx, text)
    if range_status < 0 {
        return false
    }
    if range_status == 0 {
        sema_emit_int_overflow_error(
            ctx,
            filename,
            line,
            text,
            c"f32",
            c"-3.4028235e38",
            c"3.4028235e38"
        )
    }
    return true
}

fn sema_int_type_lo(name: ref u8) i64 = trust {
    if string.str_eql(name, c"i8") {
        return -128
    }
    if string.str_eql(name, c"i16") {
        return -32768
    }
    if string.str_eql(name, c"i32") {
        return -2147483648
    }
    return 0
}

fn sema_int_type_hi(name: ref u8) i64 = trust {
    if string.str_eql(name, c"i8") {
        return 127
    }
    if string.str_eql(name, c"i16") {
        return 32767
    }
    if string.str_eql(name, c"i32") {
        return 2147483647
    }
    if string.str_eql(name, c"u8") {
        return 255
    }
    if string.str_eql(name, c"u16") {
        return 65535
    }
    if string.str_eql(name, c"u32") {
        return 4294967295
    }
    return 9223372036854775807
}

fn sema_expr_casts_to(expr: ref parser.Node, target: ref u8) bool = trust {
    val cur: mut ref parser.Node = expr
    for {
        if cur == none {
            return false
        }
        if cur.kind == parser.NK_TRUST {
            cur = cur.d0 as ref parser.Node
            continue
        }
        if cur.kind == parser.NK_CAST {
            val cast_ty: ref u8 = extract_type_name(cur.d1 as ref parser.Node)
            return string.str_eql(cast_ty, target)
        }
        return false
    }
    return false
}

fn sema_unwrap_trust_expr(expr: ref parser.Node) ref parser.Node = trust {
    val cur: mut ref parser.Node = expr
    for {
        if cur == none || cur.kind != parser.NK_TRUST {
            return cur
        }
        cur = cur.d0 as ref parser.Node
    }
    return cur
}

fn sema_direct_int_lit_text(expr: ref parser.Node) ref u8 = trust {
    val cur: ref parser.Node = sema_unwrap_trust_expr(expr)
    if cur == none || cur.kind != parser.NK_INT_LIT {
        return c""
    }
    return parser.int_lit_text_raw(cur)
}

fn sema_decimal_gt(text: ref u8, max_text: ref u8) bool = trust {
    val len: i64 = string.len_raw(text)
    val start: mut i64 = 0
    for {
        if start >= len {
            break
        }
        if @load8(@ptradd(text, start)) != 48 {
            break
        }
        start++
    }
    if start >= len {
        return false
    }
    val digits: i64 = len - start
    val max_len: i64 = string.len_raw(max_text)
    if digits != max_len {
        return digits > max_len
    }
    val i: mut i64 = 0
    for {
        if i >= digits {
            break
        }
        val a: i64 = @load8(@ptradd(text, start + i)) as i64
        val b: i64 = @load8(@ptradd(max_text, i)) as i64
        if a < b {
            return false
        }
        if a > b {
            return true
        }
        i++
    }
    return false
}

/// Compare the magnitude of a hexadecimal literal (which may not fit in i64)
/// against a hexadecimal limit, ignoring leading zeros and letter case.
fn sema_hex_gt(text: ref u8, max_text: ref u8) bool = trust {
    val len: i64 = string.len_raw(text)
    val start: mut i64 = 2
    for {
        if start >= len {
            break
        }
        if @load8(@ptradd(text, start)) != 48 {
            break
        }
        start++
    }
    val max_len: i64 = string.len_raw(max_text)
    val digits: i64 = len - start
    if digits != max_len {
        return digits > max_len
    }
    val i: mut i64 = 0
    for {
        if i >= digits {
            break
        }
        val a: i64 = @load8(@ptradd(text, start + i)) as i64
        val b: i64 = @load8(@ptradd(max_text, i)) as i64
        val al: mut i64 = a
        val bl: mut i64 = b
        if a >= 97 && a <= 102 {
            al = a - 32
        }
        if b >= 97 && b <= 102 {
            bl = b - 32
        }
        if al < bl {
            return false
        }
        if al > bl {
            return true
        }
        i++
    }
    return false
}

fn sema_emit_int_overflow_error(
    ctx: ref SemaCtx,
    filename: ref u8,
    line: i64,
    value_text: ref u8,
    type_name: ref u8,
    lo_text: ref u8,
    hi_text: ref u8
) void = trust {
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        512 as usize
    ) as ref u8
    @snprintf(
        buf,
        512,
        "{s}:{lld}: constant {s} does not fit in {s} (valid range {s}..{s})",
        {filename, line, value_text, type_name, lo_text, hi_text}
    )
    add_error(ctx, buf)
}

fn sema_check_int_literal_range(
    ctx: ref SemaCtx,
    type_name: ref u8,
    expr: ref parser.Node,
    filename: ref u8,
    line: i64
) void = trust {
    if type_name == none || expr == none {
        return
    }
    if !sema_is_int_type_name(type_name) {
        return
    }
    if sema_expr_casts_to(expr, type_name) {
        return
    }
    if string.str_eql(type_name, c"i64") || string.str_eql(type_name, c"isize") {
        val cur: ref parser.Node = sema_unwrap_trust_expr(expr)
        if cur != none && cur.kind == parser.NK_UNOP && cur.d0 == parser.UOP_NEG {
            val inner: ref parser.Node = cur.d1 as ref parser.Node
            val lit: ref u8 = sema_direct_int_lit_text(inner)
            if string.raw_cmp(lit, c"") != 0 && sema_decimal_gt(lit, c"9223372036854775808") {
                val msg: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(msg, 128, "-{s}", {lit})
                sema_emit_int_overflow_error(
                    ctx,
                    filename,
                    line,
                    msg,
                    type_name,
                    c"-9223372036854775808",
                    c"9223372036854775807"
                )
            }
        } else {
            val lit: ref u8 = sema_direct_int_lit_text(cur)
            if string.raw_cmp(lit, c"") != 0 && sema_decimal_gt(lit, c"9223372036854775807") {
                sema_emit_int_overflow_error(
                    ctx,
                    filename,
                    line,
                    lit,
                    type_name,
                    c"-9223372036854775808",
                    c"9223372036854775807"
                )
            }
        }
        return
    }
    val value: SemaConstVal = sema_const_eval_no_fields(expr)
    if !value.known {
        if string.str_eql(type_name, c"u64") || string.str_eql(type_name, c"usize") {
            val lit: ref u8 = sema_direct_int_lit_text(expr)
            if string.raw_cmp(lit, c"") != 0 && sema_decimal_gt(lit, c"18446744073709551615") {
                sema_emit_int_overflow_error(
                    ctx,
                    filename,
                    line,
                    lit,
                    type_name,
                    c"0",
                    c"18446744073709551615"
                )
            }
        }
        return
    }
    if value.is_float {
        return
    }
    val lo: i64 = sema_int_type_lo(type_name)
    val hi: i64 = sema_int_type_hi(type_name)
    if value.value < lo || value.value > hi {
        val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        val lobuf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        val hibuf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(vbuf, 64, "{lld}", {value.value})
        @snprintf(lobuf, 64, "{lld}", {lo})
        @snprintf(hibuf, 64, "{lld}", {hi})
        sema_emit_int_overflow_error(ctx, filename, line, vbuf, type_name, lobuf, hibuf)
    }
}

/// Collect unconditional preconditions from a function body. Preconditions
/// inside an active compile-time `when` branch are unconditional as well.
fn sema_collect_preconditions(
    ctx: ref SemaCtx,
    stmts: ref void,
    out: mut list[ref parser.Node]
) void = trust {
    if stmts == none {
        return
    }
    for stmt in stmts as list[ref parser.Node] {
        if stmt == none {
            continue
        }
        val k: i64 = stmt.kind
        if k == parser.NK_PRE || k == parser.NK_GUARDED_PRE {
            @append(out, stmt)
        } elif k == parser.NK_WHEN_STMT {
            val selected: ref void = sema_select_when_branch(ctx, stmt)
            if selected != none {
                sema_collect_preconditions(ctx, selected, out)
            }
        }
    }
}

/// Try to evaluate a callee's preconditions at a call site where the arguments
/// are compile-time constants. A statically false precondition is reported as
/// an error instead of being deferred to a runtime assertion.
fn sema_check_call_preconditions(
    ctx: ref SemaCtx,
    fn_found: ref parser.Node,
    cargs: ref void,
    filename: ref u8,
    line: i64
) void = trust {
    if fn_found == none {
        return
    }
    if fn_found.kind != parser.NK_FN && fn_found.kind != parser.NK_GENERIC_FN {
        return
    }
    val params: ref void = fn_found.d3 as ref void
    val body: ref void = fn_found.d5 as ref void
    if params == none || body == none {
        return
    }
    val pres: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    sema_collect_preconditions(ctx, body, pres)
    if @len(pres) as i64 == 0 {
        return
    }

    val env: mut ref SemaConstEnv = sema_const_env_new(ctx)
    val plen: i64 = @len(params as list[ref parser.Node]) as i64
    val alen: mut i64 = 0
    if cargs != none {
        alen = @len(cargs as list[ref parser.Node]) as i64
    }
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        val p_opt = @get(params as list[ref parser.Node], pi as usize)
        if p_opt is some p {
            val pnode: ref parser.Node = p as ref parser.Node
            val pname: ref u8 = parser.node_str_raw(pnode.d0)
            val pval: mut SemaConstVal = sema_const_unknown()
            if pi < alen {
                val a_opt = @get(cargs as list[ref parser.Node], pi as usize)
                if a_opt is some a {
                    pval = sema_const_eval_no_fields(a as ref parser.Node)
                }
            }
            if pval.known {
                sema_const_env_push(env, pname, pval)
            }
        }
        pi++
    }

    val fn_name: ref u8 = parser.node_str_raw(fn_found.d2)
    for pre_node in pres {
        val clist: ref void = pre_node.d0 as ref void
        if clist == none {
            continue
        }
        for c in clist as list[ref parser.Node] {
            if c == none {
                continue
            }
            val label: ref u8 = parser.node_str_raw(c.d0)
            val cexpr: ref parser.Node = c.d1 as ref parser.Node
            val result: SemaConstVal = sema_const_eval(cexpr, env)
            if !result.known || !sema_const_is_false(result) {
                continue
            }
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            if label != none {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: precondition '{s}' of function '{s}' is violated by constant arguments",
                    {filename, line, label, fn_name}
                )
            } else {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: precondition of function '{s}' is violated by constant arguments",
                    {filename, line, fn_name}
                )
            }
            add_error(ctx, buf)
        }
    }
}

fn sema_lookup_enumdef(ctx: ref SemaCtx, type_name: ref u8) ref parser.Node = trust {
    if type_name == none {
        return none
    }
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val tdnode: ref parser.Node = td as ref parser.Node
            if tdnode.kind == parser.NK_ENUMDEF {
                val tdname: ref u8 = parser.node_str_raw(tdnode.d1)
                if tdname != none && string.raw_cmp(tdname, type_name) == 0 {
                    return tdnode
                }
            }
        }
        ti++
    }
    return none
}

fn sema_lookup_tagged_uniondef(ctx: ref SemaCtx, type_name: ref u8) ref parser.Node = trust {
    if type_name == none {
        return none
    }
    val tlen: i64 = @len(ctx.type_defs) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val td_opt = @get(ctx.type_defs, ti as usize)
        if td_opt is some td {
            val tdnode: ref parser.Node = td as ref parser.Node
            if tdnode.kind == parser.NK_TAGGED_UNIONDEF {
                val tdname: ref u8 = parser.node_str_raw(tdnode.d1)
                if tdname != none && string.raw_cmp(tdname, type_name) == 0 {
                    return tdnode
                }
            }
        }
        ti++
    }
    return none
}

fn sema_match_value_is_exhaustive(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    val match_ty: ref u8 = infer_expr_scope_type_name(ctx, stmt.d0 as ref parser.Node)
    if !string.str_eql(match_ty, c"bool") {
        return false
    }
    val arms: ref void = stmt.d1 as ref void
    if arms == none {
        return false
    }
    val has_true: mut bool = false
    val has_false: mut bool = false
    for arm in arms as list[ref parser.Node] {
        val pat: SemaConstVal = sema_const_eval_no_fields(arm.d0 as ref parser.Node)
        if pat.known && !pat.is_float {
            if pat.value == 0 {
                has_false = true
            } elif pat.value == 1 {
                has_true = true
            }
        }
    }
    return has_true && has_false
}

fn sema_match_enum_is_exhaustive(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    val match_ty: ref u8 = infer_expr_scope_type_name(ctx, stmt.d0 as ref parser.Node)
    val enum_def: ref parser.Node = sema_lookup_enumdef(ctx, match_ty)
    if enum_def == none {
        return false
    }
    val variants: ref void = enum_def.d2 as ref void
    val arms: ref void = stmt.d1 as ref void
    if variants == none || arms == none {
        return false
    }
    for variant in variants as list[ref u8] {
        val covered: mut bool = false
        for arm in arms as list[ref parser.Node] {
            val arm_variant: ref u8 = parser.node_str_raw(arm.d0)
            if arm_variant != none && string.str_eql(arm_variant, variant) {
                covered = true
                break
            }
        }
        if !covered {
            return false
        }
    }
    return true
}

fn sema_match_tagged_union_is_exhaustive(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    val match_ty: ref u8 = infer_expr_scope_type_name(ctx, stmt.d0 as ref parser.Node)
    val union_def: ref parser.Node = sema_lookup_tagged_uniondef(ctx, match_ty)
    if union_def == none {
        return false
    }
    val variants: ref void = union_def.d2 as ref void
    val arms: ref void = stmt.d1 as ref void
    if variants == none || arms == none {
        return false
    }
    for variant in variants as list[ref parser.Node] {
        val variant_name: ref u8 = parser.node_str_raw(variant.d0)
        val covered: mut bool = false
        for arm in arms as list[ref parser.Node] {
            val arm_variant: ref u8 = parser.node_str_raw(arm.d0)
            if arm_variant != none && string.str_eql(arm_variant, variant_name) {
                covered = true
                break
            }
        }
        if !covered {
            return false
        }
    }
    return true
}

fn sema_if_stmt_guarantees_return(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    val cond: SemaConstVal = sema_const_eval_no_fields(stmt.d0 as ref parser.Node)
    if cond.known {
        if sema_const_is_true(cond) {
            return stmts_guarantee_return(ctx, stmt.d1 as ref void)
        }
    } else {
        if !stmts_guarantee_return(ctx, stmt.d1 as ref void) {
            return false
        }
    }

    val elif_list: ref void = stmt.d2 as ref void
    if elif_list != none {
        for ep in elif_list as list[ref parser.Node] {
            val elif_v: SemaConstVal = sema_const_eval_no_fields(ep.d0 as ref parser.Node)
            if elif_v.known {
                if sema_const_is_true(elif_v) {
                    return stmts_guarantee_return(ctx, ep.d1 as ref void)
                }
            } else {
                if !stmts_guarantee_return(ctx, ep.d1 as ref void) {
                    return false
                }
            }
        }
    }

    val else_body: ref parser.Node = stmt.d3 as ref parser.Node
    if else_body == none {
        return false
    }
    return stmts_guarantee_return(ctx, else_body.d0 as ref void)
}

fn sema_when_stmt_guarantees_return(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    val selected: ref void = sema_select_when_branch(ctx, stmt)
    if selected == none {
        return false
    }
    return stmts_guarantee_return(ctx, selected)
}

fn expr_is_staticerror(expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    if expr.kind != parser.NK_BUILTIN {
        return false
    }
    val bname: ref u8 = parser.node_str_raw(expr.d0)
    return bname != none && string.str_eql(bname, c"staticerror")
}

fn generic_when_branch_is_exhaustive(stmt: ref parser.Node) bool = trust {
    if stmt == none || stmt.kind != parser.NK_GENERIC_WHEN {
        return false
    }
    val conds: ref void = stmt.d0 as ref void
    if conds == none {
        return false
    }
    for cond in conds as list[ref parser.Node] {
        if cond == none {
            continue
        }
        val ck: i64 = cond.d1 as i64
        if ck == 0 || ck == 3 {
            return true
        }
    }
    return false
}

fn generic_when_group_guarantees_return(
    ctx: ref SemaCtx,
    stmts: ref void,
    start_idx: i64
) bool = trust {
    if stmts == none {
        return false
    }
    val slen: i64 = @len(stmts as list[ref parser.Node]) as i64
    val i: mut i64 = start_idx
    val saw_exhaustive: mut bool = false
    for {
        if i >= slen {
            break
        }
        val stmt_opt = @get(stmts as list[ref parser.Node], i as usize)
        if stmt_opt is some stmt_any {
            val stmt: ref parser.Node = stmt_any as ref parser.Node
            if stmt.kind != parser.NK_GENERIC_WHEN {
                break
            }
            if !stmts_guarantee_return(ctx, stmt.d1 as ref void) {
                return false
            }
            if generic_when_branch_is_exhaustive(stmt) {
                saw_exhaustive = true
            }
        } else {
            break
        }
        i++
    }
    return saw_exhaustive
}

fn stmt_guarantees_return(ctx: ref SemaCtx, stmt: ref parser.Node) bool = trust {
    if stmt == none {
        return false
    }
    val k: i64 = stmt.kind
    if k == parser.NK_RETURN {
        return true
    }
    if k == parser.NK_TRUST_BLOCK {
        return stmts_guarantee_return(ctx, stmt.d0 as ref void)
    }
    if k == parser.NK_EXPR_STMT {
        return expr_is_staticerror(stmt.d0 as ref parser.Node)
    }
    if k == parser.NK_IF {
        return sema_if_stmt_guarantees_return(ctx, stmt)
    }
    if k == parser.NK_MATCH_OPT {
        val some_body: ref parser.Node = stmt.d2 as ref parser.Node
        val none_body: ref parser.Node = stmt.d3 as ref parser.Node
        if some_body == none || none_body == none {
            return false
        }
        return stmts_guarantee_return(ctx, some_body.d0 as ref void) &&
        stmts_guarantee_return(ctx, none_body.d0 as ref void)
    }
    if k == parser.NK_MATCH_RES {
        val ok_body: ref parser.Node = stmt.d2 as ref parser.Node
        val err_body: ref parser.Node = stmt.d4 as ref parser.Node
        if ok_body == none || err_body == none {
            return false
        }
        return stmts_guarantee_return(ctx, ok_body.d0 as ref void) &&
        stmts_guarantee_return(ctx, err_body.d0 as ref void)
    }
    if k == parser.NK_MATCH_VALUE {
        val arms: ref void = stmt.d1 as ref void
        if arms == none {
            return false
        }
        for arm in arms as list[ref parser.Node] {
            if !stmts_guarantee_return(ctx, arm.d1 as ref void) {
                return false
            }
        }
        val else_body: ref parser.Node = stmt.d2 as ref parser.Node
        if else_body != none {
            return stmts_guarantee_return(ctx, else_body.d0 as ref void)
        }
        return sema_match_value_is_exhaustive(ctx, stmt)
    }
    if k == parser.NK_MATCH_ENUM {
        val arms: ref void = stmt.d1 as ref void
        if arms == none {
            return false
        }
        for arm in arms as list[ref parser.Node] {
            if !stmts_guarantee_return(ctx, arm.d1 as ref void) {
                return false
            }
        }
        val else_body: ref parser.Node = stmt.d2 as ref parser.Node
        if else_body != none {
            return stmts_guarantee_return(ctx, else_body.d0 as ref void)
        }
        return sema_match_enum_is_exhaustive(ctx, stmt)
    }
    if k == parser.NK_MATCH_UNION || k == parser.NK_MATCH_STR {
        val arms: ref void = stmt.d1 as ref void
        if arms == none {
            return false
        }
        for arm in arms as list[ref parser.Node] {
            if !stmts_guarantee_return(ctx, arm.d1 as ref void) {
                return false
            }
        }
        val else_body: ref parser.Node = stmt.d2 as ref parser.Node
        if else_body == none {
            return false
        }
        return stmts_guarantee_return(ctx, else_body.d0 as ref void)
    }
    if k == parser.NK_MATCH_TAGGED_UNION {
        val arms: ref void = stmt.d1 as ref void
        if arms == none {
            return false
        }
        for arm in arms as list[ref parser.Node] {
            if !stmts_guarantee_return(ctx, arm.d2 as ref void) {
                return false
            }
        }
        val else_body: ref parser.Node = stmt.d2 as ref parser.Node
        if else_body != none {
            return stmts_guarantee_return(ctx, else_body.d0 as ref void)
        }
        return sema_match_tagged_union_is_exhaustive(ctx, stmt)
    }
    if k == parser.NK_WHEN_STMT {
        return sema_when_stmt_guarantees_return(ctx, stmt)
    }
    if k == parser.NK_GENERIC_WHEN {
        if generic_when_branch_is_exhaustive(stmt) {
            return stmts_guarantee_return(ctx, stmt.d1 as ref void)
        }
        return false
    }
    return false
}

fn stmts_guarantee_return(ctx: ref SemaCtx, stmts: ref void) bool = trust {
    if stmts == none {
        return false
    }
    val slen: i64 = @len(stmts as list[ref parser.Node]) as i64
    val i: mut i64 = 0
    for {
        if i >= slen {
            break
        }
        val stmt_opt = @get(stmts as list[ref parser.Node], i as usize)
        if stmt_opt is some stmt_any {
            val stmt: ref parser.Node = stmt_any as ref parser.Node
            if stmt.kind == parser.NK_GENERIC_WHEN {
                if generic_when_group_guarantees_return(ctx, stmts, i) {
                    return true
                }
                for {
                    if i >= slen {
                        break
                    }
                    val next_opt = @get(stmts as list[ref parser.Node], i as usize)
                    if next_opt is some next_any {
                        if ((next_any as ref parser.Node).kind != parser.NK_GENERIC_WHEN) {
                            break
                        }
                    } else {
                        break
                    }
                    i++
                }
                continue
            }
            if stmt_guarantees_return(ctx, stmt) {
                return true
            }
        }
        i++
    }
    return false
}

fn check_stmts(ctx: mut ref SemaCtx, stmts: ref void, filename: ref u8) void = trust {
    if stmts == none {
        return
    }
    for s in stmts as list[ref parser.Node] {
        check_stmt(ctx, s, filename)
    }
}

fn infer_builtin_list_decl_type(
    ctx: ref SemaCtx,
    init_expr: ref parser.Node
) ref u8 = trust {
    val expr: mut ref parser.Node = init_expr
    val unwrapped: mut bool = false
    if expr != none && expr.kind == parser.NK_TRUST {
        expr = expr.d0 as ref parser.Node
    }
    if expr != none && expr.kind == parser.NK_TRY {
        unwrapped = true
        expr = expr.d0 as ref parser.Node
    }
    if expr == none || expr.kind != parser.NK_BUILTIN {
        return none
    }
    val bname: ref u8 = parser.builtin_name_raw(expr)
    if string.str_eql(
        bname,
        c"list"
    ) || string.str_eql(bname, c"listalloc") || string.str_eql(bname, c"argsalloc") {
        val elem: mut ref u8 = c""
        if string.str_eql(bname, c"argsalloc") {
            elem = c"ref u8"
        } elif string.str_eql(bname, c"listalloc") {
            val targs: list[ref parser.Node] = parser.builtin_type_args(expr)
            if @len(targs) as i64 >= 2 {
                val e_opt = @get(targs, 1 as usize)
                if e_opt is some e {
                    elem = extract_type_name(e as ref parser.Node)
                }
            }
        } else {
            val args: ref void = parser.builtin_args(expr)
            if args != none {
                val alen: i64 = @len(args as list[ref parser.Node]) as i64
                if alen >= 2 {
                    val e_opt = @get(args as list[ref parser.Node], 1 as usize)
                    if e_opt is some e {
                        elem = infer_expr_scope_type_name(ctx, e as ref parser.Node)
                    }
                }
            }
        }
        if elem == none {
            elem = c"unknown"
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        if unwrapped {
            @snprintf(buf, 256, "list[{s}]", {elem})
        } else {
            @snprintf(buf, 256, "result[list[{s}], AllocError]", {elem})
        }
        return buf
    }
    return none
}

/// Infers a type name for simple literal initializers when no explicit type
/// was written. This lets later checks (including format-string validation)
/// know whether an inferred `val` holds a string, integer, float, or char.
fn infer_simple_literal_type_name(expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return none
    }
    val k: i64 = expr.kind
    if k == parser.NK_STR_LIT {
        if parser.str_lit_is_cstr(expr) {
            return c"u8"
        }
        return c"StringView"
    }
    if k == parser.NK_INT_LIT {
        return c"i64"
    }
    if k == parser.NK_FLOAT_LIT {
        return c"f64"
    }
    if k == parser.NK_BOOL {
        return c"bool"
    }
    if k == parser.NK_CHAR_LIT {
        return c"u8"
    }
    if k == parser.NK_TRUST {
        return infer_simple_literal_type_name(expr.d0 as ref parser.Node)
    }
    if k == parser.NK_UNOP {
        return infer_simple_literal_type_name(parser.unop_inner(expr))
    }
    if k == parser.NK_CAST {
        return extract_type_name(expr.d1 as ref parser.Node)
    }
    return none
}

fn val_decl_type_name(
    ctx: ref SemaCtx,
    ty_node: ref parser.Node,
    init_expr: ref parser.Node
) ref u8 = trust {
    val explicit: ref u8 = extract_type_name(ty_node)
    if explicit != none {
        return explicit
    }
    if init_expr != none && init_expr.kind == parser.NK_STRUCT_LIT {
        return parser.struct_lit_type_name_raw(init_expr)
    }
    val literal: ref u8 = infer_simple_literal_type_name(init_expr)
    if literal != none {
        return literal
    }
    return infer_builtin_list_decl_type(ctx, init_expr)
}

/// Infer fixed-array dimensions written as `_` from a list-literal initializer.
/// Returns false when a `_` dimension has no inferable initializer.
fn sema_infer_fixed_arr_sizes(ty: ref parser.Node, init: ref parser.Node) bool = trust {
    if ty == none {
        return true
    }
    if ty.kind == parser.TY_MUT {
        return sema_infer_fixed_arr_sizes(ty.d0 as ref parser.Node, init)
    }
    if ty.kind != parser.TY_FIXED_ARR {
        return true
    }
    val elem_ty: ref parser.Node = ty.d1 as ref parser.Node
    val size_name: ref u8 = parser.fixed_arr_size_name_raw(ty)
    val has_infer: bool = size_name != none && string.str_eql(size_name, c"_")
    if has_infer {
        if init == none || init.kind != parser.NK_LIST_LIT {
            return false
        }
        val elems: ref void = init.d0 as ref void
        val count: mut i64 = 0
        if elems != none {
            count = @len(elems as list[ref parser.Node]) as i64
        }
        parser.node_store_slot[i64](@addr(ty.d0), count)
        parser.node_store_string_slot(@addr(ty.d2), c"")
    }
    if init != none && init.kind == parser.NK_LIST_LIT && elem_ty != none {
        val elems2: ref void = init.d0 as ref void
        if elems2 != none {
            for elem in elems2 as list[ref parser.Node] {
                if !sema_infer_fixed_arr_sizes(elem_ty, elem) {
                    return false
                }
            }
        }
    }
    return true
}

fn check_stmt(ctx: mut ref SemaCtx, stmt: ref parser.Node, filename: ref u8) void = trust {
    guarded pre {
        ctx_not_null: ctx != none
        stmt_not_null: stmt != none
        filename_not_null: filename != none
    }

    val k: i64 = stmt.kind
    val line: i64 = stmt.line

    if k == parser.NK_VAL {
        val name: ref u8 = parser.node_str_raw(stmt.d0)
        val mutable: i64 = stmt.d1
        check_no_module_to_module_type(ctx, stmt.d2 as ref parser.Node, line, filename)
        if !sema_infer_fixed_arr_sizes(
            stmt.d2 as ref parser.Node,
            stmt.d3 as ref parser.Node
        ) {
            val ibuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ibuf, 512,
                "{s}:{lld}: cannot infer fixed array size from initializer; use an explicit size",
                {filename, line})
            add_error(ctx, ibuf)
        }
        check_expr(ctx, stmt.d3 as ref parser.Node, filename)
        sema_check_int_literal_range(
            ctx,
            extract_type_name(stmt.d2 as ref parser.Node),
            stmt.d3 as ref parser.Node,
            filename,
            line
        )
        if scope_defined_local(ctx, name) {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(
                buf,
                256,
                "{s}:{lld}: '{s}' already declared in this scope",
                {filename, line, name}
            )
            add_error(ctx, buf)
        } else {
            val ty_node: ref parser.Node = stmt.d2 as ref parser.Node
            val tname: ref u8 = val_decl_type_name(ctx, ty_node, stmt.d3 as ref parser.Node)
            val init_expr: ref parser.Node = stmt.d3 as ref parser.Node
            val is_ref_flag: mut i64 = 0
            if ty_node != none {
                if ty_node.kind == parser.TY_REF {
                    is_ref_flag = 1
                } elif ty_node.kind == parser.TY_MUT {
                    val inner_ty: ref parser.Node = ty_node.d0 as ref parser.Node
                    if inner_ty != none && inner_ty.kind == parser.TY_REF {
                        is_ref_flag = 1
                    }
                }
            } elif init_expr != none {
                is_ref_flag = infer_expr_scope_is_ref(ctx, init_expr)
            }
            if is_ref_flag == 1 && init_expr != none {
                if !ref_assignment_rhs_ok(ctx, tname, is_ref_flag, init_expr) {
                    val target_ty: ref u8 = format_type_for_error(ctx, tname, is_ref_flag)
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf,
                        256,
                        "{s}:{lld}: cannot assign value to '{s}' without an explicit cast to that ref type",
                        {filename, line, target_ty}
                    )
                    add_error(ctx, buf)
                }
            }
            scope_define(ctx, name, mutable, tname, is_ref_flag, line)
            if tname == none && init_expr != none {
                val origin_ns: ref u8 = extract_constructor_namespace(ctx, init_expr)
                if origin_ns != none {
                    record_var_origin(ctx, name, origin_ns)
                }
            }
            val explicit_wrap: i64 = ty_wrap_kind(ty_node)
            val final_wrap: mut i64 = explicit_wrap
            if final_wrap == 0 && init_expr != none {
                final_wrap = expr_wrap_kind(ctx, init_expr)
            }
            if final_wrap != 0 {
                scope_set_wrap_kind(ctx, name, final_wrap)
            }
            if tname != none && init_expr != none {
                val init_k: i64 = init_expr.kind
                val tdef: ref parser.Node = sema_lookup_typedef(ctx, tname)
                if init_k == parser.NK_ARGS_PACK && tdef != none {
                    if !sema_rewrite_empty_struct_init(init_expr, tdef) {
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (256) as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            256,
                            "{s}:{lld}: positional struct literal not allowed for type '{s}'; use named field syntax",
                            {filename, line, tname}
                        )
                        add_error(ctx, buf)
                    }
                } elif init_k == parser.NK_STRUCT_LIT && tdef != none {
                    val typedef_fields: ref void = tdef.d2 as ref void
                    val lit_fields: ref void = init_expr.d0 as ref void
                    if typedef_fields != none && lit_fields != none {
                        val ordered_args: mut list[ref parser.Node] = mem.new[ref parser.Node]()
                        val missing_field: mut bool = false
                        val tflen: i64 = @len(typedef_fields as list[ref parser.Node]) as i64
                        val tfi: mut i64 = 0
                        for {
                            if tfi >= tflen {
                                break
                            }
                            val tf_opt = @get(typedef_fields as list[ref parser.Node], tfi as usize)
                            if tf_opt is some tf {
                                val tfname: ref u8 = parser.node_str_raw((tf as ref parser.Node).d0)
                                val lflen: i64 = @len(lit_fields as list[ref parser.Node]) as i64
                                val lfi: mut i64 = 0
                                val found: mut ref parser.Node = none
                                for {
                                    if lfi >= lflen {
                                        break
                                    }
                                    val lf_opt = @get(
                                        lit_fields as list[ref parser.Node],
                                        lfi as usize
                                    )
                                    if lf_opt is some lf {
                                        val lfname: ref u8 = parser.node_str_raw((lf as ref parser.Node).d0)
                                        if string.str_eql(lfname, tfname) {
                                            found = (lf as ref parser.Node).d1 as ref parser.Node
                                            lfi = lflen
                                        }
                                    }
                                    lfi++
                                }
                                if found == none {
                                    missing_field = true
                                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        (256) as usize
                                    ) as ref u8
                                    @snprintf(buf, 256, "{s}:{lld}: missing initializer for field '{s}' of type '{s}'",
                                        {filename, line, tfname, tname})
                                    add_error(ctx, buf)
                                }
                                @append(ordered_args, found)
                            }
                            tfi++
                        }
                        val ordered_args_list: list[ref parser.Node] = ordered_args
                        if !missing_field {
                            sema_check_invariant_lit(
                                ctx,
                                tdef,
                                ordered_args_list as ref void,
                                filename,
                                line
                            )
                        }
                    }
                }
            }
        }
        return
    }

    if k == parser.NK_ASSIGN {
        val rhs: ref parser.Node = stmt.d1 as ref parser.Node
        check_expr(ctx, rhs, filename)
        val target: ref parser.Node = stmt.d0 as ref parser.Node
        if target.kind == parser.NK_IDENT {
            val tname: ref u8 = parser.node_str_raw(target.d0)
            mark_name_mutated(ctx, tname)
            if scope_lookup(ctx, tname) == 0 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    256,
                    "{s}:{lld}: cannot assign to immutable '{s}'",
                    {filename, line, tname}
                )
                add_error(ctx, buf)
            } else {
                val target_is_ref: i64 = scope_lookup_is_ref(ctx, tname)
                val target_type_name: ref u8 = scope_lookup_type(ctx, tname)
                sema_check_int_literal_range(ctx, target_type_name, rhs, filename, line)
                if target_is_ref == 1 && target_type_name != none {
                    if !ref_assignment_rhs_ok(ctx, target_type_name, target_is_ref, rhs) {
                        val target_ty: ref u8 = format_type_for_error(ctx,
                            target_type_name,
                            target_is_ref
                        )
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (256) as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            256,
                            "{s}:{lld}: cannot assign value to '{s}' without an explicit cast to that ref type",
                            {filename, line, target_ty}
                        )
                        add_error(ctx, buf)
                    }
                }
            }
        } elif target.kind == parser.NK_FIELD {
            val root: ref parser.Node = find_root_ident(target)
            if root != none {
                val tname: ref u8 = parser.node_str_raw(root.d0)
                mark_name_mutated(ctx, tname)
                val lkup: i64 = scope_lookup(ctx, tname)
                if lkup == 0 {
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf,
                        256,
                        "{s}:{lld}: cannot assign to field of immutable '{s}'",
                        {filename, line, tname}
                    )
                    add_error(ctx, buf)
                } else {
                    val field_name: ref u8 = parser.field_name_raw(target)
                    val var_type: ref u8 = scope_lookup_type(ctx, tname)
                    if var_type != none && field_name != none {
                        val fmut: i64 = find_field_mutable(ctx, var_type, field_name)
                        if fmut == 0 {
                            val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                (256) as usize
                            ) as ref u8
                            @snprintf(
                                buf2,
                                256,
                                "{s}:{lld}: cannot assign to immutable field '{s}' of type '{s}'",
                                {filename, line, field_name, var_type}
                            )
                            add_error(ctx, buf2)
                        } else {
                            val fty: ref parser.Node = find_field_type_node(
                                ctx,
                                var_type,
                                field_name
                            )
                            if fty != none {
                                sema_check_int_literal_range(
                                    ctx,
                                    extract_type_name(fty),
                                    rhs,
                                    filename,
                                    line
                                )
                            }
                            if fty != none && sema_ty_is_ref(fty) == 1 {
                                val fty_name: ref u8 = extract_type_name(fty)
                                if !ref_assignment_rhs_ok(ctx, fty_name, 1, rhs) {
                                    val target_ty: ref u8 = format_type_for_error(ctx, fty_name, 1)
                                    val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        (256) as usize
                                    ) as ref u8
                                    @snprintf(
                                        buf3,
                                        256,
                                        "{s}:{lld}: cannot assign value to '{s}' without an explicit cast to that ref type",
                                        {filename, line, target_ty}
                                    )
                                    add_error(ctx, buf3)
                                }
                            }
                        }
                    }
                }
            } else {
                check_expr(ctx, target, filename)
            }
        } elif target.kind == parser.NK_DEREF {
            val inner_deref: ref parser.Node = target.d0 as ref parser.Node
            if inner_deref != none && inner_deref.kind == parser.NK_IDENT {
                val dname: ref u8 = parser.node_str_raw(inner_deref.d0)
                val dmut: i64 = scope_lookup(ctx, dname)
                if dmut != -1 && dmut == 0 {
                    val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (512) as usize
                    ) as ref u8
                    @snprintf(
                        ebuf,
                        512,
                        "{s}:{lld}: cannot assign through immutable reference '{s}'; parameter must be declared 'mut ref'",
                        {filename, line, dname}
                    )
                    add_error(ctx, ebuf)
                }
                mark_name_mutated(ctx, dname)
            } else {
                check_expr(ctx, target, filename)
            }
        } else {
            check_expr(ctx, target, filename)
        }
        return
    }

    if k == parser.NK_RETURN {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        return
    }
    if k == parser.NK_EXPR_STMT {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        return
    }
    if k == parser.NK_ASSERT {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        return
    }

    if k == parser.NK_GUARD {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        val gbody: ref void = stmt.d1 as ref void
        push_scope(ctx)
        check_stmts(ctx, gbody, filename)
        pop_scope(ctx, filename, line)
        val gbody_len: mut i64 = 0
        if gbody != none {
            gbody_len = @len(gbody as list[ref parser.Node]) as i64
        }
        val ends_with_return: mut bool = false
        if gbody_len > 0 {
            val last_opt = @get(gbody as list[ref parser.Node], (gbody_len - 1) as usize)
            if last_opt is some last {
                if ((last as ref parser.Node).kind == parser.NK_RETURN) {
                    ends_with_return = true
                }
            }
        }
        if !ends_with_return {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(
                buf,
                256,
                "{s}:{lld}: guard else block must end with a return statement",
                {filename, line}
            )
            add_error(ctx, buf)
        }
        return
    }

    if k == parser.NK_IF {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        push_scope(ctx)
        check_stmts(ctx, stmt.d1 as ref void, filename)
        pop_scope(ctx, filename, line)
        val elif_list: ref void = stmt.d2 as ref void
        if elif_list != none {
            for ep in elif_list as list[ref parser.Node] {
                check_expr(ctx, ep.d0 as ref parser.Node, filename)
                push_scope(ctx)
                check_stmts(ctx, ep.d1 as ref void, filename)
                pop_scope(ctx, filename, line)
            }
        }
        val else_body: ref void = stmt.d3 as ref void
        if else_body != none {
            push_scope(ctx)
            check_stmts(ctx, (stmt.d3 as ref parser.Node).d0 as ref void, filename)
            pop_scope(ctx, filename, line)
        }
        return
    }

    if k == parser.NK_FOR {
        push_scope(ctx)
        val init_name: ref u8 = parser.node_str_raw(stmt.d0)
        if init_name != none {
            check_expr(ctx, stmt.d1 as ref parser.Node, filename)
            if scope_lookup(ctx, init_name) != -1 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(buf, 256, "{s}:{lld}: for loop variable '{s}' shadows an existing variable; declare it only in the for loop",
                    {filename, line, init_name})
                add_error(ctx, buf)
            } else {
                scope_define(ctx, init_name, 1, none, 0, line)
                mark_name_mutated(ctx, init_name)
            }
        }
        check_expr(ctx, stmt.d2 as ref parser.Node, filename)
        check_stmts(ctx, stmt.d4 as ref void, filename)
        pop_scope(ctx, filename, line)
        return
    }

    if k == parser.NK_FORIN {
        val binding: ref u8 = parser.node_str_raw(stmt.d0)
        check_expr(ctx, stmt.d1 as ref parser.Node, filename)
        push_scope(ctx)
        scope_define(ctx, binding, 0, none, 0, line)
        check_stmts(ctx, stmt.d2 as ref void, filename)
        pop_scope(ctx, filename, line)
        return
    }

    if k == parser.NK_DEFER {
        push_scope(ctx)
        check_stmts(ctx, stmt.d0 as ref void, filename)
        pop_scope(ctx, filename, line)
        return
    }

    if k == parser.NK_PRE || k == parser.NK_POST || k == parser.NK_GUARDED_PRE || k == parser.NK_GUARDED_POST {
        val clist: ref void = stmt.d0 as ref void
        if clist != none {
            for c in clist as list[ref parser.Node] {
                check_expr(ctx, c.d1 as ref parser.Node, filename)
            }
        }
        return
    }

    if k == parser.NK_MATCH_VALUE {
        val match_expr: ref parser.Node = stmt.d0 as ref parser.Node
        check_expr(ctx, match_expr, filename)
        val match_ty: ref u8 = infer_expr_scope_type_name(ctx, match_expr)
        val match_cat: ref u8 = get_expr_type_category(ctx, match_expr)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            for arm in arms as list[ref parser.Node] {
                val pat: ref parser.Node = arm.d0 as ref parser.Node
                check_expr(ctx, pat, filename)
                val pat_ty: ref u8 = infer_expr_scope_type_name(ctx, pat)
                val pat_cat: ref u8 = get_expr_type_category(ctx, pat)
                val compatible: mut bool = true
                if string.str_eql(match_ty, c"bool") && !string.str_eql(pat_ty, c"") {
                    compatible = string.str_eql(pat_ty, c"bool")
                } elif string.str_eql(match_cat, c"float") && !string.str_eql(pat_cat, c"unknown") {
                    compatible = string.str_eql(pat_cat, c"float")
                } elif string.str_eql(match_cat, c"int") && !string.str_eql(pat_cat, c"unknown") {
                    compatible = string.str_eql(pat_cat, c"int") && !string.str_eql(pat_ty, c"u8")
                }
                if !compatible {
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf,
                        256,
                        "{s}:{lld}: match pattern is not compatible with the matched expression",
                        {filename, line}
                    )
                    add_error(ctx, buf)
                }
                push_scope(ctx)
                check_stmts(ctx, arm.d1 as ref void, filename)
                pop_scope(ctx, filename, line)
            }
        }
        val else_node: ref parser.Node = stmt.d2 as ref parser.Node
        if else_node != none {
            push_scope(ctx)
            check_stmts(ctx, else_node.d0 as ref void, filename)
            pop_scope(ctx, filename, line)
        }
        return
    }

    if k == parser.NK_MATCH_OPT {
        val match_expr: ref parser.Node = stmt.d0 as ref parser.Node
        check_expr(ctx, match_expr, filename)
        val opt_wrap_kind: i64 = expr_wrap_kind(ctx, match_expr)
        if opt_wrap_kind == 3 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(buf, 512, "{s}:{lld}: cannot match on a non-option value", {filename, line})
            add_error(ctx, buf)
        } elif parser.match_opt_is_sugar(stmt) {
            val sugar_kind: i64 = parser.match_opt_sugar_kind(stmt)
            if opt_wrap_kind == 1 && sugar_kind == 1 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use 'is some' with a result value; use 'is ok' instead",
                    {filename, line}
                )
                add_error(ctx, buf)
            } elif opt_wrap_kind == 1 && sugar_kind == 2 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use 'is none' with a result value; use 'is err' instead",
                    {filename, line}
                )
                add_error(ctx, buf)
            }
        }
        val some_bind: ref u8 = parser.node_str_raw(stmt.d1)
        val some_body_node: ref parser.Node = stmt.d2 as ref parser.Node
        val none_body_node: ref parser.Node = stmt.d3 as ref parser.Node
        push_scope(ctx)
        if some_bind != none {
            scope_define(ctx, some_bind, 1, none, 0, line)
            scope_set_implicit_mut(ctx, some_bind)
        }
        if some_body_node != none {
            check_stmts(ctx, some_body_node.d0 as ref void, filename)
        }
        pop_scope(ctx, filename, line)
        push_scope(ctx)
        if none_body_node != none {
            check_stmts(ctx, none_body_node.d0 as ref void, filename)
        }
        pop_scope(ctx, filename, line)
        return
    }

    if k == parser.NK_MATCH_RES {
        val match_expr: ref parser.Node = stmt.d0 as ref parser.Node
        check_expr(ctx, match_expr, filename)
        if parser.match_res_is_sugar(stmt) {
            val wrap_kind: i64 = expr_wrap_kind(ctx, match_expr)
            val sugar_kind: i64 = parser.match_res_sugar_kind(stmt)
            if wrap_kind == 2 && sugar_kind == 1 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use 'is ok' with an option value; use 'is some' instead",
                    {filename, line}
                )
                add_error(ctx, buf)
            } elif wrap_kind == 2 && sugar_kind == 2 {
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (512) as usize
                ) as ref u8
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: cannot use 'is err' with an option value; use 'is none' instead",
                    {filename, line}
                )
                add_error(ctx, buf)
            }
        }
        val ok_bind: ref u8 = parser.node_str_raw(stmt.d1)
        val ok_body_node: ref parser.Node = stmt.d2 as ref parser.Node
        push_scope(ctx)
        if ok_bind != none {
            scope_define(ctx, ok_bind, 1, none, 0, line)
            scope_set_implicit_mut(ctx, ok_bind)
        }
        if ok_body_node != none {
            check_stmts(ctx, ok_body_node.d0 as ref void, filename)
        }
        pop_scope(ctx, filename, line)
        val err_bind: ref u8 = parser.node_str_raw(stmt.d3)
        val err_body_node: ref parser.Node = stmt.d4 as ref parser.Node
        push_scope(ctx)
        if err_bind != none {
            scope_define(ctx, err_bind, 1, none, 0, line)
            scope_set_implicit_mut(ctx, err_bind)
        }
        if err_body_node != none {
            check_stmts(ctx, err_body_node.d0 as ref void, filename)
        }
        pop_scope(ctx, filename, line)
        return
    }

    if k == parser.NK_MATCH_ENUM || k == parser.NK_MATCH_STR || k == parser.NK_MATCH_UNION {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        val arms: ref void = stmt.d1 as ref void
        if arms != none {
            for arm in arms as list[ref parser.Node] {
                push_scope(ctx)
                check_stmts(ctx, arm.d1 as ref void, filename)
                pop_scope(ctx, filename, line)
            }
        }
        val else_node: ref parser.Node = stmt.d2 as ref parser.Node
        if else_node != none {
            push_scope(ctx)
            check_stmts(ctx, else_node.d0 as ref void, filename)
            pop_scope(ctx, filename, line)
        }
        return
    }

    if k == parser.NK_MATCH_TAGGED_UNION {
        check_expr(ctx, stmt.d0 as ref parser.Node, filename)
        val tu_arms: ref void = stmt.d1 as ref void
        if tu_arms != none {
            for tu_arm in tu_arms as list[ref parser.Node] {
                push_scope(ctx)
                val bindings: ref void = tu_arm.d1 as ref void
                if bindings != none {
                    for bname in bindings as list[ref u8] {
                        if string.raw_cmp(bname, c"_") != 0 {
                            scope_define(ctx, bname, 1, none, 0, line)
                            scope_set_implicit_mut(ctx, bname)
                        }
                    }
                }
                val arm_body: ref void = tu_arm.d2 as ref void
                check_stmts(ctx, arm_body, filename)
                if bindings != none {
                    for bname2 in bindings as list[ref u8] {
                        if string.raw_cmp(bname2, c"_") != 0 {
                            if !stmts_use_name(arm_body, bname2) {
                                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (256) as usize
                                ) as ref u8
                                @snprintf(buf, 256, "{s}:{lld}: match binding '{s}' is captured but never used (use '_' to discard)",
                                    {filename, tu_arm.line, bname2})
                                add_error(ctx, buf)
                            }
                        }
                    }
                }
                pop_scope(ctx, filename, line)
            }
        }
        val tu_else: ref parser.Node = stmt.d2 as ref parser.Node
        if tu_else != none {
            push_scope(ctx)
            check_stmts(ctx, tu_else.d0 as ref void, filename)
            pop_scope(ctx, filename, line)
        }
        return
    }

    if k == parser.NK_GENERIC_WHEN {
        push_scope(ctx)
        check_stmts(ctx, stmt.d1 as ref void, filename)
        pop_scope(ctx, filename, line)
        return
    }
    if k == parser.NK_WHEN_STMT {
        val selected: ref void = sema_select_when_branch(ctx, stmt)
        if selected != none {
            push_scope(ctx)
            check_stmts(ctx, selected, filename)
            pop_scope(ctx, filename, line)
        }
        return
    }

    if k == parser.NK_INCREMENT || k == parser.NK_DECREMENT {
        val target2: ref parser.Node = stmt.d0 as ref parser.Node
        if target2.kind == parser.NK_IDENT {
            val tname2: ref u8 = parser.node_str_raw(target2.d0)
            mark_name_mutated(ctx, tname2)
            if scope_lookup(ctx, tname2) == 0 {
                val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(
                    buf2,
                    256,
                    "{s}:{lld}: cannot mutate immutable '{s}'",
                    {filename, line, tname2}
                )
                add_error(ctx, buf2)
            }
        } elif target2.kind == parser.NK_FIELD {
            val root2: ref parser.Node = find_root_ident(target2)
            if root2 != none {
                val tname2: ref u8 = parser.node_str_raw(root2.d0)
                mark_name_mutated(ctx, tname2)
                val lkup2: i64 = scope_lookup(ctx, tname2)
                if lkup2 == 0 {
                    val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf2,
                        256,
                        "{s}:{lld}: cannot mutate field of immutable '{s}'",
                        {filename, line, tname2}
                    )
                    add_error(ctx, buf2)
                } else {
                    val field_name2: ref u8 = parser.field_name_raw(target2)
                    val var_type2: ref u8 = scope_lookup_type(ctx, tname2)
                    if var_type2 != none && field_name2 != none {
                        val fmut2: i64 = find_field_mutable(ctx, var_type2, field_name2)
                        if fmut2 == 0 {
                            val buf2b: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                (256) as usize
                            ) as ref u8
                            @snprintf(
                                buf2b,
                                256,
                                "{s}:{lld}: cannot mutate immutable field '{s}' of type '{s}'",
                                {filename, line, field_name2, var_type2}
                            )
                            add_error(ctx, buf2b)
                        }
                    }
                }
            }
        }
        return
    }

    if k == parser.NK_ADD_ASSIGN || k == parser.NK_SUB_ASSIGN {
        check_expr(ctx, stmt.d1 as ref parser.Node, filename)
        val target3: ref parser.Node = stmt.d0 as ref parser.Node
        if target3.kind == parser.NK_IDENT {
            val tname3: ref u8 = parser.node_str_raw(target3.d0)
            mark_name_mutated(ctx, tname3)
            if scope_lookup(ctx, tname3) == 0 {
                val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (256) as usize
                ) as ref u8
                @snprintf(
                    buf3,
                    256,
                    "{s}:{lld}: cannot mutate immutable '{s}'",
                    {filename, line, tname3}
                )
                add_error(ctx, buf3)
            }
        } elif target3.kind == parser.NK_FIELD {
            val root3: ref parser.Node = find_root_ident(target3)
            if root3 != none {
                val tname3: ref u8 = parser.node_str_raw(root3.d0)
                mark_name_mutated(ctx, tname3)
                if scope_lookup(ctx, tname3) == 0 {
                    val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(
                        buf3,
                        256,
                        "{s}:{lld}: cannot mutate field of immutable '{s}'",
                        {filename, line, tname3}
                    )
                    add_error(ctx, buf3)
                }
            }
        }
        return
    }

    if k == parser.NK_TRUST_BLOCK {
        if ctx.in_unsafe_fn != 0 || ctx.in_trust != 0 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            if ctx.in_unsafe_fn != 0 {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: redundant 'trust' block; already in a trusted function",
                    {filename, line}
                )
            } else {
                @snprintf(
                    buf,
                    512,
                    "{s}:{lld}: redundant 'trust' block; already inside a 'trust' block",
                    {filename, line}
                )
            }
            add_error(ctx, buf)
        }
        val pt_used: i64 = ctx.trust_used
        ctx.trust_used = 0
        val prev_trust: i64 = ctx.in_trust
        ctx.in_trust = 1
        push_scope(ctx)
        check_stmts(ctx, stmt.d0 as ref void, filename)
        pop_scope(ctx, filename, line)
        ctx.in_trust = prev_trust
        if ctx.trust_used == 0 && ctx.in_unsafe_fn == 0 && ctx.in_trust == 0 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(
                buf,
                512,
                "{s}:{lld}: redundant 'trust' block; no unsafe operations inside",
                {filename, line}
            )
            add_error(ctx, buf)
        }
        ctx.trust_used = pt_used | ctx.trust_used
        return
    }
}


fn check_fn(ctx: mut ref SemaCtx, fn_node: ref parser.Node, filename: ref u8) void = trust {
    guarded pre {
        ctx_not_null: ctx != none
        fn_node_not_null: fn_node != none
        fn_kind_correct: fn_node.kind == parser.NK_FN
        filename_not_null: filename != none
    }

    val fn_name: ref u8 = parser.node_str_raw(fn_node.d2)
    val fn_ns: ref u8 = parser.node_str_raw(fn_node.d1)
    val params: ref void = fn_node.d3 as ref void
    if fn_name != none && fn_ns == none && string.str_eql(fn_name, c"main") {
        if fn_node.d0 != 1 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(buf, 256, "{s}:{lld}: main must be public.", {filename, fn_node.line})
            add_error(ctx, buf)
        }

        if params != none && @len(params) > 0 {
            val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(
                buf2,
                256,
                "{s}:{lld}: main must not take any arguments.",
                {filename, fn_node.line}
            )
            add_error(ctx, buf2)
        }
    }

    val is_unsafe: mut i64 = 0
    if parser.fn_is_unsafe(fn_node) {
        is_unsafe = 1
    }
    val prev_unsafe: i64 = ctx.in_unsafe_fn
    ctx.in_unsafe_fn = is_unsafe
    val prev_argspack: list[ref u8] = ctx.argspack_params
    ctx.argspack_params = mem.new[ref u8]()

    sema_validate_fn_types(ctx, fn_node, filename)

    push_scope(ctx)
    if params != none {
        for param in params as list[ref parser.Node] {
            val pname: ref u8 = parser.node_str_raw(param.d0)
            val pty: ref parser.Node = param.d1 as ref parser.Node
            val is_mut: mut i64 = 0
            val param_is_ref: mut i64 = 0
            val param_tname: ref u8 = extract_type_name(pty)
            if pty != none && pty.kind == parser.TY_ARGSPACK {
                @append(ctx.argspack_params, pname)
            }
            if pty.kind == parser.TY_MUT {
                is_mut = 1
                val pty_inner: ref parser.Node = pty.d0 as ref parser.Node
                if pty_inner != none && pty_inner.kind == parser.TY_REF {
                    param_is_ref = 1
                }
            } elif pty.kind == parser.TY_REF {
                param_is_ref = 1
            }
            scope_define(ctx, pname, is_mut, param_tname, param_is_ref, param.line)
        }
    }
    val ret_ty: ref parser.Node = fn_node.d4 as ref parser.Node
    val body: ref void = fn_node.d5 as ref void
    check_stmts(ctx, body, filename)
    ctx.argspack_params = prev_argspack
    if ret_ty != none && ret_ty.kind != parser.TY_VOID && !stmts_guarantee_return(ctx, body) {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(
            buf,
            512,
            "{s}:{lld}: in function '{s}', not all code paths return a value",
            {filename, fn_node.line, fn_name}
        )
        add_error(ctx, buf)
    }
    pop_scope(ctx, filename, 0)

    ctx.in_unsafe_fn = prev_unsafe
}

/// Register a function name.
fn fn_full_name(ctx: ref SemaCtx, ns: ref u8, nm: ref u8) ref u8 = trust {
    if ns != none && nm != none {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (256) as usize) as ref u8
        @snprintf(buf, 256, "{s}.{s}", {ns, nm})
        return buf
    } elif nm != none {
        return nm
    }
    return none
}

fn register_fn_name(ctx: ref SemaCtx, ns: ref u8, nm: ref u8) void = trust {
    val full_name: ref u8 = fn_full_name(ctx, ns, nm)
    if full_name != none {
        @append(ctx.fn_names, full_name)
    }
}

/// Register a type definition or type-related item name.
fn register_type_name(ctx: ref SemaCtx, item: ref parser.Node) void = trust {
    if item == none {
        return
    }
    val k: i64 = item.kind
    if item.d1 != 0 as i64 {
        @append(ctx.type_names, parser.node_str_raw(item.d1))
    }
    if k == parser.NK_TYPEDEF || k == parser.NK_UNIONDEF || k == parser.NK_ENUMDEF || k == parser.NK_TAGGED_UNIONDEF {
        @append(ctx.type_defs, item)
    }
    if k == parser.NK_TAGGED_UNIONDEF {
        val tvariants: ref void = item.d2 as ref void
        if tvariants != none {
            for tv in tvariants as list[ref parser.Node] {
                if tv != none && tv.d0 != 0 as i64 {
                    val vname: ref u8 = parser.node_str_raw(tv.d0)
                    @append(ctx.fn_names, vname)
                    @append(ctx.variant_names, vname)
                }
            }
        }
    }
    if k == parser.NK_TYPEDEF {
        val spec_name: ref u8 = parser.node_str_raw(item.d4)
        if spec_name != none && item.d1 != 0 as i64 {
            @append(ctx.spec_names, spec_name)
            @append(ctx.spec_impls, parser.node_str_raw(item.d1))
        }
    }
}

/// Register a named item (const/use/val/extern_fn) name.
fn register_named_item(ctx: ref SemaCtx, item: ref parser.Node) void = trust {
    if item == none {
        return
    }
    val k: i64 = item.kind
    if k == parser.NK_EXTERN_FN {
        if item.d1 != 0 as i64 {
            @append(ctx.fn_names, parser.node_str_raw(item.d1))
        }
    }
    if k == parser.NK_USE {
        if item.d1 != 0 as i64 {
            @append(ctx.use_names, parser.node_str_raw(item.d1))
            @append(ctx.use_lines, item.line)
        }
    }
    if k == parser.NK_CONST || k == parser.NK_USE {
        if item.d1 != 0 as i64 {
            @append(ctx.global_names, parser.node_str_raw(item.d1))
        }
    }
    if k == parser.NK_VAL {
        if item.d0 != 0 as i64 {
            @append(ctx.global_names, parser.node_str_raw(item.d0))
        }
    }
}

/// Register a single top-level item's name in the context.
fn register_item_name(ctx: ref SemaCtx, item: ref parser.Node) void = trust {
    if item == none {
        return
    }
    val k: i64 = item.kind
    if k == parser.NK_GENERIC_FN {
        val nm: ref u8 = parser.node_str_raw(item.d2)
        if nm != none {
            @append(ctx.global_names, nm)
        }
        register_fn_name(ctx, parser.node_str_raw(item.d1), nm)
        @append(ctx.fn_defs, item)
        return
    }
    if k == parser.NK_FN || k == parser.NK_EXTERN_FN {
        if k == parser.NK_FN {
            register_fn_name(ctx, parser.node_str_raw(item.d1), parser.node_str_raw(item.d2))
            if item.d0 == 1 {
                val nm: ref u8 = parser.node_str_raw(item.d2)
                if nm != none {
                    @append(ctx.global_names, nm)
                }
            }
            val fname: ref u8 = parser.node_str_raw(item.d2)
            val params_node: ref void = item.d3 as ref void
            if fname != none {
                @append(ctx.fn_map_names, fname)
                @append(ctx.fn_map_params, params_node)
            }
        } else {
            if item.d1 != 0 as i64 {
                val ename: ref u8 = parser.node_str_raw(item.d1)
                val eparams: ref void = item.d4 as ref void
                @append(ctx.fn_map_names, ename)
                @append(ctx.fn_map_params, eparams)
            }
        }
        @append(ctx.fn_defs, item)
    }
    if k == parser.NK_TYPEDEF || k == parser.NK_EXTERN_TYPE ||
    k == parser.NK_ENUMDEF || k == parser.NK_UNIONDEF || k == parser.NK_TAGGED_UNIONDEF {
        register_type_name(ctx, item)
    }
    if k == parser.NK_SPEC {
        if item.d1 != 0 as i64 {
            @append(ctx.type_names, parser.node_str_raw(item.d1))
        }
    }
    register_named_item(ctx, item)
    if k == parser.NK_WHEN_ITEMS {
        val witems: ref void = sema_select_when_branch(ctx, item)
        if witems != none {
            for wi_node in witems as list[ref parser.Node] {
                register_item_name(ctx, wi_node)
            }
        }
    }
}

fn check_generic_fn(ctx: mut ref SemaCtx, fn_node: ref parser.Node, filename: ref u8) void = trust {
    val body: ref void = fn_node.d5 as ref void
    if body == none {
        return
    }
    val is_unsafe: mut i64 = 0
    if parser.generic_fn_is_unsafe(fn_node) {
        is_unsafe = 1
    }
    val prev_unsafe: i64 = ctx.in_unsafe_fn
    ctx.in_unsafe_fn = is_unsafe
    val prev_argspack: list[ref u8] = ctx.argspack_params
    ctx.argspack_params = mem.new[ref u8]()

    val type_params: ref void = fn_node.d6 as ref void
    val prev_type_params: list[ref u8] = ctx.type_params
    if type_params != none {
        for tparam in type_params as list[ref parser.Node] {
            @append(ctx.type_params, parser.tparam_name_raw(tparam as ref parser.Node))
        }
    }

    sema_validate_fn_types(ctx, fn_node, filename)

    push_scope(ctx)
    val params: ref void = fn_node.d3 as ref void
    if params != none {
        for param in params as list[ref parser.Node] {
            val pname: ref u8 = parser.node_str_raw(param.d0)
            val pty: ref parser.Node = param.d1 as ref parser.Node
            val is_mut: mut i64 = 0
            val param_is_ref: mut i64 = 0
            val param_tname: ref u8 = extract_type_name(pty)
            if pty != none && pty.kind == parser.TY_ARGSPACK {
                @append(ctx.argspack_params, pname)
            }
            if pty.kind == parser.TY_MUT {
                is_mut = 1
                val pty_inner: ref parser.Node = pty.d0 as ref parser.Node
                if pty_inner != none && pty_inner.kind == parser.TY_REF {
                    param_is_ref = 1
                }
            } elif pty.kind == parser.TY_REF {
                param_is_ref = 1
            }
            scope_define(ctx, pname, is_mut, param_tname, param_is_ref, param.line)
            mark_name_used(ctx, pname)
        }
    }

    val ret_ty: ref parser.Node = fn_node.d4 as ref parser.Node
    check_stmts(ctx, body, filename)
    ctx.argspack_params = prev_argspack
    val fn_name: ref u8 = parser.node_str_raw(fn_node.d2)
    if ret_ty != none && ret_ty.kind != parser.TY_VOID && !stmts_guarantee_return(ctx, body) {
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (512) as usize) as ref u8
        @snprintf(
            buf,
            512,
            "{s}:{lld}: function '{s}', not all code paths return a value",
            {filename, fn_node.line, fn_name}
        )
        add_error(ctx, buf)
    }
    pop_scope(ctx, filename, 0)

    ctx.type_params = prev_type_params
    ctx.in_unsafe_fn = prev_unsafe
}

/// Check a single top-level item (functions, tests, when items).
fn check_top_item(ctx: mut ref SemaCtx, item: ref parser.Node, filename: ref u8) void = trust {
    val k: i64 = item.kind
    if k == parser.NK_USE {
        if item.d0 != 0 {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(
                buf,
                256,
                "{s}:{lld}: use statements cannot be public.",
                {filename, item.line}
            )
            add_error(ctx, buf)
        }
        val annotated_use_ty: ref parser.Node = item.d3 as ref parser.Node
        if annotated_use_ty != none {
            val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (256) as usize
            ) as ref u8
            @snprintf(
                buf2,
                256,
                "{s}:{lld}: invalid type annotation on value assigned to use directive.",
                {filename, item.line}
            )
            add_error(ctx, buf2)
        }
        return
    }
    if k == parser.NK_GENERIC_FN {
        check_generic_fn(ctx, item, filename)
        return
    }
    if k == parser.NK_FN {
        check_fn(ctx, item, filename)
    }
    if k == parser.NK_TEST {
        push_scope(ctx)
        check_stmts(ctx, item.d0 as ref void, filename)
        pop_scope(ctx, filename, item.line)
    }
    if k == parser.NK_VAL {
        val init_node: ref parser.Node = item.d3 as ref parser.Node
        if init_node != none {
            check_expr(ctx, init_node, filename)
        }
        sema_check_int_literal_range(
            ctx,
            extract_type_name(item.d2 as ref parser.Node),
            init_node,
            filename,
            item.line
        )
        return
    }
    if k == parser.NK_CONST {
        val init_node: ref parser.Node = item.d2 as ref parser.Node
        if !sema_infer_fixed_arr_sizes(
            item.d3 as ref parser.Node,
            init_node
        ) {
            val ibuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (512) as usize
            ) as ref u8
            @snprintf(ibuf, 512,
                "{s}:{lld}: cannot infer fixed array size from initializer; use an explicit size",
                {filename, item.line})
            add_error(ctx, ibuf)
        }
        if init_node != none {
            check_expr(ctx, init_node, filename)
        }
        sema_check_int_literal_range(
            ctx,
            extract_type_name(item.d3 as ref parser.Node),
            init_node,
            filename,
            item.line
        )
        return
    }
    if k == parser.NK_WHEN_ITEMS {
        val witems: ref void = sema_select_when_branch(ctx, item)
        if witems != none {
            for wi in witems as list[ref parser.Node] {
                check_top_item(ctx, wi, filename)
            }
        }
        return
    }
}

fn find_use_line_in_items(items: list[ref parser.Node], import_name: ref u8) i64 = trust {
    for item in items {
        if item == none {
            continue
        }
        if item.kind == parser.NK_USE {
            val item_name: ref u8 = parser.node_str_raw(item.d1)
            if item_name != none && string.str_eql(item_name, import_name) {
                return item.line
            }
        } elif item.kind == parser.NK_WHEN_ITEMS {
            val when_items: ref void = item.d1 as ref void
            if when_items != none {
                val when_line: i64 = find_use_line_in_items(
                    when_items as list[ref parser.Node],
                    import_name
                )
                if when_line != 0 {
                    return when_line
                }
            }
            val or_branches: ref void = item.d2 as ref void
            if or_branches != none {
                for or_node in or_branches as list[ref parser.Node] {
                    val or_items: ref void = (or_node as ref parser.Node).d1 as ref void
                    if or_items != none {
                        val or_line: i64 = find_use_line_in_items(
                            or_items as list[ref parser.Node],
                            import_name
                        )
                        if or_line != 0 {
                            return or_line
                        }
                    }
                }
            }
            val otherwise_items: ref void = item.d3 as ref void
            if otherwise_items != none {
                val otherwise_line: i64 = find_use_line_in_items(
                    otherwise_items as list[ref parser.Node],
                    import_name
                )
                if otherwise_line != 0 {
                    return otherwise_line
                }
            }
        }
    }
    return 0
}

fn type_name_has_import_prefix(type_name: ref u8, import_name: ref u8) bool = trust {
    if type_name == none || import_name == none {
        return false
    }
    val nlen: i64 = string.len_raw(import_name)
    if nlen <= 0 {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        val tc: u8 = @load8(@ptradd(type_name, i))
        val ic: u8 = @load8(@ptradd(import_name, i))
        if tc == 0 || tc != ic {
            return false
        }
        i++
    }
    return @load8(@ptradd(type_name, nlen)) == 46
}

fn type_uses_import_alias(ty: ref parser.Node, import_name: ref u8) bool = trust {
    if ty == none || import_name == none {
        return false
    }
    if ty.kind == parser.TY_NAMED {
        return type_name_has_import_prefix(parser.node_str_raw(ty.d0), import_name)
    }
    if ty.kind == parser.TY_MUT || ty.kind == parser.TY_REF || ty.kind == parser.TY_OPTION || ty.kind == parser.TY_LIST || ty.kind == parser.TY_SLICE {
        return type_uses_import_alias(ty.d0 as ref parser.Node, import_name)
    }
    if ty.kind == parser.TY_RESULT {
        if type_uses_import_alias(ty.d0 as ref parser.Node, import_name) {
            return true
        }
        return type_uses_import_alias(ty.d1 as ref parser.Node, import_name)
    }
    if ty.kind == parser.TY_FIXED_ARR {
        return type_uses_import_alias(ty.d1 as ref parser.Node, import_name)
    }
    if ty.kind == parser.TY_FNPTR {
        val params: ref void = ty.d0 as ref void
        if params != none {
            for param_ty in params as list[ref parser.Node] {
                if type_uses_import_alias(param_ty as ref parser.Node, import_name) {
                    return true
                }
            }
        }
        return type_uses_import_alias(ty.d1 as ref parser.Node, import_name)
    }
    return false
}

fn expr_uses_import_alias(node: ref parser.Node, import_name: ref u8) bool = trust {
    if node == none || import_name == none {
        return false
    }
    val k: i64 = node.kind
    if k == parser.NK_IDENT {
        return string.str_eql(parser.node_str_raw(node.d0), import_name)
    }
    if k == parser.NK_FIELD {
        val base: ref parser.Node = parser.field_base(node)
        if base != none && base.kind == parser.NK_IDENT {
            if string.str_eql(parser.node_str_raw(base.d0), import_name) {
                return true
            }
        }
        return expr_uses_import_alias(base, import_name)
    }
    if k == parser.NK_CALL {
        if expr_uses_import_alias(parser.call_callee(node), import_name) {
            return true
        }
        val args: ref void = parser.call_args(node) as ref void
        if args != none {
            for arg in args as list[ref parser.Node] {
                if expr_uses_import_alias(arg, import_name) {
                    return true
                }
            }
        }
        return false
    }
    if k == parser.NK_BUILTIN {
        val bargs: ref void = node.d1 as ref void
        if bargs != none {
            for barg in bargs as list[ref parser.Node] {
                if expr_uses_import_alias(barg, import_name) {
                    return true
                }
            }
        }
        for bta in parser.builtin_type_args(node) {
            if bta != none && type_uses_import_alias(bta, import_name) {
                return true
            }
        }
        return false
    }
    if k == parser.NK_BINOP {
        if expr_uses_import_alias(parser.binop_left(node), import_name) {
            return true
        }
        return expr_uses_import_alias(parser.binop_right(node), import_name)
    }
    if k == parser.NK_UNOP {
        return expr_uses_import_alias(parser.unop_inner(node), import_name)
    }
    if k == parser.NK_CAST {
        if type_uses_import_alias(node.d1 as ref parser.Node, import_name) {
            return true
        }
        return expr_uses_import_alias(node.d0 as ref parser.Node, import_name)
    }
    if k == parser.NK_TRUST || k == parser.NK_TRY || k == parser.NK_ADDR || k == parser.NK_DEREF ||
    k == parser.NK_SOME || k == parser.NK_OK_VAL || k == parser.NK_ERR_VAL {
        val alloc_node: ref parser.Node = parser.wrap_allocator(node)
        if alloc_node != none && expr_uses_import_alias(alloc_node, import_name) {
            return true
        }
        if node.d0 == 0 as i64 {
            return false
        }
        return expr_uses_import_alias(node.d0 as ref parser.Node, import_name)
    }
    if k == parser.NK_LIST_LIT || k == parser.NK_ARGS_PACK {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            for e in elems as list[ref parser.Node] {
                if expr_uses_import_alias(e, import_name) {
                    return true
                }
            }
        }
        return false
    }
    if k == parser.NK_STRUCT_LIT {
        val fields: ref void = node.d0 as ref void
        if fields != none {
            for f in fields as list[ref parser.Node] {
                if expr_uses_import_alias(
                    (f as ref parser.Node).d1 as ref parser.Node,
                    import_name
                ) {
                    return true
                }
            }
        }
        return false
    }
    if k == parser.NK_GENERIC_INST {
        if expr_uses_import_alias(node.d0 as ref parser.Node, import_name) {
            return true
        }
        val targs: ref void = node.d1 as ref void
        if targs != none {
            for targ in targs as list[ref parser.Node] {
                if type_uses_import_alias(targ as ref parser.Node, import_name) {
                    return true
                }
            }
        }
        return false
    }
    return false
}

fn stmts_use_import_alias(stmts: ref void, import_name: ref u8) bool = trust {
    if stmts == none || import_name == none {
        return false
    }
    for s in stmts as list[ref parser.Node] {
        if s == none {
            continue
        }
        val k: i64 = s.kind
        if k == parser.NK_VAL {
            if type_uses_import_alias(s.d2 as ref parser.Node, import_name) {
                return true
            }
            if expr_uses_import_alias(s.d3 as ref parser.Node, import_name) {
                return true
            }
        } elif k == parser.NK_ASSIGN || k == parser.NK_ADD_ASSIGN || k == parser.NK_SUB_ASSIGN {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            if expr_uses_import_alias(s.d1 as ref parser.Node, import_name) {
                return true
            }
        } elif k == parser.NK_RETURN || k == parser.NK_EXPR_STMT || k == parser.NK_ASSERT ||
        k == parser.NK_INCREMENT || k == parser.NK_DECREMENT {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
        } elif k == parser.NK_GUARD {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            if stmts_use_import_alias(s.d1 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_IF {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            if stmts_use_import_alias(s.d1 as ref void, import_name) {
                return true
            }
            val elifs: ref void = s.d2 as ref void
            if elifs != none {
                for ep in elifs as list[ref parser.Node] {
                    if expr_uses_import_alias(
                        (ep as ref parser.Node).d0 as ref parser.Node,
                        import_name
                    ) {
                        return true
                    }
                    if stmts_use_import_alias((ep as ref parser.Node).d1 as ref void, import_name) {
                        return true
                    }
                }
            }
            val else_node: ref parser.Node = s.d3 as ref parser.Node
            if else_node != none && stmts_use_import_alias(else_node.d0 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_FOR {
            if expr_uses_import_alias(s.d1 as ref parser.Node, import_name) {
                return true
            }
            if expr_uses_import_alias(s.d2 as ref parser.Node, import_name) {
                return true
            }
            if s.d3 as ref parser.Node != none && stmts_use_import_alias(
                mem.from1[ref parser.Node](s.d3 as ref parser.Node),
                import_name
            ) {
                return true
            }
            if stmts_use_import_alias(s.d4 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_FORIN {
            if expr_uses_import_alias(s.d1 as ref parser.Node, import_name) {
                return true
            }
            if stmts_use_import_alias(s.d2 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_DEFER || k == parser.NK_TRUST_BLOCK {
            if stmts_use_import_alias(s.d0 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_WHEN_STMT {
            if stmts_use_import_alias(s.d1 as ref void, import_name) {
                return true
            }
            val or_branches: ref void = s.d2 as ref void
            if or_branches != none {
                for ow in or_branches as list[ref parser.Node] {
                    if stmts_use_import_alias((ow as ref parser.Node).d1 as ref void, import_name) {
                        return true
                    }
                }
            }
            if stmts_use_import_alias(s.d3 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_MATCH_VALUE {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            val arms: ref void = s.d1 as ref void
            if arms != none {
                for arm in arms as list[ref parser.Node] {
                    if expr_uses_import_alias(
                        (arm as ref parser.Node).d0 as ref parser.Node,
                        import_name
                    ) {
                        return true
                    }
                    if stmts_use_import_alias(
                        (arm as ref parser.Node).d1 as ref void,
                        import_name
                    ) {
                        return true
                    }
                }
            }
            val else_node2: ref parser.Node = s.d2 as ref parser.Node
            if else_node2 != none && stmts_use_import_alias(
                else_node2.d0 as ref void,
                import_name
            ) {
                return true
            }
        } elif k == parser.NK_MATCH_OPT {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            val some_body_node: ref parser.Node = s.d2 as ref parser.Node
            if some_body_node != none && stmts_use_import_alias(
                some_body_node.d0 as ref void,
                import_name
            ) {
                return true
            }
            val none_body_node: ref parser.Node = s.d3 as ref parser.Node
            if none_body_node != none && stmts_use_import_alias(
                none_body_node.d0 as ref void,
                import_name
            ) {
                return true
            }
        } elif k == parser.NK_MATCH_RES {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            val ok_body_node: ref parser.Node = s.d2 as ref parser.Node
            if ok_body_node != none && stmts_use_import_alias(
                ok_body_node.d0 as ref void,
                import_name
            ) {
                return true
            }
            val err_body: ref parser.Node = s.d4 as ref parser.Node
            if err_body != none && stmts_use_import_alias(err_body.d0 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_MATCH_ENUM || k == parser.NK_MATCH_UNION || k == parser.NK_MATCH_STR {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            val arms: ref void = s.d1 as ref void
            if arms != none {
                for arm in arms as list[ref parser.Node] {
                    if stmts_use_import_alias(
                        (arm as ref parser.Node).d1 as ref void,
                        import_name
                    ) {
                        return true
                    }
                }
            }
            val else_node2: ref parser.Node = s.d2 as ref parser.Node
            if else_node2 != none && stmts_use_import_alias(
                else_node2.d0 as ref void,
                import_name
            ) {
                return true
            }
        } elif k == parser.NK_MATCH_TAGGED_UNION {
            if expr_uses_import_alias(s.d0 as ref parser.Node, import_name) {
                return true
            }
            val arms: ref void = s.d1 as ref void
            if arms != none {
                for arm in arms as list[ref parser.Node] {
                    if stmts_use_import_alias(
                        (arm as ref parser.Node).d2 as ref void,
                        import_name
                    ) {
                        return true
                    }
                }
            }
            val else_node2: ref parser.Node = s.d2 as ref parser.Node
            if else_node2 != none && stmts_use_import_alias(
                else_node2.d0 as ref void,
                import_name
            ) {
                return true
            }
        } elif k == parser.NK_PRE || k == parser.NK_POST || k == parser.NK_GUARDED_PRE || k == parser.NK_GUARDED_POST {
            val contracts: ref void = s.d0 as ref void
            if contracts != none {
                for c in contracts as list[ref parser.Node] {
                    if expr_uses_import_alias(
                        (c as ref parser.Node).d1 as ref parser.Node,
                        import_name
                    ) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

fn items_use_import_alias(items: list[ref parser.Node], import_name: ref u8) bool = trust {
    if import_name == none {
        return false
    }
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
            val params: ref void = item.d3 as ref void
            if params != none {
                for p in params as list[ref parser.Node] {
                    if type_uses_import_alias(
                        (p as ref parser.Node).d1 as ref parser.Node,
                        import_name
                    ) {
                        return true
                    }
                }
            }
            if type_uses_import_alias(item.d4 as ref parser.Node, import_name) {
                return true
            }
            if stmts_use_import_alias(item.d5 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_TEST {
            if stmts_use_import_alias(item.d0 as ref void, import_name) {
                return true
            }
        } elif k == parser.NK_VAL {
            if type_uses_import_alias(item.d2 as ref parser.Node, import_name) {
                return true
            }
            if expr_uses_import_alias(item.d3 as ref parser.Node, import_name) {
                return true
            }
        } elif k == parser.NK_CONST {
            if expr_uses_import_alias(item.d2 as ref parser.Node, import_name) {
                return true
            }
        } elif k == parser.NK_WHEN_ITEMS {
            val when_items: ref void = item.d1 as ref void
            if when_items != none && items_use_import_alias(
                when_items as list[ref parser.Node],
                import_name
            ) {
                return true
            }
            val or_branches: ref void = item.d2 as ref void
            if or_branches != none {
                for or_node in or_branches as list[ref parser.Node] {
                    val or_items: ref void = (or_node as ref parser.Node).d1 as ref void
                    if or_items != none && items_use_import_alias(
                        or_items as list[ref parser.Node],
                        import_name
                    ) {
                        return true
                    }
                }
            }
            val otherwise_items: ref void = item.d3 as ref void
            if otherwise_items != none && items_use_import_alias(
                otherwise_items as list[ref parser.Node],
                import_name
            ) {
                return true
            }
        }
    }
    return false
}

fn check_unused_imports(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    filename: ref u8
) void = trust {
    val unused_imports: list[ref u8] = modinfo.collect_unused_import_names_in_items(items)
    for import_name in unused_imports {
        if items_use_import_alias(items, import_name) {
            continue
        }
        val use_line: i64 = find_use_line_in_items(items, import_name)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (256) as usize) as ref u8
        @snprintf(
            buf,
            256,
            "{s}:{lld}: use directive assigned to '{s}' is never used",
            {filename, use_line, import_name}
        )
        add_error(ctx, buf)
    }
}

/// Check for duplicate function names and import aliases.
fn check_duplicates(ctx: ref SemaCtx, filename: ref u8) void = trust {
    val fnlen: i64 = @len(ctx.fn_names) as i64
    val fi: mut i64 = 0
    for {
        if fi >= fnlen {
            break
        }
        val fn_opt = @get(ctx.fn_names, fi as usize)
        if fn_opt is some fn_name {
            val fj: mut i64 = fi + 1
            for {
                if fj >= fnlen {
                    break
                }
                val fn2_opt = @get(ctx.fn_names, fj as usize)
                if fn2_opt is some fn2_name {
                    if string.str_eql(fn_name as ref u8, fn2_name as ref u8) {
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (256) as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            256,
                            "{s}: duplicate definition of '{s}'",
                            {filename, fn_name as ref u8}
                        )
                        add_error(ctx, buf)
                    }
                }
                fj++
            }
        }
        fi++
    }

    val use_len: i64 = @len(ctx.use_names) as i64
    val ui: mut i64 = 1
    for {
        if ui >= use_len {
            break
        }
        val use_opt = @get(ctx.use_names, ui as usize)
        if use_opt is some use_name {
            val pi: mut i64 = 0
            for {
                if pi >= ui {
                    break
                }
                val prev_opt = @get(ctx.use_names, pi as usize)
                if prev_opt is some prev_name {
                    if string.str_eql(use_name as ref u8, prev_name as ref u8) {
                        val cur_line_opt = @get(ctx.use_lines, ui as usize)
                        val prev_line_opt = @get(ctx.use_lines, pi as usize)
                        if cur_line_opt is some cur_line {
                            if prev_line_opt is some prev_line {
                                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    (256) as usize
                                ) as ref u8
                                @snprintf(
                                    buf,
                                    256,
                                    "{s}:{lld}: duplicate import '{s}' (previously imported at line {lld})",
                                    {filename, cur_line, use_name as ref u8, prev_line}
                                )
                                add_error(ctx, buf)
                            }
                        }
                        break
                    }
                }
                pi++
            }
        }
        ui++
    }
}

fn is_function_public(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    fn_name: ref u8
) bool = trust {
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
            if item.d0 % 2 == 1 {
                val name: ref u8 = parser.node_str_raw(item.d2)
                val full_name: ref u8 = fn_full_name(ctx, parser.node_str_raw(item.d1), name)
                if full_name != none && string.str_eql(full_name, fn_name) {
                    return true
                }
            }
        } elif k == parser.NK_EXTERN_FN {
            if item.d0 % 2 == 1 {
                val name: ref u8 = parser.node_str_raw(item.d1)
                val full_name: ref u8 = fn_full_name(ctx, none, name)
                if full_name != none && string.str_eql(full_name, fn_name) {
                    return true
                }
            }
        } elif k == parser.NK_WHEN_ITEMS {
            val witems: ref void = sema_select_when_branch(ctx, item)
            if witems != none {
                if is_function_public(ctx, witems as list[ref parser.Node], fn_name) {
                    return true
                }
            }
        }
    }
    return false
}

fn function_suppresses_unused(
    ctx: ref SemaCtx,
    items: list[ref parser.Node],
    fn_name: ref u8
) bool = trust {
    for item in items {
        if item == none {
            continue
        }
        val k: i64 = item.kind
        if k == parser.NK_FN || k == parser.NK_GENERIC_FN {
            if parser.fn_suppresses_unused(item) {
                val name: ref u8 = parser.node_str_raw(item.d2)
                val full_name: ref u8 = fn_full_name(ctx, parser.node_str_raw(item.d1), name)
                if full_name != none && string.str_eql(full_name, fn_name) {
                    return true
                }
            }
        } elif k == parser.NK_WHEN_ITEMS {
            val witems: ref void = sema_select_when_branch(ctx, item)
            if witems != none {
                if function_suppresses_unused(ctx, witems as list[ref parser.Node], fn_name) {
                    return true
                }
            }
        }
    }
    return false
}


pub fn check_module(
    arena: allocators.ScopedArenaAllocator,
    items: list[ref parser.Node],
    filename: ref u8,
    root: ref modinfo.ResolvedModule,
    quiet: i64,
    src_target: ref u8
) list[ref u8] = trust {
    val ctx: mut ref SemaCtx = sema_new(arena)
    ctx.root_mod = root
    ctx.src_target = src_target

    for item in items {
        register_item_name(ctx, item)
    }

    check_duplicates(ctx, filename)
    sema_check_recursive_types(ctx, items, filename)

    for item2 in items {
        check_top_item(ctx, item2, filename)
    }
    check_unused_imports(ctx, items, filename)
    validate_derived_specs(ctx, items, filename)
    validate_spec_impls(ctx, items, filename)

    val fnlen: i64 = @len(ctx.fn_names) as i64
    val fi: mut i64 = 0
    for {
        if fi >= fnlen {
            break
        }
        val fn_opt = @get(ctx.fn_names, fi as usize)
        if fn_opt is some fn_name {
            val used_found: mut bool = false
            for uf in ctx.used_fns {
                if string.str_eql(uf as ref u8, fn_name as ref u8) {
                    used_found = true
                    break
                }
            }
            if !used_found {
                val namec: ref u8 = fn_name as ref u8
                val is_variant: mut bool = false
                for vn in ctx.variant_names {
                    if string.str_eql(vn as ref u8, namec) {
                        is_variant = true
                        break
                    }
                }
                val is_public: bool = is_function_public(ctx, items, namec)
                val suppresses_unused: bool = function_suppresses_unused(ctx, items, namec)
                if !string.str_eql(
                    namec,
                    c"main"
                ) && !is_variant && !is_public && !suppresses_unused {
                    val wbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (256) as usize
                    ) as ref u8
                    @snprintf(wbuf, 256, "{s}: unused function '{s}'", {filename, namec})
                    @append(ctx.warnings, wbuf)
                }
            }
        }
        fi++
    }

    if quiet == 0 {
        for w in ctx.warnings {
            stdio.print("warning: {s}\n", {w})
        }
    }

    return ctx.errors
}

fn check_module_seen(seen: list[ref void], mod: ref modinfo.ResolvedModule) bool = trust {
    for s in seen {
        if s == mod {
            return true
        }
    }
    return false
}

fn check_module_rec(
    arena: allocators.ScopedArenaAllocator,
    mod: ref modinfo.ResolvedModule,
    all_errors: mut list[ref u8],
    seen: mut list[ref void],
    quiet: i64,
    src_target: ref u8
) void = trust {
    if mod == none {
        return
    }
    if check_module_seen(seen, mod) {
        return
    }
    @append(seen, mod)

    val n: i64 = modinfo.import_count(mod)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val child: ref modinfo.ResolvedModule = modinfo.import_module_at(mod, i as usize)
        check_module_rec(arena, child, all_errors, seen, quiet, src_target)
        i++
    }

    val fname: ref u8 = normalize_path(arena, modinfo.module_filename(mod))
    val items: list[ref parser.Node] = modinfo.module_items(mod)
    val errors: list[ref u8] = check_module(arena, items, fname, mod, quiet, src_target)
    for e in errors {
        @append(all_errors, e)
    }
}

pub fn check_module_tree(
    arena: allocators.ScopedArenaAllocator,
    root: ref modinfo.ResolvedModule,
    quiet: i64,
    src_target: ref u8
) list[ref u8] = trust {
    val all_errors: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[ref void] = mem.new[ref void]()
    check_module_rec(arena, root, all_errors, seen, quiet, src_target)
    return all_errors
}
