val defines = use("defines.sx")

/// Option/result now use an unboxed, value-oriented layout by default.
///
/// During bootstrap the old heap-boxed layout can be selected with
/// -dSPECTRE_LEGACY_BOXED_OPTION_RESULT=1. The transition toggle is a build
/// define only; there is no separate user-facing command-line flag.
pub fn unboxed_option_result() bool = {
    return !defines.has("SPECTRE_LEGACY_BOXED_OPTION_RESULT")
}
