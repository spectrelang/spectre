/// Source formatter for Spectre (.sx) files.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str   = use("std/string")
val mem        = use("mem.sx")
val fs    = use("std/fs")
val path  = use("std/path")
val stdio = use("std/stdio")
val lexer = use("../ast/lexer.sx")

type Buf = {
    ptr: mut ref u8
    len: mut i64
    cap: mut i64
}

type Edit = {
    start: mut i64
    end: mut i64
    text: mut ref u8
}

type Arm = {
    start: mut i64
    arrow: mut i64
    open: mut i64
    close: mut i64
}

type Nesting = {
    braces: mut i64
    parens: mut i64
    brackets: mut i64
}

type ImportRec = {
    line_start: mut i64
    line_end: mut i64
    eq: mut i64
    left_len: mut i64
    has_nl: mut bool
}

fn byte_at(src: ref u8, i: i64) i64 = trust {
    return @load8(@ptradd(src, i)) as i64
}

fn is_space_byte(c: i64) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn buf_new(cap: i64) ref Buf = trust {
    val b: mut ref Buf = @alloc(@sizeof(Buf)) as ref Buf
    b.ptr = @alloc(cap as usize) as ref u8
    b.len = 0
    b.cap = cap
    @store8(b.ptr as ref void, 0)
    return b
}

fn buf_reserve(b: mut ref Buf, extra: i64) void = trust {
    val needed: i64 = b.len + extra + 1
    if needed <= b.cap {
        return
    }
    val new_cap: mut i64 = b.cap
    for {
        if new_cap >= needed {
            break
        }
        new_cap = new_cap * 2
    }
    b.ptr = @realloc(b.ptr as ref void, new_cap as usize) as ref u8
    b.cap = new_cap
}

fn buf_append_bytes(b: mut ref Buf, src: ref u8, start: i64, count: i64) void = trust {
    if count <= 0 {
        return
    }
    buf_reserve(b, count)
    @memcpy(@ptradd(b.ptr as ref void, b.len), @ptradd(src, start), count as usize)
    b.len = b.len + count
    @store8(@ptradd(b.ptr as ref void, b.len), 0)
}

fn buf_append_cstr(b: mut ref Buf, s: ref u8) void = trust {
    buf_append_bytes(b, s, 0, str.len_raw(s))
}

fn buf_append_char(b: mut ref Buf, c: u8) void = trust {
    buf_reserve(b, 1)
    @store8(@ptradd(b.ptr as ref void, b.len), c)
    b.len++
    @store8(@ptradd(b.ptr as ref void, b.len), 0)
}

fn buf_build(b: mut ref Buf) ref u8 = trust {
    @store8(@ptradd(b.ptr as ref void, b.len), 0)
    val ptr: ref u8 = b.ptr
    @free(b)
    return ptr
}

/// Free a formatting intermediate once it has been replaced by a new buffer.
/// The original source is never owned by the formatter, so it is never freed.
fn release_if_owned(old: mut ref u8, new: ref u8, original: ref u8) void = trust {
    if old != new && old != original {
        @free(old)
    }
}

fn edit_new(start: i64, end: i64, text: ref u8) ref Edit = trust {
    val e: mut ref Edit = @alloc(@sizeof(Edit)) as ref Edit
    e.start = start
    e.end = end
    e.text = text
    return e
}

fn free_i64_list(items: list[i64]) void = trust {
    @listfree(items)
}

fn free_edit_list(items: list[ref Edit]) void = trust {
    val n: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val opt = @get(items, i as usize)
        if opt is some item_val {
            val e: ref Edit = item_val as ref Edit
            @free(e)
        }
        i++
    }
    @listfree(items)
}

fn free_arm_list(items: list[ref Arm]) void = trust {
    val n: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val opt = @get(items, i as usize)
        if opt is some item_val {
            val a: ref Arm = item_val as ref Arm
            @free(a)
        }
        i++
    }
    @listfree(items)
}

fn free_import_group(items: list[ref ImportRec]) void = trust {
    val n: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val opt = @get(items, i as usize)
        if opt is some item_val {
            val rec: ref ImportRec = item_val as ref ImportRec
            @free(rec)
        }
        i++
    }
    @listfree(items)
}

fn apply_edits(src: ref u8, edits: mut list[ref Edit]) ref u8 = trust {
    val src_len: i64 = str.len_raw(src)
    val out: mut ref Buf = buf_new(src_len + 32)
    val pos: mut i64 = 0

    for e in edits {
        if e.start > pos {
            buf_append_bytes(out, src, pos, e.start - pos)
        }
        buf_append_cstr(out, e.text)
        pos = e.end
    }

    if pos < src_len {
        buf_append_bytes(out, src, pos, src_len - pos)
    }

    val result: ref u8 = buf_build(out)
    free_edit_list(edits)
    return result
}

fn range_is_whitespace(src: ref u8, start: i64, end: i64) bool = {
    val i: mut i64 = start
    for {
        if i >= end {
            break
        }
        if !is_space_byte(trust byte_at(src, i)) {
            return false
        }
        i++
    }
    return true
}

fn collect_line_starts(src: ref u8, len: i64) list[i64] = trust {
    val starts: mut list[i64] = mem.new[i64]()
    @append(starts, 0)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if byte_at(src, i) == 10 {
            @append(starts, i + 1)
        }
        i++
    }
    return starts
}

fn token_start(tokens: list[ref lexer.Token], starts: list[i64], idx: i64) i64 = trust {
    val tok_opt = @get(tokens, idx as usize)
    if tok_opt is some tok_val {
        val tok: ref lexer.Token = tok_val as ref lexer.Token
        val line_idx: i64 = tok.line - 1
        val start_opt = @get(starts, line_idx as usize)
        if start_opt is some line_start {
            return (line_start as i64) + tok.col - 1
        } else {
            return 0
        }
    } else {
        return 0
    }
}

fn kind_is_some(k: lexer.TokenKind) bool = {
    match k {
        Some() => {
            return true
        }
        else => {
            return false
        }
    }
}

fn kind_is_none(k: lexer.TokenKind) bool = {
    match k {
        None() => {
            return true
        }
        else => {
            return false
        }
    }
}

fn kind_is_eq(k: lexer.TokenKind) bool = {
    match k {
        Eq() => {
            return true
        }
        else => {
            return false
        }
    }
}

fn kind_is_as(k: lexer.TokenKind) bool = {
    match k {
        As() => {
            return true
