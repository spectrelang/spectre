fn format_eq_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if kind_is_eq(k) {
            val eq_pos: i64 = token_start(tokens, starts, i)
            val ws_before: mut i64 = eq_pos
            for {
                if ws_before <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_before - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_before--
            }

            val at_line_start: bool =
            ws_before == 0 ||
            byte_at(src, ws_before - 1) == 10 ||
            byte_at(src, ws_before - 1) == 13

            if !at_line_start {
                val gap: i64 = eq_pos - ws_before
                val already_one: bool = gap == 1 && byte_at(src, ws_before) == 32
                if !already_one {
                    @append(edits, edit_new(ws_before, eq_pos, " "))
                }
            }

            if i + 1 < ntokens && token_line(tokens, i + 1) == token_line(tokens, i) {
                val next_pos: i64 = token_start(tokens, starts, i + 1)
                if range_is_whitespace(src, eq_pos + 1, next_pos) {
                    val already_one_after: bool =
                    next_pos - (eq_pos + 1) == 1 && byte_at(src, eq_pos + 1) == 32
                    if !already_one_after {
                        @append(edits, edit_new(eq_pos + 1, next_pos, " "))
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_as_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if kind_is_as(k) {
            val as_pos: i64 = token_start(tokens, starts, i)
            val ws_before: mut i64 = as_pos
            for {
                if ws_before <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_before - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_before--
            }

            val at_line_start: bool =
            ws_before == 0 ||
            byte_at(src, ws_before - 1) == 10 ||
            byte_at(src, ws_before - 1) == 13

            if !at_line_start {
                val gap: i64 = as_pos - ws_before
                val already_one: bool = gap == 1 && byte_at(src, ws_before) == 32
                if !already_one {
                    @append(edits, edit_new(ws_before, as_pos, " "))
                }
            }

            if i + 1 < ntokens && token_line(tokens, i + 1) == token_line(tokens, i) {
                val next_pos: i64 = token_start(tokens, starts, i + 1)
                if range_is_whitespace(src, as_pos + 1, next_pos) {
                    val already_one_after: bool =
                    next_pos - (as_pos + 1) == 1 && byte_at(src, as_pos + 1) == 32
                    if !already_one_after {
                        @append(edits, edit_new(as_pos + 1, next_pos, " "))
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_operator_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if kind_is_operator_spacing(k) {
            val op_pos: i64 = token_start(tokens, starts, i)
            val op_len: i64 = operator_len(k)
            val ws_before: mut i64 = op_pos
            for {
                if ws_before <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_before - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_before--
            }

            val at_line_start: bool =
            ws_before == 0 ||
            byte_at(src, ws_before - 1) == 10 ||
            byte_at(src, ws_before - 1) == 13

            if !at_line_start {
                val gap: i64 = op_pos - ws_before
                val already_one: bool = gap == 1 && byte_at(src, ws_before) == 32
                if !already_one {
                    @append(edits, edit_new(ws_before, op_pos, " "))
                }
            }

            if i + 1 < ntokens && token_line(tokens, i + 1) == token_line(tokens, i) {
                val next_pos: i64 = token_start(tokens, starts, i + 1)
                if range_is_whitespace(src, op_pos + op_len, next_pos) {
                    val already_one_after: bool =
                    next_pos - (op_pos + op_len) == 1 && byte_at(src, op_pos + op_len) == 32
                    if !already_one_after {
                        @append(edits, edit_new(op_pos + op_len, next_pos, " "))
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_assert_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if kind_is_assert(k) {
            val assert_pos: i64 = token_start(tokens, starts, i)
            val keyword_end: i64 = assert_pos + 6

            if i + 1 < ntokens {
                val next_kind: lexer.TokenKind = lexer.tok_kind(tokens, i + 1)
                if lexer.kind_is_lparen(next_kind) {
                    val open_pos: i64 = token_start(tokens, starts, i + 1)
                    val close: i64 = find_matching_paren(tokens, i + 1)
                    if close > i + 1 {
                        val after: i64 = close + 1
                        val ends_expr: mut bool = after >= ntokens
                        if !ends_expr {
                            val after_kind: lexer.TokenKind = lexer.tok_kind(tokens, after)
                            if token_line(tokens, after) > token_line(tokens, close) {
                                ends_expr = true
                            } elif lexer.kind_is_rbrace(after_kind) || kind_is_semicolon(after_kind) ||
                            lexer.kind_is_eof(after_kind) {
                                ends_expr = true
                            }
                        }

                        if ends_expr {
                            val close_pos: i64 = token_start(tokens, starts, close)
                            val content_start: mut i64 = open_pos + 1
                            for {
                                if content_start >= close_pos {
                                    break
                                }
                                val c: i64 = byte_at(src, content_start)
                                if c != 32 && c != 9 {
                                    break
                                }
                                content_start++
                            }
                            @append(edits, edit_new(keyword_end, content_start, " "))

                            val content_end: mut i64 = close_pos
                            for {
                                if content_end <= content_start {
                                    break
                                }
                                val c: i64 = byte_at(src, content_end - 1)
                                if c != 32 && c != 9 {
                                    break
                                }
                                content_end--
                            }
                            @append(edits, edit_new(content_end, close_pos + 1, ""))
                        } elif token_line(
                            tokens,
                            i + 1
                        ) == token_line(
                            tokens,
                            i
                        ) && range_is_whitespace(src, keyword_end, open_pos) {
                            @append(edits, edit_new(keyword_end, open_pos, " "))
                        }
                    }
                } elif token_line(tokens, i + 1) == token_line(tokens, i) {
                    val next_pos: i64 = token_start(tokens, starts, i + 1)
                    if range_is_whitespace(src, keyword_end, next_pos) {
                        val already_one: bool =
                        next_pos - keyword_end == 1 && byte_at(src, keyword_end) == 32
                        if !already_one {
                            @append(edits, edit_new(keyword_end, next_pos, " "))
                        }
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_block_brace_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_lbrace(k) && brace_is_block(tokens, i) {
            val brace_pos: i64 = token_start(tokens, starts, i)
            val ws_start: mut i64 = brace_pos
            for {
                if ws_start <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_start - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_start--
            }

            val at_line_start: bool =
            ws_start == 0 ||
            byte_at(src, ws_start - 1) == 10 ||
            byte_at(src, ws_start - 1) == 13

            if !at_line_start {
                val gap: i64 = brace_pos - ws_start
                val already_one: bool = gap == 1 && byte_at(src, ws_start) == 32
                if !already_one {
                    @append(edits, edit_new(ws_start, brace_pos, " "))
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn find_fn_params_open(tokens: list[ref lexer.Token], fn_idx: i64) i64 = trust {
    val n: i64 = @len(tokens) as i64
    val p: mut i64 = fn_idx + 1

    if p < n && lexer.kind_is_lparen(lexer.tok_kind(tokens, p)) {
        val r: i64 = find_matching_paren(tokens, p)
        if r > p && r + 1 < n && lexer.kind_is_ident(lexer.tok_kind(tokens, r + 1)) {
            // Method receiver `(Type)`: continue after the method name.
            p = r + 2
        } else {
            return p
        }
    }

    for {
        if p >= n {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, p)
        if lexer.kind_is_lparen(k) {
            return p
        }
        if lexer.kind_is_lbrace(k) || kind_is_eq(k) {
            break
        }
        p++
    }

    return -1
}

fn format_fn_return_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_fn(k) {
            val params_open: i64 = find_fn_params_open(tokens, i)
            if params_open >= 0 {
                val params_close: i64 = find_matching_paren(tokens, params_open)
                if params_close > params_open && params_close + 1 < ntokens {
                    val close_line: i64 = token_line(tokens, params_close)
                    val next_line: i64 = token_line(tokens, params_close + 1)
                    if close_line == next_line {
                        val close_end: i64 = token_start(tokens, starts, params_close) + 1
                        val next_pos: i64 = token_start(tokens, starts, params_close + 1)
                        if range_is_whitespace(src, close_end, next_pos) {
                            val already_one: bool =
                            next_pos - close_end == 1 && byte_at(src, close_end) == 32
                            if !already_one {
                                @append(edits, edit_new(close_end, next_pos, " "))
                            }
                        }
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn segment_starts_with(src: ref u8, start: i64, end: i64, prefix: ref u8) bool = trust {
    val plen: i64 = str.len_raw(prefix)
    if end - start < plen {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= plen {
            break
        }
        if byte_at(src, start + i) != byte_at(prefix, i) {
            return false
        }
        i++
    }
    return true
}

fn segment_starts_with_keyword(src: ref u8, start: i64, end: i64, keyword: ref u8) bool = trust {
    if !segment_starts_with(src, start, end, keyword) {
        return false
    }
    val after: i64 = start + str.len_raw(keyword)
    if after >= end {
        return false
    }
    val c: i64 = byte_at(src, after)
    return c == 32 || c == 40 || c == 9
}

fn line_is_block_decl_start(src: ref u8, start: i64, end: i64) bool = trust {
    if segment_starts_with_keyword(src, start, end, "pub fn") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "fn") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "pub type") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "type") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "pub union") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "union") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "pub enum") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "enum") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "pub spec") {
        return true
    }
    if segment_starts_with_keyword(src, start, end, "spec") {
        return true
    }
    return false
}

fn import_eq_pos(src: ref u8, start: i64, end: i64) i64 = trust {
    val is_import: bool =
    segment_starts_with(src, start, end, "val ") ||
    segment_starts_with(src, start, end, "pub val ")

    if !is_import {
        return -1
    }

    val eq: mut i64 = -1
    val i: mut i64 = start
    for {
        if i >= end {
            break
        }
        if byte_at(src, i) == 61 {
            eq = i
            break
        }
        i++
    }
    if eq < 0 {
        return -1
    }

    val use_start: mut i64 = eq + 1
    for {
        if use_start >= end {
            break
        }
        val c: i64 = byte_at(src, use_start)
        if c != 32 && c != 9 {
            break
        }
        use_start++
    }
    if use_start < end && segment_starts_with(src, use_start, end, "use(") {
        return eq
    }
    return -1
}

fn flush_import_group(src: ref u8, out: mut ref Buf, group: mut list[ref ImportRec]) void = trust {
    val n: i64 = @len(group) as i64
    if n == 0 {
        free_import_group(group)
        return
    }

    val max_left: mut i64 = 0
    for rec in group {
        if rec.left_len > max_left {
            max_left = rec.left_len
        }
    }

    for rec in group {
        buf_append_bytes(out, src, rec.line_start, rec.left_len)

        val pad: mut i64 = max_left - rec.left_len + 1
        for {
            if pad <= 0 {
                break
            }
            buf_append_char(out, 32 as u8)
            pad--
        }

        buf_append_char(out, 61 as u8)

        val right_start: i64 = rec.eq + 1
        if right_start < rec.line_end {
            buf_append_bytes(out, src, right_start, rec.line_end - right_start)
        }
        if rec.has_nl {
            buf_append_char(out, 10 as u8)
        }
    }

    free_import_group(group)
}

fn format_import_alignment(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    val out: mut ref Buf = buf_new(len + 64)
    val group: mut list[ref ImportRec] = mem.new[ref ImportRec]()
    val line_start: mut i64 = 0

    for {
        if line_start > len {
            break
        }

        val line_end: mut i64 = line_start
        for {
            if line_end >= len {
                break
            }
            if byte_at(src, line_end) == 10 {
                break
            }
            line_end++
        }

        val eq: i64 = import_eq_pos(src, line_start, line_end)
        if eq >= 0 {
            val left_end: mut i64 = eq
            for {
                if left_end <= line_start {
                    break
                }
                val c: i64 = byte_at(src, left_end - 1)
                if c != 32 && c != 9 {
                    break
                }
                left_end--
            }

            val rec: mut ref ImportRec = @alloc(@sizeof(ImportRec)) as ref ImportRec
            rec.line_start = line_start
            rec.line_end = line_end
            rec.eq = eq
            rec.left_len = left_end - line_start
            rec.has_nl = line_end < len
            @append(group, rec)
        } else {
            flush_import_group(src, out, group)
            group = mem.new[ref ImportRec]()

            if line_end > line_start {
                buf_append_bytes(out, src, line_start, line_end - line_start)
            }
            if line_end < len {
                buf_append_char(out, 10 as u8)
            }
        }

        if line_end >= len {
            break
        }
        line_start = line_end + 1
    }

    flush_import_group(src, out, group)
    return buf_build(out)
}

fn spaces_text(n: i64) ref u8 = trust {
    val b: mut ref Buf = buf_new(n + 1)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        buf_append_char(b, 32 as u8)
        i++
    }
    return buf_build(b)
}

/// Align `=` inside top-level `val (...)` declarations.
fn format_bulk_val_alignment(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_val(k) && i + 1 < ntokens &&
        lexer.kind_is_lparen(lexer.tok_kind(tokens, i + 1)) {
            val close: i64 = find_matching_paren(tokens, i + 1)
            if close > i {
                val eqs: mut list[i64] = mem.new[i64]()
                val parens: mut i64 = 0
                val brackets: mut i64 = 0
                val braces: mut i64 = 0
                val j: mut i64 = i + 2
                for {
                    if j >= close {
                        break
                    }
                    val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)
                    if lexer.kind_is_lparen(jk) {
                        parens++
                    } elif lexer.kind_is_rparen(jk) {
                        if parens > 0 {
                            parens--
                        }
                    } elif lexer.kind_is_lbracket(jk) {
                        brackets++
                    } elif lexer.kind_is_rbracket(jk) {
                        if brackets > 0 {
                            brackets--
                        }
                    } elif lexer.kind_is_lbrace(jk) {
                        braces++
                    } elif lexer.kind_is_rbrace(jk) {
                        if braces > 0 {
                            braces--
                        }
                    } elif kind_is_eq(jk) && parens == 0 && brackets == 0 && braces == 0 {
                        @append(eqs, j)
                    }
                    j++
                }

                val max_left: mut i64 = 0
                for ej in eqs {
                    val eq_pos: i64 = token_start(tokens, starts, ej)
                    val line_idx: i64 = token_line(tokens, ej) - 1
                    val line_start_opt = @get(starts, line_idx as usize)
                    if line_start_opt is some line_start_val {
                        val line_start: i64 = line_start_val as i64
                        val left_end: mut i64 = eq_pos
                        for {
                            if left_end <= line_start {
                                break
                            }
                            val c: i64 = byte_at(src, left_end - 1)
                            if c != 32 && c != 9 {
                                break
                            }
                            left_end--
                        }
                        val left_len: i64 = left_end - line_start
                        if left_len > max_left {
                            max_left = left_len
                        }
                    }
                }

                for ej in eqs {
                    val eq_pos: i64 = token_start(tokens, starts, ej)
                    val line_idx: i64 = token_line(tokens, ej) - 1
                    val line_start_opt = @get(starts, line_idx as usize)
                    if line_start_opt is some line_start_val {
                        val line_start: i64 = line_start_val as i64
                        val left_end: mut i64 = eq_pos
                        for {
                            if left_end <= line_start {
                                break
                            }
                            val c: i64 = byte_at(src, left_end - 1)
                            if c != 32 && c != 9 {
                                break
                            }
                            left_end--
                        }
                        val left_len: i64 = left_end - line_start
                        val pad: i64 = max_left - left_len + 1
                        val text: ref u8 = spaces_text(pad)
                        @append(edits, edit_new(left_end, eq_pos, text))
                    }
                }
                free_i64_list(eqs)
                i = close
            }
        }
        i++
    }

    return apply_edits(src, edits)
}

fn format_top_level_decl_gaps(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    val out: mut ref Buf = buf_new(len + 64)
    val nesting: mut ref Nesting = @alloc(@sizeof(Nesting)) as ref Nesting
    val depth: mut i64 = 0
    val in_decl: mut bool = false
    val prev_decl_end: mut bool = false
    val prev_blank: mut bool = false
    val line_start: mut i64 = 0

    for {
        if line_start > len {
            break
        }

        val line_end: mut i64 = line_start
        for {
            if line_end >= len {
                break
            }
            if byte_at(src, line_end) == 10 {
                break
            }
            line_end++
        }

        val content_start: mut i64 = line_start
        for {
            if content_start >= line_end {
                break
            }
            val c: i64 = byte_at(src, content_start)
            if c != 32 && c != 9 {
                break
            }
            content_start++
        }

        val content_end: mut i64 = line_end
        for {
            if content_end <= content_start {
                break
            }
            val c: i64 = byte_at(src, content_end - 1)
            if c != 32 && c != 9 && c != 13 {
                break
            }
            content_end--
        }

        val blank: bool = content_start >= content_end
        val is_decl_start: bool =
        !blank && depth == 0 && line_is_block_decl_start(src, content_start, content_end)

        if is_decl_start && prev_decl_end && !prev_blank {
            buf_append_char(out, 10 as u8)
        }

        if !blank {
            buf_append_bytes(out, src, line_start, content_end - line_start)
        }

        if line_end < len {
            buf_append_char(out, 10 as u8)
        }

        scan_nesting(src, content_start, content_end, nesting)
        depth = depth + nesting.braces
        if depth < 0 {
            depth = 0
        }

        if is_decl_start {
            if depth > 0 {
                in_decl = true
            }
        }

        prev_decl_end = false
        if depth == 0 {
            if is_decl_start || in_decl {
                prev_decl_end = true
            }
            in_decl = false
        }
        prev_blank = blank

        if line_end >= len {
            break
        }
        line_start = line_end + 1
    }

    @free(nesting)
    return buf_build(out)
}

fn scan_nesting(src: ref u8, start: i64, end: i64, out: mut ref Nesting) void = trust {
    out.braces = 0
    out.parens = 0
    out.brackets = 0
    val i: mut i64 = start

    for {
        if i >= end {
            break
        }
        val c: i64 = byte_at(src, i)

        if c == 47 && i + 1 < end && byte_at(src, i + 1) == 47 {
            break
        }
        if c == 92 && i + 1 < end && byte_at(src, i + 1) == 92 {
            break
        }
        if c == 34 {
            i++
            for {
                if i >= end {
                    break
                }
                val sc: i64 = byte_at(src, i)
                if sc == 92 {
                    i += 2
                } elif sc == 34 {
                    i++
                    break
                } else {
                    i++
                }
            }
        } elif c == 39 {
            i++
            for {
                if i >= end {
                    break
                }
                val cc: i64 = byte_at(src, i)
                if cc == 92 {
                    i += 2
                } elif cc == 39 {
                    i++
                    break
                } else {
                    i++
                }
            }
        } elif c == 123 {
            out.braces++
            i++
        } elif c == 125 {
            out.braces--
            i++
        } elif c == 40 {
            out.parens++
            i++
        } elif c == 41 {
            out.parens--
            i++
        } elif c == 91 {
            out.brackets++
            i++
        } elif c == 93 {
            out.brackets--
            i++
        } else {
            i++
        }
    }
}

fn reindent(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    val out: mut ref Buf = buf_new(len + 32)
    val nesting: mut ref Nesting = @alloc(@sizeof(Nesting)) as ref Nesting
    val depth: mut i64 = 0
    val paren_depth: mut i64 = 0
    val bracket_depth: mut i64 = 0
    val line_start: mut i64 = 0

    for {
        if line_start > len {
            break
        }

        val line_end: mut i64 = line_start
        for {
            if line_end >= len {
                break
            }
            if byte_at(src, line_end) == 10 {
                break
            }
            line_end++
        }

        val content_start: mut i64 = line_start
        for {
            if content_start >= line_end {
                break
            }
            val c: i64 = byte_at(src, content_start)
            if c != 32 && c != 9 {
                break
            }
            content_start++
        }

        val content_end: mut i64 = line_end
        for {
            if content_end <= content_start {
                break
            }
            val c: i64 = byte_at(src, content_end - 1)
            if c != 32 && c != 9 && c != 13 {
                break
            }
            content_end--
        }

        if content_start < content_end {
            val first: i64 = byte_at(src, content_start)
            val total_depth: i64 = depth + paren_depth + bracket_depth
            val indent_depth: mut i64 = total_depth
            val starts_close: bool = first == 125 || first == 41 || first == 93
            if starts_close && indent_depth > 0 {
                indent_depth--
            }

            val spaces: i64 = indent_depth * 4
            val s: mut i64 = 0
            for {
                if s >= spaces {
                    break
                }
                buf_append_char(out, 32 as u8)
                s++
            }

            buf_append_bytes(out, src, content_start, content_end - content_start)

            scan_nesting(src, content_start, content_end, nesting)
            depth = depth + nesting.braces
            paren_depth = paren_depth + nesting.parens
            bracket_depth = bracket_depth + nesting.brackets
            if depth < 0 {
                depth = 0
            }
            if paren_depth < 0 {
                paren_depth = 0
            }
            if bracket_depth < 0 {
                bracket_depth = 0
            }
        }

        if line_end < len {
            buf_append_char(out, 10 as u8)
        }

        if line_end >= len {
            break
        }
        line_start = line_end + 1
    }

    // Normalize the end of the file: no trailing blank lines, one final newline.
    if out.len > 0 {
        for {
            if out.len <= 1 {
                break
            }
            val last: i64 = @load8(@ptradd(out.ptr, out.len - 1)) as i64
            val prev: i64 = @load8(@ptradd(out.ptr, out.len - 2)) as i64
            if last == 10 && prev == 10 {
                out.len--
            } else {
                break
            }
        }
        val last2: i64 = @load8(@ptradd(out.ptr, out.len - 1)) as i64
        if last2 != 10 {
            buf_append_char(out, 10 as u8)
        }
        @store8(@ptradd(out.ptr, out.len), 0)
    }

    @free(nesting)
    return buf_build(out)
}

fn find_for_body_open(tokens: list[ref lexer.Token], start: i64) i64 = trust {
    val n: i64 = @len(tokens) as i64
    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val i: mut i64 = start

    for {
        if i >= n {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lparen(k) {
            parens++
        } elif lexer.kind_is_rparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_lbracket(k) {
            brackets++
        } elif lexer.kind_is_rbracket(k) {
            if brackets > 0 {
                brackets--
            }
        } elif lexer.kind_is_lbrace(k) {
            if parens == 0 && brackets == 0 {
                return i
            }
        } elif lexer.kind_is_rbrace(k) {
            return -1
        }
        i++
    }

    return -1
}

fn append_remove_paren_open(
    src: ref u8,
    tokens: list[ref lexer.Token],
    starts: list[i64],
    open_idx: i64,
    next_idx: i64,
    edits: mut list[ref Edit]
) void = trust {
    val open_pos: i64 = token_start(tokens, starts, open_idx)
    val n: i64 = @len(tokens) as i64
    if next_idx >= 0 && next_idx < n && token_line(
        tokens,
        next_idx
    ) == token_line(tokens, open_idx) {
        val next_pos: i64 = token_start(tokens, starts, next_idx)
        if range_is_whitespace(src, open_pos + 1, next_pos) {
            @append(edits, edit_new(open_pos, next_pos, ""))
            return
        }
    }
    @append(edits, edit_new(open_pos, open_pos + 1, ""))
}

fn append_remove_paren_close(
    src: ref u8,
    tokens: list[ref lexer.Token],
    starts: list[i64],
    close_idx: i64,
    prev_idx: i64,
    edits: mut list[ref Edit]
) void = trust {
    val close_pos: i64 = token_start(tokens, starts, close_idx)
    if prev_idx >= 0 && token_line(tokens, prev_idx) == token_line(tokens, close_idx) {
        val prev_pos: i64 = token_start(tokens, starts, prev_idx)
        val ws_start: mut i64 = close_pos
        for {
            if ws_start <= prev_pos {
                break
            }
            val c: i64 = byte_at(src, ws_start - 1)
            if c != 32 && c != 9 {
                break
            }
            ws_start--
        }
        if ws_start > prev_pos {
            @append(edits, edit_new(ws_start, close_pos + 1, ""))
            return
        }
    }
    @append(edits, edit_new(close_pos, close_pos + 1, ""))
}

fn append_for_separator(
    src: ref u8,
    tokens: list[ref lexer.Token],
    starts: list[i64],
    idx: i64,
    edits: mut list[ref Edit]
) void = trust {
    val comma_pos: i64 = token_start(tokens, starts, idx)
    val ws_start: mut i64 = comma_pos
    for {
        if ws_start <= 0 {
            break
        }
        val c: i64 = byte_at(src, ws_start - 1)
        if c != 32 && c != 9 {
            break
        }
        ws_start--
    }

    val n: i64 = @len(tokens) as i64
    if idx + 1 < n && token_line(tokens, idx + 1) == token_line(tokens, idx) {
        val next_pos: i64 = token_start(tokens, starts, idx + 1)
        if range_is_whitespace(src, comma_pos + 1, next_pos) {
            @append(edits, edit_new(ws_start, next_pos, ", "))
            return
        }
    }

    @append(edits, edit_new(ws_start, comma_pos + 1, ","))
}

fn format_for_headers(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_for(k) {
            val header_start: i64 = i + 1
            if header_start < ntokens {
                val header_kind: lexer.TokenKind = lexer.tok_kind(tokens, header_start)

                // `for { ... }` has no header.
                if !lexer.kind_is_lbrace(header_kind) {
                    // Leave `for item in items` headers alone.
                    val probe: mut i64 = header_start
                    if lexer.kind_is_lparen(header_kind) {
                        probe = header_start + 1
                    }
                    val is_for_in: bool =
                    probe + 1 < ntokens &&
                    lexer.kind_is_ident(lexer.tok_kind(tokens, probe)) &&
                    kind_is_in(lexer.tok_kind(tokens, probe + 1))

                    if !is_for_in {
                        val body_open: i64 = find_for_body_open(tokens, header_start)
                        if body_open > header_start {
                            val header_end: i64 = body_open - 1
                            val for_pos: i64 = token_start(tokens, starts, i)
                            val header_pos: i64 = token_start(tokens, starts, header_start)
                            val keyword_end: i64 = for_pos + 3

                            if token_line(tokens, header_start) == token_line(tokens, i) &&
                            range_is_whitespace(src, keyword_end, header_pos) {
                                val already_one: bool =
                                header_pos - keyword_end == 1 && byte_at(src, keyword_end) == 32
                                if !already_one {
                                    @append(edits, edit_new(keyword_end, header_pos, " "))
                                }
                            }

                            val outer: bool =
                            lexer.kind_is_lparen(header_kind) &&
                            find_matching_paren(tokens, header_start) == header_end
                            val inner_start: mut i64 = header_start
                            val inner_end: mut i64 = header_end

                            if outer {
                                inner_start = header_start + 1
                                inner_end = header_end - 1
                                val next_inner: mut i64 = -1
                                if inner_start <= inner_end {
                                    next_inner = inner_start
                                }
                                append_remove_paren_open(
                                    src,
                                    tokens,
                                    starts,
                                    header_start,
                                    next_inner,
                                    edits
                                )
                            }

                            if inner_start <= inner_end {
                                val seps: mut list[i64] = mem.new[i64]()
                                val parens: mut i64 = 0
                                val brackets: mut i64 = 0
                                val j: mut i64 = inner_start

                                for {
                                    if j > inner_end {
                                        break
                                    }
                                    val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)
                                    if lexer.kind_is_lparen(jk) {
                                        parens++
                                    } elif lexer.kind_is_rparen(jk) {
                                        if parens > 0 {
                                            parens--
                                        }
                                    } elif lexer.kind_is_lbracket(jk) {
                                        brackets++
                                    } elif lexer.kind_is_rbracket(jk) {
                                        if brackets > 0 {
                                            brackets--
                                        }
                                    }
                                    val is_sep: bool = lexer.kind_is_comma(jk) || kind_is_semicolon(jk)
                                    if is_sep && parens == 0 && brackets == 0 {
                                        @append(seps, j)
                                    }
                                    j++
                                }

                                val nseps: i64 = @len(seps) as i64
                                val cond_first: mut i64 = inner_start
                                val cond_last: mut i64 = inner_end
                                val has_condition: mut bool = nseps == 0

                                if nseps == 2 {
                                    val first_sep_opt = @get(seps, 0 as usize)
                                    val second_sep_opt = @get(seps, 1 as usize)
                                    if first_sep_opt is some first_sep {
                                        if second_sep_opt is some second_sep {
                                            cond_first = (first_sep as i64) + 1
                                            cond_last = (second_sep as i64) - 1
                                            has_condition = true
                                        }
                                    }
                                }

                                val cond_open: mut i64 = -1
                                val cond_close: mut i64 = -1
                                if has_condition && cond_first <= cond_last &&
                                lexer.kind_is_lparen(lexer.tok_kind(tokens, cond_first)) {
                                    val match_close: i64 = find_matching_paren(tokens, cond_first)
                                    if match_close == cond_last {
                                        cond_open = cond_first
                                        cond_close = cond_last
                                    }
                                }

                                val sep_idx: mut i64 = 0
                                val jj: mut i64 = inner_start
                                for {
                                    if jj > inner_end {
                                        break
                                    }
                                    if jj == cond_open {
                                        val next_inner: mut i64 = -1
                                        if jj + 1 <= inner_end {
                                            next_inner = jj + 1
                                        }
                                        append_remove_paren_open(
                                            src,
                                            tokens,
                                            starts,
                                            jj,
                                            next_inner,
                                            edits
                                        )
                                    }
                                    if jj == cond_close {
                                        val prev_inner: mut i64 = -1
                                        if jj - 1 >= inner_start {
                                            prev_inner = jj - 1
                                        }
                                        append_remove_paren_close(
                                            src,
                                            tokens,
                                            starts,
                                            jj,
                                            prev_inner,
                                            edits
                                        )
                                    }
                                    if sep_idx < nseps {
                                        val sep_opt = @get(seps, sep_idx as usize)
                                        if sep_opt is some sep_val {
                                            val sep: i64 = sep_val as i64
                                            if sep == jj {
                                                append_for_separator(src, tokens, starts, jj, edits)
                                                sep_idx++
                                            }
                                        }
                                    }
                                    jj++
                                }
                                free_i64_list(seps)
                            }

                            if outer {
                                val prev_inner: mut i64 = -1
                                if inner_end >= inner_start {
                                    prev_inner = inner_end
                                }
                                append_remove_paren_close(
                                    src,
                                    tokens,
                                    starts,
                                    header_end,
                                    prev_inner,
                                    edits
                                )
                            }
                        }
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn line_length_at(src: ref u8, len: i64, starts: list[i64], line_idx: i64) i64 = trust {
    if line_idx < 0 {
        return 0
    }
    val start_opt = @get(starts, line_idx as usize)
    if start_opt is some sv {
        val start: i64 = sv as i64
        val end: mut i64 = start
        for {
            if end >= len {
                break
            }
            if byte_at(src, end) == 10 {
                break
            }
            end++
        }
        return end - start
    }
    return 0
}

fn paren_starts_call(tokens: list[ref lexer.Token], open_idx: i64) bool = trust {
    if open_idx <= 0 {
        return false
    }
    val pk: lexer.TokenKind = lexer.tok_kind(tokens, open_idx - 1)
    if lexer.kind_is_ident(pk) {
        return true
    }
    if lexer.kind_is_rparen(pk) {
        return true
    }
    if lexer.kind_is_rbracket(pk) {
        return true
    }
    return false
}

fn has_top_level_comma(tokens: list[ref lexer.Token], open_idx: i64, close_idx: i64) bool = trust {
    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val braces: mut i64 = 0
    val i: mut i64 = open_idx + 1

    for {
        if i >= close_idx {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lparen(k) {
            parens++
        } elif lexer.kind_is_rparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_lbracket(k) {
            brackets++
        } elif lexer.kind_is_rbracket(k) {
            if brackets > 0 {
                brackets--
            }
        } elif lexer.kind_is_lbrace(k) {
            braces++
        } elif lexer.kind_is_rbrace(k) {
            if braces > 0 {
                braces--
            }
        } elif lexer.kind_is_comma(k) {
            if parens == 0 && brackets == 0 && braces == 0 {
                if i + 1 < close_idx {
                    return true
                }
            }
        }
        i++
    }

    return false
}

fn wrap_delimited_at(
    src: ref u8,
    tokens: list[ref lexer.Token],
    starts: list[i64],
    open_idx: i64,
    close_idx: i64
) ref u8 = trust {
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val open_pos: i64 = token_start(tokens, starts, open_idx)
    @append(edits, edit_new(open_pos + 1, open_pos + 1, "\n"))

    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val braces: mut i64 = 0
    val i: mut i64 = open_idx + 1

    for {
        if i >= close_idx {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lparen(k) {
            parens++
        } elif lexer.kind_is_rparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_lbracket(k) {
            brackets++
        } elif lexer.kind_is_rbracket(k) {
            if brackets > 0 {
                brackets--
            }
        } elif lexer.kind_is_lbrace(k) {
            braces++
        } elif lexer.kind_is_rbrace(k) {
            if braces > 0 {
                braces--
            }
        } elif lexer.kind_is_comma(k) {
            if parens == 0 && brackets == 0 && braces == 0 {
                if i + 1 < close_idx {
                    val comma_pos: i64 = token_start(tokens, starts, i)
                    @append(edits, edit_new(comma_pos + 1, comma_pos + 1, "\n"))
                }
            }
        }
        i++
    }

    val close_pos: i64 = token_start(tokens, starts, close_idx)
    @append(edits, edit_new(close_pos, close_pos, "\n"))
    return apply_edits(src, edits)
}

/// Wrap the first over-long call or struct/type literal found in the source.
/// Only delimiters that open and close on the same line, and which have at
/// least two comma-separated items, are touched. This keeps the rewrite
/// purely whitespace-level and lets the caller reindent afterwards.
fn wrap_one_long_line(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_lparen(k) {
            val open_line: i64 = token_line(tokens, i)
            if line_length_at(src, len, starts, open_line - 1) > 100 {
                val close: i64 = find_matching_paren(tokens, i)
                if close > i && token_line(tokens, close) == open_line {
                    if paren_starts_call(tokens, i) &&
                    has_top_level_comma(tokens, i, close) {
                        val wrapped1: ref u8 = wrap_delimited_at(src, tokens, starts, i, close)
                        return wrapped1
                    }
                }
            }
        } elif lexer.kind_is_lbrace(k) {
            val open_line: i64 = token_line(tokens, i)
            if !brace_is_block(tokens, i) &&
            line_length_at(src, len, starts, open_line - 1) > 100 {
                val close: i64 = find_matching_brace(tokens, i)
                if close > i && token_line(tokens, close) == open_line {
                    if has_top_level_comma(tokens, i, close) {
                        val wrapped2: ref u8 = wrap_delimited_at(src, tokens, starts, i, close)
                        return wrapped2
                    }
                }
            }
        }

        i++
    }

    return src
}

fn format_long_lines(src: ref u8) ref u8 = trust {
    val current: mut ref u8 = src
    val owned: mut bool = false
    val rounds: mut i64 = 0
    for {
        if rounds >= 10000 {
            break
        }
        val next: ref u8 = wrap_one_long_line(current)
        if str.raw_cmp(next, current) == 0 {
            if next != current {
                @free(next)
            }
            break
        }
        val reindented: ref u8 = reindent(next)
        if next != current {
            @free(next)
        }
        if owned && current != reindented {
            @free(current)
        }
        current = reindented
        owned = true
        rounds++
    }
    return current
}

fn trim_leading_newlines(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    val start: mut i64 = 0

    for {
        if start >= len - 1 {
            break
        }
        if byte_at(src, start) != 10 {
            break
        }
        start++
    }

    if start == 0 {
        return src
    }

    val out: mut ref Buf = buf_new(len - start + 1)
    buf_append_bytes(out, src, start, len - start)
    return buf_build(out)
}

fn format_source(src: ref u8) ref u8 = trust {
    val current: mut ref u8 = rewrite_matches(src)
    val pass: mut ref u8 = format_for_headers(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_statement_separators(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_assert_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_block_braces(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_else_join(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_decl_separators(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_paren_separators(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_match_arm_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_colon_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_eq_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_as_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_operator_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_block_brace_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_fn_return_spacing(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = reindent(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_bulk_val_alignment(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_long_lines(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_import_alignment(current)
    release_if_owned(current, pass, src)
    current = pass

    pass = format_top_level_decl_gaps(current)
    release_if_owned(current, pass, src)
    current = pass

    val result: ref u8 = trim_leading_newlines(current)
    release_if_owned(current, result, src)
    return result
}

fn has_sx_suffix(file: ref u8) bool = {
    return str.raw_ends_with(file, ".sx")
}

fn is_directory(dir: ref u8) bool = trust {
    val handle: ref void = fs.opendir(dir)
    if handle == none {
        return false
    }
    fs.closedir(handle)
    return true
}

fn format_file(file: ref u8, to_stdout: bool) i32 = trust {
    val size_opt = fs.file_size(file)
    val size: mut i64 = 0
    if size_opt is some s {
        size = s as i64
    } else {
        stdio.print("error: could not read '{s}'\n", {file})
        return 1
    }

    val content_opt = fs.read_all_raw(file)
    val content: mut ref u8 = none
    if content_opt is some c {
        content = c
    } else {
        stdio.print("error: could not read '{s}'\n", {file})
        return 1
    }

    val i: mut i64 = 0
    for {
        if i >= size {
            break
        }
        if byte_at(content, i) == 0 {
            stdio.print("error: '{s}' is not a plaintext .sx file\n", {file})
            @free(content)
            return 1
        }
        i++
    }

    val formatted: mut ref u8 = format_source(content)
    if to_stdout {
        stdio.print("{s}", {formatted})
    } elif str.raw_cmp(formatted, content) != 0 {
        if !fs.write_all(file, formatted) {
            stdio.print("error: could not write '{s}'\n", {file})
            if formatted != content {
                @free(formatted)
            }
            @free(content)
            return 1
        }
    }

    if formatted != content {
        @free(formatted)
    }
    @free(content)
    return 0
}

fn collect_files(target: ref u8, out: mut list[ref u8], explicit: bool) i32 = trust {
    if is_directory(target) {
        val entries_opt = fs.walk_dir_raw(target)
        match entries_opt {
            none => {
                stdio.print("error: could not read directory '{s}'\n", {target})
                return 1
            }
            some entries => {
                for entry in entries {
                    val child: ref u8 = path.join(target, entry)
                    val code: i32 = collect_files(child, out, false)
                    if code != 0 {
                        return code
                    }
                }
            }
        }
        return 0
    }

    if has_sx_suffix(target) {
        @append(out, target)
        return 0
    }

    if !explicit {
        return 0
    }

    stdio.print("error: fmt only formats .sx files: '{s}'\n", {target})
    return 1
}

pub fn cmd_fmt(targets: list[ref u8], to_stdout: bool) i32 = trust {
    val n_targets: i64 = @len(targets) as i64
    if n_targets == 0 {
        stdio.puts("error: fmt requires at least one .sx file or directory")
        return 1
    }

    val files: mut list[ref u8] = mem.new[ref u8]()
    for target in targets {
        val code: i32 = collect_files(target, files, true)
        if code != 0 {
            return code
        }
    }

    for file in files {
        val code: i32 = format_file(file, to_stdout)
        if code != 0 {
            return code
        }
    }

    return 0
}
