    }
}

fn kind_is_operator_spacing(k: lexer.TokenKind) bool = {
    match k {
        EqEq() => {
            return true
        }
        BangEq() => {
            return true
        }
        Lt() => {
            return true
        }
        Gt() => {
            return true
        }
        LtEq() => {
            return true
        }
        GtEq() => {
            return true
        }
        And() => {
            return true
        }
        Or() => {
            return true
        }
        else => {
            return false
        }
    }
}

fn operator_len(k: lexer.TokenKind) i64 = {
    match k {
        EqEq() => {
            return 2
        }
        BangEq() => {
            return 2
        }
        LtEq() => {
            return 2
        }
        GtEq() => {
            return 2
        }
        And() => {
            return 2
        }
        Or() => {
            return 2
        }
        else => {
            return 1
        }
    }
}

