    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_colon(k) {
            val colon_pos: i64 = token_start(tokens, starts, i)
            val ws_before: mut i64 = colon_pos
            for {
                if ws_before <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_before - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_before--
            }
            if ws_before < colon_pos {
                @append(edits, edit_new(ws_before, colon_pos, ""))
            }

            if i + 1 < ntokens && token_line(tokens, i + 1) == token_line(tokens, i) {
                val next_kind: lexer.TokenKind = lexer.tok_kind(tokens, i + 1)
                if !lexer.kind_is_colon(next_kind) {
                    val next_pos: i64 = token_start(tokens, starts, i + 1)
                    if range_is_whitespace(src, colon_pos + 1, next_pos) {
                        @append(edits, edit_new(colon_pos + 1, next_pos, " "))
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
