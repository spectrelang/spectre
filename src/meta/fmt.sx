fn kind_starts_literal(k: lexer.TokenKind) bool = {
    match k {
        Return() => {
            return true
        }
        LParen() => {
            return true
        }
        LBracket() => {
            return true
        }
        Comma() => {
            return true
        }
        Colon() => {
            return true
        }
        Plus() => {
            return true
        }
        Minus() => {
            return true
        }
        Star() => {
            return true
        }
        Slash() => {
            return true
        }
        Percent() => {
            return true
        }
        EqEq() => {
            return true
        }
        BangEq() => {
            return true
        }
        Lt() => {
            return true
        }
        Gt() => {
            return true
        }
        LtEq() => {
            return true
        }
        GtEq() => {
            return true
        }
        And() => {
            return true
        }
        Or() => {
            return true
        }
        BitAnd() => {
            return true
        }
        BitOr() => {
            return true
        }
        BitXor() => {
            return true
        }
        Shl() => {
            return true
        }
        Shr() => {
            return true
        }
        Question() => {
            return true
        }
        Bang() => {
            return true
        }
        Tilde() => {
            return true
        }
        Dot() => {
            return true
        }
        else => {
            return false
        }
    }
}

fn token_line(tokens: list[ref lexer.Token], idx: i64) i64 = trust {
    val tok_opt = @get(tokens, idx as usize)
    if tok_opt is some tok_val {
        val tok: ref lexer.Token = tok_val as ref lexer.Token
        return tok.line
    } else {
        return -1
    }
}

fn brace_is_block(tokens: list[ref lexer.Token], i: i64) bool = trust {
    if i <= 0 {
        return true
    }
    val pk: lexer.TokenKind = lexer.tok_kind(tokens, i - 1)
    if lexer.kind_is_fatarrow(pk) {
        return true
    }

    if kind_is_eq(pk) {
        val j: mut i64 = i - 2
        for {
            if j < 0 {
                break
            }
            val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)
            if lexer.kind_is_lbrace(jk) || lexer.kind_is_rbrace(jk) || kind_is_semicolon(jk) {
                break
            }
            if kind_is_decl_keyword(jk) {
                return true
            }
            j--
        }
        return false
    }

    if kind_starts_literal(pk) {
        return false
    }

    // `Point{x: 1}` / `Point{}` are struct literals, not control-flow blocks.
    if lexer.kind_is_ident(pk) || lexer.kind_is_rbracket(pk) {
        val next: lexer.TokenKind = lexer.tok_kind(tokens, i + 1)
        if lexer.kind_is_rbrace(next) {
            if i >= 2 {
                val before: lexer.TokenKind = lexer.tok_kind(tokens, i - 2)
                if lexer.kind_is_if(before) || kind_is_elif(before) ||
                lexer.kind_is_for(before) || kind_is_in(before) ||
                kind_is_match(before) || kind_is_when(before) {
                    return true
                }
            }
            return false
        }
        if lexer.kind_is_ident(next) &&
        lexer.kind_is_colon(lexer.tok_kind(tokens, i + 2)) {
            return false
        }
    }
    return true
}

fn kind_starts_statement(k: lexer.TokenKind) bool = {
    match k {
        Val() => {
            return true
        }
        Return() => {
            return true
        }
        Pre() => {
            return true
        }
        Post() => {
            return true
        }
        Guarded() => {
            return true
        }
        Guard() => {
            return true
        }
        If() => {
            return true
        }
        For() => {
            return true
        }
        Defer() => {
            return true
        }
        Break() => {
            return true
        }
        Continue() => {
            return true
        }
        Assert() => {
            return true
        }
        When() => {
            return true
        }
        Match() => {
            return true
        }
        Trust() => {
            return true
        }
        At() => {
            return true
        }
        Ident _ => {
            return true
        }
        Str _ => {
            return true
        }
        Int _ => {
            return true
        }
        Float _ => {
            return true
        }
        CharLit _ => {
            return true
        }
        True() => {
            return true
        }
        False() => {
            return true
        }
        Some() => {
            return true
        }
        None() => {
            return true
        }
        Ok() => {
            return true
        }
        Err() => {
            return true
        }
        else => {
            return false
        }
    }
}

