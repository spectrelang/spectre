fn token_ident_is(tokens: list[ref lexer.Token], idx: i64, text: ref u8) bool = trust {
    if !lexer.kind_is_ident(lexer.tok_kind(tokens, idx)) {
        return false
    }
    val tok_text: ref u8 = lexer.tok_text(tokens, idx)
    if tok_text == none {
        return false
    }
    return str.raw_cmp(tok_text, text) == 0
}

/// Returns the index of the paren that matches the closing paren at `close_idx`.
fn find_matching_paren_back(tokens: list[ref lexer.Token], close_idx: i64) i64 = trust {
    val depth: mut i64 = 0
    val i: mut i64 = close_idx

    for {
        if i < 0 {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_rparen(k) {
            depth++
        } elif lexer.kind_is_lparen(k) {
            depth--
            if depth == 0 {
                return i
            }
        }
        i--
    }

    return -1
}

/// Returns the index of the bracket that matches the closing bracket at `close_idx`.
fn find_matching_bracket_back(tokens: list[ref lexer.Token], close_idx: i64) i64 = trust {
    val depth: mut i64 = 0
    val i: mut i64 = close_idx

    for {
        if i < 0 {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_rbracket(k) {
            depth++
        } elif lexer.kind_is_lbracket(k) {
            depth--
            if depth == 0 {
                return i
            }
        }
        i--
    }

    return -1
}

/// True when `)` closes the parameter list of a function declaration/type,
/// meaning a following identifier is its return type rather than a new
/// statement.
fn paren_closes_fn_params(tokens: list[ref lexer.Token], close_idx: i64) bool = trust {
    val open: i64 = find_matching_paren_back(tokens, close_idx)
    if open < 0 {
        return false
    }
    if open > 0 {
        val before: lexer.TokenKind = lexer.tok_kind(tokens, open - 1)
        if lexer.kind_is_fn(before) {
            return true
        }
    }

    val name_idx: mut i64 = open - 1
    if name_idx >= 0 && lexer.kind_is_rbracket(lexer.tok_kind(tokens, name_idx)) {
        val bopen: i64 = find_matching_bracket_back(tokens, name_idx)
        if bopen <= 0 {
            return false
        }
        name_idx = bopen - 1
    }
    if name_idx < 0 || !lexer.kind_is_ident(lexer.tok_kind(tokens, name_idx)) {
        return false
    }
    if name_idx == 0 {
        return false
    }

    val before_name: lexer.TokenKind = lexer.tok_kind(tokens, name_idx - 1)
    if lexer.kind_is_fn(before_name) {
        return true
    }
    if lexer.kind_is_rparen(before_name) {
        val recv_open: i64 = find_matching_paren_back(tokens, name_idx - 1)
        if recv_open > 0 {
            val before_recv: lexer.TokenKind = lexer.tok_kind(tokens, recv_open - 1)
            if lexer.kind_is_fn(before_recv) {
                return true
            }
        }
    }
    return false
}

/// True when `]` closes a fixed-size array type such as `[32]u8`.
fn bracket_closes_array_type(tokens: list[ref lexer.Token], close_idx: i64) bool = trust {
    val open: i64 = find_matching_bracket_back(tokens, close_idx)
    if open <= 0 {
        return false
    }
    val before: lexer.TokenKind = lexer.tok_kind(tokens, open - 1)
    if lexer.kind_is_colon(before) || lexer.kind_is_comma(before) ||
    lexer.kind_is_lparen(before) || lexer.kind_is_lbracket(before) ||
    lexer.kind_is_rbracket(before) || kind_is_as(before) ||
    lexer.kind_is_mut(before) || kind_is_ref(before) {
        return true
    }
    return false
}

/// True when a `{` opens the body of a type/union/enum/spec declaration.
/// Fields and methods inside those bodies are not statements.
fn brace_opens_decl_body(tokens: list[ref lexer.Token], i: i64) bool = trust {
    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val j: mut i64 = i - 1

    for {
        if j < 0 {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, j)
        if lexer.kind_is_rparen(k) {
            parens++
        } elif lexer.kind_is_lparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_rbracket(k) {
            brackets++
        } elif lexer.kind_is_lbracket(k) {
            if brackets > 0 {
                brackets--
            }
        }

        if parens == 0 && brackets == 0 {
            if kind_is_type(k) || kind_is_union(k) ||
            kind_is_enum(k) || lexer.kind_is_spec(k) {
                return true
            }
            if lexer.kind_is_lbrace(k) || lexer.kind_is_rbrace(k) ||
            kind_is_semicolon(k) || lexer.kind_is_arrow(k) ||
            lexer.kind_is_fatarrow(k) || lexer.kind_is_val(k) ||
            lexer.kind_is_return(k) || lexer.kind_is_if(k) ||
            lexer.kind_is_for(k) || kind_is_assert(k) ||
            kind_is_when(k) || kind_is_defer(k) ||
            lexer.kind_is_guard(k) {
                break
            }
        }
        j--
    }

    return false
}

/// True when a `{` opens the body of a `match`, where arm patterns are not
/// statements and must not be split apart.
fn brace_opens_match_body(tokens: list[ref lexer.Token], i: i64) bool = trust {
    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val j: mut i64 = i - 1

    for {
        if j < 0 {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, j)
        if lexer.kind_is_rparen(k) {
            parens++
        } elif lexer.kind_is_lparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_rbracket(k) {
            brackets++
        } elif lexer.kind_is_lbracket(k) {
            if brackets > 0 {
                brackets--
            }
        }

        if parens == 0 && brackets == 0 {
            if kind_is_match(k) {
                return true
            }
            if lexer.kind_is_lbrace(k) || lexer.kind_is_rbrace(k) ||
            kind_is_semicolon(k) || lexer.kind_is_arrow(k) ||
            lexer.kind_is_fatarrow(k) || lexer.kind_is_val(k) ||
            lexer.kind_is_return(k) || lexer.kind_is_if(k) ||
            lexer.kind_is_for(k) || kind_is_assert(k) ||
            kind_is_when(k) || kind_is_defer(k) ||
            lexer.kind_is_guard(k) {
                break
            }
        }
        j--
    }

    return false
}

/// Inserts a newline between statements that were written on the same line.
fn format_statement_separators(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val newlines: mut list[i64] = mem.new[i64]()
    // 1 = normal block (statements may be split), 0 = literal/match body.
    val frames: mut list[i64] = mem.new[i64]()
    val parens: mut i64 = 0
    val brackets: mut i64 = 0
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        val can_split: bool = i > 0 &&
        parens == 0 &&
        brackets == 0 &&
        token_line(tokens, i) == token_line(tokens, i - 1)
        if can_split {
            val prev_k: lexer.TokenKind = lexer.tok_kind(tokens, i - 1)
            val inside_block: mut bool = false
            if @len(frames) > 0 {
                val top_frame_opt = @get(frames, (@len(frames) - 1) as usize)
                if top_frame_opt is some top_frame {
                    inside_block = (top_frame as i64) == 1
                }
            }

            val starts_stmt: mut bool = false
            if inside_block {
                starts_stmt = kind_starts_statement(k)
            } elif @len(frames) == 0 {
                starts_stmt = kind_starts_top_level_decl(k)
            }

            if starts_stmt && kind_ends_statement(prev_k) {
                val continuation: mut bool = false
                if lexer.kind_is_ident(k) && token_ident_is(tokens, i, "is") {
                    continuation = true
                }
                if token_ident_is(tokens, i - 1, "is") ||
                token_ident_is(tokens, i - 1, "or") {
                    continuation = true
                }
                if lexer.kind_is_ident(k) && lexer.kind_is_rparen(prev_k) {
                    if paren_closes_fn_params(tokens, i - 1) {
                        continuation = true
                    }
                }
                if lexer.kind_is_fn(k) && lexer.kind_is_rparen(prev_k) {
                    val open: i64 = find_matching_paren_back(tokens, i - 1)
                    if open > 0 {
                        val before: lexer.TokenKind = lexer.tok_kind(tokens, open - 1)
                        if kind_is_extern(before) {
                            continuation = true
                        }
                    }
                }
                if lexer.kind_is_ident(k) && lexer.kind_is_rbracket(prev_k) {
                    if bracket_closes_array_type(tokens, i - 1) {
                        continuation = true
                    }
                }
                if !continuation {
                    val pos: i64 = token_start(tokens, starts, i)
                    @append(newlines, pos)
                }
            }
        }

        if lexer.kind_is_lparen(k) {
            parens++
        } elif lexer.kind_is_rparen(k) {
            if parens > 0 {
                parens--
            }
        } elif lexer.kind_is_lbracket(k) {
            brackets++
        } elif lexer.kind_is_rbracket(k) {
            if brackets > 0 {
                brackets--
            }
        } elif lexer.kind_is_lbrace(k) {
            val frame: mut i64 = 0
            if !brace_opens_match_body(tokens, i) &&
            !brace_opens_decl_body(tokens, i) &&
            brace_is_block(tokens, i) {
                frame = 1
            }
            @append(frames, frame)
        } elif lexer.kind_is_rbrace(k) {
            val flen: i64 = @len(frames) as i64
            if flen > 0 {
                @remove(frames, (flen - 1) as usize)
            }
        }

        i++
    }

    val result: ref u8 = insert_newlines(src, newlines)
    free_i64_list(frames)
    return result
}

fn sort_positions(pos: mut list[i64]) void = trust {
    val n: i64 = @len(pos) as i64
    val i: mut i64 = 1
    for {
        if i >= n {
            break
        }
        val cur_opt = @get(pos, i as usize)
        val cur: mut i64 = 0
        if cur_opt is some v {
            cur = v as i64
        }
        val j: mut i64 = i - 1
        for {
            if j < 0 {
                break
            }
            val prev_opt = @get(pos, j as usize)
            val prev: mut i64 = 0
            if prev_opt is some v {
                prev = v as i64
            }
            if prev <= cur {
                break
            }
            @set(pos, (j + 1) as usize, prev)
            j--
        }
        @set(pos, (j + 1) as usize, cur)
        i++
    }
}

fn insert_newlines(src: ref u8, pos: mut list[i64]) ref u8 = trust {
    sort_positions(pos)
    val len: i64 = str.len_raw(src)
    val out: mut ref Buf = buf_new(len + (@len(pos) as i64) + 32)
    val last: mut i64 = 0

    for p in pos {
        if p <= last {
            continue
        }
        buf_append_bytes(out, src, last, p - last)
        buf_append_char(out, 10 as u8)
        last = p
    }

    if last < len {
        buf_append_bytes(out, src, last, len - last)
    }

    val result: ref u8 = buf_build(out)
    free_i64_list(pos)
    return result
}

fn find_matching_paren(tokens: list[ref lexer.Token], open_idx: i64) i64 = trust {
    val n: i64 = @len(tokens) as i64
    val depth: mut i64 = 0
    val i: mut i64 = open_idx
    for {
        if i >= n {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lparen(k) {
            depth++
        } elif lexer.kind_is_rparen(k) {
            depth--
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn find_matching_brace(tokens: list[ref lexer.Token], open_idx: i64) i64 = trust {
    val n: i64 = @len(tokens) as i64
    val depth: mut i64 = 0
    val i: mut i64 = open_idx
    for {
        if i >= n {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lbrace(k) {
            depth++
        } elif lexer.kind_is_rbrace(k) {
            depth--
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn collect_arms(
    tokens: list[ref lexer.Token],
    body_open: i64,
    body_close: i64
) list[ref Arm] = trust {
    val arms: mut list[ref Arm] = mem.new[ref Arm]()
    val i: mut i64 = body_open + 1

    for {
        if i >= body_close {
            break
        }

        val pat_start: i64 = i
        val arrow: mut i64 = -1
        val j: mut i64 = i
        for {
            if j >= body_close {
                break
            }
            val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)
            if lexer.kind_is_fatarrow(jk) {
                arrow = j
                break
            }
            if lexer.kind_is_lbrace(jk) {
                break
            }
            j++
        }

        if arrow < 0 {
            break
        }

        val open: i64 = arrow + 1
        if open >= body_close {
            break
        }
        if !lexer.kind_is_lbrace(lexer.tok_kind(tokens, open)) {
            break
        }

        val close: i64 = find_matching_brace(tokens, open)
        if close < 0 || close > body_close {
            break
        }

        val arm: mut ref Arm = @alloc(@sizeof(Arm)) as ref Arm
        arm.start = pat_start
        arm.arrow = arrow
        arm.open = open
        arm.close = close
        @append(arms, arm)

        i = close + 1
    }

    return arms
}

fn find_match_body_open(tokens: list[ref lexer.Token], match_idx: i64) i64 = trust {
    val n: i64 = @len(tokens) as i64
    val paren: mut i64 = 0
    val bracket: mut i64 = 0
    val i: mut i64 = match_idx + 1

    for {
        if i >= n {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        if lexer.kind_is_lparen(k) {
            paren++
        } elif lexer.kind_is_rparen(k) {
            if paren > 0 {
                paren--
            }
        } elif lexer.kind_is_lbracket(k) {
            bracket++
        } elif lexer.kind_is_rbracket(k) {
            if bracket > 0 {
                bracket--
            }
        } elif lexer.kind_is_lbrace(k) {
            if paren == 0 && bracket == 0 {
                return i
            }
        }
        i++
    }

    return -1
}

fn rewrite_match_at(
    src: ref u8,
    tokens: list[ref lexer.Token],
    starts: list[i64],
    match_i: i64
) option[ref u8] = trust {
    val len_src: i64 = str.len_raw(src)
    val body_open: i64 = find_match_body_open(tokens, match_i)
    if body_open < 0 {
        return none
    }

    val body_close: i64 = find_matching_brace(tokens, body_open)
    if body_close < 0 {
        return none
    }

    val arms: mut list[ref Arm] = collect_arms(tokens, body_open, body_close)
    defer {
        free_arm_list(arms)
    }
    val n_arms: i64 = @len(arms) as i64
    if n_arms != 2 {
        return none
    }

    val arm0_opt = @get(arms, 0 as usize)
    val arm1_opt = @get(arms, 1 as usize)
    val arm0: mut ref Arm = none
    val arm1: mut ref Arm = none

    if arm0_opt is some a {
        arm0 = a as ref Arm
    } else {
        return none
    }
    if arm1_opt is some a {
        arm1 = a as ref Arm
    } else {
        return none
    }

    if !kind_is_some(lexer.tok_kind(tokens, arm0.start)) {
        return none
    }
    if !kind_is_none(lexer.tok_kind(tokens, arm1.start)) {
        return none
    }

    // The some arm must be exactly `some <binding> => { ... }`.
    if arm0.arrow != arm0.start + 2 {
        return none
    }
    if !lexer.kind_is_ident(lexer.tok_kind(tokens, arm0.start + 1)) {
        return none
    }

    // The none arm must be exactly `none => { ... }`.
    if arm1.arrow != arm1.start + 1 {
        return none
    }

    val bind_opt = @get(tokens, (arm0.start + 1) as usize)
    val bind: mut ref u8 = "_"
    if bind_opt is some bind_val {
        val bind_tok: ref lexer.Token = bind_val as ref lexer.Token
        match bind_tok.kind {
            Ident s => {
                bind = s
            }
            else => {
                return none
            }
        }
    } else {
        return none
    }

    val m_start: i64 = token_start(tokens, starts, match_i)
    val m_open: i64 = token_start(tokens, starts, body_open)
    val s_start: i64 = token_start(tokens, starts, arm0.start)
    val s_open: i64 = token_start(tokens, starts, arm0.open)
    val s_close: i64 = token_start(tokens, starts, arm0.close)
    val n_open: i64 = token_start(tokens, starts, arm1.open)
    val n_close: i64 = token_start(tokens, starts, arm1.close)
    val m_close: i64 = token_start(tokens, starts, body_close)

    val s_open_end: i64 = s_open + 1
    val s_close_end: i64 = s_close + 1
    val m_close_end: i64 = m_close + 1

    // Only collapse the match when the none arm is empty. A non-empty none
    // arm is real fallback logic and should stay as a match.
    val none_body_empty: bool = range_is_whitespace(src, n_open + 1, n_close)
    if !none_body_empty {
        return none
    }

    val edits: mut list[ref Edit] = mem.new[ref Edit]()

    // match -> if
    @append(edits, edit_new(m_start, m_start + 5, "if"))

    // Normalize the whitespace before the body brace so the inserted
    // condition does not end up with doubled spaces or a missing space.
    val ws_start: mut i64 = m_open
    for {
        if ws_start <= 0 {
            break
        }
        val c: i64 = byte_at(src, ws_start - 1)
        if !is_space_byte(c) {
            break
        }
        ws_start--
    }

    @append(edits, edit_new(ws_start, m_open, ""))
    @append(edits, edit_new(m_open, m_open, @fmtalloc(" is some {s} ", {bind})))

    val some_removal_start: mut i64 = m_open + 1
    val nl_scan: mut i64 = m_open + 1
    for {
        if nl_scan >= s_start {
            break
        }
        if byte_at(src, nl_scan) == 10 {
            some_removal_start = nl_scan + 1
        }
        nl_scan++
    }

    val some_removal_end: mut i64 = s_open_end
    if some_removal_start > m_open + 1 {
        val after_open: mut i64 = s_open_end
        for {
            if after_open >= len_src {
                break
            }
            val c: i64 = byte_at(src, after_open)
            if c != 32 && c != 9 {
                break
            }
            after_open++
        }
        if after_open < len_src {
            val c2: i64 = byte_at(src, after_open)
            if c2 == 10 {
                some_removal_end = after_open + 1
            } elif c2 == 13 {
                some_removal_end = after_open + 1
                if some_removal_end < len_src && byte_at(src, some_removal_end) == 10 {
                    some_removal_end++
                }
            }
        }
    }

    @append(edits, edit_new(some_removal_start, some_removal_end, ""))
    @append(edits, edit_new(s_close_end, m_close, ""))
    @append(edits, edit_new(m_close, m_close_end, ""))

    return some apply_edits(src, edits)
}

fn rewrite_one_match(src: ref u8) option[ref u8] = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return none
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)
        match k {
            Match() => {
                val rewritten = rewrite_match_at(src, tokens, starts, i)
                if rewritten is some out {
                    return some out
                }
            }
            else => {}
        }
        i++
    }

    return none
}

fn rewrite_matches(src: ref u8) ref u8 = trust {
    val current: mut ref u8 = src
    val owned: mut bool = false
    val rounds: mut i64 = 0
    for {
        if rounds >= 100000 {
            break
        }
        val next = rewrite_one_match(current)
        if next is some out {
            if owned && out != current {
                @free(current)
            }
            current = out
            owned = true
        } else {
            break
        }
        rounds++
    }
    return current
}

fn format_block_braces(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val newlines: mut list[i64] = mem.new[i64]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_lbrace(k) {
            if brace_is_block(tokens, i) {
                val close: i64 = find_matching_brace(tokens, i)
                if close > i {
                    if close > i + 1 {
                        val open_line: i64 = token_line(tokens, i)
                        val next_line: i64 = token_line(tokens, i + 1)
                        if open_line == next_line {
                            val open_pos: i64 = token_start(tokens, starts, i) + 1
                            @append(newlines, open_pos)
                        }

                        val prev_line: i64 = token_line(tokens, close - 1)
                        val close_line: i64 = token_line(tokens, close)
                        if prev_line == close_line {
                            val close_pos: i64 = token_start(tokens, starts, close)
                            @append(newlines, close_pos)
                        }
                    }

                    if close + 1 < ntokens {
                        val close_line2: i64 = token_line(tokens, close)
                        val after_line: i64 = token_line(tokens, close + 1)
                        if close_line2 == after_line {
                            val nk: lexer.TokenKind = lexer.tok_kind(tokens, close + 1)
                            val same_line: bool =
                            lexer.kind_is_else(nk) || kind_is_elif(nk) ||
                            lexer.kind_is_comma(nk) || lexer.kind_is_rparen(nk) ||
                            lexer.kind_is_rbracket(nk) || kind_is_semicolon(nk) ||
                            lexer.kind_is_rbrace(nk)
                            if !same_line {
                                val after_pos: i64 = token_start(tokens, starts, close + 1)
                                @append(newlines, after_pos)
                            }
                        }
                    }
                }
            }
        }

        i++
    }

    return insert_newlines(src, newlines)
}

fn format_else_join(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val joins: mut list[i64] = mem.new[i64]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_if(k) || kind_is_elif(k) {
            val body_open: i64 = find_for_body_open(tokens, i + 1)
            if body_open > i {
                val body_close: i64 = find_matching_brace(tokens, body_open)
                if body_close > body_open && body_close + 1 < ntokens {
                    val after: lexer.TokenKind = lexer.tok_kind(tokens, body_close + 1)
                    if lexer.kind_is_else(after) || kind_is_elif(after) {
                        @append(joins, body_close + 1)
                    }
                }
            }
        }

        i++
    }

    sort_positions(joins)
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    for after_idx in joins {
        val close_pos: i64 = token_start(tokens, starts, after_idx - 1)
        val after_pos: i64 = token_start(tokens, starts, after_idx)
        if range_is_whitespace(src, close_pos + 1, after_pos) {
            val already_one: bool =
            after_pos - (close_pos + 1) == 1 && byte_at(src, close_pos + 1) == 32
            if !already_one {
                @append(edits, edit_new(close_pos + 1, after_pos, " "))
            }
        }
    }

    free_i64_list(joins)
    return apply_edits(src, edits)
}

fn format_match_arm_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_fatarrow(k) {
            val arrow_line: i64 = token_line(tokens, i)

            val pstart: mut i64 = i - 1
            for {
                if pstart < 0 {
                    break
                }
                if token_line(tokens, pstart) != arrow_line {
                    break
                }
                val pk: lexer.TokenKind = lexer.tok_kind(tokens, pstart)
                if lexer.kind_is_lbrace(pk) || lexer.kind_is_rbrace(pk) {
                    break
                }
                pstart--
            }
            pstart++

            val j: mut i64 = pstart
            for {
                if j >= i {
                    break
                }
                val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)

                if lexer.kind_is_comma(jk) {
                    val comma_pos: i64 = token_start(tokens, starts, j)

                    val ws_before: mut i64 = comma_pos
                    for {
                        if ws_before <= 0 {
                            break
                        }
                        val c: i64 = byte_at(src, ws_before - 1)
                        if c != 32 && c != 9 {
                            break
                        }
                        ws_before--
                    }
                    if ws_before < comma_pos {
                        @append(edits, edit_new(ws_before, comma_pos, ""))
                    }

                    if j + 1 < i {
                        val next_line: i64 = token_line(tokens, j + 1)
                        if next_line == arrow_line {
                            val next_pos: i64 = token_start(tokens, starts, j + 1)
                            if range_is_whitespace(src, comma_pos + 1, next_pos) {
                                @append(edits, edit_new(comma_pos + 1, next_pos, " "))
                            }
                        }
                    }
                }

                j++
            }

            val arrow_pos: i64 = token_start(tokens, starts, i)
            val ws_arrow: mut i64 = arrow_pos
            for {
                if ws_arrow <= 0 {
                    break
                }
                val c: i64 = byte_at(src, ws_arrow - 1)
                if c != 32 && c != 9 {
                    break
                }
                ws_arrow--
            }

            val arrow_at_line_start: bool =
            ws_arrow == 0 ||
            byte_at(src, ws_arrow - 1) == 10 ||
            byte_at(src, ws_arrow - 1) == 13

            if !arrow_at_line_start {
                val arrow_gap: i64 = arrow_pos - ws_arrow
                val arrow_one: bool = arrow_gap == 1 && byte_at(src, ws_arrow) == 32
                if !arrow_one {
                    @append(edits, edit_new(ws_arrow, arrow_pos, " "))
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_decl_separators(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if kind_is_type(k) || kind_is_enum(k) {
            val body_open: i64 = find_match_body_open(tokens, i)
            if body_open > i {
                val body_close: i64 = find_matching_brace(tokens, body_open)
                if body_close > body_open {
                    val brace_depth: mut i64 = 0
                    val paren_depth: mut i64 = 0
                    val bracket_depth: mut i64 = 0
                    val j: mut i64 = body_open + 1

                    for {
                        if j >= body_close {
                            break
                        }
                        val jk: lexer.TokenKind = lexer.tok_kind(tokens, j)

                        if lexer.kind_is_lbrace(jk) {
                            brace_depth++
                        } elif lexer.kind_is_rbrace(jk) {
                            if brace_depth > 0 {
                                brace_depth--
                            }
                        } elif lexer.kind_is_lparen(jk) {
                            paren_depth++
                        } elif lexer.kind_is_rparen(jk) {
                            if paren_depth > 0 {
                                paren_depth--
                            }
                        } elif lexer.kind_is_lbracket(jk) {
                            bracket_depth++
                        } elif lexer.kind_is_rbracket(jk) {
                            if bracket_depth > 0 {
                                bracket_depth--
                            }
                        } elif lexer.kind_is_comma(jk) {
                            if brace_depth == 0 && paren_depth == 0 && bracket_depth == 0 {
                                val comma_pos: i64 = token_start(tokens, starts, j)
                                val same_line: bool =
                                j + 1 < body_close &&
                                token_line(tokens, j + 1) == token_line(tokens, j)

                                if same_line {
                                    @append(edits, edit_new(comma_pos, comma_pos + 1, "\n"))
                                } else {
                                    @append(edits, edit_new(comma_pos, comma_pos + 1, ""))
                                }
                            }
                        }

                        j++
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_paren_separators(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

    val len: i64 = str.len_raw(src)
    val starts: mut list[i64] = collect_line_starts(src, len)
    defer {
        free_i64_list(starts)
    }
    val ntokens: i64 = @len(tokens) as i64
    val edits: mut list[ref Edit] = mem.new[ref Edit]()
    val paren_depth: mut i64 = 0
    val i: mut i64 = 0

    for {
        if i >= ntokens {
            break
        }
        val k: lexer.TokenKind = lexer.tok_kind(tokens, i)

        if lexer.kind_is_lparen(k) {
            paren_depth++
        } elif lexer.kind_is_rparen(k) {
            if paren_depth > 0 {
                paren_depth--
            }
        } elif lexer.kind_is_comma(k) {
            if paren_depth > 0 {
                val comma_pos: i64 = token_start(tokens, starts, i)
                val ws_before: mut i64 = comma_pos
                for {
                    if ws_before <= 0 {
                        break
                    }
                    val c: i64 = byte_at(src, ws_before - 1)
                    if c != 32 && c != 9 {
                        break
                    }
                    ws_before--
                }
                if ws_before < comma_pos {
                    @append(edits, edit_new(ws_before, comma_pos, ""))
                }

                if i + 1 < ntokens && token_line(tokens, i + 1) == token_line(tokens, i) {
                    val next_kind: lexer.TokenKind = lexer.tok_kind(tokens, i + 1)
                    if !lexer.kind_is_rparen(next_kind) {
                        val next_pos: i64 = token_start(tokens, starts, i + 1)
                        if range_is_whitespace(src, comma_pos + 1, next_pos) {
                            @append(edits, edit_new(comma_pos + 1, next_pos, " "))
                        }
                    }
                }
            }
        }

        i++
    }

    return apply_edits(src, edits)
}

fn format_colon_spacing(src: ref u8) ref u8 = trust {
    val tok_res = lexer.tokenize(src)
    val tokens: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match tok_res {
        ok toks => {
            tokens = toks
        }
        err _ => {
            return src
        }
    }
    defer {
        lexer.free_tokens(tokens)
    }

