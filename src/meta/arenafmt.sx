/// Compiler-local phase-scoped formatting for codegen and parser internals.

val allocators = use("std/allocators")
val str        = use("std/string")

fn rewrite_fmt(
    arena: allocators.ScopedArenaAllocator,
    fmt: str.StringView
) str.StringView = trust {
    val buf: ref void = allocators.ScopedArena.alloc_or_none(
        arena,
        (fmt.len * 2 + 1) as usize
    )
    if buf == none {
        return str.view(none, 0)
    }
    val out_i: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= fmt.len {
            break
        }
        val c: u8 = @load8(@ptradd(fmt.ptr, i)) as u8
        if c == 92 && i + 1 < fmt.len {
            val next: u8 = @load8(@ptradd(fmt.ptr, i + 1)) as u8
            if next == 123 || next == 125 {
                @store8(@ptradd(buf, out_i), next)
                out_i++
                i += 2
            } else {
                @store8(@ptradd(buf, out_i), c)
                out_i++
                i++
            }
        } elif c == 37 {
            @store8(@ptradd(buf, out_i), 37)
            out_i++
            @store8(@ptradd(buf, out_i), 37)
            out_i++
            i++
        } elif c == 123 {
            val j: mut i64 = i + 1
            val found: mut i64 = 0
            for {
                if j >= fmt.len {
                    break
                }
                val inner: u8 = @load8(@ptradd(fmt.ptr, j)) as u8
                if inner == 125 {
                    found = 1
                    break
                }
                j++
            }
            if found != 0 {
                @store8(@ptradd(buf, out_i), 37)
                out_i++
                val k: mut i64 = i + 1
                for {
                    if k >= j {
                        break
                    }
                    val sc: u8 = @load8(@ptradd(fmt.ptr, k)) as u8
                    @store8(@ptradd(buf, out_i), sc)
                    out_i++
                    k++
                }
                i = j + 1
            } else {
                @store8(@ptradd(buf, out_i), c)
                out_i++
                i++
            }
        } else {
            @store8(@ptradd(buf, out_i), c)
            out_i++
            i++
        }
    }
    @store8(@ptradd(buf, out_i), 0)
    return str.view(buf as ref u8, out_i)
}

pub fn format(
    arena: allocators.ScopedArenaAllocator,
    fmt: str.StringView,
    args: argspack
) str.StringView = trust {
    val rfmt: str.StringView = rewrite_fmt(arena, fmt)
    if rfmt.ptr == none {
        return str.view(none, 0)
    }
    val cap: i64 = 4096
    val out: ref void = allocators.ScopedArena.alloc_or_none(arena, cap as usize)
    if out == none {
        return str.view(none, 0)
    }
    val written: i64 = @snprintf(out, cap, rfmt.ptr, args) as i64
    if written < 0 {
        return str.view(none, 0)
    }
    if written < cap {
        return str.view(out as ref u8, written)
    }
    val needed: i64 = written + 1
    val grown: ref void = allocators.ScopedArena.alloc_or_none(arena, needed as usize)
    if grown == none {
        return str.view(none, 0)
    }
    val rewritten: i64 = @snprintf(grown, needed, rfmt.ptr, args) as i64
    if rewritten < 0 || rewritten >= needed {
        return str.view(none, 0)
    }
    return str.view(grown as ref u8, rewritten)
}
