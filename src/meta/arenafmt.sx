/// Compiler-local phase-scoped formatting for codegen and parser internals.

val allocators = use("std/allocators")

extern (C, header) fn strlen(s: ref u8) i64 = "strlen"

fn rewrite_fmt(arena: allocators.ScopedArenaAllocator, fmt: ref u8) ref void = trust {
    val fmtlen: i64 = strlen(fmt)
    val buf: ref void = allocators.ScopedArena.alloc_or_none(arena, (fmtlen * 2 + 1) as usize)
    if buf == none {
        return none
    }
    val out_i: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= fmtlen {
            break
        }
        val c: u8 = @load8(@ptradd(fmt, i)) as u8
        if c == 92 && i + 1 < fmtlen {
            val next: u8 = @load8(@ptradd(fmt, i + 1)) as u8
            if next == 123 || next == 125 {
                @store8(@ptradd(buf, out_i), next)
                out_i++
                i += 2
            } else {
                @store8(@ptradd(buf, out_i), c)
                out_i++
                i++
            }
        } elif c == 37 {
            @store8(@ptradd(buf, out_i), 37)
            out_i++
            @store8(@ptradd(buf, out_i), 37)
            out_i++
            i++
        } elif c == 123 {
            val j: mut i64 = i + 1
            val found: mut i64 = 0
            for {
                if j >= fmtlen {
                    break
                }
                val inner: u8 = @load8(@ptradd(fmt, j)) as u8
                if inner == 125 {
                    found = 1
                    break
                }
                j++
            }
            if found != 0 {
                @store8(@ptradd(buf, out_i), 37)
                out_i++
                val k: mut i64 = i + 1
                for {
                    if k >= j {
                        break
                    }
                    val sc: u8 = @load8(@ptradd(fmt, k)) as u8
                    @store8(@ptradd(buf, out_i), sc)
                    out_i++
                    k++
                }
                i = j + 1
            } else {
                @store8(@ptradd(buf, out_i), c)
                out_i++
                i++
            }
        } else {
            @store8(@ptradd(buf, out_i), c)
            out_i++
            i++
        }
    }
    @store8(@ptradd(buf, out_i), 0)
    return buf
}

pub fn format(
    arena: allocators.ScopedArenaAllocator,
    fmt_string: ref u8,
    args: argspack
) ref u8 = trust {
    val rfmt: ref void = rewrite_fmt(arena, fmt_string)
    if rfmt == none {
        return none
    }
    val cap: i64 = 4096
    val out: ref void = allocators.ScopedArena.alloc_or_none(arena, cap as usize)
    if out == none {
        return none
    }
    val written: i64 = @snprintf(out, cap, rfmt, args) as i64
    if written < 0 || written >= cap {
        return none
    }
    return out as ref u8
}
