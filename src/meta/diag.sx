/// Source-located compiler diagnostics with an excerpt and caret.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val stdio      = use("std/stdio")
val str        = use("std/string")
val fs         = use("std/fs")
val cstr       = use("std/string/cstr")
val path       = use("std/path")
val reflection = use("std/reflection")
val allocators = use("std/allocators")
val terminal   = use("std/terminal")

/// Prefix for every diagnostic.
pub val LABEL: ref u8 = c"error:"

val (
    WARNING_LABEL: ref u8 = c"warning:"
    INFO_LABEL: ref u8    = c"note:"
)

type SourceLocation = {
    found: bool
    filename: ref u8
    line: i64
    col: i64
    span: i64
    message: ref u8
}

type KnownSourcePath = {
    display: mut ref u8
    actual: mut ref u8
    next: mut ref KnownSourcePath
}

val known_source_paths: mut ref KnownSourcePath = none

fn duplicate_cstr(value: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(value)
    val out: ref u8 = @alloc((len + 1) as usize) as ref u8
    if out == none {
        return none
    }
    if len > 0 {
        @memcpy(out, value, len as usize)
    }
    @store8(@ptradd(out, len), 0)
    return out
}

fn lookup_source_path(display: ref u8) ref u8 = trust {
    val node: mut ref KnownSourcePath = known_source_paths
    for {
        if node == none {
            break
        }
        if cstr.eql(node.display, display) {
            return node.actual
        }
        node = node.next
    }
    return none
}

/// Record where a shortened diagnostic filename can be read from disk.
pub fn register_source_path(display: ref u8, actual: ref u8) void = trust {
    if display == none || actual == none {
        return
    }
    if lookup_source_path(display) != none {
        return
    }
    val node: mut ref KnownSourcePath = @alloc(@sizeof(KnownSourcePath)) as ref KnownSourcePath
    if node == none {
        return
    }
    node.display = duplicate_cstr(display)
    node.actual = duplicate_cstr(actual)
    if node.display == none || node.actual == none {
        @free(node as ref void)
        return
    }
    node.next = known_source_paths
    known_source_paths = node
}

fn is_digit(c: i64) bool = {
    return c >= 48 && c <= 57
}

fn copy_range(value: ref u8, start: i64, count: i64) ref u8 = trust {
    val out: ref u8 = @alloc((count + 1) as usize) as ref u8
    if out == none {
        return c""
    }
    if count > 0 {
        @memcpy(out, @ptradd(value, start), count as usize)
    }
    @store8(@ptradd(out, count), 0)
    return out
}

/// Split `file:line:col: message` or `file:line: message` into its parts.
fn locate(message: ref u8) SourceLocation = trust {
    val n: i64 = cstr.len(message)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(message, i)) as i64 == 58 {
            val number_start: i64 = i + 1
            val after_line: mut i64 = number_start
            val line: mut i64 = 0
            for {
                if after_line >= n {
                    break
                }
                val c: i64 = @load8(@ptradd(message, after_line)) as i64
                if !is_digit(c) {
                    break
                }
                line = line * 10 + (c - 48)
                after_line++
            }
            if after_line > number_start && after_line < n {
                if @load8(@ptradd(message, after_line)) as i64 == 58 {
                    val after_colon: i64 = after_line + 1
                    if after_colon < n
                    && @load8(@ptradd(message, after_colon)) as i64 == 32 {
                        return {
                            found: true,
                            filename: copy_range(message, 0, i),
                            line: line,
                            col: 0,
                            span: 0,
                            message: @ptradd(message, after_colon + 1) as ref u8
                        }
                    }

                    val after_col: mut i64 = after_colon
                    val col: mut i64 = 0
                    for {
                        if after_col >= n {
                            break
                        }
                        val c: i64 = @load8(@ptradd(message, after_col)) as i64
                        if !is_digit(c) {
                            break
                        }
                        col = col * 10 + (c - 48)
                        after_col++
                    }
                    if col > 0 && after_col < n
                    && @load8(@ptradd(message, after_col)) as i64 == 58 {
                        val after_span_colon: i64 = after_col + 1
                        if after_span_colon < n
                        && @load8(@ptradd(message, after_span_colon)) as i64 == 32 {
                            return {
                                found: true,
                                filename: copy_range(message, 0, i),
                                line: line,
                                col: col,
                                span: 0,
                                message: @ptradd(message, after_span_colon + 1) as ref u8
                            }
                        }

                        val after_span: mut i64 = after_span_colon
                        val span: mut i64 = 0
                        for {
                            if after_span >= n {
                                break
                            }
                            val c: i64 = @load8(@ptradd(message, after_span)) as i64
                            if !is_digit(c) {
                                break
                            }
                            span = span * 10 + (c - 48)
                            after_span++
                        }
                        if span > 0 && after_span + 1 < n
                        && @load8(@ptradd(message, after_span)) as i64 == 58
                        && @load8(@ptradd(message, after_span + 1)) as i64 == 32 {
                            return {
                                found: true,
                                filename: copy_range(message, 0, i),
                                line: line,
                                col: col,
                                span: span,
                                message: @ptradd(message, after_span + 2) as ref u8
                            }
                        }
                    }
                }
            }
        }
        i++
    }
    return {found: false, filename: c"", line: 0, col: 0, span: 0, message: message}
}

fn number_width(value: i64) i64 = trust {
    val buf: ref u8 = @alloc(32) as ref u8
    @snprintf(buf, 32, "{lld}", {value})
    val width: i64 = cstr.len(buf)
    @free(buf)
    return width
}

fn label_color(label: ref u8) terminal.Color = {
    if cstr.eql(label, LABEL) {
        return terminal.Color.BrightRed
    }
    if cstr.eql(label, INFO_LABEL) {
        return terminal.Color.Cyan
    }
    return terminal.Color.Amber
}

fn caret_color(label: ref u8) terminal.Color = {
    if cstr.eql(label, LABEL) {
        return terminal.Color.Red
    }
    if cstr.eql(label, INFO_LABEL) {
        return terminal.Color.Cyan
    }
    return terminal.Color.Amber
}

fn print_label(label: ref u8) void = trust {
    terminal.print(str.from_cstr(label), label_color(label))
}

fn write_error_label_fwrite(to_stderr: bool) void = trust {
    val enabled: bool = terminal.is_enabled()
    if to_stderr {
        if enabled {
            stdio.eprintv(terminal.fg(terminal.Color.BrightRed))
        }
        stdio.eprintv(str.from_cstr(LABEL))
        if enabled {
            stdio.eprintv(terminal.reset())
        }
    } else {
        if enabled {
            stdio.printv(terminal.fg(terminal.Color.BrightRed))
        }
        stdio.printv(str.from_cstr(LABEL))
        if enabled {
            stdio.printv(terminal.reset())
        }
    }
}

fn write_warning_label_fwrite(to_stderr: bool) void = trust {
    val enabled: bool = terminal.is_enabled()
    if to_stderr {
        if enabled {
            stdio.eprintv(terminal.fg(terminal.Color.BrightRed))
        }
        stdio.eprintv(str.from_cstr(WARNING_LABEL))
        if enabled {
            stdio.eprintv(terminal.reset())
        }
    } else {
        if enabled {
            stdio.printv(terminal.fg(terminal.Color.BrightRed))
        }
        stdio.printv(str.from_cstr(WARNING_LABEL))
        if enabled {
            stdio.printv(terminal.reset())
        }
    }
}

pub fn info_label() void = {
    terminal.print(str.from_cstr(INFO_LABEL), terminal.Color.Cyan)
}

pub fn error_label() void = {
    terminal.print(str.from_cstr(LABEL), terminal.Color.BrightRed)
}

pub fn warning_label() void = {
    terminal.print(str.from_cstr(WARNING_LABEL), terminal.Color.Amber)
}

pub fn eprint_error_label() void = {
    terminal.eprint(str.from_cstr(LABEL), terminal.Color.BrightRed)
}

pub fn eprint_warning_label() void = {
    terminal.eprint(str.from_cstr(WARNING_LABEL), terminal.Color.Amber)
}

pub fn puts_error_label() void = {
    trust write_error_label_fwrite(false)
}

pub fn eputs_error_label() void = {
    trust write_error_label_fwrite(true)
}

pub fn puts_warning_label() void = {
    trust write_warning_label_fwrite(false)
}

pub fn eputs_warning_label() void = {
    trust write_warning_label_fwrite(true)
}

fn spaces(count: i64) void = trust {
    if count <= 0 {
        return
    }
    val buf: mut ref u8 = @alloc((count + 1) as usize) as ref u8
    if buf == none {
        return
    }
    @memset(buf, 32, count as usize)
    @store8(@ptradd(buf, count), 0)
    stdio.print("{s}", {buf})
    @free(buf)
}

fn diag_path_is_absolute(p: ref u8) bool = trust {
    if p == none {
        return false
    }
    val n: i64 = cstr.len(p)
    if n == 0 {
        return false
    }
    val c0: u8 = @load8(p)
    if c0 == 47 || c0 == 92 {
        return true
    }
    when windows {
        if n >= 3 && @load8(@ptradd(p, 1)) == 58 {
            val c2: u8 = @load8(@ptradd(p, 2))
            if c2 == 47 || c2 == 92 {
                return true
            }
        }
    }
    return false
}

fn report_at(
    filename: ref u8,
    line: i64,
    col: i64,
    span: i64,
    label: ref u8,
    message: ref u8
) void = trust {
    val width: i64 = number_width(line)
    val requested_col: i64 = col
    val requested_span: i64 = span
    val content_opt: mut option[ref u8] = fs.read_all_heap_cstr(filename)
    if content_opt is none {
        if filename != none && cstr.len(filename) > 0
        && !diag_path_is_absolute(filename) {
            match allocators.Arena.new(2048 as usize) {
                ok arena => {
                    val exe: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
                    if cstr.cmp(exe, c".") != 0 {
                        val exe_dir: ref u8 = path.dir_cstr(exe)
                        val candidate: ref u8 = path.join_cstr(exe_dir, filename)
                        content_opt = fs.read_all_heap_cstr(candidate)
                        @free(candidate as ref void)
                        @free(exe_dir as ref void)
                    }
                    allocators.Arena.free(arena)
                }
                err _ => {}
            }
        }
    }
    if content_opt is none {
        if filename != none {
            val known: ref u8 = lookup_source_path(filename)
            if known != none {
                content_opt = fs.read_all_heap_cstr(known)
            }
        }
    }
    if content_opt is some content {
        val start: mut i64 = 0
        val current: mut i64 = 1
        val pos: mut i64 = 0
        for {
            if current >= line {
                break
            }
            val c: i64 = @load8(@ptradd(content, pos)) as i64
            if c == 0 {
                break
            }
            if c == 10 {
                current++
                start = pos + 1
            }
            pos++
        }

        if current == line {
            val end: mut i64 = start
            for {
                val c: i64 = @load8(@ptradd(content, end)) as i64
                if c == 0 || c == 10 || c == 13 {
                    break
                }
                end++
            }

            val actual_col: mut i64 = requested_col
            if actual_col <= 0 {
                actual_col = 1
                for {
                    if start + actual_col - 1 >= end {
                        break
                    }
                    val c: i64 = @load8(@ptradd(content, start + actual_col - 1)) as i64
                    if c != 32 && c != 9 {
                        break
                    }
                    actual_col++
                }
            }

            val caret_start: i64 = start + actual_col - 1
            val caret_len: mut i64 = requested_span
            if caret_len <= 0 {
                if requested_col <= 0 {
                    caret_len = end - caret_start
                } else {
                    caret_len = 0
                    val scan: mut i64 = caret_start
                    for {
                        if scan >= end {
                            break
                        }
                        val c: i64 = @load8(@ptradd(content, scan)) as i64
                        if c == 32 || c == 9 {
                            break
                        }
                        caret_len++
                        scan++
                    }
                }
            }
            val available: i64 = end - caret_start
            if available <= 0 {
                caret_len = 1
            } elif caret_len > available {
                caret_len = available
            } elif caret_len <= 0 {
                caret_len = 1
            }

            print_label(label)
            stdio.print(" {s}\n", {message})
            stdio.print(" --> {s}:{lld}:{lld}\n", {filename, line, actual_col})
            spaces(width)
            stdio.print(" |\n", {})
            stdio.print("{lld} | ", {line})
            val excerpt_len: i64 = end - start
            val excerpt: mut ref u8 = @alloc((excerpt_len + 1) as usize) as ref u8
            if excerpt != none {
                if excerpt_len > 0 {
                    @memcpy(excerpt, @ptradd(content, start), excerpt_len as usize)
                }
                @store8(@ptradd(excerpt, excerpt_len), 0)
                stdio.print("{s}", {excerpt})
                @free(excerpt)
            }
            stdio.print("\n", {})
            spaces(width)
            stdio.print(" | ", {})
            val caret_prefix_raw: i64 = caret_start - start
            val caret_prefix_len: mut i64 = caret_prefix_raw
            if caret_prefix_len < 0 {
                caret_prefix_len = 0
            }
            val line_len: i64 = end - start
            if caret_prefix_len > line_len {
                caret_prefix_len = line_len
            }
            val caret_prefix: mut ref u8 = @alloc((caret_prefix_len + 1) as usize) as ref u8
            if caret_prefix != none {
                val prefix_i: mut i64 = 0
                for {
                    if prefix_i >= caret_prefix_len {
                        break
                    }
                    val prefix_c: i64 = @load8(@ptradd(content, start + prefix_i)) as i64
                    if prefix_c == 9 {
                        @store8(@ptradd(caret_prefix, prefix_i), 9 as u8)
                    } else {
                        @store8(@ptradd(caret_prefix, prefix_i), 32 as u8)
                    }
                    prefix_i++
                }
                @store8(@ptradd(caret_prefix, caret_prefix_len), 0)
                stdio.print("{s}", {caret_prefix})
                @free(caret_prefix)
            }
            terminal.print_repeat(str.from_cstr(c"^"), caret_len, caret_color(label))
            stdio.print("\n", {})
            @free(content)
            return
        }
        @free(content)
    }

    val fallback_col: i64 = requested_col
    val shown_col: mut i64 = fallback_col
    if shown_col <= 0 {
        shown_col = 1
    }
    print_label(label)
    stdio.print(" {s}\n", {message})
    stdio.print(" --> {s}:{lld}:{lld}\n", {filename, line, shown_col})
}

/// Report a diagnostic. Strings of the form `file:line[:col[:span]]: message`
/// are rendered with an excerpt; everything else is printed as a plain message.
pub fn error(message: ref u8) void = trust {
    val location: mut SourceLocation = locate(message)
    if location.found {
        report_at(
            location.filename,
            location.line,
            location.col,
            location.span,
            LABEL,
            location.message
        )
        if location.filename != none && cstr.len(location.filename) > 0 {
            @free(location.filename)
        }
    } else {
        print_label(LABEL)
        stdio.print(" {s}\n", {message})
    }
}

pub fn warning(message: ref u8) void = trust {
    val location: mut SourceLocation = locate(message)
    if location.found {
        report_at(
            location.filename,
            location.line,
            location.col,
            location.span,
            WARNING_LABEL,
            location.message
        )
        if location.filename != none && cstr.len(location.filename) > 0 {
            @free(location.filename)
        }
    } else {
        print_label(WARNING_LABEL)
        stdio.print(" {s}\n", {message})
    }
}

pub fn error_at(
    filename: ref u8,
    line: i64,
    col: i64,
    message: ref u8
) void = trust {
    report_at(filename, line, col, 0, LABEL, message)
}

pub fn warning_at(
    filename: ref u8,
    line: i64,
    col: i64,
    message: ref u8
) void = trust {
    report_at(filename, line, col, 0, WARNING_LABEL, message)
}

pub fn error_at_span(
    filename: ref u8,
    line: i64,
    col: i64,
    span: i64,
    message: ref u8
) void = trust {
    report_at(filename, line, col, span, LABEL, message)
}

pub fn warning_at_span(
    filename: ref u8,
    line: i64,
    col: i64,
    span: i64,
    message: ref u8
) void = trust {
    report_at(filename, line, col, span, WARNING_LABEL, message)
}

pub fn note_at_span(
    filename: ref u8,
    line: i64,
    col: i64,
    span: i64,
    message: ref u8
) void = trust {
    report_at(filename, line, col, span, INFO_LABEL, message)
}
