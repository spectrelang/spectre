/// Cross-platform library discovery for the `lib "name"` directive.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str        = use("std/string")
val cstr       = use("std/string/cstr")
val ostr       = use("std/string/owned")
val mem        = use("mem.sx")
val os         = use("std/os")
val path       = use("std/path")
val allocators = use("std/allocators")

/// Link flags and discovered paths are retained for the compiler process
/// lifetime, so their owning ZString allocations are intentionally not freed
/// per call.
fn cstr_heap() allocators.HeapAllocator = {
    return @zeroed
}

fn is_trim_char(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn trim_raw(s: str.StringView) str.StringView = trust {
    val start: mut i64 = 0
    for {
        if start >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, start)) as u8
        if !is_trim_char(c) {
            break
        }
        start++
    }
    val end: mut i64 = s.len
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, end - 1)) as u8
        if !is_trim_char(c) {
            break
        }
        end--
    }
    return str.slice(s, start, end)
}

fn split_flags(s: str.StringView) list[ref u8] = trust {
    val out: mut list[ref u8] = mem.new[ref u8]()
    val i: mut i64 = 0
    for {
        if i >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, i)) as u8
        if is_trim_char(c) {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= s.len {
                break
            }
            val c2: u8 = @load8(@ptradd(s.ptr, i)) as u8
            if is_trim_char(c2) {
                break
            }
            i++
        }
        @append(
            out,
            str.zstr_ptr(str.zstr_from[allocators.HeapAllocator](
                    cstr_heap(),
                    str.slice(s, start, i)
                ))
        )
    }
    return out
}

fn split_path_list(raw: str.StringView, out: mut list[ref u8]) void = trust {
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        val at_end: bool = i == raw.len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(raw.ptr, i)) as u8
        }
        if at_end || c == 58 || c == 59 {
            if i > start {
                @append(
                    out,
                    str.zstr_ptr(str.zstr_from[allocators.HeapAllocator](
                            cstr_heap(),
                            str.slice(raw, start, i)
                        ))
                )
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i++
    }
}

fn library_basename(name: str.StringView) str.StringView = trust {
    val n0: mut str.StringView = name
    if n0.len > 2 && str.starts_with(n0, "-l") {
        n0 = str.slice(n0, 2, n0.len)
    }

    val n1: mut str.StringView = n0
    if n1.len > 3 && str.starts_with(n1, "lib") {
        n1 = str.slice(n1, 3, n1.len)
    }

    if n1.len > 3 && str.ends_with(n1, ".so") {
        return str.slice(n1, 0, n1.len - 3)
    }
    if n1.len > 6 && str.ends_with(n1, ".dylib") {
        return str.slice(n1, 0, n1.len - 6)
    }
    if n1.len > 2 && str.ends_with(n1, ".a") {
        return str.slice(n1, 0, n1.len - 2)
    }
    return n1
}

fn pkg_config_libs(module_name: str.StringView, static_link: bool) option[list[ref u8]] = trust {
    val static_arg: mut str.StringView = ""
    if static_link {
        static_arg = c" --static"
    }
    val cmd: ref u8 = @fmtalloc(
        "pkg-config --exists {s} && pkg-config --libs{s} {s} 2>/dev/null",
        {module_name, static_arg, module_name}
    )
    val res = os.exec(cmd)
    match res {
        ok out => {
            val text: str.StringView = trim_raw(str.view(out.ptr, ostr.len(out)))
            if text.len == 0 {
                ostr.free(out)
                return none
            }
            val flags: list[ref u8] = split_flags(text)
            ostr.free(out)
            return some flags
        }
        err _ => {
            return none
        }
    }
}

fn try_pkg_config(name: str.StringView, static_link: bool) option[list[ref u8]] = trust {
    val direct = pkg_config_libs(name, static_link)
    if direct is some flags {
        return some flags
    }

    val base: str.StringView = library_basename(name)
    if !str.eql(base, name) {
        val base_flags = pkg_config_libs(base, static_link)
        if base_flags is some bf {
            return some bf
        }
    } else {
        val prefixed: ref u8 = @fmtalloc("lib{s}", {name})
        val prefixed_flags = pkg_config_libs(str.from_cstr(prefixed), static_link)
        if prefixed_flags is some pf {
            return some pf
        }
    }
    return none
}

fn compiler_library_path(base: str.StringView, suffix: str.StringView) ref u8 = trust {
    val compilers: list[ref u8] = mem.from2[ref u8](c"cc", c"clang")
    val missing: ref u8 = @fmtalloc("lib{s}{s}", {base, suffix})
    for compiler in compilers {
        if os.in_path(compiler) {
            val cmd: ref u8 = @fmtalloc(
                "{s} -print-file-name=lib{s}{s} 2>/dev/null",
                {compiler, base, suffix}
            )
            val res = os.exec(cmd)
            match res {
                ok out => {
                    val found: str.StringView = trim_raw(str.view(out.ptr, ostr.len(out)))
                    if found.len > 0 && !str.eql_cstr(found, missing) {
                        val copied: ref u8 = str.zstr_ptr(str.zstr_from[allocators.HeapAllocator](
                                cstr_heap(),
                                found
                            ))
                        ostr.free(out)
                        return copied
                    }
                    ostr.free(out)
                }
                err _ => {}
            }
        }
    }
    return c""
}

fn library_suffixes(platform: str.StringView) list[ref u8] = trust {
    if str.eql_cstr(platform, c"windows") {
        val suffixes: list[ref u8] = mem.from3[ref u8](c".lib", c".dll.a", c".a")
        return suffixes
    }
    if str.eql_cstr(platform, c"darwin") {
        val suffixes: list[ref u8] = mem.from2[ref u8](c".dylib", c".a")
        return suffixes
    }
    val suffixes: list[ref u8] = mem.from2[ref u8](c".so", c".a")
    return suffixes
}

fn native_search_dirs(platform: str.StringView) list[ref u8] = trust {
    val dirs: mut list[ref u8] = mem.new[ref u8]()

    val library_path = os.getenv(c"LIBRARY_PATH")
    if library_path is some lib_path {
        split_path_list(str.from_cstr(lib_path as ref u8), dirs)
    }

    @append(dirs, c"/usr/local/lib")
    @append(dirs, c"/usr/lib")
    @append(dirs, c"/usr/lib64")
    @append(dirs, c"/lib")
    @append(dirs, c"/lib64")

    if str.eql_cstr(platform, c"linux") {
        @append(dirs, c"/usr/lib/x86_64-linux-gnu")
        @append(dirs, c"/lib/x86_64-linux-gnu")
        @append(dirs, c"/usr/lib/aarch64-linux-gnu")
        @append(dirs, c"/lib/aarch64-linux-gnu")
        @append(dirs, c"/usr/lib/arm-linux-gnueabihf")
        @append(dirs, c"/usr/lib/i386-linux-gnu")
        @append(dirs, c"/usr/lib/riscv64-linux-gnu")
        @append(dirs, c"/usr/lib/powerpc64le-linux-gnu")
    }

    if str.eql_cstr(platform, c"darwin") {
        @append(dirs, c"/opt/homebrew/lib")
        @append(dirs, c"/opt/local/lib")
    }

    return dirs
}

fn find_native(base: str.StringView, platform: str.StringView) ref u8 = trust {
    val suffixes: list[ref u8] = library_suffixes(platform)
    for suffix in suffixes {
        val compiler_path: ref u8 = compiler_library_path(base, str.from_cstr(suffix))
        if cstr.len(compiler_path) > 0 {
            return path.dir_cstr(compiler_path)
        }
    }

    val dirs: list[ref u8] = native_search_dirs(platform)
    for dir in dirs {
        for suffix in suffixes {
            val candidate: ref u8 = @fmtalloc("{s}/lib{s}{s}", {dir, base, suffix})
            if os.exists(candidate) {
                return dir
            }
        }
    }
    return c""
}

fn requires_pkg_config(platform: str.StringView) bool = trust {
    if str.eql_cstr(platform, c"linux") {
        return false
    }
    if str.eql_cstr(platform, c"freebsd") {
        return false
    }
    if str.eql_cstr(platform, c"openbsd") {
        return false
    }
    if str.eql_cstr(platform, c"netbsd") {
        return false
    }
    if str.eql_cstr(platform, c"dragonflybsd") {
        return false
    }
    return true
}

/// Resolve a library name to linker flags for the current platform.
pub fn resolve(
    name: str.StringView,
    platform: str.StringView,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val trimmed: str.StringView = trim_raw(name)
    if trimmed.len == 0 {
        return err c"library name cannot be empty"
    }

    val has_pkg_config: bool = os.in_path(c"pkg-config")
    if has_pkg_config {
        val pkg_flags = try_pkg_config(trimmed, static_link)
        if pkg_flags is some flags {
            return ok flags
        }
    }

    val base: str.StringView = library_basename(trimmed)
    val dir: ref u8 = find_native(base, platform)
    if cstr.len(dir) > 0 {
        val flags: mut list[ref u8] = mem.new[ref u8]()
        @append(flags, @fmtalloc("-L{s}", {dir}))
        @append(flags, @fmtalloc("-l{s}", {base}))
        return ok flags
    }

    if requires_pkg_config(platform) {
        if !has_pkg_config {
            return err c"lib syntax for linking is not supported on this platform. install pkg-config to resolve."
        }
        return err @fmtalloc("could not resolve library '{s}' with pkg-config", {trimmed})
    }

    return err @fmtalloc("could not find library '{s}' on this system", {trimmed})
}
