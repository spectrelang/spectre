/// Cross-platform library discovery for the `lib "name"` directive.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val string     = use("std/string")
val mem        = use("mem.sx")
val os         = use("std/os")
val path       = use("std/path")
val allocators = use("std/allocators")

/// Link flags and discovered paths are retained for the compiler process
/// lifetime, so their owning CString allocations are intentionally not freed
/// per call.
fn cstr_heap() allocators.HeapAllocator = {
    return @zeroed
}

fn is_trim_char(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn trim_raw(s: string.StringView) string.StringView = trust {
    val start: mut i64 = 0
    for {
        if start >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, start)) as u8
        if !is_trim_char(c) {
            break
        }
        start++
    }
    val end: mut i64 = s.len
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, end - 1)) as u8
        if !is_trim_char(c) {
            break
        }
        end--
    }
    return string.view_slice(s, start, end)
}

fn split_flags(s: string.StringView) list[ref u8] = trust {
    val out: mut list[ref u8] = mem.new[ref u8]()
    val i: mut i64 = 0
    for {
        if i >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, i)) as u8
        if is_trim_char(c) {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= s.len {
                break
            }
            val c2: u8 = @load8(@ptradd(s.ptr, i)) as u8
            if is_trim_char(c2) {
                break
            }
            i++
        }
        @append(
            out,
            string.cstring_ptr(string.cstring_from_view[allocators.HeapAllocator](
                    cstr_heap(),
                    string.view_slice(s, start, i)
                ))
        )
    }
    return out
}

fn split_path_list(raw: string.StringView, out: mut list[ref u8]) void = trust {
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        val at_end: bool = i == raw.len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(raw.ptr, i)) as u8
        }
        if at_end || c == 58 || c == 59 {
            if i > start {
                @append(
                    out,
                    string.cstring_ptr(string.cstring_from_view[allocators.HeapAllocator](
                            cstr_heap(),
                            string.view_slice(raw, start, i)
                        ))
                )
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i++
    }
}

fn library_basename(name: string.StringView) string.StringView = trust {
    val n0: mut string.StringView = name
    if n0.len > 2 && string.view_starts_with(n0, string.view_cstr("-l")) {
        n0 = string.view_slice(n0, 2, n0.len)
    }

    val n1: mut string.StringView = n0
    if n1.len > 3 && string.view_starts_with(n1, string.view_cstr("lib")) {
        n1 = string.view_slice(n1, 3, n1.len)
    }

    if n1.len > 3 && string.view_ends_with(n1, string.view_cstr(".so")) {
        return string.view_slice(n1, 0, n1.len - 3)
    }
    if n1.len > 6 && string.view_ends_with(n1, string.view_cstr(".dylib")) {
        return string.view_slice(n1, 0, n1.len - 6)
    }
    if n1.len > 2 && string.view_ends_with(n1, string.view_cstr(".a")) {
        return string.view_slice(n1, 0, n1.len - 2)
    }
    return n1
}

fn pkg_config_libs(module_name: string.StringView, static_link: bool) option[list[ref u8]] = trust {
    val static_arg: mut string.StringView = string.view_cstr("")
    if static_link {
        static_arg = string.view_cstr(" --static")
    }
    val cmd: ref u8 = @fmtalloc(
        "pkg-config --exists {s} && pkg-config --libs{s} {s} 2>/dev/null",
        {module_name, static_arg, module_name}
    )
    val res = os.exec(cmd)
    match res {
        ok out => {
            val text: string.StringView = trim_raw(string.view(out.ptr, string.len(out)))
            if text.len == 0 {
                string.string_free(out)
                return none
            }
            val flags: list[ref u8] = split_flags(text)
            string.string_free(out)
            return some flags
        }
        err _ => {
            return none
        }
    }
}

fn try_pkg_config(name: string.StringView, static_link: bool) option[list[ref u8]] = trust {
    val direct = pkg_config_libs(name, static_link)
    if direct is some flags {
        return some flags
    }

    val base: string.StringView = library_basename(name)
    if !string.view_eql(base, name) {
        val base_flags = pkg_config_libs(base, static_link)
        if base_flags is some bf {
            return some bf
        }
    } else {
        val prefixed: ref u8 = @fmtalloc("lib{s}", {name})
        val prefixed_flags = pkg_config_libs(string.view_cstr(prefixed), static_link)
        if prefixed_flags is some pf {
            return some pf
        }
    }
    return none
}

fn compiler_library_path(base: string.StringView, suffix: string.StringView) ref u8 = trust {
    val compilers: list[ref u8] = mem.from2[ref u8]("cc", "clang")
    val missing: ref u8 = @fmtalloc("lib{s}{s}", {base, suffix})
    for compiler in compilers {
        if os.in_path(compiler) {
            val cmd: ref u8 = @fmtalloc(
                "{s} -print-file-name=lib{s}{s} 2>/dev/null",
                {compiler, base, suffix}
            )
            val res = os.exec(cmd)
            match res {
                ok out => {
                    val found: string.StringView = trim_raw(string.view(out.ptr, string.len(out)))
                    if found.len > 0 && !string.view_eql_cstr(found, missing) {
                        val copied: ref u8 = string.cstring_ptr(string.cstring_from_view[allocators.HeapAllocator](
                                cstr_heap(),
                                found
                            ))
                        string.string_free(out)
                        return copied
                    }
                    string.string_free(out)
                }
                err _ => {}
            }
        }
    }
    return ""
}

fn library_suffixes(platform: string.StringView) list[ref u8] = trust {
    if string.view_eql_cstr(platform, "windows") {
        val suffixes: list[ref u8] = mem.from3[ref u8](".lib", ".dll.a", ".a")
        return suffixes
    }
    if string.view_eql_cstr(platform, "darwin") {
        val suffixes: list[ref u8] = mem.from2[ref u8](".dylib", ".a")
        return suffixes
    }
    val suffixes: list[ref u8] = mem.from2[ref u8](".so", ".a")
    return suffixes
}

fn native_search_dirs(platform: string.StringView) list[ref u8] = trust {
    val dirs: mut list[ref u8] = mem.new[ref u8]()

    val library_path = os.getenv("LIBRARY_PATH")
    if library_path is some lib_path {
        split_path_list(string.view_cstr(lib_path as ref u8), dirs)
    }

    @append(dirs, "/usr/local/lib")
    @append(dirs, "/usr/lib")
    @append(dirs, "/usr/lib64")
    @append(dirs, "/lib")
    @append(dirs, "/lib64")

    if string.view_eql_cstr(platform, "linux") {
        @append(dirs, "/usr/lib/x86_64-linux-gnu")
        @append(dirs, "/lib/x86_64-linux-gnu")
        @append(dirs, "/usr/lib/aarch64-linux-gnu")
        @append(dirs, "/lib/aarch64-linux-gnu")
        @append(dirs, "/usr/lib/arm-linux-gnueabihf")
        @append(dirs, "/usr/lib/i386-linux-gnu")
        @append(dirs, "/usr/lib/riscv64-linux-gnu")
        @append(dirs, "/usr/lib/powerpc64le-linux-gnu")
    }

    if string.view_eql_cstr(platform, "darwin") {
        @append(dirs, "/opt/homebrew/lib")
        @append(dirs, "/opt/local/lib")
    }

    return dirs
}

fn find_native(base: string.StringView, platform: string.StringView) ref u8 = trust {
    val suffixes: list[ref u8] = library_suffixes(platform)
    for suffix in suffixes {
        val compiler_path: ref u8 = compiler_library_path(base, string.view_cstr(suffix))
        if string.len_raw(compiler_path) > 0 {
            return path.dir(compiler_path)
        }
    }

    val dirs: list[ref u8] = native_search_dirs(platform)
    for dir in dirs {
        for suffix in suffixes {
            val candidate: ref u8 = @fmtalloc("{s}/lib{s}{s}", {dir, base, suffix})
            if os.exists(candidate) {
                return dir
            }
        }
    }
    return ""
}

fn requires_pkg_config(platform: string.StringView) bool = trust {
    if string.view_eql_cstr(platform, "linux") {
        return false
    }
    if string.view_eql_cstr(platform, "freebsd") {
        return false
    }
    if string.view_eql_cstr(platform, "openbsd") {
        return false
    }
    if string.view_eql_cstr(platform, "netbsd") {
        return false
    }
    if string.view_eql_cstr(platform, "dragonflybsd") {
        return false
    }
    return true
}

/// Resolve a library name to linker flags for the current platform.
pub fn resolve(
    name: string.StringView,
    platform: string.StringView,
    static_link: bool
) result[list[ref u8], ref u8] = trust {
    val trimmed: string.StringView = trim_raw(name)
    if trimmed.len == 0 {
        return err "library name cannot be empty"
    }

    val has_pkg_config: bool = os.in_path("pkg-config")
    if has_pkg_config {
        val pkg_flags = try_pkg_config(trimmed, static_link)
        if pkg_flags is some flags {
            return ok flags
        }
    }

    val base: string.StringView = library_basename(trimmed)
    val dir: ref u8 = find_native(base, platform)
    if string.len_raw(dir) > 0 {
        val flags: mut list[ref u8] = mem.new[ref u8]()
        @append(flags, @fmtalloc("-L{s}", {dir}))
        @append(flags, @fmtalloc("-l{s}", {base}))
        return ok flags
    }

    if requires_pkg_config(platform) {
        if !has_pkg_config {
            return err "lib syntax for linking is not supported on this platform. install pkg-config to resolve."
        }
        return err @fmtalloc("could not resolve library '{s}' with pkg-config", {trimmed})
    }

    return err @fmtalloc("could not find library '{s}' on this system", {trimmed})
}
