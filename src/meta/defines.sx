/// Compile-time environment definitions supplied with -d or sx.mod env blocks.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str = use("std/string")

pub type Define = {
    name: mut str.StringView
    value: mut str.StringView
    next: mut ref Define
}

pub type EnvAlias = {
    name: mut str.StringView
    next: mut ref EnvAlias
}

val defs: mut ref Define = none
val env_aliases: mut ref EnvAlias = none

/// Return true when a resolved module path is the standard or compiler-local
/// environment module.
pub fn is_env_module_path(module_path: str.StringView) bool = trust {
    if str.view_ends_with(module_path, str.view_cstr("/spectrelib/env/core.sx")) {
        return true
    }
    if str.view_ends_with(module_path, str.view_cstr("/src/meta/env.sx")) {
        return true
    }
    return false
}

/// Register an import alias that refers to the environment module.
pub fn register_env_alias(name: str.StringView) void = trust {
    val cur: mut ref EnvAlias = env_aliases
    for {
        if cur == none {
            break
        }
        if str.view_eql(cur.name, name) {
            return
        }
        cur = cur.next
    }
    val alias: mut ref EnvAlias = @alloc(@sizeof(EnvAlias)) as ref EnvAlias
    alias.name = name
    alias.next = env_aliases
    env_aliases = alias
}

/// Return true when an identifier is an import alias for the environment module.
pub fn is_env_alias(name: str.StringView) bool = {
    val cur: mut ref EnvAlias = env_aliases
    for {
        if cur == none {
            break
        }
        if trust str.view_eql(cur.name, name) {
            return true
        }
        cur = cur.next
    }
    return false
}

pub fn set(name: str.StringView, value: str.StringView) void = trust {
    val cur: mut ref Define = defs
    for {
        if cur == none {
            break
        }
        if str.view_eql(cur.name, name) {
            cur.value = value
            return
        }
        cur = cur.next
    }
    val d: mut ref Define = @alloc(@sizeof(Define)) as ref Define
    d.name = name
    d.value = value
    d.next = defs
    defs = d
}

pub fn get(name: str.StringView) option[str.StringView] = {
    val cur: mut ref Define = defs
    for {
        if cur == none {
            break
        }
        if trust str.view_eql(cur.name, name) {
            return some cur.value
        }
        cur = cur.next
    }
    return none
}

/// Return true when a compile-time definition with the given name exists.
pub fn has(name: str.StringView) bool = {
    val cur: mut ref Define = defs
    for {
        if cur == none {
            break
        }
        if trust str.view_eql(cur.name, name) {
            return true
        }
        cur = cur.next
    }
    return false
}

/// Parse a NAME=VALUE definition and add it to the compile-time environment.
pub fn add_spec(definition: str.StringView) bool = trust {
    val len: i64 = definition.len
    val eq: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(definition.ptr, i)) as u8
        if c == 61 {
            eq = i
            break
        }
        i++
    }
    if eq <= 0 {
        return false
    }
    val name: ref u8 = str.substr(definition.ptr, 0, eq)
    val value: ref u8 = str.substr(definition.ptr, eq + 1, len - eq - 1)
    set(str.view_cstr(name), str.view_cstr(value))
    return true
}

/// Raw-pointer compatibility wrapper for add_spec.
pub fn add_spec_raw(definition: ref u8) bool = trust {
    return add_spec(str.view_cstr(definition))
}
