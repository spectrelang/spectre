/// Compile-time environment definitions supplied with -d or sx.mod env blocks.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str        = use("std/string")
val allocators = use("std/allocators")

fn cstr_heap() allocators.HeapAllocator = {
    return @zeroed
}

pub type Define = {
    name: mut ref u8
    value: mut ref u8
    next: mut ref Define
}

pub type EnvAlias = {
    name: mut ref u8
    next: mut ref EnvAlias
}

val defs: mut ref Define = none
val env_aliases: mut ref EnvAlias = none

/// Duplicate a view into an owned NUL-terminated C string.
fn dup_cstr(value: str.StringView) ref u8 = trust {
    val cs: str.CString = str.cstring_from[allocators.HeapAllocator](cstr_heap(), value)
    return str.cstring_ptr(cs)
}

fn free_cstr(value: ref u8) void = trust {
    if value != none {
        allocators.HeapAllocator.free(cstr_heap(), value as ref void)
    }
}

/// Return true when a resolved module path is the standard or compiler-local
/// environment module.
pub fn is_env_module_path(module_path: str.StringView) bool = trust {
    if str.view_ends_with(module_path, "/spectrelib/env/core.sx") {
        return true
    }
    if str.view_ends_with(module_path, "/src/meta/env.sx") {
        return true
    }
    return false
}

/// Register an import alias that refers to the environment module.
pub fn register_env_alias(name: str.StringView) void = trust {
    val cur: mut ref EnvAlias = env_aliases
    for {
        if cur == none {
            break
        }
        if str.view_eql(str.view_cstr(cur.name), name) {
            return
        }
        cur = cur.next
    }
    val alias: mut ref EnvAlias = @alloc(@sizeof(EnvAlias)) as ref EnvAlias
    alias.name = dup_cstr(name)
    alias.next = env_aliases
    env_aliases = alias
}

/// Return true when an identifier is an import alias for the environment module.
pub fn is_env_alias(name: str.StringView) bool = {
    val cur: mut ref EnvAlias = env_aliases
    for {
        if cur == none {
            break
        }
        if trust str.view_eql(str.view_cstr(cur.name), name) {
            return true
        }
        cur = cur.next
    }
    return false
}

pub fn set(name: str.StringView, value: str.StringView) void = trust {
    val cur: mut ref Define = defs
    for {
        if cur == none {
            break
        }
        if str.view_eql(str.view_cstr(cur.name), name) {
            free_cstr(cur.value)
            cur.value = dup_cstr(value)
            return
        }
        cur = cur.next
    }
    val d: mut ref Define = @alloc(@sizeof(Define)) as ref Define
    d.name = dup_cstr(name)
    d.value = dup_cstr(value)
    d.next = defs
    defs = d
}

/// Look up a compile-time definition. A null view means "not set".
pub fn get(name: str.StringView) str.StringView = {
    val cur: mut ref Define = defs
    for {
        if cur == none {
            break
        }
        if trust str.view_eql(str.view_cstr(cur.name), name) {
            return str.view_cstr(cur.value)
        }
        cur = cur.next
    }
    return str.view(none, 0)
}

/// Return true when a compile-time definition with the given name exists.
pub fn has(name: str.StringView) bool = {
    return get(name).ptr != none
}

/// Parse a NAME=VALUE definition and add it to the compile-time environment.
pub fn add_spec(definition: str.StringView) bool = trust {
    val len: i64 = definition.len
    val eq: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(definition.ptr, i)) as u8
        if c == 61 {
            eq = i
            break
        }
        i++
    }
    if eq <= 0 {
        return false
    }
    set(
        str.view_slice(definition, 0, eq),
        str.view_slice(definition, eq + 1, len)
    )
    return true
}
