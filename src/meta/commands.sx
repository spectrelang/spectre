val str        = use("std/string")
val cstr       = use("std/string/cstr")
val ostr       = use("std/string/owned")
val builder    = use("std/string/builder")
val mem        = use("mem.sx")
val fs         = use("std/fs")
val path       = use("std/path")
val time       = use("std/time")
val allocators = use("std/allocators")
val reflection = use("std/reflection")
val meta       = use("meta.sx")
val builds     = use("builds.sx")
val stdio      = use("std/stdio")
val os         = use("std/os")

pub type SxBuildRule = {
    platform: mut ref u8
    arch: mut ref u8
    action: mut ref u8
    flags: mut ref u8
    output: mut ref u8
    entry: mut ref u8
    envs: mut list[ref u8]
}

pub type SxBuildConfig = {
    name: mut ref u8
    base: mut ref SxBuildRule
    rules: mut list[ref SxBuildRule]
}

pub type SxMod = {
    entry: mut ref u8
    version: mut ref u8
    spectre_version: mut ref u8
    single_flags: mut ref u8
    deps: mut list[ref u8]
    builds: mut list[ref SxBuildConfig]
}

type SxLockDep = {
    url: mut ref u8
    hash: mut ref u8
}

type ParseCtx = {
    text: mut ref u8
    pos: mut i64
    len: mut i64
}

fn new_ctx(text: ref u8) ref ParseCtx = {
    val ctx: mut ref ParseCtx = @alloc(@sizeof(ParseCtx)) as ref ParseCtx
    ctx.text = text
    ctx.pos = 0
    ctx.len = cstr.len(text)
    return ctx
}

fn mem_dup_cstr(s: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(s)
    val out: ref u8 = mem.alloc((len + 1) as usize) as ref u8
    @memcpy(out, s, (len + 1) as usize)
    return out
}

fn mem_concat2(a: ref u8, b: ref u8) ref u8 = trust {
    val alen: i64 = cstr.len(a)
    val blen: i64 = cstr.len(b)
    val out: ref u8 = mem.alloc((alen + blen + 1) as usize) as ref u8
    @memcpy(out, a, alen as usize)
    @memcpy(@ptradd(out, alen), b, blen as usize)
    @store8(@ptradd(out, alen + blen), 0)
    return out
}

fn mem_concat3(a: ref u8, b: ref u8, c: ref u8) ref u8 = trust {
    return mem_concat2(mem_concat2(a, b), c)
}

fn ctx_peek(ctx: ref ParseCtx) i64 = trust {
    if ctx.pos >= ctx.len {
        return -1
    }
    return @load8(@ptradd(ctx.text, ctx.pos)) as i64
}

fn ctx_advance(ctx: mut ref ParseCtx) void = {
    ctx.pos++
}

fn ctx_skip_line(ctx: mut ref ParseCtx) void = {
    for {
        val c: i64 = trust ctx_peek(ctx)
        if c == -1 {
            break
        }
        ctx_advance(ctx)
        if c == 10 {
            break
        }
    }
}

fn ctx_skip_ws(ctx: mut ref ParseCtx) void = {
    for {
        val c: i64 = trust ctx_peek(ctx)
        if c == -1 {
            break
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            ctx_advance(ctx)
        } elif c == 47 && ctx.pos + 1 < ctx.len {
            val c2: i64 = trust @load8(@ptradd(ctx.text, ctx.pos + 1)) as i64
            if c2 == 47 {
                ctx_skip_line(ctx)
            } else {
                break
            }
        } else {
            break
        }
    }
}

fn ctx_read_quoted(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) != 34 {
        return c""
    }
    ctx_advance(ctx)
    val cap: mut i64 = 256
    val buf: mut ref u8 = @alloc(cap) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 34 {
            break
        }
        if i >= cap - 1 {
            cap = cap * 2
            buf = @realloc(buf, cap) as ref u8
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    if ctx_peek(ctx) == 34 {
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    val result: ref u8 = mem.alloc((i + 1) as usize) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

fn ctx_read_ident(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    val buf: ref u8 = @alloc(256) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 {
            break
        }
        val alpha: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        val digit: bool = c >= 48 && c <= 57
        val special: bool = c == 95 || c == 45 || c == 46 || c == 47
        if !alpha && !digit && !special {
            break
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    if i == 0 {
        @free(buf)
        return c""
    }
    val result: ref u8 = mem.alloc((i + 1) as usize) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

fn ctx_read_env_value(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) == 34 {
        return ctx_read_quoted(ctx)
    }

    val cap: mut i64 = 256
    val buf: mut ref u8 = @alloc(cap) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 32 || c == 9 || c == 10 || c == 13 || c == 125 {
            break
        }
        if i >= cap - 1 {
            cap = cap * 2
            buf = @realloc(buf, cap) as ref u8
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    if i == 0 {
        @free(buf)
        return c""
    }
    val result: ref u8 = mem.alloc((i + 1) as usize) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

pub fn new_build_rule(platform: ref u8, arch: ref u8) ref SxBuildRule = trust {
    val rule: mut ref SxBuildRule = mem.alloc(@sizeof(SxBuildRule) as usize) as mut ref SxBuildRule
    @memset(rule, 0, @sizeof(SxBuildRule))
    rule.platform = platform
    rule.arch = arch
    rule.action = c""
    rule.flags = c""
    rule.output = c""
    rule.entry = c""
    rule.envs = mem.new[ref u8]()
    return rule
}

fn parse_env_entries(ctx: mut ref ParseCtx, out: mut list[ref u8]) void = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) == 123 {
        ctx_advance(ctx)
    }
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val env_name: ref u8 = ctx_read_ident(ctx)
        if cstr.cmp(env_name, c"") == 0 {
            break
        }
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == 61 {
            ctx_advance(ctx)
        }
        val env_value: ref u8 = ctx_read_env_value(ctx)
        @append(out, mem_concat3(env_name, c"=", env_value))
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

/// Parse one of the fields accepted inside a build config or rule block.
/// Returns false when `name` is not a field (for example a platform selector).
fn parse_override_field(
    ctx: mut ref ParseCtx,
    target: mut ref SxBuildRule,
    name: ref u8
) bool = trust {
    if cstr.cmp(name, c"action") == 0 {
        target.action = ctx_read_quoted(ctx)
        return true
    }
    if cstr.cmp(name, c"flags") == 0 {
        target.flags = ctx_read_quoted(ctx)
        return true
    }
    if cstr.cmp(name, c"output") == 0 {
        target.output = ctx_read_quoted(ctx)
        return true
    }
    if cstr.cmp(name, c"entry") == 0 {
        target.entry = ctx_read_quoted(ctx)
        return true
    }
    if cstr.cmp(name, c"env") == 0 {
        parse_env_entries(ctx, target.envs)
        return true
    }
    return false
}

fn parse_rule_fields(ctx: mut ref ParseCtx, rule: mut ref SxBuildRule) void = trust {
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val name: ref u8 = ctx_read_ident(ctx)
        if cstr.cmp(name, c"") == 0 {
            break
        }
        if !parse_override_field(ctx, rule, name) {
            ctx_skip_line(ctx)
        }
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

fn parse_build_body(ctx: mut ref ParseCtx, cfg: mut ref SxBuildConfig) void = trust {
    val base: mut ref SxBuildRule = new_build_rule(c"", c"")
    cfg.base = base
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val name: ref u8 = ctx_read_ident(ctx)
        if cstr.cmp(name, c"") == 0 {
            break
        }
        if parse_override_field(ctx, base, name) {
            continue
        }

        val name_len: i64 = cstr.len(name)
        val dot: mut i64 = -1
        val di: mut i64 = 0
        for di < name_len {
            if @load8(@ptradd(name, di)) == (46 as u8) {
                dot = di
                break
            }
            di = di + (1 as i64)
        }
        val platform: mut ref u8 = name
        val arch: mut ref u8 = c""
        if dot >= 0 {
            val platform_tmp: ref u8 = cstr.substr(name, 0, dot)
            val arch_tmp: ref u8 = cstr.substr(name, dot + 1, name_len - dot - 1)
            platform = mem_dup_cstr(platform_tmp)
            arch = mem_dup_cstr(arch_tmp)
            @free(platform_tmp)
            @free(arch_tmp)
        }
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) != 123 {
            ctx_skip_line(ctx)
            continue
        }
        ctx_advance(ctx)
        val rule: mut ref SxBuildRule = new_build_rule(platform, arch)
        parse_rule_fields(ctx, rule)
        @append(cfg.rules, rule)
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

pub fn parse_sxmod(content: ref u8) ref SxMod = trust {
    val ctx: mut ref ParseCtx = new_ctx(content)
    val m: mut ref SxMod = mem.alloc(@sizeof(SxMod) as usize) as ref SxMod
    @memset(m, 0, @sizeof(SxMod) as usize)
    m.entry = c""
    m.version = c""
    m.spectre_version = c""
    m.single_flags = c""
    m.deps = mem.new[ref u8]()
    m.builds = mem.new[ref SxBuildConfig]()
    for {
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == -1 {
            break
        }
        val kw: ref u8 = ctx_read_ident(ctx)
        if cstr.cmp(kw, c"") == 0 {
            break
        }
        if cstr.cmp(kw, c"entry") == 0 {
            m.entry = ctx_read_quoted(ctx)
        } elif cstr.cmp(kw, c"version") == 0 {
            m.version = ctx_read_quoted(ctx)
        } elif cstr.cmp(kw, c"spectre_version") == 0 {
            m.spectre_version = ctx_read_quoted(ctx)
        } elif cstr.cmp(kw, c"single_flags") == 0 {
            m.single_flags = ctx_read_quoted(ctx)
        } elif cstr.cmp(kw, c"dep") == 0 {
            @append(m.deps, ctx_read_quoted(ctx))
        } elif cstr.cmp(kw, c"build") == 0 {
            val cfg: mut ref SxBuildConfig = mem.alloc(@sizeof(SxBuildConfig) as usize) as mut ref SxBuildConfig
            @memset(cfg, 0, @sizeof(SxBuildConfig))
            cfg.name = ctx_read_ident(ctx)
            cfg.base = none
            cfg.rules = mem.new[ref SxBuildRule]()
            ctx_skip_ws(ctx)
            if ctx_peek(ctx) == 123 {
                ctx_advance(ctx)
            }
            parse_build_body(ctx, cfg)
            @append(m.builds, cfg)
        } else {
            ctx_skip_line(ctx)
        }
    }
    @free(ctx)
    return m
}

fn validate_sxmod(m: ref SxMod) bool = {
    if cstr.cmp(m.entry, c"") == 0 {
        return true
    }
    for cfg in m.builds {
        if cstr.cmp(cfg.base.entry, c"") != 0 {
            stdio.puts("error: sx.mod cannot mix a top-level 'entry' with per-build 'entry' fields")
            return false
        }
        for rule in cfg.rules {
            if cstr.cmp(rule.entry, c"") != 0 {
                stdio.puts("error: sx.mod cannot mix a top-level 'entry' with per-build 'entry' fields")
                return false
            }
        }
    }
    return true
}

fn validate_spectre_version(m: ref SxMod) bool = trust {
    val installed: str.StringView = meta.get_spectre_version()
    if cstr.cmp(m.spectre_version, c"") == 0 {
        stdio.puts("error: sx.mod is missing the required 'spectre_version' field")
        stdio.print("-> installed compiler: {s}\n", {installed})
        stdio.print("-> add this line to sx.mod: spectre_version \"{s}\"\n", {installed})
        return false
    }
    if !str.eql_cstr(installed, m.spectre_version) {
        stdio.puts("error: Spectre version mismatch")
        stdio.print("  installed compiler:      {s}\n", {installed})
        stdio.print("  project spectre_version: {s}\n", {m.spectre_version})
        stdio.print(
            "Install the required compiler with: ./fw/install.sh -v {s}\n",
            {m.spectre_version}
        )
        stdio.puts("Or update 'spectre_version' in sx.mod to match the installed compiler")
        return false
    }
    return true
}

pub fn load_sxmod() option[ref SxMod] = {
    val size_opt = trust fs.file_size_cstr(c"sx.mod")
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: allocators.Arena = trust allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = trust fs.read_all_cstr[allocators.Arena](arena, c"sx.mod")
    match content_opt {
        none => {
            trust allocators.Arena.free(arena)
            return none
        }
        some content => {
            val m: ref SxMod = trust parse_sxmod(content as ref u8)
            trust allocators.Arena.free(arena)
            if !validate_sxmod(m) {
                return none
            }
            return some m
        }
    }
}

fn parse_sxlock(content: ref u8) list[ref SxLockDep] = trust {
    val ctx: mut ref ParseCtx = new_ctx(content)
    val deps: mut list[ref SxLockDep] = mem.new[ref SxLockDep]()
    for {
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == -1 {
            break
        }
        val kw: ref u8 = ctx_read_ident(ctx)
        if cstr.cmp(kw, c"") == 0 {
            break
        }
        if cstr.cmp(kw, c"dep") == 0 {
            val url: ref u8 = ctx_read_quoted(ctx)
            val hash: ref u8 = ctx_read_quoted(ctx)
            if cstr.cmp(url, c"") != 0 && cstr.cmp(hash, c"") != 0 {
                val dep: mut ref SxLockDep = mem.alloc(@sizeof(SxLockDep) as usize) as ref SxLockDep
                @memset(dep, 0, @sizeof(SxLockDep) as usize)
                dep.url = url
                dep.hash = hash
                @append(deps, dep)
            }
        } else {
            ctx_skip_line(ctx)
        }
    }
    @free(ctx)
    return deps
}

fn load_sxlock() option[list[ref SxLockDep]] = {
    val size_opt = trust fs.file_size_cstr(c"sx.lock")
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: allocators.Arena = trust allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = trust fs.read_all_cstr[allocators.Arena](arena, c"sx.lock")
    match content_opt {
        none => {
            trust allocators.Arena.free(arena)
            return none
        }
        some content => {
            val deps: list[ref SxLockDep] = trust parse_sxlock(content as ref u8)
            trust allocators.Arena.free(arena)
            return some deps
        }
    }
}

pub fn load_sxmod_at(dir: ref u8) option[ref SxMod] = trust {
    val mod_path: ref u8 = path.join_cstr(dir, c"sx.mod")
    val size_opt = fs.file_size_cstr(mod_path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all_cstr[allocators.Arena](arena, mod_path)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return none
        }
        some content => {
            val m: ref SxMod = parse_sxmod(content as ref u8)
            allocators.Arena.free(arena)
            return some m
        }
    }
}

/// True when an sx.mod in `dir` describes a project (entry/build configs).
/// An sx.mod containing only `single_flags` is not a project root.
pub fn is_project_sxmod_at(dir: ref u8) bool = trust {
    val mod_opt = load_sxmod_at(dir)
    match mod_opt {
        none => {
            return false
        }
        some m => {
            if cstr.cmp(m.entry, c"") != 0 {
                return true
            }
            if @len(m.builds) > 0 {
                return true
            }
            return false
        }
    }
}

fn parent_dir(dir: ref u8) ref u8 = trust {
    val len: i64 = cstr.len(dir)
    val end: mut i64 = len
    for {
        if end <= 1 {
            break
        }
        val c: u8 = @load8(@ptradd(dir, end - 1)) as u8
        if c == 47 || c == 92 {
            end--
        } else {
            break
        }
    }
    val i: mut i64 = end - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(dir, i)) as u8
        if c == 47 || c == 92 {
            if i == 0 {
                return c"/"
            }
            return cstr.substr(dir, 0, i)
        }
        i--
    }
    return c"."
}

/// Read the application version from the nearest sx.mod for a source file.
/// The same-directory manifest is checked first, then parent directories.
pub fn load_version_for(input: ref u8) ref u8 = trust {
    val raw_dir: ref u8 = path.dir_cstr(input)
    val start_dir: mut ref u8 = raw_dir
    if cstr.cmp(raw_dir, c".") == 0 {
        val cwd_opt = fs.cwd_cstr()
        if cwd_opt is some cwd {
            start_dir = cwd
        }
    }
    val same_opt = load_sxmod_at(start_dir)
    if same_opt is some same_mod {
        if cstr.cmp(same_mod.version, c"") != 0 {
            return same_mod.version
        }
    }

    val cur: mut ref u8 = start_dir
    val depth: mut i32 = 0 as i32
    for depth < (16 as i32) {
        val parent: ref u8 = parent_dir(cur)
        if cstr.cmp(parent, cur) == 0 {
            break
        }
        cur = parent
        val mod_opt = load_sxmod_at(cur)
        if mod_opt is some found_mod {
            if cstr.cmp(found_mod.version, c"") != 0 {
                return found_mod.version
            }
        }
        if cstr.cmp(cur, c".") == 0 || cstr.cmp(cur, c"/") == 0 {
            break
        }
        depth = depth + (1 as i32)
    }
    return c""
}

/// Read single_flags from an sx.mod next to the given source file.
/// Parent directories are deliberately not searched.
pub fn load_single_flags_for(input: ref u8) result[ref u8, ref u8] = trust {
    val dir: ref u8 = path.dir_cstr(input)
    val mod_opt = load_sxmod_at(dir)
    match mod_opt {
        none => {
            return ok c""
        }
        some m => {
            if cstr.cmp(m.spectre_version, c"") != 0 {
                if !validate_spectre_version(m) {
                    return err c""
                }
            }
            return ok m.single_flags
        }
    }
}

/// Split a single_flags value into command-line tokens.
pub fn split_single_flags(s: ref u8) list[ref u8] = trust {
    val out: mut list[ref u8] = mem.new[ref u8]()
    val len: i64 = cstr.len(s)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i)) as u8
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= len {
                break
            }
            val c2: u8 = @load8(@ptradd(s, i)) as u8
            if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 {
                break
            }
            i++
        }
        @append(out, cstr.substr(s, start, i - start))
    }
    return out
}

fn load_sxlock_at(dir: ref u8) option[list[ref SxLockDep]] = trust {
    val lock_path: ref u8 = @fmtalloc("{s}/sx.lock", {dir})
    val size_opt = fs.file_size_cstr(lock_path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        @free(lock_path)
        return none
    }
    val arena: allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all_cstr[allocators.Arena](arena, lock_path)
    @free(lock_path)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return none
        }
        some content => {
            val deps: list[ref SxLockDep] = parse_sxlock(content as ref u8)
            allocators.Arena.free(arena)
            return some deps
        }
    }
}

fn lock_hash_for_url(lock_deps: list[ref SxLockDep], url: ref u8) ref u8 = {
    for dep in lock_deps {
        if cstr.cmp(dep.url, url) == 0 {
            return dep.hash
        }
    }
    return c""
}

fn build_rule_matches(rule: ref SxBuildRule) bool = trust {
    if cstr.cmp(rule.platform, c"") != 0 {
        if !builds.platform_matches_with_target(rule.platform, c"") {
            return false
        }
    }
    if cstr.cmp(rule.arch, c"") != 0 {
        if !builds.arch_matches(rule.arch) {
            return false
        }
    }
    return true
}

fn apply_build_rule(target: mut ref SxBuildRule, source: ref SxBuildRule) void = {
    if cstr.cmp(source.action, c"") != 0 {
        target.action = source.action
    }
    if cstr.cmp(source.flags, c"") != 0 {
        target.flags = source.flags
    }
    if cstr.cmp(source.output, c"") != 0 {
        target.output = source.output
    }
    if cstr.cmp(source.entry, c"") != 0 {
        target.entry = source.entry
    }
    for env_entry in source.envs {
        @append(target.envs, env_entry)
    }
}

pub fn resolve_build_rule(cfg: ref SxBuildConfig, target: mut ref SxBuildRule) void = trust {
    target.platform = c""
    target.arch = c""
    target.action = c""
    target.flags = c""
    target.output = c""
    target.entry = c""
    target.envs = mem.new[ref u8]()
    apply_build_rule(target, cfg.base)
    for rule in cfg.rules {
        if build_rule_matches(rule) {
            apply_build_rule(target, rule)
        }
    }
}

fn build_config_cmd(cfg: ref SxBuildRule, exe_path: ref u8, entry: ref u8) ref u8 = trust {
    val cmd: mut ref u8 = c""
    if cstr.cmp(cfg.action, c"") != 0 {
        cmd = mem_dup_cstr(cfg.action)
    } else {
        cmd = mem_concat2(mem_concat3(exe_path, c" ", entry), c" -no-single-flags")
    }
    if cstr.cmp(cfg.flags, c"") != 0 {
        cmd = mem_concat3(cmd, c" ", cfg.flags)
    }
    if cstr.cmp(cfg.output, c"") != 0 {
        cmd = mem_concat3(cmd, c" -o ", cfg.output)
    }
    val nenv: i64 = @len(cfg.envs) as i64
    if nenv > 0 {
        if cstr.cmp(cfg.action, c"") == 0 {
            for e in cfg.envs {
                cmd = mem_concat3(cmd, c" -d:", e)
            }
        } else {
            val prefix: mut ref u8 = c""
            for e in cfg.envs {
                prefix = mem_concat3(prefix, e, c" ")
            }
            cmd = mem_concat2(prefix, cmd)
        }
    }
    return cmd
}

fn basename_of(path: ref u8) ref u8 = {
    val len: i64 = cstr.len(path)
    if len == 0 {
        return c"project"
    }
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(path, i)) as u8
        if c == 47 {
            last_slash = i
        }
        i++
    }
    val start: i64 = last_slash + 1
    val name_len: i64 = len - start
    if name_len <= 0 {
        return c"project"
    }
    val buf: ref u8 = @alloc(name_len + 1) as ref u8
    trust @memcpy(buf, @ptradd(path, start), name_len as usize)
    trust @store8(@ptradd(buf, name_len), 0)
    return buf
}

pub fn repo_name_from_url(url: ref u8) ref u8 = trust {
    val base: ref u8 = basename_of(url)
    val blen: i64 = cstr.len(base)
    if blen > 4 {
        val a: u8 = @load8(@ptradd(base, blen - 4)) as u8
        val b: u8 = @load8(@ptradd(base, blen - 3)) as u8
        val c: u8 = @load8(@ptradd(base, blen - 2)) as u8
        val d: u8 = @load8(@ptradd(base, blen - 1)) as u8
        if a == 46 && b == 103 && c == 105 && d == 116 {
            val trimmed: ref u8 = @alloc(blen - 3) as ref u8
            @memcpy(trimmed, base, (blen - 4) as usize)
            @store8(@ptradd(trimmed, blen - 4), 0)
            return trimmed
        }
    }
    return base
}

/// Rewrite filepath, dropping lines that start with dep_prefix AND contain needle.
fn drop_dep_lines(filepath: ref u8, needle: ref u8) void = trust {
    val size_opt = fs.file_size_cstr(filepath)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return
    }
    val arena: allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all_cstr[allocators.Arena](arena, filepath)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return
        }
        some content => {
            val sb: ref void = builder.StringBuilder.new()
            val text: ref u8 = content as ref u8
            val tlen: i64 = cstr.len(text)
            val line_start: mut i64 = 0
            val i: mut i64 = 0
            for {
                if i > tlen {
                    break
                }
                val at_end: bool = i == tlen
                val c: mut u8 = 0
                if !at_end {
                    c = @load8(@ptradd(text, i)) as u8
                }
                if at_end || c == 10 {
                    val line_len: i64 = i - line_start
                    val line: ref u8 = @alloc(line_len + 1) as ref u8
                    @memcpy(line, @ptradd(text, line_start), line_len as usize)
                    @store8(@ptradd(line, line_len), 0)
                    val is_dep: bool = cstr.starts_with(line, c"dep ")
                    val has_needle: bool = cstr.contains(line, needle)
                    if !(is_dep && has_needle) {
                        builder.StringBuilder.append_cstr(sb, line)
                        if !at_end {
                            builder.StringBuilder.append_char(sb, 10 as u8)
                        }
                    }
                    @free(line)
                    line_start = i + 1
                }
                i++
            }
            val result: ref void = builder.StringBuilder.build(sb)
            allocators.Arena.free(arena)
            fs.write_all_cstr(filepath, ostr.as_cstr(result))
            builder.StringBuilder.free(sb)
        }
    }
}

fn output_trimmed(cmd: ref u8) ref u8 = trust {
    val res = os.exec(cmd)
    match res {
        ok v => {
            val raw: ref u8 = ostr.as_cstr(v)
            val raw_len: i64 = cstr.len(raw)
            val end: mut i64 = raw_len
            for {
                if end <= 0 {
                    break
                }
                val c: u8 = @load8(@ptradd(raw, end - 1)) as u8
                if c == 10 || c == 13 || c == 32 {
                    end--
                } else {
                    break
                }
            }
            if end <= 0 {
                return c""
            }
            val trimmed: ref u8 = @alloc(end + 1) as ref u8
            @memcpy(trimmed, raw, end as usize)
            @store8(@ptradd(trimmed, end), 0)
            return trimmed
        }
        err _ => {
            return c""
        }
    }
}

fn dep_name_matches(dep_url: ref u8, dep_name: ref u8) bool = trust {
    if cstr.cmp(dep_name, c"") == 0 {
        return true
    }
    val url_name: ref u8 = repo_name_from_url(dep_url)
    return cstr.cmp(url_name, dep_name) == 0
}

fn set_lock_hash(filepath: ref u8, url: ref u8, hash: ref u8) void = trust {
    drop_dep_lines(filepath, url)
    fs.append_all_cstr(filepath, @fmtalloc("dep \"{s}\" \"{s}\"\n", {url, hash}))
}

fn upgrade_dir(
    base_dir: ref u8,
    dep_name: ref u8,
    matched: mut list[ref u8],
    visited: mut list[ref u8]
) i32 = trust {
    for v in visited {
        if cstr.cmp(v, base_dir) == 0 {
            return 0
        }
    }
    @append(visited, base_dir)

    val mod_opt = load_sxmod_at(base_dir)
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            return 0
        }
        some m => {
            sxmod = m
        }
    }

    val ndeps: i64 = @len(sxmod.deps) as i64
    if ndeps == 0 {
        return 0
    }

    val lock_opt = load_sxlock_at(base_dir)
    val lock_deps: mut list[ref SxLockDep] = mem.new[ref SxLockDep]()
    match lock_opt {
        none => {}
        some deps => {
            lock_deps = deps
        }
    }

    val lib_dir: ref u8 = @fmtalloc("{s}/lib", {base_dir})
    for dep_url in sxmod.deps {
        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("{s}/{s}", {lib_dir, name})

        if dep_name_matches(dep_url, dep_name) {
            if !fs.is_directory_cstr(lib_path) {
                stdio.print("error: dependency '{s}' is not present at {s}\n", {dep_url, lib_path})
                stdio.puts("run 'spectre restore' first")
                return 1
            }

            @append(matched, dep_url)
            val old_hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
            stdio.print("Upgrading {s}...\n", {dep_url})

            val fetch_cmd: ref u8 = @fmtalloc("git -C {s} fetch --quiet origin HEAD", {lib_path})
            if os.run(fetch_cmd) != 0 {
                stdio.print("error: git fetch failed for {s}\n", {dep_url})
                return 1
            }

            val reset_cmd: ref u8 = @fmtalloc(
                "git -C {s} reset --hard --quiet FETCH_HEAD",
                {lib_path}
            )
            if os.run(reset_cmd) != 0 {
                stdio.print("error: failed to check out HEAD for {s}\n", {dep_url})
                return 1
            }

            val new_hash: ref u8 = output_trimmed(@fmtalloc(
                    "git -C {s} rev-parse HEAD",
                    {lib_path}
                ))
            if cstr.cmp(new_hash, c"") == 0 {
                stdio.print("error: could not determine HEAD for {s}\n", {dep_url})
                return 1
            }

            set_lock_hash(@fmtalloc("{s}/sx.lock", {base_dir}), dep_url, new_hash)
            if cstr.cmp(old_hash, c"") == 0 {
                stdio.print("Upgraded '{s}' to {s}\n", {name, new_hash})
            } elif cstr.cmp(old_hash, new_hash) == 0 {
                stdio.print("'{s}' is already up to date ({s})\n", {name, new_hash})
            } else {
                stdio.print("Upgraded '{s}' {s} -> {s}\n", {name, old_hash, new_hash})
            }
        }

        val sub_code: i32 = upgrade_dir(lib_path, dep_name, matched, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    return 0
}

pub fn cmd_upgrade(dep_name: ref u8) i32 = trust {
    if !os.exists(c"sx.mod") {
        stdio.puts("error: sx.mod not found, run 'spectre init' first")
        return 1
    }

    val matched: mut list[ref u8] = mem.new[ref u8]()
    val visited: mut list[ref u8] = mem.new[ref u8]()
    val code: i32 = upgrade_dir(c".", dep_name, matched, visited)
    if code != 0 {
        return code
    }

    if (@len(matched) as i64) == 0 {
        if cstr.cmp(dep_name, c"") == 0 {
            stdio.puts("No dependencies to upgrade.")
            return 0
        }
        stdio.print("error: dependency '{s}' not found\n", {dep_name})
        return 1
    }

    return 0
}

fn add_stdlib_candidate(candidates: mut list[ref u8], dir: ref u8) void = trust {
    if cstr.cmp(dir, c"") == 0 {
        return
    }
    @append(candidates, dir)
}

fn copy_current_stdlib(snapshot_dir: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(4096 as usize)?
    val exe_path = reflection.get_exe_path[allocators.Arena](arena)
    val exe_dir = path.dir_cstr(exe_path)
    val candidates: mut list[ref u8] = mem.new[ref u8]()
    val stdlib_env = os.env(c"SPECTRE_STDLIB")

    if stdlib_env is some v {
        val dir: ref u8 = v as ref u8
        add_stdlib_candidate(candidates, dir)
        add_stdlib_candidate(candidates, path.join_cstr(dir, c"spectrelib"))
    }

    val root_env = os.env(c"SPECTRE_ROOT")
    if root_env is some v {
        add_stdlib_candidate(candidates, path.join_cstr(v as ref u8, c"spectrelib"))
    }

    add_stdlib_candidate(candidates, path.join_cstr(exe_dir, c"spectrelib"))
    add_stdlib_candidate(candidates, path.join_cstr(exe_dir, c"../share/spectre/spectrelib"))
    add_stdlib_candidate(candidates, path.join_cstr(exe_dir, c"../lib/spectre/spectrelib"))
    add_stdlib_candidate(candidates, path.join_cstr(exe_dir, c"../lib/spectrelib"))
    add_stdlib_candidate(candidates, c"spectrelib")

    val std_dir: mut ref u8 = c""
    for candidate in candidates {
        if fs.is_directory_cstr(candidate) {
            std_dir = candidate
            break
        }
    }

    if cstr.cmp(std_dir, c"") == 0 {
        stdio.puts("error: could not locate the Spectre standard library ('spectrelib')")
        stdio.print("  executable: {s}\n", {exe_path})
        stdio.print("  directory:  {s}\n", {exe_dir})
        stdio.puts("  looked in:")
        for candidate in candidates {
            stdio.print("    - {s}\n", {candidate})
        }
        stdio.puts("  set SPECTRE_STDLIB=/path/to/spectrelib to override")
        allocators.Arena.free(arena)
        return false
    }

    val its_ok: mut bool = os.copy_dir_recursive(std_dir, snapshot_dir)
    if !its_ok {
        stdio.puts("error: failed to copy the standard library")
        stdio.print("  from: {s}\n", {std_dir})
        stdio.print("  to:   {s}\n", {snapshot_dir})
        stdio.puts("  check that both directories are readable and writable")
    } else {
        val marker = path.join_cstr(snapshot_dir, c"stdio/core.sx")
        if !os.exists(marker) {
            stdio.print(
                "error: standard library copy at {s} looks incomplete (missing {s})\n",
                {snapshot_dir, marker}
            )
            its_ok = false
        }
    }

    allocators.Arena.free(arena)
    return its_ok
}

pub fn cmd_ref() i32 = trust {
    val path: ref u8 = c"SPECTRE_LANGUAGE_REFERENCE.md"
    val content: ref void = @embed("../../docs/SPECTRE_REFERENCE.md") as ref void
    val content_len: i64 = @embedlen("../../docs/SPECTRE_REFERENCE.md") as i64
    if !fs.write_all_bytes_cstr(path, content, content_len) {
        stdio.print("error: could not write {s}\n", {path})
        return 1
    }

    val unix_time: i64 = time.unix_now()
    val std_snapshot_dir: ref u8 = @fmtalloc("std__{d}", {unix_time})
    if !(copy_current_stdlib(std_snapshot_dir)) {
        stdio.print("error: could not copy stdlib into {s}\n", {std_snapshot_dir})
        return 1
    }

    stdio.print("Generated SLR + Copied stdlib to {s}.\n", {std_snapshot_dir})
    return 0
}

pub fn cmd_init(name_arg: ref u8) i32 = {
    if os.exists(c"sx.mod") {
        stdio.puts("error: sx.mod already exists in this directory")
        return 1
    }

    val proj_name: mut ref u8 = name_arg
    if cstr.cmp(proj_name, c"") == 0 {
        val cwd_arena: allocators.Arena = trust allocators.Arena.new(4096 as usize)?
        val cwd_opt = trust fs.cwd[allocators.Arena](cwd_arena)
        if cwd_opt is some cwd {
            proj_name = basename_of(cwd)
        } else {
            proj_name = c"my-project"
        }
        trust allocators.Arena.free(cwd_arena)
    }

    val sb: ref void = builder.StringBuilder.new()
    val init_header: ref u8 = trust @fmtalloc(
        "entry \"./src/main.sx\"\nversion \"v0.0.1\"\nspectre_version \"{s}\"\n\nbuild release {\n    flags \"-release\"\n    output \"./",
        {meta.get_spectre_version()}
    )
    trust builder.StringBuilder.append_cstr(sb, init_header)
    trust builder.StringBuilder.append_cstr(sb, proj_name)
    trust builder.StringBuilder.append_cstr(sb, c"\"\n}\n\nbuild dev {\n    output \"./")
    trust builder.StringBuilder.append_cstr(sb, proj_name)
    trust builder.StringBuilder.append_cstr(sb, c"-dev\"\n}\n")
    val sxmod_built: ref void = trust builder.StringBuilder.build(sb)
    trust fs.write_all_cstr(c"sx.mod", ostr.as_cstr(sxmod_built))
    trust builder.StringBuilder.free(sb)
    trust fs.write_all_cstr(c"sx.lock", c"version \"1\"\n")
    trust fs.write_all_cstr(
        c".gitignore",
        c"SPECTRE_LANGUAGE_REFERENCE.md\nlib/\nstd__*\ns-out/\ndocs-out*/\n"
    )

    trust fs.mkdir_path_cstr(c"src")

    val main_template: str.StringView = \\val stdio = use("std/stdio")
    \\
    \\pub fn main() void = {
    \\    stdio.puts("Hello, world.")
    \\}
    \\
    trust fs.write_all("src/main.sx", main_template)
    trust stdio.print("Initialized project '{s}'\n", {proj_name})
    return 0
}

pub fn cmd_build(config_name: ref u8, exe_path: ref u8) i32 = {
    match load_sxmod() {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            if !trust validate_spectre_version(m) {
                return 1
            }

            val found_cfg: mut ref SxBuildConfig = none
            val builds: list[ref SxBuildConfig] = m.builds
            for cfg in builds {
                if cstr.cmp(cfg.name, config_name) == 0 {
                    found_cfg = cfg
                    break
                }
            }
            if found_cfg == none {
                trust stdio.print("error: build config '{s}' not found in sx.mod\n", {config_name})
                return 1
            }

            val resolved: mut ref SxBuildRule = trust new_build_rule(c"", c"")
            trust resolve_build_rule(found_cfg, resolved)

            val entry: mut ref u8 = m.entry
            if cstr.cmp(resolved.entry, c"") != 0 {
                entry = resolved.entry
            }
            val cmd: ref u8 = trust build_config_cmd(resolved, exe_path, entry)
            val exit_code: i32 = trust os.run(cmd)
            if exit_code != 0 {
                return 1
            }
            return 0
        }
    }
}

pub fn cmd_add(url: ref u8) i32 = trust {
    if !os.exists(c"sx.mod") {
        stdio.puts("error: sx.mod not found, run 'spectre init' first")
        return 1
    }

    val name: ref u8 = repo_name_from_url(url)
    val lib_path: ref u8 = @fmtalloc("lib/{s}", {name})

    if os.exists(lib_path) {
        stdio.print("error: dependency '{s}' already exists at {s}\n", {name, lib_path})
        return 1
    }

    fs.mkdir_path_cstr(c"lib")

    val clone_cmd: ref u8 = @fmtalloc("git clone {s} {s}", {url, lib_path})
    stdio.print("Cloning {s}...\n", {url})
    val exit_code: i32 = os.run(clone_cmd)
    if exit_code != 0 {
        stdio.print("error: git clone failed for {s}\n", {url})
        return 1
    }

    val dep_line: ref u8 = @fmtalloc("dep \"{s}\"\n", {url})
    fs.append_all_cstr(c"sx.mod", dep_line)

    val hash_cmd: ref u8 = @fmtalloc("git -C {s} rev-parse HEAD", {lib_path})
    val hash_res = os.exec(hash_cmd)
    val hash: mut ref u8 = c"unknown"
    match hash_res {
        ok v => {
            val raw: ref u8 = ostr.as_cstr(v)
            val raw_len: i64 = cstr.len(raw)
            val trimmed_len: mut i64 = raw_len
            for {
                if trimmed_len <= 0 {
                    break
                }
                val c: u8 = @load8(@ptradd(raw, trimmed_len - 1)) as u8
                if c == 10 || c == 13 || c == 32 {
                    trimmed_len--
                } else {
                    break
                }
            }
            val h: ref u8 = @alloc(trimmed_len + 1) as ref u8
            @memcpy(h, raw, trimmed_len as usize)
            @store8(@ptradd(h, trimmed_len), 0)
            hash = h
        }
        err _ => {}
    }

    val lock_line: ref u8 = @fmtalloc("dep \"{s}\" \"{s}\"\n", {url, hash})
    fs.append_all_cstr(c"sx.lock", lock_line)

    stdio.print("Added dependency '{s}' ({s})\n", {name, hash})
    return 0
}

pub fn cmd_remove(dep_name: ref u8) i32 = {
    if !os.exists(c"sx.mod") {
        stdio.puts("error: sx.mod not found")
        return 1
    }

    val lib_path: ref u8 = trust @fmtalloc("lib/{s}", {dep_name})
    if os.exists(lib_path) {
        val rm_cmd: ref u8 = trust @fmtalloc("rm -rf {s}", {lib_path})
        trust os.run(rm_cmd)
        trust stdio.print("Removed {s}\n", {lib_path})
    } else {
        trust stdio.print("warning: {s} not found, updating manifests only\n", {lib_path})
    }

    trust drop_dep_lines(c"sx.mod", dep_name)
    trust drop_dep_lines(c"sx.lock", dep_name)
    trust stdio.print("Removed dependency '{s}'\n", {dep_name})
    return 0
}

fn restore_in_dir(base_dir: ref u8, visited: mut list[ref u8]) i32 = trust {
    for v in visited {
        if cstr.cmp(v, base_dir) == 0 {
            return 0
        }
    }
    @append(visited, base_dir)

    val sxmod_opt = load_sxmod_at(base_dir)
    val sxmod: mut ref SxMod = none
    match sxmod_opt {
        none => {
            return 0
        }
        some m => {
            sxmod = m
        }
    }

    if ((@len(sxmod.deps) as i64) == 0) {
        return 0
    }

    val lock_opt = load_sxlock_at(base_dir)
    val lock_deps: mut list[ref SxLockDep] = mem.new[ref SxLockDep]()
    match lock_opt {
        none => {
            stdio.print("warning: no sx.lock in {s}, skipping transitive deps\n", {base_dir})
            return 0
        }
        some deps => {
            lock_deps = deps
        }
    }

    val lib_dir: ref u8 = @fmtalloc("{s}/lib", {base_dir})
    if os.exists(lib_dir) {
        when windows {
            os.run(@fmtalloc("rmdir /s /q {s}", {lib_dir}))
        }
        when posix {
            os.run(@fmtalloc("rm -rf {s}", {lib_dir}))
        }
    }
    fs.mkdir_path_cstr(lib_dir)

    for dep_url in sxmod.deps {
        val hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
        if cstr.cmp(hash, c"") == 0 {
            stdio.print("error: '{s}' missing from sx.lock in {s}\n", {dep_url, base_dir})
            return 1
        }

        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("{s}/{s}", {lib_dir, name})
        stdio.print("Restoring {s}...\n", {dep_url})
        if os.run(@fmtalloc("git clone {s} {s}", {dep_url, lib_path})) != 0 {
            stdio.print("error: git clone failed for {s}\n", {dep_url})
            return 1
        }

        if cstr.cmp(hash, c"unknown") != 0 {
            if os.run(@fmtalloc("git -C {s} checkout --quiet {s}", {lib_path, hash})) != 0 {
                stdio.print("error: failed to checkout {s} for {s}\n", {hash, dep_url})
                return 1
            }
        }

        val sub_code: i32 = restore_in_dir(lib_path, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    return 0
}

pub fn cmd_restore() i32 = trust {
    val mod_opt = load_sxmod()
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            sxmod = m
        }
    }

    val lock_opt = load_sxlock()
    val lock_deps: mut list[ref SxLockDep] = mem.new[ref SxLockDep]()
    match lock_opt {
        none => {
            stdio.puts("error: sx.lock not found, add dependencies or generate a lockfile first")
            return 1
        }
        some deps => {
            lock_deps = deps
        }
    }

    if os.exists(c"lib") {
        when windows {
            os.run(c"rmdir /s /q lib")
        }
        when posix {
            os.run(c"rm -rf lib")
        }
    }
    fs.mkdir_path_cstr(c"lib")

    val visited: mut list[ref u8] = mem.new[ref u8]()
    @append(visited, c".")

    for dep_url in sxmod.deps {
        val hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
        if cstr.cmp(hash, c"") == 0 {
            stdio.print("error: dependency '{s}' is missing from sx.lock\n", {dep_url})
            return 1
        }

        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("lib/{s}", {name})
        val clone_cmd: ref u8 = @fmtalloc("git clone {s} {s}", {dep_url, lib_path})
        stdio.print("Restoring {s}...\n", {dep_url})
        if os.run(clone_cmd) != 0 {
            stdio.print("error: git clone failed for {s}\n", {dep_url})
            return 1
        }

        if cstr.cmp(hash, c"unknown") != 0 {
            val checkout_cmd: ref u8 = @fmtalloc(
                "git -C {s} checkout --quiet {s}",
                {lib_path, hash}
            )
            if os.run(checkout_cmd) != 0 {
                stdio.print("error: failed to checkout {s} for {s}\n", {hash, dep_url})
                return 1
            }
        }

        val sub_code: i32 = restore_in_dir(lib_path, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    stdio.puts("Restored dependencies to ./lib")
    return 0
}

fn print_graph_node(
    base_dir: ref u8,
    name: ref u8,
    url: ref u8,
    prefix: ref u8,
    is_last: bool,
    visited: mut list[ref u8]
) void = trust {
    val conn: mut ref u8 = c"├── "
    if is_last {
        conn = c"└── "
    }

    val line: mut ref u8 = @fmtalloc("{s}{s}{s}", {prefix, conn, name})
    if cstr.cmp(url, c"") != 0 {
        line = @fmtalloc("{s} ({s})", {line, url})
    }
    stdio.puts(str.from_cstr(line))

    for v in visited {
        if cstr.cmp(v, base_dir) == 0 {
            return
        }
    }
    @append(visited, base_dir)

    val child_mod_opt = load_sxmod_at(base_dir)
    match child_mod_opt {
        none => {
            return
        }
        some child_mod => {
            val ndeps: i64 = @len(child_mod.deps) as i64
            if ndeps == 0 {
                return
            }
            val child_prefix: mut ref u8 = @fmtalloc("{s}│   ", {prefix})
            if is_last {
                child_prefix = @fmtalloc("{s}    ", {prefix})
            }
            val i: mut i64 = 0
            for dep_url in child_mod.deps {
                val dep_name: ref u8 = repo_name_from_url(dep_url)
                val dep_dir: ref u8 = @fmtalloc("{s}/lib/{s}", {base_dir, dep_name})
                print_graph_node(dep_dir, dep_name, dep_url, child_prefix, i == ndeps - 1, visited)
                i++
            }
        }
    }
}

pub fn cmd_graph() i32 = trust {
    val mod_opt = load_sxmod()
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            sxmod = m
        }
    }

    val cwd_arena: allocators.Arena = allocators.Arena.new(4096 as usize)?
    val cwd_opt = fs.cwd[allocators.Arena](cwd_arena)
    val proj_name: mut ref u8 = c"project"
    if cwd_opt is some cwd {
        proj_name = basename_of(cwd)
    }
    allocators.Arena.free(cwd_arena)

    if cstr.cmp(sxmod.version, c"") == 0 {
        stdio.puts(str.from_cstr(proj_name))
    } else {
        stdio.puts(str.from_cstr(@fmtalloc("{s} ({s})", {proj_name, sxmod.version})))
    }

    val ndeps: i64 = @len(sxmod.deps) as i64
    if ndeps == 0 {
        stdio.puts("(no dependencies)")
        return 0
    }

    val visited: mut list[ref u8] = mem.new[ref u8]()
    @append(visited, c".")

    val i: mut i64 = 0
    for dep_url in sxmod.deps {
        val dep_name: ref u8 = repo_name_from_url(dep_url)
        val dep_dir: ref u8 = @fmtalloc("lib/{s}", {dep_name})
        print_graph_node(dep_dir, dep_name, dep_url, c"", i == ndeps - 1, visited)
        i++
    }

    return 0
}

pub fn shell_quote(s: ref u8) ref u8 = trust {
    val sb: ref void = builder.StringBuilder.new()
    builder.StringBuilder.append_char(sb, 39)
    val n: i64 = cstr.len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 39 {
            builder.StringBuilder.append_char(sb, 39)
            builder.StringBuilder.append_char(sb, 92)
            builder.StringBuilder.append_char(sb, 39)
            builder.StringBuilder.append_char(sb, 39)
        } else {
            builder.StringBuilder.append_char(sb, c)
        }
        i++
    }
    builder.StringBuilder.append_char(sb, 39)
    val built: ref void = builder.StringBuilder.build(sb)
    val raw: ref u8 = ostr.as_cstr(built)
    val out: ref u8 = @alloc(cstr.len(raw) + 1) as ref u8
    @memcpy(out, raw, cstr.len(raw) as usize)
    @store8(@ptradd(out, cstr.len(raw)), 0)
    builder.StringBuilder.free(sb)
    return out
}

fn collect_test_files(
    target: ref u8,
    depth: i64,
    max_depth: i64,
    out: mut list[ref u8]
) void = trust {
    if !fs.is_directory_cstr(target) {
        if cstr.ends_with(target, c".sx") {
            @append(out, target)
        }
        return
    }
    val walk_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
        65536 as usize
    )?
    val walk_list_arena: allocators.ListArena = {arena: walk_arena}
    val entries_opt = fs.walk_dir[allocators.ListArena](walk_list_arena, target)
    if entries_opt is some entries {
        for entry in entries {
            val child: ref u8 = path.join_cstr(target, entry)
            if fs.is_directory_cstr(child) {
                if depth < max_depth {
                    collect_test_files(child, depth + 1, max_depth, out)
                }
                @free(child)
            } elif cstr.ends_with(entry, c".sx") {
                @append(out, child)
            } else {
                @free(child)
            }
        }
    } else {
        stdio.print("error: could not read directory '{s}'\n", {target})
    }
    allocators.ScopedArena.free(walk_arena)
}

/// Run `-test` for every `.sx` file under `root`, recursively.
pub fn cmd_test_all(
    exe_path: ref u8,
    root: ref u8,
    max_depth: i64,
    extra_flags: list[ref u8]
) i32 = trust {
    val files: mut list[ref u8] = mem.new[ref u8]()
    collect_test_files(root, 0, max_depth, files)
    val count: i64 = @len(files) as i64
    if count == 0 {
        stdio.print("no .sx files found under '{s}'\n", {root})
        return 0
    }
    val failures: mut i64 = 0
    val i: mut i64 = 0
    for file in files {
        i++
        stdio.print("[{lld}/{lld}] {s}\n", {i, count, file})
        val sb: ref void = builder.StringBuilder.new()
        builder.StringBuilder.append_cstr(sb, shell_quote(exe_path))
        builder.StringBuilder.append_cstr(sb, c" ")
        builder.StringBuilder.append_cstr(sb, shell_quote(file))
        builder.StringBuilder.append_cstr(sb, c" -test")
        for flag in extra_flags {
            builder.StringBuilder.append_cstr(sb, c" ")
            builder.StringBuilder.append_cstr(sb, flag)
        }
        val built: ref void = builder.StringBuilder.build(sb)
        val cmd: ref u8 = ostr.as_cstr(built)
        val code: i32 = os.run(cmd)
        builder.StringBuilder.free(sb)
        if code != 0 {
            failures++
            stdio.print("[fail] {s}\n", {file})
        }
    }
    if failures > 0 {
        stdio.print("{lld} of {lld} modules failed\n", {failures, count})
        return 1
    }
    stdio.print("all {lld} modules passed\n", {count})
    return 0
}

pub fn cmd_clean() i32 = {
    if os.exists(c"s-out") {
        when windows {
            trust os.run(c"rmdir /s /q s-out")
        }
        when posix {
            trust os.run(c"rm -rf s-out")
        }
        stdio.puts("Removed s-out/")
    }
    trust os.delete(builds.get_tmp_path(c"spectre_output.ssa"))
    trust os.delete(builds.get_tmp_path(c"spectre_output.s"))
    trust os.delete(builds.get_tmp_path(c"spectre_test_bin"))
    stdio.puts("Clean complete.")
    return 0
}

fn tool_version(cmd: ref u8) ref u8 = {
    val res = trust os.exec(cmd)
    match res {
        ok v => {
            val raw: ref u8 = trust ostr.as_cstr(v)
            val raw_len: i64 = cstr.len(raw)
            val end: mut i64 = raw_len
            for {
                if end <= 0 {
                    break
                }
                val c: u8 = trust @load8(@ptradd(raw, end - 1)) as u8
                if c == 10 || c == 13 {
                    end--
                } else {
                    break
                }
            }
            if end <= 0 {
                return c"unknown"
            }
            val buf: ref u8 = @alloc(end + 1) as ref u8
            trust @memcpy(buf, raw, end as usize)
            trust @store8(@ptradd(buf, end), 0)
            return buf
        }
        err _ => {
            return c"not found"
        }
    }
}

pub fn cmd_doctor() i32 = {
    trust stdio.print("Spectre Compiler {s}\n\n", {meta.get_spectre_version()})

    val platform_res = trust os.exec(c"uname -srm 2>&1")
    match platform_res {
        ok v => {
            trust stdio.print("os:      {s}", {ostr.as_cstr(v)})
        }
        err _ => {
            stdio.puts("os:      unknown")
        }
    }

    val qbe_ver: ref u8 = tool_version(c"qbe -d 2>&1")
    val qbe_installed_str: mut ref u8 = c"installed"
    val arena: allocators.Arena = trust allocators.Arena.new(256 as usize)?
    val qbe_ver_string = trust ostr.from_cstr[allocators.Arena](arena, qbe_ver)
    val not_found = trust ostr.from_cstr[allocators.Arena](arena, c"not found")
    if ostr.contains(qbe_ver_string, not_found) {
        qbe_installed_str = c"not installed"
    }
    trust allocators.Arena.free(arena)
    trust stdio.print("qbe:     {s}\n", {qbe_installed_str})

    val cc_ver: ref u8 = tool_version(c"cc -version 2>&1 | head -1")
    trust stdio.print("cc:      {s}\n", {cc_ver})

    val git_ver: ref u8 = tool_version(c"git -version 2>&1")
    trust stdio.print("git:     {s}\n", {git_ver})

    val cwd_arena: allocators.Arena = trust allocators.Arena.new(4096 as usize)?
    val cwd_opt = trust fs.cwd[allocators.Arena](cwd_arena)
    if cwd_opt is some cwd {
        trust stdio.print("cwd:     {s}\n", {cwd})
    } else {
        stdio.puts("cwd:     unknown")
    }
    trust allocators.Arena.free(cwd_arena)

    if os.exists(c"sx.mod") {
        stdio.puts("sx.mod:  found")
    } else {
        stdio.puts("sx.mod:  not found")
    }

    return 0
}
