val str        = use("std/string")
val fs         = use("std/fs")
val path       = use("std/path")
val time       = use("std/time")
val allocators = use("std/allocators")
val reflection = use("std/reflection")
val meta       = use("meta.sx")
val builds     = use("builds.sx")
val stdio      = use("std/stdio")
val os         = use("std/os")
val git        = use("std/git")

pub type SxBuildRule = {
    platform: mut ref u8
    arch: mut ref u8
    action: mut ref u8
    flags: mut ref u8
    output: mut ref u8
    entry: mut ref u8
    envs: mut list[ref u8]
}

pub type SxBuildConfig = {
    name: mut ref u8
    base: mut ref SxBuildRule
    rules: mut list[ref SxBuildRule]
}

pub type SxMod = {
    entry: mut ref u8
    version: mut ref u8
    spectre_version: mut ref u8
    single_flags: mut ref u8
    deps: mut list[ref u8]
    builds: mut list[ref SxBuildConfig]
}

type SxLockDep = {
    url: mut ref u8
    hash: mut ref u8
}

type ParseCtx = {
    text: mut ref u8
    pos: mut i64
    len: mut i64
}

fn new_ctx(text: ref u8) ref ParseCtx = {
    val ctx: mut ref ParseCtx = @alloc(@sizeof(ParseCtx)) as ref ParseCtx
    ctx.text = text
    ctx.pos = 0
    ctx.len = str.len_raw(text)
    return ctx
}

fn ctx_peek(ctx: ref ParseCtx) i64 = trust {
    if ctx.pos >= ctx.len {
        return -1
    }
    return @load8(@ptradd(ctx.text, ctx.pos)) as i64
}

fn ctx_advance(ctx: mut ref ParseCtx) void = {
    ctx.pos++
}

fn ctx_skip_line(ctx: mut ref ParseCtx) void = {
    for {
        val c: i64 = trust ctx_peek(ctx)
        if c == -1 {
            break
        }
        ctx_advance(ctx)
        if c == 10 {
            break
        }
    }
}

fn ctx_skip_ws(ctx: mut ref ParseCtx) void = {
    for {
        val c: i64 = trust ctx_peek(ctx)
        if c == -1 {
            break
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            ctx_advance(ctx)
        } elif c == 47 && ctx.pos + 1 < ctx.len {
            val c2: i64 = trust @load8(@ptradd(ctx.text, ctx.pos + 1)) as i64
            if c2 == 47 {
                ctx_skip_line(ctx)
            } else {
                break
            }
        } else {
            break
        }
    }
}

fn ctx_read_quoted(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) != 34 {
        return ""
    }
    ctx_advance(ctx)
    val cap: mut i64 = 256
    val buf: mut ref u8 = @alloc(cap) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 34 {
            break
        }
        if i >= cap - 1 {
            cap = cap * 2
            buf = @realloc(buf, cap) as ref u8
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    if ctx_peek(ctx) == 34 {
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    val result: ref u8 = @alloc(i + 1) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

fn ctx_read_ident(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    val buf: ref u8 = @alloc(256) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 {
            break
        }
        val alpha: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        val digit: bool = c >= 48 && c <= 57
        val special: bool = c == 95 || c == 45 || c == 46 || c == 47
        if !alpha && !digit && !special {
            break
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    if i == 0 {
        @free(buf)
        return ""
    }
    val result: ref u8 = @alloc(i + 1) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

fn ctx_read_env_value(ctx: mut ref ParseCtx) ref u8 = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) == 34 {
        return ctx_read_quoted(ctx)
    }

    val cap: mut i64 = 256
    val buf: mut ref u8 = @alloc(cap) as ref u8
    val i: mut i64 = 0
    for {
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 32 || c == 9 || c == 10 || c == 13 || c == 125 {
            break
        }
        if i >= cap - 1 {
            cap = cap * 2
            buf = @realloc(buf, cap) as ref u8
        }
        @store8(@ptradd(buf, i), c as u8)
        i++
        ctx_advance(ctx)
    }
    @store8(@ptradd(buf, i), 0)
    if i == 0 {
        @free(buf)
        return ""
    }
    val result: ref u8 = @alloc(i + 1) as ref u8
    @memcpy(result, buf, (i + 1) as usize)
    @free(buf)
    return result
}

fn new_build_rule(platform: ref u8, arch: ref u8) ref SxBuildRule = trust {
    val rule: mut ref SxBuildRule = @alloc(@sizeof(SxBuildRule)) as mut ref SxBuildRule
    @memset(rule as ref void, 0, @sizeof(SxBuildRule))
    rule.platform = platform
    rule.arch = arch
    rule.action = ""
    rule.flags = ""
    rule.output = ""
    rule.entry = ""
    rule.envs = []
    return rule
}

fn parse_env_entries(ctx: mut ref ParseCtx, out: mut list[ref u8]) void = trust {
    ctx_skip_ws(ctx)
    if ctx_peek(ctx) == 123 {
        ctx_advance(ctx)
    }
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val env_name: ref u8 = ctx_read_ident(ctx)
        if str.raw_cmp(env_name, "") == 0 {
            break
        }
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == 61 {
            ctx_advance(ctx)
        }
        val env_value: ref u8 = ctx_read_env_value(ctx)
        @append(out, @fmtalloc("{s}={s}", {env_name, env_value}))
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

/// Parse one of the fields accepted inside a build config or rule block.
/// Returns false when `name` is not a field (for example a platform selector).
fn parse_override_field(
    ctx: mut ref ParseCtx,
    target: mut ref SxBuildRule,
    name: ref u8
) bool = trust {
    if str.raw_cmp(name, "action") == 0 {
        target.action = ctx_read_quoted(ctx)
        return true
    }
    if str.raw_cmp(name, "flags") == 0 {
        target.flags = ctx_read_quoted(ctx)
        return true
    }
    if str.raw_cmp(name, "output") == 0 {
        target.output = ctx_read_quoted(ctx)
        return true
    }
    if str.raw_cmp(name, "entry") == 0 {
        target.entry = ctx_read_quoted(ctx)
        return true
    }
    if str.raw_cmp(name, "env") == 0 {
        parse_env_entries(ctx, target.envs)
        return true
    }
    return false
}

fn parse_rule_fields(ctx: mut ref ParseCtx, rule: mut ref SxBuildRule) void = trust {
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val name: ref u8 = ctx_read_ident(ctx)
        if str.raw_cmp(name, "") == 0 {
            break
        }
        if !parse_override_field(ctx, rule, name) {
            ctx_skip_line(ctx)
        }
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

fn parse_build_body(ctx: mut ref ParseCtx, cfg: mut ref SxBuildConfig) void = trust {
    val base: mut ref SxBuildRule = new_build_rule("", "")
    cfg.base = base
    for {
        ctx_skip_ws(ctx)
        val c: i64 = ctx_peek(ctx)
        if c == -1 || c == 125 {
            break
        }
        val name: ref u8 = ctx_read_ident(ctx)
        if str.raw_cmp(name, "") == 0 {
            break
        }
        if parse_override_field(ctx, base, name) {
            continue
        }

        val name_len: i64 = str.len_raw(name)
        val dot: mut i64 = -1
        val di: mut i64 = 0
        for di < name_len {
            if @load8(@ptradd(name, di)) == (46 as u8) {
                dot = di
                break
            }
            di = di + (1 as i64)
        }
        val platform: mut ref u8 = name
        val arch: mut ref u8 = ""
        if dot >= 0 {
            platform = str.substr(name, 0, dot)
            arch = str.substr(name, dot + 1, name_len - dot - 1)
        }
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) != 123 {
            ctx_skip_line(ctx)
            continue
        }
        ctx_advance(ctx)
        val rule: mut ref SxBuildRule = new_build_rule(platform, arch)
        parse_rule_fields(ctx, rule)
        @append(cfg.rules, rule)
    }
    if ctx_peek(ctx) == 125 {
        ctx_advance(ctx)
    }
}

pub fn parse_sxmod(content: ref u8) ref SxMod = trust {
    val ctx: mut ref ParseCtx = new_ctx(content)
    val m: mut ref SxMod = @alloc(@sizeof(SxMod)) as ref SxMod
    @memset(m, 0, @sizeof(SxMod) as usize)
    m.entry = ""
    m.version = ""
    m.spectre_version = ""
    m.single_flags = ""
    m.deps = []
    m.builds = []
    for {
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == -1 {
            break
        }
        val kw: ref u8 = ctx_read_ident(ctx)
        if str.raw_cmp(kw, "") == 0 {
            break
        }
        if str.raw_cmp(kw, "entry") == 0 {
            m.entry = ctx_read_quoted(ctx)
        } elif str.raw_cmp(kw, "version") == 0 {
            m.version = ctx_read_quoted(ctx)
        } elif str.raw_cmp(kw, "spectre_version") == 0 {
            m.spectre_version = ctx_read_quoted(ctx)
        } elif str.raw_cmp(kw, "single_flags") == 0 {
            m.single_flags = ctx_read_quoted(ctx)
        } elif str.raw_cmp(kw, "dep") == 0 {
            @append(m.deps, ctx_read_quoted(ctx))
        } elif str.raw_cmp(kw, "build") == 0 {
            val cfg: mut ref SxBuildConfig = @alloc(@sizeof(SxBuildConfig)) as mut ref SxBuildConfig
            @memset(cfg as ref void, 0, @sizeof(SxBuildConfig))
            cfg.name = ctx_read_ident(ctx)
            cfg.base = none
            cfg.rules = []
            ctx_skip_ws(ctx)
            if ctx_peek(ctx) == 123 {
                ctx_advance(ctx)
            }
            parse_build_body(ctx, cfg)
            @append(m.builds, cfg)
        } else {
            ctx_skip_line(ctx)
        }
    }
    @free(ctx)
    return m
}

fn validate_sxmod(m: ref SxMod) bool = {
    if str.raw_cmp(m.entry, "") == 0 {
        return true
    }
    for cfg in m.builds {
        if str.raw_cmp(cfg.base.entry, "") != 0 {
            stdio.puts("error: sx.mod cannot mix a top-level 'entry' with per-build 'entry' fields")
            return false
        }
        for rule in cfg.rules {
            if str.raw_cmp(rule.entry, "") != 0 {
                stdio.puts("error: sx.mod cannot mix a top-level 'entry' with per-build 'entry' fields")
                return false
            }
        }
    }
    return true
}

fn validate_spectre_version(m: ref SxMod) bool = trust {
    val installed: ref u8 = meta.get_spectre_version()
    if str.raw_cmp(m.spectre_version, "") == 0 {
        stdio.puts("error: sx.mod is missing the required 'spectre_version' field")
        stdio.print("-> installed compiler: {s}\n", {installed})
        stdio.print("-> add this line to sx.mod: spectre_version \"{s}\"\n", {installed})
        return false
    }
    if str.raw_cmp(m.spectre_version, installed) != 0 {
        stdio.puts("error: Spectre version mismatch")
        stdio.print("  installed compiler:      {s}\n", {installed})
        stdio.print("  project spectre_version: {s}\n", {m.spectre_version})
        stdio.print(
            "  install the required compiler with: ./fw/install.sh -v {s}\n",
            {m.spectre_version}
        )
        stdio.puts("  or update 'spectre_version' in sx.mod to match the installed compiler")
        return false
    }
    return true
}

pub fn load_sxmod() option[ref SxMod] = {
    val size_opt = trust fs.file_size("sx.mod")
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: mut allocators.Arena = trust allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = trust fs.read_all[allocators.Arena](arena, "sx.mod")
    match content_opt {
        none => {
            trust allocators.Arena.free(arena)
            return none
        }
        some content => {
            val m: ref SxMod = trust parse_sxmod(content as ref u8)
            trust allocators.Arena.free(arena)
            if !validate_sxmod(m) {
                return none
            }
            return some m
        }
    }
}

fn parse_sxlock(content: ref u8) list[ref SxLockDep] = trust {
    val ctx: mut ref ParseCtx = new_ctx(content)
    val deps: mut list[ref SxLockDep] = []
    for {
        ctx_skip_ws(ctx)
        if ctx_peek(ctx) == -1 {
            break
        }
        val kw: ref u8 = ctx_read_ident(ctx)
        if str.raw_cmp(kw, "") == 0 {
            break
        }
        if str.raw_cmp(kw, "dep") == 0 {
            val url: ref u8 = ctx_read_quoted(ctx)
            val hash: ref u8 = ctx_read_quoted(ctx)
            if str.raw_cmp(url, "") != 0 && str.raw_cmp(hash, "") != 0 {
                val dep: mut ref SxLockDep = @alloc(@sizeof(SxLockDep)) as ref SxLockDep
                @memset(dep, 0, @sizeof(SxLockDep) as usize)
                dep.url = url
                dep.hash = hash
                @append(deps, dep)
            }
        } else {
            ctx_skip_line(ctx)
        }
    }
    @free(ctx)
    return deps
}

fn load_sxlock() option[list[ref SxLockDep]] = {
    val size_opt = trust fs.file_size("sx.lock")
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: mut allocators.Arena = trust allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = trust fs.read_all[allocators.Arena](arena, "sx.lock")
    match content_opt {
        none => {
            trust allocators.Arena.free(arena)
            return none
        }
        some content => {
            val deps: list[ref SxLockDep] = trust parse_sxlock(content as ref u8)
            trust allocators.Arena.free(arena)
            return some deps
        }
    }
}

fn load_sxmod_at(dir: ref u8) option[ref SxMod] = trust {
    val mod_path: ref u8 = path.join(dir, "sx.mod")
    val size_opt = fs.file_size(mod_path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: mut allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all[allocators.Arena](arena, mod_path)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return none
        }
        some content => {
            val m: ref SxMod = parse_sxmod(content as ref u8)
            allocators.Arena.free(arena)
            return some m
        }
    }
}

/// True when an sx.mod in `dir` describes a project (entry/build configs).
/// An sx.mod containing only `single_flags` is not a project root.
pub fn is_project_sxmod_at(dir: ref u8) bool = trust {
    val mod_opt = load_sxmod_at(dir)
    match mod_opt {
        none => {
            return false
        }
        some m => {
            if str.raw_cmp(m.entry, "") != 0 {
                return true
            }
            if @len(m.builds) > 0 {
                return true
            }
            return false
        }
    }
}

fn parent_dir(dir: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(dir)
    val end: mut i64 = len
    for {
        if end <= 1 {
            break
        }
        val c: u8 = @load8(@ptradd(dir, end - 1)) as u8
        if c == 47 || c == 92 {
            end--
        } else {
            break
        }
    }
    val i: mut i64 = end - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(dir, i)) as u8
        if c == 47 || c == 92 {
            if i == 0 {
                return "/"
            }
            return str.substr(dir, 0, i)
        }
        i--
    }
    return "."
}

/// Read the application version from the nearest sx.mod for a source file.
/// The same-directory manifest is checked first, then parent directories.
pub fn load_version_for(input: ref u8) ref u8 = trust {
    val raw_dir: ref u8 = path.dir(input)
    val start_dir: mut ref u8 = raw_dir
    if str.raw_cmp(raw_dir, ".") == 0 {
        val cwd_opt = fs.cwd_raw()
        if cwd_opt is some cwd {
            start_dir = cwd
        }
    }
    val same_opt = load_sxmod_at(start_dir)
    if same_opt is some same_mod {
        if str.raw_cmp(same_mod.version, "") != 0 {
            return same_mod.version
        }
    }

    val cur: mut ref u8 = start_dir
    val depth: mut i32 = 0 as i32
    for depth < (16 as i32) {
        val parent: ref u8 = parent_dir(cur)
        if str.raw_cmp(parent, cur) == 0 {
            break
        }
        cur = parent
        val mod_opt = load_sxmod_at(cur)
        if mod_opt is some found_mod {
            if str.raw_cmp(found_mod.version, "") != 0 {
                return found_mod.version
            }
        }
        if str.raw_cmp(cur, ".") == 0 || str.raw_cmp(cur, "/") == 0 {
            break
        }
        depth = depth + (1 as i32)
    }
    return ""
}

/// Read single_flags from an sx.mod next to the given source file.
/// Parent directories are deliberately not searched.
pub fn load_single_flags_for(input: ref u8) result[ref u8, ref u8] = trust {
    val dir: ref u8 = path.dir(input)
    val mod_opt = load_sxmod_at(dir)
    match mod_opt {
        none => {
            return ok ""
        }
        some m => {
            if str.raw_cmp(m.spectre_version, "") != 0 {
                if !validate_spectre_version(m) {
                    return err ""
                }
            }
            return ok m.single_flags
        }
    }
}

/// Split a single_flags value into command-line tokens.
pub fn split_single_flags(s: ref u8) list[ref u8] = trust {
    val out: mut list[ref u8] = []
    val len: i64 = str.len_raw(s)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i)) as u8
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= len {
                break
            }
            val c2: u8 = @load8(@ptradd(s, i)) as u8
            if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 {
                break
            }
            i++
        }
        @append(out, str.substr(s, start, i - start))
    }
    return out
}

fn load_sxlock_at(dir: ref u8) option[list[ref SxLockDep]] = trust {
    val lock_path: ref u8 = @fmtalloc("{s}/sx.lock", {dir})
    val size_opt = fs.file_size(lock_path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return none
    }
    val arena: mut allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all[allocators.Arena](arena, lock_path)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return none
        }
        some content => {
            val deps: list[ref SxLockDep] = parse_sxlock(content as ref u8)
            allocators.Arena.free(arena)
            return some deps
        }
    }
}

fn lock_hash_for_url(lock_deps: list[ref SxLockDep], url: ref u8) ref u8 = {
    for dep in lock_deps {
        if str.raw_cmp(dep.url, url) == 0 {
            return dep.hash
        }
    }
    return ""
}

fn build_rule_matches(rule: ref SxBuildRule) bool = trust {
    if str.raw_cmp(rule.platform, "") != 0 {
        if !builds.platform_matches_with_target(rule.platform, "") {
            return false
        }
    }
    if str.raw_cmp(rule.arch, "") != 0 {
        if !builds.arch_matches(rule.arch) {
            return false
        }
    }
    return true
}

fn apply_build_rule(target: mut ref SxBuildRule, source: ref SxBuildRule) void = {
    if str.raw_cmp(source.action, "") != 0 {
        target.action = source.action
    }
    if str.raw_cmp(source.flags, "") != 0 {
        target.flags = source.flags
    }
    if str.raw_cmp(source.output, "") != 0 {
        target.output = source.output
    }
    if str.raw_cmp(source.entry, "") != 0 {
        target.entry = source.entry
    }
    for env_entry in source.envs {
        @append(target.envs, env_entry)
    }
}

fn resolve_build_rule(cfg: ref SxBuildConfig, target: mut ref SxBuildRule) void = trust {
    target.platform = ""
    target.arch = ""
    target.action = ""
    target.flags = ""
    target.output = ""
    target.entry = ""
    target.envs = []
    apply_build_rule(target, cfg.base)
    for rule in cfg.rules {
        if build_rule_matches(rule) {
            apply_build_rule(target, rule)
        }
    }
}

fn build_config_cmd(cfg: ref SxBuildRule, exe_path: ref u8, entry: ref u8) ref u8 = trust {
    val cmd: mut ref u8 = ""
    if str.raw_cmp(cfg.action, "") != 0 {
        cmd = cfg.action
    } else {
        cmd = @fmtalloc("{s} {s} --no-single-flags", {exe_path, entry})
    }
    if str.raw_cmp(cfg.flags, "") != 0 {
        cmd = @fmtalloc("{s} {s}", {cmd, cfg.flags})
    }
    if str.raw_cmp(cfg.output, "") != 0 {
        cmd = @fmtalloc("{s} -o {s}", {cmd, cfg.output})
    }
    val nenv: i64 = @len(cfg.envs) as i64
    if nenv > 0 {
        if str.raw_cmp(cfg.action, "") == 0 {
            for e in cfg.envs {
                cmd = @fmtalloc("{s} -d{s}", {cmd, e})
            }
        } else {
            val prefix: mut ref u8 = ""
            for e in cfg.envs {
                prefix = @fmtalloc("{s}{s} ", {prefix, e})
            }
            cmd = @fmtalloc("{s}{s}", {prefix, cmd})
        }
    }
    return cmd
}

fn basename_of(path: ref u8) ref u8 = {
    val len: i64 = str.len_raw(path)
    if len == 0 {
        return "project"
    }
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = trust @load8(@ptradd(path, i)) as u8
        if c == 47 {
            last_slash = i
        }
        i++
    }
    val start: i64 = last_slash + 1
    val name_len: i64 = len - start
    if name_len <= 0 {
        return "project"
    }
    val buf: ref u8 = @alloc(name_len + 1) as ref u8
    trust @memcpy(buf, @ptradd(path, start), name_len as usize)
    trust @store8(@ptradd(buf, name_len), 0)
    return buf
}

fn repo_name_from_url(url: ref u8) ref u8 = trust {
    val url_len: i64 = str.len_raw(url)
    val url_end: mut i64 = url_len
    for {
        if url_end <= 0 {
            break
        }
        val last: u8 = @load8(@ptradd(url, url_end - 1)) as u8
        if last != 47 && last != 92 {
            break
        }
        url_end--
    }
    val clean_url: ref u8 = str.substr(url, 0, url_end)
    val base: ref u8 = basename_of(clean_url)
    val blen: i64 = str.len_raw(base)
    if blen > 4 {
        val a: u8 = @load8(@ptradd(base, blen - 4)) as u8
        val b: u8 = @load8(@ptradd(base, blen - 3)) as u8
        val c: u8 = @load8(@ptradd(base, blen - 2)) as u8
        val d: u8 = @load8(@ptradd(base, blen - 1)) as u8
        if a == 46 && b == 103 && c == 105 && d == 116 {
            val trimmed: ref u8 = @alloc(blen - 3) as ref u8
            @memcpy(trimmed, base, (blen - 4) as usize)
            @store8(@ptradd(trimmed, blen - 4), 0)
            return trimmed
        }
    }
    return base
}

fn raw_contains(haystack: ref u8, needle: ref u8) bool = {
    val hlen: i64 = str.len_raw(haystack)
    val nlen: i64 = str.len_raw(needle)
    if nlen == 0 {
        return true
    }
    if nlen > hlen {
        return false
    }
    val limit: i64 = hlen - nlen
    val i: mut i64 = 0
    for {
        if i > limit {
            break
        }
        val j: mut i64 = 0
        val matched: mut bool = true
        for {
            if j >= nlen {
                break
            }
            val x: u8 = trust @load8(@ptradd(haystack, i + j)) as u8
            val y: u8 = trust @load8(@ptradd(needle, j)) as u8
            if x != y {
                matched = false break
            }
            j++
        }
        if matched {
            return true
        }
        i++
    }
    return false
}

/// Rewrite filepath, dropping lines that start with dep_prefix AND contain needle.
fn drop_dep_lines(filepath: ref u8, needle: ref u8) void = trust {
    val size_opt = fs.file_size(filepath)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return
    }
    val arena: mut allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all[allocators.Arena](arena, filepath)
    match content_opt {
        none => {
            allocators.Arena.free(arena)
            return
        }
        some content => {
            val sb: ref void = str.StringBuilder.new()
            val text: ref u8 = content as ref u8
            val tlen: i64 = str.len_raw(text)
            val line_start: mut i64 = 0
            val i: mut i64 = 0
            for {
                if i > tlen {
                    break
                }
                val at_end: bool = i == tlen
                val c: mut u8 = 0
                if !at_end {
                    c = @load8(@ptradd(text, i)) as u8
                }
                if at_end || c == 10 {
                    val line_len: i64 = i - line_start
                    val line: ref u8 = @alloc(line_len + 1) as ref u8
                    @memcpy(line, @ptradd(text, line_start), line_len as usize)
                    @store8(@ptradd(line, line_len), 0)
                    val is_dep: bool = str.raw_starts_with(line, "dep ")
                    val has_needle: bool = raw_contains(line, needle)
                    if !(is_dep && has_needle) {
                        str.StringBuilder.append_cstr(sb, line)
                        if !at_end {
                            str.StringBuilder.append_char(sb, 10 as u8)
                        }
                    }
                    @free(line)
                    line_start = i + 1
                }
                i++
            }
            val result: ref void = str.StringBuilder.build(sb)
            allocators.Arena.free(arena)
            fs.write_all(filepath, str.cstr(result))
            str.StringBuilder.free(sb)
        }
    }
}

fn dep_name_matches(dep_url: ref u8, dep_name: ref u8) bool = trust {
    if str.raw_cmp(dep_name, "") == 0 {
        return true
    }
    val url_name: ref u8 = repo_name_from_url(dep_url)
    return str.raw_cmp(url_name, dep_name) == 0
}

fn set_lock_hash(filepath: ref u8, url: ref u8, hash: ref u8) void = trust {
    drop_dep_lines(filepath, url)
    fs.append_all(filepath, @fmtalloc("dep \"{s}\" \"{s}\"\n", {url, hash}))
}

fn upgrade_dir(
    base_dir: ref u8,
    dep_name: ref u8,
    matched: mut list[ref u8],
    visited: mut list[ref u8]
) i32 = trust {
    for v in visited {
        if str.raw_cmp(v, base_dir) == 0 {
            return 0
        }
    }
    @append(visited, base_dir)

    val ac: allocators.HeapAllocator = @zeroed
    val mod_opt = load_sxmod_at(base_dir)
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            return 0
        }
        some m => {
            sxmod = m
        }
    }

    val ndeps: i64 = @len(sxmod.deps) as i64
    if ndeps == 0 {
        return 0
    }

    val lock_opt = load_sxlock_at(base_dir)
    val lock_deps: mut list[ref SxLockDep] = []
    match lock_opt {
        none => {}
        some deps => {
            lock_deps = deps
        }
    }

    val lib_dir: ref u8 = @fmtalloc("{s}/lib", {base_dir})
    for dep_url in sxmod.deps {
        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("{s}/{s}", {lib_dir, name})

        if dep_name_matches(dep_url, dep_name) {
            if !is_directory(lib_path) {
                stdio.print("error: dependency '{s}' is not present at {s}\n", {dep_url, lib_path})
                stdio.puts("run 'spectre restore' first")
                return 1
            }

            @append(matched, dep_url)
            val old_hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
            stdio.print("Upgrading {s}...\n", {dep_url})

            val clone_res = git.clone[allocators.HeapAllocator](
                ac,
                dep_url,
                lib_path,
                ""
            )
            val new_hash: mut ref u8 = ""
            match clone_res {
                ok hash => {
                    new_hash = hash
                }
                err _ => {
                    stdio.print("error: failed to check out HEAD for {s}\n", {dep_url})
                    return 1
                }
            }

            set_lock_hash(@fmtalloc("{s}/sx.lock", {base_dir}), dep_url, new_hash)
            if str.raw_cmp(old_hash, "") == 0 {
                stdio.print("Upgraded '{s}' to {s}\n", {name, new_hash})
            } elif str.raw_cmp(old_hash, new_hash) == 0 {
                stdio.print("'{s}' is already up to date ({s})\n", {name, new_hash})
            } else {
                stdio.print("Upgraded '{s}' {s} -> {s}\n", {name, old_hash, new_hash})
            }
        }

        val sub_code: i32 = upgrade_dir(lib_path, dep_name, matched, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    return 0
}

pub fn cmd_upgrade(dep_name: ref u8) i32 = trust {
    if !os.exists("sx.mod") {
        stdio.puts("error: sx.mod not found, run 'spectre init' first")
        return 1
    }

    val matched: mut list[ref u8] = []
    val visited: mut list[ref u8] = []
    val code: i32 = upgrade_dir(".", dep_name, matched, visited)
    if code != 0 {
        return code
    }

    if (@len(matched) as i64) == 0 {
        if str.raw_cmp(dep_name, "") == 0 {
            stdio.puts("No dependencies to upgrade.")
            return 0
        }
        stdio.print("error: dependency '{s}' not found\n", {dep_name})
        return 1
    }

    return 0
}

fn add_stdlib_candidate(candidates: mut list[ref u8], dir: ref u8) void = trust {
    if str.raw_cmp(dir, "") == 0 {
        return
    }
    @append(candidates, dir)
}

fn is_directory(dir: ref u8) bool = trust {
    val handle: ref void = fs.opendir(dir)
    if handle == none {
        return false
    }
    fs.closedir(handle)
    return true
}

fn copy_current_stdlib(snapshot_dir: ref u8) bool = trust {
    val arena: mut allocators.Arena = allocators.Arena.new(4096 as usize)?
    val exe_path = reflection.get_exe_path[allocators.Arena](arena)
    val exe_dir = path.dir(exe_path)
    val candidates: mut list[ref u8] = []
    val stdlib_env = os.env("SPECTRE_STDLIB")

    if stdlib_env is some v {
        val dir: ref u8 = v as ref u8
        add_stdlib_candidate(candidates, dir)
        add_stdlib_candidate(candidates, path.join(dir, "spectrelib"))
    }

    val root_env = os.env("SPECTRE_ROOT")
    if root_env is some v {
        add_stdlib_candidate(candidates, path.join(v as ref u8, "spectrelib"))
    }

    add_stdlib_candidate(candidates, path.join(exe_dir, "spectrelib"))
    add_stdlib_candidate(candidates, path.join(exe_dir, "../share/spectre/spectrelib"))
    add_stdlib_candidate(candidates, path.join(exe_dir, "../lib/spectre/spectrelib"))
    add_stdlib_candidate(candidates, path.join(exe_dir, "../lib/spectrelib"))
    add_stdlib_candidate(candidates, "spectrelib")

    val std_dir: mut ref u8 = ""
    for candidate in candidates {
        if is_directory(candidate) {
            std_dir = candidate
            break
        }
    }

    if str.raw_cmp(std_dir, "") == 0 {
        stdio.puts("error: could not locate the Spectre standard library ('spectrelib')")
        stdio.print("  executable: {s}\n", {exe_path})
        stdio.print("  directory:  {s}\n", {exe_dir})
        stdio.puts("  looked in:")
        for candidate in candidates {
            stdio.print("    - {s}\n", {candidate})
        }
        stdio.puts("  set SPECTRE_STDLIB=/path/to/spectrelib to override")
        allocators.Arena.free(arena)
        return false
    }

    val its_ok: mut bool = os.copy_dir_recursive(std_dir, snapshot_dir)
    if !its_ok {
        stdio.puts("error: failed to copy the standard library")
        stdio.print("  from: {s}\n", {std_dir})
        stdio.print("  to:   {s}\n", {snapshot_dir})
        stdio.puts("  check that both directories are readable and writable")
    } else {
        val marker = path.join(snapshot_dir, "stdio/core.sx")
        if !os.exists(marker) {
            stdio.print(
                "error: standard library copy at {s} looks incomplete (missing {s})\n",
                {snapshot_dir, marker}
            )
            its_ok = false
        }
    }

    allocators.Arena.free(arena)
    return its_ok
}

pub fn cmd_ref() i32 = {
    val path: ref u8 = "SPECTRE_LANGUAGE_REFERENCE.md"
    val f_opt = trust fs.open(path, "w")
    match f_opt {
        none => {
            trust stdio.print("error: could not write {s}\n", {path})
            return 1
        }
        some f => {
            trust fs.write(f, \\ # Spectre Language Reference
                \\
                \\ ---
                \\
                \\ ## Comments
                \\
                \\ ```
                \\ // This is a line comment
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Variables
                \\
                \\ ```
                \\ val x: i64 = 42          // immutable binding
                \\ val y: mut i64 = 0       // mutable binding
                \\ y = y + 1
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Primitive Types
                \\
                \\ | Type    | Description              |
                \\ |---------|--------------------------|
                \\ | `i32`   | 32-bit signed integer    |
                \\ | `i64`   | 64-bit signed integer    |
                \\ | `u8`    | 8-bit unsigned integer   |
                \\ | `u32`   | 32-bit unsigned integer  |
                \\ | `u64`   | 64-bit unsigned integer  |
                \\ | `usize` | pointer-sized unsigned   |
                \\ | `f32`   | 32-bit float             |
                \\ | `f64`   | 64-bit float             |
                \\ | `bool`  | boolean (`true`/`false`) |
                \\ | `u8`  | single byte character    |
                \\ | `void`  | no value                 |
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Reference and Pointer Types
                \\
                \\ ```
                \\ val p: ref u8 = "hello"    // pointer to u8 (C string)
                \\ val q: mut ref i64 = ...     // reassignable pointer
                \\ ```
                \\
                \\ `ref T` is a raw pointer.  Null is written as `none`.
                \\
                \\ ---
                \\
                \\ ## List Type
                \\
                \\ ```
                \\ val xs: mut list[i64] = []
                \\ @append(xs, 1)
                \\ @append(xs, 2)
                \\ val n: usize = @len(xs)
                \\ val opt = @get(xs, 0)        // returns option[i64]
                \\ @remove(xs, 0)
                \\ @reserve(xs, 64)
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Option Type
                \\
                \\ ```
                \\ val a: option[i64] = some 42
                \\ val b: option[i64] = none
                \\
                \\ match a {
                \\     some v => { /* use v */ }
                \\     none   => { /* handle missing */ }
                \\ }
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Result Type
                \\
                \\ ```
                \\ val r: result[i64, ref u8] = ok 10
                \\ val e: result[i64, ref u8] = err "oops"
                \\
                \\ match r {
                \\     ok v  => { } // Use v
                \\     err e => { } // Handle the error
                \\ }
                \\ ```
                \\
                \\ Note that braces in match arms are not optional. You must use braces, for example:
                \\
                \\ ```
                \\ ok v => hello // INVALID
                \\ ok v => { return hello } // VALID if hello is defined and matches the return type
                \\ ```
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Strings
                \\
                \\ ```
                \\ val s: ref u8 = "hello"           // C string literal
                \\ val raw = \\ a raw string literal   // raw string (no escape processing)
                \\           \\ continued on next line // lines joined with \n
                \\ ```
                \\
                \\ The standard library (`std/string`) provides `String` (owned heap string)
                \\ and `StringBuilder` for building strings dynamically.
                \\
                \\ ---
                \\
                \\ ## Functions
                \\
                \\ ```
                \\ fn add(a: i64, b: i64) i64 = {
                \\     return a + b
                \\ }
                \\
                \\ pub fn greet(name: ref u8) void = {
                \\     @print("Hello, %s!\n", name)
                \\ }
                \\
                \\ pub enum SomeError = {
                \\     FailedToDoSomeThing
                \\     OrSomethingElse
                \\ }
                \\
                \\ // Functions that may propagate errors use result[T, E]
                \\ fn open_file(path: ref u8) result[ref void, SomeError] = {
                \\     // ... can use ? to propagate
                \\ }
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Namespaced Functions
                \\
                \\ ```
                \\ type Counter = {
                \\     value: mut i64
                \\ }
                \\
                \\ pub fn (Counter) new() ref Counter = {
                \\     val c: ref Counter = trust @alloc(@sizeof(Counter)) as ref Counter
                \\     // Note that "trust" needs to be used above as @alloc is an untrusted intrinsic
                \\     // as per the contract system.
                \\     c.value = 0
                \\     return c
                \\ }
                \\
                \\ pub fn (Counter) inc(s: mut self) void = {
                \\     s.value = s.value + 1
                \\ }
                \\
                \\ // Call site:
                \\ val c = Counter.new()
                \\ Counter.inc(c)
                \\ ```
                \\
                \\ `self` in a parameter position refers to the enclosing type.
                \\ `mut self` means the method may mutate the receiver.
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Control Flow
                \\
                \\ ```
                \\ // if / elif / else
                \\ if x > 0 {
                \\     // ...
                \\ } elif x == 0 {
                \\     // ...
                \\ } else {
                \\     // ...
                \\ }
                \\
                \\ // infinite loop with break
                \\ for {
                \\     if done { break }
                \\ }
                \\
                \\ // for-in over a list
                \\ for item in my_list {
                \\     // use item
                \\ }
                \\
                \\ // early return
                \\ return value
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Pattern Matching
                \\
                \\ ```
                \\ // option
                \\ match maybe_val {
                \\     some v => { /* v is the unwrapped value */ }
                \\     none   => { }
                \\ }
                \\
                \\ // result
                \\ match result_val {
                \\     ok v  => { }
                \\     err e => { }
                \\ }
                \\
                \\ // union
                \\ match shape {
                \\     Circle r    => { }
                \\     Rectangle w h => { }
                \\ }
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Type Definitions
                \\
                \\ ```
                \\ // struct
                \\ pub type Point = {
                \\     x: mut f64
                \\     y: mut f64
                \\ }
                \\
                \\ // union (tagged)
                \\ pub union Shape = {
                \\     Circle(f64) | Rectangle(f64, f64)
                \\ }
                \\
                \\ // enum
                \\ pub enum Color = {
                \\     Red
                \\     Green
                \\     Blue
                \\ }
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Modules
                \\
                \\ ```
                \\ // import a module
                \\ val io = use("std/stdio")
                \\ val mymod = use("path/to/module.sx")
                \\
                \\ // use it
                \\ io.puts("hello")
                \\
                \\ // pub makes a declaration visible to importers
                \\ pub fn my_fn() void = { }
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Contracts
                \\
                \\ ```
                \\ fn divide(a: i64, b: i64) i64 = {
                \\     pre  { nonzero: b != 0 }
                \\     post { result_valid: true }
                \\     return a / b
                \\ }
                \\
                \\ // guarded: contract violation checks persist in --release builds
                \\ fn safe_div(a: i64, b: i64) i64 = {
                \\     guarded pre { nonzero: b != 0 }
                \\     return a / b
                \\ }
                \\
                \\ // type level invariant: checked at compile time where possible
                \\ type SomeType = {
                \\     x: i32
                \\     y: i32
                \\
                \\     invariant {
                \\         x > 10 && y > 5
                \\     }
                \\ }
                \\
                \\ ```
                \\ // ! in return type means the function is untrusted as per the contract system
                \\ // this means that you would need to call this function read_file with the `trust`
                \\ // prefix, like:
                \\ //
                \\ // trust read_file("some_file.txt")
                \\ //
                \\ // Note that trust statements inside verified functions are redundant
                \\ // and will result in a compile-time error.
                \\ fn read_file(path: ref u8) result[ref u8, SomeError] = trust {
                \\     val f = some_fallible_call()?   // ? propagates err upward
                \\     return f
                \\ }
                \\ ```
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## Builtins
                \\
                \\ | Builtin                        | Description                              |
                \\ |-------------------------------|------------------------------------------|
                \\ | `@alloc(n)`                   | allocate n bytes, returns `ref void`, remember it is always better to use an allocator     |
                \\ | `@realloc(ptr, n)`            | resize allocation                        |
                \\ | `@free(ptr)`                  | free allocation                          |
                \\ | `@sizeof(T)`                  | size of type T in bytes                  |
                \\ | `@memcpy(dst, src, n)`        | copy n bytes                             |
                \\ | `@memset(dst, val, n)`        | fill n bytes with val                    |
                \\ | `@memmove(dst, src, n)`       | overlapping-safe copy                    |
                \\ | `@ptradd(ptr, n)`             | pointer arithmetic                       |
                \\ | `@load(ptr)`                  | load word from pointer                   |
                \\ | `@store(ptr, val)`            | store word to pointer                    |
                \\ | `@load8(ptr)`                 | load byte from pointer                   |
                \\ | `@store8(ptr, val)`           | store byte to pointer                    |
                \\ | `@bitcast(T, expr)`           | unsafe bitcast expr to type T            |
                \\ | `@append(list, val)`          | append to list                           |
                \\ | `@remove(list, i)`            | remove element at index i                |
                \\ | `@get(list, i)`               | get element at index (returns option)    |
                \\ | `@len(list)`                  | list length (returns usize)              |
                \\ | `@reserve(list, n)`           | reserve capacity                         |
                \\ | `@capacity(list)`             | current capacity                         |
                \\ | `@fmtalloc(fmt, {args})`      | heap-allocate a formatted string         |
                \\ | `@snprintf(buf, n, fmt, {})` | printf into a buffer                     |
                \\ | `@print(fmt, {args})`        | print to stdout                          |
                \\ | `@args()`                     | command-line arguments as `list[ref u8]` |
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## The `trust` Keyword
                \\
                \\ `trust expr` evaluates `expr` while suppressing all contract checks.
                \\ Use it when you have external guarantees that contracts cannot express.
                \\
                \\ ```
                \\ val ptr: ref void = trust @load(some_raw_ptr)
                \\ ```
                \\
                \\ ---
                \\
                \\ ## `assert`
                \\
                \\ ```
                \\ assert x > 0           // aborts if false
                \\ assert my_fn() == ok 1
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Platform Conditionals
                \\
                \\ ```
                \\ when linux   {  }
                \\ when darwin  {  }
                \\ when windows {  }
                \\ when posix   {  }
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Extern Functions
                \\
                \\ ```
                \\ extern (C) fn strlen(s: ref u8) i64 = "strlen"
                \\ extern (C) fn printf(fmt: ref u8, ...) i32 = "printf"
                \\ ```
                \\
                \\ ---
                \\
                \\ ## Tests
                \\
                \\ ```
                \\ test {
                \\     assert add(1, 2) == 3
                \\ }
                \\ ```
                \\
                \\ Run with: `spectre <file.sx> --test`
                \\
            )
            trust fs.write(f, \\ ---
                \\
                \\ ## sx.mod — This is the Project Manifest
                \\
                \\ ```
                \\ entry "./src/main.sx"
                \\ version "v0.0.1"
                \\ spectre_version "v0.0.12"
                \\
                \\ // Applied when this file is compiled/run directly.
                \\ single_flags "--dynamic --show-cmd"
                \\
                \\ dep "https://github.com/user/some-lib"
                \\
                \\ build release {
                \\     flags  "--release"
                \\     output "./myapp"
                \\ }
                \\
                \\ build dev {
                \\     output "./myapp-dev"
                \\     env {
                \\         GIT_HASH=abcdef
                \\     }
                \\     posix {
                \\         action "./scripts/notice.sh"
                \\     }
                \\     windows.x86_64 {
                \\         action "./scripts/notice.cmd"
                \\     }
                \\ }
                \\ ```
                \\
                \\ - `entry`   — source file passed to the compiler
                \\ - `version` — project version string (available as `env.get("SPECTRE_MOD_VERSION")`)
                \\ - `spectre_version` — required Spectre compiler version
                \\ - `single_flags` — default flags for standalone compile/run of files in this directory
                \\ - `dep`     — git dependency URL (cloned to `lib/`)
                \\ - `build`   — named build configuration
                \\   - `action`  — base shell command for this build config
                \\   - `flags`   — extra flags appended to the build command
                \\   - `output`  — `-o` output path appended to the build command
                \\   - `env`     — compile-time environment variables for this build
                \\   - `posix { ... }`, `windows { ... }` — per-platform overrides
                \\   - `posix.aarch64 { ... }`, `windows.x86_64 { ... }` — per-platform/arch overrides
                \\
                \\ Platform selectors: windows, linux, darwin, freebsd, openbsd, netbsd,
                \\ dragonflybsd, android, haiku, redox, plan9.
                \\ Group selectors: posix/unix (linux, darwin, the BSDs, android, haiku, redox)
                \\ and bsd (freebsd, openbsd, netbsd, dragonflybsd).
                \\
                \\ Platform/arch blocks override individual fields from the outer build
                \\ config. Matching blocks are applied in declaration order.
                \\
            )
            trust fs.close(f)
        }
    }

    val unix_time: i64 = time.unix_now()
    val std_snapshot_dir: ref u8 = trust @fmtalloc("std__{d}", {unix_time})
    if !(trust copy_current_stdlib(std_snapshot_dir)) {
        trust stdio.print("error: could not copy stdlib into {s}\n", {std_snapshot_dir})
        return 1
    }

    trust stdio.print("Generated SLR + Copied stdlib to {s}.\n", {std_snapshot_dir})
    return 0
}

pub fn cmd_init(name_arg: ref u8) i32 = {
    if os.exists("sx.mod") {
        stdio.puts("error: sx.mod already exists in this directory")
        return 1
    }

    val proj_name: mut ref u8 = name_arg
    if str.raw_cmp(proj_name, "") == 0 {
        val cwd_arena: mut allocators.Arena = trust allocators.Arena.new(4096 as usize)?
        val cwd_opt = trust fs.cwd[allocators.Arena](cwd_arena)
        if cwd_opt is some cwd {
            proj_name = basename_of(cwd)
        } else {
            proj_name = "my-project"
        }
        trust allocators.Arena.free(cwd_arena)
    }

    val sb: ref void = str.StringBuilder.new()
    val init_header: ref u8 = trust @fmtalloc(
        "entry \"./src/main.sx\"\nversion \"v0.0.1\"\nspectre_version \"{s}\"\n\nbuild release {\n    flags \"--release\"\n    output \"./",
        {meta.get_spectre_version()}
    )
    trust str.StringBuilder.append_cstr(sb, init_header)
    trust str.StringBuilder.append_cstr(sb, proj_name)
    trust str.StringBuilder.append_cstr(sb, "\"\n}\n\nbuild dev {\n    output \"./")
    trust str.StringBuilder.append_cstr(sb, proj_name)
    trust str.StringBuilder.append_cstr(sb, "-dev\"\n}\n")
    val sxmod_built: ref void = trust str.StringBuilder.build(sb)
    trust fs.write_all("sx.mod", str.cstr(sxmod_built))
    trust str.StringBuilder.free(sb)
    trust fs.write_all("sx.lock", "version \"1\"\n")
    trust fs.write_all(
        ".gitignore",
        "SPECTRE_LANGUAGE_REFERENCE.md\nlib/\nstd__*\ns-out/\ndocs-out/\n"
    )

    trust fs.mkdir_path("src")

    val main_template: ref u8 = \\val stdio = use("std/stdio")
    \\
    \\pub fn main() void = {
    \\    stdio.puts("Hello, world.")
    \\}
    \\
    trust fs.write_all("src/main.sx", main_template)
    trust stdio.print("Initialized project '{s}'\n", {proj_name})
    return 0
}

pub fn cmd_build(config_name: ref u8, exe_path: ref u8) i32 = {
    match load_sxmod() {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            if !trust validate_spectre_version(m) {
                return 1
            }

            val found_cfg: mut ref SxBuildConfig = none
            val builds: list[ref SxBuildConfig] = m.builds
            for cfg in builds {
                if str.raw_cmp(cfg.name, config_name) == 0 {
                    found_cfg = cfg
                    break
                }
            }
            if found_cfg == none {
                trust stdio.print("error: build config '{s}' not found in sx.mod\n", {config_name})
                return 1
            }

            val resolved: mut ref SxBuildRule = trust new_build_rule("", "")
            trust resolve_build_rule(found_cfg, resolved)

            val entry: mut ref u8 = m.entry
            if str.raw_cmp(resolved.entry, "") != 0 {
                entry = resolved.entry
            }
            val cmd: ref u8 = trust build_config_cmd(resolved, exe_path, entry)
            val exit_code: i32 = trust os.run(cmd)
            return exit_code
        }
    }
}

pub fn cmd_add(url: ref u8) i32 = trust {
    if !os.exists("sx.mod") {
        stdio.puts("error: sx.mod not found, run 'spectre init' first")
        return 1
    }

    val name: ref u8 = repo_name_from_url(url)
    val lib_path: ref u8 = @fmtalloc("lib/{s}", {name})

    if os.exists(lib_path) {
        stdio.print("error: dependency '{s}' already exists at {s}\n", {name, lib_path})
        return 1
    }

    fs.mkdir_path("lib")

    stdio.print("Cloning {s}...\n", {url})
    val ac: allocators.HeapAllocator = @zeroed
    val clone_res = git.clone[allocators.HeapAllocator](ac, url, lib_path, "")
    val hash: mut ref u8 = ""
    match clone_res {
        ok resolved_hash => {
            hash = resolved_hash
        }
        err _ => {
            stdio.print("error: failed to clone {s}\n", {url})
            return 1
        }
    }

    val dep_line: ref u8 = @fmtalloc("dep \"{s}\"\n", {url})
    fs.append_all("sx.mod", dep_line)

    val lock_line: ref u8 = @fmtalloc("dep \"{s}\" \"{s}\"\n", {url, hash})
    fs.append_all("sx.lock", lock_line)

    stdio.print("Added dependency '{s}' ({s})\n", {name, hash})
    return 0
}

pub fn cmd_remove(dep_name: ref u8) i32 = {
    if !os.exists("sx.mod") {
        stdio.puts("error: sx.mod not found")
        return 1
    }

    val lib_path: ref u8 = trust @fmtalloc("lib/{s}", {dep_name})
    if os.exists(lib_path) {
        when windows {
            trust os.run(@fmtalloc("rmdir /s /q {s}", {lib_path}))
        }
        when posix {
            trust os.run(@fmtalloc("rm -rf {s}", {lib_path}))
        }
        trust stdio.print("Removed {s}\n", {lib_path})
    } else {
        trust stdio.print("warning: {s} not found, updating manifests only\n", {lib_path})
    }

    trust drop_dep_lines("sx.mod", dep_name)
    trust drop_dep_lines("sx.lock", dep_name)
    trust stdio.print("Removed dependency '{s}'\n", {dep_name})
    return 0
}

fn restore_in_dir(base_dir: ref u8, visited: mut list[ref u8]) i32 = trust {
    for v in visited {
        if str.raw_cmp(v, base_dir) == 0 {
            return 0
        }
    }
    @append(visited, base_dir)

    val sxmod_opt = load_sxmod_at(base_dir)
    val sxmod: mut ref SxMod = none
    match sxmod_opt {
        none => {
            return 0
        }
        some m => {
            sxmod = m
        }
    }

    if ((@len(sxmod.deps) as i64) == 0) {
        return 0
    }

    val lock_opt = load_sxlock_at(base_dir)
    val lock_deps: mut list[ref SxLockDep] = []
    match lock_opt {
        none => {
            stdio.print("warning: no sx.lock in {s}, skipping transitive deps\n", {base_dir})
            return 0
        }
        some deps => {
            lock_deps = deps
        }
    }

    val ac: allocators.HeapAllocator = @zeroed
    val lib_dir: ref u8 = @fmtalloc("{s}/lib", {base_dir})
    if os.exists(lib_dir) {
        fs.remove_dir_all(lib_dir)
    }
    fs.mkdir_path(lib_dir)

    for dep_url in sxmod.deps {
        val hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
        if str.raw_cmp(hash, "") == 0 {
            stdio.print("error: '{s}' missing from sx.lock in {s}\n", {dep_url, base_dir})
            return 1
        }

        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("{s}/{s}", {lib_dir, name})
        stdio.print("Restoring {s}...\n", {dep_url})
        val checkout_hash: mut ref u8 = hash
        if str.raw_cmp(hash, "unknown") == 0 {
            checkout_hash = ""
        }
        val clone_res = git.clone[allocators.HeapAllocator](
            ac,
            dep_url,
            lib_path,
            checkout_hash
        )
        match clone_res {
            ok _ => {}
            err _ => {
                stdio.print("error: failed to restore {s}\n", {dep_url})
                return 1
            }
        }

        val sub_code: i32 = restore_in_dir(lib_path, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    return 0
}

pub fn cmd_restore() i32 = trust {
    val mod_opt = load_sxmod()
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            sxmod = m
        }
    }

    val lock_opt = load_sxlock()
    val lock_deps: mut list[ref SxLockDep] = []
    match lock_opt {
        none => {
            stdio.puts("error: sx.lock not found, add dependencies or generate a lockfile first")
            return 1
        }
        some deps => {
            lock_deps = deps
        }
    }

    if os.exists("lib") {
        fs.remove_dir_all("lib")
    }
    fs.mkdir_path("lib")

    val ac: allocators.HeapAllocator = @zeroed
    val visited: mut list[ref u8] = []
    @append(visited, ".")

    for dep_url in sxmod.deps {
        val hash: ref u8 = lock_hash_for_url(lock_deps, dep_url)
        if str.raw_cmp(hash, "") == 0 {
            stdio.print("error: dependency '{s}' is missing from sx.lock\n", {dep_url})
            return 1
        }

        val name: ref u8 = repo_name_from_url(dep_url)
        val lib_path: ref u8 = @fmtalloc("lib/{s}", {name})
        stdio.print("Restoring {s}...\n", {dep_url})
        val checkout_hash: mut ref u8 = hash
        if str.raw_cmp(hash, "unknown") == 0 {
            checkout_hash = ""
        }
        val clone_res = git.clone[allocators.HeapAllocator](
            ac,
            dep_url,
            lib_path,
            checkout_hash
        )
        match clone_res {
            ok _ => {}
            err _ => {
                stdio.print("error: failed to restore {s}\n", {dep_url})
                return 1
            }
        }

        val sub_code: i32 = restore_in_dir(lib_path, visited)
        if sub_code != 0 {
            return sub_code
        }
    }

    stdio.puts("Restored dependencies to ./lib")
    return 0
}

fn print_graph_node(
    base_dir: ref u8,
    name: ref u8,
    url: ref u8,
    prefix: ref u8,
    is_last: bool,
    visited: mut list[ref u8]
) void = trust {
    val conn: mut ref u8 = "├── "
    if is_last {
        conn = "└── "
    }

    val line: mut ref u8 = @fmtalloc("{s}{s}{s}", {prefix, conn, name})
    if str.raw_cmp(url, "") != 0 {
        line = @fmtalloc("{s} ({s})", {line, url})
    }
    stdio.puts(line)

    for v in visited {
        if str.raw_cmp(v, base_dir) == 0 {
            return
        }
    }
    @append(visited, base_dir)

    val child_mod_opt = load_sxmod_at(base_dir)
    match child_mod_opt {
        none => {
            return
        }
        some child_mod => {
            val ndeps: i64 = @len(child_mod.deps) as i64
            if ndeps == 0 {
                return
            }
            val child_prefix: mut ref u8 = @fmtalloc("{s}│   ", {prefix})
            if is_last {
                child_prefix = @fmtalloc("{s}    ", {prefix})
            }
            val i: mut i64 = 0
            for dep_url in child_mod.deps {
                val dep_name: ref u8 = repo_name_from_url(dep_url)
                val dep_dir: ref u8 = @fmtalloc("{s}/lib/{s}", {base_dir, dep_name})
                print_graph_node(dep_dir, dep_name, dep_url, child_prefix, i == ndeps - 1, visited)
                i++
            }
        }
    }
}

pub fn cmd_graph() i32 = trust {
    val mod_opt = load_sxmod()
    val sxmod: mut ref SxMod = none
    match mod_opt {
        none => {
            stdio.puts("error: sx.mod not found, run 'spectre init' first")
            return 1
        }
        some m => {
            sxmod = m
        }
    }

    val cwd_arena: mut allocators.Arena = allocators.Arena.new(4096 as usize)?
    val cwd_opt = fs.cwd[allocators.Arena](cwd_arena)
    val proj_name: mut ref u8 = "project"
    if cwd_opt is some cwd {
        proj_name = basename_of(cwd)
    }
    allocators.Arena.free(cwd_arena)

    if str.raw_cmp(sxmod.version, "") == 0 {
        stdio.puts(proj_name)
    } else {
        stdio.puts(@fmtalloc("{s} ({s})", {proj_name, sxmod.version}))
    }

    val ndeps: i64 = @len(sxmod.deps) as i64
    if ndeps == 0 {
        stdio.puts("(no dependencies)")
        return 0
    }

    val visited: mut list[ref u8] = []
    @append(visited, ".")

    val i: mut i64 = 0
    for dep_url in sxmod.deps {
        val dep_name: ref u8 = repo_name_from_url(dep_url)
        val dep_dir: ref u8 = @fmtalloc("lib/{s}", {dep_name})
        print_graph_node(dep_dir, dep_name, dep_url, "", i == ndeps - 1, visited)
        i++
    }

    return 0
}

pub fn cmd_clean() i32 = {
    if os.exists("s-out") {
        when windows {
            trust os.run("rmdir /s /q s-out")
        }
        when posix {
            trust os.run("rm -rf s-out")
        }
        stdio.puts("Removed s-out/")
    }
    trust os.delete(builds.get_tmp_path("spectre_output.ssa"))
    trust os.delete(builds.get_tmp_path("spectre_output.s"))
    trust os.delete(builds.get_tmp_path("spectre_test_bin"))
    stdio.puts("Clean complete.")
    return 0
}

fn tool_version(cmd: ref u8) ref u8 = {
    val res = trust os.exec(cmd)
    match res {
        ok v => {
            val raw: ref u8 = trust str.cstr(v)
            val raw_len: i64 = str.len_raw(raw)
            val end: mut i64 = raw_len
            for {
                if end <= 0 {
                    break
                }
                val c: u8 = trust @load8(@ptradd(raw, end - 1)) as u8
                if c == 10 || c == 13 {
                    end--
                } else {
                    break
                }
            }
            if end <= 0 {
                return "unknown"
            }
            val buf: ref u8 = @alloc(end + 1) as ref u8
            trust @memcpy(buf, raw, end as usize)
            trust @store8(@ptradd(buf, end), 0)
            return buf
        }
        err _ => {
            return "not found"
        }
    }
}

pub fn cmd_doctor() i32 = {
    trust stdio.print("Spectre Compiler {s}\n\n", {meta.get_spectre_version()})

    val platform_res = trust os.exec("uname -srm 2>&1")
    match platform_res {
        ok v => {
            trust stdio.print("os:      {s}", {str.cstr(v)})
        }
        err _ => {
            stdio.puts("os:      unknown")
        }
    }

    val qbe_ver: ref u8 = tool_version("qbe -d 2>&1")
    val qbe_installed_str: mut ref u8 = "installed"
    val arena: mut allocators.Arena = trust allocators.Arena.new(256 as usize)?
    val qbe_ver_string = trust str.from[allocators.Arena](arena, qbe_ver)
    val not_found = trust str.from[allocators.Arena](arena, "not found")
    if str.contains(qbe_ver_string, not_found) {
        qbe_installed_str = "not installed"
    }
    trust allocators.Arena.free(arena)
    trust stdio.print("qbe:     {s}\n", {qbe_installed_str})

    val cc_ver: ref u8 = tool_version("cc --version 2>&1 | head -1")
    trust stdio.print("cc:      {s}\n", {cc_ver})

    val git_ver: ref u8 = tool_version("git --version 2>&1")
    trust stdio.print("git:     {s}\n", {git_ver})

    val cwd_arena: mut allocators.Arena = trust allocators.Arena.new(4096 as usize)?
    val cwd_opt = trust fs.cwd[allocators.Arena](cwd_arena)
    if cwd_opt is some cwd {
        trust stdio.print("cwd:     {s}\n", {cwd})
    } else {
        stdio.puts("cwd:     unknown")
    }
    trust allocators.Arena.free(cwd_arena)

    if os.exists("sx.mod") {
        stdio.puts("sx.mod:  found")
    } else {
        stdio.puts("sx.mod:  not found")
    }

    return 0
}
