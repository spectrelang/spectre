/// Environment variable access used while building the compiler.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str        = use("std/string")
val allocators = use("std/allocators")

val heap: allocators.HeapAllocator = @zeroed

extern (C, header) fn getenv(name: ref u8) ref u8 = "getenv"

fn env_lookup(name: str.StringView) option[str.StringView] = trust {
    val key: str.CString = str.cstring_from_view[allocators.HeapAllocator](heap, name)
    defer {
        str.cstring_free[allocators.HeapAllocator](heap, key)
    }
    if key.ptr == none {
        return none
    }
    val value = getenv(key.ptr)
    if value == none {
        return none
    }
    return some str.view_cstr(value)
}

pub fn get(name: str.StringView) str.StringView = {
    match trust env_lookup(name) {
        some value => {
            return value
        }
        none => {
            return str.view_cstr("")
        }
    }
}

pub fn get_opt(name: str.StringView) option[str.StringView] = {
    return trust env_lookup(name)
}

pub fn has(name: str.StringView) bool = {
    match trust env_lookup(name) {
        some _ => {
            return true
        }
        none => {
            return false
        }
    }
}
