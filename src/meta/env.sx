/// Environment variable access used while building the compiler.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val str        = use("std/string")
val allocators = use("std/allocators")
val rt         = use("std/runtime")

fn cstr_heap() allocators.HeapAllocator = {
    return @zeroed
}

/// Look up an environment variable. A null view means "not set".
fn env_lookup(name: str.StringView) str.StringView = trust {
    val key: str.ZString = str.zstr_from[allocators.HeapAllocator](cstr_heap(), name)
    defer {
        str.zstr_free[allocators.HeapAllocator](cstr_heap(), key)
    }
    if key.ptr == none {
        return str.view(none, 0)
    }
    val value = rt.getenv(key.ptr)
    if value == none {
        return str.view(none, 0)
    }
    return str.from_cstr(value)
}

pub fn get(name: str.StringView) str.StringView = {
    val value: str.StringView = trust env_lookup(name)
    if value.ptr == none {
        return ""
    }
    return value
}

pub fn get_opt(name: str.StringView) option[str.StringView] = {
    val value: str.StringView = trust env_lookup(name)
    if value.ptr == none {
        return none
    }
    return some value
}

pub fn has(name: str.StringView) bool = {
    return trust env_lookup(name).ptr != none
}
