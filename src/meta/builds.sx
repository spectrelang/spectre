val os         = use("std/os")
val string     = use("std/string")
val fs         = use("std/fs")
val stdio      = use("std/stdio")
val path       = use("std/path")
val reflection = use("std/reflection")
val allocators = use("std/allocators")
val parser     = use("../ast/parser.sx")

/// Returns a platform-appropriate path for a temp file.
pub fn get_tmp_path(name: ref u8) ref u8 = trust {
    when windows {
        val tmp_dir: ref u8 = os.getenv("TEMP")
        if tmp_dir != none {
            return @fmt("{s}/{s}", {tmp_dir, name})
        }
        val tmp2: ref u8 = os.getenv("TMP")
        if tmp2 != none {
            return @fmt("{s}/{s}", {tmp2, name})
        }
        return @fmt("C:/Windows/Temp/{s}", {name})
    }
    return @fmt("/tmp/{s}", {name})
}

pub fn is_compiler_available(compiler: ref u8) bool = {
    return trust os.in_path(compiler)
}

pub fn select_alt_compiler(requested: ref u8) ref u8 = {
    if string.raw_cmp(requested, "") != 0 {
        return requested
    }
    if is_compiler_available("tcc") {
        return "tcc"
    }
    if is_compiler_available("clang") {
        return "clang"
    }
    return "cc"
}

pub fn compiler_warn_flag(compiler: ref u8) ref u8 = {
    if string.raw_cmp(compiler, "clang") == 0 {
        return "-Wno-everything"
    }
    return "-w"
}

/// Returns true when the host platform can produce a completely statically
/// linked executable.
pub fn supports_static_linking(platform: ref u8) bool = {
    if string.raw_cmp(platform, "linux") == 0 {
        return true
    }
    if string.raw_cmp(platform, "freebsd") == 0 {
        return true
    }
    if string.raw_cmp(platform, "openbsd") == 0 {
        return true
    }
    if string.raw_cmp(platform, "netbsd") == 0 {
        return true
    }
    if string.raw_cmp(platform, "dragonflybsd") == 0 {
        return true
    }
    return false
}

/// Returns the compiler driver flag used to request a fully static link, or an
/// empty string when static linking is disabled or unsupported on the platform.
pub fn static_link_flag(platform: ref u8, dynamic_linking: bool) ref u8 = {
    if dynamic_linking {
        return ""
    }
    if supports_static_linking(platform) {
        return "-static"
    }
    return ""
}

/// tcc cannot reliably produce fully static binaries, so it should not be used
/// when static linking is requested.
pub fn compiler_supports_static_linking(compiler: ref u8) bool = {
    if string.raw_cmp(compiler, "tcc") == 0 {
        return false
    }
    return true
}

/// Returns the compiler driver flag used to strip symbols, or an empty string
/// when symbols should be retained.
pub fn strip_link_flag(release_mode: bool) ref u8 = {
    if release_mode {
        return "-s"
    }
    return ""
}

pub fn parse_alt_compiler_arg(arg: ref u8) ref u8 = {
    if string.raw_starts_with(arg, "--alt=") {
        return trust @ptradd(arg, 6) as ref u8
    }
    return ""
}

pub fn filter_c_diagnostics(raw: ref u8) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    val len: i64 = string.len_raw(raw) as i64
    val ls: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        val at_end: bool = i == len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(raw, i)) as u8
        }
        if at_end || c == 10 {
            val line_len: i64 = i - ls
            if line_len > 0 {
                val first: u8 = @load8(@ptradd(raw, ls)) as u8
                val is_context: bool = first == 32 || first == 9
                if !is_context {
                    val ji: mut i64 = ls
                    for {
                        if ji >= ls + line_len {
                            break
                        }
                        string.StringBuilder.append_char(sb, @load8(@ptradd(raw, ji)) as u8)
                        ji++
                    }
                    string.StringBuilder.append_char(sb, 10 as u8)
                }
            }
            ls = i + 1
        }
        i++
    }
    val built: ref void = string.StringBuilder.build(sb)
    val out: ref u8 = string.cstr(built)
    string.StringBuilder.free(sb)
    return out
}

pub fn root_has_direct_links(items: list[ref parser.Node]) bool = {
    for item in items {
        if item.kind == parser.NK_LINK || item.kind == parser.NK_LIB {
            return true
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val when_items: list[ref parser.Node] = item.d1 as list[ref parser.Node]
            for w in when_items {
                if w.kind == parser.NK_LINK || w.kind == parser.NK_LIB {
                    return true
                }
            }
            val or_branches: ref void = item.d2 as ref void
            if or_branches != none {
                for ob in or_branches as list[ref parser.Node] {
                    val ob_items: list[ref parser.Node] = ob.d1 as list[ref parser.Node]
                    for obn in ob_items {
                        if obn.kind == parser.NK_LINK || obn.kind == parser.NK_LIB {
                            return true
                        }
                    }
                }
            }
            val owise: ref void = item.d3 as ref void
            if owise != none {
                for ow in owise as list[ref parser.Node] {
                    if ow.kind == parser.NK_LINK || ow.kind == parser.NK_LIB {
                        return true
                    }
                }
            }
        }
    }
    return false
}

pub fn input_is_in_std(input: ref u8, arena: ref allocators.Arena) bool = {
    if string.raw_starts_with(input, "std/") {
        return true
    }
    if string.raw_starts_with(input, "./std/") {
        return true
    }
    val input_string = trust string.from[allocators.Arena](arena, input)
    val std_segment = trust string.from[allocators.Arena](arena, "/std/")
    val in_std: bool = string.contains(input_string, std_segment)
    if in_std {
        return true
    }
    return false
}

pub fn pick_alt_backend(
    requested: ref u8,
    release_mode: bool,
    input: ref u8,
    root_items: list[ref parser.Node],
    arena: ref allocators.Arena
) ref u8 = {
    if string.raw_cmp(requested, "") != 0 {
        return requested
    }
    if release_mode {
        if is_compiler_available("clang") {
            return "clang"
        }
        if is_compiler_available("tcc") {
            return "tcc"
        }
        return "cc"
    }
    if !input_is_in_std(input, arena) && root_has_direct_links(root_items) {
        if is_compiler_available("clang") {
            return "clang"
        }
    }
    if is_compiler_available("tcc") {
        return "tcc"
    }
    if is_compiler_available("clang") {
        return "clang"
    }
    return "cc"
}

pub fn append_debug_runtime_links(
    links: mut list[ref u8],
    exe_dir: ref u8,
    quiet: bool,
    release_mode: bool,
    arena: ref allocators.Arena
) void = trust {
    if release_mode {
        return
    }
    val panic_o: ref u8 = path.join(exe_dir, "spectrelib/csources/panic_handler.o")
    val panic_f = fs.open(panic_o, "r")
    if panic_f is some h {
        fs.close(h)
        @append(links, panic_o)
    } else {
        if !quiet {
            stdio.print("warning: panic_handler.o not found at: {s}\n", {panic_o})
        }
    }
    val platform: ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    if string.raw_cmp(platform, "windows") == 0 {
        @append(links, "-lDbgHelp")
    }
}
