val os         = use("std/os")
val cstr       = use("std/string/cstr")
val ostr       = use("std/string/owned")
val builder    = use("std/string/builder")
val fs         = use("std/fs")
val stdio      = use("std/stdio")
val path       = use("std/path")
val reflection = use("std/reflection")
val allocators = use("std/allocators")
val random     = use("std/crypto/random")
val mem        = use("../meta/mem.sx")
val parser     = use("../ast/parser.sx")

/// Join a temporary directory and file name using a tracked allocation.
fn tmp_join(dir: ref u8, name: ref u8) ref u8 = trust {
    val dlen: i64 = cstr.len(dir)
    val nlen: i64 = cstr.len(name)
    val out: ref u8 = @alloc((dlen + nlen + 2) as usize) as ref u8
    @memcpy(out, dir, dlen as usize)
    @store8(@ptradd(out, dlen), 47)
    @memcpy(@ptradd(out, dlen + 1), name, (nlen + 1) as usize)
    return out
}

/// Quote a path or argument for use in a shell command.
pub fn quote_arg(value: ref u8) ref u8 = trust {
    if value == none {
        return value
    }
    return @fmtalloc("\"{s}\"", {value})
}

/// Returns a platform-appropriate path for a temp file.
pub fn get_tmp_path(name: ref u8) ref u8 = trust {
    when windows {
        val tmp_dir: ref u8 = os.getenv(c"TEMP")
        if tmp_dir != none {
            return tmp_join(tmp_dir, name)
        }
        val tmp2: ref u8 = os.getenv(c"TMP")
        if tmp2 != none {
            return tmp_join(tmp2, name)
        }
        return tmp_join(c"C:/Windows/Temp", name)
    }
    return tmp_join(c"/tmp", name)
}

/// Returns a unique platform-appropriate temp path for a build artifact.
///
/// A UUID is inserted immediately before the file extension (or appended when
/// there is no extension), so concurrent compiler invocations never share the
/// intermediate `.c`, `.s`, `.ssa`, object, or test binary paths.
pub fn get_unique_tmp_path(name: ref u8) ref u8 = trust {
    val path_name: ref u8 = get_tmp_path(name)
    val guid: ref u8 = random.random_uuid()
    val n: i64 = cstr.len(path_name)
    val sep: mut i64 = -1
    val si: mut i64 = n - 1
    for {
        if si < 0 {
            break
        }
        val sc: u8 = @load8(@ptradd(path_name, si)) as u8
        if sc == 47 || sc == 92 {
            sep = si
            break
        }
        si--
    }
    val dot: mut i64 = -1
    val i: mut i64 = n - 1
    for {
        if i <= sep {
            break
        }
        if @load8(@ptradd(path_name, i)) == 46 {
            dot = i
            break
        }
        i--
    }
    val cap: i64 = n + 80
    val out: ref u8 = @alloc(cap as usize) as ref u8
    if dot < 0 {
        @snprintf(out, cap, "{s}_{s}", {path_name, guid})
    } else {
        if dot > 0 {
            @memcpy(out, path_name, dot as usize)
        }
        @snprintf(
            @ptradd(out, dot),
            cap - dot,
            "_{s}{s}",
            {guid, @ptradd(path_name, dot)}
        )
    }
    @free(guid)
    @free(path_name)
    return out
}

pub fn is_compiler_available(compiler: ref u8) bool = {
    if trust os.in_path(compiler) {
        return true
    }
    when windows {
        if !cstr.ends_with(compiler, c".exe") {
            val exe_name: ref u8 = trust @fmtalloc("{s}.exe", {compiler})
            val found: bool = trust os.in_path(exe_name)
            trust @free(exe_name)
            return found
        }
    }
    return false
}

pub fn select_alt_compiler(requested: ref u8) ref u8 = {
    if cstr.cmp(requested, c"") != 0 {
        return requested
    }
    if is_compiler_available(c"clang") {
        return c"clang"
    }
    when windows {
        if is_compiler_available(c"clang-cl") {
            return c"clang-cl"
        }
        if is_compiler_available(c"cl") {
            return c"cl"
        }
    }
    if is_compiler_available(c"gcc") {
        return c"gcc"
    }
    if is_compiler_available(c"cc") {
        return c"cc"
    }
    if is_compiler_available(c"tcc") {
        return c"tcc"
    }
    return c"cc"
}

/// Classify an alternative-backend C compiler driver.
///
/// "gnu" covers GCC, Clang, MinGW and Apple Clang. "clang-cl" is Clang's
/// MSVC-compatible driver. "msvc" is cl.exe. "tcc" is TinyCC.
pub fn alt_compiler_kind(compiler: ref u8) ref u8 = {
    if cstr.len(compiler) == 0 {
        return c"unknown"
    }
    if cstr.cmp(compiler, c"tcc") == 0
    || cstr.ends_with(compiler, c"tcc.exe") {
        return c"tcc"
    }
    if cstr.cmp(compiler, c"clang-cl") == 0
    || cstr.ends_with(compiler, c"clang-cl.exe") {
        return c"clang-cl"
    }
    if cstr.cmp(compiler, c"cl") == 0
    || cstr.ends_with(compiler, c"\\cl.exe")
    || cstr.ends_with(compiler, c"/cl.exe") {
        return c"msvc"
    }
    return c"gnu"
}

pub fn compiler_uses_msvc_flags(kind: ref u8) bool = {
    return cstr.cmp(kind, c"msvc") == 0
    || cstr.cmp(kind, c"clang-cl") == 0
}

pub fn compiler_uses_gnu_vectors(kind: ref u8) bool = {
    return cstr.cmp(kind, c"gnu") == 0
    || cstr.cmp(kind, c"clang-cl") == 0
}

/// Return the SIMD backend to use for the alt code generator.
///
/// 0 = GNU/Clang vector extensions, 1 = MSVC intrinsics, 2 = scalar only.
pub fn alt_simd_backend(compiler: ref u8, platform: ref u8, arch: ref u8) i64 = {
    if cstr.cmp(platform, c"windows") != 0
    && cstr.cmp(platform, c"linux") != 0
    && cstr.cmp(platform, c"darwin") != 0 {
        return 2
    }
    if cstr.cmp(arch, c"x86_64") != 0
    && cstr.cmp(arch, c"aarch64") != 0 {
        return 2
    }
    val kind: ref u8 = alt_compiler_kind(compiler)
    if compiler_uses_gnu_vectors(kind) {
        return 0
    }
    if cstr.cmp(kind, c"msvc") == 0 {
        return 1
    }
    return 2
}

pub fn compiler_std_flag(kind: ref u8) ref u8 = {
    if cstr.cmp(kind, c"msvc") == 0 {
        return c"/std:c11"
    }
    if cstr.cmp(kind, c"clang-cl") == 0 {
        return c"-std=c11"
    }
    return c"-std=c99"
}

pub fn compiler_opt_flag(kind: ref u8, release_mode: bool) ref u8 = {
    if compiler_uses_msvc_flags(kind) {
        if release_mode {
            return c"/O2"
        }
        return c"/Od /Zi"
    }
    if release_mode {
        return c"-O3"
    }
    return c"-g"
}

pub fn compiler_warn_flag(compiler: ref u8) ref u8 = {
    val kind: ref u8 = alt_compiler_kind(compiler)
    if compiler_uses_msvc_flags(kind) {
        return c"/W0"
    }
    if cstr.cmp(compiler, c"clang") == 0 {
        return c"-Wno-everything"
    }
    return c"-w"
}

pub fn compiler_native_flags(
    kind: ref u8,
    platform: ref u8,
    arch: ref u8,
    native_mode: bool
) ref u8 = {
    if !native_mode {
        return c""
    }
    if compiler_uses_msvc_flags(kind) {
        if cstr.cmp(arch, c"x86_64") == 0 {
            return c"/arch:AVX2"
        }
        return c""
    }
    if cstr.cmp(kind, c"gnu") != 0 {
        return c""
    }
    if cstr.cmp(platform, c"darwin") == 0
    && cstr.cmp(arch, c"aarch64") == 0 {
        return c""
    }
    if cstr.cmp(arch, c"x86_64") == 0 {
        return c"-march=native"
    }
    if cstr.cmp(arch, c"aarch64") == 0 {
        return c"-mcpu=native"
    }
    return c""
}

pub fn compiler_unroll_flag(kind: ref u8, unroll_mode: bool) ref u8 = {
    if unroll_mode && cstr.cmp(kind, c"gnu") == 0 {
        return c"-funroll-loops"
    }
    return c""
}

pub fn compiler_include_flag(kind: ref u8, path: ref u8) ref u8 = trust {
    if compiler_uses_msvc_flags(kind) {
        return @fmtalloc("/I\"{s}\"", {path})
    }
    return @fmtalloc("-I\"{s}\"", {path})
}

pub fn compiler_strip_flag(kind: ref u8, release_mode: bool) ref u8 = {
    if !release_mode {
        return c""
    }
    if compiler_uses_msvc_flags(kind) {
        return c""
    }
    return c"-s"
}

pub fn translate_link_flag(kind: ref u8, flag: ref u8) ref u8 = trust {
    if !compiler_uses_msvc_flags(kind) {
        return flag
    }
    if cstr.cmp(flag, c"-pthread") == 0 {
        return c""
    }
    if cstr.starts_with(flag, c"-l") {
        val name: ref u8 = cstr.substr(flag, 2, cstr.len(flag) - 2)
        return @fmtalloc("{s}.lib", {name})
    }
    return flag
}

/// Runtime modes supported by the compiler.
pub fn runtime_is_freestanding(mode: ref u8) bool = {
    return cstr.cmp(mode, c"freestanding") == 0
}

pub fn runtime_is_hosted(mode: ref u8) bool = {
    return cstr.cmp(mode, c"hosted") == 0
}

/// Returns true when a runtime mode is meaningful for the target.
pub fn runtime_supported(platform: ref u8, arch: ref u8, mode: ref u8) bool = {
    if runtime_is_hosted(mode) {
        return true
    }
    if !runtime_is_freestanding(mode) {
        return false
    }
    if cstr.cmp(platform, c"linux") == 0 {
        return cstr.cmp(arch, c"x86_64") == 0
        || cstr.cmp(arch, c"aarch64") == 0
    }
    if cstr.cmp(platform, c"windows") == 0 {
        return cstr.cmp(arch, c"x86_64") == 0
        || cstr.cmp(arch, c"aarch64") == 0
    }
    return false
}

/// Cache directory for prebuilt freestanding runtime objects.
pub fn freestanding_runtime_cache_dir(platform: ref u8, arch: ref u8) ref u8 = trust {
    val base: mut ref u8 = c"/tmp/spectre-runtime-cache"
    when windows {
        val tmp: ref u8 = os.getenv(c"TEMP")
        if tmp != none {
            base = @fmtalloc("{s}/spectre-runtime-cache", {tmp})
        }
    }
    fs.mkdir_path_cstr(base)
    val dir: ref u8 = @fmtalloc("{s}/{s}.{s}", {base, platform, arch})
    fs.mkdir_path_cstr(dir)
    return dir
}

/// Compute a stable cache path for a runtime/start object.
pub fn freestanding_cache_path(
    platform: ref u8,
    arch: ref u8,
    name: ref u8
) ref u8 = trust {
    val dir: ref u8 = freestanding_runtime_cache_dir(platform, arch)
    return @fmtalloc("{s}/{s}", {dir, name})
}

/// Path to the freestanding runtime source shipped beside the compiler.
pub fn freestanding_runtime_source(exe_dir: ref u8) ref u8 = trust {
    return path.join_cstr(exe_dir, c"spectrelib/csources/freestanding/runtime.c")
}

/// Path to the Linux freestanding entry stub, or an empty string when the
/// platform does not use an assembly entry.
pub fn freestanding_start_source(exe_dir: ref u8, platform: ref u8, arch: ref u8) ref u8 = trust {
    if cstr.cmp(platform, c"linux") != 0 {
        if cstr.cmp(platform, c"windows") == 0 {
            if cstr.cmp(arch, c"aarch64") == 0 {
                return path.join_cstr(
                    exe_dir,
                    c"spectrelib/csources/freestanding/start_windows_aarch64.S"
                )
            }
            return path.join_cstr(
                exe_dir,
                c"spectrelib/csources/freestanding/start_windows_x86_64.S"
            )
        }
        return c""
    }
    if cstr.cmp(arch, c"aarch64") == 0 {
        return path.join_cstr(exe_dir, c"spectrelib/csources/freestanding/start_linux_aarch64.S")
    }
    return path.join_cstr(exe_dir, c"spectrelib/csources/freestanding/start_linux_x86_64.S")
}

/// Compiler flags shared by freestanding runtime/translation-unit compiles.
pub fn freestanding_c_flags() ref u8 = {
    return c"-ffreestanding -nostdinc -fno-builtin -fno-stack-protector -fno-common -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections"
}

/// Link flags for the freestanding Windows runtime.
pub fn freestanding_windows_link_flags(kind: ref u8) ref u8 = {
    if cstr.cmp(kind, c"tcc") == 0 {
        return c"-nostdlib"
    }
    if cstr.cmp(kind, c"msvc") == 0 {
        return c"/link /nodefaultlib /entry:mainCRTStartup /opt:ref"
    }
    return c"-nostdlib -Wl,/nodefaultlib,/entry:mainCRTStartup"
}

/// Optional architecture flags for freestanding compiles.
pub fn freestanding_arch_flags(arch: ref u8) ref u8 = {
    if cstr.cmp(arch, c"aarch64") == 0 {
        return c""
    }
    return c""
}

/// Default import libraries used by the freestanding Windows runtime.
pub fn freestanding_windows_import_libs() ref u8 = {
    return c"kernel32.lib shell32.lib bcrypt.lib ws2_32.lib"
}

/// Build a deterministic import library from a DLL and symbol list using
/// llvm-dlltool. Returns the generated library path, or an empty string.
pub fn generate_windows_import_library(
    cache_dir: ref u8,
    dll: ref u8,
    symbols: list[ref u8],
    arch: ref u8
) ref u8 = trust {
    if (@len(symbols) as i64) == 0 {
        return c""
    }
    val machine: mut ref u8 = c"i386:x86-64"
    if cstr.cmp(arch, c"aarch64") == 0 {
        machine = c"arm64"
    }
    val def_path: ref u8 = @fmtalloc("{s}/{s}.def", {cache_dir, dll})
    val lib_path: ref u8 = @fmtalloc("{s}/{s}_{s}.lib", {cache_dir, dll, arch})
    val f = os.open(def_path, c"w")
    if f is some fh {
        val header: ref u8 = @fmtalloc("LIBRARY {s}.dll\nEXPORTS\n", {dll})
        os.write(fh, header, cstr.len(header) as i64)
        for sym in symbols {
            val line: ref u8 = @fmtalloc("    {s}\n", {sym})
            os.write(fh, line, cstr.len(line) as i64)
        }
        os.close(fh)
    } else {
        return c""
    }
    val dlltool: mut ref u8 = c"llvm-dlltool"
    if !is_compiler_available(dlltool) {
        if is_compiler_available(c"llvm-dlltool-18") {
            dlltool = c"llvm-dlltool-18"
        } elif is_compiler_available(c"llvm-dlltool-15") {
            dlltool = c"llvm-dlltool-15"
        } else {
            return c""
        }
    }
    val cmd: ref u8 = @fmtalloc(
        "{s} -m {s} -d {s} -l {s} 2>&1",
        {
            dlltool,
            machine,
            quote_arg(def_path),
            quote_arg(lib_path)
        }
    )
    val res = os.exec(cmd)
    match res {
        ok _ => {
            if os.exists(lib_path) {
                return lib_path
            }
            return c""
        }
        err _ => {
            return c""
        }
    }
}

/// Create (or reuse) a cache directory for generated Windows import libraries.
pub fn windows_import_cache_dir(arch: ref u8) ref u8 = trust {
    val base: mut ref u8 = c"/tmp/spectre-freestanding-imports"
    when windows {
        val tmp: ref u8 = os.getenv(c"TEMP")
        if tmp != none {
            base = @fmtalloc("{s}/spectre-freestanding-imports", {tmp})
        }
    }
    fs.mkdir_path_cstr(base)
    val dir: ref u8 = @fmtalloc("{s}/{s}", {base, arch})
    fs.mkdir_path_cstr(dir)
    return dir
}

/// Returns a comma-separated list of import libraries synthesized for the
/// freestanding Windows runtime.
pub fn freestanding_windows_import_flags(arch: ref u8) ref u8 = trust {
    val cache: ref u8 = windows_import_cache_dir(arch)
    val kernel: mut list[ref u8] = mem.new[ref u8]()
    @append(kernel, c"GetStdHandle")
    @append(kernel, c"WriteFile")
    @append(kernel, c"ReadFile")
    @append(kernel, c"CloseHandle")
    @append(kernel, c"CreateFileA")
    @append(kernel, c"SetFilePointer")
    @append(kernel, c"SetFilePointerEx")
    @append(kernel, c"GetFileSizeEx")
    @append(kernel, c"ExitProcess")
    @append(kernel, c"GetCurrentProcessId")
    @append(kernel, c"GetCurrentThreadId")
    @append(kernel, c"GetCurrentProcess")
    @append(kernel, c"GetSystemTimeAsFileTime")
    @append(kernel, c"GetLocalTime")
    @append(kernel, c"Sleep")
    @append(kernel, c"GetProcessHeap")
    @append(kernel, c"HeapAlloc")
    @append(kernel, c"HeapFree")
    @append(kernel, c"VirtualAlloc")
    @append(kernel, c"VirtualFree")
    @append(kernel, c"GetEnvironmentVariableA")
    @append(kernel, c"GetCurrentDirectoryA")
    @append(kernel, c"SetCurrentDirectoryA")
    @append(kernel, c"GetFullPathNameA")
    @append(kernel, c"GetFileAttributesA")
    @append(kernel, c"CreateDirectoryA")
    @append(kernel, c"RemoveDirectoryA")
    @append(kernel, c"DeleteFileA")
    @append(kernel, c"MoveFileA")
    @append(kernel, c"CopyFileA")
    @append(kernel, c"FindFirstFileA")
    @append(kernel, c"FindNextFileA")
    @append(kernel, c"FindClose")
    @append(kernel, c"CreateProcessA")
    @append(kernel, c"CreatePipe")
    @append(kernel, c"SetHandleInformation")
    @append(kernel, c"WaitForSingleObject")
    @append(kernel, c"GetExitCodeProcess")
    @append(kernel, c"CreateThread")
    @append(kernel, c"InitializeCriticalSection")
    @append(kernel, c"DeleteCriticalSection")
    @append(kernel, c"EnterCriticalSection")
    @append(kernel, c"LeaveCriticalSection")
    @append(kernel, c"SwitchToThread")
    @append(kernel, c"WideCharToMultiByte")
    @append(kernel, c"GetCommandLineW")
    @append(kernel, c"LocalFree")
    @append(kernel, c"GetModuleFileNameA")
    @append(kernel, c"SetConsoleOutputCP")

    val shell: mut list[ref u8] = mem.new[ref u8]()
    @append(shell, c"CommandLineToArgvW")

    val bcrypt: mut list[ref u8] = mem.new[ref u8]()
    @append(bcrypt, c"BCryptGenRandom")

    val ws2: mut list[ref u8] = mem.new[ref u8]()
    @append(ws2, c"WSAStartup")
    @append(ws2, c"WSACleanup")
    @append(ws2, c"socket")
    @append(ws2, c"bind")
    @append(ws2, c"listen")
    @append(ws2, c"accept")
    @append(ws2, c"connect")
    @append(ws2, c"send")
    @append(ws2, c"recv")
    @append(ws2, c"sendto")
    @append(ws2, c"recvfrom")
    @append(ws2, c"setsockopt")
    @append(ws2, c"closesocket")
    @append(ws2, c"htons")
    @append(ws2, c"ntohs")
    @append(ws2, c"WSAPoll")
    @append(ws2, c"ioctlsocket")

    val out: mut ref u8 = c""
    val kernel_lib: ref u8 = generate_windows_import_library(cache, c"kernel32", kernel, arch)
    val shell_lib: ref u8 = generate_windows_import_library(cache, c"shell32", shell, arch)
    val bcrypt_lib: ref u8 = generate_windows_import_library(cache, c"bcrypt", bcrypt, arch)
    val ws2_lib: ref u8 = generate_windows_import_library(cache, c"ws2_32", ws2, arch)
    if cstr.len(kernel_lib) > 0 {
        out = @fmtalloc("{s} {s}", {out, quote_arg(kernel_lib)})
    }
    if cstr.len(shell_lib) > 0 {
        out = @fmtalloc("{s} {s}", {out, quote_arg(shell_lib)})
    }
    if cstr.len(bcrypt_lib) > 0 {
        out = @fmtalloc("{s} {s}", {out, quote_arg(bcrypt_lib)})
    }
    if cstr.len(ws2_lib) > 0 {
        out = @fmtalloc("{s} {s}", {out, quote_arg(ws2_lib)})
    }
    return out
}
/// Returns true when a link list contains a library that is not part of the
/// freestanding runtime (and therefore requires the hosted toolchain).
pub fn links_require_hosted(links: list[ref u8]) bool = trust {
    for flag in links {
        if cstr.cmp(flag, c"") == 0 {
            continue
        }
        if cstr.starts_with(flag, c"-L") || cstr.starts_with(flag, c"-Wl,") {
            continue
        }
        if cstr.cmp(flag, c"-pthread") == 0 {
            continue
        }
        if cstr.starts_with(flag, c"-l") {
            val name: ref u8 = cstr.substr(flag, 2, cstr.len(flag) - 2)
            if cstr.cmp(name, c"m") == 0
            || cstr.cmp(name, c"dl") == 0
            || cstr.cmp(name, c"rt") == 0
            || cstr.cmp(name, c"c") == 0
            || cstr.cmp(name, c"gcc") == 0
            || cstr.cmp(name, c"gcc_s") == 0
            || cstr.cmp(name, c"pthread") == 0
            || cstr.cmp(name, c"bcrypt") == 0
            || cstr.cmp(name, c"dbghelp") == 0 {
                continue
            }
            return true
        }
        if cstr.ends_with(flag, c".lib")
        || cstr.ends_with(flag, c".a")
        || cstr.ends_with(flag, c".so")
        || cstr.ends_with(flag, c".c")
        || cstr.ends_with(flag, c".o")
        || cstr.ends_with(flag, c".obj") {
            return true
        }
    }
    return false
}

pub fn supports_static_linking(platform: ref u8) bool = {
    if cstr.cmp(platform, c"linux") == 0 {
        return true
    }
    if cstr.cmp(platform, c"freebsd") == 0 {
        return true
    }
    if cstr.cmp(platform, c"openbsd") == 0 {
        return true
    }
    if cstr.cmp(platform, c"netbsd") == 0 {
        return true
    }
    if cstr.cmp(platform, c"dragonflybsd") == 0 {
        return true
    }
    return false
}

/// Returns the compiler driver flag used to request a fully static link, or an
/// empty string when static linking is disabled or unsupported on the platform.
pub fn static_link_flag(platform: ref u8, dynamic_linking: bool) ref u8 = {
    if dynamic_linking {
        return c""
    }
    if supports_static_linking(platform) {
        return c"-static"
    }
    return c""
}

/// tcc cannot reliably produce fully static binaries, so it should not be used
/// when static linking is requested.
pub fn compiler_supports_static_linking(compiler: ref u8) bool = {
    if cstr.cmp(compiler, c"tcc") == 0 {
        return false
    }
    return true
}

/// Returns the compiler driver flag used to strip symbols, or an empty string
/// when symbols should be retained.
pub fn strip_link_flag(release_mode: bool) ref u8 = {
    if release_mode {
        return c"-s"
    }
    return c""
}

pub fn parse_alt_compiler_arg(arg: ref u8) ref u8 = {
    if cstr.starts_with(arg, c"-alt:") {
        return trust @ptradd(arg, 5) as ref u8
    }
    return c""
}

/// Normalize the OS component of a `-target:<os>.<arch>` selector.
pub fn normalize_target_platform(name: ref u8) ref u8 = {
    if cstr.cmp(name, c"macos") == 0 || cstr.cmp(name, c"osx") == 0 {
        return c"darwin"
    }
    if cstr.cmp(name, c"win") == 0 || cstr.cmp(name, c"win32") == 0 {
        return c"windows"
    }
    return name
}

/// Normalize the architecture component of a target selector.
pub fn normalize_target_arch(name: ref u8) ref u8 = {
    if cstr.cmp(name, c"amd64") == 0 || cstr.cmp(name, c"x64") == 0 {
        return c"x86_64"
    }
    if cstr.cmp(name, c"arm64") == 0 {
        return c"aarch64"
    }
    return name
}

/// Return the OS component of a target string, or the empty string when the
/// target has no dot.
pub fn target_platform_of(target: ref u8) ref u8 = trust {
    val n: i64 = cstr.len(target)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(target, i)) == 46 {
            if i == 0 {
                return c""
            }
            return normalize_target_platform(cstr.substr(target, 0, i))
        }
        i++
    }
    return normalize_target_platform(target)
}

/// Return the architecture component of a target string, or the empty string
/// when the target has no dot.
pub fn target_arch_of(target: ref u8) ref u8 = trust {
    val n: i64 = cstr.len(target)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(target, i)) == 46 {
            if i + 1 >= n {
                return c""
            }
            return normalize_target_arch(cstr.substr(target, i + 1, n - i - 1))
        }
        i++
    }
    return c""
}

/// Cross-compilation targets currently supported by Spectre.
pub fn target_is_supported(platform: ref u8, arch: ref u8) bool = {
    if cstr.cmp(platform, c"windows") == 0 {
        return cstr.cmp(arch, c"x86_64") == 0
        || cstr.cmp(arch, c"aarch64") == 0
    }
    if cstr.cmp(platform, c"linux") == 0 {
        return cstr.cmp(arch, c"x86_64") == 0
        || cstr.cmp(arch, c"aarch64") == 0
    }
    return false
}

pub fn target_is_windows(platform: ref u8) bool = {
    return cstr.cmp(platform, c"windows") == 0
}

pub fn target_is_linux(platform: ref u8) bool = {
    return cstr.cmp(platform, c"linux") == 0
}

/// QBE target name for a platform/architecture pair.
pub fn target_qbe_name(platform: ref u8, arch: ref u8) ref u8 = {
    if cstr.cmp(platform, c"windows") == 0 {
        if cstr.cmp(arch, c"aarch64") == 0 {
            return c"arm64_win"
        }
        return c"amd64_win"
    }
    if cstr.cmp(arch, c"aarch64") == 0 {
        return c"arm64"
    }
    return c"amd64_sysv"
}

/// Clang target triple for a platform/architecture pair.
pub fn target_triple(platform: ref u8, arch: ref u8) ref u8 = {
    if cstr.cmp(platform, c"windows") == 0 {
        if cstr.cmp(arch, c"aarch64") == 0 {
            return c"aarch64-pc-windows-msvc"
        }
        return c"x86_64-pc-windows-msvc"
    }
    if cstr.cmp(arch, c"aarch64") == 0 {
        return c"aarch64-unknown-linux-gnu"
    }
    return c"x86_64-unknown-linux-gnu"
}

pub fn target_object_ext(platform: ref u8) ref u8 = {
    if cstr.cmp(platform, c"windows") == 0 {
        return c".obj"
    }
    return c".o"
}

pub fn target_needs_cross(
    platform: ref u8,
    arch: ref u8,
    host_platform: ref u8,
    host_arch: ref u8
) bool = {
    return cstr.cmp(platform, host_platform) != 0
    || cstr.cmp(arch, host_arch) != 0
}

/// Cross compilation always needs Clang to assemble or compile for the target
/// triple. Windows links use lld-link; Linux links use ld.lld via Clang.
pub fn cross_toolchain_available(platform: ref u8) bool = {
    if !is_compiler_available(c"clang") {
        return false
    }
    if cstr.cmp(platform, c"windows") == 0 {
        return is_compiler_available(c"lld-link")
    }
    return is_compiler_available(c"ld.lld")
}

/// Library name translation for lld-link.
pub fn translate_lld_link_flag(flag: ref u8) ref u8 = trust {
    if cstr.cmp(flag, c"-pthread") == 0 {
        return c""
    }
    if cstr.starts_with(flag, c"-l") {
        val name: ref u8 = cstr.substr(flag, 2, cstr.len(flag) - 2)
        return @fmtalloc("{s}.lib", {name})
    }
    if cstr.ends_with(flag, c".lib") || cstr.ends_with(flag, c".a")
    || cstr.ends_with(flag, c".obj") || cstr.ends_with(flag, c".o") {
        return flag
    }
    return flag
}

/// Returns true when `root` looks like an xwin splat directory.
pub fn xwin_root_looks_valid(root: ref u8) bool = trust {
    if cstr.cmp(root, c"") == 0 {
        return false
    }
    if !fs.is_directory_cstr(path.join_cstr(root, c"crt")) {
        return false
    }
    if !fs.is_directory_cstr(path.join_cstr(root, c"sdk")) {
        return false
    }
    return true
}

/// Discover an xwin splat root.
///
/// Order: SPECTRE_XWIN_DIR, XWIN_DIR, ~/.xwin, ~/.cache/xwin/splat, then
/// ./.xwin-cache/splat. Returns an empty string when nothing was found.
pub fn xwin_find_root() ref u8 = trust {
    val from_env: ref u8 = os.getenv(c"SPECTRE_XWIN_DIR")
    if from_env != none && cstr.len(from_env) > 0 {
        return from_env
    }
    val from_env2: ref u8 = os.getenv(c"XWIN_DIR")
    if from_env2 != none && cstr.len(from_env2) > 0 {
        return from_env2
    }
    val home_opt = fs.home_dir_cstr()
    if home_opt is some home {
        val a: ref u8 = path.join_cstr(home, c".xwin")
        if xwin_root_looks_valid(a) {
            return a
        }
        val b: ref u8 = path.join_cstr(home, c".cache/xwin/splat")
        if xwin_root_looks_valid(b) {
            return b
        }
    }
    if xwin_root_looks_valid(c"./.xwin-cache/splat") {
        return c"./.xwin-cache/splat"
    }
    return c""
}

/// Resolve the architecture directory name used by xwin.
///
/// Returns "x86_64", "aarch64", or "arm64" when that directory exists below
/// `<root>/crt/lib`, and an empty string otherwise.
pub fn xwin_arch_dir(root: ref u8, arch: ref u8) ref u8 = trust {
    if cstr.cmp(root, c"") == 0 {
        return c""
    }
    val lib_root: ref u8 = path.join_cstr(root, c"crt/lib")
    if cstr.cmp(arch, c"aarch64") == 0 || cstr.cmp(arch, c"arm64") == 0 {
        val a64: ref u8 = path.join_cstr(lib_root, c"aarch64")
        if fs.is_directory_cstr(a64) {
            return c"aarch64"
        }
        val arm64: ref u8 = path.join_cstr(lib_root, c"arm64")
        if fs.is_directory_cstr(arm64) {
            return c"arm64"
        }
        return c""
    }
    val x64: ref u8 = path.join_cstr(lib_root, c"x86_64")
    if fs.is_directory_cstr(x64) {
        return c"x86_64"
    }
    return c""
}

/// Returns true when `root` has the CRT/SDK directories and import libraries
/// required to link a hosted Windows program for `arch`.
pub fn xwin_available_in(root: ref u8, arch: ref u8) bool = trust {
    if !xwin_root_looks_valid(root) {
        return false
    }
    val ad: ref u8 = xwin_arch_dir(root, arch)
    if cstr.cmp(ad, c"") == 0 {
        return false
    }
    val crt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"crt/lib"), ad)
    val um_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/um"), ad)
    val ucrt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/ucrt"), ad)
    if !fs.is_directory_cstr(crt_lib) {
        return false
    }
    if !fs.is_directory_cstr(um_lib) {
        return false
    }
    if !fs.is_directory_cstr(ucrt_lib) {
        return false
    }
    if !os.exists(path.join_cstr(crt_lib, c"libcmt.lib")) {
        return false
    }
    if !os.exists(path.join_cstr(ucrt_lib, c"libucrt.lib")) {
        return false
    }
    if !os.exists(path.join_cstr(um_lib, c"kernel32.lib")) {
        return false
    }
    return true
}

/// Returns true when a usable xwin root for `arch` can be discovered.
pub fn xwin_available(arch: ref u8) bool = trust {
    return xwin_available_in(xwin_find_root(), arch)
}

/// GNU-style Clang include flags for an xwin root.
pub fn xwin_include_flags(root: ref u8, arch: ref u8) ref u8 = trust {
    if !xwin_root_looks_valid(root) {
        return c""
    }
    if cstr.cmp(arch, c"") == 0 {
        return c""
    }
    val flags: mut ref u8 = c""
    val crt_inc: ref u8 = path.join_cstr(root, c"crt/include")
    val ucrt_inc: ref u8 = path.join_cstr(root, c"sdk/include/ucrt")
    val shared_inc: ref u8 = path.join_cstr(root, c"sdk/include/shared")
    val um_inc: ref u8 = path.join_cstr(root, c"sdk/include/um")
    val winrt_inc: ref u8 = path.join_cstr(root, c"sdk/include/winrt")
    if fs.is_directory_cstr(crt_inc) {
        flags = @fmtalloc("{s} -isystem \"{s}\"", {flags, crt_inc})
    }
    if fs.is_directory_cstr(ucrt_inc) {
        flags = @fmtalloc("{s} -isystem \"{s}\"", {flags, ucrt_inc})
    }
    if fs.is_directory_cstr(shared_inc) {
        flags = @fmtalloc("{s} -isystem \"{s}\"", {flags, shared_inc})
    }
    if fs.is_directory_cstr(um_inc) {
        flags = @fmtalloc("{s} -isystem \"{s}\"", {flags, um_inc})
    }
    if fs.is_directory_cstr(winrt_inc) {
        flags = @fmtalloc("{s} -isystem \"{s}\"", {flags, winrt_inc})
    }
    // Clang 18 defines an AArch64 `__prefetch` builtin that conflicts with the
    // MSVC arm64 CRT's declaration in <intrin.h>. Rename the declaration so the
    // system headers parse; runtime code does not call it.
    if cstr.cmp(arch, c"aarch64") == 0 || cstr.cmp(arch, c"arm64") == 0 {
        flags = @fmtalloc(
            "{s} -D__prefetch=__sx_unused_prefetch",
            {flags}
        )
    }
    return flags
}

/// lld-link `/libpath:` flags for an xwin root.
pub fn xwin_lib_path_flags(root: ref u8, arch: ref u8) ref u8 = trust {
    val ad: ref u8 = xwin_arch_dir(root, arch)
    if cstr.cmp(ad, c"") == 0 {
        return c""
    }
    val crt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"crt/lib"), ad)
    val um_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/um"), ad)
    val ucrt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/ucrt"), ad)
    return @fmtalloc(
        "/libpath:\"{s}\" /libpath:\"{s}\" /libpath:\"{s}\"",
        {crt_lib, um_lib, ucrt_lib}
    )
}

/// Clang-driver library search flags for an xwin root.
pub fn xwin_lib_path_flags_clang(root: ref u8, arch: ref u8) ref u8 = trust {
    val ad: ref u8 = xwin_arch_dir(root, arch)
    if cstr.cmp(ad, c"") == 0 {
        return c""
    }
    val crt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"crt/lib"), ad)
    val um_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/um"), ad)
    val ucrt_lib: ref u8 = path.join_cstr(path.join_cstr(root, c"sdk/lib/ucrt"), ad)
    return @fmtalloc(
        "-Wl,/libpath:\"{s}\" -Wl,/libpath:\"{s}\" -Wl,/libpath:\"{s}\"",
        {crt_lib, um_lib, ucrt_lib}
    )
}

/// Default libraries for a hosted Windows link.
pub fn xwin_default_libs() ref u8 = {
    return c"libcmt.lib libucrt.lib libvcruntime.lib oldnames.lib kernel32.lib ws2_32.lib bcrypt.lib"
}

/// Human-readable comma-separated list of architectures available in `root`.
pub fn xwin_available_archs(root: ref u8) ref u8 = trust {
    val out: mut ref u8 = c""
    if xwin_available_in(root, c"x86_64") {
        out = c"x86_64"
    }
    if xwin_available_in(root, c"aarch64") {
        if cstr.len(out) > 0 {
            out = @fmtalloc("{s}, aarch64", {out})
        } else {
            out = c"aarch64"
        }
    }
    if cstr.len(out) == 0 {
        return c"none"
    }
    return out
}

pub fn filter_c_diagnostics(raw: ref u8) ref u8 = trust {
    val sb: ref void = builder.StringBuilder.new()
    val len: i64 = cstr.len(raw) as i64
    val ls: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        val at_end: bool = i == len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(raw, i)) as u8
        }
        if at_end || c == 10 {
            val line_len: i64 = i - ls
            if line_len > 0 {
                val first: u8 = @load8(@ptradd(raw, ls)) as u8
                val is_context: bool = first == 32 || first == 9
                if !is_context {
                    val ji: mut i64 = ls
                    for {
                        if ji >= ls + line_len {
                            break
                        }
                        builder.StringBuilder.append_char(sb, @load8(@ptradd(raw, ji)) as u8)
                        ji++
                    }
                    builder.StringBuilder.append_char(sb, 10 as u8)
                }
            }
            ls = i + 1
        }
        i++
    }
    val built: ref void = builder.StringBuilder.build(sb)
    val out: ref u8 = ostr.as_cstr(built)
    builder.StringBuilder.free(sb)
    return out
}

pub fn root_has_direct_links(items: list[ref parser.Node]) bool = {
    for item in items {
        if item.kind == parser.NK_LINK || item.kind == parser.NK_LIB {
            return true
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val when_items: list[ref parser.Node] = item.d1 as list[ref parser.Node]
            for w in when_items {
                if w.kind == parser.NK_LINK || w.kind == parser.NK_LIB {
                    return true
                }
            }
            val or_branches: ref void = item.d2 as ref void
            if or_branches != none {
                for ob in or_branches as list[ref parser.Node] {
                    val ob_items: list[ref parser.Node] = ob.d1 as list[ref parser.Node]
                    for obn in ob_items {
                        if obn.kind == parser.NK_LINK || obn.kind == parser.NK_LIB {
                            return true
                        }
                    }
                }
            }
            val owise: ref void = item.d3 as ref void
            if owise != none {
                for ow in owise as list[ref parser.Node] {
                    if ow.kind == parser.NK_LINK || ow.kind == parser.NK_LIB {
                        return true
                    }
                }
            }
        }
    }
    return false
}

pub fn input_is_in_std(input: ref u8, arena: ref allocators.Arena) bool = {
    if cstr.starts_with(input, c"std/") {
        return true
    }
    if cstr.starts_with(input, c"./std/") {
        return true
    }
    val input_string = trust ostr.from_cstr[allocators.Arena](arena, input)
    val std_segment = trust ostr.from_cstr[allocators.Arena](arena, c"/std/")
    val in_std: bool = ostr.contains(input_string, std_segment)
    if in_std {
        return true
    }
    return false
}

pub fn pick_alt_backend(
    requested: ref u8,
    release_mode: bool,
    input: ref u8,
    root_items: list[ref parser.Node],
    arena: ref allocators.Arena
) ref u8 = {
    if cstr.cmp(requested, c"") != 0 {
        return requested
    }
    if release_mode || (!input_is_in_std(input, arena) && root_has_direct_links(root_items)) {
        if is_compiler_available(c"clang") {
            return c"clang"
        }
    }
    if is_compiler_available(c"clang") {
        return c"clang"
    }
    when windows {
        if is_compiler_available(c"clang-cl") {
            return c"clang-cl"
        }
        if is_compiler_available(c"cl") {
            return c"cl"
        }
    }
    if is_compiler_available(c"gcc") {
        return c"gcc"
    }
    if is_compiler_available(c"cc") {
        return c"cc"
    }
    if is_compiler_available(c"tcc") {
        return c"tcc"
    }
    return c"cc"
}

pub fn append_debug_runtime_links(
    links: mut list[ref u8],
    exe_dir: ref u8,
    quiet: bool,
    release_mode: bool,
    compiler: ref u8,
    platform: ref u8
) void = trust {
    val kind: ref u8 = alt_compiler_kind(compiler)
    if cstr.cmp(platform, c"windows") == 0 {
        if compiler_uses_msvc_flags(kind) {
            @append(links, c"bcrypt.lib")
            @append(links, c"ws2_32.lib")
        } else {
            @append(links, c"-lbcrypt")
            @append(links, c"-lws2_32")
        }
    }
    if release_mode {
        return
    }
    val panic_c: ref u8 = path.join_cstr(exe_dir, c"spectrelib/csources/panic_handler.c")
    val panic_o: ref u8 = path.join_cstr(exe_dir, c"spectrelib/csources/panic_handler.o")
    val panic_cf = fs.open_cstr(panic_c, c"r")
    if panic_cf is some hc {
        fs.close(hc)
        @append(links, panic_c)
    } else {
        val panic_of = fs.open_cstr(panic_o, c"r")
        if panic_of is some ho {
            fs.close(ho)
            @append(links, panic_o)
        } elif !quiet {
            stdio.print("warning: panic_handler.c not found at: {s}\n", {panic_c})
        }
    }
    if cstr.cmp(platform, c"windows") == 0 {
        if compiler_uses_msvc_flags(kind) {
            @append(links, c"Dbghelp.lib")
        } else {
            @append(links, c"-ldbghelp")
        }
    }
}

pub fn is_posix_platform(name: ref u8) bool = {
    if cstr.cmp(name, c"linux") == 0 {
        return true
    }
    if cstr.cmp(name, c"darwin") == 0 {
        return true
    }
    if cstr.cmp(name, c"freebsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"openbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"netbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"dragonflybsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"android") == 0 {
        return true
    }
    if cstr.cmp(name, c"haiku") == 0 {
        return true
    }
    if cstr.cmp(name, c"redox") == 0 {
        return true
    }
    return false
}

pub fn is_bsd_platform(name: ref u8) bool = {
    if cstr.cmp(name, c"freebsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"openbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"netbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"dragonflybsd") == 0 {
        return true
    }
    return false
}

pub fn is_known_platform(name: ref u8) bool = {
    if cstr.cmp(name, c"windows") == 0 {
        return true
    }
    if cstr.cmp(name, c"linux") == 0 {
        return true
    }
    if cstr.cmp(name, c"darwin") == 0 {
        return true
    }
    if cstr.cmp(name, c"freebsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"openbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"netbsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"dragonflybsd") == 0 {
        return true
    }
    if cstr.cmp(name, c"android") == 0 {
        return true
    }
    if cstr.cmp(name, c"haiku") == 0 {
        return true
    }
    if cstr.cmp(name, c"redox") == 0 {
        return true
    }
    if cstr.cmp(name, c"plan9") == 0 {
        return true
    }
    return false
}

/// Returns true when the given platform selector matches the current platform.
/// Accepts every concrete platform name plus the groups "posix"/"unix" and "bsd".
pub fn platform_matches_with_target(name: ref u8, src_target: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val cur: mut ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    if cstr.cmp(src_target, c"") != 0 {
        cur = src_target
    }
    val matched: mut bool = false
    if is_known_platform(name) {
        if cstr.cmp(name, cur) == 0 {
            matched = true
        }
    } elif cstr.cmp(name, c"posix") == 0 || cstr.cmp(name, c"unix") == 0 {
        matched = is_posix_platform(cur)
    } elif cstr.cmp(name, c"bsd") == 0 {
        matched = is_bsd_platform(cur)
    }
    allocators.Arena.free(arena)
    return matched
}

/// Returns true when the given architecture name matches the current process.
pub fn arch_matches(name: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val current: ref u8 = reflection.current_arch_name[allocators.Arena](arena)
    val wanted: mut ref u8 = name
    if cstr.cmp(wanted, c"amd64") == 0 {
        wanted = c"x86_64"
    }
    if cstr.cmp(wanted, c"arm64") == 0 {
        wanted = c"aarch64"
    }
    val matched: bool = cstr.cmp(wanted, current) == 0
    allocators.Arena.free(arena)
    return matched
}
