/// Compiler-wide arena for allocator-backed lists.
///
/// The compiler creates large numbers of short-lived lists while parsing,
/// checking, and generating code. They all share one scoped arena which is
/// released once the compiler is finished. The reusable `ListArena` allocator
/// itself lives in `std/allocators`; this module owns the compiler-wide
/// singleton and the list constructors that use it.
///
/// SPDX-License-Identifier: GPL-3.0-only
/// (C) Navid Momtahen - 2026

val allocators = use("std/allocators")
val stdio      = use("std/stdio")
val os         = use("std/os")

val state: mut ref allocators.ListArena = none

pub fn init() void = {
    if state == none {
        match trust allocators.ScopedArena.new(67108864 as usize) {
            ok a => {
                val next: mut ref allocators.ListArena = @alloc(
                    @sizeof(allocators.ListArena)
                ) as ref allocators.ListArena
                next.arena = a
                state = next
            }
            err _ => {
                stdio.puts("error: could not allocate compiler list arena\n")
                trust os.exit(1)
            }
        }
    }
}

pub fn allocator() ref allocators.ListArena = {
    init()
    return state
}

/// Allocate raw bytes from the compiler-wide scoped arena.
pub fn alloc(size: usize) ref void = {
    val ac: ref allocators.ListArena = allocator()
    return allocators.ScopedArena.alloc_or_none(ac.arena, size)
}

/// Return a new allocator-backed list.
pub fn new[T]() list[T] = {
    val ac: ref allocators.ListArena = allocator()
    return @listalloc[allocators.ListArena, T](ac)?
}


pub fn from1[T](a: T) list[T] = {
    val xs: mut list[T] = new[T]()
    @append(xs, a)
    return xs
}

pub fn from2[T](a: T, b: T) list[T] = {
    val xs: mut list[T] = new[T]()
    @append(xs, a)
    @append(xs, b)
    return xs
}

pub fn from3[T](a: T, b: T, c: T) list[T] = {
    val xs: mut list[T] = new[T]()
    @append(xs, a)
    @append(xs, b)
    @append(xs, c)
    return xs
}

pub fn from6[T](a: T, b: T, c: T, d: T, e: T, f: T) list[T] = {
    val xs: mut list[T] = new[T]()
    @append(xs, a)
    @append(xs, b)
    @append(xs, c)
    @append(xs, d)
    @append(xs, e)
    @append(xs, f)
    return xs
}

pub fn close() void = {
    if state != none {
        val old: ref allocators.ListArena = state
        trust allocators.ScopedArena.free(old.arena)
        trust @free(old)
        state = none
    }
}

test "compiler list arena appends items" {
    init()
    val xs: mut list[i64] = new[i64]()
    @append(xs, 1)
    @append(xs, 2)
    assert @len(xs) == 2
    close()
}
