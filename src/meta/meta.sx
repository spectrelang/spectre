val stdio = use("std/stdio")
val str   = use("std/string")
val env   = use("env.sx")

pub fn get_spectre_version() str.StringView = {
    return env.get(str.view_cstr("SPECTRE_MOD_VERSION"))
}

pub fn get_commit_hash() str.StringView = {
    val hash: str.StringView = env.get(str.view_cstr("GIT_HASH"))
    if hash.len == 0 {
        return str.view_cstr("unknown")
    }
    return hash
}

pub fn print_usage() void = {
    stdio.puts("usage:")
    stdio.puts("  spectre <command> [args] | <input.sx> [options]")
    stdio.puts("")
    stdio.puts("commands:")
    stdio.puts("  init    <name>       Initialize a new project")
    stdio.puts("  fmt     <path>       Format .sx files or directories in place")
    stdio.puts("  critic  <path>       Point out antipatterns in .sx files")
    stdio.puts("  build   <config>     Build using a config from sx.mod")
    stdio.puts("  run     <input.sx>   Compile and immediately run a program")
    stdio.puts("  doc     <path>       Generate docs for a file or directory")
    stdio.puts("  add     <git-url>    Clone a git dependency into ./lib/ and record it")
    stdio.puts("  install <git-url>    Build and install a Spectre project from a repository")
    stdio.puts("  remove  <dep-name>   Remove a dependency by repository name")
    stdio.puts("  upgrade <dep-name>   Upgrade dependencies in ./lib/ to their latest HEAD")
    stdio.puts("  help    <topic>      Show detailed help for a command or flag")
    stdio.puts("  restore              Restore all dependencies from sx.mod and sx.lock into ./lib/")
    stdio.puts("  graph                Visualize the project dependency tree")
    stdio.puts("  ref                  Generate the language reference in the current directory")
    stdio.puts("  clean                Remove build artifacts")
    stdio.puts("  doctor               Show system and Spectre installation information")
    stdio.puts("")
    stdio.puts("options:")
    stdio.puts("  -ast                 Print the AST in a unicode tree and exit")
    stdio.puts("  -syntax-check        Check validity of syntax given some program")
    when posix {
        stdio.puts("  -emit-ssa            Print QBE IR to stdout and exit")
        stdio.puts("  -emit-shim:<file>    Write the QBE shim alongside -emit-ssa")
    }
    stdio.puts("  -emit-alt            Print alternative IR to stdout and exit")
    stdio.puts("  -emit-asm            Print assembly to stdout and exit")
    stdio.puts("  -src-target:<os>     Mock target OS for when-blocks in source output")
    stdio.puts("  -translate-c         Translate C input into a single .sx file")
    stdio.puts("  -inc-path:<dir>      Add an include search path for the alt backend")
    stdio.puts("  -show-cmd            Show the command used for linking")
    stdio.puts("  -test                Run the unit tests in the current file")
    stdio.puts("  -test-all            Run tests in every .sx file under the current directory")
    stdio.puts("  -test-depth:<n>      Maximum directory depth for -test-all (default: 25)")
    stdio.puts("  -leak-check          Track allocations and enable the @dumpmemleaks intrinsic")
    stdio.puts("  -release             Build in release mode")
    stdio.puts("  -native              Optimize the alt backend for the host CPU")
    stdio.puts("  -unroll              Enable aggressive loop unrolling in the alt backend")
    stdio.puts("  -no-simd             Disable autovectorization (scalar fallback)")
    stdio.puts("  -dynamic             Link dynamically instead of statically")
    stdio.puts("  -dll                 Build a shared library")
    when posix {
        stdio.puts("  -a, -alt             Compile with fallback backend")
    }
    stdio.puts("  -b, -bootstrap       Display backend output on error")
    stdio.puts("  -c, -compile         Compile only to produce object file, without linking")
    stdio.puts("  -d:<NAME>=<value>    Define a compile-time environment variable")
    stdio.puts("  -o, -output <file>   Output path for binary or build artifact")
    stdio.puts("  -l, -loud            Show stages of compilation with verbose output")
    stdio.puts("  -v, -version         Show the version of the Spectre compiler")
    stdio.puts("  -h, -help            Print this help message")
}

pub fn print_version() void = {
    trust stdio.print(
        "Spectre {s} ({s})\n(C) Navid Momtahen - GPL-3.0 - 2026\n",
        {get_spectre_version(), get_commit_hash()}
    )
}

fn print_flag_help(name: str.StringView, summary: str.StringView, usage: str.StringView) void = trust {
    stdio.print("{s}\n\n  {s}\n\nusage:\n  {s}\n", {name, summary, usage})
}

pub fn print_help(topic: str.StringView) i32 = trust {
    if str.view_eql_cstr(topic, "") == 0 {
        print_usage()
        return 0
    }

    if str.view_eql_cstr(topic, "init") == 0 {
        stdio.puts("init - Initialize a new project")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre init [name]")
        stdio.puts("")
        stdio.puts("Creates sx.mod, sx.lock, src/main.sx and .gitignore in the current")
        stdio.puts("directory. The project name defaults to the current directory name.")
        return 0
    }

    if str.view_eql_cstr(topic, "fmt") == 0 {
        stdio.puts("fmt - Format Spectre source files")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre fmt [-stdio] <file.sx|directory>...")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  -stdio      Write formatted output to stdout instead of editing in place")
        stdio.puts("  -h, -help   Show this help message")
        stdio.puts("")
        stdio.puts("Directories are searched recursively for .sx files. Other files are")
        stdio.puts("ignored. Without -stdio, files are rewritten in place.")
        stdio.puts("")
        stdio.puts("Calls, signatures and struct/type literals longer than 100")
        stdio.puts("characters are split across multiple lines when they can be split")
        stdio.puts("safely.")
        return 0
    }

    if str.view_eql_cstr(topic, "critic") == 0 {
        stdio.puts("critic - Point out antipatterns in Spectre source files")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre critic [-fix] <file.sx|directory>...")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  -fix        Apply safe fixes to the checked files")
        stdio.puts("  -h, -help   Show this help message")
        stdio.puts("")
        stdio.puts("Directories are searched recursively for .sx files. The exit code is")
        stdio.puts("non-zero when issues remain.")
        return 0
    }

    if str.view_eql_cstr(topic, "build") == 0 {
        stdio.puts("build - Build using a configuration from sx.mod")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre build [config]")
        stdio.puts("")
        stdio.puts("The configuration name defaults to \"dev\".")
        stdio.puts("sx.mod must contain a spectre_version that matches the installed")
        stdio.puts("compiler, or the build is rejected. A build configuration may also")
        stdio.puts("define compile-time environment variables with an env { } block.")
        return 0
    }

    if str.view_eql_cstr(topic, "install") == 0 {
        stdio.puts("install - Build and install a Spectre project from a repository")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre install <git-url> [-config <name>] [-shell <shell>]")
        stdio.puts("                [-bin-dir <dir>]")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  -config <name>  Build configuration to use (default: prod, then")
        stdio.puts("                  production, release, default, dev, then the first")
        stdio.puts("                  configuration in sx.mod)")
        stdio.puts("  -shell <shell>  Shell to configure PATH for (bash, zsh, fish,")
        stdio.puts("                  nushell, elvish, powershell, sh, ksh, tcsh, ...)")
        stdio.puts("                  Use 'all' to write every supported integration.")
        stdio.puts("  -bin-dir <dir>  Override the install directory")
        stdio.puts("  -h, -help       Show this help message")
        stdio.puts("")
        stdio.puts("The repository is cloned to a temporary directory, built with the")
        stdio.puts("installed Spectre compiler, and the resulting executable is copied")
        stdio.puts("into a Spectre-owned binary directory:")
        when windows {
            stdio.puts("  %LOCALAPPDATA%\\Spectre\\bin")
        }
        when posix {
            stdio.puts("  ~/.local/share/spectre/bin")
        }
        stdio.puts("")
        stdio.puts("That directory is then added to PATH for the selected shell.")
        return 0
    }

    if str.view_eql_cstr(topic, "run") == 0 {
        stdio.puts("run - Compile and immediately run a program")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre run <input.sx> [options]")
        stdio.puts("")
        stdio.puts("Compiler options after the input file are applied before running.")
        return 0
    }

    if str.view_eql_cstr(topic, "doc") == 0 {
        stdio.puts("doc - Generate documentation for a source file")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre doc [path] [-o <dir>] [-md] [-read <file>]")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  -o <dir>     Write documentation to <dir> instead of the default")
        stdio.puts("  -md          Generate Markdown instead of HTML")
        stdio.puts("  -read <file> Use <file> (relative to the current directory) as the")
        stdio.puts("               overview page instead of the target's README")
        stdio.puts("  -h, -help    Show this help message")
        stdio.puts("")
        stdio.puts("The path defaults to the current directory. Without -o, a directory")
        stdio.puts("target is written to ./docs-out-<name>/, where <name> is the last")
        stdio.puts("path component. A single .sx target is written to ./docs-out/.")
        stdio.puts("The output directory is created if it does not exist.")
        return 0
    }

    if str.view_eql_cstr(topic, "add") == 0 {
        stdio.puts("add - Add a git dependency")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre add <git-url>")
        stdio.puts("")
        stdio.puts("Clones the repository into ./lib/ and records it in sx.mod and sx.lock.")
        return 0
    }

    if str.view_eql_cstr(topic, "remove") == 0 {
        stdio.puts("remove - Remove a dependency")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre remove <dep-name>")
        stdio.puts("")
        stdio.puts("Removes the dependency from ./lib/, sx.mod and sx.lock.")
        return 0
    }

    if str.view_eql_cstr(topic, "upgrade") == 0 {
        stdio.puts("upgrade - Upgrade dependencies to their latest HEAD")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre upgrade <dep-name>")
        stdio.puts("")
        stdio.puts("Without a name, every dependency in ./lib/ is upgraded. With a")
        stdio.puts("dependency name, only that dependency (and its subtree) is")
        stdio.puts("upgraded. sx.lock is updated to the new HEAD commit hashes.")
        return 0
    }

    if str.view_eql_cstr(topic, "restore") == 0 {
        stdio.puts("restore - Restore project dependencies")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre restore")
        stdio.puts("")
        stdio.puts("Restores all dependencies from sx.mod and sx.lock into ./lib/.")
        return 0
    }

    if str.view_eql_cstr(topic, "graph") == 0 {
        stdio.puts("graph - Visualize the project dependency tree")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre graph")
        return 0
    }

    if str.view_eql_cstr(topic, "ref") == 0 {
        stdio.puts("ref - Generate the language reference")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre ref")
        stdio.puts("")
        stdio.puts("Generates the language reference in the current directory.")
        return 0
    }

    if str.view_eql_cstr(topic, "clean") == 0 {
        stdio.puts("clean - Remove build artifacts")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre clean")
        stdio.puts("")
        stdio.puts("Removes s-out/ and temporary compiler output files.")
        return 0
    }

    if str.view_eql_cstr(topic, "doctor") == 0 {
        stdio.puts("doctor - Show system and Spectre installation information")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre doctor")
        return 0
    }

    if str.view_eql_cstr(topic, "help") == 0 {
        stdio.puts("help - Show detailed help for a command or flag")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre help [command|flag]")
        stdio.puts("")
        stdio.puts("Without a topic, the general help message is shown.")
        stdio.puts("Examples:")
        stdio.puts("  spectre help fmt")
        stdio.puts("  spectre help -emit-ssa")
        return 0
    }

    if str.view_eql_cstr(topic, "-ast") == 0 {
        print_flag_help(
            str.view_cstr("-ast"),
            str.view_cstr("Print the AST in a unicode tree and exit."),
            str.view_cstr("spectre <input.sx> -ast")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-syntax-check") == 0 {
        print_flag_help(
            str.view_cstr("-syntax-check"),
            str.view_cstr("Check the validity of the syntax without compiling."),
            str.view_cstr("spectre <input.sx> -syntax-check")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-emit-ssa") == 0 {
        print_flag_help(
            str.view_cstr("-emit-ssa"),
            str.view_cstr("Print QBE IR to stdout and exit (POSIX only)."),
            str.view_cstr("spectre <input.sx> -emit-ssa")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-emit-alt") == 0 {
        print_flag_help(
            str.view_cstr("-emit-alt"),
            str.view_cstr("Print alternative IR to stdout and exit."),
            str.view_cstr("spectre <input.sx> -emit-alt")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-emit-asm") == 0 {
        print_flag_help(
            str.view_cstr("-emit-asm"),
            str.view_cstr("Print assembly to stdout and exit."),
            str.view_cstr("spectre <input.sx> -emit-asm")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-src-target") == 0 || str.view_eql_cstr(topic, "-src-target:<os>") == 0 {
        print_src_target_help()
        return 0
    }

    if str.view_eql_cstr(topic, "-translate-c") == 0 {
        print_flag_help(
            str.view_cstr("-translate-c"),
            str.view_cstr("Translate C input into a single .sx file."),
            str.view_cstr("spectre -translate-c <input.c|input.h>")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-inc-path") == 0 || str.view_eql_cstr(topic, "-inc-path:<dir>") == 0 {
        print_flag_help(
            str.view_cstr("-inc-path:<dir>"),
            str.view_cstr("Add an include search path for the alternative backend."),
            str.view_cstr("spectre <input.sx> -alt -inc-path:<dir>")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-show-cmd") == 0 {
        print_flag_help(
            str.view_cstr("-show-cmd"),
            str.view_cstr("Show the command used for linking."),
            str.view_cstr("spectre <input.sx> -show-cmd")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-test") == 0 {
        print_flag_help(
            str.view_cstr("-test"),
            str.view_cstr("Run the unit tests in the current file."),
            str.view_cstr("spectre <input.sx> -test")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-test-all") == 0 {
        print_flag_help(
            str.view_cstr("-test-all"),
            str.view_cstr("Run the unit tests in every .sx file under the current directory, recursively."),
            str.view_cstr("spectre -test-all [-test-depth:<n>] [directory]")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-leak-check") == 0 {
        print_flag_help(
            str.view_cstr("-leak-check"),
            str.view_cstr("Route allocations made by @alloc through the leak tracker and enable the @dumpmemleaks intrinsic."),
            str.view_cstr("spectre <input.sx> -leak-check")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-release") == 0 {
        print_flag_help(
            str.view_cstr("-release"),
            str.view_cstr("Build in release mode with optimizations and stripped symbols."),
            str.view_cstr("spectre <input.sx> -release")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-native") == 0 {
        print_flag_help(
            str.view_cstr("-native"),
            str.view_cstr("Optimize the alternative backend for the host CPU at the cost of portability across architectures."),
            str.view_cstr("spectre <input.sx> -release -alt -native")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-unroll") == 0 {
        print_flag_help(
            str.view_cstr("-unroll"),
            str.view_cstr("Enable aggressive loop unrolling in the alternative backend with -funroll-loops."),
            str.view_cstr("spectre <input.sx> -release -alt -unroll")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-no-simd") == 0 {
        print_flag_help(
            str.view_cstr("-no-simd"),
            str.view_cstr("Disable autovectorization and emit scalar loops. Useful for debugging and for platforms without a supported SIMD backend."),
            str.view_cstr("spectre <input.sx> -release -alt -no-simd")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-dynamic") == 0 {
        print_flag_help(
            str.view_cstr("-dynamic"),
            str.view_cstr("Link dynamically instead of statically. Static linking is the default on platforms that support it."),
            str.view_cstr("spectre <input.sx> -dynamic")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-dll") == 0 {
        print_flag_help(str.view_cstr("-dll"), str.view_cstr("Build a shared library."), str.view_cstr("spectre <input.sx> -dll"))
        return 0
    }

    if str.view_eql_cstr(topic, "-a") == 0 || str.view_eql_cstr(topic, "-alt") == 0 {
        print_flag_help(
            str.view_cstr("-a, -alt"),
            str.view_cstr("Compile with the fallback backend. Use -alt:<cc> to force a driver such as clang, clang-cl, cl, or tcc."),
            str.view_cstr("spectre <input.sx> -alt:clang-cl")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-b") == 0 || str.view_eql_cstr(topic, "-bootstrap") == 0 {
        print_flag_help(
            str.view_cstr("-b, -bootstrap"),
            str.view_cstr("Display backend output on error."),
            str.view_cstr("spectre <input.sx> -bootstrap")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-c") == 0 || str.view_eql_cstr(topic, "-compile") == 0 {
        print_flag_help(
            str.view_cstr("-c, -compile"),
            str.view_cstr("Compile only to produce an object file, without linking."),
            str.view_cstr("spectre <input.sx> -compile")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-d") == 0 || str.view_starts_with(topic, str.view_cstr("-d:")) {
        print_flag_help(
            str.view_cstr("-d:<NAME>=<value>"),
            str.view_cstr("Define a compile-time environment variable. Reads through env.get(\"NAME\") are replaced with the supplied value at compile time."),
            str.view_cstr("spectre -d:GIT_HASH=abcdef <input.sx>")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-o") == 0 || str.view_eql_cstr(topic, "-output") == 0 || str.view_eql_cstr(topic, "-output=<file>") == 0 {
        print_flag_help(
            str.view_cstr("-o, -output <file>"),
            str.view_cstr("Set the output path for a binary or build artifact."),
            str.view_cstr("spectre <input.sx> -o <file>")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-l") == 0 || str.view_eql_cstr(topic, "-loud") == 0 {
        print_flag_help(
            str.view_cstr("-l, -loud"),
            str.view_cstr("Show compilation stages with verbose output."),
            str.view_cstr("spectre <input.sx> -loud")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-v") == 0 || str.view_eql_cstr(topic, "-version") == 0 {
        print_flag_help(
            str.view_cstr("-v, -version"),
            str.view_cstr("Show the version of the installed Spectre compiler."),
            str.view_cstr("spectre -v")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-h") == 0 || str.view_eql_cstr(topic, "-help") == 0 {
        print_flag_help(
            str.view_cstr("-h, -help"),
            str.view_cstr("Print the general help message."),
            str.view_cstr("spectre -h\n  spectre help <command|flag>")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-stdio") == 0 {
        print_flag_help(
            str.view_cstr("-stdio"),
            str.view_cstr("Write formatted output to stdout instead of editing files in place."),
            str.view_cstr("spectre fmt -stdio <file.sx|directory>...")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-md") == 0 {
        print_flag_help(
            str.view_cstr("-md"),
            str.view_cstr("Generate Markdown documentation instead of HTML."),
            str.view_cstr("spectre doc [path] -md")
        )
        return 0
    }

    if str.view_eql_cstr(topic, "-fix") == 0 {
        print_flag_help(
            str.view_cstr("-fix"),
            str.view_cstr("Apply safe critic fixes to .sx files or directories."),
            str.view_cstr("spectre critic -fix <file.sx|directory>...")
        )
        return 0
    }

    stdio.print("error: unknown help topic '{s}'\n", {topic})
    stdio.puts("Run 'spectre help' to see available commands and flags.")
    return 1
}

pub fn print_src_target_help() void = {
    stdio.puts("-src-target:<os>")
    stdio.puts("")
    stdio.puts("  Mock the target OS for when blocks in source output.")
    stdio.puts("  Requires -emit-alt or -emit-ssa.")
    stdio.puts("")
    stdio.puts("  Valid targets:")
    stdio.puts("    windows, linux, darwin, freebsd, openbsd, netbsd,")
    stdio.puts("    dragonflybsd, android, haiku, redox, plan9")
    stdio.puts("")
    stdio.puts("  Example:")
    stdio.puts("    spectre file.sx -src-target:windows -emit-alt")
}
