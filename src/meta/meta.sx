val stdio = use("std/stdio")
val str   = use("std/string")
val env   = use("env.sx")

pub fn get_spectre_version() ref u8 = {
    return "v0.0.12"
}

pub fn get_commit_hash() ref u8 = {
    val hash: ref u8 = env.get("GIT_HASH")
    if str.raw_cmp(hash, "") == 0 {
        return "unknown"
    }
    return hash
}

pub fn print_usage() void = {
    stdio.puts("usage:")
    stdio.puts("  spectre <command> [args] | <input.sx> [options]")
    stdio.puts("")
    stdio.puts("commands:")
    stdio.puts("  init   <name>        Initialize a new project")
    stdio.puts("  fmt    <path>        Format .sx files or directories in place")
    stdio.puts("  critic <path>        Point out antipatterns in .sx files")
    stdio.puts("  build  <config>      Build using a config from sx.mod")
    stdio.puts("  run    <input.sx>    Compile and immediately run a program")
    stdio.puts("  doc    <path>        Generate docs for a given .sx into ./docs-out/")
    stdio.puts("  add    <git-url>     Clone a git dependency into ./lib/ and record it")
    stdio.puts("  remove <dep-name>    Remove a dependency by repository name")
    stdio.puts("  help   <topic>       Show detailed help for a command or flag")
    stdio.puts("  restore              Restore all dependencies from sx.mod and sx.lock into ./lib/")
    stdio.puts("  graph                Visualize the project dependency tree")
    stdio.puts("  ref                  Generate the language reference in the current directory")
    stdio.puts("  clean                Remove build artifacts")
    stdio.puts("  doctor               Show system and Spectre installation information")
    stdio.puts("")
    stdio.puts("options:")
    stdio.puts("  --ast                Print the AST in a unicode tree and exit")
    stdio.puts("  --syntax-check       Check validity of syntax given some program")
    when posix {
        stdio.puts("  --emit-ssa           Print QBE IR to stdout and exit")
    }
    stdio.puts("  --emit-alt           Print alternative IR to stdout and exit")
    stdio.puts("  --emit-asm           Print assembly to stdout and exit")
    stdio.puts("  --src-target=<os>    Mock target OS for when-blocks in source output")
    stdio.puts("  --translate-c        Translate C input into a single .sx file")
    stdio.puts("  --inc-path=<dir>     Add an include search path for the alt backend")
    stdio.puts("  --show-cmd           Show the command used for linking")
    stdio.puts("  --test               Run the unit tests in the current file")
    stdio.puts("  --release            Build in release mode")
    stdio.puts("  --dynamic            Link dynamically instead of statically")
    stdio.puts("  --dll                Build a shared library")
    when posix {
        stdio.puts("  -a, --alt            Compile with fallback backend")
    }
    stdio.puts("  -b, --bootstrap      Display backend output on error")
    stdio.puts("  -c, --compile        Compile only to produce object file, without linking")
    stdio.puts("  -d<NAME>=<value>     Define a compile-time environment variable")
    stdio.puts("  -o, --output <file>  Output path for binary or build artifact")
    stdio.puts("  -l, --loud           Show stages of compilation with verbose output")
    stdio.puts("  -v, --version        Show the version of the Spectre compiler")
    stdio.puts("  -h, --help           Print this help message")
}

pub fn print_version() void = {
    trust stdio.print("Spectre {s} ({s})\n(C) Navid Momtahen - GPL-3.0 - 2026\n", {get_spectre_version(), get_commit_hash()})
}

fn print_flag_help(name: ref u8, summary: ref u8, usage: ref u8) void = trust {
    stdio.print("{s}\n\n  {s}\n\nusage:\n  {s}\n", {name, summary, usage})
}

pub fn print_help(topic: ref u8) i32 = trust {
    if str.raw_cmp(topic, "") == 0 {
        print_usage()
        return 0
    }

    if str.raw_cmp(topic, "init") == 0 {
        stdio.puts("init - Initialize a new project")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre init [name]")
        stdio.puts("")
        stdio.puts("Creates sx.mod, sx.lock, src/main.sx and .gitignore in the current")
        stdio.puts("directory. The project name defaults to the current directory name.")
        return 0
    }

    if str.raw_cmp(topic, "fmt") == 0 {
        stdio.puts("fmt - Format Spectre source files")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre fmt [--stdio] <file.sx|directory>...")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  --stdio      Write formatted output to stdout instead of editing in place")
        stdio.puts("  -h, --help   Show this help message")
        stdio.puts("")
        stdio.puts("Directories are searched recursively for .sx files. Other files are")
        stdio.puts("ignored. Without --stdio, files are rewritten in place.")
        return 0
    }

    if str.raw_cmp(topic, "critic") == 0 {
        stdio.puts("critic - Point out antipatterns in Spectre source files")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre critic [--fix] <file.sx|directory>...")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  --fix        Apply safe fixes to the checked files")
        stdio.puts("  -h, --help   Show this help message")
        stdio.puts("")
        stdio.puts("Directories are searched recursively for .sx files. The exit code is")
        stdio.puts("non-zero when issues remain.")
        return 0
    }

    if str.raw_cmp(topic, "build") == 0 {
        stdio.puts("build - Build using a configuration from sx.mod")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre build [config]")
        stdio.puts("")
        stdio.puts("The configuration name defaults to \"dev\".")
        stdio.puts("sx.mod must contain a spectre_version that matches the installed")
        stdio.puts("compiler, or the build is rejected. A build configuration may also")
        stdio.puts("define compile-time environment variables with an env { } block.")
        return 0
    }

    if str.raw_cmp(topic, "run") == 0 {
        stdio.puts("run - Compile and immediately run a program")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre run <input.sx> [options]")
        stdio.puts("")
        stdio.puts("Compiler options after the input file are applied before running.")
        return 0
    }

    if str.raw_cmp(topic, "doc") == 0 {
        stdio.puts("doc - Generate documentation for a source file")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre doc [path] [--md]")
        stdio.puts("")
        stdio.puts("options:")
        stdio.puts("  --md         Generate Markdown instead of HTML")
        stdio.puts("  -h, --help   Show this help message")
        stdio.puts("")
        stdio.puts("The path defaults to the current directory. Output is written to")
        stdio.puts("./docs-out/.")
        return 0
    }

    if str.raw_cmp(topic, "add") == 0 {
        stdio.puts("add - Add a git dependency")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre add <git-url>")
        stdio.puts("")
        stdio.puts("Clones the repository into ./lib/ and records it in sx.mod and sx.lock.")
        return 0
    }

    if str.raw_cmp(topic, "remove") == 0 {
        stdio.puts("remove - Remove a dependency")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre remove <dep-name>")
        stdio.puts("")
        stdio.puts("Removes the dependency from ./lib/, sx.mod and sx.lock.")
        return 0
    }

    if str.raw_cmp(topic, "restore") == 0 {
        stdio.puts("restore - Restore project dependencies")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre restore")
        stdio.puts("")
        stdio.puts("Restores all dependencies from sx.mod and sx.lock into ./lib/.")
        return 0
    }

    if str.raw_cmp(topic, "graph") == 0 {
        stdio.puts("graph - Visualize the project dependency tree")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre graph")
        return 0
    }

    if str.raw_cmp(topic, "ref") == 0 {
        stdio.puts("ref - Generate the language reference")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre ref")
        stdio.puts("")
        stdio.puts("Generates the language reference in the current directory.")
        return 0
    }

    if str.raw_cmp(topic, "clean") == 0 {
        stdio.puts("clean - Remove build artifacts")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre clean")
        stdio.puts("")
        stdio.puts("Removes s-out/ and temporary compiler output files.")
        return 0
    }

    if str.raw_cmp(topic, "doctor") == 0 {
        stdio.puts("doctor - Show system and Spectre installation information")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre doctor")
        return 0
    }

    if str.raw_cmp(topic, "help") == 0 {
        stdio.puts("help - Show detailed help for a command or flag")
        stdio.puts("")
        stdio.puts("usage:")
        stdio.puts("  spectre help [command|flag]")
        stdio.puts("")
        stdio.puts("Without a topic, the general help message is shown.")
        stdio.puts("Examples:")
        stdio.puts("  spectre help fmt")
        stdio.puts("  spectre help --emit-ssa")
        return 0
    }

    if str.raw_cmp(topic, "--ast") == 0 {
        print_flag_help("--ast", "Print the AST in a unicode tree and exit.", "spectre <input.sx> --ast")
        return 0
    }

    if str.raw_cmp(topic, "--syntax-check") == 0 {
        print_flag_help("--syntax-check", "Check the validity of the syntax without compiling.", "spectre <input.sx> --syntax-check")
        return 0
    }

    if str.raw_cmp(topic, "--emit-ssa") == 0 {
        print_flag_help("--emit-ssa", "Print QBE IR to stdout and exit (POSIX only).", "spectre <input.sx> --emit-ssa")
        return 0
    }

    if str.raw_cmp(topic, "--emit-alt") == 0 {
        print_flag_help("--emit-alt", "Print alternative IR to stdout and exit.", "spectre <input.sx> --emit-alt")
        return 0
    }

    if str.raw_cmp(topic, "--emit-asm") == 0 {
        print_flag_help("--emit-asm", "Print assembly to stdout and exit.", "spectre <input.sx> --emit-asm")
        return 0
    }

    if str.raw_cmp(topic, "--src-target") == 0 || str.raw_cmp(topic, "--src-target=<os>") == 0 {
        print_src_target_help()
        return 0
    }

    if str.raw_cmp(topic, "--translate-c") == 0 {
        print_flag_help("--translate-c", "Translate C input into a single .sx file.", "spectre --translate-c <input.c|input.h>")
        return 0
    }

    if str.raw_cmp(topic, "--inc-path") == 0 || str.raw_cmp(topic, "--inc-path=<dir>") == 0 {
        print_flag_help("--inc-path=<dir>", "Add an include search path for the alternative backend.", "spectre <input.sx> --alt --inc-path=<dir>")
        return 0
    }

    if str.raw_cmp(topic, "--show-cmd") == 0 {
        print_flag_help("--show-cmd", "Show the command used for linking.", "spectre <input.sx> --show-cmd")
        return 0
    }

    if str.raw_cmp(topic, "--test") == 0 {
        print_flag_help("--test", "Run the unit tests in the current file.", "spectre <input.sx> --test")
        return 0
    }

    if str.raw_cmp(topic, "--release") == 0 {
        print_flag_help("--release", "Build in release mode with optimizations and stripped symbols.", "spectre <input.sx> --release")
        return 0
    }

    if str.raw_cmp(topic, "--dynamic") == 0 {
        print_flag_help("--dynamic", "Link dynamically instead of statically. Static linking is the default on platforms that support it.", "spectre <input.sx> --dynamic")
        return 0
    }

    if str.raw_cmp(topic, "--dll") == 0 {
        print_flag_help("--dll", "Build a shared library.", "spectre <input.sx> --dll")
        return 0
    }

    if str.raw_cmp(topic, "-a") == 0 || str.raw_cmp(topic, "--alt") == 0 {
        print_flag_help("-a, --alt", "Compile with the fallback backend.", "spectre <input.sx> --alt")
        return 0
    }

    if str.raw_cmp(topic, "-b") == 0 || str.raw_cmp(topic, "--bootstrap") == 0 {
        print_flag_help("-b, --bootstrap", "Display backend output on error.", "spectre <input.sx> --bootstrap")
        return 0
    }

    if str.raw_cmp(topic, "-c") == 0 || str.raw_cmp(topic, "--compile") == 0 {
        print_flag_help("-c, --compile", "Compile only to produce an object file, without linking.", "spectre <input.sx> --compile")
        return 0
    }

    if str.raw_cmp(topic, "-d") == 0 || str.raw_starts_with(topic, "-d") {
        print_flag_help("-d<NAME>=<value>", "Define a compile-time environment variable. Reads through env.get(\"NAME\") are replaced with the supplied value at compile time.", "spectre -dGIT_HASH=abcdef <input.sx>")
        return 0
    }

    if str.raw_cmp(topic, "-o") == 0 || str.raw_cmp(topic, "--output") == 0 || str.raw_cmp(topic, "--output=<file>") == 0 {
        print_flag_help("-o, --output <file>", "Set the output path for a binary or build artifact.", "spectre <input.sx> -o <file>")
        return 0
    }

    if str.raw_cmp(topic, "-l") == 0 || str.raw_cmp(topic, "--loud") == 0 {
        print_flag_help("-l, --loud", "Show compilation stages with verbose output.", "spectre <input.sx> --loud")
        return 0
    }

    if str.raw_cmp(topic, "-v") == 0 || str.raw_cmp(topic, "--version") == 0 {
        print_flag_help("-v, --version", "Show the version of the installed Spectre compiler.", "spectre -v")
        return 0
    }

    if str.raw_cmp(topic, "-h") == 0 || str.raw_cmp(topic, "--help") == 0 {
        print_flag_help("-h, --help", "Print the general help message.", "spectre -h\n  spectre help <command|flag>")
        return 0
    }

    if str.raw_cmp(topic, "--stdio") == 0 {
        print_flag_help("--stdio", "Write formatted output to stdout instead of editing files in place.", "spectre fmt --stdio <file.sx|directory>...")
        return 0
    }

    if str.raw_cmp(topic, "--md") == 0 {
        print_flag_help("--md", "Generate Markdown documentation instead of HTML.", "spectre doc [path] --md")
        return 0
    }

    if str.raw_cmp(topic, "--fix") == 0 {
        print_flag_help("--fix", "Apply safe critic fixes to .sx files or directories.", "spectre critic --fix <file.sx|directory>...")
        return 0
    }

    stdio.print("error: unknown help topic '{s}'\n", {topic})
    stdio.puts("Run 'spectre help' to see available commands and flags.")
    return 1
}

pub fn print_src_target_help() void = {
    stdio.puts("--src-target=<os>")
    stdio.puts("")
    stdio.puts("  Mock the target OS for when blocks in source output.")
    stdio.puts("  Requires --emit-alt or --emit-ssa.")
    stdio.puts("")
    stdio.puts("  Valid targets:")
    stdio.puts("    windows, linux, darwin, freebsd, openbsd, netbsd,")
    stdio.puts("    dragonflybsd, android, haiku, redox, plan9")
    stdio.puts("")
    stdio.puts("  Example:")
    stdio.puts("    spectre file.sx --src-target=windows --emit-alt")
}
