    string.StringBuilder.append(sb,
        \\:root{
        \\  --bg:#f0f4fa;--bg2:#e4ecf7;--surface:#ffffff;--surface2:#f7f9fd;
        \\  --border:#c8d8ee;--border2:#dde8f5;
