val stdio      = use("std/stdio")
val mem        = use("mem.sx")
val str        = use("std/string")
val regex      = use("std/regex")
val fs         = use("std/fs")
val path       = use("std/path")
val os         = use("std/os")
val string     = use("std/string")
val algo       = use("std/algorithms")
val allocators = use("std/allocators")
val arenafmt   = use("arenafmt.sx")
val lexer      = use("../ast/lexer.sx")
val parser     = use("../ast/parser.sx")
val commands   = use("commands.sx")

type DocArenaState = {
    arena: mut allocators.ScopedArenaAllocator
}

val doc_arena_state: mut ref DocArenaState = none

fn doc_alloc(size: usize) ref void = trust {
    return allocators.ScopedArena.alloc_or_none(doc_arena_state.arena, size)
}

fn dfmt(format: str.StringView, args: argspack) ref u8 = trust {
    return arenafmt.format(doc_arena_state.arena, format, args).ptr
}

fn build_cstr(sb: ref void) ref u8 = trust {
    val built: ref void = string.StringBuilder.build(sb)
    val source: ref u8 = string.cstr(built)
    val len: i64 = str.len_raw(source)
    val out: ref u8 = doc_alloc((len + 1) as usize) as ref u8
    if out != none && len > 0 {
        @memcpy(out, source, len as usize)
    }
    if out != none {
        @store8(@ptradd(out, len), 0)
    }
    @free(source)
    @free(built)
    return out
}

type DocMap = {
    lines: mut list[i64]
    docs: mut list[ref u8]
}

type DocEntry = {
    kind: mut i64
    line: mut i64
    name: mut ref u8
    nav_name: mut ref u8
    anchor: mut ref u8
    signature: mut ref u8
    docs: mut ref u8
    method_docs: mut list[ref u8]
    is_private_fn: mut bool
    availability: mut ref u8
    node: mut ref parser.Node
}

type DocModule = {
    source_path: mut ref u8
    rel_path: mut ref u8
    module_name: mut ref u8
    output_path: mut ref u8
    is_root: mut bool
    entries: mut list[ref DocEntry]
}

fn safe_cstr(s: ref u8) ref u8 = {
    if s == none {
        return c""
    }
    return s
}

fn is_space(c: u8) bool = {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn substr(src: ref u8, start: i64, len: i64) ref u8 = trust {
    guarded pre {
        src_not_null: src != none
    }

    val src_len: i64 = str.len_raw(src)
    val safe_start: mut i64 = start
    if safe_start < 0 {
        safe_start = 0
    }
    if safe_start > src_len {
        safe_start = src_len
    }

    val max_len: i64 = src_len - safe_start
    val safe_len: mut i64 = len
    if safe_len < 0 {
        safe_len = 0
    }
    if safe_len > max_len {
        safe_len = max_len
    }

    val out: ref u8 = doc_alloc((safe_len + 1) as usize) as ref u8
    if out == none {
        return c""
    }
    if safe_len > 0 {
        @memcpy(out, @ptradd(src, safe_start), safe_len as usize)
    }
    @store8(@ptradd(out, safe_len), 0)

    guarded post {
        out_not_null: out != none
    }
    return out
}

fn copy_cstr(src: ref u8) ref u8 = trust {
    if src == none {
        return none
    }
    val len: i64 = str.len_raw(src)
    val out: ref u8 = doc_alloc((len + 1) as usize) as ref u8
    if out == none {
        return none
    }
    @memset(out, 0, len + 1)
    if len > 0 {
        @memcpy(out, src, len)
    }
    return out
}

fn trim_ws(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    if len == 0 {
        return c""
    }
    val start: mut i64 = 0
    for {
        if start >= len {
            break
        }
        val c: u8 = @load8(@ptradd(src, start))
        if !is_space(c) {
            break
        }
        start++
    }
    val finish: mut i64 = len
    for {
        if finish <= start {
            break
        }
        val c: u8 = @load8(@ptradd(src, finish - 1))
        if !is_space(c) {
            break
        }
        finish--
    }
    return substr(src, start, finish - start)
}

fn trim_trailing_slash(src: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(src)
    if len <= 1 {
        return src
    }
    if @load8(@ptradd(src, len - 1)) != 47 {
        return src
    }
    return substr(src, 0, len - 1)
}

fn normalize_rel_path(path: ref u8) ref u8 = trust {
    val no_dot: mut ref u8 = path
    if str.raw_starts_with(path, c"./") {
        no_dot = substr(path, 2, str.len_raw(path) - 2)
    }
    return trim_trailing_slash(no_dot)
}

fn path_dirname(path: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(path)
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(path, i)) == 47 {
            last_slash = i
        }
        i++
    }
    if last_slash < 0 {
        return c"."
    }
    if last_slash == 0 {
        return c"/"
    }
    return substr(path, 0, last_slash)
}

fn path_basename(path: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(path)
    val last_slash: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(path, i)) == 47 {
            last_slash = i
        }
        i++
    }
    return substr(path, last_slash + 1, len - last_slash - 1)
}

fn strip_sx_ext(path: ref u8) ref u8 = trust {
    if str.raw_ends_with(path, c".sx") {
        return substr(path, 0, str.len_raw(path) - 3)
    }
    return path
}

fn dir_exists(path: ref u8) bool = {
    val dir: ref void = trust fs.opendir(path)
    if dir == none {
        return false
    }
    trust fs.closedir(dir)
    return true
}

fn ensure_dir(path: ref u8) bool = trust {
    val clean = trim_trailing_slash(path)
    if str.str_eql(clean, c"") || str.str_eql(clean, c".") {
        return true
    }
    if os.exists(clean) {
        return true
    }
    val len: i64 = str.len_raw(clean)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(clean, i))
        if c == 47 {
            val part = substr(clean, 0, i)
            if !str.str_eql(part, c"") && !str.str_eql(part, c".") && !os.exists(part) {
                if !fs.mkdir_path_raw(part) {
                    return false
                }
            }
        }
        i++
    }
    if !os.exists(clean) {
        return fs.mkdir_path_raw(clean)
    }
    return true
}

fn ensure_parent_dir(file_path: ref u8) bool = trust {
    val dir = path_dirname(file_path)
    return ensure_dir(dir)
}

fn is_hidden_name(name: ref u8) bool = trust {
    val len: i64 = str.len_raw(name)
    if len == 0 {
        return false
    }
    return @load8(name) == 46
}

fn collect_sx_files(dir: ref u8, rel_dir: ref u8, out: mut list[ref u8]) void = trust {
    val walk_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(65536 as usize)?
    val walk_list_arena: allocators.ListArena = {arena: walk_arena}
    val entries_opt = fs.walk_dir[allocators.ListArena](walk_list_arena, dir)
    if entries_opt is some entries {
        val sorted = entries as list[ref u8]
        for entry in sorted {
            if str.str_eql(entry, c"") {
                continue
            }
            if is_hidden_name(entry) {
                continue
            }
            if str.raw_starts_with(entry, c"docs-out") {
                continue
            }
            val child_path: mut ref u8 = path.join_raw(dir, entry)
            val child_rel: mut ref u8 = entry
            val child_rel_owned: mut bool = false
            if !str.str_eql(rel_dir, c"") {
                child_rel = path.join_raw(rel_dir, entry)
                child_rel_owned = true
            }
            if dir_exists(child_path) {
                collect_sx_files(child_path, child_rel, out)
            } elif str.raw_ends_with(entry, c".sx") {
                @append(out, copy_cstr(normalize_rel_path(child_rel)))
            }
            if child_rel_owned {
                @free(child_rel)
            }
            @free(child_path)
        }
    }
    allocators.ScopedArena.free(walk_arena)
}

fn is_doc_target_line(line: ref u8) bool = trust {
    return str.raw_starts_with(line, c"fn ") ||
    str.raw_starts_with(line, c"pub fn ") ||
    str.raw_starts_with(line, c"val ") ||
    str.raw_starts_with(line, c"val (") ||
    str.raw_starts_with(line, c"pub val ") ||
    str.raw_starts_with(line, c"pub val (") ||
    str.raw_starts_with(line, c"extern ") ||
    str.raw_starts_with(line, c"pub extern ") ||
    str.raw_starts_with(line, c"type ") ||
    str.raw_starts_with(line, c"pub type ") ||
    str.raw_starts_with(line, c"enum ") ||
    str.raw_starts_with(line, c"pub enum ") ||
    str.raw_starts_with(line, c"union ") ||
    str.raw_starts_with(line, c"pub union ") ||
    str.raw_starts_with(line, c"spec ") ||
    str.raw_starts_with(line, c"pub spec ")
}

fn doc_line_text(trimmed: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(trimmed)
    if len <= 3 {
        return c""
    }
    if len > 3 && @load8(@ptradd(trimmed, 3)) == 32 {
        return substr(trimmed, 4, len - 4)
    }
    return substr(trimmed, 3, len - 3)
}

fn update_doc_map_for_line(
    map: ref DocMap,
    trimmed: ref u8,
    line_no: i64,
    current_doc: ref u8
) ref u8 = trust {
    guarded pre {
        map_not_null: map != none
        trimmed_not_null: trimmed != none
        current_doc_not_null: current_doc != none
        line_is_positive: line_no > 0
    }

    if str.raw_starts_with(trimmed, c"///") {
        val text = doc_line_text(trimmed)
        if str.str_eql(current_doc, c"") {
            return text
        }
        return dfmt("{s}\n{s}", {current_doc, text})
    }

    if !str.str_eql(current_doc, c"") && is_doc_target_line(trimmed) {
        @append(map.lines, line_no)
        @append(map.docs, current_doc)
        return c""
    }

    guarded post {
        lengths_match: @len(map.lines) == @len(map.docs)
    }
    return c""
}

fn extract_doc_map(src: str.StringView) ref DocMap = trust {
    guarded pre {
        src_not_null: src.ptr != none
    }

    val map: mut ref DocMap = doc_alloc(@sizeof(DocMap) as usize) as ref DocMap
    map.lines = mem.new[i64]()
    map.docs = mem.new[ref u8]()
    val len: i64 = src.len
    val line_no: mut i64 = 1
    val line_start: mut i64 = 0
    val i: mut i64 = 0
    val current_doc: mut ref u8 = c""
    for {
        if i >= len {
            val line = substr(src.ptr, line_start, len - line_start)
            val trimmed = trim_ws(line)
            current_doc = update_doc_map_for_line(map, trimmed, line_no, current_doc)
            break
        }

        val c: u8 = @load8(@ptradd(src.ptr, i))
        if c == 10 {
            val line = substr(src.ptr, line_start, i - line_start)
            val trimmed = trim_ws(line)
            current_doc = update_doc_map_for_line(map, trimmed, line_no, current_doc)
            line_no++
            line_start = i + 1
        }
        i++
    }

    guarded post {
        map_not_null: map != none
        lengths_match: @len(map.lines) == @len(map.docs)
    }
    return map
}

fn lookup_doc(map: ref DocMap, line: i64) ref u8 = trust {
    val len: i64 = @len(map.lines) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val line_opt = @get(map.lines, i as usize)
        if line_opt is some v {
            if ((v as i64) == line) {
                val doc_opt = @get(map.docs, i as usize)
                if doc_opt is some d {
                    return d as ref u8
                }
            }
        }
        i++
    }
    return c""
}

fn slugify(text: ref u8) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    val len: i64 = str.len_raw(text)
    val i: mut i64 = 0
    val prev_dash: mut bool = false
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(text, i))
        val is_lower: bool = c >= 97 && c <= 122
        val is_upper: bool = c >= 65 && c <= 90
        val is_digit: bool = c >= 48 && c <= 57
        if is_lower || is_digit {
            string.StringBuilder.append_char(sb, c)
            prev_dash = false
        } elif is_upper {
            string.StringBuilder.append_char(sb, (c + 32) as u8)
            prev_dash = false
        } else {
            if !prev_dash {
                string.StringBuilder.append_char(sb, 45 as u8)
                prev_dash = true
            }
        }
        i++
    }
    val out = build_cstr(sb)
    string.StringBuilder.free(sb)
    return out
}

fn anchor_for(kind_name: ref u8, item_name: ref u8, line: i64) ref u8 = trust {
    return slugify(dfmt("{s}-{s}-{lld}", {kind_name, item_name, line}))
}

fn render_type(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c""
    }
    match ty.kind {
        parser.TY_NAMED => {
            return parser.node_str_raw(ty.d0)
        }
        parser.TY_REF => {
            return dfmt("ref {s}", {render_type(ty.d0 as ref parser.Node)})
        }
        parser.TY_MUT => {
            return dfmt("mut {s}", {render_type(ty.d0 as ref parser.Node)})
        }
        parser.TY_OPTION => {
            return dfmt("option[{s}]", {render_type(ty.d0 as ref parser.Node)})
        }
        parser.TY_LIST => {
            return dfmt("list[{s}]", {render_type(ty.d0 as ref parser.Node)})
        }
        parser.TY_RESULT => {
            return dfmt(
                "result[{s}, {s}]",
                {render_type(ty.d0 as ref parser.Node), render_type(ty.d1 as ref parser.Node)}
            )
        }
        parser.TY_SLICE => {
            return dfmt("[]{s}", {render_type(ty.d0 as ref parser.Node)})
        }
        parser.TY_FIXED_ARR => {
            val size_name: ref u8 = parser.fixed_arr_size_name_raw(ty)
            if size_name != none {
                return dfmt("[{s}]{s}", {size_name, render_type(parser.fixed_arr_inner(ty))})
            }
            return dfmt(
                "[{lld}]{s}",
                {parser.fixed_arr_size(ty), render_type(parser.fixed_arr_inner(ty))}
            )
        }
        parser.TY_FNPTR => {
            val parts: mut ref u8 = c""
            val params = ty.d0 as list[ref parser.Node]
            for param in params {
                val part = render_type(param)
                if str.str_eql(parts, c"") {
                    parts = part
                } else {
                    parts = dfmt("{s}, {s}", {parts, part})
                }
            }
            return dfmt("fn({s}) {s}", {parts, render_type(ty.d1 as ref parser.Node)})
        }
        parser.TY_VOID => {
            return c"void"
        }
        parser.TY_ARGSPACK => {
            return c"argspack"
        }
    }
    return c"unknown"
}

fn render_fn_params(params: list[ref parser.Node]) ref u8 = trust {
    val out: mut ref u8 = c""
    for param in params {
        val param_name: ref u8 = parser.node_str_raw(param.d0)
        val param_ty: ref parser.Node = param.d1 as ref parser.Node
        val piece = dfmt("{s}: {s}", {param_name, render_type(param_ty)})
        if str.str_eql(out, c"") {
            out = piece
        } else {
            out = dfmt("{s}, {s}", {out, piece})
        }
    }
    return out
}

fn render_type_fields(fields: list[ref parser.Node]) ref u8 = trust {
    val out: mut ref u8 = c""
    for field in fields {
        val prefix: mut ref u8 = c""
        if field.d1 != 0 {
            prefix = c"mut "
        }
        val piece = dfmt(
            "{s}: {s}{s}",
            {parser.node_str_raw(field.d0), prefix, render_type(field.d2 as ref parser.Node)}
        )
        if str.str_eql(out, c"") {
            out = piece
        } else {
            out = dfmt("{s}, {s}", {out, piece})
        }
    }
    return out
}

fn render_type_list(types: list[ref parser.Node], delim: ref u8) ref u8 = trust {
    val out: mut ref u8 = c""
    for ty in types {
        val piece = render_type(ty)
        if str.str_eql(out, c"") {
            out = piece
        } else {
            out = dfmt("{s}{s}{s}", {out, delim, piece})
        }
    }
    return out
}

fn render_variant_list(values: list[ref u8], delim: ref u8) ref u8 = trust {
    val out: mut ref u8 = c""
    for value in values {
        if str.str_eql(out, c"") {
            out = value
        } else {
            out = dfmt("{s}{s}{s}", {out, delim, value})
        }
    }
    return out
}

fn render_expr_list(values: list[ref parser.Node], delim: ref u8) ref u8 = trust {
    val out: mut ref u8 = c""
    for value in values {
        val piece = render_const_expr(value)
        if str.str_eql(out, c"") {
            out = piece
        } else {
            out = dfmt("{s}{s}{s}", {out, delim, piece})
        }
    }
    return out
}

fn node_is_public(node: ref parser.Node) bool = {
    if node.kind == parser.NK_GENERIC_FN {
        return (node.d0 & 1) != 0
    }
    return node.d0 != 0
}

fn node_is_function(node: ref parser.Node) bool = {
    return node.kind == parser.NK_FN || node.kind == parser.NK_GENERIC_FN || node.kind == parser.NK_EXTERN_FN
}

fn module_has_private_functions(module: ref DocModule) bool = {
    for entry in module.entries {
        if entry.is_private_fn {
            return true
        }
    }
    return false
}

fn binop_text(op: i64) ref u8 = {
    if op == parser.OP_ADD {
        return c"+"
    }
    if op == parser.OP_SUB {
        return c"-"
    }
    if op == parser.OP_MUL {
        return c"*"
    }
    if op == parser.OP_DIV {
        return c"/"
    }
    if op == parser.OP_REM {
        return c"%"
    }
    if op == parser.OP_EQ {
        return c"=="
    }
    if op == parser.OP_NE {
        return c"!="
    }
    if op == parser.OP_LT {
        return c"<"
    }
    if op == parser.OP_GT {
        return c">"
    }
    if op == parser.OP_LE {
        return c"<="
    }
    if op == parser.OP_GE {
        return c">="
    }
    if op == parser.OP_AND {
        return c"and"
    }
    if op == parser.OP_OR {
        return c"or"
    }
    if op == parser.OP_BAND {
        return c"&"
    }
    if op == parser.OP_BOR {
        return c"|"
    }
    if op == parser.OP_BXOR {
        return c"^"
    }
    if op == parser.OP_SHL {
        return c"<<"
    }
    if op == parser.OP_SHR {
        return c">>"
    }
    return c"?"
}

fn unop_text(op: i64) ref u8 = {
    if op == parser.UOP_NOT {
        return c"not "
    }
    if op == parser.UOP_NEG {
        return c"-"
    }
    if op == parser.UOP_BNOT {
        return c"~"
    }
    return c""
}

fn render_const_expr(expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c"..."
    }
    val kind: i64 = expr.kind
    if kind == parser.NK_INT_LIT {
        return parser.int_lit_text_raw(expr)
    }
    if kind == parser.NK_FLOAT_LIT {
        return parser.float_lit_text_raw(expr)
    }
    if kind == parser.NK_STR_LIT {
        return dfmt("\"{s}\"", {parser.str_lit_text_raw(expr)})
    }
    if kind == parser.NK_IDENT {
        return parser.node_str_raw(expr.d0)
    }
    if kind == parser.NK_BOOL {
        if expr.d0 != 0 {
            return c"true"
        }
        return c"false"
    }
    if kind == parser.NK_CHAR_LIT {
        return dfmt("'{s}'", {parser.node_str_raw(expr.d0)})
    }
    if kind == parser.NK_NONE {
        return c"none"
    }
    if kind == parser.NK_ZERO_INIT {
        return dfmt("@zeroed[{s}]", {parser.node_str_raw(expr.d0)})
    }
    if kind == parser.NK_UNOP {
        return dfmt(
            "{s}{s}",
            {unop_text(parser.unop_op(expr)), render_const_expr(parser.unop_inner(expr))}
        )
    }
    if kind == parser.NK_BINOP {
        return dfmt("{s} {s} {s}", {
                render_const_expr(parser.binop_left(expr)),
                binop_text(parser.binop_op(expr)),
                render_const_expr(parser.binop_right(expr))
            })
    }
    if kind == parser.NK_FIELD {
        return dfmt(
            "{s}.{s}",
            {render_const_expr(parser.field_base(expr)), parser.field_name_raw(expr)}
        )
    }
    if kind == parser.NK_CALL {
        return dfmt("{s}({s})", {
                render_const_expr(parser.call_callee(expr)),
                render_expr_list(parser.call_args(expr), c", ")
            })
    }
    if kind == parser.NK_CAST {
        return dfmt(
            "{s} as {s}",
            {render_const_expr(expr.d1 as ref parser.Node), render_type(expr.d0 as ref parser.Node)}
        )
    }
    if kind == parser.NK_ADDR {
        return dfmt("@addr({s})", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_DEREF {
        return dfmt("*{s}", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_TRY {
        return dfmt("{s}?", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_SOME {
        return dfmt("some {s}", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_OK_VAL {
        return dfmt("ok {s}", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_ERR_VAL {
        return dfmt("err {s}", {render_const_expr(expr.d0 as ref parser.Node)})
    }
    if kind == parser.NK_BUILTIN {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val rendered_btargs: ref u8 = render_type_list(btargs, c", ")
        if !str.str_eql(rendered_btargs, c"") {
            return dfmt(
                "@{s}[{s}]({s})",
                {
                    parser.node_str_raw(expr.d0),
                    rendered_btargs,
                    render_expr_list(expr.d1 as list[ref parser.Node], c", ")
                }
            )
        }
        return dfmt(
            "@{s}({s})",
            {parser.node_str_raw(expr.d0), render_expr_list(expr.d1 as list[ref parser.Node], c", ")}
        )
    }
    if kind == parser.NK_LIST_LIT {
        return dfmt("[{s}]", {render_expr_list(expr.d0 as list[ref parser.Node], c", ")})
    }
    if kind == parser.NK_ARGS_PACK {
        return dfmt("\\{{s}\\}", {render_expr_list(expr.d0 as list[ref parser.Node], c", ")})
    }
    return c"..."
}

fn render_tagged_variants(values: list[ref parser.Node]) ref u8 = trust {
    val out: mut ref u8 = c""
    for value in values {
        val types = value.d1 as list[ref parser.Node]
        val rendered_types = render_type_list(types, c", ")
        val piece: mut ref u8 = parser.node_str_raw(value.d0)
        if !str.str_eql(rendered_types, c"") {
            piece = dfmt("{s}({s})", {piece, rendered_types})
        } else {
            piece = dfmt("{s}()", {piece})
        }
        if str.str_eql(out, c"") {
            out = piece
        } else {
            out = dfmt("{s} | {s}", {out, piece})
        }
    }
    return out
}

fn render_type_signature(node: ref parser.Node) ref u8 = trust {
    val public_prefix: mut ref u8 = c""
    if node_is_public(node) {
        public_prefix = c"pub "
    }
    if node.kind == parser.NK_TYPEDEF || node.kind == parser.NK_EXTERN_TYPE {
        val extern_prefix: mut ref u8 = c""
        if node.kind == parser.NK_EXTERN_TYPE {
            extern_prefix = c"extern "
        }
        val fields = render_type_fields(node.d2 as list[ref parser.Node])
        return dfmt(
            "{s}{s}type {s} = \\{ {s} \\}",
            {public_prefix, extern_prefix, parser.node_str_raw(node.d1), fields}
        )
    }
    if node.kind == parser.NK_ENUMDEF {
        val variants = render_variant_list(node.d2 as list[ref u8], c", ")
        return dfmt(
            "{s}enum {s} = \\{ {s} \\}",
            {public_prefix, parser.node_str_raw(node.d1), variants}
        )
    }
    if node.kind == parser.NK_UNIONDEF {
        val variants = render_type_list(node.d2 as list[ref parser.Node], c" | ")
        return dfmt(
            "{s}union {s} = \\{ {s} \\}",
            {public_prefix, parser.node_str_raw(node.d1), variants}
        )
    }
    if node.kind == parser.NK_TAGGED_UNIONDEF {
        val variants = render_tagged_variants(node.d2 as list[ref parser.Node])
        return dfmt(
            "{s}union {s} = \\{ {s} \\}",
            {public_prefix, parser.node_str_raw(node.d1), variants}
        )
    }
    return c""
}

fn render_fn_signature(node: ref parser.Node) ref u8 = trust {
    if node.kind == parser.NK_EXTERN_FN {
        val public_prefix: mut ref u8 = c""
        if node_is_public(node) {
            public_prefix = c"pub "
        }
        val conv: ref u8 = parser.node_str_raw(node.d3)
        val params = render_fn_params(node.d4 as list[ref parser.Node])
        val variadic_suffix: mut ref u8 = c""
        if parser.extern_fn_is_variadic(node) {
            if str.str_eql(params, c"") {
                variadic_suffix = c"..."
            } else {
                variadic_suffix = c", ..."
            }
        }
        val header_mod: mut ref u8 = c""
        if parser.extern_fn_uses_header(node) {
            header_mod = c", header"
        }
        val unsafe_suffix: mut ref u8 = c""
        if parser.fn_is_unsafe(node) {
            unsafe_suffix = c" = trust { ... }"
        }
        return dfmt("{s}extern ({s}{s}) fn {s}({s}{s}) {s}{s} = \"{s}\"", {
                public_prefix,
                conv,
                header_mod,
                parser.node_str_raw(node.d1),
                params,
                variadic_suffix,
                render_type(node.d5 as ref parser.Node),
                unsafe_suffix,
                parser.node_str_raw(node.d2)
            })
    }
    val public_prefix: mut ref u8 = c""
    if node_is_public(node) {
        public_prefix = c"pub "
    }
    val receiver: mut ref u8 = c""
    if node.d1 != 0 as i64 {
        receiver = dfmt("({s}) ", {parser.node_str_raw(node.d1)})
    }
    val type_params: mut ref u8 = c""
    if node.kind == parser.NK_GENERIC_FN {
        val tp_nodes: list[ref parser.Node] = parser.generic_fn_type_params(node)
        val tp_strs: mut list[ref u8] = mem.new[ref u8]()
        for tp in tp_nodes {
            val tp_constraint: ref parser.Node = parser.tparam_constraint(tp as ref parser.Node)
            if tp_constraint != none {
                @append(
                    tp_strs,
                    dfmt(
                        "{s}: {s}",
                        {parser.tparam_name_raw(tp as ref parser.Node), render_type(tp_constraint)}
                    )
                )
            } else {
                @append(tp_strs, parser.tparam_name_raw(tp as ref parser.Node))
            }
        }
        val parts = render_variant_list(tp_strs, c", ")
        if !str.str_eql(parts, c"") {
            type_params = dfmt("[{s}]", {parts})
        }
    }
    val unsafe_suffix: mut ref u8 = c""
    if node.kind == parser.NK_FN && parser.fn_is_unsafe(node) {
        unsafe_suffix = c" = trust { ... }"
    }
    val params = render_fn_params(node.d3 as list[ref parser.Node])
    return dfmt("{s}fn {s}{s}{s}({s}) {s}{s}", {
            public_prefix,
            receiver,
            parser.node_str_raw(node.d2),
            type_params,
            params,
            render_type(node.d4 as ref parser.Node),
            unsafe_suffix
        })
}

fn render_spec_signature(node: ref parser.Node) ref u8 = trust {
    val public_prefix: mut ref u8 = c""
    if node_is_public(node) {
        public_prefix = c"pub "
    }
    val methods = node.d2 as list[ref parser.Node]
    val rendered: mut ref u8 = c""
    for method in methods {
        val method_signature = render_fn_signature(method)
        if str.str_eql(rendered, c"") {
            rendered = method_signature
        } else {
            rendered = dfmt("{s}\n    {s}", {rendered, method_signature})
        }
    }
    if str.str_eql(rendered, c"") {
        return dfmt("{s}spec {s} = \\{\\}", {public_prefix, parser.node_str_raw(node.d1)})
    }
    return dfmt(
        "{s}spec {s} = \\{\n    {s}\n\\}",
        {public_prefix, parser.node_str_raw(node.d1), rendered}
    )
}

fn render_const_signature(node: ref parser.Node) ref u8 = trust {
    val public_prefix: mut ref u8 = c""
    if node_is_public(node) {
        public_prefix = c"pub "
    }
    return dfmt("{s}val {s} = {s}", {
            public_prefix,
            parser.node_str_raw(node.d1),
            render_const_expr(node.d2 as ref parser.Node)
        })
}

fn entry_kind_name(kind: i64) ref u8 = {
    if kind == parser.NK_FN || kind == parser.NK_GENERIC_FN || kind == parser.NK_EXTERN_FN {
        return c"function"
    }
    if kind == parser.NK_CONST {
        return c"constant"
    }
    if kind == parser.NK_SPEC {
        return c"spec"
    }
    return c"type"
}

fn entry_name(node: ref parser.Node) ref u8 = trust {
    if node.kind == parser.NK_EXTERN_FN {
        return parser.node_str_raw(node.d1)
    }
    if node.kind == parser.NK_FN || node.kind == parser.NK_GENERIC_FN {
        return parser.node_str_raw(node.d2)
    }
    return parser.node_str_raw(node.d1)
}

fn entry_nav_name(node: ref parser.Node) ref u8 = trust {
    if ((node.kind == parser.NK_FN || node.kind == parser.NK_GENERIC_FN) && node.d1 != 0 as i64) {
        return dfmt("{s}.{s}", {parser.node_str_raw(node.d1), parser.node_str_raw(node.d2)})
    }
    return entry_name(node)
}

fn add_entry(
    entries: mut list[ref DocEntry],
    node: ref parser.Node,
    doc_map: ref DocMap,
    availability: ref u8
) void = trust {
    val item: mut ref DocEntry = doc_alloc(@sizeof(DocEntry) as usize) as ref DocEntry
    item.kind = node.kind
    item.line = node.line
    item.name = entry_name(node)
    item.nav_name = entry_nav_name(node)
    item.anchor = anchor_for(entry_kind_name(node.kind), item.name, node.line)
    item.docs = lookup_doc(doc_map, node.line)
    item.method_docs = mem.new[ref u8]()
    item.is_private_fn = node_is_function(node) && !node_is_public(node)
    item.availability = availability
    item.node = node
    if node.kind == parser.NK_FN || node.kind == parser.NK_GENERIC_FN || node.kind == parser.NK_EXTERN_FN {
        item.signature = render_fn_signature(node)
    } elif node.kind == parser.NK_SPEC {
        for method in node.d2 as list[ref parser.Node] {
            @append(item.method_docs, lookup_doc(doc_map, method.line))
        }
        item.signature = render_spec_signature(node)
    } elif node.kind == parser.NK_CONST {
        item.signature = render_const_signature(node)
    } else {
        item.signature = render_type_signature(node)
    }
    @append(entries, item)
}

fn combine_availability(a: ref u8, b: ref u8) ref u8 = trust {
    if str.str_eql(a, c"") {
        return b
    }
    if str.str_eql(b, c"") {
        return a
    }
    return dfmt("{s}, {s}", {a, b})
}

fn collect_entries(
    items: list[ref parser.Node],
    doc_map: ref DocMap,
    out: mut list[ref DocEntry],
    availability: ref u8
) void = trust {
    for item in items {
        if item.kind == parser.NK_VAL_BULK {
            collect_entries(parser.val_bulk_items(item), doc_map, out, availability)
            continue
        }
        if item.kind == parser.NK_WHEN_ITEMS {
            val branch = combine_availability(
                availability,
                dfmt("when {s}", {parser.node_str_raw(item.d0)})
            )
            collect_entries(item.d1 as list[ref parser.Node], doc_map, out, branch)
            val or_branches = item.d2 as list[ref parser.Node]
            for branch_item in or_branches {
                val branch_avail = combine_availability(
                    availability,
                    dfmt("when {s}", {parser.node_str_raw(branch_item.d0)})
                )
                collect_entries(branch_item.d1 as list[ref parser.Node], doc_map, out, branch_avail)
            }
            val otherwise_items = item.d3 as list[ref parser.Node]
            if @len(otherwise_items) as i64 > 0 {
                collect_entries(
                    otherwise_items,
                    doc_map,
                    out,
                    combine_availability(availability, c"otherwise")
                )
            }
            continue
        }
        if item.kind == parser.NK_FN ||
        item.kind == parser.NK_GENERIC_FN ||
        item.kind == parser.NK_EXTERN_FN ||
        item.kind == parser.NK_TYPEDEF ||
        item.kind == parser.NK_EXTERN_TYPE ||
        item.kind == parser.NK_ENUMDEF ||
        item.kind == parser.NK_UNIONDEF ||
        item.kind == parser.NK_TAGGED_UNIONDEF ||
        item.kind == parser.NK_SPEC {
            add_entry(out, item, doc_map, availability)
        } elif item.kind == parser.NK_CONST && node_is_public(item) {
            add_entry(out, item, doc_map, availability)
        }
    }
}

fn load_module(
    parse_arena: allocators.ScopedArenaAllocator,
    source_path: ref u8,
    rel_path: ref u8
) ref DocModule = trust {
    val src_size_opt = fs.file_size_raw(source_path)
    val src_arena_cap: mut i64 = 4096
    if src_size_opt is some sz {
        if ((sz as i64) > src_arena_cap) {
            src_arena_cap = sz as i64
        }
    } else {
        stdio.print("error: could not read '{s}'\n", {source_path})
        os.exit(1)
    }
    val src_arena: allocators.Arena = allocators.Arena.new((src_arena_cap + 8) as usize)?
    val src_opt = fs.read_all_raw[allocators.Arena](src_arena, source_path)
    val src: mut ref u8 = c""
    if src_opt is some text {
        src = text as ref u8
    } else {
        allocators.Arena.free(src_arena)
        stdio.print("error: could not read '{s}'\n", {source_path})
        os.exit(1)
    }
    val doc_map = extract_doc_map(str.view_cstr(src))
    val toks_res = lexer.tokenize_with(parse_arena, src)
    allocators.Arena.free(src_arena)
    val toks: mut list[ref lexer.Token] = mem.new[ref lexer.Token]()
    match toks_res {
        ok t => {
            toks = t
        }
        err e => {
            stdio.print("error: {s}: {s}\n", {source_path, e})
            os.exit(1)
        }
    }
    val parse_res = parser.parse_module_with(parse_arena, toks, source_path)
    val items: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    match parse_res {
        ok p => {
            items = p
        }
        err e => {
            stdio.print("error: {s}\n", {e})
            os.exit(1)
        }
    }
    val mod: mut ref DocModule = doc_alloc(@sizeof(DocModule) as usize) as ref DocModule
    mod.source_path = source_path
    mod.rel_path = rel_path
    mod.module_name = strip_sx_ext(rel_path)
    mod.output_path = c""
    mod.is_root = false
    mod.entries = mem.new[ref DocEntry]()
    collect_entries(items, doc_map, mod.entries, c"")
    return mod
}

fn find_root_module(modules: list[ref DocModule], root_rel: ref u8) i64 = trust {
    val len: i64 = @len(modules) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val mod_opt = @get(modules, i as usize)
        if mod_opt is some v {
            val mod: ref DocModule = v as ref DocModule
            if str.str_eql(mod.rel_path, root_rel) {
                return i
            }
        }
        i++
    }
    return -1
}

fn module_output_path(module_name: ref u8, markdown: bool) ref u8 = trust {
    val ext: ref u8 = c"html"
    if markdown {
        return dfmt("pages/{s}.md", {module_name})
    }
    return dfmt("pages/{s}.{s}", {module_name, ext})
}

fn assign_output_paths(modules: list[ref DocModule], markdown: bool, root_idx: i64) void = trust {
    val len: i64 = @len(modules) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val mod_opt = @get(modules, i as usize)
        if mod_opt is some v {
            val mod: mut ref DocModule = v as ref DocModule
            mod.is_root = i == root_idx
            mod.output_path = module_output_path(mod.module_name, markdown)
        }
        i++
    }
}

fn html_escape(text: ref u8) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    val len: i64 = str.len_raw(text)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(text, i))
        if c == 38 {
            string.StringBuilder.append_cstr(sb, c"&amp;")
        } elif c == 60 {
            string.StringBuilder.append_cstr(sb, c"&lt;")
        } elif c == 62 {
            string.StringBuilder.append_cstr(sb, c"&gt;")
        } elif c == 34 {
            string.StringBuilder.append_cstr(sb, c"&quot;")
        } else {
            string.StringBuilder.append_char(sb, c)
        }
        i++
    }
    val out = build_cstr(sb)
    string.StringBuilder.free(sb)
    return out
}

fn append_doc_html(sb: ref void, docs: ref u8) void = trust {
    if str.str_eql(docs, c"") {
        return
    }
    val len: i64 = str.len_raw(docs)
    val line_start: mut i64 = 0
    val i: mut i64 = 0
    val paragraph: mut ref u8 = c""
    string.StringBuilder.append_cstr(sb, c"<div class=\"docs\">")
    for {
        if i >= len {
            val line = trim_ws(substr(docs, line_start, len - line_start))
            if str.str_eql(line, c"") {
                if !str.str_eql(paragraph, c"") {
                    string.StringBuilder.append_cstr(sb, c"<p>")
                    append_markdown_inline_html(sb, paragraph)
                    string.StringBuilder.append_cstr(sb, c"</p>")
                    paragraph = c""
                }
            } else {
                if str.str_eql(paragraph, c"") {
                    paragraph = line
                } else {
                    paragraph = dfmt("{s} {s}", {paragraph, line})
                }
            }
            break
        }
        val c: u8 = @load8(@ptradd(docs, i))
        if c == 10 {
            val line = trim_ws(substr(docs, line_start, i - line_start))
            if str.str_eql(line, c"") {
                if !str.str_eql(paragraph, c"") {
                    string.StringBuilder.append_cstr(sb, c"<p>")
                    append_markdown_inline_html(sb, paragraph)
                    string.StringBuilder.append_cstr(sb, c"</p>")
                    paragraph = c""
                }
            } else {
                if str.str_eql(paragraph, c"") {
                    paragraph = line
                } else {
                    paragraph = dfmt("{s} {s}", {paragraph, line})
                }
            }
            line_start = i + 1
        }
        i++
    }
    if !str.str_eql(paragraph, c"") {
        string.StringBuilder.append_cstr(sb, c"<p>")
        append_markdown_inline_html(sb, paragraph)
        string.StringBuilder.append_cstr(sb, c"</p>")
    }
    string.StringBuilder.append_cstr(sb, c"</div>")
}

fn render_entry_details_html(sb: ref void, entry: ref DocEntry) void = trust {
    val node = entry.node
    if node.kind == parser.NK_SPEC {
        val methods = node.d2 as list[ref parser.Node]
        if @len(methods) as i64 > 0 {
            string.StringBuilder.append_cstr(sb, c"<h4>Functions</h4><ul class=\"details\">")
            val idx: mut i64 = 0
            for method in methods {
                string.StringBuilder.append_cstr(sb, c"<li><code>")
                string.StringBuilder.append_cstr(sb, html_escape(render_fn_signature(method)))
                string.StringBuilder.append_cstr(sb, c"</code>")
                val method_doc_opt = @get(entry.method_docs, idx as usize)
                if method_doc_opt is some method_doc {
                    append_doc_html(sb, method_doc as ref u8)
                }
                string.StringBuilder.append_cstr(sb, c"</li>")
                idx++
            }
            string.StringBuilder.append_cstr(sb, c"</ul>")
        }
    } elif node.kind == parser.NK_TYPEDEF || node.kind == parser.NK_EXTERN_TYPE {
        val fields = node.d2 as list[ref parser.Node]
        if @len(fields) as i64 > 0 {
            string.StringBuilder.append_cstr(
                sb,
                c"<h4>Fields</h4><div class=\"details-table-wrap\"><table class=\"details-table\"><thead><tr><th>Name</th><th>Type</th></tr></thead><tbody>"
            )
            for field in fields {
                val prefix: mut ref u8 = c""
                if field.d1 != 0 {
                    prefix = c"mut "
                }
                string.StringBuilder.append_cstr(sb, c"<tr><td><code>")
                string.StringBuilder.append_cstr(sb, html_escape(parser.node_str_raw(field.d0)))
                string.StringBuilder.append_cstr(sb, c"</code></td><td><code>")
                string.StringBuilder.append_cstr(
                    sb,
                    html_escape(dfmt(
                            "{s}{s}",
                            {prefix, render_type(field.d2 as ref parser.Node)}
                        ))
                )
                string.StringBuilder.append_cstr(sb, c"</code></td></tr>")
            }
            string.StringBuilder.append_cstr(sb, c"</tbody></table></div>")
        }
    } elif node.kind == parser.NK_ENUMDEF {
        string.StringBuilder.append_cstr(sb, c"<h4>Variants</h4><ul class=\"details\">")
        for variant in node.d2 as list[ref u8] {
            string.StringBuilder.append_cstr(sb, c"<li><code>")
            string.StringBuilder.append_cstr(sb, html_escape(variant))
            string.StringBuilder.append_cstr(sb, c"</code></li>")
        }
        string.StringBuilder.append_cstr(sb, c"</ul>")
    } elif node.kind == parser.NK_UNIONDEF {
        string.StringBuilder.append_cstr(sb, c"<h4>Variants</h4><ul class=\"details\">")
        for variant in node.d2 as list[ref parser.Node] {
            string.StringBuilder.append_cstr(sb, c"<li><code>")
            string.StringBuilder.append_cstr(sb, html_escape(render_type(variant)))
            string.StringBuilder.append_cstr(sb, c"</code></li>")
        }
        string.StringBuilder.append_cstr(sb, c"</ul>")
    } elif node.kind == parser.NK_TAGGED_UNIONDEF {
        string.StringBuilder.append_cstr(sb, c"<h4>Variants</h4><ul class=\"details\">")
        for variant in node.d2 as list[ref parser.Node] {
            val types = render_type_list(variant.d1 as list[ref parser.Node], c", ")
            val text: mut ref u8 = parser.node_str_raw(variant.d0)
            if !str.str_eql(types, c"") {
                text = dfmt("{s}({s})", {text, types})
            } else {
                text = dfmt("{s}()", {text})
            }
            string.StringBuilder.append_cstr(sb, c"<li><code>")
            string.StringBuilder.append_cstr(sb, html_escape(text))
            string.StringBuilder.append_cstr(sb, c"</code></li>")
        }
        string.StringBuilder.append_cstr(sb, c"</ul>")
    }
}

fn render_entry_html(sb: ref void, entry: ref DocEntry) void = trust {
    val entry_class: mut ref u8 = c"entry"
    val entry_private: mut ref u8 = c"0"
    if entry.is_private_fn {
        entry_class = c"entry entry-private-fn s-hide"
        entry_private = c"1"
    }
    string.StringBuilder.append_cstr(sb, dfmt("<section class=\"{s}\" id=\"{s}\" data-name=\"{s}\" data-private=\"{s}\">", {
                entry_class,
                entry.anchor,
                html_escape(entry.nav_name),
                entry_private
            }))
    string.StringBuilder.append_cstr(
        sb,
        dfmt("<div class=\"entry-header\"><h3>{s}</h3>", {html_escape(entry.name)})
    )
    if !str.str_eql(entry.availability, c"") {
        string.StringBuilder.append_cstr(
            sb,
            dfmt("<span class=\"badge\">{s}</span>", {html_escape(entry.availability)})
        )
    }
    if entry.is_private_fn {
        string.StringBuilder.append_cstr(sb, c"<span class=\"badge badge-private\">private</span>")
    }
    string.StringBuilder.append_cstr(sb, c"</div>")
    string.StringBuilder.append_cstr(sb, c"<pre><code class=\"language-spectre\">")
    string.StringBuilder.append_cstr(sb, html_escape(entry.signature))
    string.StringBuilder.append_cstr(sb, c"</code></pre>")
    append_doc_html(sb, entry.docs)
    render_entry_details_html(sb, entry)
    string.StringBuilder.append_cstr(sb, c"</section>")
}

fn depth_prefix(output_path: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(output_path)
    val depth: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(output_path, i)) == 47 {
            depth++
        }
        i++
    }
    val prefix: mut ref u8 = c""
    val j: mut i64 = 0
    for {
        if j >= depth {
            break
        }
        prefix = dfmt("{s}../", {prefix})
        j++
    }
    return prefix
}

fn href_from(current_output: ref u8, target_output: ref u8) ref u8 = trust {
    return dfmt("{s}{s}", {depth_prefix(safe_cstr(current_output)), safe_cstr(target_output)})
}

fn nav_key(label: ref u8, unique: ref u8) ref u8 = trust {
    return dfmt("{s}\n{s}", {safe_cstr(label), safe_cstr(unique)})
}

fn nav_key_tail(key: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(key)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(key, i)) == 10 {
            return substr(key, i + 1, len - i - 1)
        }
        i++
    }
    return c""
}

fn append_sorted_module_nav_html(
    sb: ref void,
    modules: list[ref DocModule],
    current: ref DocModule
) void = trust {
    val keys: mut list[ref u8] = mem.new[ref u8]()
    for mod in modules {
        @append(keys, nav_key(mod.module_name, mod.output_path))
    }
    val sorted = algo.sort_alpha[allocators.ListArena](mem.allocator(), keys)
    for key in sorted {
        val target_output = nav_key_tail(key)
        for mod in modules {
            if !str.str_eql(mod.output_path, target_output) {
                continue
            }
            val cls: mut ref u8 = c"nav-item"
            if str.str_eql(mod.rel_path, current.rel_path) {
                cls = c"nav-item active"
            }
            string.StringBuilder.append_cstr(sb, dfmt("<a class=\"{s}\" href=\"{s}\" data-name=\"{s}\" data-private=\"0\">{s}</a>", {
                        cls,
                        href_from(current.output_path, mod.output_path),
                        html_escape(safe_cstr(mod.module_name)),
                        html_escape(safe_cstr(mod.module_name))
                    }))
            break
        }
    }
}

fn append_sorted_entry_nav_html(sb: ref void, entries: list[ref DocEntry]) void = trust {
    val keys: mut list[ref u8] = mem.new[ref u8]()
    for entry in entries {
        @append(keys, nav_key(entry.nav_name, entry.anchor))
    }
    val sorted = algo.sort_alpha[allocators.ListArena](mem.allocator(), keys)
    for key in sorted {
        val target_anchor = nav_key_tail(key)
        for entry in entries {
            if !str.str_eql(entry.anchor, target_anchor) {
                continue
            }
            val nav_class: mut ref u8 = c"nav-item"
            val entry_private: mut ref u8 = c"0"
            if entry.is_private_fn {
                nav_class = c"nav-item hidden"
                entry_private = c"1"
            }
            string.StringBuilder.append_cstr(sb, dfmt("<a class=\"{s}\" href=\"#{s}\" data-name=\"{s}\" data-private=\"{s}\">{s}</a>", {
                        nav_class,
                        entry.anchor,
                        html_escape(entry.nav_name),
                        entry_private,
                        html_escape(entry.nav_name)
                    }))
            break
        }
    }
}

fn append_nav_html(
    sb: ref void,
    modules: list[ref DocModule],
    current: ref DocModule
) void = trust {
    if @len(modules) as i64 > 1 {
        string.StringBuilder.append_cstr(
            sb,
            c"<div class=\"nav-section\"><div class=\"nav-label\">Modules</div>"
        )
        append_sorted_module_nav_html(sb, modules, current)
        string.StringBuilder.append_cstr(sb, c"</div>")
    }
    if @len(current.entries) as i64 > 0 {
        string.StringBuilder.append_cstr(
            sb,
            c"<div class=\"nav-section\"><div class=\"nav-label\">On this page</div>"
        )
        append_sorted_entry_nav_html(sb, current.entries)
        string.StringBuilder.append_cstr(sb, c"</div>")
    }
}

fn read_text_file_or_empty(file_path: ref u8) ref u8 = trust {
    val size_opt = fs.file_size_raw(file_path)
    val arena_cap: mut i64 = 4096
    if size_opt is some sz {
        if ((sz as i64) > arena_cap) {
            arena_cap = sz as i64
        }
    } else {
        return c""
    }
    val arena: allocators.Arena = allocators.Arena.new((arena_cap + 8) as usize)?
    val content_opt = fs.read_all_raw[allocators.Arena](arena, file_path)
    val content: mut ref u8 = c""
    if content_opt is some text {
        content = copy_cstr(text as ref u8)
    }
    allocators.Arena.free(arena)
    if content == none {
        return c""
    }
    return content
}

fn load_directory_readme(dir_path: ref u8) ref u8 = trust {
    val base_dir: mut ref u8 = dir_path
    if str.str_eql(base_dir, c"") {
        base_dir = c"."
    }
    val readme_md: mut ref u8 = path.join_raw(base_dir, c"README.md")
    if os.exists(readme_md) {
        val text = read_text_file_or_empty(readme_md)
        @free(readme_md)
        return text
    }
    @free(readme_md)
    val readme_plain: mut ref u8 = path.join_raw(base_dir, c"README")
    if os.exists(readme_plain) {
        val text = read_text_file_or_empty(readme_plain)
        @free(readme_plain)
        return text
    }
    @free(readme_plain)
    return c""
}

fn markdown_heading_level(line: ref u8) i64 = trust {
    val len: i64 = str.len_raw(line)
    val level: mut i64 = 0
    for {
        if level >= len || level >= 6 {
            break
        }
        if @load8(@ptradd(line, level)) != 35 {
            break
        }
        level++
    }
    if level == 0 || level >= len {
        return 0
    }
    if @load8(@ptradd(line, level)) != 32 {
        return 0
    }
    return level
}

fn markdown_title(markdown: ref u8, fallback: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(markdown)
    val line_start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            val line = trim_ws(substr(markdown, line_start, len - line_start))
            val level = markdown_heading_level(line)
            if level > 0 {
                return trim_ws(substr(line, level + 1, str.len_raw(line) - level - 1))
            }
            break
        }
        if @load8(@ptradd(markdown, i)) == 10 {
            val line = trim_ws(substr(markdown, line_start, i - line_start))
            val level = markdown_heading_level(line)
            if level > 0 {
                return trim_ws(substr(line, level + 1, str.len_raw(line) - level - 1))
            }
            line_start = i + 1
        }
        i++
    }
    return fallback
}

fn find_byte(text: ref u8, start: i64, needle: u8) i64 = trust {
    val len: i64 = str.len_raw(text)
    val i: mut i64 = start
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(text, i)) == needle {
            return i
        }
        i++
    }
    return -1
}

fn append_html_escaped_char(sb: ref void, c: u8) void = trust {
    if c == 38 {
        string.StringBuilder.append_cstr(sb, c"&amp;")
    } elif c == 60 {
        string.StringBuilder.append_cstr(sb, c"&lt;")
    } elif c == 62 {
        string.StringBuilder.append_cstr(sb, c"&gt;")
    } elif c == 34 {
        string.StringBuilder.append_cstr(sb, c"&quot;")
    } else {
        string.StringBuilder.append_char(sb, c)
    }
}

fn append_markdown_inline_html(sb: ref void, text: ref u8) void = trust {
    val len: i64 = str.len_raw(text)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(text, i))
        if c == 33 && i + 1 < len && @load8(@ptradd(text, i + 1)) == 91 {
            val alt_end = find_byte(text, i + 2, 93 as u8)
            if alt_end >= 0 && alt_end + 1 < len && @load8(@ptradd(text, alt_end + 1)) == 40 {
                val url_end = find_byte(text, alt_end + 2, 41 as u8)
                if url_end >= 0 {
                    val alt = substr(text, i + 2, alt_end - i - 2)
                    val src = substr(text, alt_end + 2, url_end - alt_end - 2)
                    string.StringBuilder.append_cstr(sb, dfmt("<img src=\"{s}\" alt=\"{s}\" loading=\"lazy\">", {
                                html_escape(src),
                                html_escape(alt)
                            }))
                    i = url_end + 1
                    continue
                }
            }
        }
        if c == 91 {
            val label_end = find_byte(text, i + 1, 93 as u8)
            if label_end >= 0 && label_end + 1 < len && @load8(@ptradd(text, label_end + 1)) == 40 {
                val href_end = find_byte(text, label_end + 2, 41 as u8)
                if href_end >= 0 {
                    val label = substr(text, i + 1, label_end - i - 1)
                    val href = substr(text, label_end + 2, href_end - label_end - 2)
                    string.StringBuilder.append_cstr(
                        sb,
                        dfmt("<a href=\"{s}\">", {html_escape(href)})
                    )
                    append_markdown_inline_html(sb, label)
                    string.StringBuilder.append_cstr(sb, c"</a>")
                    i = href_end + 1
                    continue
                }
            }
        }
        if c == 96 {
            val code_end = find_byte(text, i + 1, 96 as u8)
            if code_end >= 0 {
                string.StringBuilder.append_cstr(sb, c"<code>")
                string.StringBuilder.append_cstr(
                    sb,
                    html_escape(substr(text, i + 1, code_end - i - 1))
                )
                string.StringBuilder.append_cstr(sb, c"</code>")
                i = code_end + 1
                continue
            }
        }
        append_html_escaped_char(sb, c)
        i++
    }
}

fn flush_markdown_paragraph_html(sb: ref void, paragraph: ref u8) ref u8 = trust {
    if str.str_eql(paragraph, c"") {
        return c""
    }
    string.StringBuilder.append_cstr(sb, c"<p>")
    append_markdown_inline_html(sb, paragraph)
    string.StringBuilder.append_cstr(sb, c"</p>")
    return c""
}

fn close_markdown_list_html(sb: ref void, in_list: bool) bool = trust {
    if !in_list {
        return false
    }
    string.StringBuilder.append_cstr(sb, c"</ul>")
    return false
}

fn append_markdown_html(sb: ref void, markdown: ref u8) void = trust {
    val len: i64 = str.len_raw(markdown)
    val line_start: mut i64 = 0
    val i: mut i64 = 0
    val paragraph: mut ref u8 = c""
    val in_list: mut bool = false
    val in_code: mut bool = false
    val code_lang: mut ref u8 = c""

    for {
        if i >= len {
            val line = substr(markdown, line_start, len - line_start)
            val trimmed = trim_ws(line)
            if in_code {
                if !str.str_eql(line, c"") {
                    string.StringBuilder.append_cstr(sb, html_escape(line))
                }
                string.StringBuilder.append_cstr(sb, c"</code></pre>")
            } elif str.str_eql(trimmed, c"") {
                paragraph = flush_markdown_paragraph_html(sb, paragraph)
                in_list = close_markdown_list_html(sb, in_list)
            } else {
                val level = markdown_heading_level(trimmed)
                if level > 0 {
                    paragraph = flush_markdown_paragraph_html(sb, paragraph)
                    in_list = close_markdown_list_html(sb, in_list)
                    val heading_text = trim_ws(substr(
                            trimmed,
                            level + 1,
                            str.len_raw(trimmed) - level - 1
                        ))
                    val tag = dfmt("h{lld}", {level})
                    string.StringBuilder.append_cstr(sb, dfmt("<{s}>", {tag}))
                    append_markdown_inline_html(sb, heading_text)
                    string.StringBuilder.append_cstr(sb, dfmt("</{s}>", {tag}))
                } elif str.raw_starts_with(trimmed, c"- ") || str.raw_starts_with(trimmed, c"* ") {
                    paragraph = flush_markdown_paragraph_html(sb, paragraph)
                    if !in_list {
                        string.StringBuilder.append_cstr(sb, c"<ul>")
                        in_list = true
                    }
                    string.StringBuilder.append_cstr(sb, c"<li>")
                    append_markdown_inline_html(
                        sb,
                        trim_ws(substr(trimmed, 2, str.len_raw(trimmed) - 2))
                    )
                    string.StringBuilder.append_cstr(sb, c"</li>")
                } else {
                    in_list = close_markdown_list_html(sb, in_list)
                    if str.str_eql(paragraph, c"") {
                        paragraph = trimmed
                    } else {
                        paragraph = dfmt("{s} {s}", {paragraph, trimmed})
                    }
                    paragraph = flush_markdown_paragraph_html(sb, paragraph)
                }
            }
            break
        }
        if @load8(@ptradd(markdown, i)) == 10 {
            val line = substr(markdown, line_start, i - line_start)
            val trimmed = trim_ws(line)
            if in_code {
                if str.raw_starts_with(trimmed, c"```") {
                    string.StringBuilder.append_cstr(sb, c"</code></pre>")
                    in_code = false
                    code_lang = c""
                } else {
                    string.StringBuilder.append_cstr(sb, html_escape(line))
                    string.StringBuilder.append_cstr(sb, c"\n")
                }
            } elif str.raw_starts_with(trimmed, c"```") {
                paragraph = flush_markdown_paragraph_html(sb, paragraph)
                in_list = close_markdown_list_html(sb, in_list)
                code_lang = trim_ws(substr(trimmed, 3, str.len_raw(trimmed) - 3))
                if str.str_eql(code_lang, c"") {
                    string.StringBuilder.append_cstr(sb, c"<pre><code>")
                } else {
                    string.StringBuilder.append_cstr(
                        sb,
                        dfmt("<pre><code class=\"language-{s}\">", {html_escape(code_lang)})
                    )
                }
                in_code = true
            } elif str.str_eql(trimmed, c"") {
                paragraph = flush_markdown_paragraph_html(sb, paragraph)
                in_list = close_markdown_list_html(sb, in_list)
            } else {
                val level = markdown_heading_level(trimmed)
                if level > 0 {
                    paragraph = flush_markdown_paragraph_html(sb, paragraph)
                    in_list = close_markdown_list_html(sb, in_list)
                    val heading_text = trim_ws(substr(
                            trimmed,
                            level + 1,
                            str.len_raw(trimmed) - level - 1
                        ))
                    val tag = dfmt("h{lld}", {level})
                    string.StringBuilder.append_cstr(sb, dfmt("<{s}>", {tag}))
                    append_markdown_inline_html(sb, heading_text)
                    string.StringBuilder.append_cstr(sb, dfmt("</{s}>", {tag}))
                } elif str.raw_starts_with(trimmed, c"- ") || str.raw_starts_with(trimmed, c"* ") {
                    paragraph = flush_markdown_paragraph_html(sb, paragraph)
                    if !in_list {
                        string.StringBuilder.append_cstr(sb, c"<ul>")
                        in_list = true
                    }
                    string.StringBuilder.append_cstr(sb, c"<li>")
                    append_markdown_inline_html(
                        sb,
                        trim_ws(substr(trimmed, 2, str.len_raw(trimmed) - 2))
                    )
                    string.StringBuilder.append_cstr(sb, c"</li>")
                } else {
                    in_list = close_markdown_list_html(sb, in_list)
                    if str.str_eql(paragraph, c"") {
                        paragraph = trimmed
                    } else {
                        paragraph = dfmt("{s} {s}", {paragraph, trimmed})
                    }
                }
            }
            line_start = i + 1
        }
        i++
    }
}

fn append_page_head_html(sb: ref void, title: ref u8) void = trust {
    string.StringBuilder.append_cstr(
        sb,
        c"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    )
    string.StringBuilder.append_cstr(
        sb,
        dfmt("<title>{s} - Docs</title>", {html_escape(safe_cstr(title))})
    )
    string.StringBuilder.append_cstr(
        sb,
        c"<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    )
    string.StringBuilder.append_cstr(
        sb,
        c"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">"
    )
    string.StringBuilder.append_cstr(
        sb,
        c"<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">"
    )
