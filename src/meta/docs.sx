    )
    string.StringBuilder.append_cstr(sb, c"</style></head><body>")
}

fn append_page_shell_start_html(
    sb: ref void,
    modules: list[ref DocModule],
    current: ref DocModule,
    has_private_functions: bool
) void = trust {
    string.StringBuilder.append_cstr(
        sb,
        c"<button class=\"toggle\" id=\"toggle\" aria-label=\"Toggle sidebar\"><svg viewBox=\"0 0 24 24\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"/></svg></button>"
    )

    string.StringBuilder.append_cstr(
        sb,
        dfmt(
            "<a class=\"control-btn home-btn\" id=\"home-btn\" href=\"{s}\" aria-label=\"Documentation home\" title=\"Documentation home\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg></a>",
            {href_from(current.output_path, c"index.html")}
        )
    )

    if has_private_functions {
        string.StringBuilder.append_cstr(
            sb,
            c"<button class=\"control-btn private-toggle-btn\" id=\"private-toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"Show private functions\" title=\"Show private functions\"><svg id=\"private-toggle-icon\" viewBox=\"0 0 24 24\"><path d=\"M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button>"
        )
    }

    string.StringBuilder.append_cstr(
        sb,
        c"<button class=\"control-btn theme-btn\" id=\"theme-btn\" aria-label=\"Toggle theme\"><svg id=\"theme-icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"23\"/><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"/><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"/><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"/><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"/><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"/><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"/></svg></button>"
    )

    string.StringBuilder.append_cstr(sb, c"<div class=\"page\">")

    string.StringBuilder.append_cstr(sb, c"<aside class=\"sidebar\" id=\"sidebar\">")
    string.StringBuilder.append_cstr(
        sb,
        c"<div class=\"sb-search\"><svg class=\"sb-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg><input class=\"sb-input\" id=\"search\" type=\"search\" placeholder=\"Search... (/)\" autocomplete=\"off\" spellcheck=\"false\"/></div>"
    )
    string.StringBuilder.append_cstr(sb, c"<nav class=\"sb-nav\" id=\"sb-nav\">")
    append_nav_html(sb, modules, current)
    string.StringBuilder.append_cstr(sb, c"</nav></aside>")

    string.StringBuilder.append_cstr(sb, c"<main class=\"content\" id=\"content\">")
}

fn append_page_shell_end_html(sb: ref void) void = trust {
    string.StringBuilder.append_cstr(sb, c"</main></div>")
    string.StringBuilder.append_cstr(sb, c"<script>")
    string.StringBuilder.append(sb,
        \\(function(){
        \\'use strict';
        \\
