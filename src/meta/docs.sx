fn render_module_page_html(module: ref DocModule, modules: list[ref DocModule]) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    val has_private_functions: bool = module_has_private_functions(module)
    append_page_head_html(sb, safe_cstr(module.module_name))
    append_page_shell_start_html(sb, modules, module, has_private_functions)
    string.StringBuilder.append_cstr(sb, dfmt("<div class=\"hero\"><div class=\"hero-top\"><div><h1>{s}</h1><div class=\"hero-meta\"><span class=\"label\">source</span><code>{s}</code></div></div>", {
                html_escape(safe_cstr(module.module_name)),
                html_escape(safe_cstr(module.rel_path))
            }))
    string.StringBuilder.append_cstr(sb, c"</div></div>")

    for entry in module.entries {
        render_entry_html(sb, entry)
    }
    if @len(module.entries) as i64 == 0 {
        string.StringBuilder.append_cstr(
            sb,
            c"<div class=\"empty\">No documented items found in this module.</div>"
        )
    }
    append_page_shell_end_html(sb)
    val out = build_cstr(sb)
    string.StringBuilder.free(sb)
    return out
}

fn append_md_indented(sb: ref void, text: ref u8, indent: ref u8) void = trust {
    if str.str_eql(text, c"") {
        return
    }
    val len: i64 = str.len_raw(text)
    val line_start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            val line = trim_ws(substr(text, line_start, len - line_start))
            if !str.str_eql(line, c"") {
                string.StringBuilder.append_cstr(sb, indent)
                string.StringBuilder.append_cstr(sb, line)
                string.StringBuilder.append_cstr(sb, c"\n")
            }
            break
        }
        if @load8(@ptradd(text, i)) == 10 {
            val line = trim_ws(substr(text, line_start, i - line_start))
            if str.str_eql(line, c"") {
                string.StringBuilder.append_cstr(sb, c"\n")
            } else {
                string.StringBuilder.append_cstr(sb, indent)
                string.StringBuilder.append_cstr(sb, line)
                string.StringBuilder.append_cstr(sb, c"\n")
            }
            line_start = i + 1
        }
        i++
    }
}

fn render_entry_details_md(sb: ref void, entry: ref DocEntry) void = trust {
    val node = entry.node
    if node.kind == parser.NK_SPEC {
        val methods = node.d2 as list[ref parser.Node]
        if @len(methods) as i64 > 0 {
            string.StringBuilder.append_cstr(sb, c"\n**Methods**\n\n")
            val idx: mut i64 = 0
            for method in methods {
                string.StringBuilder.append_cstr(
                    sb,
                    dfmt("- `{s}`\n", {render_fn_signature(method)})
                )
                val method_doc_opt = @get(entry.method_docs, idx as usize)
                if method_doc_opt is some method_doc {
                    val method_doc_text: ref u8 = method_doc as ref u8
                    if !str.str_eql(method_doc_text, c"") {
                        string.StringBuilder.append_cstr(sb, c"\n")
                        append_md_indented(sb, method_doc_text, c"  ")
                    }
                }
                idx++
            }
        }
    } elif node.kind == parser.NK_TYPEDEF || node.kind == parser.NK_EXTERN_TYPE {
        val fields = node.d2 as list[ref parser.Node]
        if @len(fields) as i64 > 0 {
            string.StringBuilder.append_cstr(sb, c"\n**Fields**\n\n| Name | Type |\n| --- | --- |\n")
            for field in fields {
                val prefix: mut ref u8 = c""
                if field.d1 != 0 {
                    prefix = c"mut "
                }
                string.StringBuilder.append_cstr(
                    sb,
                    dfmt(
                        "| `{s}` | `{s}{s}` |\n",
                        {
                            parser.node_str_raw(field.d0),
                            prefix,
                            render_type(field.d2 as ref parser.Node)
                        }
                    )
                )
            }
        }
    } elif node.kind == parser.NK_ENUMDEF {
        string.StringBuilder.append_cstr(sb, c"\n**Variants**\n\n")
        for variant in node.d2 as list[ref u8] {
            string.StringBuilder.append_cstr(sb, dfmt("- `{s}`\n", {variant}))
        }
    } elif node.kind == parser.NK_UNIONDEF {
        string.StringBuilder.append_cstr(sb, c"\n**Variants**\n\n")
        for variant in node.d2 as list[ref parser.Node] {
            string.StringBuilder.append_cstr(sb, dfmt("- `{s}`\n", {render_type(variant)}))
        }
    } elif node.kind == parser.NK_TAGGED_UNIONDEF {
        string.StringBuilder.append_cstr(sb, c"\n**Variants**\n\n")
        for variant in node.d2 as list[ref parser.Node] {
            val types = render_type_list(variant.d1 as list[ref parser.Node], c", ")
            val text: mut ref u8 = parser.node_str_raw(variant.d0)
            if !str.str_eql(types, c"") {
                text = dfmt("{s}({s})", {text, types})
            } else {
                text = dfmt("{s}()", {text})
            }
            string.StringBuilder.append_cstr(sb, dfmt("- `{s}`\n", {text}))
        }
    }
}

fn render_module_page_md(module: ref DocModule, modules: list[ref DocModule]) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    string.StringBuilder.append_cstr(sb, dfmt("# {s}\n\n", {safe_cstr(module.module_name)}))
    string.StringBuilder.append_cstr(
        sb,
        dfmt("Source: `{s}`\n\n", {safe_cstr(module.rel_path)})
    )
    if @len(modules) as i64 > 1 {
        string.StringBuilder.append_cstr(sb, c"## Modules\n\n")
        for mod in modules {
            string.StringBuilder.append_cstr(
                sb,
                dfmt(
                    "- [{s}]({s})\n",
                    {safe_cstr(mod.module_name), href_from(module.output_path, mod.output_path)}
                )
            )
        }
        string.StringBuilder.append_cstr(sb, c"\n")
    }
    if @len(module.entries) as i64 > 0 {
        string.StringBuilder.append_cstr(sb, c"## On this page\n\n")
        for entry in module.entries {
            string.StringBuilder.append_cstr(
                sb,
                dfmt("- [{s}](#{s})\n", {entry.nav_name, entry.anchor})
            )
        }
        string.StringBuilder.append_cstr(sb, c"\n")
    }
    for entry in module.entries {
        string.StringBuilder.append_cstr(sb, c"## ")
        string.StringBuilder.append_cstr(sb, entry.name)
        string.StringBuilder.append_cstr(sb, c" {#")
        string.StringBuilder.append_cstr(sb, entry.anchor)
        string.StringBuilder.append_cstr(sb, c"}\n\n")
        if !str.str_eql(entry.availability, c"") {
            string.StringBuilder.append_cstr(
                sb,
                dfmt("Availability: `{s}`\n\n", {entry.availability})
            )
        }
        string.StringBuilder.append_cstr(sb, c"```spectre\n")
        string.StringBuilder.append_cstr(sb, entry.signature)
        string.StringBuilder.append_cstr(sb, c"\n```\n\n")
        if !str.str_eql(entry.docs, c"") {
            string.StringBuilder.append_cstr(sb, entry.docs)
            string.StringBuilder.append_cstr(sb, c"\n")
        }
        render_entry_details_md(sb, entry)
        string.StringBuilder.append_cstr(sb, c"\n")
    }
    if @len(module.entries) as i64 == 0 {
        string.StringBuilder.append_cstr(
            sb,
            c"No top-level documented functions, constants, or types were found in this module.\n"
        )
    }
    val out = build_cstr(sb)
    string.StringBuilder.free(sb)
    return out
}

fn make_overview_module(output_path: ref u8) ref DocModule = trust {
    val module: mut ref DocModule = doc_alloc(@sizeof(DocModule) as usize) as ref DocModule
    module.source_path = c""
    module.rel_path = c"__overview__"
    module.module_name = c"Docs"
    module.output_path = output_path
    module.is_root = false
    module.entries = mem.new[ref DocEntry]()
    return module
}

fn append_modules_overview_html(
    sb: ref void,
    modules: list[ref DocModule],
    current_output: ref u8
) void = trust {
    string.StringBuilder.append_cstr(
        sb,
        c"<section class=\"entry\"><div class=\"entry-header\"><h3>Modules</h3></div><ul class=\"module-list\">"
    )
    for mod in modules {
        string.StringBuilder.append_cstr(sb, dfmt("<li><a href=\"{s}\">{s}</a></li>", {
                    href_from(current_output, mod.output_path),
                    html_escape(safe_cstr(mod.module_name))
                }))
    }
    string.StringBuilder.append_cstr(sb, c"</ul></section>")
}

fn render_overview_page(
    markdown: bool,
    modules: list[ref DocModule],
    output_path: ref u8,
    source_dir: ref u8,
    readme: ref u8
) ref u8 = trust {
    val page_title = markdown_title(readme, c"Docs")
    if markdown {
        val sb = string.StringBuilder.new()
        if !str.str_eql(readme, c"") {
            string.StringBuilder.append_cstr(sb, readme)
            if !str.str_eql(substr(readme, str.len_raw(readme) - 1, 1), c"\n") {
                string.StringBuilder.append_cstr(sb, c"\n")
            }
            string.StringBuilder.append_cstr(sb, c"\n")
        } else {
            string.StringBuilder.append_cstr(sb, dfmt("# {s}\n\n", {page_title}))
            string.StringBuilder.append_cstr(sb, dfmt("Source: `{s}`\n\n", {source_dir}))
        }
        string.StringBuilder.append_cstr(sb, c"## Modules\n\n")
        for mod in modules {
            string.StringBuilder.append_cstr(
                sb,
                dfmt(
                    "- [{s}]({s})\n",
                    {mod.module_name, href_from(output_path, mod.output_path)}
                )
            )
        }
        val out = build_cstr(sb)
        string.StringBuilder.free(sb)
        return out
    }
    val sb2 = string.StringBuilder.new()
    val overview_module = make_overview_module(output_path)
    append_page_head_html(sb2, page_title)
    append_page_shell_start_html(sb2, modules, overview_module, false)
    string.StringBuilder.append_cstr(sb2, dfmt("<div class=\"hero\"><div class=\"hero-top\"><div><h1>{s}</h1><div class=\"hero-meta\"><span class=\"label\">source</span><code>{s}</code></div></div></div></div>", {
                html_escape(page_title),
                html_escape(source_dir)
            }))
    if !str.str_eql(readme, c"") {
        string.StringBuilder.append_cstr(
            sb2,
            c"<section class=\"entry\"><div class=\"doc-article\">"
        )
        append_markdown_html(sb2, readme)
        string.StringBuilder.append_cstr(sb2, c"</div></section>")
    } else {
        string.StringBuilder.append_cstr(
            sb2,
            c"<div class=\"empty\">No README.md or README found for this directory.</div>"
        )
    }
    append_modules_overview_html(sb2, modules, output_path)
    append_page_shell_end_html(sb2)
    val out = build_cstr(sb2)
    string.StringBuilder.free(sb2)
    return out
}

fn write_page(path: ref u8, content: ref u8) bool = trust {
    if !ensure_parent_dir(path) {
        return false
    }
    return fs.write_all_raw(path, content)
}

fn maybe_root_rel_for_dir() ref u8 = trust {
    val sxmod_opt = commands.load_sxmod()
    if sxmod_opt is some cfg {
        val entry: ref u8 = (cfg as ref commands.SxMod).entry
        if !str.str_eql(entry, c"") {
            return normalize_rel_path(entry)
        }
    }
    return c""
}

fn output_dir_for_target(target: ref u8, target_is_dir: bool) ref u8 = trust {
    if target_is_dir {
        val clean = trim_trailing_slash(target)
        val name = path_basename(clean)
        if !str.str_eql(name, c"") && !str.str_eql(name, c".") && !str.str_eql(name, c"..") {
            return dfmt("./docs-out-{s}", {name})
        }
    }
    return c"./docs-out"
}

pub fn cmd_doc(
    target: ref u8,
    markdown: bool,
    output_override: ref u8,
    read_override: ref u8
) i32 = trust {
    val parse_arena: allocators.ScopedArenaAllocator = allocators.ScopedArena.new(
        67108864 as usize
    )?
    val arena_state: mut ref DocArenaState = allocators.ScopedArena.alloc_or_none(
        parse_arena,
        @sizeof(DocArenaState) as usize
    ) as ref DocArenaState
    arena_state.arena = parse_arena
    doc_arena_state = arena_state
    defer {
        doc_arena_state = none
        allocators.ScopedArena.free(parse_arena)
    }
    if str.str_eql(target, c"") {
        stdio.puts("error: doc requires a file or directory target")
        return 1
    }
    val readme_override: mut ref u8 = c""
    if !str.str_eql(read_override, c"") {
        if !os.exists(read_override) {
            stdio.print("error: could not read '{s}'\n", {read_override})
            return 1
        }
        readme_override = read_text_file_or_empty(read_override)
    }
    val target_is_dir: bool = dir_exists(target)
    val out_dir: mut ref u8 = output_dir_for_target(target, target_is_dir)
    if !str.str_eql(output_override, c"") {
        out_dir = output_override
    }
    if !ensure_dir(out_dir) {
        stdio.print("error: could not create '{s}'\n", {out_dir})
        return 1
    }
    if target_is_dir {
        val clean_target = trim_trailing_slash(target)
        val files: mut list[ref u8] = mem.new[ref u8]()
        collect_sx_files(clean_target, c"", files)
        if @len(files) as i64 == 0 {
            stdio.print("error: no .sx files found in '{s}'\n", {target})
            return 1
        }
        val modules: mut list[ref DocModule] = mem.new[ref DocModule]()
        for rel in files {
            val source_path: mut ref u8 = rel
            val source_owned: mut bool = false
            if !str.str_eql(clean_target, c".") && !str.str_eql(clean_target, c"") {
                source_path = path.join_raw(clean_target, rel)
                source_owned = true
            } else {
                source_path = dfmt("./{s}", {rel})
            }
            @append(modules, load_module(parse_arena, source_path, rel))
            if source_owned {
                @free(source_path)
            }
        }

        val root_rel = maybe_root_rel_for_dir()
        val root_idx = find_root_module(modules, root_rel)
        assign_output_paths(modules, markdown, root_idx)
        val index_rel: mut ref u8 = c"index.html"
        if markdown {
            index_rel = c"index.md"
        }
        val index_path: mut ref u8 = path.join_raw(out_dir, index_rel)
        val readme: mut ref u8 = load_directory_readme(clean_target)
        if !str.str_eql(readme_override, c"") {
            readme = readme_override
        }
        val overview = render_overview_page(markdown, modules, index_rel, clean_target, readme)
        if !write_page(index_path, overview) {
            stdio.print("error: could not write '{s}'\n", {index_path})
            @free(index_path)
            return 1
        }
        @free(index_path)

        for mod in modules {
            val full_path: mut ref u8 = path.join_raw(out_dir, mod.output_path)
            val content: mut ref u8 = c""
            if markdown {
                content = render_module_page_md(mod, modules)
            } else {
                content = render_module_page_html(mod, modules)
            }
            if !write_page(full_path, content) {
                stdio.print("error: could not write '{s}'\n", {full_path})
                @free(full_path)
                return 1
            }
            @free(full_path)
        }
        stdio.print("wrote docs to {s}\n", {out_dir})
        return 0
    }

    if !os.exists(target) {
        stdio.print("error: could not read '{s}'\n", {target})
        return 1
    }
    if !str.raw_ends_with(target, c".sx") {
        stdio.puts("error: doc expects a .sx file or a directory")
        return 1
    }
    if !str.str_eql(read_override, c"") {
        stdio.puts("error: -read requires a directory target")
        return 1
    }
    val rel_path = normalize_rel_path(path_basename(target))
    val module: mut ref DocModule = load_module(parse_arena, target, rel_path)
    module.is_root = true
    if markdown {
        module.output_path = c"index.md"
    } else {
        module.output_path = c"index.html"
    }
    val modules: mut list[ref DocModule] = mem.new[ref DocModule]()
    @append(modules, module)
    val content: mut ref u8 = c""
    if markdown {
        content = render_module_page_md(module, modules)
    } else {
        content = render_module_page_html(module, modules)
    }
    val out_path: mut ref u8 = path.join_raw(out_dir, module.output_path)
    if !write_page(out_path, content) {
        stdio.print("error: could not write '{s}'\n", {out_path})
        @free(out_path)
        return 1
    }
    @free(out_path)
    stdio.print("wrote docs to {s}\n", {out_dir})
    return 0
}

test "docs extracts comments, signatures and slugs" {
    val test_arena: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(
        1048576 as usize
    )?
    val test_state: mut ref DocArenaState = allocators.ScopedArena.alloc_or_none(
        test_arena,
        @sizeof(DocArenaState) as usize
    ) as ref DocArenaState
    test_state.arena = test_arena
    doc_arena_state = test_state
    defer {
        doc_arena_state = none
        trust allocators.ScopedArena.free(test_arena)
    }
    assert str.str_eql(trust substr(c"hello", -5, 2), c"he")
    assert str.str_eql(trust substr(c"hello", 10, 3), c"")
    assert str.str_eql(trust substr(c"hello", 1, 99), c"ello")

    val docs = trust extract_doc_map(
        \\/// hello
        \\/// world
        \\fn greet() void = {}
        \\type Point = { x: i64 }
    )

    assert str.str_eql(trust lookup_doc(docs, 3), c"hello\nworld")
    assert str.str_eql(trust lookup_doc(docs, 4), c"")

    val docs_no_trailing_nl = trust extract_doc_map(
        \\/// tail docs
        \\fn tail() void = {}
    )

    assert str.str_eql(trust lookup_doc(docs_no_trailing_nl, 2), c"tail docs")

    val gapped_docs = trust extract_doc_map(
        \\/// detached header
        \\
        \\/// getenv docs
        \\extern (C) fn getenv(name: ref u8) ref u8 = "getenv"
    )
    assert str.str_eql(trust lookup_doc(gapped_docs, 4), c"getenv docs")

    val header_only_docs = trust extract_doc_map(
        \\/// detached header
        \\
        \\pub fn get(name: ref u8) ref u8 = {}
    )
    assert str.str_eql(trust lookup_doc(header_only_docs, 3), c"")

    val doc_html_sb = string.StringBuilder.new()
    trust append_doc_html(doc_html_sb, c"Return when x is `none`")
    val doc_html_built = trust string.StringBuilder.build(doc_html_sb)
    val doc_html = trust string.cstr(doc_html_built)
    trust string.StringBuilder.free(doc_html_sb)
    assert str.raw_cmp(
        doc_html,
        c"<div class=\"docs\"><p>Return when x is <code>none</code></p></div>"
    ) == 0
    trust @free(string.cstr(doc_html_built) as ref void)
    val doc_html_hdr: mut ref void = doc_html_built as ref void
    trust @free(doc_html_hdr)

    val md_html_sb = string.StringBuilder.new()
    trust append_markdown_html(md_html_sb, c"first\n\nsecond\n\n- a\n- b\n")
    val md_html_built = trust string.StringBuilder.build(md_html_sb)
    val md_html = trust string.cstr(md_html_built)
    trust string.StringBuilder.free(md_html_sb)
    assert str.raw_cmp(
        md_html,
        c"<p>first</p><p>second</p><ul><li>a</li><li>b</li></ul>"
    ) == 0
    trust @free(string.cstr(md_html_built) as ref void)
    val md_html_hdr: mut ref void = md_html_built as ref void
    trust @free(md_html_hdr)

    assert str.str_eql(trust slugify(c"Hello.World"), c"hello-world")
    assert str.str_eql(trust strip_sx_ext(c"src/meta/docs.sx"), c"src/meta/docs")

    val const_src = trust extract_doc_map(
        \\/// constant docs
        \\pub val some_constant = 100
    )
    assert str.str_eql(trust lookup_doc(const_src, 2), c"constant docs")

    assert trust is_doc_target_line(c"spec Allocator = {")
    assert trust is_doc_target_line(c"pub spec Allocator = {")
    assert trust is_doc_target_line(c"val (")
    assert trust is_doc_target_line(c"pub val (")

    val spec_src = trust extract_doc_map(
        \\/// allocator interface
        \\pub spec Allocator = {
        \\    pub fn new(capacity: usize) result[Allocator, AllocError]
        \\}
    )
    assert str.str_eql(trust lookup_doc(spec_src, 2), c"allocator interface")

    val docs_src_arena: allocators.Arena = trust allocators.Arena.new(131072 as usize)?
    val docs_src_opt = trust fs.read_all_raw[allocators.Arena](docs_src_arena, c"./src/meta/docs.sx")
    if docs_src_opt is some docs_src {
        val ml_toggle: mut i64 = 0
        match regex.re_match(c"id=\\\\\"private-toggle\\\\\"", docs_src, @addr(ml_toggle)) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }

        val ml_home: mut i64 = 0
        match regex.re_match(c"id=\\\\\"home-btn\\\\\"", docs_src, @addr(ml_home)) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }

        val ml_private: mut i64 = 0
        match regex.re_match(c"data-private=\\\\\"\\{s\\}\\\\\"", docs_src, @addr(ml_private)) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }

        val ml_label: mut i64 = 0
        match regex.re_match(
            c"aria-label=\\\\\"Show private functions\\\\\"",
            docs_src,
            @addr(ml_label)
        ) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }

        val ml_const_kind: mut i64 = 0
        match regex.re_match(
            c"item\\.kind == parser\\.NK_CONST && node_is_public\\(item\\)",
            docs_src,
            @addr(ml_const_kind)
        ) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }

        val ml_const_sig: mut i64 = 0
        match regex.re_match(
            c"return dfmt\\(\"\\{s\\}val \\{s\\} = \\{s\\}\"",
            docs_src,
            @addr(ml_const_sig)
        ) {
            ok found => {
                if found is some _ {
                } else {
                    assert false
                }
            }
            err _ => {
                assert false
            }
        }
    } else {
        assert false
    }
    trust allocators.Arena.free(docs_src_arena)

    val fn_src = c"fn add(a: i64, b: i64) i64 = trust { return a + b }"
    val ml: mut i64 = 0

    match regex.re_match(c"^fn [^=]+", fn_src, @addr(ml)) {
        ok found => {
            if found is some pos {
                val sig = trust trim_ws(substr(fn_src, pos, ml))
                assert str.str_eql(sig, c"fn add(a: i64, b: i64) i64")
            } else {
                assert false
            }
        }
        err _ => {
            assert false
        }
    }
    val type_src = c"type Point = { x: i64, y: i64 }"
    val ml2: mut i64 = 0
    match regex.re_match(c"^type [A-Za-z_]+", type_src, @addr(ml2)) {
        ok found => {
            if found is some pos {
                assert str.str_eql(trust trim_ws(substr(type_src, pos, ml2)), c"type Point")
            } else {
                assert false
            }
        }
        err _ => {
            assert false
        }
    }
}
