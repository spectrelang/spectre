        \\var inp=document.getElementById('search');
        \\var privateBtn=document.getElementById('private-toggle');
        \\var privateIcon=document.getElementById('private-toggle-icon');
        \\var showPrivate=localStorage.getItem('docs-show-private')==='1';
        \\function syncPrivateToggle(){
        \\  if(!privateBtn)return;
        \\  privateBtn.setAttribute('aria-pressed',showPrivate?'true':'false');
        \\  privateBtn.setAttribute('aria-label',showPrivate?'Hide private functions':'Show private functions');
        \\  privateBtn.setAttribute('title',showPrivate?'Hide private functions':'Show private functions');
        \\  if(privateIcon){
        \\    privateIcon.innerHTML=showPrivate
        \\      ?'<path d="M3 3l18 18"/><path d="M10.58 10.58A3 3 0 0 0 12 15a3 3 0 0 0 2.42-4.42"/><path d="M9.88 5.09A10.94 10.94 0 0 1 12 5c6.5 0 10 7 10 7a17.56 17.56 0 0 1-4.04 4.94"/><path d="M6.61 6.61C4.62 8.06 3 12 3 12a17.32 17.32 0 0 0 5.39 5.39"/>'
        \\      :'<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="3"/>';
        \\  }
        \\}
        \\function updateEntryVisibility(){
        \\  var q=inp.value.toLowerCase().trim();
        \\  var links=sb.querySelectorAll('.nav-item[data-name]');
        \\  for(var i=0;i<links.length;i++){
