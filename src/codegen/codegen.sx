    \\static long long sx_leak_records_cap = 0;
    \\static long long sx_leak_live_allocations = 0;
    \\static long long sx_leak_live_bytes = 0;
    \\static long long sx_leak_total_allocations = 0;
    \\static long long sx_leak_total_frees = 0;
    \\static long long sx_leak_peak_live_bytes = 0;
    \\static long long sx_leak_invalid_frees = 0;
    \\static void sx_leak_unlink(sx_leak_block* b) {
    \\    if (b->prev) b->prev->next = b->next;
    \\    if (b->next) b->next->prev = b->prev;
    \\    if (sx_leak_head == b) sx_leak_head = b->next;
    \\}
    \\void* __sx_leak_alloc(unsigned long long size, const char* file, long long line) {
    \\    if (size == 0) size = 1;
    \\    sx_leak_block* b = (sx_leak_block*)malloc(sizeof(sx_leak_block) + (size_t)size);
    \\    if (!b) return 0;
    \\    b->prev = 0;
    \\    b->next = sx_leak_head;
    \\    if (sx_leak_head) sx_leak_head->prev = b;
    \\    sx_leak_head = b;
    \\    b->size = size;
    \\    b->magic = SX_LEAK_MAGIC;
    \\    b->file = file;
    \\    b->line = line;
    \\    sx_leak_live_allocations++;
    \\    sx_leak_live_bytes += (long long)size;
    \\    sx_leak_total_allocations++;
