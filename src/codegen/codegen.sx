    \\    }
    \\    sx_leak_block* b = ((sx_leak_block*)ptr) - 1;
    \\    if (b->magic != SX_LEAK_MAGIC) {
    \\        sx_leak_invalid_frees++;
    \\        return 0;
    \\    }
    \\    unsigned long long old_size = b->size;
    \\    void* next = __sx_leak_alloc(size, file, line);
    \\    if (!next) return 0;
