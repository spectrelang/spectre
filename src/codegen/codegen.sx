    \\        sx_leak_records[index].size = b->size;
    \\        sx_leak_records[index].line = b->line;
    \\        sx_leak_records[index].file = b->file;
    \\        index++;
    \\        b = b->next;
    \\    }
    \\    return index;
    \\}
    \\void __sx_leak_fill(long long* out) {
    \\    if (!out) return;
    \\    long long record_count = sx_leak_collect_records();
    \\    out[0] = 1;
    \\    out[1] = sx_leak_live_allocations;
    \\    out[2] = sx_leak_live_bytes;
    \\    out[3] = sx_leak_total_allocations;
    \\    out[4] = sx_leak_total_frees;
    \\    out[5] = sx_leak_peak_live_bytes;
    \\    out[6] = sx_leak_invalid_frees;
    \\    out[7] = (long long)(intptr_t)sx_leak_records;
    \\    out[8] = record_count;
    \\}
    \\
}

/// Build the C translation unit that exposes C header constants to QBE.
fn cg_build_c_shim(ctx: ref CgCtx) ref u8 = trust {
    val n_consts: i64 = @len(ctx.c_consts) as i64
    val n_adapters: i64 = @len(ctx.alloc_adapter_lines as list[ref u8]) as i64
    if n_consts == 0 && !ctx.alloc_runtime && n_adapters == 0 && !ctx.leak_check {
        return c""
    }

    val sb: ref void = str.StringBuilder.new()
    if ctx.leak_check {
        str.StringBuilder.append(sb, leak_runtime_c_source())
    }
    if ctx.alloc_runtime {
        str.StringBuilder.append(sb, cg_alloc_runtime_c_source())
    }
    val ai: mut i64 = 0
    for {
        if ai >= n_adapters {
            break
        }
        val a_opt = @get(ctx.alloc_adapter_lines as list[ref u8], ai as usize)
        if a_opt is some a {
            str.StringBuilder.append_cstr(sb, a as ref u8)
        }
        ai++
    }
    for header in ctx.c_headers {
        val inc: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (str.len_raw(header) + 16) as usize
        ) as ref u8
        @snprintf(inc, str.len_raw(header) + 16, "#include \"{s}\"\n", {header})
        str.StringBuilder.append_cstr(sb, inc)
    }
    if (@len(ctx.c_headers) as i64) > 0 {
        str.StringBuilder.append_cstr(sb, c"\n")
    }

    val i: mut i64 = 0
    for {
        if i >= n_consts {
            break
        }
        val raw_opt = @get(ctx.c_consts, i as usize)
        val sym_opt = @get(ctx.c_const_syms, i as usize)
        if raw_opt is some rv {
            if sym_opt is some sv {
                val raw: ref u8 = rv as ref u8
                val sym: ref u8 = sv as ref u8
                val def: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (str.len_raw(raw) + str.len_raw(sym) + 48) as usize
                ) as ref u8
                @snprintf(
                    def,
                    str.len_raw(raw) + str.len_raw(sym) + 48,
                    "long long {s} = (long long)({s});\n",
                    {sym, raw}
                )
                str.StringBuilder.append_cstr(sb, def)
            }
        }
        i++
    }

    val built: ref void = str.StringBuilder.build(sb)
    val out: ref u8 = str.cstr(built)
    str.StringBuilder.free(sb)
    @free(built)
    return out
}

fn cg_is_int_const_val(cval: ref u8) bool = trust {
    if cval == none || str.raw_cmp(cval, c"") == 0 {
        return false
    }
    if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") {
        return false
    }
    return true
}

fn cg_fixed_arr_size_text(ctx: ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none || ty.kind != parser.TY_FIXED_ARR {
        return c"0"
    }
    val sz_name: ref u8 = parser.fixed_arr_size_name_raw(ty)
    if sz_name != none && str.raw_cmp(sz_name, c"") != 0 {
        return sz_name
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(buf, 64, "{lld}", {parser.fixed_arr_size(ty)})
    return buf
}

fn cg_fixed_arr_size_val(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    if ty == none || ty.kind != parser.TY_FIXED_ARR {
        return 0
    }
    val sz_name: ref u8 = parser.fixed_arr_size_name_raw(ty)
    if sz_name == none || str.raw_cmp(sz_name, c"") == 0 {
        return parser.fixed_arr_size(ty)
    }
    val exact: ref u8 = cg_const_val(ctx, sz_name)
    val ctext: mut ref u8 = exact
    if str.raw_cmp(ctext, c"") == 0 {
        val slen: i64 = str.len_raw(sz_name)
        val mapped: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (slen * 2 + 1) as usize
        ) as ref u8
        val si: mut i64 = 0
        val mi: mut i64 = 0
        for {
            if si >= slen {
                break
            }
            val ch: u8 = @load8(@ptradd(sz_name, si))
            if ch == 46 {
                @store8(@ptradd(mapped, mi), 95)
                @store8(@ptradd(mapped, mi + 1), 95)
                mi += 2
            } else {
                @store8(@ptradd(mapped, mi), ch)
                mi++
            }
            si++
        }
        @store8(@ptradd(mapped, mi), 0)
        ctext = cg_const_val(ctx, mapped)
    }
    if str.raw_cmp(ctext, c"") == 0 {
        return 0
    }
    val parsed = fmt.string_to_i64(ctext)
    match parsed {
        ok v => {
            return v
        }
        err _ => {
            return 0
        }
    }
}

fn cg_type_size(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 8
    }
    val k: i64 = ty.kind
    if k == parser.TY_FIXED_ARR {
        val count: i64 = cg_fixed_arr_size_val(ctx, ty)
        val elem_size: i64 = cg_type_size(ctx, parser.fixed_arr_inner(ty))
        return count * elem_size
    }
    if k == parser.TY_MUT {
        return cg_type_size(ctx, ty.d0 as ref parser.Node)
    }
    return type_size(ty)
}

fn ann_fixed_arr_close_index(ann: ref u8) i64 = trust {
    val len: i64 = str.len_raw(ann)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(ann, i))
        if c == 93 {
            return i
        }
        i++
    }
    return -1
}

fn ann_fixed_arr_len_text(ann: ref u8) ref u8 = trust {
    val close_i: i64 = ann_fixed_arr_close_index(ann)
    if close_i <= 1 {
        return c""
    }
    return str.substr(ann, 1, close_i - 1)
}

fn ann_fixed_arr_inner(ann: ref u8) ref u8 = trust {
    val close_i: i64 = ann_fixed_arr_close_index(ann)
    val len: i64 = str.len_raw(ann)
    if close_i < 0 || close_i + 1 >= len {
        return c""
    }
    return str.substr(ann, close_i + 1, len - close_i - 1)
}

fn cg_ann_fixed_arr_len_val(ctx: mut ref CgCtx, ann: ref u8) i64 = trust {
    val ltxt: ref u8 = ann_fixed_arr_len_text(ann)
    if str.raw_cmp(ltxt, c"") == 0 {
        return 0
    }
    val parsed = fmt.string_to_i64(ltxt)
    match parsed {
        ok v => {
            return v
        }
        err _ => {
            val ctext: ref u8 = cg_const_val(ctx, ltxt)
            if str.raw_cmp(ctext, c"") == 0 {
                return 0
            }
            val parsed2 = fmt.string_to_i64(ctext)
            match parsed2 {
                ok v2 => {
                    return v2
                }
                err _ => {
                    return 0
                }
            }
        }
    }
}

fn cg_ann_size(ctx: mut ref CgCtx, ann: ref u8) i64 = trust {
    if str.raw_cmp(ann, c"") == 0 {
        return 8
    }
    if raw_starts_with(ann, c"[") {
        val count: i64 = cg_ann_fixed_arr_len_val(ctx, ann)
        val inner: ref u8 = ann_fixed_arr_inner(ann)
        return count * cg_ann_size(ctx, inner)
    }
    if str.raw_cmp(
        ann,
        c"i8"
    ) == 0 || str.raw_cmp(
        ann,
        c"u8"
    ) == 0 || str.raw_cmp(ann, c"bool") == 0 || str.raw_cmp(ann, c"u8") == 0 {
        return 1
    }
    if str.raw_cmp(ann, c"i16") == 0 || str.raw_cmp(ann, c"u16") == 0 {
        return 2
    }
    if str.raw_cmp(
        ann,
        c"i32"
    ) == 0 || str.raw_cmp(ann, c"u32") == 0 || str.raw_cmp(ann, c"f32") == 0 {
        return 4
    }
    if str.raw_cmp(ann, c"void") == 0 {
        return 0
    }
    return 8
}

fn cg_ann_store_instr(ctx: mut ref CgCtx, ann: ref u8) ref u8 = trust {
    if str.raw_cmp(ann, c"f64") == 0 {
        return c"stored"
    }
    if str.raw_cmp(ann, c"f32") == 0 {
        return c"stores"
    }
    val sz: i64 = cg_ann_size(ctx, ann)
    if sz <= 1 {
        return c"storeb"
    }
    if sz == 2 {
        return c"storeh"
    }
    if sz == 4 {
        return c"storew"
    }
    return c"storel"
}

fn cg_ann_load_instr(ann: ref u8) ref u8 = trust {
    if str.raw_cmp(ann, c"f64") == 0 {
        return c"loadd"
    }
    if str.raw_cmp(ann, c"f32") == 0 {
        return c"loads"
    }
    if str.raw_cmp(ann, c"i32") == 0 {
        return c"loadsw"
    }
    if str.raw_cmp(ann, c"u32") == 0 {
        return c"loaduw"
    }
    if str.raw_cmp(ann, c"i16") == 0 {
        return c"loadsh"
    }
    if str.raw_cmp(ann, c"u16") == 0 {
        return c"loaduh"
    }
    if str.raw_cmp(ann, c"i8") == 0 {
        return c"loadsb"
    }
    if str.raw_cmp(ann, c"u8") == 0 || str.raw_cmp(ann, c"bool") == 0 || str.raw_cmp(ann, c"u8") == 0 {
        return c"loadub"
    }
    return c"loadl"
}

fn cg_ann_qtype(ann: ref u8) ref u8 = trust {
    if str.raw_cmp(ann, c"f64") == 0 {
        return c"d"
    }
    if str.raw_cmp(ann, c"f32") == 0 {
        return c"s"
    }
    if str.raw_cmp(
        ann,
        c"i32"
    ) == 0 || str.raw_cmp(
        ann,
        c"u32"
    ) == 0 || str.raw_cmp(
        ann,
        c"i16"
    ) == 0 || str.raw_cmp(
        ann,
        c"u16"
    ) == 0 || str.raw_cmp(
        ann,
        c"i8"
    ) == 0 || str.raw_cmp(
        ann,
        c"u8"
    ) == 0 || str.raw_cmp(ann, c"bool") == 0 || str.raw_cmp(ann, c"u8") == 0 {
        return c"w"
    }
    return c"l"
}

fn cg_ann_word_extend_instr(ann: ref u8) ref u8 = trust {
    if str.raw_cmp(
        ann,
        c"u32"
    ) == 0 || str.raw_cmp(
        ann,
        c"u16"
    ) == 0 || str.raw_cmp(
        ann,
        c"u8"
    ) == 0 || str.raw_cmp(ann, c"bool") == 0 || str.raw_cmp(ann, c"u8") == 0 {
        return c"extuw"
    }
    return c"extsw"
}

fn cg_normalize_qtype(qtype: ref u8) ref u8 = trust {
    if qtype == none {
        return c""
    }
    val qv: i64 = parser.ptr_to_i64[ref u8](qtype)
    if qv == 119 {
        return c"w"
    }
    if qv == 108 {
        return c"l"
    }
    if qv == 115 {
        return c"s"
    }
    if qv == 100 {
        return c"d"
    }
    if qv == 97 {
        return c"a"
    }
    return qtype
}

fn cg_coerce_qtype(
    ctx: mut ref CgCtx,
    value: ref u8,
    src_qtype: ref u8,
    dst_qtype: ref u8
) ref u8 = trust {
    val src_qtype_n: ref u8 = cg_normalize_qtype(src_qtype)
    val dst_qtype_n: ref u8 = cg_normalize_qtype(dst_qtype)
    if str.raw_cmp(src_qtype_n, dst_qtype_n) == 0 {
        return value
    }
    if str.raw_cmp(src_qtype_n, c"w") == 0 && str.raw_cmp(dst_qtype_n, c"l") == 0 {
        val conv_tmp: i64 = fresh_tmp(ctx)
        val conv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(conv_buf, 64, "    %%t{lld} =l extsw {s}\n", {conv_tmp, value})
        emit(
            ctx,
            conv_buf
        )
        val conv_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(conv_res, 32, "%%t{lld}", {conv_tmp})
        return conv_res
    }
    if str.raw_cmp(src_qtype_n, c"l") == 0 && str.raw_cmp(dst_qtype_n, c"w") == 0 {
        val conv_tmp: i64 = fresh_tmp(ctx)
        val conv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(conv_buf, 64, "    %%t{lld} =w copy {s}\n", {conv_tmp, value})
        emit(
            ctx,
            conv_buf
        )
        val conv_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(conv_res, 32, "%%t{lld}", {conv_tmp})
        return conv_res
    }
    if str.raw_cmp(src_qtype_n, c"s") == 0 && str.raw_cmp(dst_qtype_n, c"d") == 0 {
        val conv_tmp: i64 = fresh_tmp(ctx)
        val conv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(conv_buf, 64, "    %%t{lld} =d exts {s}\n", {conv_tmp, value})
        emit(
            ctx,
            conv_buf
        )
        val conv_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(conv_res, 32, "%%t{lld}", {conv_tmp})
        return conv_res
    }
    if str.raw_cmp(src_qtype_n, c"d") == 0 && str.raw_cmp(dst_qtype_n, c"s") == 0 {
        val conv_tmp: i64 = fresh_tmp(ctx)
        val conv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(conv_buf, 64, "    %%t{lld} =s truncd {s}\n", {conv_tmp, value})
        emit(
            ctx,
            conv_buf
        )
        val conv_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(conv_res, 32, "%%t{lld}", {conv_tmp})
        return conv_res
    }
    return value
}

/// Truncate an integer value to the declared sub-word type (u8/i8/u16/i16)
/// or to 32 bits for word-sized integer types.
fn cg_narrow_int_for_ann(ctx: mut ref CgCtx, value: ref u8, ann: ref u8) ref u8 = trust {
    if ann == none || str.raw_cmp(ann, c"") == 0 {
        return value
    }

    val is_u8: bool = str.raw_cmp(ann, c"u8") == 0 || str.raw_cmp(ann, c"bool") == 0
    val is_i8: bool = str.raw_cmp(ann, c"i8") == 0
    val is_u16: bool = str.raw_cmp(ann, c"u16") == 0
    val is_i16: bool = str.raw_cmp(ann, c"i16") == 0
    val is_u32: bool = str.raw_cmp(ann, c"u32") == 0
    val is_i32: bool = str.raw_cmp(ann, c"i32") == 0
    if !is_u8 && !is_i8 && !is_u16 && !is_i16 && !is_u32 && !is_i32 {
        return value
    }

    val w_tmp: i64 = fresh_tmp(ctx)
    val w_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(w_buf, 64, "    %%t{lld} =w copy {s}\n", {w_tmp, value})
    emit(ctx, w_buf)
    val out_tmp: mut i64 = w_tmp
    if is_u8 || is_i8 || is_u16 || is_i16 {
        out_tmp = fresh_tmp(ctx)
        val op: mut ref u8 = c"extub"
        if is_i8 {
            op = c"extsb"
        } elif is_u16 {
            op = c"extuh"
        } elif is_i16 {
            op = c"extsh"
        }
        val narrow_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(narrow_buf, 64, "    %%t{lld} =w {s} %%t{lld}\n", {out_tmp, op, w_tmp})
        emit(ctx, narrow_buf)
    }

    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {out_tmp})
    return res
}

fn cg_ann_after_get_indices(ann: ref u8, dims: i64) ref u8 = trust {
    val cur: mut ref u8 = ann
    val di: mut i64 = 0
    for {
        if di >= dims {
            break
        }
        if !raw_starts_with(cur, c"[") {
            return c""
        }
        cur = ann_fixed_arr_inner(cur)
        di++
    }
    return cur
}

/// Returns true if name is a registered function.
fn cg_is_fn(ctx: mut ref CgCtx, name: ref u8) bool = trust {
    return collections.RawIndexMap.contains(ctx.fn_name_index, name)
}

/// Returns the mangled function name for a bare name, or 0 if not found.
///
/// Tries exact match first, then the current module's prefix, then suffix
/// match (e.g. "hash_string" -> "collections__hash_string"). The function
/// index makes all three lookups O(1) instead of scanning every function.
fn cg_resolve_fn_name(ctx: mut ref CgCtx, name: ref u8) ref u8 = trust {
    if name == none {
        return none
    }

    if collections.RawIndexMap.contains(ctx.fn_name_index, name) {
        cg_mark_prefix_used(ctx, c"")
        return name
    }

    val prefix: ref u8 = ctx.current_module_prefix
    if str.raw_cmp(prefix, c"") != 0 {
        val namelen: i64 = str.len_raw(name)
        val prefix_len: i64 = str.len_raw(prefix)
        val is_sc: bool = is_std_child_name(prefix)
        val cur_name: mut ref u8 = none
        if is_sc {
            val cap: i64 = prefix_len + namelen + 8
            cur_name = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                cap as usize
            ) as ref u8
            @snprintf(cur_name, cap, "std__{s}__{s}", {prefix, name})
        } else {
            val cap: i64 = prefix_len + namelen + 3
            cur_name = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                cap as usize
            ) as ref u8
            @snprintf(cur_name, cap, "{s}__{s}", {prefix, name})
        }
        if collections.RawIndexMap.contains(ctx.fn_name_index, cur_name) {
            cg_mark_prefix_used(ctx, prefix)
            return cur_name
        }
    }

    match collections.RawIndexMap.get(ctx.fn_suffix_index, name) {
        some raw_index => {
            val index: usize = raw_index as usize
            val found_opt = @get(ctx.fn_names, index)
            val found: mut ref u8 = none
            if found_opt is some value {
                found = value as ref u8
            } else {
                return none
            }
            val found_prefix: ref u8 = extract_prefix_from_mangled(ctx.arena, found, name)
            val plen: i64 = str.len_raw(found_prefix)
            val pi: mut i64 = 0
            for {
                if pi >= plen {
                    break
                }
                val c1: u8 = @load8(@ptradd(found_prefix, pi))
                if pi + 1 < plen {
                    val c2: u8 = @load8(@ptradd(found_prefix, pi + 1))
                    if c1 == 95 && c2 == 95 {
                        val sub_prefix: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (pi + 1) as usize
                        ) as ref u8
                        @memcpy(sub_prefix, found_prefix, pi as usize)
                        @store8(@ptradd(sub_prefix, pi), 0)
                        cg_mark_prefix_used(ctx, sub_prefix)
                        pi++
                    }
                }
                pi++
            }
            cg_mark_prefix_used(ctx, found_prefix)
            return found
        }
        none => {
            return none
        }
    }
}

/// Index a mangled name by itself and by every suffix after a `__` boundary.
fn cg_index_fn_name(ctx: mut ref CgCtx, mangled: ref u8, index: usize) void = trust {
    collections.RawIndexMap.set(ctx.fn_name_index, mangled, index)
    val n: i64 = str.len_raw(mangled)
    val i: mut i64 = 0
    for {
        if i + 1 >= n {
            break
        }
        if @load8(@ptradd(mangled, i)) == 95 && @load8(@ptradd(mangled, i + 1)) == 95 {
            val suffix: ref u8 = @ptradd(mangled, i + 2) as ref u8
            collections.RawIndexMap.set(ctx.fn_suffix_index, suffix, index)
        }
        i++
    }
}

/// Register a function's mangled name and its param list for call-site type checking.
fn cg_register_fn(
    ctx: mut ref CgCtx,
    node: ref parser.Node,
    mangled: ref u8,
    params: ref void,
    ret_ty: ref void
) void = trust {
    @append(ctx.fn_nodes as list[ref void], node)
    @append(ctx.fn_names, mangled)
    @append(ctx.fn_params as list[ref void], params)
    @append(ctx.fn_rets as list[ref void], ret_ty)
    val index: usize = (@len(ctx.fn_names) as usize) - 1
    cg_index_fn_name(ctx, mangled, index)
}

fn cg_lookup_fn_name_by_node(ctx: ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return none
    }
    if node.kind == parser.NK_EXTERN_FN {
        return parser.node_str_raw(node.d2)
    }
    val nlen: i64 = @len(ctx.fn_nodes as list[ref void]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val nd_opt = @get(ctx.fn_nodes as list[ref void], ni as usize)
        if nd_opt is some nd {
            if nd as ref parser.Node == node {
                val n_opt = @get(ctx.fn_names, ni as usize)
                if n_opt is some n {
                    return n as ref u8
                } else {
                    return none
                }
            }
        }
        ni++
    }
    return none
}

/// Look up param list for a mangled function name. Returns 0 if not found.
fn cg_lookup_fn_params(ctx: mut ref CgCtx, mangled: ref u8) ref void = trust {
    match collections.RawIndexMap.get(ctx.fn_name_index, mangled) {
        some raw_index => {
            val index: usize = raw_index as usize
            val p_opt = @get(cg_fn_params(ctx) as list[ref void], index)
            if p_opt is some p {
                return p as ref void
            }
            return none
        }
        none => {
            return none
        }
    }
}

/// Find a mangled function name whose suffix matches the given bare name.
/// E.g. bare name "kind_is_eq" matches mangled "parser__kind_is_eq".
/// Returns the mangled name, or empty string if not found.
fn resolve_fn_mangled(ctx: mut ref CgCtx, bare_name: ref u8) ref u8 = trust {
    val names: ref void = cg_fn_names(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            val mangled: ref u8 = n as ref u8
            val mlen: i64 = str.len_raw(mangled)
            val blen: i64 = str.len_raw(bare_name)
            if mlen > blen {
                val suffix_pos: i64 = mlen - blen
                if suffix_pos > 0 {
                    val sc: u8 = @load8(@ptradd(mangled, suffix_pos - 1))
                    if sc == 95 {
                        val rest: ref u8 = @ptradd(mangled, suffix_pos) as ref u8
                        if str.raw_cmp(rest, bare_name) == 0 {
                            return mangled
                        }
                    }
                }
            } elif mlen == blen {
                if str.raw_cmp(mangled, bare_name) == 0 {
                    return mangled
                }
            }
        }
        ni++
    }
    return c""
}

/// Look up the return type for a mangled function name. Returns 0 if not found.
fn cg_lookup_fn_ret(ctx: mut ref CgCtx, mangled: ref u8) ref void = trust {
    match collections.RawIndexMap.get(ctx.fn_name_index, mangled) {
        some raw_index => {
            val index: usize = raw_index as usize
            val r_opt = @get(cg_fn_rets(ctx) as list[ref void], index)
            if r_opt is some r {
                return r as ref void
            }
            return none
        }
        none => {
            return none
        }
    }
}

/// Look up the return TypeExpr for a function by its simple (unmangled) name.
/// Uses suffix matching (same as cg_resolve_fn_name).
/// Returns none if not found.
fn cg_lookup_fn_ret_type_expr(ctx: mut ref CgCtx, name: ref u8) ref parser.Node = trust {
    val names: ref void = cg_fn_names(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val namelen: i64 = str.len_raw(name)
    val suffix: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (namelen + 3) as usize
    ) as ref u8
    @snprintf(suffix, namelen + 3, "__{s}", {name})
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            if str.raw_cmp(candidate, name) == 0 {
                val r_opt = @get(cg_fn_rets(ctx) as list[ref void], ni as usize)
                if r_opt is some r {
                    return r as ref parser.Node
                }
            }
            val clen: i64 = str.len_raw(candidate)
            val slen: i64 = namelen + 2
            if clen > slen {
                val tail: ref u8 = @ptradd(candidate, clen - slen) as ref u8
                if str.raw_cmp(tail, suffix) == 0 {
                    val r_opt = @get(cg_fn_rets(ctx) as list[ref void], ni as usize)
                    if r_opt is some r {
                        return r as ref parser.Node
                    }
                }
            }
        }
        ni++
    }
    return none
}

fn cg_infer_call_ret_ty(ctx: mut ref CgCtx, expr: ref parser.Node) ref parser.Node = trust {
    if expr == none || expr.kind != parser.NK_CALL {
        return none
    }
    val callee: ref parser.Node = parser.call_callee(expr)
    if callee == none {
        return none
    }
    val resolved_fn: ref parser.Node = parser.call_resolved_fn(expr)

    if callee.kind != parser.NK_GENERIC_INST {
        if resolved_fn == none {
            return none
        }
        if resolved_fn.kind == parser.NK_FN || resolved_fn.kind == parser.NK_GENERIC_FN {
            return cg_concrete_ty(ctx, resolved_fn.d4 as ref parser.Node)
        }
        if resolved_fn.kind == parser.NK_EXTERN_FN {
            return cg_concrete_ty(ctx, resolved_fn.d5 as ref parser.Node)
        }
        return none
    }

    val gi_base: ref parser.Node = parser.generic_inst_base(callee)
    val gi_targs: list[ref parser.Node] = parser.generic_inst_type_args(callee)
    val base_name: ref u8 = generic_callee_base_name(ctx, gi_base)
    val gfn_node: mut ref parser.Node = none
    if resolved_fn != none && resolved_fn.kind == parser.NK_GENERIC_FN {
        gfn_node = resolved_fn
    } else {
        gfn_node = lookup_generic_fn(ctx, base_name)
    }
    if gfn_node == none {
        return none
    }

    val resolved_targs: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    for ta in gi_targs {
        @append(resolved_targs, cg_concrete_ty(ctx, ta as ref parser.Node))
    }

    val old_gsubst_names: mut list[ref u8] = mem.new[ref u8]()
    for n in ctx.gsubst_names {
        @append(old_gsubst_names, n)
    }
    val old_gsubst_tnodes: mut list[ref void] = mem.new[ref void]()
    for t in ctx.gsubst_tnodes {
        @append(old_gsubst_tnodes, t)
    }
    ctx.gsubst_names = mem.new[ref u8]()
    ctx.gsubst_tnodes = mem.new[ref void]()

    val tparams: ref void = gfn_node.d6 as ref void
    if tparams != none {
        val nparms: i64 = @len(tparams as list[ref parser.Node]) as i64
        val pi: mut i64 = 0
        for {
            if pi >= nparms {
                break
            }
            val pn_opt = @get(tparams as list[ref parser.Node], pi as usize)
            val ta_opt = @get(resolved_targs, pi as usize)
            if pn_opt is some pn {
                if ta_opt is some ta {
                    gsubst_push(
                        ctx,
                        parser.tparam_name_raw(pn as ref parser.Node),
                        ta as ref parser.Node
                    )
                }
            }
            pi++
        }
    }

    val ret_ty: ref parser.Node = cg_concrete_ty(ctx, gfn_node.d4 as ref parser.Node)
    ctx.gsubst_names = old_gsubst_names
    ctx.gsubst_tnodes = old_gsubst_tnodes
    return ret_ty
}

/// Register an extern function: maps its declared name to its C symbol and stores return type.
fn cg_register_extern(
    ctx: mut ref CgCtx,
    name: ref u8,
    symbol: ref u8,
    ret_ty: ref void
) void = trust {
    @append(cg_extern_names(ctx) as list[ref u8], name)
    @append(cg_extern_syms(ctx) as list[ref u8], symbol)
    @append(cg_ext_rets(ctx) as list[ref void], ret_ty)
}

/// Look up the C symbol for an extern function name. Returns 0 if not found.
/// Tries exact match first, then suffix match (e.g. "std__os__exit" -> "exit").
fn cg_lookup_extern_symbol(ctx: mut ref CgCtx, name: ref u8) ref u8 = trust {
    val names: ref void = cg_extern_names(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                val s_opt = @get(cg_extern_syms(ctx) as list[ref u8], ni as usize)
                if s_opt is some s {
                    return s as ref u8
                } else {
                    return none
                }
            }
        }
        ni++
    }
    val namelen: i64 = str.len_raw(name)
    val ni2: mut i64 = 0
    for {
        if ni2 >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni2 as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            val clen: i64 = str.len_raw(candidate)
            if namelen > clen {
                val suffix_pos: i64 = namelen - clen
                if suffix_pos > 0 {
                    val sc: u8 = @load8(@ptradd(name, suffix_pos - 1))
                    if sc == 95 {
                        val rest: ref u8 = @ptradd(name, suffix_pos) as ref u8
                        if str.raw_cmp(rest, candidate) == 0 {
                            val s_opt = @get(cg_extern_syms(ctx) as list[ref u8], ni2 as usize)
                            if s_opt is some s {
                                return s as ref u8
                            }
                        }
                    }
                }
            }
        }
        ni2++
    }
    return none
}

/// Look up the return type for an extern function name. Returns 0 if not found.
/// Tries exact match first, then suffix match.
fn cg_lookup_ext_ret(ctx: mut ref CgCtx, name: ref u8) ref void = trust {
    val names: ref void = cg_extern_names(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                val r_opt = @get(cg_ext_rets(ctx) as list[ref void], ni as usize)
                if r_opt is some r {
                    return r as ref void
                } else {
                    return none
                }
            }
        }
        ni++
    }
    val namelen: i64 = str.len_raw(name)
    val ni2: mut i64 = 0
    for {
        if ni2 >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni2 as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            val clen: i64 = str.len_raw(candidate)
            if namelen > clen {
                val suffix_pos: i64 = namelen - clen
                if suffix_pos > 0 {
                    val sc: u8 = @load8(@ptradd(name, suffix_pos - 1))
                    if sc == 95 {
                        val rest: ref u8 = @ptradd(name, suffix_pos) as ref u8
                        if str.raw_cmp(rest, candidate) == 0 {
                            val r_opt = @get(cg_ext_rets(ctx) as list[ref void], ni2 as usize)
                            if r_opt is some r {
                                return r as ref void
                            }
                        }
                    }
                }
            }
        }
        ni2++
    }
    return none
}

/// Register a tagged union variant: variant_name -> (union_name, tag_index, field_type_node).
fn cg_register_tv(
    ctx: mut ref CgCtx,
    vname: ref u8,
    owner: ref u8,
    tag: i64,
    field_ty: ref void
) void = trust {
    @append(cg_tv_names(ctx) as list[ref u8], vname)
    @append(cg_tv_owners(ctx) as list[ref u8], owner)
    @append(cg_tv_tags(ctx) as list[i64], tag)
    @append(cg_tv_fields(ctx) as list[ref void], field_ty)
}

/// Look up a tagged union variant by name.
/// Returns the tag index, or -1 if not found.
/// Sets out_owner and out_field_ty if found (pass as ref void pointers to ref u8 / ref void).
fn cg_lookup_tv(
    ctx: mut ref CgCtx,
    vname: ref u8,
    out_owner: ref void,
    out_field_ty: ref void
) i64 = trust {
    val names: ref void = cg_tv_names(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, vname) == 0 {
                val tag_opt = @get(cg_tv_tags(ctx) as list[i64], ni as usize)
                val owner_opt = @get(cg_tv_owners(ctx) as list[ref u8], ni as usize)
                val field_opt = @get(cg_tv_fields(ctx) as list[ref void], ni as usize)
                if tag_opt is some tag {
                    if owner_opt is some owner {
                        @store(out_owner, owner as usize)
                    }
                    if field_opt is some field {
                        @store(out_field_ty, field as usize)
                    }
                    return tag as i64
                }
            }
        }
        ni++
    }
    return -1
}

/// Build a named type node without going through the parser.
fn cg_builtin_named_type(ctx: ref CgCtx, name: ref u8) ref parser.Node = trust {
    val n: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
    parser.node_store_string_slot(@addr(n.d0), name)
    return n
}

fn cg_builtin_ref_type(ctx: ref CgCtx, inner: ref parser.Node) ref parser.Node = trust {
    val n: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_REF, 0)
    parser.node_store_slot[ref parser.Node](@addr(n.d0), inner)
    return n
}

fn cg_builtin_field(
    ctx: ref CgCtx,
    name: ref u8,
    ty: ref parser.Node
) ref parser.Node = trust {
    val n: mut ref parser.Node = parser.make_node(ctx.arena, parser.NK_VAL, 0)
    parser.node_store_string_slot(@addr(n.d0), name)
    n.d1 = 0
    parser.node_store_slot[ref parser.Node](@addr(n.d2), ty)
    return n
}

/// A string literal evaluates to a `StringView` without requiring std/string
/// to be imported, so codegen always knows the built-in struct shape.
fn cg_register_builtin_stringview(ctx: mut ref CgCtx) void = trust {
    if cg_lookup_struct(ctx, c"StringView") != none {
        return
    }
    val fields: mut list[ref void] = mem.new[ref void]()
    val u8_ty: ref parser.Node = cg_builtin_named_type(ctx, c"u8")
    val ptr_ty: ref parser.Node = cg_builtin_ref_type(ctx, u8_ty)
    val len_ty: ref parser.Node = cg_builtin_named_type(ctx, c"i64")
    @append(fields, cg_builtin_field(ctx, c"ptr", ptr_ty))
    @append(fields, cg_builtin_field(ctx, c"len", len_ty))
    cg_register_struct(ctx, c"StringView", fields, false)
}

/// Register a struct type's field list by name.
fn cg_register_struct(
    ctx: mut ref CgCtx,
    type_name: ref u8,
    fields: ref void,
    is_extern: bool
) void = trust {
    // Structs are registered both by preregister_items and by the codegen
    // loops. Skip exact duplicates so literal field matching does not see
    // multiple copies of the same struct and give up as ambiguous.
    val names: ref void = cg_snames(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, type_name) == 0 {
                val f_opt = @get(cg_sfields(ctx) as list[ref void], ni as usize)
                if f_opt is some f {
                    if f as ref void == fields {
                        return
                    }
                }
            }
        }
        ni++
    }
    @append(cg_snames(ctx) as list[ref u8], type_name)
    @append(cg_sfields(ctx) as list[ref void], fields)
    @append(cg_sis_extern(ctx) as list[bool], is_extern)
}

/// Look up the field list for a struct type name. Returns 0 if not found.
fn cg_lookup_struct(ctx: mut ref CgCtx, type_name: ref u8) ref void = trust {
    val names: ref void = cg_snames(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, type_name) == 0 {
                val f_opt = @get(cg_sfields(ctx) as list[ref void], ni as usize)
                if f_opt is some f {
                    return f as ref void
                } else {
                    return none
                }
            }
        }
        ni++
    }

    val tlen: i64 = str.len_raw(type_name)
    val dot_pos: mut i64 = tlen - 1

    for {
        if dot_pos < 0 {
            break
        }
        val ch: u8 = @load8(@ptradd(type_name, dot_pos))
        if ch == 46 {
            break
        }
        dot_pos--
    }

    if dot_pos >= 0 {
        val bare: ref u8 = @ptradd(type_name, dot_pos + 1) as ref u8
        val ni2: mut i64 = 0
        for {
            if ni2 >= nlen {
                break
            }
            val n_opt2 = @get(names as list[ref u8], ni2 as usize)
            if n_opt2 is some n2 {
                if str.raw_cmp(n2 as ref u8, bare) == 0 {
                    val f_opt2 = @get(cg_sfields(ctx) as list[ref void], ni2 as usize)
                    if f_opt2 is some f2 {
                        return f2 as ref void
                    } else {
                        return none
                    }
                }
            }
            ni2++
        }
    }
    return none
}

fn cg_struct_uses_c_abi(ctx: mut ref CgCtx, fields: ref void) bool = trust {
    if fields == none {
        return false
    }
    val nlen: i64 = @len(cg_sfields(ctx) as list[ref void]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val f_opt = @get(cg_sfields(ctx) as list[ref void], ni as usize)
        if f_opt is some f {
            if f as ref void == fields {
                val ex_opt = @get(cg_sis_extern(ctx) as list[bool], ni as usize)
                if ex_opt is some is_extern {
                    return is_extern
                } else {
                    return false
                }
            }
        }
        ni++
    }
    return false
}

fn cg_struct_align(ctx: mut ref CgCtx, fields: ref void) i64 = trust {
    if fields == none {
        return 1
    }
    if !cg_struct_uses_c_abi(ctx, fields) {
        return 8
    }
    val flen: i64 = @len(fields as list[ref void]) as i64
    val max_align: mut i64 = 1
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val falign: i64 = cg_c_abi_type_align(ctx, fnode.d2 as ref parser.Node)
            if falign > max_align {
                max_align = falign
            }
        }
        fi++
    }
    return max_align
}

fn cg_c_abi_type_size(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 8
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return 8
    }
    val k: i64 = resolved.kind
    if k == parser.TY_VOID {
        return 0
    }
    if k == parser.TY_MUT {
        return cg_c_abi_type_size(ctx, resolved.d0 as ref parser.Node)
    }
    if k == parser.TY_REF || k == parser.TY_OPTION || k == parser.TY_FNPTR {
        return 8
    }
    if k == parser.TY_LIST {
        return 8
    }
    if k == parser.TY_RESULT || k == parser.TY_SLICE {
        return 16
    }
    if k == parser.TY_FIXED_ARR {
        val count: i64 = cg_fixed_arr_size_val(ctx, resolved)
        return count * cg_c_abi_type_size(ctx, resolved.d1 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(resolved.d0)
        if str.raw_cmp(
            tname,
            c"i8"
        ) == 0 || str.raw_cmp(tname, c"u8") == 0 || str.raw_cmp(tname, c"bool") == 0 {
            return 1
        }
        if str.raw_cmp(tname, c"i16") == 0 || str.raw_cmp(tname, c"u16") == 0 {
            return 2
        }
        if str.raw_cmp(
            tname,
            c"i32"
        ) == 0 || str.raw_cmp(tname, c"u32") == 0 || str.raw_cmp(tname, c"f32") == 0 {
            return 4
        }
        if str.raw_cmp(
            tname,
            c"i64"
        ) == 0 || str.raw_cmp(
            tname,
            c"u64"
        ) == 0 || str.raw_cmp(
            tname,
            c"usize"
        ) == 0 || str.raw_cmp(tname, c"isize") == 0 || str.raw_cmp(tname, c"f64") == 0 {
            return 8
        }
        val union_check: ref void = cg_lookup_union_suffix(ctx, tname)
        if union_check != none {
            return cg_union_size(ctx, union_check)
        }
        val struct_fields: ref void = cg_lookup_struct(ctx, tname)
        if struct_fields != none {
            return struct_size(ctx, struct_fields)
        }
    }
    return type_size(resolved)
}

fn cg_c_abi_type_align(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 8
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return 8
    }
    val k: i64 = resolved.kind
    if k == parser.TY_VOID {
        return 1
    }
    if k == parser.TY_MUT {
        return cg_c_abi_type_align(ctx, resolved.d0 as ref parser.Node)
    }
    if k == parser.TY_REF || k == parser.TY_OPTION || k == parser.TY_RESULT || k == parser.TY_SLICE || k == parser.TY_FNPTR || k == parser.TY_LIST {
        return 8
    }
    if k == parser.TY_FIXED_ARR {
        return cg_c_abi_type_align(ctx, resolved.d1 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(resolved.d0)
        if str.raw_cmp(
            tname,
            c"i8"
        ) == 0 || str.raw_cmp(tname, c"u8") == 0 || str.raw_cmp(tname, c"bool") == 0 {
            return 1
        }
        if str.raw_cmp(tname, c"i16") == 0 || str.raw_cmp(tname, c"u16") == 0 {
            return 2
        }
        if str.raw_cmp(
            tname,
            c"i32"
        ) == 0 || str.raw_cmp(tname, c"u32") == 0 || str.raw_cmp(tname, c"f32") == 0 {
            return 4
        }
        if str.raw_cmp(
            tname,
            c"i64"
        ) == 0 || str.raw_cmp(
            tname,
            c"u64"
        ) == 0 || str.raw_cmp(
            tname,
            c"usize"
        ) == 0 || str.raw_cmp(tname, c"isize") == 0 || str.raw_cmp(tname, c"f64") == 0 {
            return 8
        }
        val struct_fields: ref void = cg_lookup_struct(ctx, tname)
        if struct_fields != none {
            if cg_struct_uses_c_abi(ctx, struct_fields) {
                return cg_struct_align(ctx, struct_fields)
            }
            return 8
        }
    }
    return 8
}

/// Register an invariant expression list for a type name.
fn cg_register_invariant(ctx: mut ref CgCtx, type_name: ref u8, inv_list: ref void) void = trust {
    @append(ctx.inv_tnames as list[ref u8], type_name)
    @append(ctx.inv_tlists as list[ref void], inv_list)
}

/// Look up the invariant expression list for a type name. Returns 0 if not found.
fn cg_lookup_invariant(ctx: ref CgCtx, type_name: ref u8) ref void = trust {
    val nlen: i64 = @len(ctx.inv_tnames as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.inv_tnames as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, type_name) == 0 {
                val il_opt = @get(ctx.inv_tlists as list[ref void], ni as usize)
                if il_opt is some il {
                    return il as ref void
                } else {
                    return none
                }
            }
        }
        ni++
    }
    return none
}

/// Emit runtime invariant checks for all mut-T params in the current function.
/// No-ops in release mode.
fn cg_emit_invariant_checks(ctx: mut ref CgCtx) void = trust {
    if ctx.release_mode {
        return
    }
    val plen: i64 = @len(ctx.inv_cur_pnames as list[ref u8]) as i64
    if plen == 0 {
        return
    }
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        val pn_opt = @get(ctx.inv_cur_pnames as list[ref u8], pi as usize)
        val pt_opt = @get(ctx.inv_cur_ptypes as list[ref u8], pi as usize)
        if pn_opt is some pn {
            if pt_opt is some pt {
                val param_name: ref u8 = pn as ref u8
                val type_name: ref u8 = pt as ref u8
                val inv_list: ref void = cg_lookup_invariant(ctx, type_name)
                val fields: ref void = cg_lookup_struct(ctx, type_name)
                if inv_list != none && fields != none {
                    val flen: i64 = @len(fields as list[ref void]) as i64
                    val fi: mut i64 = 0
                    for {
                        if fi >= flen {
                            break
                        }
                        val f_opt = @get(fields as list[ref void], fi as usize)
                        if f_opt is some f {
                            val fnode: ref parser.Node = f as ref parser.Node
                            val fname: ref u8 = parser.node_str_raw(fnode.d0)
                            val fty: ref parser.Node = fnode.d2 as ref parser.Node
                            val fqt: ref u8 = qbe_type_of(fty)
                            val foff: i64 = field_offset(ctx, fields, fname)
                            if str.raw_cmp(fqt, c"l") == 0 {
                                val addr_tmp: i64 = fresh_tmp(ctx)
                                val val_tmp: i64 = fresh_tmp(ctx)
                                val lbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(lbuf, 256,
                                    "    %%t{lld} =l add %%{s}, {lld}\n    %%t{lld} =l loadl %%t{lld}\n",
                                    {addr_tmp, param_name, foff, val_tmp, addr_tmp})
                                emit(
                                    ctx,
                                    lbuf
                                )
                                val tmp_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    32 as usize
                                ) as ref u8
                                @snprintf(tmp_str, 32, "{lld}", {val_tmp})
                                cg_register_local_var(ctx, fname, tmp_str)
                                cg_register_local_type(ctx, fname, c"i64")
                            } elif str.raw_cmp(fqt, c"w") == 0 {
                                val addr_tmp: i64 = fresh_tmp(ctx)
                                val w_tmp: i64 = fresh_tmp(ctx)
                                val val_tmp: i64 = fresh_tmp(ctx)
                                val lbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(lbuf, 256,
                                    "    %%t{lld} =l add %%{s}, {lld}\n    %%t{lld} =w loadw %%t{lld}\n    %%t{lld} =l extsw %%t{lld}\n",
                                    {addr_tmp, param_name, foff, w_tmp, addr_tmp, val_tmp, w_tmp})
                                emit(
                                    ctx,
                                    lbuf
                                )
                                val tmp_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    32 as usize
                                ) as ref u8
                                @snprintf(tmp_str, 32, "{lld}", {val_tmp})
                                cg_register_local_var(ctx, fname, tmp_str)
                                cg_register_local_type(ctx, fname, c"i64")
                            }
                        }
                        fi++
                    }
                    val ilen: i64 = @len(inv_list as list[ref parser.Node]) as i64
                    val ii: mut i64 = 0
                    for {
                        if ii >= ilen {
                            break
                        }
                        val inv_opt = @get(inv_list as list[ref parser.Node], ii as usize)
                        if inv_opt is some inv {
                            val inv_node: ref parser.Node = inv as ref parser.Node
                            val cv: ref u8 = gen_expr(ctx, inv_node)
                            val ok_lbl: i64 = fresh_lbl(ctx)
                            val fail_lbl: i64 = fresh_lbl(ctx)
                            val fn_name: ref u8 = cg_fn_name(ctx)
                            val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                128 as usize
                            ) as ref u8
                            @snprintf(jbuf, 128,
                                "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                                {cv, ok_lbl, fail_lbl, fail_lbl})
                            emit(
                                ctx,
                                jbuf
                            )
                            val msg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                512 as usize
                            ) as ref u8
                            @snprintf(msg_buf, 512,
                                "spectre: invariant violated for type '{s}' in '{s}'\n",
                                {type_name, fn_name})
                            val msg_idx: i64 = intern_string_raw(
                                ctx,
                                msg_buf
                            )
                            val msg_tmp: i64 = fresh_tmp(ctx)
                            val call_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(call_buf, 256,
                                "    %%t{lld} =l copy $__str{lld}\n    call $dprintf(w 2, l %%t{lld})\n    call $fflush(l 0)\n    call $exit(l 1)\n    hlt\n@lbl{lld}\n",
                                {msg_tmp, msg_idx, msg_tmp, ok_lbl})
                            emit(ctx, call_buf)
                        }
                        ii++
                    }
                }
            }
        }
        pi++
    }
}

/// Register a union type's variant type-name list.
fn cg_register_union(ctx: mut ref CgCtx, union_name: ref u8, variants: ref void) void = trust {
    @append(cg_unames(ctx) as list[ref u8], union_name)
    @append(cg_uvariants(ctx) as list[ref void], variants)
}

/// Look up the variant list for a union type. Returns 0 if not found.
fn cg_lookup_union(ctx: mut ref CgCtx, union_name: ref u8) ref void = trust {
    val names: ref void = cg_unames(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, union_name) == 0 {
                val v_opt = @get(cg_uvariants(ctx) as list[ref void], ni as usize)
                if v_opt is some v {
                    return v as ref void
                } else {
                    return none
                }
            }
        }
        ni++
    }
    return none
}

/// Check if a type name matches any registered union (tries exact match and suffix match for mangled names).
fn is_union_type_name(ctx: mut ref CgCtx, type_name: ref u8) bool = trust {
    if cg_lookup_union_suffix(ctx, type_name) != none {
        return true
    }
    val names: ref void = cg_unames(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val tlen: i64 = str.len_raw(type_name)
    val suffix_len: i64 = tlen + 2
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            val clen: i64 = str.len_raw(candidate)
            if clen > suffix_len {
                val tail: ref u8 = @ptradd(candidate, clen - suffix_len) as ref u8
                val c1: u8 = @load8(@ptradd(tail, 0))
                val c2: u8 = @load8(@ptradd(tail, 1))
                if c1 == 95 && c2 == 95 {
                    val rest: ref u8 = @ptradd(tail, 2) as ref u8
                    if str.raw_cmp(rest, type_name) == 0 {
                        return true
                    }
                }
            }
        }
        ni++
    }
    return false
}

/// Compute the total byte size of a struct with the given fields.
fn struct_size(ctx: mut ref CgCtx, fields: ref void) i64 = trust {
    if cg_struct_uses_c_abi(ctx, fields) {
        val flen2: i64 = @len(fields as list[ref void]) as i64
        val offset2: mut i64 = 0
        val max_align2: mut i64 = 1
        val fi2: mut i64 = 0
        for {
            if fi2 >= flen2 {
                break
            }
            val f_opt2 = @get(fields as list[ref void], fi2 as usize)
            if f_opt2 is some f2 {
                val fnode2: ref parser.Node = f2 as ref parser.Node
                val fty2: ref parser.Node = fnode2.d2 as ref parser.Node
                val falign2: i64 = cg_c_abi_type_align(ctx, fty2)
                if falign2 > max_align2 {
                    max_align2 = falign2
                }
                offset2 = align_to(offset2, falign2)
                offset2 = offset2 + cg_c_abi_type_size(ctx, fty2)
            }
            fi2++
        }
        return align_to(offset2, max_align2)
    }
    val flen: i64 = @len(fields as list[ref void]) as i64
    val offset: mut i64 = 0
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val fty: ref parser.Node = fnode.d2 as ref parser.Node
            val fsize: mut i64 = type_size(fty)
            if fty != none && fty.kind == parser.TY_NAMED {
                val tname: ref u8 = parser.node_str_raw(fty.d0)
                val union_check: ref void = cg_lookup_union_suffix(ctx, tname)
                if union_check != none {
                    fsize = cg_union_size(ctx, union_check)
                } else {
                    val struct_fields: ref void = cg_lookup_struct(ctx, tname)
                    if struct_fields != none {
                        fsize = struct_size(ctx, struct_fields)
                    }
                }
            }
            offset = offset + fsize
        }
        fi++
    }
    return offset
}

fn field_offset(ctx: mut ref CgCtx, fields: ref void, field_name: ref u8) i64 = trust {
    if cg_struct_uses_c_abi(ctx, fields) {
        val flen2: i64 = @len(fields as list[ref void]) as i64
        val offset2: mut i64 = 0
        val fi2: mut i64 = 0
        for {
            if fi2 >= flen2 {
                break
            }
            val f_opt2 = @get(fields as list[ref void], fi2 as usize)
            if f_opt2 is some f2 {
                val fnode2: ref parser.Node = f2 as ref parser.Node
                val fty2: ref parser.Node = fnode2.d2 as ref parser.Node
                offset2 = align_to(offset2, cg_c_abi_type_align(ctx, fty2))
                if str.raw_cmp(parser.node_str_raw(fnode2.d0), field_name) == 0 {
                    return offset2
                }
                offset2 = offset2 + cg_c_abi_type_size(ctx, fty2)
            }
            fi2++
        }
        return -1
    }
    val flen: i64 = @len(fields as list[ref void]) as i64
    val offset: mut i64 = 0
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val fname: ref u8 = parser.node_str_raw(fnode.d0)
            val fty: ref parser.Node = fnode.d2 as ref parser.Node
            if str.raw_cmp(fname, field_name) == 0 {
                return offset
            }
            val fsize: mut i64 = type_size(fty)
            if fty != none && fty.kind == parser.TY_NAMED {
                val tname: ref u8 = parser.node_str_raw(fty.d0)
                val union_check: ref void = cg_lookup_union_suffix(ctx, tname)
                if union_check != none {
                    fsize = cg_union_size(ctx, union_check)
                } else {
                    val struct_fields2: ref void = cg_lookup_struct(ctx, tname)
                    if struct_fields2 != none {
                        fsize = struct_size(ctx, struct_fields2)
                    }
                }
            }
            offset = offset + fsize
        }
        fi++
    }
    return -1
}

/// Look up the type name of a field in a struct by name. Returns "" if not found.
fn field_type_name(_: ref CgCtx, fields: ref void, field_name: ref u8) ref u8 = trust {
    val flen: i64 = @len(fields as list[ref void]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val fname: ref u8 = parser.node_str_raw(fnode.d0)
            if str.raw_cmp(fname, field_name) == 0 {
                val fty: ref parser.Node = fnode.d2 as ref parser.Node
                if fty != none {
                    return unwrap_type_name(fty)
                }
            }
        }
        fi++
    }
    return c""
}

/// Compute the cumulative offset for a nested field access chain (e.g., o.inner.len).
/// Returns -1 if the type cannot be resolved.
fn nested_field_offset(ctx: mut ref CgCtx, node: ref parser.Node, field_name: ref u8) i64 = trust {
    if node == none {
        return -1
    }
    if node.kind == parser.NK_IDENT {
        val bname: ref u8 = parser.node_str_raw(node.d0)
        val tname: mut ref u8 = cg_local_type(ctx, bname)
        if str.raw_cmp(tname, c"") == 0 {
            tname = infer_type_annotation(ctx, node)
        }
        val lookup_tname: ref u8 = cg_ann_deref(tname)
        if str.raw_cmp(lookup_tname, c"") != 0 {
            val flds: ref void = cg_lookup_struct(ctx, lookup_tname)
            if flds != none {
                val off: i64 = field_offset(ctx, flds, field_name)
                if off >= 0 {
                    return off
                }
            }
        }
        return -1
    }
    if node.kind == parser.NK_FIELD {
        val inner_base: ref parser.Node = parser.field_base(node)
        val inner_name: ref u8 = parser.field_name_raw(node)
        val inner_off: i64 = nested_field_offset(ctx, inner_base, inner_name)
        if inner_off < 0 {
            return -1
        }
        val inner_type: mut ref u8 = c""
        if inner_base.kind == parser.NK_IDENT {
            val bname2: ref u8 = parser.node_str_raw(inner_base.d0)
            val btname: mut ref u8 = cg_local_type(ctx, bname2)
            if str.raw_cmp(btname, c"") == 0 {
                btname = infer_type_annotation(ctx, inner_base)
            }
            val blookup: ref u8 = cg_ann_deref(btname)
            if str.raw_cmp(blookup, c"") != 0 {
                val bflds: ref void = cg_lookup_struct(ctx, blookup)
                if bflds != none {
                    inner_type = field_type_name(ctx, bflds, inner_name)
                }
            }
        }
        if str.raw_cmp(inner_type, c"") == 0 {
            inner_type = infer_type_annotation(ctx, node)
        }
        val lookup_inner: ref u8 = cg_ann_deref(inner_type)
        if str.raw_cmp(lookup_inner, c"") != 0 {
            val inner_flds: ref void = cg_lookup_struct(ctx, lookup_inner)
            if inner_flds != none {
                val final_off: i64 = field_offset(ctx, inner_flds, field_name)
                if final_off >= 0 {
                    return inner_off + final_off
                }
            }
        }
        return -1
    }
    return -1
}

fn cg_dvars_clear(ctx: mut ref CgCtx) void = trust {
    ctx.dvars = mem.new[ref u8]()
    ctx.dqtypes = mem.new[ref u8]()
    ctx.local_ref_types = mem.new[ref u8]()
    ctx.lnames = mem.new[ref u8]()
    ctx.ltypes = mem.new[ref u8]()
    ctx.local_src_names = mem.new[ref u8]()
    ctx.local_qbe_names = mem.new[ref u8]()
    ctx.local_slot_names = mem.new[ref u8]()
    ctx.stack_agg_values = mem.new[ref u8]()
    cg_defer_clear(ctx)
    cg_set_tmp(ctx, 0)
}

fn cg_register_local_type(ctx: mut ref CgCtx, name: ref u8, type_name: ref u8) void = trust {
    @append(ctx.lnames as list[ref u8], name)
    @append(ctx.ltypes as list[ref u8], type_name)
}

/// Register a local variable as having a reference/pointer type
fn cg_register_local_ref_type(ctx: mut ref CgCtx, name: ref u8) void = trust {
    @append(ctx.local_ref_types as list[ref u8], name)
}

/// Check if a local variable has a reference/pointer type
fn cg_is_local_ref_type(ctx: ref CgCtx, name: ref u8) bool = trust {
    val nlen: i64 = @len(ctx.local_ref_types as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.local_ref_types as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                return true
            }
        }
        ni++
    }
    return false
}

fn cg_local_type(ctx: ref CgCtx, name: ref u8) ref u8 = trust {
    val nlen: i64 = @len(ctx.lnames as list[ref u8]) as i64
    val ni: mut i64 = nlen - 1
    for {
        if ni < 0 {
            break
        }
        val n_opt = @get(ctx.lnames as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                val t_opt = @get(ctx.ltypes as list[ref u8], ni as usize)
                if t_opt is some t {
                    return t as ref u8
                } else {
                    return c""
                }
            }
        }
        ni--
    }
    return c""
}

/// Generate a struct literal inline within a parent allocation (e.g., union payload).
/// base_offset is the starting offset within the parent allocation.
fn gen_struct_lit_inline(
    ctx: mut ref CgCtx,
    struct_node: ref parser.Node,
    parent_ptr: i64,
    base_offset: i64,
    fields: ref void
) void = trust {
    val sfields_node: ref void = fields
    val lit_fields: ref void = struct_node.d0 as ref void

    if lit_fields == none {
        return
    }

    val lit_flen: i64 = @len(lit_fields as list[ref void]) as i64
    val li: mut i64 = 0
    for {
        if li >= lit_flen {
            break
        }
        val lf_opt = @get(lit_fields as list[ref void], li as usize)
        if lf_opt is some lf {
            val lf_node: ref parser.Node = lf as ref parser.Node
            val lf_name: ref u8 = parser.node_str_raw(lf_node.d0)
            val lf_expr: ref parser.Node = lf_node.d1 as ref parser.Node
            val off: i64 = field_offset(ctx, sfields_node, lf_name)
            if off >= 0 {
                val actual_off: i64 = base_offset + off
                val fptr: i64 = fresh_tmp(ctx)
                val fbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                val lit_store_op: mut ref u8 = c"storel"
                val fty_node: mut ref parser.Node = none
                val sflen2: i64 = @len(sfields_node as list[ref void]) as i64
                val sfi2: mut i64 = 0
                for {
                    if sfi2 >= sflen2 {
                        break
                    }
                    val sf2_opt = @get(sfields_node as list[ref void], sfi2 as usize)
                    if sf2_opt is some sf2 {
                        val sf2n: ref parser.Node = sf2 as ref parser.Node
                        val sf2name: ref u8 = parser.node_str_raw(sf2n.d0)
                        if str.raw_cmp(sf2name, lf_name) == 0 {
                            val sf2ty: ref parser.Node = sf2n.d2 as ref parser.Node
                            fty_node = sf2ty
                            lit_store_op = field_store_instr_for_struct(ctx, sfields_node, sf2ty)
                            sfi2 = sflen2
                        }
                    }
                    sfi2++
                }
                if cg_type_needs_aggregate_copy(ctx, fty_node) {
                    val copy_size: i64 = cg_alloc_size_for_type(ctx, fty_node)
                    if cg_expr_is_zero_init_like(lf_expr) {
                        @snprintf(fbuf, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    call $memset(l %%t{lld}, w 0, l {lld})\n",
                            {fptr, parent_ptr, actual_off, fptr, copy_size})
                    } else {
                        val fval: ref u8 = gen_expr_expected(ctx, lf_expr, fty_node)
                        @snprintf(fbuf, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                            {fptr, parent_ptr, actual_off, fptr, fval, copy_size})
                    }
                } else {
                    val fval: ref u8 = cg_gen_expr_for_store(ctx, lf_expr, fty_node, lit_store_op)
                    @snprintf(fbuf, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    {s} {s}, %%t{lld}\n",
                        {fptr, parent_ptr, actual_off, lit_store_op, fval, fptr})
                }
                emit(ctx, fbuf)
            }
        }
        li++
    }
}

fn cg_dvars_add(ctx: mut ref CgCtx, name: ref u8, qtype: ref u8) void = trust {
    @append(cg_dvars(ctx) as list[ref u8], name)
    @append(ctx.dqtypes as list[ref u8], qtype)
}

/// Get the QBE type for a variable (from dvars or inferred from local type)
fn cg_var_qbe_type(ctx: mut ref CgCtx, name: ref u8) ref u8 = trust {
    val dv: ref void = cg_dvars(ctx)
    val dlen: i64 = @len(dv as list[ref u8]) as i64
    val di: mut i64 = 0
    for {
        if di >= dlen {
            break
        }
        val d_opt = @get(dv as list[ref u8], di as usize)
        if d_opt is some d {
            if str.raw_cmp(d as ref u8, name) == 0 {
                val q_opt = @get(ctx.dqtypes as list[ref u8], di as usize)
                if q_opt is some q {
                    return q as ref u8
                } else {
                    return c"l"
                }
            }
        }
        di++
    }

    val ltype: ref u8 = cg_local_type(ctx, name)
    if str.raw_cmp(ltype, c"f64") == 0 {
        return c"d"
    } elif str.raw_cmp(ltype, c"f32") == 0 {
        return c"s"
    } elif is_word_type_name(ltype) {
        return c"w"
    }
    return c"l"

}

/// Register a local variable: map source name to QBE temporary name
fn cg_register_local_var(ctx: mut ref CgCtx, src_name: ref u8, qbe_name: ref u8) void = trust {
    @append(ctx.local_src_names as list[ref u8], src_name)
    @append(ctx.local_qbe_names as list[ref u8], qbe_name)
}

/// Mark a variable as a slot (mutable, needs load/store)
fn cg_mark_as_slot(ctx: mut ref CgCtx, src_name: ref u8) void = trust {
    @append(ctx.local_slot_names as list[ref u8], src_name)
}

/// Remove a stale slot marker when a later declaration shadows the name.
/// Codegen walks mutually exclusive branches sequentially, so a mutable local
/// from an earlier branch must not make a later immutable `val` look mutable.
fn cg_unmark_slot(ctx: mut ref CgCtx, src_name: ref u8) void = trust {
    val nlen: i64 = @len(ctx.local_slot_names as list[ref u8]) as i64
    val i: mut i64 = nlen - 1
    for {
        if i < 0 {
            break
        }
        val n_opt = @get(ctx.local_slot_names as list[ref u8], i as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, src_name) == 0 {
                @remove(ctx.local_slot_names, i as usize)
            }
        }
        i--
    }
}

/// Check if a variable is a slot (mutable)
fn cg_is_slot(ctx: ref CgCtx, src_name: ref u8) bool = trust {
    val nlen: i64 = @len(ctx.local_slot_names as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.local_slot_names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, src_name) == 0 {
                return true
            }
        }
        ni++
    }
    return false
}

/// Look up the QBE temporary name for a source variable name. Returns "" if not found.
/// Handles shadowing.
fn cg_lookup_local_var(ctx: ref CgCtx, src_name: ref u8) ref u8 = trust {
    val nlen: i64 = @len(ctx.local_src_names as list[ref u8]) as i64
    val ni: mut i64 = nlen - 1
    for {
        if ni < 0 {
            break
        }
        val n_opt = @get(ctx.local_src_names as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, src_name) == 0 {
                val q_opt = @get(ctx.local_qbe_names as list[ref u8], ni as usize)
                if q_opt is some q {
                    return q as ref u8
                } else {
                    return c""
                }
            }
        }
        ni--
    }
    return c""
}

/// Convert a stored local QBE name into a usable operand reference.
/// Stored names may be raw QBE values ("%t42", "$foo") or legacy temp ids ("42").
fn cg_qbe_value_ref(ctx: ref CgCtx, qbe_name: ref u8) ref u8 = trust {
    if str.raw_cmp(qbe_name, c"") == 0 {
        return c""
    }
    val first: u8 = @load8(qbe_name) as u8
    val qlen: i64 = str.len_raw(qbe_name)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (qlen + 4) as usize) as ref u8
    if first == 37 || first == 36 {
        @memcpy(out, qbe_name, qlen + 1)
        return out
    }
    @snprintf(out, qlen + 4, "%%t{s}", {qbe_name})
    return out
}

fn cg_ann_deref(ann: ref u8) ref u8 = trust {
    if ann == none {
        return c""
    }
    if raw_starts_with(ann, c"mut ref ") {
        return @ptradd(ann, 8) as ref u8
    }
    if raw_starts_with(ann, c"ref ") {
        return @ptradd(ann, 4) as ref u8
    }
    return ann
}

fn cg_ann_is_indirect_value(ctx: mut ref CgCtx, ann: ref u8) bool = trust {
    if str.raw_cmp(ann, c"") == 0 {
        return false
    }
    if raw_starts_with(ann, c"mut ref ") {
        return true
    }
    if raw_starts_with(ann, c"ref ") {
        return true
    }
    if raw_starts_with(ann, c"list[") {
        return true
    }
    if raw_starts_with(ann, c"slice[") {
        return true
    }
    if raw_starts_with(ann, c"option[") {
        return true
    }
    if raw_starts_with(ann, c"result[") {
        return true
    }
    if @load8(ann) as i64 == 91 {
        return true
    }
    if cg_lookup_struct(ctx, ann) != none {
        return true
    }
    if cg_lookup_union_suffix(ctx, ann) != none {
        return true
    }
    return false
}

/// Returns an empty ref u8, i.e. "" if not direct, else the qbe type ("w" or "l")
fn cg_direct_type(ctx: mut ref CgCtx, name: ref u8) ref u8 = trust {
    val dv: ref void = cg_dvars(ctx)
    val dlen: i64 = @len(dv as list[ref u8]) as i64
    val di: mut i64 = 0
    for {
        if di >= dlen {
            break
        }
        val d_opt = @get(dv as list[ref u8], di as usize)
        if d_opt is some d {
            if str.raw_cmp(d as ref u8, name) == 0 {
                val q_opt = @get(ctx.dqtypes as list[ref u8], di as usize)
                if q_opt is some q {
                    return q as ref u8
                } else {
                    return c"l"
                }
            }
        }
        di++
    }
    return c""
}

fn fresh_tmp(ctx: mut ref CgCtx) i64 = trust {
    val n: i64 = cg_tmp(ctx)
    cg_set_tmp(ctx, n + 1)
    return n
}

/// Return the QBE-safe temporary name to use for a source-level function parameter.
/// Parameters named `_` are wildcards and may repeat with different types; QBE
/// treats every parameter as a temporary assignment, so each needs a distinct name.
fn cg_param_qbe_name(ctx: ref CgCtx, index: i64, pname: ref u8) ref u8 = trust {
    if str.raw_cmp(pname, c"_") != 0 {
        return pname
    }
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(out, 32, "_unused.{lld}", {index})
    return out
}

fn fresh_lbl(ctx: mut ref CgCtx) i64 = trust {
    val n: i64 = cg_lbl(ctx)
    cg_set_lbl(ctx, n + 1)
    return n
}

fn emit(ctx: mut ref CgCtx, s: ref u8) void = trust {
    str.StringBuilder.append_cstr(cg_sb(ctx), s)
}

fn emitln(ctx: mut ref CgCtx, s: ref u8) void = trust {
    str.StringBuilder.append_cstr(cg_sb(ctx), s)
    str.StringBuilder.append_char(cg_sb(ctx), 10 as u8)
}

fn emit_view(ctx: mut ref CgCtx, s: str.StringView) void = trust {
    str.StringBuilder.append(cg_sb(ctx), s)
}

fn emitln_view(ctx: mut ref CgCtx, s: str.StringView) void = trust {
    str.StringBuilder.append(cg_sb(ctx), s)
    str.StringBuilder.append_char(cg_sb(ctx), 10 as u8)
}

/// Returns true if the type name maps to QBE word type (w).
fn is_word_type_name(name: ref u8) bool = trust {
    if str.raw_cmp(name, c"u8") == 0 {
        return true
    }
    if str.raw_cmp(name, c"i8") == 0 {
        return true
    }
    if str.raw_cmp(name, c"u16") == 0 {
        return true
    }
    if str.raw_cmp(name, c"i16") == 0 {
        return true
    }
    if str.raw_cmp(name, c"u32") == 0 {
        return true
    }
    if str.raw_cmp(name, c"i32") == 0 {
        return true
    }
    if str.raw_cmp(name, c"bool") == 0 {
        return true
    }
    if str.raw_cmp(name, c"u8") == 0 {
        return true
    }
    return false
}

fn is_float_type_name(name: ref u8) bool = trust {
    if str.raw_cmp(name, c"f32") == 0 {
        return true
    }
    if str.raw_cmp(name, c"f64") == 0 {
        return true
    }
    return false
}

fn qbe_type_of(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"l"
    }
    val k: i64 = ty.kind
    if k == parser.TY_VOID {
        return c"w"
    }
    if k == parser.TY_MUT {
        return qbe_type_of(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_REF {
        return c"l"
    }
    if k == parser.TY_OPTION {
        return c"l"
    }
    if k == parser.TY_LIST {
        return c"l"
    }
    if k == parser.TY_RESULT {
        return c"l"
    }
    if k == parser.TY_SLICE {
        return c"l"
    }
    if k == parser.TY_FNPTR {
        return c"l"
    }
    if k == parser.TY_FIXED_ARR {
        return c"a"
    }
    if k == parser.TY_NAMED {
        val name: ref u8 = parser.node_str_raw(ty.d0)
        if str.raw_cmp(name, c"i32") == 0 || str.raw_cmp(name, c"u32") == 0 {
            return c"w"
        }
        if str.raw_cmp(name, c"i8") == 0 || str.raw_cmp(name, c"u8") == 0 {
            return c"w"
        }
        if str.raw_cmp(name, c"i16") == 0 || str.raw_cmp(name, c"u16") == 0 {
            return c"w"
        }
        if str.raw_cmp(name, c"bool") == 0 {
            return c"w"
        }
        if str.raw_cmp(name, c"f32") == 0 {
            return c"s"
        }
        if str.raw_cmp(name, c"f64") == 0 {
            return c"d"
        }
        if str.raw_cmp(name, c"u8") == 0 {
            return c"w"
        }
        return c"l"
    }
    return c"l"
}

/// Returns true if the type is a reference/pointer type (TY_REF or TY_MUT with ref inside).
fn is_ref_type(ty: ref parser.Node) bool = trust {
    if ty == none {
        return false
    }
    val k: i64 = ty.kind
    if k == parser.TY_REF {
        return true
    }
    if k == parser.TY_MUT {
        return is_ref_type(ty.d0 as ref parser.Node)
    }
    return false
}

/// Infer the result type from a list of statements (used for match body type inference).
/// Looks for the last expression statement's type.
fn infer_stmts_result_type(ctx: mut ref CgCtx, stmts: ref void) ref u8 = trust {
    if stmts == none {
        return c""
    }
    val slen: i64 = @len(stmts as list[ref void]) as i64
    if slen == 0 {
        return c""
    }
    val last_opt = @get(stmts as list[ref void], (slen - 1) as usize)
    if last_opt is some last {
        val stmt: ref parser.Node = last as ref parser.Node
        return infer_stmt_result_type(ctx, stmt)
    } else {
        return c""
    }
}

/// Infer the result type from a single statement.
fn infer_stmt_result_type(ctx: mut ref CgCtx, stmt: ref parser.Node) ref u8 = trust {
    if stmt == none {
        return c""
    }
    val k: i64 = stmt.kind
    if k == parser.NK_EXPR_STMT {
        val expr: ref parser.Node = stmt.d0 as ref parser.Node
        return infer_type_annotation(ctx, expr)
    }
    if k == parser.NK_RETURN {
        val expr: ref parser.Node = stmt.d0 as ref parser.Node
        if expr != none {
            return infer_type_annotation(ctx, expr)
        }
    }
    return c""
}

/// Infer the type annotation string for an expression.
/// Handles: Ident (local vars, params, globals), Cast, Call (function return type).
fn infer_type_annotation(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c""
    }
    val k: i64 = expr.kind

    if k == parser.NK_INT_LIT {
        return c"i64"
    }
    if k == parser.NK_FLOAT_LIT {
        if ctx.expected_ty != none {
            val eqt: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
            if str.raw_cmp(eqt, c"s") == 0 {
                return c"f32"
            }
        }
        return c"f64"
    }
    if k == parser.NK_BOOL {
        return c"bool"
    }
    if k == parser.NK_CHAR_LIT {
        return c"u8"
    }
    if k == parser.NK_STR_LIT {
        if parser.str_lit_is_cstr(expr) {
            return c"ref u8"
        }
        return c"StringView"
    }

    if k == parser.NK_BUILTIN {
        val bname: ref u8 = parser.node_str_raw(expr.d0)
        if str.raw_cmp(bname, c"embed") == 0 {
            return c"ref u8"
        }
        if str.raw_cmp(bname, c"embedlen") == 0 {
            return c"i64"
        }
        if str.raw_cmp(bname, c"dumpmemleaks") == 0 {
            return c"testing.LeakDiagnostics"
        }
    }

    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val lt: ref u8 = cg_local_type(ctx, name)
        if str.raw_cmp(lt, c"") != 0 {
            return lt
        }
        val fparams: ref void = cg_lookup_fn_params(ctx, ctx.fn_name)
        if fparams != none {
            val plen: i64 = @len(fparams as list[ref parser.Node]) as i64
            val pi: mut i64 = 0
            for {
                if pi >= plen {
                    break
                }
                val p_opt = @get(fparams as list[ref parser.Node], pi as usize)
                if p_opt is some p {
                    val pname: ref u8 = parser.node_str_raw((p as ref parser.Node).d0)
                    val pty: ref parser.Node = (p as ref parser.Node).d1 as ref parser.Node
                    if str.raw_cmp(pname, name) == 0 {
                        if pty != none && (pty.kind == parser.TY_LIST || pty.kind == parser.TY_FIXED_ARR || pty.kind == parser.TY_FNPTR) {
                            return type_expr_to_annotation(ctx, pty)
                        }
                        return unwrap_type_name(pty)
                    }
                }
                pi++
            }
        }
        return c""
    }

    if k == parser.NK_STRUCT_LIT {
        val lit_ty: ref u8 = parser.struct_lit_type_name_raw(expr)
        if lit_ty != none {
            return lit_ty
        }
    }

    if k == parser.NK_CAST {
        val cast_ty: ref parser.Node = expr.d1 as ref parser.Node
        return type_expr_to_annotation(ctx, cast_ty)
    }

    if k == parser.NK_FIELD {
        val base_expr: ref parser.Node = parser.field_base(expr)
        val field_name: ref u8 = parser.field_name_raw(expr)
        val base_ann: ref u8 = infer_type_annotation(ctx, base_expr)
        val lookup_type: ref u8 = cg_ann_deref(base_ann)
        if str.raw_cmp(lookup_type, c"") != 0 {
            val fields: ref void = cg_lookup_struct(ctx, lookup_type)
            if fields != none {
                val flen: i64 = @len(fields as list[ref void]) as i64
                val fi: mut i64 = 0
                for {
                    if fi >= flen {
                        break
                    }
                    val f_opt = @get(fields as list[ref void], fi as usize)
                    if f_opt is some f {
                        val fnode: ref parser.Node = f as ref parser.Node
                        val fname: ref u8 = parser.node_str_raw(fnode.d0)
                        if str.raw_cmp(fname, field_name) == 0 {
                            return type_expr_to_annotation(ctx, fnode.d2 as ref parser.Node)
                        }
                    }
                    fi++
                }
            }
        }
        if base_expr != none && base_expr.kind == parser.NK_IDENT {
            val base_name_f: ref u8 = parser.node_str_raw(base_expr.d0)
            val mod_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(mod_key, 512, "{s}__{s}", {base_name_f, field_name})
            if cg_global_label_exists(ctx, mod_key) {
                val mod_ann: ref u8 = cg_global_ann_by_label(ctx, mod_key)
                if str.raw_cmp(mod_ann, c"") != 0 {
                    return mod_ann
                }
            }
            val mod_cval: ref u8 = cg_const_val(ctx, mod_key)
            if str.raw_cmp(mod_cval, c"") != 0 {
                if raw_starts_with(mod_cval, c"d_") {
                    return c"f64"
                }
                if raw_starts_with(mod_cval, c"s_") {
                    return c"f32"
                }
                return c"i64"
            }
        }
        return c""
    }

    if k == parser.NK_CALL {
        val callee: ref parser.Node = parser.call_callee(expr)
        val ret_expr: ref parser.Node = cg_infer_call_ret_ty(ctx, expr)
        if ret_expr != none {
            return type_expr_to_annotation(ctx, ret_expr)
        }
        if callee != none && callee.kind == parser.NK_IDENT {
            val callee_name: ref u8 = parser.node_str_raw(callee.d0)
            val ext_ret_expr: ref void = cg_lookup_ext_ret(ctx, callee_name)
            if ext_ret_expr != none {
                return type_expr_to_annotation(ctx, ext_ret_expr as ref parser.Node)
            }
            val ret_expr2: ref parser.Node = cg_lookup_fn_ret_type_expr(ctx, callee_name)
            if ret_expr2 != none {
                val ann = type_expr_to_annotation(ctx, ret_expr2)
                return ann
            }
            val resolved_name: ref u8 = cg_resolve_fn_name(ctx, callee_name)
            if resolved_name != none {
                val ret_expr3: ref void = cg_lookup_fn_ret(ctx, resolved_name)
                if ret_expr3 != none {
                    return type_expr_to_annotation(ctx, ret_expr3 as ref parser.Node)
                }
            }
        }
    }

    if k == parser.NK_BUILTIN {
        val bname: ref u8 = parser.node_str_raw(expr.d0)
        if str.raw_cmp(bname, c"call") == 0 {
            val bargs: ref void = expr.d1 as ref void
            if bargs != none && @len(bargs as list[ref parser.Node]) as i64 > 0 {
                val fn_opt = @get(bargs as list[ref parser.Node], 0)
                if fn_opt is some fn_expr {
                    val fn_sig: ref parser.Node = cg_lookup_fnptr_sig(
                        ctx,
                        fn_expr as ref parser.Node
                    )
                    if fn_sig != none {
                        return type_expr_to_annotation(ctx, fn_sig.d1 as ref parser.Node)
                    }
                }
            }
        }
        if str.raw_cmp(bname, c"ptradd") == 0 {
            val ptr_args: ref void = expr.d1 as ref void
            if ptr_args != none && @len(ptr_args as list[ref parser.Node]) as i64 > 0 {
                val base_opt = @get(ptr_args as list[ref parser.Node], 0 as usize)
                if base_opt is some base_ptr {
                    return infer_type_annotation(ctx, base_ptr as ref parser.Node)
                }
            }
        }

    }

    if k == parser.NK_TRUST {
        val trust_inner: ref parser.Node = expr.d0 as ref parser.Node
        if trust_inner != none {
            return infer_type_annotation(ctx, trust_inner)
        }
        return c""
    }

    if k == parser.NK_UNOP {
        return infer_type_annotation(ctx, parser.unop_inner(expr))
    }

    if k == parser.NK_DEREF {
        val inner_expr: ref parser.Node = expr.d0 as ref parser.Node
        val inner_ann: ref u8 = infer_type_annotation(ctx, inner_expr)
        if raw_starts_with(inner_ann, c"mut ref ") {
            return @ptradd(inner_ann, 8) as ref u8
        }
        if raw_starts_with(inner_ann, c"ref ") {
            return @ptradd(inner_ann, 4) as ref u8
        }
        return inner_ann
    }

    if k == parser.NK_TRY {
        val try_inner: ref parser.Node = expr.d0 as ref parser.Node
        if try_inner != none {
            val inner_ann: ref u8 = infer_type_annotation(ctx, try_inner)
            if str.raw_cmp(inner_ann, c"") != 0 {
                val ok_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                val err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                parse_result_types(inner_ann, ok_buf, err_buf)
                if @load8(ok_buf) != 0 as u8 {
                    return ok_buf
                }
            }
        }
        return c""
    }

    if k == parser.NK_MATCH_OPT {
        val some_body: ref parser.Node = parser.match_opt_some_body(expr)
        if some_body != none {
            val some_stmts: ref void = some_body.d0 as ref void
            val t: ref u8 = infer_stmts_result_type(ctx, some_stmts)
            if str.raw_cmp(t, c"") != 0 {
                return t
            }
        }
        val none_body: ref parser.Node = parser.match_opt_none_body(expr)
        if none_body != none {
            val none_stmts: ref void = none_body.d0 as ref void
            val t2: ref u8 = infer_stmts_result_type(ctx, none_stmts)
            if str.raw_cmp(t2, c"") != 0 {
                return t2
            }
        }
        return c""
    }

    if k == parser.NK_BINOP {
        val lhs: ref parser.Node = parser.binop_left(expr)
        val rhs: ref parser.Node = parser.binop_right(expr)
        val lhs_ann: ref u8 = infer_type_annotation(ctx, lhs)
        val rhs_ann: ref u8 = infer_type_annotation(ctx, rhs)

        if str.raw_cmp(lhs_ann, c"f64") == 0 || str.raw_cmp(rhs_ann, c"f64") == 0 {
            return c"f64"
        }
        if str.raw_cmp(lhs_ann, c"f32") == 0 || str.raw_cmp(rhs_ann, c"f32") == 0 {
            return c"f32"
        }

        val op: i64 = parser.binop_op(expr)
        if op == parser.OP_EQ || op == parser.OP_NE || op == parser.OP_LT ||
        op == parser.OP_GT || op == parser.OP_LE || op == parser.OP_GE {
            return c"bool"
        }

        if op == parser.OP_AND || op == parser.OP_OR {
            return c"bool"
        }

        return c"i64"
    }

    if k == parser.NK_BUILTIN {
        val bname_ann: ref u8 = parser.node_str_raw(expr.d0)
        if str.raw_cmp(bname_ann, c"get") == 0 || str.raw_cmp(bname_ann, c"getref") == 0
        || str.raw_cmp(bname_ann, c"getmut") == 0 {
            val bargs_ann: ref void = expr.d1 as ref void
            if bargs_ann != none {
                val blen: i64 = @len(bargs_ann as list[ref parser.Node]) as i64
                val a0_opt = @get(bargs_ann as list[ref parser.Node], 0 as usize)
                if a0_opt is some a0 {
                    val base_ann: ref u8 = infer_type_annotation(ctx, a0 as ref parser.Node)
                    val elem_t: mut ref u8 = c""
                    if raw_starts_with(base_ann, c"list[") {
                        val la_len: i64 = str.len_raw(base_ann)
                        elem_t = str.substr(base_ann, 5, la_len - 6)
                    } elif raw_starts_with(base_ann, c"[") && blen > 1 {
                        elem_t = cg_ann_after_get_indices(base_ann, blen - 1)
                    }
                    if str.raw_cmp(elem_t, c"") != 0 {
                        val opt_a: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            512 as usize
                        ) as ref u8
                        if str.raw_cmp(bname_ann, c"getref") == 0 {
                            @snprintf(opt_a, 512, "option[ref {s}]", {elem_t})
                        } elif str.raw_cmp(bname_ann, c"getmut") == 0 {
                            @snprintf(opt_a, 512, "option[ref mut {s}]", {elem_t})
                        } else {
                            @snprintf(opt_a, 512, "option[{s}]", {elem_t})
                        }
                        return opt_a
                    }
                }
            }
        }
        if str.raw_cmp(bname_ann, c"bitcast") == 0 {
            val bargs_ann2: ref void = expr.d1 as ref void
            if bargs_ann2 != none {
                val a0_opt2 = @get(bargs_ann2 as list[ref parser.Node], 0 as usize)
                if a0_opt2 is some a0_2 {
                    val target_node: ref parser.Node = a0_2 as ref parser.Node
                    if target_node != none && target_node.kind == parser.TY_NAMED {
                        return parser.node_str_raw(target_node.d0)
                    }
                }
            }
        }
    }

    return c""
}

fn ann_is_string_type(ann: ref u8, name: ref u8) bool = trust {
    if ann == none {
        return false
    }
    val alen: i64 = str.len_raw(ann)
    val nlen: i64 = str.len_raw(name)
    if alen == nlen {
        return str.raw_cmp(ann, name) == 0
    }
    if alen > nlen && str.raw_ends_with(ann, name) {
        return @load8(@ptradd(ann, alen - nlen - 1)) == 46
    }
    return false
}

fn gen_string_pack_value(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    val raw: ref u8 = gen_expr(ctx, node)
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        128 as usize
    ) as ref u8
    @snprintf(buf, 128, "    %%t{lld} =l loadl {s}\n", {tmp, raw})
    emit(ctx, buf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        16 as usize
    ) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn gen_string_variadic_arg(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    val value: ref u8 = gen_string_pack_value(ctx, node)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        32 as usize
    ) as ref u8
    @snprintf(res, 32, "l {s}", {value})
    return res
}

fn gen_variadic_arg(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    val ann: ref u8 = infer_type_annotation(ctx, node)
    if ann_is_string_type(ann, c"String") || ann_is_string_type(ann, c"StringView") {
        return gen_string_variadic_arg(ctx, node)
    }

    val qtype: mut ref u8 = expr_qbe_type(ctx, node)
    val value: mut ref u8 = gen_expr(ctx, node)

    if str.raw_cmp(qtype, c"w") == 0 {
        val ann: ref u8 = infer_type_annotation(ctx, node)
        val instr: mut ref u8 = c"extsw"
        if str.raw_cmp(ann, c"u8") == 0
        || str.raw_cmp(ann, c"u16") == 0
        || str.raw_cmp(ann, c"u32") == 0
        || str.raw_cmp(ann, c"bool") == 0
        || str.raw_cmp(ann, c"u8") == 0 {
            instr = c"extuw"
        }

        val promoted_tmp: i64 = fresh_tmp(ctx)
        val promoted_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(promoted_buf, 128, "    %%t{lld} =l {s} {s}\n", {promoted_tmp, instr, value})
        emit(
            ctx,
            promoted_buf
        )
        val promoted_val: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(promoted_val, 16, "%%t{lld}", {promoted_tmp})
        value = promoted_val
        qtype = c"l"
    } elif str.raw_cmp(qtype, c"s") == 0 {
        val promoted_tmp2: i64 = fresh_tmp(ctx)
        val promoted_buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(promoted_buf2, 128, "    %%t{lld} =d exts {s}\n", {promoted_tmp2, value})
        emit(
            ctx,
            promoted_buf2
        )
        val promoted_val2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(promoted_val2, 16, "%%t{lld}", {promoted_tmp2})
        value = promoted_val2
        qtype = c"d"
    }

    val arg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(arg_buf, 64, "{s} {s}", {qtype, value})
    return arg_buf
}

fn cg_param_is_argspack(params: ref void, idx: i64) bool = trust {
    if params == none {
        return false
    }
    val plen: i64 = @len(params as list[ref parser.Node]) as i64
    if idx < 0 || idx >= plen {
        return false
    }
    val p_opt = @get(params as list[ref parser.Node], idx as usize)
    if p_opt is some p {
        val pty: ref parser.Node = (p as ref parser.Node).d1 as ref parser.Node
        return pty != none && pty.kind == parser.TY_ARGSPACK
    }
    return false
}

fn cg_current_fn_param_is_argspack(ctx: mut ref CgCtx, name: ref u8) bool = trust {
    if name == none {
        return false
    }
    val params: ref void = cg_lookup_fn_params(ctx, ctx.fn_name)
    if params == none {
        return false
    }
    val plen: i64 = @len(params as list[ref parser.Node]) as i64
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        val p_opt = @get(params as list[ref parser.Node], pi as usize)
        if p_opt is some p {
            val pnode: ref parser.Node = p as ref parser.Node
            if str.raw_cmp(parser.node_str_raw(pnode.d0), name) == 0 {
                val pty: ref parser.Node = pnode.d1 as ref parser.Node
                return pty != none && pty.kind == parser.TY_ARGSPACK
            }
        }
        pi++
    }
    return false
}

fn cg_pack_value_to_l(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    val qt: ref u8 = expr_qbe_type(ctx, node)
    val value: ref u8 = gen_expr(ctx, node)
    if str.raw_cmp(qt, c"w") == 0 {
        val t: i64 = fresh_tmp(ctx)
        val b: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(b, 128, "    %%t{lld} =l extsw {s}\n", {t, value})
        emit(
            ctx,
            b
        )
        val r: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(r, 16, "%%t{lld}", {t})
        return r
    }
    if str.raw_cmp(qt, c"s") == 0 || str.raw_cmp(qt, c"d") == 0 {
        val t: i64 = fresh_tmp(ctx)
        val b: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(b, 128, "    %%t{lld} =l cast {s}\n", {t, value})
        emit(
            ctx,
            b
        )
        val r: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(r, 16, "%%t{lld}", {t})
        return r
    }
    return value
}

fn cg_gen_argspack_pack(
    ctx: mut ref CgCtx,
    elems: list[ref parser.Node]
) ref u8 = trust {
    val arr: i64 = fresh_tmp(ctx)
    val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(abuf, 128, "    %%t{lld} =l alloc8 128\n", {arr})
    emit(ctx, abuf)
    val n: i64 = @len(elems) as i64
    val i: mut i64 = 0
    for {
        if i >= 16 {
            break
        }
        val value: mut ref u8 = c"0"
        if i < n {
            val e_opt = @get(elems, i as usize)
            if e_opt is some e {
                value = cg_pack_value_to_l(ctx, e as ref parser.Node)
            }
        }
        val ptr: i64 = fresh_tmp(ctx)
        val b: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 160 as usize) as ref u8
        @snprintf(
            b,
            160,
            "    %%t{lld} =l add %%t{lld}, {lld}\n    storel {s}, %%t{lld}\n",
            {ptr, arr, i * 8, value, ptr}
        )
        emit(ctx, b)
        i++
    }
    val r: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(r, 32, "%%t{lld}", {arr})
    return r
}

fn cg_expand_argspack_pack_args(
    ctx: mut ref CgCtx,
    pack_val: ref u8
) ref u8 = trust {
    val sb: ref void = str.StringBuilder.new()
    val i: mut i64 = 0
    for {
        if i >= 16 {
            break
        }
        val ptr: i64 = fresh_tmp(ctx)
        val val_tmp: i64 = fresh_tmp(ctx)
        val b: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 160 as usize) as ref u8
        @snprintf(
            b,
            160,
            "    %%t{lld} =l add {s}, {lld}\n    %%t{lld} =l loadl %%t{lld}\n",
            {ptr, pack_val, i * 8, val_tmp, ptr}
        )
        emit(
            ctx,
            b
        )
        val ab: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(ab, 64, ", l %%t{lld}", {val_tmp})
        str.StringBuilder.append_cstr(sb, ab)
        i++
    }
    val built: ref void = str.StringBuilder.build(sb)
    val out: ref u8 = str.cstr(built)
    str.StringBuilder.free(sb)
    @free(built)
    return out
}

/// Check if a raw u8 pointer starts with a raw prefix.
fn raw_starts_with(src: ref u8, prefix: ref u8) bool = trust {
    val slen: i64 = str.len_raw(src)
    val plen: i64 = str.len_raw(prefix)
    if plen > slen {
        return false
    }
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        if @load8(@ptradd(src, pi)) != @load8(@ptradd(prefix, pi)) {
            return false
        }
        pi++
    }
    return true
}

/// Extract the inner type from a "option[T]" annotation str. Returns "" if not an option.
fn parse_option_inner(ann: ref u8) ref u8 = trust {
    if !raw_starts_with(ann, c"option[") {
        return c""
    }
    val alen: i64 = str.len_raw(ann)
    if @load8(@ptradd(ann, alen - 1)) != 93 {
        return c""
    }  // not ']'
    val inner = str.substr(ann, 7, alen - 8)
    return inner
}

/// Extract the ok and err types from a "result[T, E]" annotation str. Returns 0 for each part if not a result.
/// Caller provides two 256-byte buffers for the results.
fn parse_result_types(ann: ref u8, ok_buf: ref u8, err_buf: ref u8) void = trust {
    if !raw_starts_with(ann, c"result[") {
        @store8(ok_buf, 0)
        @store8(err_buf, 0)
        return
    }
    val alen: i64 = str.len_raw(ann)
    if @load8(@ptradd(ann, alen - 1)) != 93 {  // not ']'
        @store8(ok_buf, 0)
        @store8(err_buf, 0)
        return
    }
    val inner_start: i64 = 7
    val inner_end: i64 = alen - 1
    val depth: mut i64 = 0
    val split_pos: mut i64 = -1
    val i: mut i64 = inner_start
    for {
        if i >= inner_end {
            break
        }
        val c: i64 = @load8(@ptradd(ann, i))
        if c == 91 {
            depth++
        }       // '['
        elif c == 93 {
            depth--
        }     // ']'
        elif c == 44 && depth == 0 {            // ','
            split_pos = i
            break
        }
        i++
    }
    if split_pos < 0 {
        @store8(ok_buf, 0)
        @store8(err_buf, 0)
        return
    }
    val ok_len: i64 = split_pos - inner_start
    val err_len: i64 = inner_end - split_pos - 1
    val j: mut i64 = 0
    for {
        if j >= ok_len {
            break
        }
        @store8(@ptradd(ok_buf, j), @load8(@ptradd(ann, inner_start + j)))
        j++
    }
    @store8(@ptradd(ok_buf, ok_len), 0)
    val err_start: i64 = split_pos + 1
    val k: mut i64 = 0
    for {
        if k >= err_len {
            break
        }
        @store8(@ptradd(err_buf, k), @load8(@ptradd(ann, err_start + k)))
        k++
    }
    @store8(@ptradd(err_buf, err_len), 0)
}

/// Convert a TypeExpr AST node to its annotation str.
/// Handles all type kinds: NAMED, REF, MUT, RESULT, OPTION, LIST, SLICE, FIXED_ARR, FNPTR.
fn type_expr_to_annotation(ctx: mut ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c""
    }
    val k: i64 = ty.kind

    if k == parser.TY_NAMED {
        return parser.node_str_raw(ty.d0)
    }
    if k == parser.TY_REF {
        val inner = type_expr_to_annotation(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "ref {s}", {inner})
        return buf
    }
    if k == parser.TY_MUT {
        return type_expr_to_annotation(ctx, ty.d0 as ref parser.Node)
    }

    if k == parser.TY_RESULT {
        val ok_ty = ty.d0 as ref parser.Node
        val err_ty = ty.d1 as ref parser.Node
        val ok_s = type_expr_to_annotation(ctx, ok_ty)
        val err_s = type_expr_to_annotation(ctx, err_ty)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "result[{s}, {s}]", {ok_s, err_s})
        return buf
    }

    if k == parser.TY_OPTION {
        val inner = type_expr_to_annotation(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "option[{s}]", {inner})
        return buf
    }

    if k == parser.TY_LIST {
        val inner = type_expr_to_annotation(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "list[{s}]", {inner})
        return buf
    }

    if k == parser.TY_SLICE {
        val inner = type_expr_to_annotation(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "slice[{s}]", {inner})
        return buf
    }

    if k == parser.TY_FIXED_ARR {
        val count_text: ref u8 = cg_fixed_arr_size_text(ctx, ty)
        val inner = type_expr_to_annotation(ctx, ty.d1 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "[{s}]{s}", {count_text, inner})
        return buf
    }

    if k == parser.TY_FNPTR {
        val sb: ref void = str.StringBuilder.new()
        str.StringBuilder.append_cstr(sb, c"fn(")
        val params: ref void = ty.d0 as ref void
        if params != none {
            val plen: i64 = @len(params as list[ref parser.Node]) as i64
            val pi: mut i64 = 0
            for {
                if pi >= plen {
                    break
                }
                val p_opt = @get(params as list[ref parser.Node], pi as usize)
                if p_opt is some p {
                    if pi > 0 {
                        str.StringBuilder.append_cstr(sb, c", ")
                    }
                    str.StringBuilder.append_cstr(
                        sb,
                        type_expr_to_annotation(ctx, p as ref parser.Node)
                    )
                }
                pi++
            }
        }
        str.StringBuilder.append_cstr(sb, c") ")
        str.StringBuilder.append_cstr(sb, type_expr_to_annotation(ctx, ty.d1 as ref parser.Node))
        val built: ref void = str.StringBuilder.build(sb)
        val out: ref u8 = str.cstr(built)
        str.StringBuilder.free(sb)
        @free(built)
        return out
    }

    return c""
}

fn cg_parse_type_annotation(ctx: ref CgCtx, ann: ref u8) ref parser.Node = {
    if ann == none || str.raw_cmp(ann, c"") == 0 {
        return none
    }
    val toks_res = trust lexer.tokenize_with(ctx.arena, ann)
    match toks_res {
        err _ => {
            return none
        }
        ok toks => {
            val p: mut ref parser.Parser = trust parser.parser_new(
                ctx.arena,
                toks,
                c"<codegen-type>"
            )
            val ty_res = trust parser.parse_type(p)
            match ty_res {
                ok ty => {
                    return ty
                }
                err _ => {
                    return none
                }
            }
        }
    }
}

fn cg_make_fnptr_type(
    ctx: ref CgCtx,
    params: ref void,
    ret_ty: ref parser.Node
) ref parser.Node = trust {
    if ret_ty == none {
        return none
    }
    val nfp: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_FNPTR, 0)
    parser.node_store_slot[list[ref parser.Node]](@addr(nfp.d0), params as list[ref parser.Node])
    parser.node_store_slot[ref parser.Node](@addr(nfp.d1), ret_ty)
    return nfp
}

fn cg_lookup_fnptr_sig(ctx: mut ref CgCtx, expr: ref parser.Node) ref parser.Node = trust {
    if expr == none {
        return none
    }
    if expr.kind == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val local_ann: ref u8 = cg_local_type(ctx, name)
        if str.raw_cmp(local_ann, c"") != 0 {
            val local_ty: ref parser.Node = cg_concrete_ty(
                ctx,
                cg_parse_type_annotation(ctx, local_ann)
            )
            if local_ty != none && local_ty.kind == parser.TY_FNPTR {
                return local_ty
            }
        }

        val resolved_name: ref u8 = cg_resolve_fn_name(ctx, name)
        val lookup_name: mut ref u8 = name
        if resolved_name != none {
            lookup_name = resolved_name
        }
        val params: ref void = cg_lookup_fn_params(ctx, lookup_name)
        val ret_ty: ref parser.Node = cg_lookup_fn_ret_type_expr(ctx, lookup_name)
        if params != none && ret_ty != none {
            val param_tys: mut list[ref parser.Node] = mem.new[ref parser.Node]()
            val plen: i64 = @len(params as list[ref void]) as i64
            val pi: mut i64 = 0
            for {
                if pi >= plen {
                    break
                }
                val p_opt = @get(params as list[ref void], pi as usize)
                if p_opt is some p {
                    val pnode: ref parser.Node = p as ref parser.Node
                    @append(param_tys, cg_concrete_ty(ctx, pnode.d1 as ref parser.Node))
                }
                pi++
            }
            return cg_make_fnptr_type(ctx, param_tys, ret_ty)
        }
    }
    if expr.kind == parser.NK_CAST {
        val cast_ty: ref parser.Node = cg_concrete_ty(ctx, expr.d1 as ref parser.Node)
        if cast_ty != none && cast_ty.kind == parser.TY_FNPTR {
            return cast_ty
        }
    }
    return none
}

/// Unwrap a type node to get the base named type, stripping ref/mut wrappers.
/// Returns "" if not a named type. Kept for backward compatibility.
fn unwrap_type_name(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c""
    }
    val k: i64 = ty.kind
    if k == parser.TY_REF {
        return unwrap_type_name(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_MUT {
        return unwrap_type_name(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        return parser.node_str_raw(ty.d0)
    }
    return c""
}

/// Check if a type is a tagged union. Returns the union name if it is, "" otherwise.
fn is_union_type(ctx: mut ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c""
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        val name: ref u8 = parser.node_str_raw(ty.d0)
        val union_vars: ref void = cg_lookup_union_suffix(ctx, name)

        if union_vars != none {
            return name
        }

        val names: ref void = cg_unames(ctx)
        val nlen: i64 = @len(names as list[ref u8]) as i64
        val tlen: i64 = str.len_raw(name)
        val suffix_len: i64 = tlen + 2
        val ni: mut i64 = 0

        for {
            if ni >= nlen {
                break
            }
            val n_opt = @get(names as list[ref u8], ni as usize)
            if n_opt is some n {
                val candidate: ref u8 = n as ref u8
                val clen: i64 = str.len_raw(candidate)
                if clen > suffix_len {
                    val tail: ref u8 = @ptradd(candidate, clen - suffix_len) as ref u8
                    val c1: u8 = @load8(@ptradd(tail, 0))
                    val c2: u8 = @load8(@ptradd(tail, 1))
                    if c1 == 95 && c2 == 95 {
                        val rest: ref u8 = @ptradd(tail, 2) as ref u8
                        if str.raw_cmp(rest, name) == 0 {
                            return name
                        }
                    }
                }
            }
            ni++
        }
    }
    return c""
}

fn type_size(ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 8
    }
    val k: i64 = ty.kind
    if k == parser.TY_VOID {
        return 0
    }
    if k == parser.TY_MUT {
        return type_size(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_REF {
        return 8
    }
    if k == parser.TY_LIST {
        return 8
    }
    if k == parser.TY_OPTION {
        return 8
    }
    if k == parser.TY_RESULT {
        return 16
    }
    if k == parser.TY_SLICE {
        return 16
    }
    if k == parser.TY_FNPTR {
        return 8
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(ty.d0)
        if str.raw_cmp(tname, c"i8") == 0 {
            return 1
        }
        if str.raw_cmp(tname, c"u8") == 0 {
            return 1
        }
        if str.raw_cmp(tname, c"u8") == 0 {
            return 1
        }
        if str.raw_cmp(tname, c"i16") == 0 {
            return 2
        }
        if str.raw_cmp(tname, c"u16") == 0 {
            return 2
        }
        if str.raw_cmp(tname, c"i32") == 0 {
            return 4
        }
        if str.raw_cmp(tname, c"u32") == 0 {
            return 4
        }
        if str.raw_cmp(tname, c"f32") == 0 {
            return 4
        }
        if str.raw_cmp(tname, c"i64") == 0 {
            return 8
        }
        if str.raw_cmp(tname, c"u64") == 0 {
            return 8
        }
        if str.raw_cmp(tname, c"f64") == 0 {
            return 8
        }
        if str.raw_cmp(tname, c"bool") == 0 {
            return 4
        }
        if str.raw_cmp(tname, c"isize") == 0 {
            return 8
        }
        if str.raw_cmp(tname, c"usize") == 0 {
            return 8
        }
        if str.raw_cmp(tname, c"void") == 0 {
            return 0
        }
        return 8
    }
    if k == parser.TY_FIXED_ARR {
        val count: i64 = parser.fixed_arr_size(ty)
        val elem_size: i64 = type_size(ty.d1 as ref parser.Node)
        return count * elem_size
    }
    if k == parser.TY_LIST {
        return 8
    }
    return 8
}

fn align_to(n: i64, align: i64) i64 = trust {
    if align <= 1 {
        return n
    }
    return (n + align - 1) / align * align
}

fn rewrite_fmt(ctx: ref CgCtx, s: ref u8) ref u8 = trust {
    val slen: i64 = str.len_raw(s)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (slen * 2 + 1) as usize
    ) as ref u8
    val oi: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= slen {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))

        if c == 92 { // '\\'
            if i + 1 < slen {
                val next: u8 = @load8(@ptradd(s, i + 1))
                if next == 123 || next == 125 { // '{' or '}'
                    @store8(@ptradd(out, oi), next)
                    oi++
                    i += 2
                } else {
                    @store8(@ptradd(out, oi), c)
                    oi++
                    i++
                }
            } else {
                @store8(@ptradd(out, oi), c)
                oi++
                i++
            }
        } elif c == 123 { // '{'
            val j: mut i64 = i + 1
            val found: mut bool = false
            for {
                if j >= slen {
                    break
                }
                val ic: u8 = @load8(@ptradd(s, j))
                if ic == 125 {
                    found = true
                    break
                } // '}'
                j++
            }
            if found {
                @store8(@ptradd(out, oi), 37) // '%'
                oi++
                val k: mut i64 = i + 1
                for {
                    if k >= j {
                        break
                    }
                    val sc: u8 = @load8(@ptradd(s, k))
                    @store8(@ptradd(out, oi), sc)
                    oi++
                    k++
                }
                i = j + 1
            } else {
                @store8(@ptradd(out, oi), c)
                oi++
                i++
            }
        } else {
            @store8(@ptradd(out, oi), c)
            oi++
            i++
        }
    }
    @store8(@ptradd(out, oi), 0)
    return out
}

/// Intern a string literal without format rewriting, return its global label index.
fn env_key_literal_node(node: ref parser.Node) ref parser.Node = trust {
    if node == none {
        return none
    }
    if node.kind == parser.NK_STR_LIT {
        return node
    }
    if node.kind != parser.NK_CALL {
        return none
    }
    val callee: ref parser.Node = parser.call_callee(node)
    if callee == none || callee.kind != parser.NK_FIELD {
        return none
    }
    if str.raw_cmp(parser.field_name_raw(callee), c"view_cstr") != 0 {
        return none
    }
    val call_args: ref void = parser.call_args(node) as ref void
    if call_args == none || @len(call_args as list[ref parser.Node]) == 0 {
        return none
    }
    val a0_opt = @get(call_args as list[ref parser.Node], 0 as usize)
    if a0_opt is some a0_val {
        val a0: ref parser.Node = a0_val as ref parser.Node
        if a0 != none && a0.kind == parser.NK_STR_LIT {
            return a0
        }
    }
    return none
}

fn intern_string(ctx: mut ref CgCtx, s: str.StringView) i64 = trust {
    val strs: ref void = cg_strs(ctx)
    val len: i64 = @len(strs) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val s_opt = @get(strs, i as usize)
        if s_opt is some existing {
            val ev: str.StringView = existing as str.StringView
            if str.view_eql(ev, s) {
                return i
            }
        }
        i++
    }
    val scopy_ptr: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (s.len + 1) as usize
    ) as ref u8
    if s.len > 0 {
        @memcpy(scopy_ptr, s.ptr as ref void, s.len as usize)
    }
    @store8(@ptradd(scopy_ptr, s.len), 0)
    val scopy: str.StringView = str.view(scopy_ptr, s.len)
    @append(strs, scopy)
    val idx: i64 = cg_str_cnt(ctx)
    cg_set_str_cnt(ctx, idx + 1)
    return idx
}

/// Raw-pointer compatibility wrapper for intern_string.
fn intern_string_raw(ctx: mut ref CgCtx, s: ref u8) i64 = trust {
    return intern_string(ctx, str.view_cstr(s))
}

/// Intern a `StringView` literal, returning the index of its static
/// `{ ptr, len }` data object.
fn intern_string_view(ctx: mut ref CgCtx, s: str.StringView) i64 = trust {
    val sidx: i64 = intern_string(ctx, s)
    val n: i64 = @len(ctx.sv_stridx) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val idx_opt = @get(ctx.sv_stridx, i as usize)
        val len_opt = @get(ctx.sv_len, i as usize)
        if idx_opt is some idx {
            if len_opt is some l {
                if (idx as i64) == sidx && (l as i64) == s.len {
                    return i
                }
            }
        }
        i++
    }
    @append(ctx.sv_stridx, sidx)
    @append(ctx.sv_len, s.len)
    return n
}

/// Intern a format string with rewriting ({d} → %d), return its global label index.
fn intern_format_string(ctx: mut ref CgCtx, s: ref u8) i64 = trust {
    val rewritten: ref u8 = rewrite_fmt(ctx, s)
    return intern_string(ctx, str.view_cstr(rewritten))
}

/// Emit all interned string data sections.
fn emit_string_data(ctx: mut ref CgCtx) void = trust {
    val strs: ref void = cg_strs(ctx)
    val len: i64 = @len(strs) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val s_opt = @get(strs, i as usize)
        if s_opt is some s_val {
            val s: str.StringView = s_val as str.StringView
            val str_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(str_buf, 64, "data $__str{lld} = \\{ b \"", {i})
            emit(ctx, str_buf) // emit each byte, escaping special chars
            val j: mut i64 = 0
            for {
                if j >= s.len {
                    break
                }
                val c: u8 = @load8(@ptradd(s.ptr, j))
                if c == 10 {
                    emit(ctx, c"\\n")
                } elif c == 9 {
                    emit(ctx, c"\\t")
                } elif c == 34 {
                    emit(ctx, c"\\\"")
                } elif c == 92 {
                    emit(ctx, c"\\\\")
                } else {
                    val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        2 as usize
                    ) as ref u8
                    @store8(cb, c)
                    @store8(@ptradd(cb, 1), 0)
                    emit(ctx, cb)
                }
                j++
            }
            emitln(ctx, c"\", b 0 }")
        }
        i++
    }

    val vlen: i64 = @len(ctx.sv_stridx) as i64
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val idx_opt = @get(ctx.sv_stridx, vi as usize)
        val len_opt = @get(ctx.sv_len, vi as usize)
        if idx_opt is some idx {
            if len_opt is some l {
                val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(vbuf, 64, "data $__sv{lld} = \{ l $__str{lld}, l {lld} \}\n",
                    {vi, idx as i64, l as i64})
                emit(ctx, vbuf)
            }
        }
        vi++
    }
}

/// Generate an integer literal with a specific QBE type (w or l).
fn gen_int_lit_as(ctx: mut ref CgCtx, text: ref u8, qbe_type: ref u8) ref u8 = trust {
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    val emit_text: mut ref u8 = text

    if @load8(text) == 48 && @load8(@ptradd(text, 1)) == 120 {
        val hex_start: ref u8 = @ptradd(text, 2) as ref u8
        val val_: mut i64 = 0
        val hi: mut i64 = 0
        for {
            val hc: i64 = @load8(@ptradd(hex_start, hi)) as i64
            if hc == 0 {
                break
            }
            val digit: mut i64 = hc - 48
            if hc >= 97 {
                digit = hc - 87
            } elif hc >= 65 {
                digit = hc - 55
            }
            val_ = val_ * 16 + digit
            hi++
        }
        val dec_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(dec_buf, 32, "{lld}", {val_})
        emit_text = dec_buf
    }
    @snprintf(buf, 64, "    %%t{lld} ={s} copy {s}\n", {tmp, qbe_type, emit_text})
    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn normalize_static_int_text(ctx: ref CgCtx, text: ref u8) ref u8 = trust {
    if text == none {
        return c"0"
    }
    val start: mut ref u8 = text
    val sign: mut i64 = 1
    val sc_sign: i64 = @load8(@ptradd(start, 0)) as i64
    if sc_sign == 45 {
        sign = -1
        start = @ptradd(start, 1) as ref u8
    }
    val fc: i64 = @load8(@ptradd(start, 0)) as i64
    if fc == 48 {
        val sc: i64 = @load8(@ptradd(start, 1)) as i64
        if sc == 120 || sc == 88 {
            val hex_start: ref u8 = @ptradd(start, 2) as ref u8
            val val_: mut i64 = 0
            val hi: mut i64 = 0
            for {
                val hc: i64 = @load8(@ptradd(hex_start, hi)) as i64
                if hc == 0 {
                    break
                }
                val digit: mut i64 = hc - 48
                if hc >= 97 {
                    digit = hc - 87
                } elif hc >= 65 {
                    digit = hc - 55
                }
                val_ = val_ * 16 + digit
                hi++
            }
            if sign < 0 {
                val_ = 0 - val_
            }
            val dec_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(dec_buf, 32, "{lld}", {val_})
            return dec_buf
        }
    }
    return text
}

fn static_global_init_value(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c"0"
    }
    val k: i64 = expr.kind
    if k == parser.NK_INT_LIT {
        return normalize_static_int_text(ctx, parser.int_lit_text_raw(expr))
    }
    if k == parser.NK_BOOL {
        val bv: i64 = expr.d0 as i64
        if bv != 0 {
            return c"1"
        }
        return c"0"
    }
    if k == parser.NK_CHAR_LIT {
        val cv: i64 = expr.d0 as i64
        val cv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(cv_buf, 32, "{lld}", {cv})
        return cv_buf
    }
    if k == parser.NK_IDENT {
        val cval: ref u8 = cg_const_val(ctx, parser.node_str_raw(expr.d0))
        if str.raw_cmp(cval, c"") != 0 {
            return normalize_static_int_text(ctx, cval)
        }
    }
    if k == parser.NK_UNOP {
        val uop: i64 = parser.unop_op(expr)
        val inner: ref parser.Node = parser.unop_inner(expr)
        if uop == parser.UOP_NEG && inner != none {
            if inner.kind == parser.NK_INT_LIT {
                val inner_val: ref u8 = normalize_static_int_text(
                    ctx,
                    parser.int_lit_text_raw(inner)
                )
                val neg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(neg_buf, 64, "-{s}", {inner_val})
                return neg_buf
            }
        }
    }
    if k == parser.NK_STR_LIT {
        val s: str.StringView = parser.str_lit_text(expr)
        val sbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        if parser.str_lit_is_cstr(expr) {
            val idx: i64 = intern_string(ctx, s)
            @snprintf(sbuf, 64, "$__str{lld}", {idx})
        } else {
            val idx: i64 = intern_string_view(ctx, s)
            @snprintf(sbuf, 64, "$__sv{lld}", {idx})
        }
        return sbuf
    }
    return c""
}

fn global_fixed_arr_type_qbe(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"l"
    }
    val k: i64 = ty.kind
    if k == parser.TY_MUT {
        return global_fixed_arr_type_qbe(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_FIXED_ARR {
        return global_fixed_arr_type_qbe(ty.d1 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        val name: ref u8 = parser.node_str_raw(ty.d0)
        if str.raw_cmp(
            name,
            c"i8"
        ) == 0 || str.raw_cmp(name, c"u8") == 0 || str.raw_cmp(name, c"u8") == 0 {
            return c"b"
        }
        if str.raw_cmp(name, c"i16") == 0 || str.raw_cmp(name, c"u16") == 0 {
            return c"h"
        }
        if str.raw_cmp(
            name,
            c"i32"
        ) == 0 || str.raw_cmp(name, c"u32") == 0 || str.raw_cmp(name, c"bool") == 0 {
            return c"w"
        }
        if str.raw_cmp(name, c"f32") == 0 {
            return c"s"
        }
        if str.raw_cmp(name, c"f64") == 0 {
            return c"d"
        }
        return c"l"
    }
    return c"l"
}

fn static_global_init_value_typed(
    ctx: mut ref CgCtx,
    ty: ref parser.Node,
    expr: ref parser.Node
) ref u8 = trust {
    if expr != none && ty != none {
        val tk: i64 = ty.kind
        if tk == parser.TY_MUT {
            return static_global_init_value_typed(ctx, ty.d0 as ref parser.Node, expr)
        }
        if tk == parser.TY_NAMED {
            val tname: ref u8 = parser.node_str_raw(ty.d0)
            if expr.kind == parser.NK_FLOAT_LIT {
                val ftext: ref u8 = parser.float_lit_text_raw(expr)
                val fval: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                if str.raw_cmp(tname, c"f32") == 0 {
                    @snprintf(fval, 128, "s_{s}", {ftext})
                    return fval
                }
                if str.raw_cmp(tname, c"f64") == 0 {
                    @snprintf(fval, 128, "d_{s}", {ftext})
                    return fval
                }
            }
            if expr.kind == parser.NK_UNOP {
                val uop: i64 = parser.unop_op(expr)
                val inner: ref parser.Node = parser.unop_inner(expr)
                if uop == parser.UOP_NEG && inner != none && inner.kind == parser.NK_FLOAT_LIT {
                    val ftext2: ref u8 = parser.float_lit_text_raw(inner)
                    val fval2: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    if str.raw_cmp(tname, c"f32") == 0 {
                        @snprintf(fval2, 128, "s_-{s}", {ftext2})
                        return fval2
                    }
                    if str.raw_cmp(tname, c"f64") == 0 {
                        @snprintf(fval2, 128, "d_-{s}", {ftext2})
                        return fval2
                    }
                }
            }
        }
    }
    return static_global_init_value(ctx, expr)
}

fn append_global_fixed_arr_zero_entries(
    ctx: mut ref CgCtx,
    ty: ref parser.Node,
    out: ref void
) void = trust {
    if ty == none {
        return
    }
    val k: i64 = ty.kind
    if k == parser.TY_MUT {
        append_global_fixed_arr_zero_entries(ctx, ty.d0 as ref parser.Node, out)
        return
    }
    if k == parser.TY_FIXED_ARR {
        val count: i64 = cg_fixed_arr_size_val(ctx, ty)
        val inner: ref parser.Node = ty.d1 as ref parser.Node
        val i: mut i64 = 0
        for {
            if i >= count {
                break
            }
            append_global_fixed_arr_zero_entries(ctx, inner, out)
            i++
        }
        return
    }
    val qt: ref u8 = global_fixed_arr_type_qbe(ty)
    val zero_val: mut ref u8 = c"0"
    if str.raw_cmp(qt, c"s") == 0 {
        zero_val = c"s_0.0"
    } elif str.raw_cmp(qt, c"d") == 0 {
        zero_val = c"d_0.0"
    }
    val entry: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(entry, 64, "{s} {s}", {qt, zero_val})
    @append(out as list[ref u8], entry)
}

fn collect_global_fixed_arr_entries(
    ctx: mut ref CgCtx,
    ty: ref parser.Node,
    expr: ref parser.Node,
    out: ref void
) bool = trust {
    if ty == none {
        return false
    }
    val k: i64 = ty.kind
    if k == parser.TY_MUT {
        return collect_global_fixed_arr_entries(ctx, ty.d0 as ref parser.Node, expr, out)
    }
    if k == parser.TY_FIXED_ARR {
        val count: i64 = cg_fixed_arr_size_val(ctx, ty)
        val inner: ref parser.Node = ty.d1 as ref parser.Node
        if expr == none || expr.kind == parser.NK_ZERO_INIT {
            val zi: mut i64 = 0
            for {
                if zi >= count {
                    break
                }
                append_global_fixed_arr_zero_entries(ctx, inner, out)
                zi++
            }
            return true
        }
        if expr.kind != parser.NK_LIST_LIT {
            return false
        }
        val elems: ref void = expr.d0 as ref void
        val elen: i64 = @len(elems as list[ref parser.Node]) as i64
        if elen != count {
            return false
        }
        val ei: mut i64 = 0
        for {
            if ei >= count {
                break
            }
            val elem_opt = @get(elems as list[ref parser.Node], ei as usize)
            if elem_opt is some elem {
                if !collect_global_fixed_arr_entries(ctx, inner, elem as ref parser.Node, out) {
                    return false
                }
            } else {
                return false
            }
            ei++
        }
        return true
    }
    val init_val: ref u8 = static_global_init_value_typed(ctx, ty, expr)
    if str.raw_cmp(init_val, c"") == 0 {
        return false
    }
    val qt2: ref u8 = global_fixed_arr_type_qbe(ty)
    val entry2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 160 as usize) as ref u8
    @snprintf(entry2, 160, "{s} {s}", {qt2, init_val})
    @append(out as list[ref u8], entry2)
    return true
}

fn emit_global_fixed_arr_literal(
    ctx: mut ref CgCtx,
    glabel: ref u8,
    gty: ref parser.Node,
    gexpr: ref parser.Node
) bool = trust {
    if gty == none {
        return false
    }
    val real_ty: ref parser.Node = cg_concrete_ty(ctx, gty)
    if real_ty == none {
        return false
    }
    val rk: i64 = real_ty.kind
    if rk != parser.TY_FIXED_ARR && rk != parser.TY_MUT {
        return false
    }
    val entries: mut list[ref u8] = mem.new[ref u8]()
    if !collect_global_fixed_arr_entries(ctx, real_ty, gexpr, entries as ref void) {
        return false
    }
    val data_hdr_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        576 as usize
    ) as ref u8
    @snprintf(data_hdr_buf, 576, "data ${s} = \\{ ", {glabel})
    emit(ctx, data_hdr_buf)
    val elen: i64 = @len(entries as list[ref u8]) as i64
    if elen == 0 {
        emit(ctx, c"z 0")
    } else {
        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            if ei != 0 {
                emit(ctx, c", ")
            }
            val e_opt = @get(entries as list[ref u8], ei as usize)
            if e_opt is some e {
                emit(ctx, e as ref u8)
            }
            ei++
        }
    }
    emit(ctx, c" }\n")
    return true
}

fn is_fixed_arr_type(ty: ref parser.Node) bool = trust {
    if ty == none {
        return false
    }
    val k: i64 = ty.kind
    if k == parser.TY_FIXED_ARR {
        return true
    }
    if k == parser.TY_MUT {
        return is_fixed_arr_type(ty.d0 as ref parser.Node)
    }
    return false
}

fn emit_global_list_literal(
    ctx: mut ref CgCtx,
    glabel: ref u8,
    gexpr: ref parser.Node
) bool = trust {
    if gexpr == none || gexpr.kind != parser.NK_LIST_LIT {
        return false
    }
    val elems: ref void = gexpr.d0 as ref void
    val elen: mut i64 = 0
    if elems != none {
        elen = @len(elems as list[ref parser.Node]) as i64
    }

    val init_vals: mut list[ref u8] = mem.new[ref u8]()
    val ei: mut i64 = 0
    for {
        if ei >= elen {
            break
        }
        val elem_opt = @get(elems as list[ref parser.Node], ei as usize)
        if elem_opt is some elem {
            val init_val: ref u8 = static_global_init_value(ctx, elem as ref parser.Node)
            if str.raw_cmp(init_val, c"") == 0 {
                return false
            }
            @append(init_vals, init_val)
        }
        ei++
    }

    val data_label: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 576 as usize) as ref u8
    val hdr_label: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 576 as usize) as ref u8
    @snprintf(data_label, 576, "{s}__data", {glabel})
    @snprintf(hdr_label, 576, "{s}__hdr", {glabel})

    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(buf, 1024, "data ${s} = \\{ ", {data_label})
    emit(ctx, buf)

    if elen == 0 {
        emit(ctx, c"l 0")
    } else {
        val vi: mut i64 = 0
        for {
            if vi >= elen {
                break
            }
            if vi != 0 {
                emit(ctx, c", ")
            }
            val val_opt = @get(init_vals as list[ref u8], vi as usize)
            if val_opt is some init_val {
                @snprintf(buf, 1024, "l {s}", {init_val as ref u8})
                emit(ctx, buf)
            }
            vi++
        }
    }
    emit(ctx, c" }\n")

    val cap: mut i64 = elen
    if cap == 0 {
        cap = 1
    }
    @snprintf(
        buf,
        1024,
        "data ${s} = \\{ l ${s}, l {lld}, l {lld} \\}\n",
        {hdr_label, data_label, elen, cap}
    )
    emit(ctx, buf)
    @snprintf(buf, 1024, "data ${s} = \\{ l ${s} \\}\n", {glabel, hdr_label})
    emit(ctx, buf)
    return true
}

fn emit_global_val(ctx: mut ref CgCtx, mod_prefix: ref u8, node: ref parser.Node) void = trust {
    val gname: ref u8 = parser.node_str_raw(node.d0)
    val gty_node: ref parser.Node = node.d2 as ref parser.Node
    val gexpr: ref parser.Node = node.d3 as ref parser.Node

    val gqtype: mut ref u8 = c"l"
    if gty_node != none {
        if is_fixed_arr_type(gty_node) {
            gqtype = c"l"
        } else {
            gqtype = qbe_type_of(gty_node)
        }
    } elif gexpr != none {
        if gexpr.kind == parser.NK_BOOL || gexpr.kind == parser.NK_CHAR_LIT {
            gqtype = c"w"
        }
    }

    val gann: mut ref u8 = c""
    if gty_node != none {
        gann = type_expr_to_annotation(ctx, gty_node)
    } elif gexpr != none {
        gann = infer_type_annotation(ctx, gexpr)
    }

    val ginit: mut ref u8 = c"0"
    if gexpr != none {
        if gexpr.kind == parser.NK_BUILTIN && str.raw_cmp(
            parser.node_str_raw(gexpr.d0),
            c"embedlen"
        ) == 0 {
            ginit = arenafmt.format(ctx.arena, "{lld}", {gexpr.d3}).ptr
        } else {
            val static_init: ref u8 = static_global_init_value(ctx, gexpr)
            if str.raw_cmp(static_init, c"") != 0 {
                ginit = static_init
            }
        }
    }

    val glabel: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if str.raw_cmp(mod_prefix, c"") == 0 {
        @snprintf(glabel, 512, "{s}", {gname})
    } else {
        @snprintf(glabel, 512, "{s}__{s}", {mod_prefix, gname})
    }

    if gexpr != none && gexpr.kind == parser.NK_BUILTIN && str.raw_cmp(
        parser.node_str_raw(gexpr.d0),
        c"embed"
    ) == 0 {
        val epath: ref u8 = parser.node_str_raw(gexpr.d2)
        if epath == none {
            stdio.eprint("error: @embed path was not resolved\n", {})
            os.exit(1)
        }
        val before: i64 = @len(ctx.embed_labels) as i64
        val embed_label: ref u8 = cg_embed_label(ctx, epath)
        if (@len(ctx.embed_labels) as i64) > before {
            cg_emit_embed_data(ctx, epath, embed_label, gexpr.d3)
        }
        val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(data_buf, 256, "data ${s} = \{ l ${s} \}\n", {glabel, embed_label})
        emit(ctx, data_buf)
        cg_register_global(ctx, gname, glabel, c"l", gann)
        return
    }

    if !emit_global_fixed_arr_literal(
        ctx,
        glabel,
        gty_node,
        gexpr
    ) && !emit_global_list_literal(ctx, glabel, gexpr) {
        val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(data_buf, 256, "data ${s} = \{ {s} {s} \}\n", {glabel, gqtype, ginit})
        emit(ctx, data_buf)
    }

    if gexpr != none && str.raw_cmp(gqtype, c"l") == 0 {
        val needs_runtime_init: mut bool = gexpr.kind == parser.NK_STRUCT_LIT ||
        gexpr.kind == parser.NK_ARGS_PACK ||
        gexpr.kind == parser.NK_CALL
        if gexpr.kind == parser.NK_ZERO_INIT {
            needs_runtime_init = !is_fixed_arr_type(gty_node)
        }
        if needs_runtime_init {
            val init: mut ref GlobalInit = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (@sizeof(GlobalInit)) as usize
            ) as ref GlobalInit
            init.label = glabel
            init.ty = gty_node
            init.expr = gexpr
            @append(ctx.global_inits, init)
        }
    }

    cg_register_global(ctx, gname, glabel, gqtype, gann)
}

/// Emit storage for an immutable module-level value whose initializer can only
/// be evaluated at runtime (for example a struct returned by a function call).
fn emit_const_runtime_global(
    ctx: mut ref CgCtx,
    mod_prefix: ref u8,
    node: ref parser.Node
) void = trust {
    val gname: ref u8 = parser.node_str_raw(node.d1)
    val gexpr: ref parser.Node = node.d2 as ref parser.Node
    val gty_node: ref parser.Node = node.d3 as ref parser.Node
    if gexpr == none || gty_node == none {
        return
    }
    if gexpr.kind != parser.NK_CALL &&
    gexpr.kind != parser.NK_STRUCT_LIT &&
    gexpr.kind != parser.NK_ARGS_PACK &&
    gexpr.kind != parser.NK_ZERO_INIT {
        return
    }
    val as_val: mut ref parser.Node = parser.make_node(ctx.arena, parser.NK_VAL, node.line)
    parser.node_store_string_slot(@addr(as_val.d0), gname)
    as_val.d1 = 0
    as_val.d2 = gty_node
    as_val.d3 = gexpr
    emit_global_val(ctx, mod_prefix, as_val)
}

fn cg_register_globals_as_locals(ctx: mut ref CgCtx) void = trust {
    val gnames_list: ref void = cg_global_src_names(ctx)
    val glen: i64 = @len(gnames_list) as i64
    val gi: mut i64 = 0
    for {
        if gi >= glen {
            break
        }
        val gn_opt = @get(gnames_list, gi as usize)
        if gn_opt is some gn {
            val glbl_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val gqt_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                8 as usize
            ) as ref u8
            val gann_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val found: bool = cg_lookup_global(ctx, gn as ref u8, glbl_buf, gqt_buf, gann_buf)
            if found && cg_lookup_local_var(ctx, gn as ref u8) == c"" {
                val dollar_label: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    260 as usize
                ) as ref u8
                @snprintf(dollar_label, 260, "${s}", {glbl_buf})
                cg_register_local_var(ctx, gn as ref u8, dollar_label)
                val is_fixed_arr_global: bool = @load8(gann_buf) as i64 == 91
                if !is_fixed_arr_global {
                    cg_mark_as_slot(ctx, gn as ref u8)
                }
                if str.raw_cmp(gann_buf, c"") != 0 {
                    val gann_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (str.len_raw(gann_buf) + 1) as usize
                    ) as ref u8
                    @memcpy(gann_copy, gann_buf, str.len_raw(gann_buf) + 1)
                    cg_register_local_type(ctx, gn as ref u8, gann_copy)
                    if raw_starts_with(
                        gann_copy,
                        c"ref "
                    ) || raw_starts_with(
                        gann_copy,
                        c"mut ref "
                    ) || cg_ann_is_indirect_value(ctx, gann_copy) {
                        cg_register_local_ref_type(ctx, gn as ref u8)
                    }
                } elif str.raw_cmp(gqt_buf, c"w") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"i32")
                } elif str.raw_cmp(gqt_buf, c"s") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f32")
                } elif str.raw_cmp(gqt_buf, c"d") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f64")
                }
            }
        }
        gi++
    }
}

/// Emit the function that performs runtime initialization of global values.
fn cg_emit_global_init(ctx: mut ref CgCtx) void = trust {
    emitln(ctx, c"function w $__sx_global_init() {")
    emitln(ctx, c"@start")
    cg_dvars_clear(ctx)
    cg_set_fn_name(ctx, c"__sx_global_init")
    ctx.current_fn_ret_qtype = c"w"
    ctx.current_fn_ret_union = c""
    ctx.current_fn_ret_ty = none
    ctx.expected_ty = none
    ctx.inv_cur_pnames = mem.new[ref u8]()
    ctx.inv_cur_ptypes = mem.new[ref u8]()
    cg_register_globals_as_locals(ctx)

    for init in ctx.global_inits {
        val ty: ref parser.Node = init.ty as ref parser.Node
        val expr: ref parser.Node = init.expr as ref parser.Node
        ctx.aggregate_heap++
        val v: ref u8 = gen_expr_expected(ctx, expr, ty)
        ctx.aggregate_heap--
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "    storel {s}, ${s}\n", {v, init.label})
        emit(ctx, buf)
    }

    emitln(ctx, c"    ret 0")
    emitln(ctx, c"}")
    emitln(ctx, c"")
}

/// Generate an expression, with integer literals using the specified QBE type.
fn gen_expr_with_type(
    ctx: mut ref CgCtx,
    expr: ref parser.Node,
    target_type: ref u8
) ref u8 = trust {
    if expr == none {
        return c"0"
    }
    val k: i64 = expr.kind
    if k == parser.NK_INT_LIT {
        val text: ref u8 = parser.int_lit_text_raw(expr)
        return gen_int_lit_as(ctx, text, target_type)
    }
    if k == parser.NK_IDENT {
        val cval: ref u8 = cg_const_val(ctx, parser.node_str_raw(expr.d0))
        if cg_is_int_const_val(cval) && (str.raw_cmp(
                target_type,
                c"w"
            ) == 0 || str.raw_cmp(target_type, c"l") == 0) {
            val tmp: i64 = fresh_tmp(ctx)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
            @snprintf(buf, 64, "    %%t{lld} ={s} copy {s}\n", {tmp, target_type, cval})
            emit(
                ctx,
                buf
            )
            val res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res, 16, "%%t{lld}", {tmp})
            return res
        }
    }
    if k == parser.NK_FLOAT_LIT {
        val text: ref u8 = parser.float_lit_text_raw(expr)
        val tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        if str.raw_cmp(target_type, c"s") == 0 {
            @snprintf(buf, 64, "    %%t{lld} =s copy s_{s}\n", {tmp, text})
        } elif str.raw_cmp(target_type, c"d") == 0 {
            @snprintf(buf, 64, "    %%t{lld} =d copy d_{s}\n", {tmp, text})
        } else {
            return gen_expr(ctx, expr)
        }
        emit(
            ctx,
            buf
        )
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {tmp})
        return res
    }
    val raw: ref u8 = gen_expr(ctx, expr)
    if str.raw_cmp(target_type, c"") == 0 {
        return raw
    }
    val raw_qtype: ref u8 = expr_qbe_type(ctx, expr)
    return cg_coerce_qtype(ctx, raw, raw_qtype, target_type)
}

fn gen_expr_expected(
    ctx: mut ref CgCtx,
    expr: ref parser.Node,
    expected_ty: ref parser.Node
) ref u8 = trust {
    val old_expected: ref parser.Node = ctx.expected_ty as ref parser.Node
    ctx.expected_ty = expected_ty
    val res: ref u8 = gen_expr(ctx, expr)
    ctx.expected_ty = old_expected
    return res
}

fn gen_expr(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c"0"
    }

    val k: i64 = expr.kind

    if k == parser.NK_INT_LIT {
        val text: ref u8 = parser.int_lit_text_raw(expr)
        val fch: i64 = @load8(@ptradd(text, 0)) as i64
        val sch: mut i64 = 0
        if fch == 48 {
            sch = @load8(@ptradd(text, 1)) as i64
        }
        val tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        val emit_text: mut ref u8 = text
        if fch == 48 {
            if sch == 120 || sch == 88 {
                val hex_start: ref u8 = @ptradd(text, 2) as ref u8
                val val_: mut i64 = 0
                val hi: mut i64 = 0
                for {
                    val hc: i64 = @load8(@ptradd(hex_start, hi)) as i64
                    if hc == 0 {
                        break
                    }
                    val digit: mut i64 = hc - 48
                    if hc >= 97 {
                        digit = hc - 87
                    } elif hc >= 65 {
                        digit = hc - 55
                    }
                    val_ = val_ * 16 + digit
                    hi++
                }
                val dec_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(dec_buf, 32, "{lld}", {val_})
                emit_text = dec_buf
            }
        }
        @snprintf(buf, 64, "    %%t{lld} =l copy {s}\n", {tmp, emit_text})
        emit(
            ctx,
            buf
        )
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {tmp})
        return res
    }

    if k == parser.NK_FLOAT_LIT {
        val text2: ref u8 = parser.float_lit_text_raw(expr)
        val tmp2: i64 = fresh_tmp(ctx)
        val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        val expected_qt: mut ref u8 = c"d"
        if ctx.expected_ty != none {
            val eqt: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
            if str.raw_cmp(eqt, c"s") == 0 {
                expected_qt = c"s"
            }
        }
        if str.raw_cmp(expected_qt, c"s") == 0 {
            @snprintf(buf2, 64, "    %%t{lld} =s copy s_{s}\n", {tmp2, text2})
        } else {
            @snprintf(buf2, 64, "    %%t{lld} =d copy d_{s}\n", {tmp2, text2})
        }
        emit(
            ctx,
            buf2
        )
        val res2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res2, 16, "%%t{lld}", {tmp2})
        return res2
    }

    if k == parser.NK_STR_LIT {
        val s: str.StringView = parser.str_lit_text(expr)
        if parser.str_lit_is_cstr(expr) {
            val idx: i64 = intern_string(ctx, s)
            val tmp3: i64 = fresh_tmp(ctx)
            val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
            @snprintf(buf3, 64, "    %%t{lld} =l copy $__str{lld}\n", {tmp3, idx})
            emit(
                ctx,
                buf3
            )
            val res3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(res3, 16, "%%t{lld}", {tmp3})
            return res3
        }
        val idx: i64 = intern_string_view(ctx, s)
        val svbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(svbuf, 64, "$__sv{lld}", {idx})
        return svbuf
    }

    if k == parser.NK_BOOL {
        val v: i64 = expr.d0 as i64
        val tmp4: i64 = fresh_tmp(ctx)
        val buf4: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(buf4, 64, "    %%t{lld} =l copy {lld}\n", {tmp4, v})
        emit(
            ctx,
            buf4
        )
        val res4: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res4, 16, "%%t{lld}", {tmp4})
        return res4
    }

    if k == parser.NK_CHAR_LIT {
        val cv: i64 = expr.d0 as i64
        val tmp_c: i64 = fresh_tmp(ctx)
        val buf_c: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(buf_c, 64, "    %%t{lld} =l copy {lld}\n", {tmp_c, cv})
        emit(
            ctx,
            buf_c
        )
        val res_c: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res_c, 16, "%%t{lld}", {tmp_c})
        return res_c
    }

    if k == parser.NK_NONE {
        if ctx.expected_ty != none
        && (ctx.expected_ty as ref parser.Node).kind == parser.TY_OPTION {
            val opt_ty: ref parser.Node = ctx.expected_ty as ref parser.Node
            val sz: i64 = cg_option_layout_size(ctx, opt_ty, 0)
            val tmp_none: i64 = fresh_tmp(ctx)
            val buf_none: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_none, 128, "    %%t{lld} =l alloc8 {lld}\n    storel 0, %%t{lld}\n",
                {tmp_none, sz, tmp_none})
            emit(ctx, buf_none)
            val res_none: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_none, 16, "%%t{lld}", {tmp_none})
            return res_none
        }
        val tmp5: i64 = fresh_tmp(ctx)
        val buf5: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(buf5, 64, "    %%t{lld} =l copy 0\n", {tmp5})
        emit(
            ctx,
            buf5
        )
        val res5: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res5, 16, "%%t{lld}", {tmp5})
        return res5
    }

    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val cval: ref u8 = cg_const_val(ctx, name)
        if str.raw_cmp(cval, c"") != 0 {
            val tmp6: i64 = fresh_tmp(ctx)
            val buf6: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            val expected_qt2: mut ref u8 = c""
            if ctx.expected_ty != none {
                expected_qt2 = qbe_type_of(ctx.expected_ty as ref parser.Node)
            }
            if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") {
                val ftext: ref u8 = @ptradd(cval, 2) as ref u8
                val emit_qt: mut ref u8 = c"d"
                if raw_starts_with(cval, c"s_") {
                    emit_qt = c"s"
                }
                if str.raw_cmp(expected_qt2, c"s") == 0 {
                    emit_qt = c"s"
                } elif str.raw_cmp(expected_qt2, c"d") == 0 {
                    emit_qt = c"d"
                }
                @snprintf(
                    buf6,
                    128,
                    "    %%t{lld} ={s} copy {s}_{s}\n",
                    {tmp6, emit_qt, emit_qt, ftext}
                )
            } else {
                @snprintf(buf6, 128, "    %%t{lld} =l copy {s}\n", {tmp6, cval})
            }
            emit(
                ctx,
                buf6
            )
            val res6: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res6, 16, "%%t{lld}", {tmp6})
            return res6
        } else {
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, name)
            if str.raw_cmp(qbe_var, c"") != 0 {
                if cg_is_slot(ctx, name) {
                    val tmp_load: i64 = fresh_tmp(ctx)
                    val buf_load: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8

                    val slot_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)

                    val is_ref_load: bool = cg_is_local_ref_type(ctx, name)
                    if is_ref_load {
                        @snprintf(
                            buf_load,
                            128,
                            "    %%t{lld} =l loadl {s}\n",
                            {tmp_load, slot_ref}
                        )
                    } else {
                        val qtype: ref u8 = cg_var_qbe_type(ctx, name)
                        if str.raw_cmp(qtype, c"w") == 0 {
                            val w_tmp_load: i64 = fresh_tmp(ctx)
                            val buf_w_load: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                128 as usize
                            ) as ref u8
                            @snprintf(
                                buf_w_load,
                                128,
                                "    %%t{lld} =w loadw {s}\n",
                                {w_tmp_load, slot_ref}
                            )
                            emit(ctx, buf_w_load)
                            @snprintf(
                                buf_load,
                                128,
                                "    %%t{lld} =l extsw %%t{lld}\n",
                                {tmp_load, w_tmp_load}
                            )
                        } elif str.raw_cmp(qtype, c"s") == 0 {
                            @snprintf(
                                buf_load,
                                128,
                                "    %%t{lld} =s loads {s}\n",
                                {tmp_load, slot_ref}
                            )
                        } elif str.raw_cmp(qtype, c"d") == 0 {
                            @snprintf(
                                buf_load,
                                128,
                                "    %%t{lld} =d loadd {s}\n",
                                {tmp_load, slot_ref}
                            )
                        } else {
                            @snprintf(
                                buf_load,
                                128,
                                "    %%t{lld} =l loadl {s}\n",
                                {tmp_load, slot_ref}
                            )
                        }
                    }
                    emit(ctx, buf_load)
                    val res_load: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(res_load, 16, "%%t{lld}", {tmp_load})
                    return res_load
                } else {
                    return cg_qbe_value_ref(ctx, qbe_var)
                }
            }

            val dqt: ref u8 = cg_direct_type(ctx, name)
            if str.raw_cmp(dqt, c"") != 0 {
                val res_direct: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(res_direct, 32, "%%{s}", {name})
                return res_direct
            } else {
                val tmp6b: i64 = fresh_tmp(ctx)
                val buf6b: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                val ltype: ref u8 = cg_local_type(ctx, name)
                val fn_check: ref void = cg_lookup_fn_params(ctx, name)
                if fn_check != none {
                    val ext_addr: ref u8 = cg_lookup_extern_symbol(ctx, name)
                    if ext_addr != none {
                        @snprintf(
                            buf6b,
                            128,
                            "    %%t{lld} =l copy ${s}\n",
                            {tmp6b, ext_addr}
                        )
                    } else {
                        @snprintf(buf6b, 128, "    %%t{lld} =l copy ${s}\n", {tmp6b, name})
                    }
                } else {
                    val resolved_name: ref u8 = resolve_fn_mangled(ctx, name)
                    if str.raw_cmp(resolved_name, c"") != 0 {
                        val ext_addr2: ref u8 = cg_lookup_extern_symbol(ctx, resolved_name)
                        if ext_addr2 != none {
                            @snprintf(
                                buf6b,
                                128,
                                "    %%t{lld} =l copy ${s}\n",
                                {tmp6b, ext_addr2}
                            )
                        } else {
                            @snprintf(
                                buf6b,
                                128,
                                "    %%t{lld} =l copy ${s}\n",
                                {tmp6b, resolved_name}
                            )
                        }
                    } elif str.raw_cmp(ltype, c"f64") == 0 {
                        @snprintf(buf6b, 128, "    %%t{lld} =d loadd %%{s}\n", {tmp6b, name})
                    } elif str.raw_cmp(ltype, c"f32") == 0 {
                        @snprintf(buf6b, 128, "    %%t{lld} =s loads %%{s}\n", {tmp6b, name})
                    } elif is_word_type_name(ltype) {
                        val w_tmp6: i64 = fresh_tmp(ctx)
                        val buf6c: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(buf6c, 128, "    %%t{lld} =w loadw %%{s}\n", {w_tmp6, name})
                        emit(
                            ctx,
                            buf6c
                        )
                        @snprintf(buf6b, 128, "    %%t{lld} =l extsw %%t{lld}\n", {tmp6b, w_tmp6})
                    } else {
                        @snprintf(buf6b, 128, "    %%t{lld} =l loadl %%{s}\n", {tmp6b, name})
                    }
                }
                emit(
                    ctx,
                    buf6b
                )
                val res6b: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(res6b, 16, "%%t{lld}", {tmp6b})
                return res6b
            }
        }
    }

    if k == parser.NK_TRUST {
        return gen_expr(ctx, expr.d0 as ref parser.Node)
    }

    if k == parser.NK_SOME {
        val inner_node: ref parser.Node = expr.d0 as ref parser.Node
        ctx.aggregate_heap++
        val inner_raw: ref u8 = gen_expr(ctx, inner_node)
        ctx.aggregate_heap--
        val inner_ann: ref u8 = infer_type_annotation(ctx, inner_node)
        val inner: ref u8 = cg_materialize_stack_aggregate_ann(ctx, inner_raw, inner_ann)
        val inner_qt: ref u8 = expr_qbe_type(ctx, inner_node)
        val alloc_node: ref parser.Node = parser.wrap_allocator(expr)
        if true {
            val opt_ty: mut ref parser.Node = none
            if ctx.expected_ty != none && (ctx.expected_ty as ref parser.Node).kind == parser.TY_OPTION {
                opt_ty = ctx.expected_ty as ref parser.Node
            } else {
                opt_ty = parser.make_node(ctx.arena, parser.TY_OPTION, expr.line)
                val inner_ann: ref u8 = infer_type_annotation(ctx, inner_node)
                parser.node_store_slot[ref parser.Node](
                    @addr(opt_ty.d0),
                    cg_named_ty_from_ann(ctx, inner_ann)
                )
            }
            val sz: i64 = cg_option_layout_size(ctx, opt_ty, 0)
            val some_ptr: i64 = fresh_tmp(ctx)
            if alloc_node != none {
                val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
                val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
                val ac: ref u8 = gen_expr(ctx, alloc_node)
                val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
                ctx.alloc_runtime = true
                val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(abuf, 256, "    %%t{lld} =l call $sxqbe_wrap_alloc(l {s}, l {s}, l {lld})\n",
                    {some_ptr, af, ac, sz})
                emit(ctx, abuf)
            } else {
                val abuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(abuf2, 128, "    %%t{lld} =l alloc8 {lld}\n", {some_ptr, sz})
                emit(ctx, abuf2)
            }
            val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(tbuf, 64, "    storel 1, %%t{lld}\n", {some_ptr})
            emit(ctx, tbuf)
            val ptr_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(ptr_str, 32, "%%t{lld}", {some_ptr})
            cg_emit_store_typed(ctx, ptr_str, 8, inner, opt_ty.d0 as ref parser.Node)
            val unbox_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(unbox_res, 16, "%%t{lld}", {some_ptr})
            return unbox_res
        }
        if alloc_node != none {
            val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
            val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
            val ac: ref u8 = gen_expr(ctx, alloc_node)
            val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
            val inner_l: ref u8 = cg_coerce_qtype(ctx, inner, inner_qt, c"l")
            val some_tmp2: i64 = fresh_tmp(ctx)
            ctx.alloc_runtime = true
            val alloc_hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(alloc_hdr, 64, "    %%t{lld} =l call $sxqbe_some_alloc(l ", {some_tmp2})
            emit(ctx, alloc_hdr)
            val af_safe: ref u8 = cg_copy_str(ctx, af)
            val ac_safe: ref u8 = cg_copy_str(ctx, ac)
            val inner_safe: ref u8 = cg_copy_str(ctx, inner_l)
            emit(ctx, af_safe)
            emit(ctx, c", l ")
            emit(ctx, ac_safe)
            emit(ctx, c", l ")
            emit(ctx, inner_safe)
            emit(ctx, c")\n")
            val alloc_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(alloc_res, 16, "%%t{lld}", {some_tmp2})
            return alloc_res
        }
        val box_tmp: i64 = fresh_tmp(ctx)
        val some_tmp: i64 = fresh_tmp(ctx)
        val box_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            192 as usize
        ) as ref u8
        if str.raw_cmp(inner_qt, c"d") == 0 {
            @snprintf(box_buf, 192, "    %%t{lld} =l call $malloc(l 8)\n    stored {s}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n",
                {box_tmp, inner, box_tmp, some_tmp, box_tmp})
        } elif str.raw_cmp(inner_qt, c"s") == 0 {
            @snprintf(box_buf, 192, "    %%t{lld} =l call $malloc(l 8)\n    stores {s}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n",
                {box_tmp, inner, box_tmp, some_tmp, box_tmp})
        } else {
            val inner_l: ref u8 = cg_coerce_qtype(ctx, inner, inner_qt, c"l")
            @snprintf(box_buf, 192, "    %%t{lld} =l call $malloc(l 8)\n    storel {s}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n",
                {box_tmp, inner_l, box_tmp, some_tmp, box_tmp})
        }
        emit(
            ctx,
            box_buf
        )
        val res7: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res7, 16, "%%t{lld}", {some_tmp})
        return res7
    }

    if k == parser.NK_OK_VAL {
        val alloc_node: ref parser.Node = parser.wrap_allocator(expr)
        if true {
            val res_ty: mut ref parser.Node = none
            if ctx.expected_ty != none && (ctx.expected_ty as ref parser.Node).kind == parser.TY_RESULT {
                res_ty = ctx.expected_ty as ref parser.Node
            } else {
                res_ty = parser.make_node(ctx.arena, parser.TY_RESULT, expr.line)
                val ok_ann: mut ref u8 = c"i64"
                if expr.d0 != 0 {
                    ok_ann = infer_type_annotation(ctx, expr.d0 as ref parser.Node)
                }
                parser.node_store_slot[ref parser.Node](
                    @addr(res_ty.d0),
                    cg_named_ty_from_ann(ctx, ok_ann)
                )
                parser.node_store_slot[ref parser.Node](
                    @addr(res_ty.d1),
                    cg_named_ty_from_ann(ctx, c"i64")
                )
            }
            val sz: i64 = cg_result_layout_size(ctx, res_ty, 0)
            val ok_ptr: i64 = fresh_tmp(ctx)
            if alloc_node != none {
                val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
                val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
                val ac: ref u8 = gen_expr(ctx, alloc_node)
                val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
                ctx.alloc_runtime = true
                val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(abuf, 256, "    %%t{lld} =l call $sxqbe_wrap_alloc(l {s}, l {s}, l {lld})\n",
                    {ok_ptr, af, ac, sz})
                emit(ctx, abuf)
            } else {
                val abuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(abuf2, 128, "    %%t{lld} =l alloc8 {lld}\n", {ok_ptr, sz})
                emit(ctx, abuf2)
            }
            val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(tbuf, 64, "    storel 0, %%t{lld}\n", {ok_ptr})
            emit(ctx, tbuf)
            if expr.d0 != 0 {
                val inner_ok_expr: ref parser.Node = expr.d0 as ref parser.Node
                val old_expected_ok: ref parser.Node = ctx.expected_ty as ref parser.Node
                ctx.expected_ty = res_ty.d0 as ref void
                ctx.aggregate_heap++
                val inner_ok_raw: ref u8 = gen_expr(ctx, inner_ok_expr)
                ctx.aggregate_heap--
                ctx.expected_ty = old_expected_ok
                val inner_ok_ann: ref u8 = infer_type_annotation(ctx, inner_ok_expr)
                val inner_ok: ref u8 = cg_materialize_stack_aggregate_ann(
                    ctx,
                    inner_ok_raw,
                    inner_ok_ann
                )
                val ptr_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(ptr_str, 32, "%%t{lld}", {ok_ptr})
                cg_emit_store_typed(ctx, ptr_str, 8, inner_ok, res_ty.d0 as ref parser.Node)
            }
            val unbox_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(unbox_res, 16, "%%t{lld}", {ok_ptr})
            return unbox_res
        }
        if alloc_node != none {
            val inner_val: mut ref u8 = c"0"
            if expr.d0 != 0 {
                val inner_node: ref parser.Node = expr.d0 as ref parser.Node
                ctx.aggregate_heap++
                val inner_raw: ref u8 = gen_expr(ctx, inner_node)
                ctx.aggregate_heap--
                inner_val = inner_raw
            }
            val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
            val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
            val ac: ref u8 = gen_expr(ctx, alloc_node)
            val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
            val ok_tmp2: i64 = fresh_tmp(ctx)
            ctx.alloc_runtime = true
            val alloc_hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(alloc_hdr, 64, "    %%t{lld} =l call $sxqbe_ok_alloc(l ", {ok_tmp2})
            emit(ctx, alloc_hdr)
            val af_safe: ref u8 = cg_copy_str(ctx, af)
            val ac_safe: ref u8 = cg_copy_str(ctx, ac)
            val inner_safe: ref u8 = cg_copy_str(ctx, inner_val)
            emit(ctx, af_safe)
            emit(ctx, c", l ")
            emit(ctx, ac_safe)
            emit(ctx, c", l ")
            emit(ctx, inner_safe)
            emit(ctx, c")\n")
            val alloc_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(alloc_res, 16, "%%t{lld}", {ok_tmp2})
            return alloc_res
        }
        val ptr_ok: i64 = fresh_tmp(ctx)
        val buf_ok: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(
            buf_ok,
            64,
            "    %%t{lld} =l call $malloc(l 16)\n    storel 0, %%t{lld}\n",
            {ptr_ok, ptr_ok}
        )
        emit(ctx, buf_ok)
        if expr.d0 != 0 {
            val inner_ok_expr: ref parser.Node = expr.d0 as ref parser.Node
            ctx.aggregate_heap++
            val inner_ok_raw: ref u8 = gen_expr(ctx, inner_ok_expr)
            ctx.aggregate_heap--
            val inner_ok_ann: ref u8 = infer_type_annotation(ctx, inner_ok_expr)
            val inner_ok: ref u8 = cg_materialize_stack_aggregate_ann(
                ctx,
                inner_ok_raw,
                inner_ok_ann
            )
            val off_ok: i64 = fresh_tmp(ctx)
            val vbuf_ok: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            val store_op_ok: mut ref u8 = c""
            if expr_is_float(ctx, inner_ok_expr) {
                store_op_ok = c"stored"
            } else {
                store_op_ok = c"storel"
            }
            @snprintf(vbuf_ok, 128, "    %%t{lld} =l add %%t{lld}, 8\n    {s} {s}, %%t{lld}\n",
                {off_ok, ptr_ok, store_op_ok, inner_ok, off_ok})
            emit(ctx, vbuf_ok)
        }
        val res_ok: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res_ok, 16, "%%t{lld}", {ptr_ok})
        return res_ok
    }

    if k == parser.NK_ERR_VAL {
        val alloc_node: ref parser.Node = parser.wrap_allocator(expr)
        if true {
            val res_ty: mut ref parser.Node = none
            if ctx.expected_ty != none && (ctx.expected_ty as ref parser.Node).kind == parser.TY_RESULT {
                res_ty = ctx.expected_ty as ref parser.Node
            } else {
                res_ty = parser.make_node(ctx.arena, parser.TY_RESULT, expr.line)
                parser.node_store_slot[ref parser.Node](
                    @addr(res_ty.d0),
                    cg_named_ty_from_ann(ctx, c"i64")
                )
                val err_ann: mut ref u8 = c"i64"
                if expr.d0 != 0 {
                    err_ann = infer_type_annotation(ctx, expr.d0 as ref parser.Node)
                }
                parser.node_store_slot[ref parser.Node](
                    @addr(res_ty.d1),
                    cg_named_ty_from_ann(ctx, err_ann)
                )
            }
            val sz: i64 = cg_result_layout_size(ctx, res_ty, 0)
            val err_ptr: i64 = fresh_tmp(ctx)
            if alloc_node != none {
                val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
                val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
                val ac: ref u8 = gen_expr(ctx, alloc_node)
                val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
                ctx.alloc_runtime = true
                val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(abuf, 256, "    %%t{lld} =l call $sxqbe_wrap_alloc(l {s}, l {s}, l {lld})\n",
                    {err_ptr, af, ac, sz})
                emit(ctx, abuf)
            } else {
                val abuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(abuf2, 128, "    %%t{lld} =l alloc8 {lld}\n", {err_ptr, sz})
                emit(ctx, abuf2)
            }
            val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(tbuf, 64, "    storel 1, %%t{lld}\n", {err_ptr})
            emit(ctx, tbuf)
            val old_expected_err: ref parser.Node = ctx.expected_ty as ref parser.Node
            ctx.expected_ty = res_ty.d1 as ref void
            ctx.aggregate_heap++
            val inner_err_raw: ref u8 = gen_expr(ctx, expr.d0 as ref parser.Node)
            ctx.aggregate_heap--
            ctx.expected_ty = old_expected_err
            val inner_err_ann: ref u8 = infer_type_annotation(
                ctx,
                expr.d0 as ref parser.Node
            )
            val inner_err: ref u8 = cg_materialize_stack_aggregate_ann(
                ctx,
                inner_err_raw,
                inner_err_ann
            )
            val ptr_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(ptr_str, 32, "%%t{lld}", {err_ptr})
            cg_emit_store_typed(ctx, ptr_str, 8, inner_err, res_ty.d1 as ref parser.Node)
            val unbox_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(unbox_res, 16, "%%t{lld}", {err_ptr})
            return unbox_res
        }
        if alloc_node != none {
            val inner_node: ref parser.Node = expr.d0 as ref parser.Node
            ctx.aggregate_heap++
            val inner_raw: ref u8 = gen_expr(ctx, inner_node)
            ctx.aggregate_heap--
            val inner_val: mut ref u8 = c"0"
            inner_val = inner_raw
            val alloc_ann: ref u8 = infer_type_annotation(ctx, alloc_node)
            val alloc_ty: ref parser.Node = cg_named_ty_from_ann(ctx, alloc_ann)
            val ac: ref u8 = gen_expr(ctx, alloc_node)
            val af: ref u8 = cg_alloc_fn_ptr(ctx, alloc_ty, c"alloc_raw")
            val err_tmp2: i64 = fresh_tmp(ctx)
            ctx.alloc_runtime = true
            val alloc_hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(alloc_hdr, 64, "    %%t{lld} =l call $sxqbe_err_alloc(l ", {err_tmp2})
            emit(ctx, alloc_hdr)
            val af_safe: ref u8 = cg_copy_str(ctx, af)
            val ac_safe: ref u8 = cg_copy_str(ctx, ac)
            val inner_safe: ref u8 = cg_copy_str(ctx, inner_val)
            emit(ctx, af_safe)
            emit(ctx, c", l ")
            emit(ctx, ac_safe)
            emit(ctx, c", l ")
            emit(ctx, inner_safe)
            emit(ctx, c")\n")
            val alloc_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(alloc_res, 16, "%%t{lld}", {err_tmp2})
            return alloc_res
        }
        // result err: [tag=1][value]
        val inner2: ref u8 = gen_expr(ctx, expr.d0 as ref parser.Node)
        val ptr3: i64 = fresh_tmp(ctx)
        val buf10: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(
            buf10,
            64,
            "    %%t{lld} =l call $malloc(l 16)\n    storel 1, %%t{lld}\n",
            {ptr3, ptr3}
        )
        emit(ctx, buf10)
        val off2: i64 = fresh_tmp(ctx)
        val buf11: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(buf11, 128, "    %%t{lld} =l add %%t{lld}, 8\n    storel {s}, %%t{lld}\n",
            {off2, ptr3, inner2, off2})
        emit(
            ctx,
            buf11
        )
        val res8: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res8, 16, "%%t{lld}", {ptr3})
        return res8
    }

    if k == parser.NK_BINOP {
        return gen_binop(ctx, expr)
    }

    if k == parser.NK_UNOP {
        return gen_unop(ctx, expr)
    }

    if k == parser.NK_FIELD {
        return gen_field(ctx, expr)
    }

    if k == parser.NK_CALL {
        return gen_call(ctx, expr)
    }

    if k == parser.NK_BUILTIN {
        return gen_builtin(ctx, expr)
    }

    if k == parser.NK_CAST {
        val inner_expr: ref parser.Node = expr.d0 as ref parser.Node
        val inner3: ref u8 = gen_expr(ctx, inner_expr)
        val ty: ref parser.Node = expr.d1 as ref parser.Node
        val qt: ref u8 = qbe_type_of(ty)
        val src_qt: ref u8 = expr_qbe_type(ctx, inner_expr)

        val needs_conversion: mut bool = false
        val conv_instr: mut ref u8 = c"copy"

        if str.raw_cmp(src_qt, c"d") == 0 && str.raw_cmp(qt, c"l") == 0 {
            needs_conversion = true
            conv_instr = c"dtosi"
        } elif str.raw_cmp(src_qt, c"d") == 0 && str.raw_cmp(qt, c"w") == 0 {
            needs_conversion = true
            conv_instr = c"dtosi"
        } elif str.raw_cmp(src_qt, c"s") == 0 && str.raw_cmp(qt, c"l") == 0 {
            val tmp_conv_d: i64 = fresh_tmp(ctx)
            val buf_conv_d: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_d, 128, "    %%t{lld} =d exts {s}\n", {tmp_conv_d, inner3})
            emit(ctx, buf_conv_d)
            val tmp_conv_i: i64 = fresh_tmp(ctx)
            val buf_conv_i: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_i, 128, "    %%t{lld} =l dtosi %%t{lld}\n", {tmp_conv_i, tmp_conv_d})
            emit(
                ctx,
                buf_conv_i
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv_i})
            return res_conv
        } elif str.raw_cmp(src_qt, c"s") == 0 && str.raw_cmp(qt, c"w") == 0 {
            val tmp_conv_d: i64 = fresh_tmp(ctx)
            val buf_conv_d: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_d, 128, "    %%t{lld} =d exts {s}\n", {tmp_conv_d, inner3})
            emit(ctx, buf_conv_d)
            val tmp_conv_i: i64 = fresh_tmp(ctx)
            val buf_conv_i: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_i, 128, "    %%t{lld} =w dtosi %%t{lld}\n", {tmp_conv_i, tmp_conv_d})
            emit(
                ctx,
                buf_conv_i
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv_i})
            return res_conv
        } elif str.raw_cmp(src_qt, c"d") == 0 && str.raw_cmp(qt, c"s") == 0 {
            val tmp_conv: i64 = fresh_tmp(ctx)
            val buf_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv, 128, "    %%t{lld} =s truncd {s}\n", {tmp_conv, inner3})
            emit(
                ctx,
                buf_conv
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv})
            return res_conv
        } elif str.raw_cmp(src_qt, c"s") == 0 && str.raw_cmp(qt, c"d") == 0 {
            val tmp_conv: i64 = fresh_tmp(ctx)
            val buf_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv, 128, "    %%t{lld} =d exts {s}\n", {tmp_conv, inner3})
            emit(
                ctx,
                buf_conv
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv})
            return res_conv
        } elif str.raw_cmp(src_qt, c"l") == 0 && str.raw_cmp(qt, c"d") == 0 {
            needs_conversion = true
            conv_instr = c"sltof"
        } elif str.raw_cmp(src_qt, c"l") == 0 && str.raw_cmp(qt, c"s") == 0 {
            val tmp_conv_d: i64 = fresh_tmp(ctx)
            val buf_conv_d: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_d, 128, "    %%t{lld} =d sltof {s}\n", {tmp_conv_d, inner3})
            emit(ctx, buf_conv_d)
            val tmp_conv_s: i64 = fresh_tmp(ctx)
            val buf_conv_s: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                buf_conv_s,
                128,
                "    %%t{lld} =s truncd %%t{lld}\n",
                {tmp_conv_s, tmp_conv_d}
            )
            emit(
                ctx,
                buf_conv_s
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv_s})
            return res_conv
        } elif str.raw_cmp(src_qt, c"w") == 0 && str.raw_cmp(qt, c"l") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, inner3})
            emit(
                ctx,
                ext_buf
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {ext_tmp})
            return res_conv
        } elif str.raw_cmp(src_qt, c"w") == 0 && str.raw_cmp(qt, c"d") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, inner3})
            emit(ctx, ext_buf)
            val tmp_conv: i64 = fresh_tmp(ctx)
            val buf_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv, 128, "    %%t{lld} =d sltof %%t{lld}\n", {tmp_conv, ext_tmp})
            emit(
                ctx,
                buf_conv
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv})
            return res_conv
        } elif str.raw_cmp(src_qt, c"w") == 0 && str.raw_cmp(qt, c"s") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, inner3})
            emit(ctx, ext_buf)
            val tmp_conv_d: i64 = fresh_tmp(ctx)
            val buf_conv_d: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf_conv_d, 128, "    %%t{lld} =d sltof %%t{lld}\n", {tmp_conv_d, ext_tmp})
            emit(ctx, buf_conv_d)
            val tmp_conv_s: i64 = fresh_tmp(ctx)
            val buf_conv_s: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                buf_conv_s,
                128,
                "    %%t{lld} =s truncd %%t{lld}\n",
                {tmp_conv_s, tmp_conv_d}
            )
            emit(
                ctx,
                buf_conv_s
            )
            val res_conv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res_conv, 16, "%%t{lld}", {tmp_conv_s})
            return res_conv
        }

        if str.raw_cmp(qt, c"w") == 0 && !needs_conversion {
            return inner3
        }

        val tmp7: i64 = fresh_tmp(ctx)
        val buf12: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        if needs_conversion {
            @snprintf(buf12, 128, "    %%t{lld} ={s} {s} {s}\n", {tmp7, qt, conv_instr, inner3})
        } else {
            @snprintf(buf12, 128, "    %%t{lld} ={s} copy {s}\n", {tmp7, qt, inner3})
        }
        emit(
            ctx,
            buf12
        )
        val res9: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res9, 16, "%%t{lld}", {tmp7})
        return res9
    }

    if k == parser.NK_ADDR {
        val inner4: ref parser.Node = expr.d0 as ref parser.Node
        if inner4.kind == parser.NK_IDENT {
            val iname: ref u8 = parser.node_str_raw(inner4.d0)
            val qbe_var_addr: ref u8 = cg_lookup_local_var(ctx, iname)
            if str.raw_cmp(qbe_var_addr, c"") != 0 {
                if cg_is_slot(ctx, iname) {
                    val local_type_addr: ref u8 = cg_local_type(ctx, iname)
                    val slot_is_indirect_addr: mut bool = false
                    if !raw_starts_with(local_type_addr, c"ref ") &&
                    !raw_starts_with(local_type_addr, c"mut ref ") {
                        if raw_starts_with(local_type_addr, c"list[") ||
                        raw_starts_with(local_type_addr, c"slice[") ||
                        raw_starts_with(local_type_addr, c"result[") ||
                        raw_starts_with(local_type_addr, c"[") {
                            slot_is_indirect_addr = true
                        } elif str.raw_cmp(local_type_addr, c"") != 0 {
                            if cg_lookup_struct(ctx, local_type_addr) != none {
                                slot_is_indirect_addr = true
                            } elif cg_lookup_union_suffix(ctx, local_type_addr) != none {
                                slot_is_indirect_addr = true
                            }
                        }
                    }
                    if slot_is_indirect_addr {
                        return gen_list_ptr(ctx, inner4)
                    }
                    val slot_ref_addr: ref u8 = cg_qbe_value_ref(ctx, qbe_var_addr)
                    return slot_ref_addr
                }
                val local_type_ns: ref u8 = cg_local_type(ctx, iname)
                if cg_ann_is_indirect_value(ctx, local_type_ns) {
                    return cg_qbe_value_ref(ctx, qbe_var_addr)
                }
                val vqtype4: ref u8 = cg_var_qbe_type(ctx, iname)
                val slot_tmp4: i64 = fresh_tmp(ctx)
                val store_op4: mut ref u8 = c"storel"
                val alloc_op4: mut ref u8 = c"alloc8"
                val alloc_sz4: mut i64 = 8
                if str.raw_cmp(vqtype4, c"w") == 0 {
                    store_op4 = c"storew"
                    alloc_op4 = c"alloc4"
                    alloc_sz4 = 4
                } elif str.raw_cmp(vqtype4, c"s") == 0 {
                    store_op4 = c"stores"
                    alloc_op4 = c"alloc4"
                    alloc_sz4 = 4
                } elif str.raw_cmp(vqtype4, c"d") == 0 {
                    store_op4 = c"stored"
                }
                val val_ref4: ref u8 = cg_qbe_value_ref(ctx, qbe_var_addr)
                val spill_buf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(spill_buf4, 128, "    %%t{lld} =l {s} {lld}\n    {s} {s}, %%t{lld}\n",
                    {slot_tmp4, alloc_op4, alloc_sz4, store_op4, val_ref4, slot_tmp4})
                emit(ctx, spill_buf4)
                val res10: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(res10, 32, "%%t{lld}", {slot_tmp4})
                return res10
            }
            val resolved_fn: ref u8 = cg_resolve_fn_name(ctx, iname)
            if resolved_fn != none {
                val ext_fn: ref u8 = cg_lookup_extern_symbol(ctx, iname)
                val res_fn: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                if ext_fn != none {
                    @snprintf(res_fn, 256, "${s}", {ext_fn})
                } else {
                    @snprintf(res_fn, 256, "${s}", {resolved_fn})
                }
                return res_fn
            }
            val res10: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(res10, 32, "%%{s}", {iname})
            return res10
        }
        if inner4.kind == parser.NK_FIELD {
            return gen_field_storage_addr(ctx, inner4)
        }
        return gen_expr(ctx, inner4)
    }

    if k == parser.NK_DEREF {
        val inner5: ref u8 = gen_expr(ctx, expr.d0 as ref parser.Node)
        val tmp8: i64 = fresh_tmp(ctx)
        val pointee: ref u8 = cg_ann_deref(infer_type_annotation(ctx, expr.d0 as ref parser.Node))
        if cg_lookup_struct(ctx, pointee) != none ||
        cg_lookup_union_suffix(ctx, pointee) != none {
            return inner5
        }
        val load_op: ref u8 = scalar_load_instr_for_name(pointee)
        val load_qtype: ref u8 = scalar_load_qtype_for_name(pointee)
        val buf13: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(buf13, 128, "    %%t{lld} ={s} {s} {s}\n", {tmp8, load_qtype, load_op, inner5})
        emit(
            ctx,
            buf13
        )
        val res11: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res11, 16, "%%t{lld}", {tmp8})
        return res11
    }

    if k == parser.NK_ARGS_PACK {
        if cg_rewrite_empty_struct_init(ctx, expr) {
            return gen_struct_lit(ctx, expr)
        }
        // args pack — return the list pointer; caller handles unpacking
        val elist: ref void = expr.d0 as ref void
        val elen: i64 = @len(elist) as i64
        if elen == 0 {
            return c"0"
        }
        // just return the first element for single-arg packs
        val e_opt = @get(elist, 0)
        if e_opt is some e {
            return gen_expr(ctx, e as ref parser.Node)
        } else {
            return c"0"
        }
    }

    if k == parser.NK_LIST_LIT {
        return gen_list_lit(ctx, expr)
    }

    if k == parser.NK_STRUCT_LIT {
        return gen_struct_lit(ctx, expr)
    }

    if k == parser.NK_ZERO_INIT {
        val tmp9: i64 = fresh_tmp(ctx)
        val buf14: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(
            buf14,
            64,
            "    %%t{lld} =l alloc8 64\n    call $memset(l %%t{lld}, w 0, l 64)\n",
            {tmp9, tmp9}
        )
        emit(
            ctx,
            buf14
        )
        val res12: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res12, 16, "%%t{lld}", {tmp9})
        return res12
    }

    if k == parser.NK_TRY {
        return gen_try(ctx, expr)
    }

    // fallback
    val tmp10: i64 = fresh_tmp(ctx)
    val buf15: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(buf15, 64, "    %%t{lld} =l copy 0\n", {tmp10})
    emit(
        ctx,
        buf15
    )
    val res13: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res13, 16, "%%t{lld}", {tmp10})
    return res13
}

/// Check if an expression is float-typed by examining its structure
fn expr_is_float(ctx: mut ref CgCtx, expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    val k: i64 = expr.kind
    if k == parser.NK_FLOAT_LIT {
        return true
    }
    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val qtype: ref u8 = cg_direct_type(ctx, name)
        if str.raw_cmp(qtype, c"d") == 0 || str.raw_cmp(qtype, c"s") == 0 {
            return true
        }
        val ltype: ref u8 = cg_local_type(ctx, name)
        if str.raw_cmp(ltype, c"f64") == 0 || str.raw_cmp(ltype, c"f32") == 0 {
            return true
        }
        val cval: ref u8 = cg_const_val(ctx, name)
        if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") {
            return true
        }
        return false
    }
    if k == parser.NK_FIELD {
        val ann: ref u8 = infer_type_annotation(ctx, expr)
        if str.raw_cmp(ann, c"f64") == 0 || str.raw_cmp(ann, c"f32") == 0 {
            return true
        }
        return false
    }
    if k == parser.NK_CALL || k == parser.NK_CAST || k == parser.NK_TRUST {
        val qtype: ref u8 = expr_qbe_type(ctx, expr)
        return str.raw_cmp(qtype, c"d") == 0 || str.raw_cmp(qtype, c"s") == 0
    }
    if k == parser.NK_BINOP {
        val lhs_float: bool = expr_is_float(ctx, parser.binop_left(expr))
        val rhs_float: bool = expr_is_float(ctx, parser.binop_right(expr))
        return lhs_float || rhs_float
    }
    if k == parser.NK_UNOP {
        return expr_is_float(ctx, parser.unop_inner(expr))
    }
    return false
}

/// Infer the QBE type of an expression.
fn expr_qbe_type(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c"l"
    }

    val k: i64 = expr.kind

    if k == parser.NK_INT_LIT || k == parser.NK_STR_LIT || k == parser.NK_NONE {
        return c"l"
    }
    if k == parser.NK_FLOAT_LIT {
        if ctx.expected_ty != none {
            val expected_qt: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
            if str.raw_cmp(expected_qt, c"s") == 0 {
                return c"s"
            }
        }
        return c"d"
    }
    if k == parser.NK_BOOL || k == parser.NK_CHAR_LIT {
        return c"w"
    }

    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(expr.d0)
        val cval_ident: ref u8 = cg_const_val(ctx, name)
        if str.raw_cmp(cval_ident, c"") != 0 {
            if raw_starts_with(cval_ident, c"s_") {
                return c"s"
            }
            if raw_starts_with(cval_ident, c"d_") {
                if ctx.expected_ty != none {
                    val expected_qt_ident: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
                    if str.raw_cmp(expected_qt_ident, c"s") == 0 {
                        return c"s"
                    }
                }
                return c"d"
            }
            return c"l"
        }
        val dqt_opt: ref u8 = cg_direct_type(ctx, name)
        if str.raw_cmp(dqt_opt, c"") != 0 {
            return dqt_opt
        }

        val ltype: ref u8 = cg_local_type(ctx, name)
        if str.raw_cmp(ltype, c"") != 0 {
            if cg_is_local_ref_type(ctx, name) {
                return c"l"
            }
            if is_word_type_name(ltype) {
                return c"w"
            }
            if str.raw_cmp(ltype, c"f64") == 0 {
                return c"d"
            }
            if str.raw_cmp(ltype, c"f32") == 0 {
                return c"s"
            }
            return c"l"
        }
        return c"l"
    }

    if k == parser.NK_FIELD {
        val ann: ref u8 = infer_type_annotation(ctx, expr)
        if str.raw_cmp(ann, c"f64") == 0 {
            return c"d"
        }
        if str.raw_cmp(ann, c"f32") == 0 {
            return c"s"
        }
        if is_word_type_name(ann) {
            return c"w"
        }
        return c"l"
    }

    if k == parser.NK_TRUST {
        return expr_qbe_type(ctx, expr.d0 as ref parser.Node)
    }

    if k == parser.NK_DEREF {
        val deref_inner: ref parser.Node = expr.d0 as ref parser.Node
        val pointee_ann: ref u8 = cg_ann_deref(infer_type_annotation(ctx, deref_inner))
        return cg_ann_qtype(pointee_ann)
    }

    if k == parser.NK_CALL {
        val callee_node: ref parser.Node = parser.call_callee(expr)
        val ret_ty_node: ref parser.Node = cg_infer_call_ret_ty(ctx, expr)
        if ret_ty_node != none {
            return qbe_type_of(ret_ty_node)
        }
        val callee_name: ref u8 = resolve_callee_name(ctx, callee_node)
        val ext_ret_ty_node: ref void = cg_lookup_ext_ret(ctx, callee_name)
        if ext_ret_ty_node != none {
            return qbe_type_of(ext_ret_ty_node as ref parser.Node)
        }

        val fn_ret_ty_node: ref void = cg_lookup_fn_ret(ctx, callee_name)
        if fn_ret_ty_node != none {
            val ret_type: ref u8 = qbe_type_of(fn_ret_ty_node as ref parser.Node)
            return ret_type
        }

        val resolved_name: ref u8 = cg_resolve_fn_name(ctx, callee_name)
        if resolved_name != none {
            val fn_ret_ty_node2: ref void = cg_lookup_fn_ret(ctx, resolved_name)
            if fn_ret_ty_node2 != none {
                val ret_type2: ref u8 = qbe_type_of(fn_ret_ty_node2 as ref parser.Node)
                return ret_type2
            }
        }

        val fn_ret_ty_node3: ref parser.Node = cg_lookup_fn_ret_type_expr(ctx, callee_name)
        if fn_ret_ty_node3 != none {
            return qbe_type_of(fn_ret_ty_node3)
        }

        return c"l"
    }

    if k == parser.NK_CAST {
        val cast_ty_node: ref parser.Node = expr.d1 as ref parser.Node
        return qbe_type_of(cast_ty_node)
    }

    if k == parser.NK_BUILTIN {
        val bname_bc: ref u8 = parser.node_str_raw(expr.d0)
        if str.raw_cmp(bname_bc, c"bitcast") == 0 {
            val bargs_bc: ref void = expr.d1 as ref void
            if bargs_bc != none {
                val first_bc = @get(bargs_bc as list[ref parser.Node], 0 as usize)
                if first_bc is some first_node_bc {
                    return qbe_type_of(first_node_bc as ref parser.Node)
                }
            }
        }
    }

    if k == parser.NK_BINOP {
        val lhs_qbt = expr_qbe_type(ctx, parser.binop_left(expr))
        val rhs_qbt = expr_qbe_type(ctx, parser.binop_right(expr))
        if str.raw_cmp(lhs_qbt, c"d") == 0 || str.raw_cmp(lhs_qbt, c"s") == 0 ||
        str.raw_cmp(rhs_qbt, c"d") == 0 || str.raw_cmp(rhs_qbt, c"s") == 0 {
            return c"d"
        }
        if str.raw_cmp(lhs_qbt, c"l") == 0 || str.raw_cmp(rhs_qbt, c"l") == 0 {
            val op: i64 = parser.binop_op(expr)
            if op == parser.OP_EQ || op == parser.OP_NE || op == parser.OP_LT ||
            op == parser.OP_GT || op == parser.OP_LE || op == parser.OP_GE ||
            op == parser.OP_AND || op == parser.OP_OR {
                return c"w"
            }
            return c"l"
        }
        return c"w"
    }

    if k == parser.NK_UNOP {
        val op_qbt = expr_qbe_type(ctx, parser.unop_inner(expr))
        val op: i64 = parser.unop_op(expr)
        if op == parser.UOP_NEG {
            return op_qbt
        }
        if op == parser.UOP_NOT {
            return c"w"
        }
        if op == parser.UOP_BNOT {
            return op_qbt
        }
        return c"l"
    }

    return c"l"
}

fn expr_is_result(expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    val k: i64 = expr.kind
    if k == parser.NK_OK_VAL || k == parser.NK_ERR_VAL {
        return true
    }
    return false
}

fn expr_is_option(ctx: mut ref CgCtx, expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    if expr.kind == parser.NK_SOME || expr.kind == parser.NK_NONE {
        return true
    }
    val ann: ref u8 = infer_type_annotation(ctx, expr)
    return raw_starts_with(ann, c"option[")
}

fn option_inner_annotation(
    ctx: mut ref CgCtx,
    lhs: ref parser.Node,
    rhs: ref parser.Node
) ref u8 = trust {
    val lann: ref u8 = infer_type_annotation(ctx, lhs)
    val lin: ref u8 = parse_option_inner(lann)
    if str.raw_cmp(lin, c"") != 0 {
        return lin
    }
    if lhs != none && lhs.kind == parser.NK_SOME {
        return infer_type_annotation(ctx, lhs.d0 as ref parser.Node)
    }
    val rann: ref u8 = infer_type_annotation(ctx, rhs)
    val rin: ref u8 = parse_option_inner(rann)
    if str.raw_cmp(rin, c"") != 0 {
        return rin
    }
    if rhs != none && rhs.kind == parser.NK_SOME {
        return infer_type_annotation(ctx, rhs.d0 as ref parser.Node)
    }
    return c""
}

fn gen_binop(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val op: i64 = expr.d0 as i64
    val lhs_expr: ref parser.Node = expr.d1 as ref parser.Node
    val rhs_expr: ref parser.Node = expr.d2 as ref parser.Node

    if op == parser.OP_AND || op == parser.OP_OR {
        val lhs: ref u8 = gen_expr(ctx, lhs_expr)
        val rhs_lbl: i64 = fresh_lbl(ctx)
        val done_lbl: i64 = fresh_lbl(ctx)
        val slot: i64 = fresh_tmp(ctx)

        val sb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(sb, 128, "    %%t{lld} =l alloc4 1\n", {slot})
        emit(
            ctx,
            sb
        )
        val s0: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(s0, 128, "    storew {s}, %%t{lld}\n", {lhs, slot})
        emit(
            ctx,
            s0
        )
        val jb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        if op == parser.OP_AND {
            @snprintf(
                jb,
                128,
                "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                {lhs, rhs_lbl, done_lbl, rhs_lbl}
            )
        } else {
            @snprintf(
                jb,
                128,
                "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                {lhs, done_lbl, rhs_lbl, rhs_lbl}
            )
        }
        emit(ctx, jb)
        val rhs: ref u8 = gen_expr(ctx, rhs_expr)
        val sr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(
            sr,
            128,
            "    storew {s}, %%t{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n",
            {rhs, slot, done_lbl, done_lbl}
        )
        emit(ctx, sr)
        val result: i64 = fresh_tmp(ctx)
        val lb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(lb, 64, "    %%t{lld} =w loadw %%t{lld}\n", {result, slot})
        emit(
            ctx,
            lb
        )
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {result})
        return res
    }

    val lhs_is_result: bool = expr_is_result(lhs_expr)
    val rhs_is_result: bool = expr_is_result(rhs_expr)

    if ((lhs_is_result || rhs_is_result) && (op == parser.OP_EQ || op == parser.OP_NE)) {
        val lhs: ref u8 = gen_expr(ctx, lhs_expr)
        val rhs: ref u8 = gen_expr(ctx, rhs_expr)
        val l_tag: i64 = fresh_tmp(ctx)
        val r_tag: i64 = fresh_tmp(ctx)
        val tag_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(
            tag_buf,
            128,
            "    %%t{lld} =l loadl {s}\n    %%t{lld} =l loadl {s}\n",
            {l_tag, lhs, r_tag, rhs}
        )
        emit(ctx, tag_buf)
        val tags_eq: i64 = fresh_tmp(ctx)
        val tags_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(
            tags_buf,
            128,
            "    %%t{lld} =w ceql %%t{lld}, %%t{lld}\n",
            {tags_eq, l_tag, r_tag}
        )
        emit(ctx, tags_buf)
        val l_val_ptr: i64 = fresh_tmp(ctx)
        val r_val_ptr: i64 = fresh_tmp(ctx)
        val ptr_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(
            ptr_buf,
            128,
            "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 8\n",
            {l_val_ptr, lhs, r_val_ptr, rhs}
        )
        emit(ctx, ptr_buf)
        val result_literal: mut ref parser.Node = none
        if lhs_is_result {
            result_literal = lhs_expr
        } else {
            result_literal = rhs_expr
        }
        val payload_expr: ref parser.Node = result_literal.d0 as ref parser.Node
        val payload_is_float: bool = expr_is_float(ctx, payload_expr)

        val vals_eq: i64 = fresh_tmp(ctx)
        if payload_is_float {
            val l_val: i64 = fresh_tmp(ctx)
            val r_val: i64 = fresh_tmp(ctx)
            val load_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                load_buf,
                128,
                "    %%t{lld} =d loadd %%t{lld}\n    %%t{lld} =d loadd %%t{lld}\n",
                {l_val, l_val_ptr, r_val, r_val_ptr}
            )
            emit(
                ctx,
                load_buf
            )
            val cmp_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                cmp_buf,
                128,
                "    %%t{lld} =w ceqd %%t{lld}, %%t{lld}\n",
                {vals_eq, l_val, r_val}
            )
            emit(ctx, cmp_buf)
        } else {
            val l_val: i64 = fresh_tmp(ctx)
            val r_val: i64 = fresh_tmp(ctx)
            val load_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                load_buf,
                128,
                "    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
                {l_val, l_val_ptr, r_val, r_val_ptr}
            )
            emit(
                ctx,
                load_buf
            )
            val cmp_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                cmp_buf,
                128,
                "    %%t{lld} =w ceql %%t{lld}, %%t{lld}\n",
                {vals_eq, l_val, r_val}
            )
            emit(ctx, cmp_buf)
        }

        val both: i64 = fresh_tmp(ctx)
        val and_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(
            and_buf,
            128,
            "    %%t{lld} =w and %%t{lld}, %%t{lld}\n",
            {both, tags_eq, vals_eq}
        )
        emit(ctx, and_buf)
        val result: i64 = fresh_tmp(ctx)
        val res_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        if op == parser.OP_NE {
            @snprintf(res_buf, 128, "    %%t{lld} =w ceqw %%t{lld}, 0\n", {result, both})
        } else {
            @snprintf(res_buf, 128, "    %%t{lld} =w copy %%t{lld}\n", {result, both})
        }
        emit(
            ctx,
            res_buf
        )
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {result})
        return res
    }

    val lhs_is_option: bool = expr_is_option(ctx, lhs_expr)
    val rhs_is_option: bool = expr_is_option(ctx, rhs_expr)
    if ((lhs_is_option || rhs_is_option) && (op == parser.OP_EQ || op == parser.OP_NE)) {
        val lhs: ref u8 = gen_expr(ctx, lhs_expr)
        val rhs: ref u8 = gen_expr(ctx, rhs_expr)
        val l_non: i64 = fresh_tmp(ctx)
        val r_non: i64 = fresh_tmp(ctx)
        val l_zero: i64 = fresh_tmp(ctx)
        val r_zero: i64 = fresh_tmp(ctx)
        val both_zero: i64 = fresh_tmp(ctx)
        val slot: i64 = fresh_tmp(ctx)
        val lhs_ok_lbl: i64 = fresh_lbl(ctx)
        val payload_lbl: i64 = fresh_lbl(ctx)
        val done_lbl: i64 = fresh_lbl(ctx)
        val head_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(head_buf, 512,
            "    %%t{lld} =l alloc4 1\n    %%t{lld} =w ceql {s}, 0\n    %%t{lld} =w ceql {s}, 0\n    %%t{lld} =w cnel {s}, 0\n    %%t{lld} =w cnel {s}, 0\n    %%t{lld} =w and %%t{lld}, %%t{lld}\n    storew %%t{lld}, %%t{lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {
                slot,
                l_zero,
                lhs,
                r_zero,
                rhs,
                l_non,
                lhs,
                r_non,
                rhs,
                both_zero,
                l_zero,
                r_zero,
                both_zero,
                slot,
                l_non,
                lhs_ok_lbl,
                done_lbl,
                lhs_ok_lbl
            })
        emit(ctx, head_buf)
        val jump_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(jump_buf, 256,
            "    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {r_non, payload_lbl, done_lbl, payload_lbl})
        emit(ctx, jump_buf)
        val l_ptr: i64 = fresh_tmp(ctx)
        val r_ptr: i64 = fresh_tmp(ctx)
        val l_val: i64 = fresh_tmp(ctx)
        val r_val: i64 = fresh_tmp(ctx)
        val vals_eq: i64 = fresh_tmp(ctx)
        val inner_ann: ref u8 = option_inner_annotation(ctx, lhs_expr, rhs_expr)
        val pay_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            768 as usize
        ) as ref u8
        if str.raw_cmp(inner_ann, c"f64") == 0 {
            @snprintf(pay_buf, 768,
                "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 8\n    %%t{lld} =d loadd %%t{lld}\n    %%t{lld} =d loadd %%t{lld}\n    %%t{lld} =w ceqd %%t{lld}, %%t{lld}\n    storew %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                {
                    l_ptr,
                    lhs,
                    r_ptr,
                    rhs,
                    l_val,
                    l_ptr,
                    r_val,
                    r_ptr,
                    vals_eq,
                    l_val,
                    r_val,
                    vals_eq,
                    slot,
                    done_lbl
                })
        } elif str.raw_cmp(inner_ann, c"f32") == 0 {
            @snprintf(pay_buf, 768,
                "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 8\n    %%t{lld} =s loads %%t{lld}\n    %%t{lld} =s loads %%t{lld}\n    %%t{lld} =w ceqs %%t{lld}, %%t{lld}\n    storew %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                {
                    l_ptr,
                    lhs,
                    r_ptr,
                    rhs,
                    l_val,
                    l_ptr,
                    r_val,
                    r_ptr,
                    vals_eq,
                    l_val,
                    r_val,
                    vals_eq,
                    slot,
                    done_lbl
                })
        } else {
            @snprintf(pay_buf, 768,
                "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =w ceql %%t{lld}, %%t{lld}\n    storew %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                {
                    l_ptr,
                    lhs,
                    r_ptr,
                    rhs,
                    l_val,
                    l_ptr,
                    r_val,
                    r_ptr,
                    vals_eq,
                    l_val,
                    r_val,
                    vals_eq,
                    slot,
                    done_lbl
                })
        }
        emit(ctx, pay_buf)
        val result: i64 = fresh_tmp(ctx)
        val tail_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        if op == parser.OP_NE {
            @snprintf(tail_buf, 256,
                "@lbl{lld}\n    %%t{lld} =w loadw %%t{lld}\n    %%t{lld} =w ceqw %%t{lld}, 0\n",
                {done_lbl, result, slot, result, result})
        } else {
            @snprintf(
                tail_buf,
                256,
                "@lbl{lld}\n    %%t{lld} =w loadw %%t{lld}\n",
                {done_lbl, result, slot}
            )
        }
        emit(ctx, tail_buf)
        val out: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(out, 16, "%%t{lld}", {result})
        return out
    }

    val is_float: bool = expr_is_float(ctx, lhs_expr) || expr_is_float(ctx, rhs_expr)
    val lhs_qbt: ref u8 = expr_qbe_type(ctx, lhs_expr)
    val rhs_qbt: ref u8 = expr_qbe_type(ctx, rhs_expr)
    val lhs_const_val: mut ref u8 = c""
    val rhs_const_val: mut ref u8 = c""
    if lhs_expr.kind == parser.NK_IDENT {
        lhs_const_val = cg_const_val(ctx, parser.node_str_raw(lhs_expr.d0))
    }
    if rhs_expr.kind == parser.NK_IDENT {
        rhs_const_val = cg_const_val(ctx, parser.node_str_raw(rhs_expr.d0))
    }
    val lhs_is_word: mut bool = str.raw_cmp(lhs_qbt, c"w") == 0
    val rhs_is_word: mut bool = str.raw_cmp(rhs_qbt, c"w") == 0
    if !lhs_is_word && lhs_expr.kind == parser.NK_CALL {
        val lhs_cn: ref parser.Node = parser.call_callee(lhs_expr)
        val lhs_ret: mut ref parser.Node = cg_infer_call_ret_ty(ctx, lhs_expr)
        if lhs_ret == none {
            val lhs_cname: ref u8 = resolve_callee_name(ctx, lhs_cn)
            lhs_ret = cg_lookup_fn_ret_type_expr(ctx, lhs_cname)
        }
        if lhs_ret != none && str.raw_cmp(qbe_type_of(lhs_ret), c"w") == 0 {
            lhs_is_word = true
        }
    }
    if !rhs_is_word && rhs_expr.kind == parser.NK_CALL {
        val rhs_cn: ref parser.Node = parser.call_callee(rhs_expr)
        val rhs_ret: mut ref parser.Node = cg_infer_call_ret_ty(ctx, rhs_expr)
        if rhs_ret == none {
            val rhs_cname: ref u8 = resolve_callee_name(ctx, rhs_cn)
            rhs_ret = cg_lookup_fn_ret_type_expr(ctx, rhs_cname)
        }
        if rhs_ret != none && str.raw_cmp(qbe_type_of(rhs_ret), c"w") == 0 {
            rhs_is_word = true
        }
    }
    val lhs_is_int_lit: bool = lhs_expr.kind == parser.NK_INT_LIT || (lhs_expr.kind == parser.NK_IDENT && cg_is_int_const_val(lhs_const_val))
    val rhs_is_int_lit: bool = rhs_expr.kind == parser.NK_INT_LIT || (rhs_expr.kind == parser.NK_IDENT && cg_is_int_const_val(rhs_const_val))
    val is_comparison: bool = op == parser.OP_EQ || op == parser.OP_NE || op == parser.OP_LT ||
    op == parser.OP_GT || op == parser.OP_LE || op == parser.OP_GE
    val target_type: mut ref u8 = c"l"

    if !is_float && is_comparison {
        if ((lhs_is_word && rhs_is_int_lit) || (rhs_is_word && lhs_is_int_lit)) {
            target_type = c"w"
        }
    }

    val lhs: ref u8 = gen_expr_with_type(ctx, lhs_expr, target_type)
    val rhs: ref u8 = gen_expr_with_type(ctx, rhs_expr, target_type)
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    val lhs_l: mut ref u8 = lhs
    val rhs_l: mut ref u8 = rhs
    val both_word: bool = (lhs_is_word && rhs_is_word) ||
    (lhs_is_word && rhs_is_int_lit) ||
    (rhs_is_word && lhs_is_int_lit)

    if op == parser.OP_EQ || op == parser.OP_NE || op == parser.OP_LT ||
    op == parser.OP_GT || op == parser.OP_LE || op == parser.OP_GE {
        if !both_word {
            if str.raw_cmp(lhs_qbt, c"w") == 0 {
                val ext_tmp: i64 = fresh_tmp(ctx)
                val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, lhs_l})
                emit(
                    ctx,
                    ext_buf
                )
                lhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
                @snprintf(lhs_l, 16, "%%t{lld}", {ext_tmp})
            }
            if str.raw_cmp(rhs_qbt, c"w") == 0 {
                val ext_tmp: i64 = fresh_tmp(ctx)
                val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, rhs_l})
                emit(
                    ctx,
                    ext_buf
                )
                rhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
                @snprintf(rhs_l, 16, "%%t{lld}", {ext_tmp})
            }
        }
    }

    if is_float {
        if str.raw_cmp(lhs_qbt, c"s") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =d exts {s}\n", {ext_tmp, lhs_l})
            emit(
                ctx,
                ext_buf
            )
            lhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(lhs_l, 16, "%%t{lld}", {ext_tmp})
        }
        if str.raw_cmp(rhs_qbt, c"s") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =d exts {s}\n", {ext_tmp, rhs_l})
            emit(
                ctx,
                ext_buf
            )
            rhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(rhs_l, 16, "%%t{lld}", {ext_tmp})
        }
    }

    if op == parser.OP_BAND || op == parser.OP_BOR || op == parser.OP_BXOR ||
    op == parser.OP_SHL || op == parser.OP_SHR ||
    op == parser.OP_ADD || op == parser.OP_SUB || op == parser.OP_MUL ||
    op == parser.OP_DIV || op == parser.OP_REM {
        if str.raw_cmp(lhs_qbt, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, lhs_l})
            emit(
                ctx,
                ext_buf
            )
            lhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(lhs_l, 16, "%%t{lld}", {ext_tmp})
        }
        if str.raw_cmp(rhs_qbt, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, rhs_l})
            emit(
                ctx,
                ext_buf
            )
            rhs_l = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(rhs_l, 16, "%%t{lld}", {ext_tmp})
        }
    }

    if is_float {
        if op == parser.OP_ADD {
            @snprintf(buf, 256, "    %%t{lld} =d add {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_SUB {
            @snprintf(buf, 256, "    %%t{lld} =d sub {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_MUL {
            @snprintf(buf, 256, "    %%t{lld} =d mul {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_DIV {
            @snprintf(buf, 256, "    %%t{lld} =d div {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_REM {
            @snprintf(buf, 256, "    %%t{lld} =d rem {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_EQ {
            @snprintf(buf, 256, "    %%t{lld} =w ceqd {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_NE {
            @snprintf(buf, 256, "    %%t{lld} =w cned {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_LT {
            @snprintf(buf, 256, "    %%t{lld} =w cltd {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_GT {
            @snprintf(buf, 256, "    %%t{lld} =w cgtd {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_LE {
            @snprintf(buf, 256, "    %%t{lld} =w cled {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_GE {
            @snprintf(buf, 256, "    %%t{lld} =w cged {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } else {
            @snprintf(buf, 256, "    %%t{lld} =l copy 0\n", {tmp})
        }
    } else {
        if op == parser.OP_ADD {
            @snprintf(buf, 256, "    %%t{lld} =l add {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_SUB {
            @snprintf(buf, 256, "    %%t{lld} =l sub {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_MUL {
            @snprintf(buf, 256, "    %%t{lld} =l mul {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_DIV {
            @snprintf(buf, 256, "    %%t{lld} =l div {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_REM {
            @snprintf(buf, 256, "    %%t{lld} =l rem {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_EQ {
            if both_word {
                @snprintf(buf, 256, "    %%t{lld} =w ceqw {s}, {s}\n", {tmp, lhs, rhs})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =w ceql {s}, {s}\n", {tmp, lhs_l, rhs_l})
            }
        } elif op == parser.OP_NE {
            if both_word {
                @snprintf(buf, 256, "    %%t{lld} =w cnew {s}, {s}\n", {tmp, lhs, rhs})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =w cnel {s}, {s}\n", {tmp, lhs_l, rhs_l})
            }
        } elif op == parser.OP_LT {
            if both_word {
                @snprintf(buf, 256, "    %%t{lld} =w csltw {s}, {s}\n", {tmp, lhs, rhs})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =w csltl {s}, {s}\n", {tmp, lhs_l, rhs_l})
            }
        } elif op == parser.OP_GT {
            if both_word {
                @snprintf(buf, 256, "    %%t{lld} =w csgtw {s}, {s}\n", {tmp, lhs, rhs})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =w csgtl {s}, {s}\n", {tmp, lhs_l, rhs_l})
            }
        } elif op == parser.OP_LE {
            if both_word {
                @snprintf(buf, 256, "    %%t{lld} =w cslew {s}, {s}\n", {tmp, lhs, rhs})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =w cslel {s}, {s}\n", {tmp, lhs_l, rhs_l})
            }
        } elif op == parser.OP_GE {
            val lt: i64 = fresh_tmp(ctx)
            if both_word {
                @snprintf(
                    buf,
                    256,
                    "    %%t{lld} =w csltw {s}, {s}\n    %%t{lld} =w ceqw %%t{lld}, 0\n",
                    {lt, lhs, rhs, tmp, lt}
                )
            } else {
                @snprintf(
                    buf,
                    256,
                    "    %%t{lld} =w csltl {s}, {s}\n    %%t{lld} =w ceqw %%t{lld}, 0\n",
                    {lt, lhs_l, rhs_l, tmp, lt}
                )
            }
        } elif op == parser.OP_BAND {
            @snprintf(buf, 256, "    %%t{lld} =l and {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_BOR {
            @snprintf(buf, 256, "    %%t{lld} =l or {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_BXOR {
            @snprintf(buf, 256, "    %%t{lld} =l xor {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_SHL {
            @snprintf(buf, 256, "    %%t{lld} =l shl {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } elif op == parser.OP_SHR {
            @snprintf(buf, 256, "    %%t{lld} =l shr {s}, {s}\n", {tmp, lhs_l, rhs_l})
        } else {
            @snprintf(buf, 256, "    %%t{lld} =l copy 0\n", {tmp})
        }
    }

    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn gen_unop(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val op: i64 = expr.d0 as i64
    val inner_expr: ref parser.Node = expr.d1 as ref parser.Node
    val inner: ref u8 = gen_expr(ctx, inner_expr)
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    val is_float: bool = expr_is_float(ctx, inner_expr)
    val inner_qt: ref u8 = expr_qbe_type(ctx, inner_expr)

    if op == parser.UOP_NOT {
        @snprintf(buf, 128, "    %%t{lld} =w ceqw {s}, 0\n", {tmp, inner})
    } elif op == parser.UOP_NEG {
        if is_float {
            val neg_qt: mut ref u8 = c"d"
            if str.raw_cmp(inner_qt, c"s") == 0 {
                neg_qt = c"s"
            }
            @snprintf(buf, 128, "    %%t{lld} ={s} sub {s}_0, {s}\n", {tmp, neg_qt, neg_qt, inner})
        } else {
            @snprintf(buf, 128, "    %%t{lld} =l neg {s}\n", {tmp, inner})
        }
    } elif op == parser.UOP_BNOT {
        if str.raw_cmp(inner_qt, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(ext_buf, 64, "    %%t{lld} =l extsw {s}\n", {ext_tmp, inner})
            emit(
                ctx,
                ext_buf
            )
            @snprintf(buf, 128, "    %%t{lld} =l xor %%t{lld}, -1\n", {tmp, ext_tmp})
        } else {
            @snprintf(buf, 128, "    %%t{lld} =l xor {s}, -1\n", {tmp, inner})
        }
    } else {
        @snprintf(buf, 128, "    %%t{lld} =l copy 0\n", {tmp})
    }
    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

/// Strip a leading `mut ` from a type annotation used for pointer access.
fn scalar_access_type_name(name: ref u8) ref u8 = trust {
    if name == none {
        return none
    }
    if raw_starts_with(name, c"mut ") {
        return @ptradd(name, 4) as ref u8
    }
    return name
}

/// Return the QBE load instruction for a scalar pointee type.
fn scalar_load_instr_for_name(name: ref u8) ref u8 = trust {
    val n: ref u8 = scalar_access_type_name(name)
    if n == none {
        return c"loadl"
    }
    if str.raw_cmp(n, c"u8") == 0 || str.raw_cmp(n, c"bool") == 0 {
        return c"loadub"
    }
    if str.raw_cmp(n, c"i8") == 0 {
        return c"loadsb"
    }
    if str.raw_cmp(n, c"u16") == 0 {
        return c"loaduh"
    }
    if str.raw_cmp(n, c"i16") == 0 {
        return c"loadsh"
    }
    if str.raw_cmp(n, c"u32") == 0 {
        return c"loaduw"
    }
    if str.raw_cmp(n, c"i32") == 0 {
        return c"loadsw"
    }
    if str.raw_cmp(n, c"f32") == 0 {
        return c"loads"
    }
    if str.raw_cmp(n, c"f64") == 0 {
        return c"loadd"
    }
    return c"loadl"
}

/// Return the QBE value type produced by a scalar load.
fn scalar_load_qtype_for_name(name: ref u8) ref u8 = trust {
    val n: ref u8 = scalar_access_type_name(name)
    if n == none {
        return c"l"
    }
    if str.raw_cmp(n, c"u8") == 0 || str.raw_cmp(n, c"i8") == 0 ||
    str.raw_cmp(n, c"u16") == 0 || str.raw_cmp(n, c"i16") == 0 ||
    str.raw_cmp(n, c"u32") == 0 || str.raw_cmp(n, c"i32") == 0 ||
    str.raw_cmp(n, c"bool") == 0 {
        return c"w"
    }
    if str.raw_cmp(n, c"f32") == 0 {
        return c"s"
    }
    if str.raw_cmp(n, c"f64") == 0 {
        return c"d"
    }
    return c"l"
}

/// Return the QBE store instruction for a scalar pointee type.
fn scalar_store_instr_for_name(name: ref u8) ref u8 = trust {
    val n: ref u8 = scalar_access_type_name(name)
    if n == none {
        return c"storel"
    }
    if str.raw_cmp(n, c"u8") == 0 || str.raw_cmp(n, c"i8") == 0 ||
    str.raw_cmp(n, c"bool") == 0 {
        return c"storeb"
    }
    if str.raw_cmp(n, c"u16") == 0 || str.raw_cmp(n, c"i16") == 0 {
        return c"storeh"
    }
    if str.raw_cmp(n, c"u32") == 0 || str.raw_cmp(n, c"i32") == 0 {
        return c"storew"
    }
    if str.raw_cmp(n, c"f32") == 0 {
        return c"stores"
    }
    if str.raw_cmp(n, c"f64") == 0 {
        return c"stored"
    }
    return c"storel"
}

/// Return the QBE value type expected by a scalar store.
fn scalar_store_qtype_for_name(name: ref u8) ref u8 = trust {
    val n: ref u8 = scalar_access_type_name(name)
    if n == none {
        return c"l"
    }
    if str.raw_cmp(n, c"u8") == 0 || str.raw_cmp(n, c"i8") == 0 ||
    str.raw_cmp(n, c"u16") == 0 || str.raw_cmp(n, c"i16") == 0 ||
    str.raw_cmp(n, c"u32") == 0 || str.raw_cmp(n, c"i32") == 0 ||
    str.raw_cmp(n, c"bool") == 0 {
        return c"w"
    }
    if str.raw_cmp(n, c"f32") == 0 {
        return c"s"
    }
    if str.raw_cmp(n, c"f64") == 0 {
        return c"d"
    }
    return c"l"
}

fn field_load_instr_for(ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"loadl"
    }
    val k: i64 = ty.kind
    if k == parser.TY_MUT {
        return field_load_instr_for(ty.d0 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        val name: ref u8 = parser.node_str_raw(ty.d0)
        if str.raw_cmp(name, c"f64") == 0 {
            return c"loadd"
        }
        if str.raw_cmp(name, c"f32") == 0 {
            return c"loads"
        }
        if str.raw_cmp(name, c"i32") == 0 {
            return c"loadsw"
        }
        if str.raw_cmp(name, c"u32") == 0 {
            return c"loaduw"
        }
        if str.raw_cmp(name, c"i16") == 0 {
            return c"loadsh"
        }
        if str.raw_cmp(name, c"u16") == 0 {
            return c"loaduh"
        }
        if str.raw_cmp(name, c"i8") == 0 {
            return c"loadsb"
        }
        if str.raw_cmp(name, c"u8") == 0 {
            return c"loadub"
        }
        if str.raw_cmp(name, c"bool") == 0 {
            return c"loadub"
        }
        if str.raw_cmp(name, c"u8") == 0 {
            return c"loadub"
        }
    }
    return c"loadl"
}

fn field_store_instr_for_struct(
    ctx: mut ref CgCtx,
    owner_fields: ref void,
    ty: ref parser.Node
) ref u8 = trust {
    if owner_fields != none && cg_struct_uses_c_abi(ctx, owner_fields) {
        val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
        if resolved != none && resolved.kind == parser.TY_MUT {
            return field_store_instr_for_struct(ctx, owner_fields, resolved.d0 as ref parser.Node)
        }
        if resolved != none && resolved.kind == parser.TY_NAMED {
            val name: ref u8 = parser.node_str_raw(resolved.d0)
            if str.raw_cmp(name, c"f64") == 0 {
                return c"stored"
            }
            if str.raw_cmp(name, c"f32") == 0 {
                return c"stores"
            }
        }
        val sz: i64 = cg_c_abi_type_size(ctx, resolved)
        if sz <= 1 {
            return c"storeb"
        }
        if sz == 2 {
            return c"storeh"
        }
        if sz == 4 {
            return c"storew"
        }
        return c"storel"
    }
    // Non-C-ABI structs use packed field offsets, so the store width must
    // match the field's in-memory size rather than the QBE value type. Using
    // `storew` for a u8/u16 field would clobber adjacent fields.
    val resolved_nc: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved_nc != none && resolved_nc.kind == parser.TY_MUT {
        return field_store_instr_for_struct(ctx, owner_fields, resolved_nc.d0 as ref parser.Node)
    }
    if resolved_nc != none && resolved_nc.kind == parser.TY_NAMED {
        val name_nc: ref u8 = parser.node_str_raw(resolved_nc.d0)
        if str.raw_cmp(name_nc, c"f64") == 0 {
            return c"stored"
        }
        if str.raw_cmp(name_nc, c"f32") == 0 {
            return c"stores"
        }
        val sz_nc: i64 = type_size(resolved_nc)
        if sz_nc <= 1 {
            return c"storeb"
        }
        if sz_nc == 2 {
            return c"storeh"
        }
        if sz_nc == 4 {
            return c"storew"
        }
    }
    return c"storel"
}

/// Coerce an expression value to the QBE type expected by a field store.
fn cg_coerce_store_value(
    ctx: mut ref CgCtx,
    value: ref u8,
    val_qtype: ref u8,
    store_op: ref u8
) ref u8 = trust {
    val vq: ref u8 = cg_normalize_qtype(val_qtype)
    if str.raw_cmp(store_op, c"stores") == 0 {
        return cg_coerce_qtype(ctx, value, vq, c"s")
    }
    if str.raw_cmp(store_op, c"stored") == 0 {
        return cg_coerce_qtype(ctx, value, vq, c"d")
    }
    if str.raw_cmp(store_op, c"storel") == 0 && str.raw_cmp(vq, c"w") == 0 {
        val ext_tmp: i64 = fresh_tmp(ctx)
        val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(ext_buf, 64, "    %%t{lld} =l extsw {s}\n", {ext_tmp, value})
        emit(
            ctx,
            ext_buf
        )
        val ext_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(ext_res, 16, "%%t{lld}", {ext_tmp})
        return ext_res
    }
    return value
}

/// Generate an expression for a field initializer and coerce it to the type
/// required by the field's store instruction.
fn cg_gen_expr_for_store(
    ctx: mut ref CgCtx,
    expr: ref parser.Node,
    expected_ty: ref parser.Node,
    store_op: ref u8
) ref u8 = trust {
    val old_expected: ref parser.Node = ctx.expected_ty as ref parser.Node
    ctx.expected_ty = expected_ty
    val raw: ref u8 = gen_expr(ctx, expr)
    val raw_qtype: ref u8 = expr_qbe_type(ctx, expr)
    ctx.expected_ty = old_expected
    return cg_coerce_store_value(ctx, raw, raw_qtype, store_op)
}

fn gen_field(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val base_expr: ref parser.Node = expr.d0 as ref parser.Node
    val field_name: ref u8 = parser.node_str_raw(expr.d1)
    if cg_is_c_escape_expr(expr) {
        val raw_name: ref u8 = cg_raw_c_name(ctx, expr)
        if str.raw_cmp(raw_name, c"") != 0 {
            val sym: ref u8 = cg_c_const_symbol(ctx, raw_name)
            val tmp_raw: i64 = fresh_tmp(ctx)
            val raw_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(raw_buf, 256, "    %%t{lld} =l loadl ${s}\n", {tmp_raw, sym})
            emit(
                ctx,
                raw_buf
            )
            val raw_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(raw_res, 16, "%%t{lld}", {tmp_raw})
            return raw_res
        }
        val tmp_raw2: i64 = fresh_tmp(ctx)
        val raw_buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(raw_buf2, 256, "    %%t{lld} =l copy 0\n", {tmp_raw2})
        emit(
            ctx,
            raw_buf2
        )
        val raw_res2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(raw_res2, 16, "%%t{lld}", {tmp_raw2})
        return raw_res2
    }

    if base_expr != none && base_expr.kind == parser.NK_FIELD {
        val mid_expr: ref parser.Node = parser.field_base(base_expr)
        val mid_name: ref u8 = parser.field_name_raw(base_expr)
        if mid_expr != none && mid_expr.kind == parser.NK_IDENT {
            val mid_base_name: ref u8 = parser.node_str_raw(mid_expr.d0)
            val enum_key3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(enum_key3, 512, "{s}__{s}__{s}", {mid_base_name, mid_name, field_name})
            val const_val3: ref u8 = cg_const_val(
                ctx,
                enum_key3
            )
            if str.raw_cmp(const_val3, c"") != 0 {
                val tmp3: i64 = fresh_tmp(ctx)
                val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                if raw_starts_with(const_val3, c"d_") || raw_starts_with(const_val3, c"s_") {
                    val ftext3: ref u8 = @ptradd(const_val3, 2) as ref u8
                    val emit_qt3: mut ref u8 = c"d"
                    if raw_starts_with(const_val3, c"s_") {
                        emit_qt3 = c"s"
                    }
                    if ctx.expected_ty != none {
                        val expected_qt_field3: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
                        if str.raw_cmp(expected_qt_field3, c"s") == 0 {
                            emit_qt3 = c"s"
                        } elif str.raw_cmp(expected_qt_field3, c"d") == 0 {
                            emit_qt3 = c"d"
                        }
                    }
                    @snprintf(
                        buf3,
                        256,
                        "    %%t{lld} ={s} copy {s}_{s}\n",
                        {tmp3, emit_qt3, emit_qt3, ftext3}
                    )
                } else {
                    @snprintf(buf3, 256, "    %%t{lld} =l copy {s}\n", {tmp3, const_val3})
                }
                emit(
                    ctx,
                    buf3
                )
                val res3: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(res3, 16, "%%t{lld}", {tmp3})
                return res3
            }
        }
    }
    val offset: mut i64 = 0

    if base_expr.kind == parser.NK_IDENT {
        val base_name: ref u8 = parser.node_str_raw(base_expr.d0)
        val resolved_base_name: ref u8 = gsubst_resolve_name(ctx, base_name)
        val base_name2: mut ref u8 = base_name
        if str.raw_cmp(resolved_base_name, c"") != 0 {
            base_name2 = resolved_base_name
        }
        val dqt_check: ref u8 = cg_direct_type(ctx, base_name2)
        val local_type: ref u8 = cg_local_type(ctx, base_name2)
        val local_var: ref u8 = cg_lookup_local_var(ctx, base_name2)
        val is_local: bool = str.raw_cmp(
            dqt_check,
            c""
        ) != 0 || str.raw_cmp(local_type, c"") != 0 || str.raw_cmp(local_var, c"") != 0

        if !is_local {
            val tmp: i64 = fresh_tmp(ctx)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val enum_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(enum_key, 512, "{s}__{s}", {base_name2, field_name})
            val const_val: ref u8 = cg_const_val(ctx, enum_key)
            if str.raw_cmp(const_val, c"") != 0 {
                if raw_starts_with(const_val, c"d_") || raw_starts_with(const_val, c"s_") {
                    val ftext: ref u8 = @ptradd(const_val, 2) as ref u8
                    val emit_qt: mut ref u8 = c"d"
                    if raw_starts_with(const_val, c"s_") {
                        emit_qt = c"s"
                    }
                    if ctx.expected_ty != none {
                        val expected_qt_field: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
                        if str.raw_cmp(expected_qt_field, c"s") == 0 {
                            emit_qt = c"s"
                        } elif str.raw_cmp(expected_qt_field, c"d") == 0 {
                            emit_qt = c"d"
                        }
                    }
                    @snprintf(
                        buf,
                        256,
                        "    %%t{lld} ={s} copy {s}_{s}\n",
                        {tmp, emit_qt, emit_qt, ftext}
                    )
                } else {
                    @snprintf(buf, 256, "    %%t{lld} =l copy {s}\n", {tmp, const_val})
                }
            } else {
                val qbe_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(qbe_key, 512, "{s}__{s}", {base_name2, field_name})
                val is_fn: bool = cg_is_fn(ctx, qbe_key)
                val gann: ref u8 = cg_global_ann_by_label(ctx, qbe_key)
                if raw_starts_with(gann, c"[") {
                    @snprintf(
                        buf,
                        256,
                        "    %%t{lld} =l add ${s}__{s}, 0\n",
                        {tmp, base_name2, field_name}
                    )
                } elif is_fn {
                    @snprintf(
                        buf,
                        256,
                        "    %%t{lld} =l copy ${s}__{s}\n",
                        {tmp, base_name2, field_name}
                    )
                } else {
                    @snprintf(
                        buf,
                        256,
                        "    %%t{lld} =l loadl ${s}__{s}\n",
                        {tmp, base_name2, field_name}
                    )
                }
            }
            emit(
                ctx,
                buf
            )
            val res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res, 16, "%%t{lld}", {tmp})
            return res
        }

        if str.raw_cmp(local_type, c"") != 0 {
            val lookup_type: ref u8 = cg_ann_deref(local_type)
            val fields: ref void = cg_lookup_struct(ctx, lookup_type)
            if fields != none {
                val off: i64 = field_offset(ctx, fields, field_name)
                if off >= 0 {
                    offset = off
                }
            }
        } else {
            val inferred: ref u8 = infer_type_annotation(ctx, base_expr)
            if str.raw_cmp(inferred, c"") != 0 {
                val lookup_type: ref u8 = cg_ann_deref(inferred)
                val fields: ref void = cg_lookup_struct(ctx, lookup_type)
                if fields != none {
                    val off: i64 = field_offset(ctx, fields, field_name)
                    if off >= 0 {
                        offset = off
                    }
                }
            }
        }
    }

    val base: mut ref u8 = none
    val base_is_ref: mut bool = false
    if base_expr.kind == parser.NK_IDENT {
        val base_name2: mut ref u8 = parser.node_str_raw(base_expr.d0)
        val resolved_base_name2: ref u8 = gsubst_resolve_name(ctx, base_name2)
        if str.raw_cmp(resolved_base_name2, c"") != 0 {
            base_name2 = resolved_base_name2
        }
        val dqt: ref u8 = cg_direct_type(ctx, base_name2)
        if str.raw_cmp(dqt, c"") != 0 {
            val direct_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(direct_buf, 32, "%%{s}", {base_name2})
            base = direct_buf
        } else {
            val local_type_base: ref u8 = cg_local_type(ctx, base_name2)
            if cg_is_local_ref_type(ctx, base_name2) {
                base_is_ref = true
            }
            if !base_is_ref && cg_ann_is_indirect_value(ctx, local_type_base) {
                base_is_ref = true
            }
            if cg_is_slot(ctx, base_name2) && !base_is_ref {
                if cg_is_local_ref_type(ctx, base_name2) {
                    base_is_ref = true
                } else {
                    val inferred_type: ref u8 = infer_type_annotation(ctx, base_expr)
                    val lookup_inferred_type: ref u8 = cg_ann_deref(inferred_type)
                    if str.raw_cmp(
                        inferred_type,
                        c""
                    ) != 0 && str.raw_cmp(lookup_inferred_type, inferred_type) != 0 {
                        base_is_ref = true
                    }
                }
            }
        }
    } elif base_expr.kind == parser.NK_CAST {
        val cast_ty: ref parser.Node = base_expr.d1 as ref parser.Node
        if is_ref_type(cast_ty) {
            base_is_ref = true
        }
        val cast_type_name: ref u8 = unwrap_type_name(cast_ty)
        if str.raw_cmp(cast_type_name, c"") != 0 {
            val fields: ref void = cg_lookup_struct(ctx, cast_type_name)
            if fields != none {
                val off: i64 = field_offset(ctx, fields, field_name)
                if off >= 0 {
                    offset = off
                }
            }
        }
    } elif base_expr.kind == parser.NK_DEREF {
        base_is_ref = true
        val inner: ref parser.Node = base_expr.d0 as ref parser.Node
        if inner.kind == parser.NK_IDENT {
            val inner_name: ref u8 = parser.node_str_raw(inner.d0)
            val inner_type: ref u8 = cg_local_type(ctx, inner_name)
            if str.raw_cmp(inner_type, c"") != 0 && raw_starts_with(inner_type, c"ref ") {
                val deref_type: ref u8 = @ptradd(inner_type, 4) as ref u8
                val fields: ref void = cg_lookup_struct(ctx, deref_type)
                if fields != none {
                    val off: i64 = field_offset(ctx, fields, field_name)
                    if off >= 0 {
                        offset = off
                    }
                }
            }
        }
    } elif base_expr.kind == parser.NK_CALL {
        val inferred: ref u8 = infer_type_annotation(ctx, base_expr)
        if str.raw_cmp(inferred, c"") != 0 {
            val lookup_type: ref u8 = cg_ann_deref(inferred)
            val fields: ref void = cg_lookup_struct(ctx, lookup_type)
            if fields != none {
                val off: i64 = field_offset(ctx, fields, field_name)
                if off >= 0 {
                    offset = off
                }
            }
        }
    }
    if base == none {
        if base_expr.kind == parser.NK_DEREF {
            val inner: ref parser.Node = base_expr.d0 as ref parser.Node
            base = gen_expr(ctx, inner)
        } else {
            base = gen_expr(ctx, base_expr)
        }
        if base_expr.kind == parser.NK_IDENT {
            val base_name3: ref u8 = parser.node_str_raw(base_expr.d0)
            if cg_is_local_ref_type(ctx, base_name3) {
                base_is_ref = true
            }
        }
    }

    val field_is_fa: mut bool = false
    val field_is_union: mut bool = false
    val field_is_multi_word_struct: mut bool = false
    val field_load_instr: mut ref u8 = c"loadl"
    if base_expr.kind == parser.NK_IDENT {
        val base_name3: ref u8 = parser.node_str_raw(base_expr.d0)
        val local_type2: ref u8 = cg_local_type(ctx, base_name3)
        val lookup_type2: mut ref u8 = cg_ann_deref(local_type2)
        if str.raw_cmp(local_type2, c"") == 0 {
            val inferred: ref u8 = infer_type_annotation(ctx, base_expr)
            if str.raw_cmp(inferred, c"") != 0 {
                lookup_type2 = cg_ann_deref(inferred)
            }
        }

        if str.raw_cmp(lookup_type2, c"") != 0 {
            val fields2: ref void = cg_lookup_struct(ctx, lookup_type2)
            if fields2 != none {
                val sflen3: i64 = @len(fields2 as list[ref void]) as i64
                val sfi3: mut i64 = 0
                for {
                    if sfi3 >= sflen3 {
                        break
                    }
                    val sf3_opt = @get(fields2 as list[ref void], sfi3 as usize)
                    if sf3_opt is some sf3 {
                        val sfn3: ref parser.Node = sf3 as ref parser.Node
                        val sfname3: ref u8 = parser.node_str_raw(sfn3.d0)
                        if str.raw_cmp(sfname3, field_name) == 0 {
                            val sfty3: ref parser.Node = sfn3.d2 as ref parser.Node
                            if sfty3 != none {
                                if sfty3.kind == parser.TY_FIXED_ARR {
                                    field_is_fa = true
                                } elif sfty3.kind == parser.TY_NAMED {
                                    val type_name: ref u8 = parser.node_str_raw(sfty3.d0)
                                    if is_union_type_name(ctx, type_name) {
                                        field_is_union = true
                                    } else {
                                        val sfields: ref void = cg_lookup_struct(ctx, type_name)
                                        if sfields != none {
                                            field_is_multi_word_struct = true
                                        }
                                    }
                                }
                                field_load_instr = field_load_instr_for(sfty3)
                            }
                            sfi3 = sflen3 // break
                        }
                    }
                    sfi3++
                }
            }
        }
    } elif base_expr.kind == parser.NK_CAST {
        val cast_ty: ref parser.Node = base_expr.d1 as ref parser.Node
        val type_name: ref u8 = unwrap_type_name(cast_ty)
        if str.raw_cmp(type_name, c"") != 0 {
            val fields2: ref void = cg_lookup_struct(ctx, type_name)
            if fields2 != none {
                val sflen3: i64 = @len(fields2 as list[ref void]) as i64
                val sfi3: mut i64 = 0
                for {
                    if sfi3 >= sflen3 {
                        break
                    }
                    val sf3_opt = @get(fields2 as list[ref void], sfi3 as usize)
                    if sf3_opt is some sf3 {
                        val sfn3: ref parser.Node = sf3 as ref parser.Node
                        val sfname3: ref u8 = parser.node_str_raw(sfn3.d0)
                        if str.raw_cmp(sfname3, field_name) == 0 {
                            val sfty3: ref parser.Node = sfn3.d2 as ref parser.Node
                            if sfty3 != none {
                                if sfty3.kind == parser.TY_FIXED_ARR {
                                    field_is_fa = true
                                } elif sfty3.kind == parser.TY_NAMED {
                                    val ftype_name: ref u8 = parser.node_str_raw(sfty3.d0)
                                    if is_union_type_name(ctx, ftype_name) {
                                        field_is_union = true
                                    } else {
                                        val sfields: ref void = cg_lookup_struct(ctx, ftype_name)
                                        if sfields != none {
                                            field_is_multi_word_struct = true
                                        }
                                    }
                                }
                                field_load_instr = field_load_instr_for(sfty3)
                            }
                            sfi3 = sflen3 // break
                        }
                    }
                    sfi3++
                }
            }
        }
    } elif base_expr.kind == parser.NK_FIELD {
        val inner_type3: ref u8 = infer_type_annotation(ctx, base_expr)
        val lookup_inner3: ref u8 = cg_ann_deref(inner_type3)
        if str.raw_cmp(lookup_inner3, c"") != 0 {
            val iflds3: ref void = cg_lookup_struct(ctx, lookup_inner3)
            if iflds3 != none {
                val direct_off: i64 = field_offset(ctx, iflds3, field_name)
                if direct_off >= 0 {
                    offset = direct_off
                }
                val sflen4: i64 = @len(iflds3 as list[ref void]) as i64
                val sfi4: mut i64 = 0
                for {
                    if sfi4 >= sflen4 {
                        break
                    }
                    val sf4_opt = @get(iflds3 as list[ref void], sfi4 as usize)
                    if sf4_opt is some sf4 {
                        val sfn4: ref parser.Node = sf4 as ref parser.Node
                        val sfname4: ref u8 = parser.node_str_raw(sfn4.d0)
                        if str.raw_cmp(sfname4, field_name) == 0 {
                            val sfty4: ref parser.Node = sfn4.d2 as ref parser.Node
                            if sfty4 != none {
                                if sfty4.kind == parser.TY_FIXED_ARR {
                                    field_is_fa = true
                                } elif sfty4.kind == parser.TY_NAMED {
                                    val ftype_name: ref u8 = parser.node_str_raw(sfty4.d0)
                                    if is_union_type_name(ctx, ftype_name) {
                                        field_is_union = true
                                    } else {
                                        val sfields: ref void = cg_lookup_struct(ctx, ftype_name)
                                        if sfields != none {
                                            field_is_multi_word_struct = true
                                        }
                                    }
                                }
                                field_load_instr = field_load_instr_for(sfty4)
                            }
                            sfi4 = sflen4
                        }
                    }
                    sfi4++
                }
            }
        }
    }
    if str.raw_cmp(field_load_instr, c"loadl") == 0 {
        val field_ann: ref u8 = infer_type_annotation(ctx, expr)
        if str.raw_cmp(field_ann, c"f64") == 0 {
            field_load_instr = c"loadd"
        } elif str.raw_cmp(field_ann, c"f32") == 0 {
            field_load_instr = c"loads"
        }
    }

    val tmp: i64 = fresh_tmp(ctx)
    val tmp_qt: mut ref u8 = c"l"
    if str.raw_cmp(field_load_instr, c"loadd") == 0 {
        tmp_qt = c"d"
    } elif str.raw_cmp(field_load_instr, c"loads") == 0 {
        tmp_qt = c"s"
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8

    if base_is_ref {
        if field_is_fa || field_is_union || field_is_multi_word_struct {
            if offset == 0 {
                @snprintf(buf, 256, "    %%t{lld} =l add {s}, 0\n", {tmp, base})
            } else {
                @snprintf(buf, 256, "    %%t{lld} =l add {s}, {lld}\n", {tmp, base, offset})
            }
        } else {
            if offset == 0 {
                @snprintf(
                    buf,
                    256,
                    "    %%t{lld} ={s} {s} {s}\n",
                    {tmp, tmp_qt, field_load_instr, base}
                )
            } else {
                val ptr_tmp: i64 = fresh_tmp(ctx)
                val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(buf2, 128, "    %%t{lld} =l add {s}, {lld}\n", {ptr_tmp, base, offset})
                emit(
                    ctx,
                    buf2
                )
                val ptr_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(ptr_str, 16, "%%t{lld}", {ptr_tmp})
                @snprintf(
                    buf,
                    256,
                    "    %%t{lld} ={s} {s} {s}\n",
                    {tmp, tmp_qt, field_load_instr, ptr_str}
                )
            }
        }
    } elif field_is_fa || field_is_union || field_is_multi_word_struct {
        if offset == 0 {
            @snprintf(buf, 256, "    %%t{lld} =l add {s}, 0\n", {tmp, base})
        } else {
            @snprintf(buf, 256, "    %%t{lld} =l add {s}, {lld}\n", {tmp, base, offset})
        }
    } elif offset == 0 {
        @snprintf(buf, 256, "    %%t{lld} ={s} {s} {s}\n", {tmp, tmp_qt, field_load_instr, base})
    } else {
        val ptr_tmp: i64 = fresh_tmp(ctx)
        val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(buf2, 128, "    %%t{lld} =l add {s}, {lld}\n", {ptr_tmp, base, offset})
        emit(
            ctx,
            buf2
        )
        val ptr_str: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(ptr_str, 16, "%%t{lld}", {ptr_tmp})
        @snprintf(buf, 256, "    %%t{lld} ={s} {s} {s}\n", {tmp, tmp_qt, field_load_instr, ptr_str})
    }
    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

/// Returns the address of a field (or list variable) without loading its value.
/// Used by list builtins (@append, @len, @get, etc.) that need the list header address.
/// Returns the address of the storage that holds a list handle. This is used
/// to write a freshly-created header back into a zeroed list field/local.
fn gen_field_storage_addr(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none || expr.kind != parser.NK_FIELD {
        return none
    }
    val base_expr: ref parser.Node = parser.field_base(expr)
    val field_name: ref u8 = parser.field_name_raw(expr)
    val offset: mut i64 = 0
    val base_lookup: mut ref u8 = c""
    if base_expr.kind == parser.NK_IDENT {
        val base_name: ref u8 = parser.node_str_raw(base_expr.d0)
        val local_type: ref u8 = cg_local_type(ctx, base_name)
        if str.raw_cmp(local_type, c"") != 0 {
            base_lookup = cg_ann_deref(local_type)
        }
    } else {
        val base_ann: ref u8 = infer_type_annotation(ctx, base_expr)
        if str.raw_cmp(base_ann, c"") != 0 {
            base_lookup = cg_ann_deref(base_ann)
        }
    }
    if str.raw_cmp(base_lookup, c"") != 0 {
        val fields: ref void = cg_lookup_struct(ctx, base_lookup)
        if fields != none {
            val off: i64 = field_offset(ctx, fields, field_name)
            if off >= 0 {
                offset = off
            }
        }
    }
    val base: mut ref u8 = none
    if base_expr.kind == parser.NK_IDENT {
        val base_name2: ref u8 = parser.node_str_raw(base_expr.d0)
        if str.raw_cmp(cg_lookup_local_var(ctx, base_name2), c"") == 0 {
            val mod_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(mod_key, 512, "{s}__{s}", {base_name2, field_name})
            if cg_global_label_exists(ctx, mod_key) {
                val mod_addr: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    260 as usize
                ) as ref u8
                @snprintf(mod_addr, 260, "${s}", {mod_key})
                base = mod_addr
            }
        }
        if base == none {
            val dqt: ref u8 = cg_direct_type(ctx, base_name2)
            if str.raw_cmp(dqt, c"") != 0 {
                val direct_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(direct_buf, 32, "%%{s}", {base_name2})
                base = direct_buf
            }
        }
    }
    if base == none {
        base = gen_expr(ctx, base_expr)
    }
    if offset == 0 {
        return base
    }
    val ptr_tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf, 128, "    %%t{lld} =l add {s}, {lld}\n", {ptr_tmp, base, offset})
    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {ptr_tmp})
    return res
}

fn gen_list_ptr(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c"0"
    }
    if expr.kind == parser.NK_FIELD {
        val addr: ref u8 = gen_field_storage_addr(ctx, expr)
        if addr == none {
            return c"0"
        }
        val ptr_tmp2: i64 = fresh_tmp(ctx)
        val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(buf2, 128, "    %%t{lld} =l loadl {s}\n", {ptr_tmp2, addr})
        emit(ctx, buf2)
        val res2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(res2, 16, "%%t{lld}", {ptr_tmp2})
        return res2
    }
    if expr.kind == parser.NK_IDENT {
        val vname: ref u8 = parser.node_str_raw(expr.d0)
        val qbe_var: ref u8 = cg_lookup_local_var(ctx, vname)
        if str.raw_cmp(qbe_var, c"") != 0 && cg_is_slot(ctx, vname) {
            val slot_addr: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
            val list_ptr_tmp: i64 = fresh_tmp(ctx)
            val load_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(load_buf, 128, "    %%t{lld} =l loadl {s}\n", {list_ptr_tmp, slot_addr})
            emit(ctx, load_buf)

            val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
            @snprintf(res, 16, "%%t{lld}", {list_ptr_tmp})
            return res
        }
        val dqt: ref u8 = cg_direct_type(ctx, vname)
        if str.raw_cmp(dqt, c"") != 0 {
            val res2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(res2, 32, "%%{s}", {vname})
            return res2
        }
    }
    return gen_expr(ctx, expr)
}

/// Returns the address of the storage holding a list handle for lvalues that
/// can be written back to, or none when the expression is not addressable.
fn gen_list_slot(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return none
    }
    if expr.kind == parser.NK_FIELD {
        return gen_field_storage_addr(ctx, expr)
    }
    if expr.kind == parser.NK_IDENT {
        val vname: ref u8 = parser.node_str_raw(expr.d0)
        val qbe_var: ref u8 = cg_lookup_local_var(ctx, vname)
        if str.raw_cmp(qbe_var, c"") != 0 && cg_is_slot(ctx, vname) {
            return cg_qbe_value_ref(ctx, qbe_var)
        }
        return none
    }
    if expr.kind == parser.NK_DEREF {
        return gen_expr(ctx, expr.d0 as ref parser.Node)
    }
    return none
}

/// Load a list argument, creating and storing a fresh header first when the
/// argument is an addressable list that is currently null.
fn cg_list_arg_ensured(
    ctx: mut ref CgCtx,
    args: ref void,
    idx: i64
) ref u8 = trust {
    val node_opt = @get(args, idx as usize)
    val node: mut ref parser.Node = none
    if node_opt is some n {
        node = n as ref parser.Node
    }
    val slot: ref u8 = gen_list_slot(ctx, node)
    if slot != none {
        val tmp_ens: i64 = fresh_tmp(ctx)
        val buf_ens: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(buf_ens, 128, "    %%t{lld} =l call $sxqbe_list_ensure(l {s})\n",
            {tmp_ens, slot})
        emit(ctx, buf_ens)
        ctx.alloc_runtime = true
        val res_ens: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(res_ens, 16, "%%t{lld}", {tmp_ens})
        return res_ens
    }
    return get_list_arg(ctx, args, idx)
}

fn gen_store_field_value(
    ctx: mut ref CgCtx,
    target: ref parser.Node,
    val_tmp2: ref u8,
    val_qtype: ref u8
) void = trust {
    val val_qtype_n: ref u8 = cg_normalize_qtype(val_qtype)
    val ftarget: ref parser.Node = parser.field_base(target)
    val fname: ref u8 = parser.field_name_raw(target)
    val foffset: mut i64 = 0
    val field_is_union: mut bool = false

    val owner_lookup: mut ref u8 = c""
    if ftarget.kind == parser.NK_IDENT {
        val bname: ref u8 = parser.node_str_raw(ftarget.d0)
        val tname2: ref u8 = cg_local_type(ctx, bname)
        owner_lookup = cg_ann_deref(tname2)
    } elif ftarget.kind == parser.NK_FIELD {
        val tname2: ref u8 = infer_type_annotation(ctx, ftarget)
        owner_lookup = cg_ann_deref(tname2)
    }

    if str.raw_cmp(owner_lookup, c"") != 0 {
        val flds2: ref void = cg_lookup_struct(ctx, owner_lookup)
        if flds2 != none {
            val off2: i64 = field_offset(ctx, flds2, fname)
            if off2 >= 0 {
                foffset = off2
            }

            val sflen: i64 = @len(flds2 as list[ref void]) as i64
            val sfi: mut i64 = 0
            for {
                if sfi >= sflen {
                    break
                }
                val sf_opt = @get(flds2 as list[ref void], sfi as usize)
                if sf_opt is some sf {
                    val sfn: ref parser.Node = sf as ref parser.Node
                    val sfname: ref u8 = parser.node_str_raw(sfn.d0)
                    if str.raw_cmp(sfname, fname) == 0 {
                        val sfty: ref parser.Node = sfn.d2 as ref parser.Node
                        if sfty != none && sfty.kind == parser.TY_NAMED {
                            val ftype_name: ref u8 = parser.node_str_raw(sfty.d0)
                            val union_check: ref void = cg_lookup_union_suffix(ctx, ftype_name)
                            if union_check != none {
                                field_is_union = true
                            }
                        }
                        sfi = sflen
                    }
                }
                sfi++
            }
        }
    }

    if field_is_union {
        val base: ref u8 = gen_expr(ctx, ftarget)
        val fptr: i64 = fresh_tmp(ctx)
        if foffset == 0 {
            val buf3u: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf3u, 128, "    call $memcpy(l {s}, l {s}, l 16)\n", {base, val_tmp2})
            emit(ctx, buf3u)
        } else {
            val buf3ub: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf3ub, 128, "    %%t{lld} =l add {s}, {lld}\n", {fptr, base, foffset})
            emit(
                ctx,
                buf3ub
            )
            val buf3u: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf3u, 128, "    call $memcpy(l %%t{lld}, l {s}, l 16)\n", {fptr, val_tmp2})
            emit(ctx, buf3u)
        }
    } else {
        val field_size_write: mut i64 = 8
        val field_store_op: mut ref u8 = c"storel"

        val module_key: mut ref u8 = c""
        val module_ann: mut ref u8 = c""
        if ftarget.kind == parser.NK_IDENT {
            val bname_m: ref u8 = parser.node_str_raw(ftarget.d0)
            if str.raw_cmp(cg_lookup_local_var(ctx, bname_m), c"") == 0 {
                val key_m: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(key_m, 512, "{s}__{s}", {bname_m, fname})
                if cg_global_label_exists(ctx, key_m) {
                    module_key = key_m
                    module_ann = cg_global_ann_by_label(ctx, key_m)
                    foffset = 0
                }
            }
        }

        val lookup3: mut ref u8 = c""
        if str.raw_cmp(module_key, c"") != 0 {
            if str.raw_cmp(module_ann, c"") != 0 {
                field_size_write = cg_ann_size(ctx, module_ann)
                field_store_op = cg_ann_store_instr(ctx, module_ann)
            }
        } elif ftarget.kind == parser.NK_IDENT {
            val bname2: ref u8 = parser.node_str_raw(ftarget.d0)
            val tname3: ref u8 = cg_local_type(ctx, bname2)
            lookup3 = cg_ann_deref(tname3)
        } else {
            val tname3: ref u8 = infer_type_annotation(ctx, ftarget)
            lookup3 = cg_ann_deref(tname3)
        }
        if str.raw_cmp(lookup3, c"") != 0 {
            val flds3: ref void = cg_lookup_struct(ctx, lookup3)
            if flds3 != none {
                val sf3len: i64 = @len(flds3 as list[ref void]) as i64
                val sf3i: mut i64 = 0
                for {
                    if sf3i >= sf3len {
                        break
                    }
                    val sf3_opt = @get(flds3 as list[ref void], sf3i as usize)
                    if sf3_opt is some sf3 {
                        val sf3n: ref parser.Node = sf3 as ref parser.Node
                        val sf3name: ref u8 = parser.node_str_raw(sf3n.d0)
                        if str.raw_cmp(sf3name, fname) == 0 {
                            val sf3ty: ref parser.Node = sf3n.d2 as ref parser.Node
                            if sf3ty != none {
                                if sf3ty.kind == parser.TY_NAMED {
                                    val ftnm: ref u8 = parser.node_str_raw(sf3ty.d0)
                                    val sflds: ref void = cg_lookup_struct(ctx, ftnm)
                                    if sflds != none {
                                        field_size_write = struct_size(ctx, sflds)
                                    }
                                }
                                field_store_op = field_store_instr_for_struct(ctx, flds3, sf3ty)
                            }
                            sf3i = sf3len
                        }
                    }
                    sf3i++
                }
            }
        }

        val val_to_store: mut ref u8 = val_tmp2
        if str.raw_cmp(field_store_op, c"storeb") == 0 ||
        str.raw_cmp(field_store_op, c"storeh") == 0 ||
        str.raw_cmp(field_store_op, c"storew") == 0 {
            val_to_store = cg_coerce_qtype(ctx, val_tmp2, val_qtype_n, c"w")
        } elif str.raw_cmp(field_store_op, c"storel") == 0 && str.raw_cmp(val_qtype_n, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, val_tmp2})
            emit(
                ctx,
                ext_buf
            )
            val ext_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(ext_res, 16, "%%t{lld}", {ext_tmp})
            val_to_store = ext_res
        } elif str.raw_cmp(
            field_store_op,
            c"stores"
        ) == 0 || str.raw_cmp(field_store_op, c"stored") == 0 {
            val dst_qtype: mut ref u8 = c"d"
            if str.raw_cmp(field_store_op, c"stores") == 0 {
                dst_qtype = c"s"
            }
            val_to_store = cg_coerce_qtype(ctx, val_tmp2, val_qtype_n, dst_qtype)
        }

        val base: mut ref u8 = none
        if str.raw_cmp(module_key, c"") != 0 {
            val mod_addr: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                260 as usize
            ) as ref u8
            @snprintf(mod_addr, 260, "${s}", {module_key})
            base = mod_addr
        } else {
            base = gen_expr(ctx, ftarget)
        }
        val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        if field_size_write > 8 {
            if foffset == 0 {
                @snprintf(
                    buf3,
                    128,
                    "    call $memcpy(l {s}, l {s}, l {lld})\n",
                    {base, val_to_store, field_size_write}
                )
            } else {
                val fptr: i64 = fresh_tmp(ctx)
                val buf3b: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(buf3b, 128, "    %%t{lld} =l add {s}, {lld}\n", {fptr, base, foffset})
                emit(ctx, buf3b)
                @snprintf(
                    buf3,
                    128,
                    "    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                    {fptr, val_to_store, field_size_write}
                )
            }
        } elif foffset == 0 {
            @snprintf(buf3, 128, "    {s} {s}, {s}\n", {field_store_op, val_to_store, base})
        } else {
            val fptr: i64 = fresh_tmp(ctx)
            val buf3b: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf3b, 128, "    %%t{lld} =l add {s}, {lld}\n", {fptr, base, foffset})
            emit(
                ctx,
                buf3b
            )
            @snprintf(buf3, 128, "    {s} {s}, %%t{lld}\n", {field_store_op, val_to_store, fptr})
        }
        emit(ctx, buf3)
    }
}

fn cg_callsite_param_is_argspack(ctx: mut ref CgCtx, expr: ref parser.Node, idx: i64) bool = trust {
    val callee: ref parser.Node = parser.call_callee(expr)
    if callee == none {
        return false
    }
    val callee_name: ref u8 = resolve_callee_name(ctx, callee)
    val resolved_fn: ref parser.Node = parser.call_resolved_fn(expr)
    val exact: ref u8 = cg_lookup_fn_name_by_node(ctx, resolved_fn)
    val resolved: mut ref u8 = exact
    if resolved == none {
        resolved = cg_resolve_fn_name(ctx, callee_name)
    }
    val effective: mut ref u8 = resolved
    if effective == none {
        val ext: ref u8 = cg_lookup_extern_symbol(ctx, callee_name)
        if ext != none {
            effective = ext
        } else {
            effective = callee_name
        }
    }
    val params: ref void = cg_lookup_fn_params(ctx, effective)
    if params == none {
        return false
    }
    val plen: i64 = @len(params as list[ref void]) as i64
    if idx < 0 || idx >= plen {
        return false
    }
    val p_opt = @get(params as list[ref void], idx as usize)
    if p_opt is some p {
        val pnode: ref parser.Node = p as ref parser.Node
        if pnode != none {
            val pty: ref parser.Node = pnode.d1 as ref parser.Node
            return pty != none && pty.kind == parser.TY_ARGSPACK
        }
    }
    return false
}

fn cg_trunc_chars(xs: mut list[ref u8], n: i64) void = trust {
    for {
        if (@len(xs) as i64) <= n {
            break
        }
        @remove(xs, (@len(xs) - 1) as usize)
    }
}

/// Inline a call to an `inline` function whose body is a single return
/// expression. Returns the QBE operand for the inlined result, or none when
/// the call cannot be expanded (in which case the normal call path is used).
fn cg_try_inline_call(
    ctx: mut ref CgCtx,
    fn_node: ref parser.Node,
    arg_tmps: list[ref u8]
) ref u8 = trust {
    if fn_node == none || !parser.fn_is_inline(fn_node) {
        return none
    }
    if fn_node.kind == parser.NK_EXTERN_FN {
        return none
    }
    val body: ref void = fn_node.d5 as ref void
    if body == none || (@len(body as list[ref parser.Node]) as i64) != 1 {
        return none
    }
    val stmt_opt = @get(body as list[ref parser.Node], 0 as usize)
    if stmt_opt is some stmt {
        if stmt.kind != parser.NK_RETURN {
            return none
        }
        val ret_expr: ref parser.Node = stmt.d0 as ref parser.Node
        if ret_expr == none {
            return none
        }

        val saved_src_len: i64 = @len(ctx.local_src_names as list[ref u8]) as i64
        val saved_qbe_len: i64 = @len(ctx.local_qbe_names as list[ref u8]) as i64
        val saved_lnames_len: i64 = @len(ctx.lnames as list[ref u8]) as i64
        val saved_ltypes_len: i64 = @len(ctx.ltypes as list[ref u8]) as i64
        val saved_ref_len: i64 = @len(ctx.local_ref_types as list[ref u8]) as i64

        val params: ref void = fn_node.d3 as ref void
        if params != none {
            val plen: i64 = @len(params as list[ref parser.Node]) as i64
            val alen: i64 = @len(arg_tmps) as i64
            val pi: mut i64 = 0
            for {
                if pi >= plen || pi >= alen {
                    break
                }
                val p_opt = @get(params as list[ref parser.Node], pi as usize)
                val a_opt = @get(arg_tmps, pi as usize)
                if p_opt is some p {
                    if a_opt is some a {
                        val param: ref parser.Node = p
                        val pname: ref u8 = parser.node_str_raw(param.d0)
                        val pty: ref parser.Node = param.d1 as ref parser.Node
                        cg_register_local_var(ctx, pname, a as ref u8)
                        if pty != none {
                            if pty.kind == parser.TY_REF {
                                cg_register_local_ref_type(ctx, pname)
                                val inner: ref parser.Node = pty.d0 as ref parser.Node
                                if inner != none && inner.kind == parser.TY_NAMED {
                                    cg_register_local_type(
                                        ctx,
                                        pname,
                                        parser.node_str_raw(inner.d0)
                                    )
                                }
                            } elif pty.kind == parser.TY_NAMED {
                                cg_register_local_type(ctx, pname, parser.node_str_raw(pty.d0))
                            }
                        }
                    }
                }
                pi++
            }
        }

        val result: ref u8 = gen_expr(ctx, ret_expr)

        cg_trunc_chars(ctx.local_src_names, saved_src_len)
        cg_trunc_chars(ctx.local_qbe_names, saved_qbe_len)
        cg_trunc_chars(ctx.lnames, saved_lnames_len)
        cg_trunc_chars(ctx.ltypes, saved_ltypes_len)
        cg_trunc_chars(ctx.local_ref_types, saved_ref_len)
        return result
    }
    return none
}

fn gen_call(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val callee_node: ref parser.Node = expr.d0 as ref parser.Node
    val args_list: ref void = expr.d1 as ref void

    // `env.get("NAME")` is resolved at compile time when NAME was supplied
    // through a -d definition (or an sx.mod env block).
    if callee_node.kind == parser.NK_FIELD {
        val env_base: ref parser.Node = parser.field_base(callee_node)
        val env_name: ref u8 = parser.field_name_raw(callee_node)
        if env_base != none && env_base.kind == parser.NK_IDENT &&
        defines.is_env_alias(parser.node_str(env_base.d0)) &&
        str.raw_cmp(env_name, c"get") == 0 {
            if args_list != none && (@len(args_list as list[ref parser.Node]) as i64) > 0 {
                val key_opt = @get(args_list as list[ref parser.Node], 0 as usize)
                if key_opt is some key_val {
                    val key_candidate: ref parser.Node = key_val as ref parser.Node
                    val key_node: ref parser.Node = env_key_literal_node(key_candidate)
                    if key_node != none {
                        val key: str.StringView = parser.str_lit_text(key_node)
                        val value: str.StringView = defines.get(key)
                        if value.ptr != none {
                            val idx: i64 = intern_string(ctx, value)
                            val sbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                64 as usize
                            ) as ref u8
                            @snprintf(sbuf, 64, "$__str{lld}", {idx})
                            return sbuf
                        }
                    }
                }
            }
        }
    }

    if callee_node.kind == parser.NK_GENERIC_INST {
        val gi_base: ref parser.Node = parser.generic_inst_base(callee_node)
        val gi_targs: list[ref parser.Node] = parser.generic_inst_type_args(callee_node)
        val base_name: ref u8 = generic_callee_base_name(ctx, gi_base)
        val resolved_fn_node: ref parser.Node = parser.call_resolved_fn(expr)
        val gfn_node: mut ref parser.Node = none
        val gfn_prefix: mut ref u8 = c""
        if resolved_fn_node != none && resolved_fn_node.kind == parser.NK_GENERIC_FN {
            gfn_node = resolved_fn_node
            gfn_prefix = lookup_generic_fn_prefix_by_node(ctx, gfn_node)
        } else {
            gfn_node = lookup_generic_fn(ctx, base_name)
            if gfn_node != none {
                gfn_prefix = lookup_generic_fn_prefix(ctx, base_name)
            }
        }
        val gsrc_params: mut ref void = none
        if gfn_node != none {
            gsrc_params = gfn_node.d3 as ref void
        }
        val arg_tmps_g: mut list[ref u8] = mem.new[ref u8]()
        val arg_qts_g: mut list[ref u8] = mem.new[ref u8]()
        if args_list != none {
            val glen: i64 = @len(args_list as list[ref parser.Node]) as i64
            val gai: mut i64 = 0
            for {
                if gai >= glen {
                    break
                }
                val ga_opt = @get(args_list as list[ref parser.Node], gai as usize)
                if ga_opt is some ga {
                    val ga_node: ref parser.Node = ga as ref parser.Node
                    val gak: i64 = ga_node.kind
                    if cg_param_is_argspack(gsrc_params, gai) {
                        val elems: mut list[ref parser.Node] = mem.new[ref parser.Node]()
                        if gak == parser.NK_ARGS_PACK {
                            val pack: ref void = ga_node.d0 as ref void
                            val plen: i64 = @len(pack) as i64
                            val gpi: mut i64 = 0
                            for {
                                if gpi >= plen {
                                    break
                                }
                                val gpe_opt = @get(pack, gpi as usize)
                                if gpe_opt is some gpe {
                                    @append(elems, gpe as ref parser.Node)
                                }
                                gpi++
                            }
                        } else {
                            @append(elems, ga_node)
                        }
                        val pack_ptr: ref u8 = cg_gen_argspack_pack(ctx, elems)
                        @append(arg_tmps_g, pack_ptr)
                        @append(arg_qts_g, c"l")
                    } elif gak == parser.NK_ARGS_PACK {
                        val pack: ref void = ga_node.d0 as ref void
                        val plen: i64 = @len(pack) as i64
                        val gpi: mut i64 = 0
                        for {
                            if gpi >= plen {
                                break
                            }
                            val gpe_opt = @get(pack, gpi as usize)
                            if gpe_opt is some gpe {
                                val gpe_node: ref parser.Node = gpe as ref parser.Node
                                val gpt: ref u8 = gen_expr(ctx, gpe_node)
                                @append(arg_tmps_g, gpt)
                                @append(arg_qts_g, expr_qbe_type(ctx, gpe_node))
                            }
                            gpi++
                        }
                    } else {
                        val gat: ref u8 = gen_expr(ctx, ga_node)
                        @append(arg_tmps_g, gat)
                        @append(arg_qts_g, expr_qbe_type(ctx, ga_node))
                    }
                }
                gai++
            }
        }
        val mono_base: mut ref u8 = none
        if gfn_node != none {
            val resolved_targs: mut list[ref parser.Node] = mem.new[ref parser.Node]()
            for ta in gi_targs {
                @append(resolved_targs, cg_concrete_ty(ctx, ta as ref parser.Node))
            }
            mono_base = monomorphize_generic_fn(ctx, gfn_node, gfn_prefix, resolved_targs)
        }
        if mono_base == none {
            mono_base = base_name
        }
        val gtmp: i64 = fresh_tmp(ctx)
        val gfn_params_list: ref void = cg_lookup_fn_params(ctx, mono_base)
        val gret_node: ref void = cg_lookup_fn_ret(ctx, mono_base)
        val gret_qt: mut ref u8 = c"l"
        if gret_node != none {
            gret_qt = qbe_type_of(gret_node as ref parser.Node)
        }
        val gret_union_name: ref u8 = is_union_type(ctx, gret_node as ref parser.Node)
        val greturns_union: bool = str.raw_cmp(gret_union_name, c"") != 0
        val greturns_unboxed: bool = gret_node != none
        && ((gret_node as ref parser.Node).kind == parser.TY_OPTION
            || (gret_node as ref parser.Node).kind == parser.TY_RESULT)
        val ghas_sret: bool = greturns_union || greturns_unboxed
        val gret_buf: mut i64 = -1
        if ghas_sret {
            gret_buf = fresh_tmp(ctx)
            val gret_sz: mut i64 = 16
            if greturns_union {
                val guv: ref void = cg_lookup_union_suffix(ctx, gret_union_name)
                if guv != none {
                    gret_sz = cg_union_size(ctx, guv)
                }
            }
            if greturns_unboxed {
                gret_sz = cg_wrap_layout_size(ctx, gret_node as ref parser.Node)
            }
            val grabuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(grabuf, 128, "    %%t{lld} =l alloc8 {lld}\n", {gret_buf, gret_sz})
            emit(ctx, grabuf)
        }
        val gcall_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            2048 as usize
        ) as ref u8
        val gcall_pos: mut i64 = 0
        val ghdr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(ghdr, 256, "    %%t{lld} ={s} call ${s}(", {gtmp, gret_qt, mono_base})
        val ghdr_len: i64 = str.len_raw(ghdr)
        @memcpy(@ptradd(gcall_buf, gcall_pos), ghdr, ghdr_len as usize)
        gcall_pos = gcall_pos + ghdr_len
        val gtlen: i64 = @len(arg_tmps_g) as i64
        if ghas_sret {
            val gra: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
            @snprintf(gra, 64, "l %%t{lld}", {gret_buf})
            val gralen: i64 = str.len_raw(gra)
            @memcpy(@ptradd(gcall_buf, gcall_pos), gra, gralen as usize)
            gcall_pos = gcall_pos + gralen
        }
        val gti: mut i64 = 0
        for {
            if gti >= gtlen {
                break
            }
            val gt_opt = @get(arg_tmps_g, gti as usize)
            if gt_opt is some gt {
                val garg_qt: mut ref u8 = c"l"
                val gsrc_qt: mut ref u8 = c"l"
                if gfn_params_list != none {
                    val gplen: i64 = @len(gfn_params_list as list[ref void]) as i64
                    if gti < gplen {
                        val gp_opt = @get(gfn_params_list as list[ref void], gti as usize)
                        if gp_opt is some gp {
                            val gp_node: ref parser.Node = gp as ref parser.Node
                            if gp_node != none {
                                val gp_ty: ref parser.Node = gp_node.d1 as ref parser.Node
                                if gp_ty != none {
                                    garg_qt = qbe_type_of(gp_ty)
                                }
                            }
                        }
                    }
                }
                val gqt_opt = @get(arg_qts_g, gti as usize)
                if gqt_opt is some gq {
                    gsrc_qt = gq as ref u8
                }
                val gt_arg: ref u8 = cg_coerce_qtype(ctx, gt as ref u8, gsrc_qt, garg_qt)
                val gtbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                if gti > 0 || ghas_sret {
                    @memcpy(@ptradd(gcall_buf, gcall_pos), c", " as ref void, 2)
                    gcall_pos += 2
                }
                @snprintf(gtbuf, 128, "{s} {s}", {garg_qt, gt_arg})
                val gtbuf_len: i64 = str.len_raw(gtbuf)
                @memcpy(@ptradd(gcall_buf, gcall_pos), gtbuf, gtbuf_len as usize)
                gcall_pos = gcall_pos + gtbuf_len
            }
            gti++
        }
        if gfn_params_list != none {
            val pad_need: i64 = @len(gfn_params_list as list[ref parser.Node]) as i64
            val pad_i: mut i64 = @len(arg_tmps_g) as i64
            for {
                if pad_i >= pad_need {
                    break
                }
                if pad_i > 0 || ghas_sret {
                    @memcpy(@ptradd(gcall_buf, gcall_pos), c", " as ref void, 2)
                    gcall_pos += 2
                }
                @memcpy(@ptradd(gcall_buf, gcall_pos), c"l 0" as ref void, 3)
                gcall_pos += 3
                pad_i++
            }
        }
        @store8(@ptradd(gcall_buf, gcall_pos), 41)
        gcall_pos++
        @store8(@ptradd(gcall_buf, gcall_pos), 10)
        gcall_pos++
        @store8(@ptradd(gcall_buf, gcall_pos), 0)
        emitln(
            ctx,
            gcall_buf
        )
        val gres: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        val gresult: mut i64 = gtmp
        if ghas_sret {
            gresult = gret_buf
        }
        @snprintf(gres, 16, "%%t{lld}", {gresult})
        return gres
    }

    val callee_raw: ref u8 = resolve_callee_name(ctx, callee_node)
    val callee_name: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8

    @snprintf(callee_name, 256, "{s}", {callee_raw})

    val tv_owner_slot: ref void = allocators.ScopedArena.alloc_or_none(ctx.arena, 8 as usize)
    val tv_field_slot: ref void = allocators.ScopedArena.alloc_or_none(ctx.arena, 8 as usize)

    @store(tv_owner_slot, 0)
    @store(tv_field_slot, 0)

    val tv_tag: i64 = cg_lookup_tv(ctx, callee_name, tv_owner_slot, tv_field_slot)

    if tv_tag < 0 {
        val sep_pos: mut i64 = -1
        val scan_i: mut i64 = 0
        for {
            val sc: u8 = @load8(@ptradd(callee_name, scan_i))
            if sc == 0 {
                break
            }
            val sc2: u8 = @load8(@ptradd(callee_name, scan_i + 1))
            if sc == 95 && sc2 == 95 {
                sep_pos = scan_i
            } // '__'
            scan_i++
        }
        if sep_pos >= 0 {
            val bare_name: ref u8 = @ptradd(callee_name, sep_pos + 2) as ref u8
            @store(tv_owner_slot, 0)
            @store(tv_field_slot, 0)
            val tv_tag2: i64 = cg_lookup_tv(ctx, bare_name, tv_owner_slot, tv_field_slot)
            if tv_tag2 >= 0 {
                val field_ty_list2: ref void = @load(tv_field_slot) as ref void
                val n_args2: mut i64 = 0
                if args_list != none {
                    n_args2 = @len(args_list) as i64
                }
                val payload_size2: mut i64 = 0
                if field_ty_list2 != none {
                    val ftlen2: i64 = @len(field_ty_list2 as list[ref parser.Node]) as i64
                    val fti2: mut i64 = 0
                    for {
                        if fti2 >= ftlen2 {
                            break
                        }
                        val ft_opt2 = @get(field_ty_list2 as list[ref parser.Node], fti2 as usize)
                        if ft_opt2 is some ft2 {
                            val ft_node2: ref parser.Node = ft2 as ref parser.Node
                            val fsize2: mut i64 = type_size(ft_node2)
                            if ft_node2 != none && ft_node2.kind == parser.TY_NAMED {
                                val tname2: ref u8 = parser.node_str_raw(ft_node2.d0)
                                val union_check2: ref void = cg_lookup_union_suffix(ctx, tname2)
                                if union_check2 != none {
                                    fsize2 = cg_union_size(ctx, union_check2)
                                } else {
                                    val struct_fields2: ref void = cg_lookup_struct(ctx, tname2)
                                    if struct_fields2 != none {
                                        fsize2 = struct_size(ctx, struct_fields2)
                                    }
                                }
                            }
                            if fsize2 == 0 {
                                payload_size2 += 8
                            } else {
                                payload_size2 = payload_size2 + align_to(fsize2, 8)
                            }
                        } else {
                            payload_size2 += 8
                        }
                        fti2++
                    }
                } else {
                    payload_size2 = n_args2 * 8
                }

                val alloc_size2: i64 = 8 + payload_size2
                val actual_alloc_size2: mut i64 = alloc_size2
                if actual_alloc_size2 < 16 {
                    actual_alloc_size2 = 16
                }
                val ptr2: i64 = fresh_tmp(ctx)
                val pbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(pbuf2, 64, "    %%t{lld} =l alloc8 {lld}\n    storel {lld}, %%t{lld}\n",
                    {ptr2, actual_alloc_size2, tv_tag2, ptr2})
                emit(ctx, pbuf2)
                if args_list != none {
                    val flen2: i64 = @len(args_list) as i64
                    val fi2: mut i64 = 0
                    for {
                        if fi2 >= flen2 {
                            break
                        }
                        val fa2_opt = @get(args_list, fi2 as usize)
                        if fa2_opt is some fa2 {
                            val fa2_node: ref parser.Node = fa2 as ref parser.Node
                            val offset2: i64 = 8 + fi2 * 8

                            if fa2_node.kind == parser.NK_STRUCT_LIT {
                                if field_ty_list2 != none {
                                    val ft_opt2 = @get(
                                        field_ty_list2 as list[ref parser.Node],
                                        fi2 as usize
                                    )
                                    if ft_opt2 is some ft2 {
                                        val ft_node2: ref parser.Node = ft2 as ref parser.Node
                                        if ft_node2.kind == parser.TY_NAMED {
                                            val st_name2: ref u8 = parser.node_str_raw(ft_node2.d0)
                                            val st_fields2: ref void = cg_lookup_struct(
                                                ctx,
                                                st_name2
                                            )
                                            if st_fields2 != none {
                                                gen_struct_lit_inline(
                                                    ctx,
                                                    fa2_node,
                                                    ptr2,
                                                    8,
                                                    st_fields2
                                                )
                                            }
                                        }
                                    }
                                }
                            } else {
                                val field_val2: ref u8 = gen_expr(ctx, fa2_node)
                                val fptr2: i64 = fresh_tmp(ctx)
                                val fbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    128 as usize
                                ) as ref u8
                                val store_op2: mut ref u8 = c"storel"
                                if field_ty_list2 != none {
                                    val fts2_opt = @get(
                                        field_ty_list2 as list[ref parser.Node],
                                        fi2 as usize
                                    )
                                    if fts2_opt is some fts2 {
                                        val li2: ref u8 = field_load_instr_for(fts2 as ref parser.Node)
                                        if str.raw_cmp(li2, c"loadd") == 0 {
                                            store_op2 = c"stored"
                                        } elif str.raw_cmp(li2, c"loads") == 0 {
                                            store_op2 = c"stores"
                                        }
                                    }
                                }
                                @snprintf(fbuf2, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    {s} {s}, %%t{lld}\n",
                                    {fptr2, ptr2, offset2, store_op2, field_val2, fptr2})
                                emit(ctx, fbuf2)
                            }
                        }
                        fi2++
                    }
                }
                val tv_res2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(tv_res2, 16, "%%t{lld}", {ptr2})
                return tv_res2
            }
        }
    }

    if tv_tag >= 0 {
        val field_ty_list: ref void = @load(tv_field_slot) as ref void
        val n_args: mut i64 = 0
        if args_list != none {
            n_args = @len(args_list) as i64
        }

        val payload_size: mut i64 = 0
        if field_ty_list != none {
            val ftlen: i64 = @len(field_ty_list as list[ref parser.Node]) as i64
            val fti: mut i64 = 0
            for {
                if fti >= ftlen {
                    break
                }
                val ft_opt = @get(field_ty_list as list[ref parser.Node], fti as usize)
                if ft_opt is some ft {
                    val ft_node: ref parser.Node = ft as ref parser.Node
                    val fsize: mut i64 = type_size(ft_node)
                    if ft_node != none && ft_node.kind == parser.TY_NAMED {
                        val tname: ref u8 = parser.node_str_raw(ft_node.d0)
                        val union_check: ref void = cg_lookup_union_suffix(ctx, tname)
                        if union_check != none {
                            fsize = cg_union_size(ctx, union_check)
                        } else {
                            val struct_fields: ref void = cg_lookup_struct(ctx, tname)
                            if struct_fields != none {
                                fsize = struct_size(ctx, struct_fields)
                            }
                        }
                    }
                    if fsize == 0 {
                        payload_size += 8
                    } else {
                        payload_size = payload_size + align_to(fsize, 8)
                    }
                } else {
                    payload_size += 8
                }
                fti++
            }
        } else {
            payload_size = n_args * 8
        }

        val alloc_size: i64 = 8 + payload_size
        val actual_alloc_size: mut i64 = alloc_size
        if actual_alloc_size < 16 {
            actual_alloc_size = 16
        }
        val ptr: i64 = fresh_tmp(ctx)
        val pbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(pbuf, 64, "    %%t{lld} =l alloc8 {lld}\n    storel {lld}, %%t{lld}\n",
            {ptr, actual_alloc_size, tv_tag, ptr})
        emit(ctx, pbuf)
        if args_list != none {
            val flen: i64 = @len(args_list) as i64
            val fi: mut i64 = 0
            for {
                if fi >= flen {
                    break
                }
                val fa_opt = @get(args_list, fi as usize)
                if fa_opt is some fa {
                    val fa_node: ref parser.Node = fa as ref parser.Node
                    val offset: i64 = 8 + fi * 8

                    if fa_node.kind == parser.NK_STRUCT_LIT {
                        if field_ty_list != none {
                            val ft_opt = @get(field_ty_list as list[ref parser.Node], fi as usize)
                            if ft_opt is some ft {
                                val ft_node: ref parser.Node = ft as ref parser.Node
                                if ft_node.kind == parser.TY_NAMED {
                                    val st_name: ref u8 = parser.node_str_raw(ft_node.d0)
                                    val st_fields: ref void = cg_lookup_struct(ctx, st_name)
                                    if st_fields != none {
                                        gen_struct_lit_inline(ctx, fa_node, ptr, 8, st_fields)
                                    }
                                }
                            }
                        }
                    } else {
                        val field_val: ref u8 = gen_expr(ctx, fa_node)
                        val fptr: i64 = fresh_tmp(ctx)
                        val fbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        val store_op: mut ref u8 = c"storel"
                        if field_ty_list != none {
                            val fts_opt = @get(field_ty_list as list[ref parser.Node], fi as usize)
                            if fts_opt is some fts {
                                val li: ref u8 = field_load_instr_for(fts as ref parser.Node)
                                if str.raw_cmp(li, c"loadd") == 0 {
                                    store_op = c"stored"
                                } elif str.raw_cmp(li, c"loads") == 0 {
                                    store_op = c"stores"
                                }
                            }
                        }
                        @snprintf(fbuf, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    {s} {s}, %%t{lld}\n",
                            {fptr, ptr, offset, store_op, field_val, fptr})
                        emit(ctx, fbuf)
                    }
                }
                fi++
            }
        }
        val tv_res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(tv_res, 16, "%%t{lld}", {ptr})
        return tv_res
    }
    val is_print: bool = str.raw_cmp(callee_name, c"print") == 0
    || str.raw_ends_with(callee_name, c"__print")
    || str.raw_ends_with(callee_name, c"__eprint")

    if is_print && args_list != none {
        val alen_p: i64 = @len(args_list) as i64
        if alen_p > 0 {
            val first_arg_opt = @get(args_list, 0)
            if first_arg_opt is some first_arg {
                val first_node: ref parser.Node = first_arg as ref parser.Node
                if first_node.kind == parser.NK_STR_LIT {
                    val fmt_str: ref u8 = parser.str_lit_text_raw(first_node)
                    val fmt_idx: i64 = intern_format_string(ctx, fmt_str)
                    val fmt_tmp: i64 = fresh_tmp(ctx)
                    val fmt_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(fmt_buf, 64, "    %%t{lld} =l copy $__str{lld}\n", {fmt_tmp, fmt_idx})
                    emit(ctx, fmt_buf)
                    val variadic_args: mut list[ref u8] = mem.new[ref u8]()
                    val ai_p: mut i64 = 1
                    for {
                        if ai_p >= alen_p {
                            break
                        }
                        val arg_opt_p = @get(args_list, ai_p as usize)
                        if arg_opt_p is some arg_p {
                            val arg_node_p: ref parser.Node = arg_p as ref parser.Node
                            if arg_node_p.kind == parser.NK_ARGS_PACK {
                                val pack_p: ref void = arg_node_p.d0 as ref void
                                val plen_p: i64 = @len(pack_p) as i64
                                val pi_p: mut i64 = 0
                                for {
                                    if pi_p >= plen_p {
                                        break
                                    }
                                    val pe_opt_p = @get(pack_p, pi_p as usize)
                                    if pe_opt_p is some pe_p {
                                        val pe_node_p: ref parser.Node = pe_p as ref parser.Node
                                        val pbuf_p: ref u8 = gen_variadic_arg(ctx, pe_node_p)
                                        @append(variadic_args, pbuf_p)
                                    }
                                    pi_p++
                                }
                            } else {
                                val abuf_p: ref u8 = gen_variadic_arg(ctx, arg_node_p)
                                @append(variadic_args, abuf_p)
                            }
                        }
                        ai_p++
                    }

                    val result_tmp: i64 = fresh_tmp(ctx)
                    val call_buf_p: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        4096 as usize
                    ) as ref u8
                    val vlen: i64 = @len(variadic_args) as i64
                    if vlen == 0 {
                        @snprintf(
                            call_buf_p,
                            4096,
                            "    %%t{lld} =l call $printf(l %%t{lld}, ..., l 0)\n",
                            {result_tmp, fmt_tmp}
                        )
                    } else {
                        val call_pos_p: mut i64 = 0
                        val hdr_p: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            256 as usize
                        ) as ref u8
                        @snprintf(
                            hdr_p,
                            256,
                            "    %%t{lld} =l call $printf(l %%t{lld}, ...",
                            {result_tmp, fmt_tmp}
                        )
                        val hdr_len_p: i64 = str.len_raw(hdr_p)
                        @memcpy(@ptradd(call_buf_p, call_pos_p), hdr_p, hdr_len_p)
                        call_pos_p = call_pos_p + hdr_len_p
                        val vi: mut i64 = 0
                        for {
                            if vi >= vlen {
                                break
                            }
                            val v_opt = @get(variadic_args, vi as usize)
                            if v_opt is some v {
                                val vstr: ref u8 = v as ref u8
                                val vlen2: i64 = str.len_raw(vstr)
                                @memcpy(@ptradd(call_buf_p, call_pos_p), c", " as ref void, 2)
                                call_pos_p += 2
                                @memcpy(@ptradd(call_buf_p, call_pos_p), vstr, vlen2)
                                call_pos_p = call_pos_p + vlen2
                            }
                            vi++
                        }
                        @store8(@ptradd(call_buf_p, call_pos_p), 41) // ')'
                        call_pos_p++
                        @store8(@ptradd(call_buf_p, call_pos_p), 10) // '\n'
                        call_pos_p++
                        @store8(@ptradd(call_buf_p, call_pos_p), 0)
                    }
                    emit(
                        ctx,
                        call_buf_p
                    )
                    val res_p: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(res_p, 16, "%%t{lld}", {result_tmp})
                    return res_p
                }
            }
        }
    }

    val arg_tmps: mut list[ref u8] = mem.new[ref u8]()
    val arg_qts: mut list[ref u8] = mem.new[ref u8]()

    if args_list != none {
        val alen: i64 = @len(args_list) as i64
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arg_opt = @get(args_list, ai as usize)
            if arg_opt is some arg {
                val arg_node: ref parser.Node = arg as ref parser.Node
                val ak: i64 = arg_node.kind
                if cg_callsite_param_is_argspack(ctx, expr, ai) {
                    if ak == parser.NK_ARGS_PACK {
                        val elems: mut list[ref parser.Node] = mem.new[ref parser.Node]()
                        val pack: ref void = arg_node.d0 as ref void
                        val plen: i64 = @len(pack) as i64
                        val pi: mut i64 = 0
                        for {
                            if pi >= plen {
                                break
                            }
                            val pe_opt = @get(pack, pi as usize)
                            if pe_opt is some pe {
                                @append(elems, pe as ref parser.Node)
                            }
                            pi++
                        }
                        val pack_ptr: ref u8 = cg_gen_argspack_pack(ctx, elems)
                        @append(arg_tmps, pack_ptr)
                        @append(arg_qts, c"l")
                    } elif arg_node.kind == parser.NK_IDENT &&
                    cg_current_fn_param_is_argspack(ctx, parser.node_str_raw(arg_node.d0)) {
                        val at: ref u8 = gen_expr(ctx, arg_node)
                        @append(arg_tmps, at)
                        @append(arg_qts, c"l")
                    } else {
                        val elems: mut list[ref parser.Node] = mem.new[ref parser.Node]()
                        @append(elems, arg_node)
                        val pack_ptr: ref u8 = cg_gen_argspack_pack(ctx, elems)
                        @append(arg_tmps, pack_ptr)
                        @append(arg_qts, c"l")
                    }
                } elif ak == parser.NK_ARGS_PACK {
                    val pack: ref void = arg_node.d0 as ref void
                    val plen: i64 = @len(pack) as i64
                    val pi: mut i64 = 0
                    for {
                        if pi >= plen {
                            break
                        }
                        val pe_opt = @get(pack, pi as usize)
                        if pe_opt is some pe {
                            val pe_node: ref parser.Node = pe as ref parser.Node
                            val pt: ref u8 = gen_expr(ctx, pe_node)
                            @append(arg_tmps, pt)
                            @append(arg_qts, expr_qbe_type(ctx, pe_node))
                        }
                        pi++
                    }
                } else {
                    val at: ref u8 = gen_expr(ctx, arg_node)
                    @append(arg_tmps, at)
                    @append(arg_qts, expr_qbe_type(ctx, arg_node))
                }
            }
            ai++
        }
    }

    val tmp: mut i64 = fresh_tmp(ctx)
    val resolved_fn_node: ref parser.Node = parser.call_resolved_fn(expr)
    val inlined: ref u8 = cg_try_inline_call(ctx, resolved_fn_node, arg_tmps)
    if inlined != none {
        return inlined
    }
    val exact_callee: ref u8 = cg_lookup_fn_name_by_node(ctx, resolved_fn_node)
    val resolved_callee: mut ref u8 = exact_callee
    if resolved_callee == none {
        resolved_callee = cg_resolve_fn_name(ctx, callee_name)
    }
    val ext_sym2: mut ref u8 = none
    if exact_callee == none {
        ext_sym2 = cg_lookup_extern_symbol(ctx, callee_name)
    }
    val effective_callee: mut ref u8 = c""
    if resolved_callee != none {
        effective_callee = resolved_callee
    } elif ext_sym2 != none {
        effective_callee = ext_sym2
    } else {
        effective_callee = callee_name
    }
    val fn_params_list: ref void = cg_lookup_fn_params(ctx, effective_callee)
    val fixed_params_len: mut i64 = 0
    if fn_params_list != none {
        fixed_params_len = @len(fn_params_list as list[ref void]) as i64
    }
    val is_variadic_extern: bool = resolved_fn_node != none
    && resolved_fn_node.kind == parser.NK_EXTERN_FN
    && parser.extern_fn_is_variadic(resolved_fn_node)
    if fn_params_list != none {
        val tlen0: i64 = @len(arg_tmps) as i64
        val wi: mut i64 = 0
        for {
            if wi >= fixed_params_len {
                break
            }
            if wi >= tlen0 {
                break
            }
            val p_opt = @get(fn_params_list, wi as usize)
            if p_opt is some p {
                val param_node: ref parser.Node = p as ref parser.Node
                val pty: ref parser.Node = param_node.d1 as ref parser.Node
                if pty != none && pty.kind == parser.TY_NAMED {
                    val ptype_name: ref u8 = parser.node_str_raw(pty.d0)
                    val union_vars: ref void = cg_lookup_union_suffix(ctx, ptype_name)
                    if union_vars != none {
                        val at_opt = @get(arg_tmps, wi as usize)
                        if at_opt is some at {
                            val arg_val: ref u8 = at as ref u8
                            val should_wrap: mut bool = true
                            if @load8(arg_val) as i64 == 37 {
                                val second: i64 = @load8(@ptradd(arg_val, 1)) as i64
                                if second == 116 {
                                    should_wrap = false
                                }
                            }

                            if should_wrap {
                                val box_ptr: i64 = fresh_tmp(ctx)
                                val payload_ptr: i64 = fresh_tmp(ctx)
                                val bbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(bbuf, 256,
                                    "    %%t{lld} =l call $malloc(l 16)\n    storew 0, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 8\n    storel {s}, %%t{lld}\n",
                                    {box_ptr, box_ptr, payload_ptr, box_ptr, arg_val, payload_ptr})
                                emit(
                                    ctx,
                                    bbuf
                                )
                                val wrapped: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    16 as usize
                                ) as ref u8
                                @snprintf(wrapped, 16, "%%t{lld}", {box_ptr})
                                val new_tmps: mut list[ref u8] = mem.new[ref u8]()
                                val tlen_r: i64 = @len(arg_tmps) as i64
                                val ri: mut i64 = 0
                                for {
                                    if ri >= tlen_r {
                                        break
                                    }
                                    val r_opt = @get(arg_tmps, ri as usize)
                                    if r_opt is some r {
                                        if ri == wi {
                                            @append(new_tmps, wrapped)
                                        } else {
                                            @append(new_tmps, r as ref u8)
                                        }
                                    }
                                    ri++
                                }
                                arg_tmps = new_tmps
                            }
                        }
                    }
                }
            }
            wi++
        }
    }

    val call_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 8192 as usize) as ref u8
    val call_pos: mut i64 = 0
    val hdr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    val using_ext: bool = ext_sym2 != none && effective_callee == ext_sym2
    val is_fn_ptr: bool = resolved_callee == none
    && !using_ext
    && callee_node.kind == parser.NK_IDENT

    val ret_qtype: mut ref u8 = c"l"
    val ret_union_name: mut ref u8 = c""
    val ret_ty_node: mut ref parser.Node = none
    if using_ext {
        val ret_ty: ref void = cg_lookup_ext_ret(ctx, callee_raw)
        if ret_ty != none {
            ret_ty_node = ret_ty as ref parser.Node
            ret_qtype = qbe_type_of(ret_ty as ref parser.Node)
            ret_union_name = is_union_type(ctx, ret_ty as ref parser.Node)
        }
    } else {
        val lookup_name: mut ref u8 = callee_name
        if resolved_callee != none {
            lookup_name = resolved_callee
        }
        val ret_ty: ref void = cg_lookup_fn_ret(ctx, lookup_name)
        if ret_ty != none {
            ret_ty_node = ret_ty as ref parser.Node
            ret_qtype = qbe_type_of(ret_ty as ref parser.Node)
            ret_union_name = is_union_type(ctx, ret_ty as ref parser.Node)
        }
    }
    val inferred_ret: ref parser.Node = cg_infer_call_ret_ty(ctx, expr)
    if inferred_ret != none {
        ret_ty_node = inferred_ret
        ret_qtype = qbe_type_of(inferred_ret)
        ret_union_name = is_union_type(ctx, inferred_ret)
    }

    val returns_union: bool = str.raw_cmp(ret_union_name, c"") != 0
    val returns_unboxed: bool = ret_ty_node != none
    && (ret_ty_node.kind == parser.TY_OPTION || ret_ty_node.kind == parser.TY_RESULT)
    val has_sret: bool = returns_union || returns_unboxed
    val ret_buf_tmp: mut i64 = -1

    if has_sret {
        ret_buf_tmp = fresh_tmp(ctx)
        val ret_sz: mut i64 = 16
        if returns_union {
            val uv: ref void = cg_lookup_union_suffix(ctx, ret_union_name)
            if uv != none {
                ret_sz = cg_union_size(ctx, uv)
            }
        }
        if returns_unboxed {
            ret_sz = cg_wrap_layout_size(ctx, ret_ty_node)
        }
        val alloc_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(alloc_buf, 64, "    %%t{lld} =l alloc8 {lld}\n", {ret_buf_tmp, ret_sz})
        emit(ctx, alloc_buf)
    }

    if is_fn_ptr {
        val dqt: ref u8 = cg_direct_type(ctx, callee_name)
        if str.raw_cmp(dqt, c"") != 0 {
            @snprintf(hdr, 256, "    %%t{lld} ={s} call %%{s}(", {tmp, ret_qtype, callee_name})
        } else {
            val ptr_tmp: i64 = fresh_tmp(ctx)
            val load_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(load_buf, 64, "    %%t{lld} =l loadl %%{s}\n", {ptr_tmp, callee_name})
            emit(
                ctx,
                load_buf
            )
            @snprintf(hdr, 256, "    %%t{lld} ={s} call %%t{lld}(", {tmp, ret_qtype, ptr_tmp})
        }
    } else {
        @snprintf(hdr, 256, "    %%t{lld} ={s} call ${s}(", {tmp, ret_qtype, effective_callee})
    }
    val hdr_len: i64 = str.len_raw(hdr)
    @memcpy(@ptradd(call_buf, call_pos), hdr, hdr_len)
    call_pos = call_pos + hdr_len
    val tlen: i64 = @len(arg_tmps) as i64

    // If returning an aggregate, add the return buffer as the first argument
    if has_sret {
        val ret_arg: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(ret_arg, 32, "l %%t{lld}", {ret_buf_tmp})
        val ret_arg_len: i64 = str.len_raw(ret_arg)
        @memcpy(@ptradd(call_buf, call_pos), ret_arg, ret_arg_len)
        call_pos = call_pos + ret_arg_len
        if tlen > 0 {
            @memcpy(@ptradd(call_buf, call_pos), c", " as ref void, 2)
            call_pos += 2
        }
    }

    val ti: mut i64 = 0
    val variadic_started: mut bool = false
    for {
        if ti >= tlen {
            break
        }
        val t_opt = @get(arg_tmps, ti as usize)
        if t_opt is some t {
            val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            val src_qtype: mut ref u8 = c"l"
            val is_variadic_arg: bool = is_variadic_extern && ti >= fixed_params_len
            if is_variadic_arg && !variadic_started {
                if ti > 0 || has_sret {
                    @memcpy(@ptradd(call_buf, call_pos), c", ..." as ref void, 5)
                    call_pos += 5
                } else {
                    @memcpy(@ptradd(call_buf, call_pos), c"..." as ref void, 3)
                    call_pos += 3
                }
                variadic_started = true
            }
            if ti > 0 || is_variadic_arg {
                @memcpy(@ptradd(call_buf, call_pos), c", " as ref void, 2)
                call_pos += 2
            }

            val arg_qtype: mut ref u8 = c"l"
            if !is_variadic_arg && fn_params_list != none {
                if ti < fixed_params_len {
                    val param_opt = @get(fn_params_list as list[ref void], ti as usize)
                    if param_opt is some param {
                        val param_node: ref parser.Node = param as ref parser.Node
                        if param_node != none {
                            val param_ty: ref parser.Node = param_node.d1 as ref parser.Node
                            if param_ty != none {
                                arg_qtype = qbe_type_of(param_ty)
                            }
                        }
                    }
                }
            }
            val src_qt_opt = @get(arg_qts, ti as usize)
            if src_qt_opt is some sq {
                src_qtype = sq as ref u8
            }
            if is_variadic_arg {
                if str.raw_cmp(src_qtype, c"w") == 0 {
                    arg_qtype = c"l"
                } elif str.raw_cmp(src_qtype, c"s") == 0 {
                    arg_qtype = c"d"
                } else {
                    arg_qtype = src_qtype
                }
            }
            val call_arg: ref u8 = cg_coerce_qtype(ctx, t as ref u8, src_qtype, arg_qtype)
            @snprintf(tbuf, 64, "{s} {s}", {arg_qtype, call_arg})
            val tlen2: i64 = str.len_raw(tbuf)
            @memcpy(@ptradd(call_buf, call_pos), tbuf, tlen2)
            call_pos = call_pos + tlen2
        }
        ti++
    }
    @store8(@ptradd(call_buf, call_pos), 41) // ')'
    call_pos++
    @store8(@ptradd(call_buf, call_pos), 0)
    emitln(ctx, call_buf)

    if using_ext {
        val ret_ty2: ref void = cg_lookup_ext_ret(ctx, callee_raw)
        if ret_ty2 != none {
            val ret_qtype2: ref u8 = qbe_type_of(ret_ty2 as ref parser.Node)
            if str.raw_cmp(ret_qtype2, c"w") == 0 {
                val ext_tmp: i64 = fresh_tmp(ctx)
                val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(ext_buf, 64, "    %%t{lld} =l extsw %%t{lld}\n", {ext_tmp, tmp})
                emit(ctx, ext_buf)
                tmp = ext_tmp
            }
        }
    }

    // If the function returns an aggregate, return the caller buffer pointer.
    val result_tmp: mut i64 = tmp
    if has_sret {
        result_tmp = ret_buf_tmp
    }

    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {result_tmp})
    return res
}

fn resolve_callee_name(ctx: ref CgCtx, node: ref parser.Node) ref u8 = trust {
    val k: i64 = node.kind as i64
    if k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(node.d0)
        val resolved_name: ref u8 = gsubst_resolve_name(ctx, name)
        if str.raw_cmp(resolved_name, c"") != 0 {
            return resolved_name
        }
        return name
    }
    if k == parser.NK_FIELD {
        if cg_is_c_escape_expr(node) {
            return cg_raw_c_name(ctx, node)
        }
        val base: ref u8 = resolve_callee_name(ctx, parser.field_base(node))
        val field: ref u8 = parser.field_name_raw(node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "{s}__{s}", {base, field})
        return buf
    }
    if k == parser.NK_GENERIC_INST {
        return resolve_callee_name(ctx, parser.generic_inst_base(node))
    }
    return c"unknown"
}

fn get_arg(ctx: mut ref CgCtx, args: ref void, i: i64) ref u8 = trust {
    val opt = @get(args, i as usize)
    if opt is some a {
        return gen_expr(ctx, a as ref parser.Node)
    } else {
        return c"0"
    }
}

/// Generate an expression suitable for a C API that expects a NUL-terminated
/// `ref u8`. String literals use their interned bytes directly, and
/// `StringView` values are read through their `ptr` field.
fn gen_cstr_arg(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c"0"
    }
    if node.kind == parser.NK_STR_LIT {
        val idx: i64 = intern_string(ctx, parser.str_lit_text(node))
        val tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(buf, 64, "    %%t{lld} =l copy $__str{lld}\n", {tmp, idx})
        emit(ctx, buf)
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {tmp})
        return res
    }
    val raw: ref u8 = gen_expr(ctx, node)
    if format_arg_is_view(ctx, node) {
        val ptr_tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(buf, 128, "    %%t{lld} =l loadl {s}\n", {ptr_tmp, raw})
        emit(ctx, buf)
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res, 16, "%%t{lld}", {ptr_tmp})
        return res
    }
    return raw
}

/// Like get_arg but for format strings - interns with format rewriting.
fn get_format_arg(ctx: mut ref CgCtx, args: ref void, i: i64) ref u8 = trust {
    val opt = @get(args, i as usize)
    if opt is some a {
        val node: ref parser.Node = a as ref parser.Node
        if node.kind == parser.NK_STR_LIT {
            val s: ref u8 = parser.str_lit_text_raw(node)
            val idx: i64 = intern_format_string(ctx, s)
            val tmp: i64 = fresh_tmp(ctx)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
            @snprintf(buf, 64, "    %%t{lld} =l copy $__str{lld}\n", {tmp, idx})
            emit(
                ctx,
                buf
            )
            val res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res, 16, "%%t{lld}", {tmp})
            return res
        } else {
            val raw: ref u8 = gen_expr(ctx, node)
            val fmt_ptr: mut ref u8 = raw
            if format_arg_is_view(ctx, node) {
                val ptr_tmp: i64 = fresh_tmp(ctx)
                val ptr_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(ptr_buf, 128, "    %%t{lld} =l loadl {s}\n", {ptr_tmp, raw})
                emit(ctx, ptr_buf)
                val ptr_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(ptr_res, 16, "%%t{lld}", {ptr_tmp})
                fmt_ptr = ptr_res
            }
            val tmp: i64 = fresh_tmp(ctx)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf, 128, "    %%t{lld} =l call $sxqbe_rewrite_fmt(l {s})\n", {tmp, fmt_ptr})
            emit(ctx, buf)
            ctx.alloc_runtime = true
            val res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(res, 16, "%%t{lld}", {tmp})
            return res
        }
    } else {
        return c"0"
    }
}

fn format_arg_pack_node(args: ref void, pack_idx: i64, elem_idx: i64) ref parser.Node = trust {
    if args == none {
        return none
    }
    val alen: i64 = @len(args) as i64
    if pack_idx >= alen {
        return none
    }
    val pack_opt = @get(args, pack_idx)
    if pack_opt is some pack_raw {
        val pn: ref parser.Node = pack_raw as ref parser.Node
        if pn == none || pn.kind != parser.NK_ARGS_PACK {
            return none
        }
        val pack: ref void = pn.d0 as ref void
        if pack == none {
            return none
        }
        val plen: i64 = @len(pack) as i64
        if elem_idx < 0 || elem_idx >= plen {
            return none
        }
        val node_opt = @get(pack, elem_idx)
        if node_opt is some node_raw {
            return node_raw as ref parser.Node
        }
    }
    return none
}

fn format_arg_is_view(ctx: mut ref CgCtx, node: ref parser.Node) bool = trust {
    if node == none {
        return false
    }
    val ann: ref u8 = infer_type_annotation(ctx, node)
    return ann_is_string_type(ann, c"StringView")
}

fn intern_c_format(ctx: mut ref CgCtx, s: ref u8) ref u8 = trust {
    val idx: i64 = intern_string_raw(ctx, s)
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        64 as usize
    ) as ref u8
    @snprintf(buf, 64, "    %%t{lld} =l copy $__str{lld}\n", {tmp, idx})
    emit(ctx, buf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        16 as usize
    ) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

/// Rewrite a Spectre format string to C form, using `%.*s` for StringView args.
fn rewrite_fmt_viewaware(
    ctx: mut ref CgCtx,
    s: ref u8,
    args: ref void,
    pack_idx: i64
) ref u8 = trust {
    val slen: i64 = str.len_raw(s)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (slen * 4 + 16) as usize
    ) as ref u8
    val oi: mut i64 = 0
    val i: mut i64 = 0
    val arg_idx: mut i64 = 0

    for {
        if i >= slen {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 92 && i + 1 < slen {
            val next: u8 = @load8(@ptradd(s, i + 1))
            if next == 123 || next == 125 {
                @store8(@ptradd(out, oi), next)
                oi++
                i += 2
            } else {
                @store8(@ptradd(out, oi), c)
                oi++
                i++
            }
        } elif c == 37 {
            @store8(@ptradd(out, oi), 37)
            oi++
            @store8(@ptradd(out, oi), 37)
            oi++
            i++
        } elif c == 123 {
            val j: mut i64 = i + 1
            val found: mut bool = false
            for {
                if j >= slen {
                    break
                }
                if @load8(@ptradd(s, j)) == 125 {
                    found = true
                    break
                }
                j++
            }
            if found {
                val node: ref parser.Node = format_arg_pack_node(args, pack_idx, arg_idx)
                arg_idx++
                val is_view: bool = format_arg_is_view(ctx, node)
                @store8(@ptradd(out, oi), 37)
                oi++
                val k: mut i64 = i + 1
                for {
                    if k >= j {
                        break
                    }
                    val sc: u8 = @load8(@ptradd(s, k))
                    if is_view && sc == 115 && k + 1 == j {
                        @store8(@ptradd(out, oi), 46)
                        oi++
                        @store8(@ptradd(out, oi), 42)
                        oi++
                    }
                    @store8(@ptradd(out, oi), sc)
                    oi++
                    k++
                }
                i = j + 1
            } else {
                @store8(@ptradd(out, oi), c)
                oi++
                i++
            }
        } else {
            @store8(@ptradd(out, oi), c)
            oi++
            i++
        }
    }
    @store8(@ptradd(out, oi), 0)
    return out
}

fn args_have_view_arg(ctx: mut ref CgCtx, args: ref void, pack_idx: i64) bool = trust {
    if args == none {
        return false
    }
    val alen: i64 = @len(args) as i64
    if pack_idx >= alen {
        return false
    }
    val pack_opt = @get(args, pack_idx)
    if pack_opt is some pack_raw {
        val pn: ref parser.Node = pack_raw as ref parser.Node
        if pn == none || pn.kind != parser.NK_ARGS_PACK {
            return false
        }
        val pack: ref void = pn.d0 as ref void
        if pack == none {
            return false
        }
        val plen: i64 = @len(pack) as i64
        val i: mut i64 = 0
        for {
            if i >= plen {
                break
            }
            val node: ref parser.Node = format_arg_pack_node(args, pack_idx, i)
            if format_arg_is_view(ctx, node) {
                return true
            }
            i++
        }
    }
    return false
}

fn get_format_arg_viewaware(
    ctx: mut ref CgCtx,
    args: ref void,
    fmt_idx: i64,
    pack_idx: i64
) ref u8 = trust {
    if args == none || @len(args) as i64 <= fmt_idx {
        return c"0"
    }
    val fmt_opt = @get(args, fmt_idx)
    if fmt_opt is some fmt_raw {
        val fmt_node: ref parser.Node = fmt_raw as ref parser.Node
        if fmt_node.kind != parser.NK_STR_LIT || !args_have_view_arg(ctx, args, pack_idx) {
            return get_format_arg(ctx, args, fmt_idx)
        }
        val s: ref u8 = parser.str_lit_text_raw(fmt_node)
        val rewritten: ref u8 = rewrite_fmt_viewaware(ctx, s, args, pack_idx)
        return intern_c_format(ctx, rewritten)
    }
    return c"0"
}

fn get_print_format_arg(ctx: mut ref CgCtx, args: ref void) ref u8 = trust {
    return get_format_arg_viewaware(ctx, args, 0, 1)
}

fn gen_print_arg(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if !format_arg_is_view(ctx, node) {
        return gen_variadic_arg(ctx, node)
    }
    val raw: ref u8 = gen_expr(ctx, node)
    val len_tmp: i64 = fresh_tmp(ctx)
    val off_tmp: i64 = fresh_tmp(ctx)
    val ptr_tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    @snprintf(
        buf,
        256,
        "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl {s}\n",
        {off_tmp, raw, len_tmp, off_tmp, ptr_tmp, raw}
    )
    emit(ctx, buf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        64 as usize
    ) as ref u8
    @snprintf(res, 64, "l %%t{lld}, l %%t{lld}", {len_tmp, ptr_tmp})
    return res
}

/// Like get_arg but returns the address of the list header (for list builtins).
fn get_list_arg(ctx: mut ref CgCtx, args: ref void, i: i64) ref u8 = trust {
    val opt = @get(args, i as usize)
    if opt is some a {
        return gen_list_ptr(ctx, a as ref parser.Node)
    } else {
        return c"0"
    }
}

/// Returns the QBE type ("d", "s", or "l") for an expression node without generating code.
fn expr_qtype(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c"l"
    }
    val k: i64 = node.kind
    if k == parser.NK_FLOAT_LIT {
        if ctx.expected_ty != none {
            val expected_qt: ref u8 = qbe_type_of(ctx.expected_ty as ref parser.Node)
            if str.raw_cmp(expected_qt, c"s") == 0 {
                return c"s"
            }
        }
        return c"d"
    }
    if k == parser.NK_INT_LIT {
        return c"l"
    }
    if k == parser.NK_IDENT {
        val vname: ref u8 = parser.node_str_raw(node.d0)
        val dqt: ref u8 = cg_direct_type(ctx, vname)
        if str.raw_cmp(dqt, c"") != 0 {
            return dqt
        }
        val ltype: ref u8 = cg_local_type(ctx, vname)
        if str.raw_cmp(ltype, c"f64") == 0 {
            return c"d"
        }
        if str.raw_cmp(ltype, c"f32") == 0 {
            return c"s"
        }
        if is_word_type_name(ltype) {
            return c"w"
        }
    }
    if k == parser.NK_CAST {
        val ty: ref parser.Node = node.d1 as ref parser.Node
        return qbe_type_of(ty)
    }
    return c"l"
}

fn cg_emit_embed_const(
    ctx: mut ref CgCtx,
    cname: ref u8,
    const_label: ref u8,
    cexpr: ref parser.Node
) bool = trust {
    if cexpr == none || cexpr.kind != parser.NK_BUILTIN {
        return false
    }
    val bname: ref u8 = parser.node_str_raw(cexpr.d0)
    if str.raw_cmp(bname, c"embed") == 0 {
        val epath: ref u8 = parser.node_str_raw(cexpr.d2)
        if epath == none {
            stdio.eprint("error: @embed path was not resolved\n", {})
            os.exit(1)
        }
        val before: i64 = @len(ctx.embed_labels) as i64
        val label: ref u8 = cg_embed_label(ctx, epath)
        if (@len(ctx.embed_labels) as i64) > before {
            cg_emit_embed_data(ctx, epath, label, cexpr.d3)
        }
        cg_register_module_const(
            ctx,
            cname,
            arenafmt.format(ctx.arena, "${s}", {label}).ptr
        )
        return true
    }
    if str.raw_cmp(bname, c"embedlen") == 0 {
        val sval: ref u8 = arenafmt.format(ctx.arena, "{lld}", {cexpr.d3}).ptr
        cg_register_module_const(ctx, cname, sval)
        if cg_emit_label_if_new(ctx, const_label) {
            val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(data_buf, 256, "data ${s} = \{ l {s} \}\n", {const_label, sval})
            emit(ctx, data_buf)
        } else { }
        return true
    }
    return false
}

fn cg_embed_label(ctx: mut ref CgCtx, path: ref u8) ref u8 = trust {
    val n: i64 = @len(ctx.embed_paths) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val p_opt = @get(ctx.embed_paths, i as usize)
        if p_opt is some p {
            if str.raw_cmp(p as ref u8, path) == 0 {
                val l_opt = @get(ctx.embed_labels, i as usize)
                if l_opt is some l {
                    return l as ref u8
                }
            }
        }
        i++
    }

    val label: ref u8 = arenafmt.format(
        ctx.arena,
        "sx__embed_{lld}",
        {ctx.embed_count}
    ).ptr
    ctx.embed_count = ctx.embed_count + (1 as i64)
    @append(ctx.embed_paths, path)
    @append(ctx.embed_labels, label)
    return label
}

fn cg_emit_embed_data(ctx: ref CgCtx, path: ref u8, label: ref u8, size: i64) void = trust {
    val sb: ref void = str.StringBuilder.new()
    str.StringBuilder.append_cstr(sb, c"data $")
    str.StringBuilder.append_cstr(sb, label)
    str.StringBuilder.append_cstr(sb, c" = { ")

    val data_opt = fs.read_all_heap_raw(path)
    val nbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    val first: mut bool = true
    if data_opt is some data {
        val i: mut i64 = 0
        val zeros: mut i64 = 0
        for {
            if i >= size {
                break
            }
            val b: i64 = @load8(@ptradd(data, i)) as i64
            if b == 0 {
                zeros = zeros + (1 as i64)
            } else {
                if zeros > 0 {
                    if zeros >= (4 as i64) {
                        if !first {
                            str.StringBuilder.append_cstr(sb, c", ")
                        }
                        @snprintf(nbuf, 32, "z {lld}", {zeros})
                        str.StringBuilder.append_cstr(sb, nbuf)
                        first = false
                    } else {
                        val zi: mut i64 = 0
                        for zi < zeros {
                            if !first {
                                str.StringBuilder.append_cstr(sb, c", ")
                            }
                            str.StringBuilder.append_cstr(sb, c"b 0")
                            first = false
                            zi = zi + (1 as i64)
                        }
                    }
                    zeros = 0
                }
                if !first {
                    str.StringBuilder.append_cstr(sb, c", ")
                }
                @snprintf(nbuf, 32, "b {lld}", {b})
                str.StringBuilder.append_cstr(sb, nbuf)
                first = false
            }
            i = i + (1 as i64)
        }
        if zeros > 0 {
            if zeros >= (4 as i64) {
                if !first {
                    str.StringBuilder.append_cstr(sb, c", ")
                }
                @snprintf(nbuf, 32, "z {lld}", {zeros})
                str.StringBuilder.append_cstr(sb, nbuf)
                first = false
            } else {
                val zi2: mut i64 = 0
                for zi2 < zeros {
                    if !first {
                        str.StringBuilder.append_cstr(sb, c", ")
                    }
                    str.StringBuilder.append_cstr(sb, c"b 0")
                    first = false
                    zi2 = zi2 + (1 as i64)
                }
            }
        }
    } else {
        str.StringBuilder.append_cstr(sb, c"z 1")
        first = false
    }
    if first {
        str.StringBuilder.append_cstr(sb, c"z 1")
    }
    str.StringBuilder.append_cstr(sb, c" }\n")
    val built: ref void = str.StringBuilder.build(sb)
    str.StringBuilder.append_cstr(ctx.embed_sb, str.cstr(built))
    str.StringBuilder.free(sb)
    @free(@load(built))
    @free(built)
}

fn cg_first_type_arg(targs: list[ref parser.Node]) ref parser.Node = trust {
    if (@len(targs) as i64) > 0 {
        val first_opt = @get(targs, 0 as usize)
        if first_opt is some first {
            return first as ref parser.Node
        }
    }
    return none
}

fn cg_last_type_segment(name: ref u8) ref u8 = trust {
    if name == none {
        return c""
    }
    val nlen: i64 = str.len_raw(name)
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= nlen {
            break
        }
        if @load8(@ptradd(name, i)) == 46 {
            start = i + 1
        }
        i++
    }
    return @ptradd(name, start) as ref u8
}

fn cg_find_fn_by_suffix(ctx: ref CgCtx, suffix: ref u8) ref u8 = trust {
    val suffix_len: i64 = str.len_raw(suffix)
    val names: ref void = ctx.fn_names as ref void
    val nlen: i64 = @len(ctx.fn_names) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val candidate: ref u8 = @load(cg_list_slot(names, ni)) as ref u8
        if str.raw_cmp(candidate, suffix) == 0 {
            return candidate
        }
        val clen: i64 = str.len_raw(candidate)
        if clen > suffix_len + 2 {
            val tail: ref u8 = @ptradd(candidate, clen - suffix_len) as ref u8
            if str.raw_cmp(tail, suffix) == 0 {
                return candidate
            }
        }
        ni++
    }
    return c""
}

fn cg_resolve_alloc_fn(ctx: mut ref CgCtx, ty: ref parser.Node, method: ref u8) ref u8 = trust {
    val concrete: ref parser.Node = cg_concrete_ty(ctx, ty)
    if concrete == none || concrete.kind != parser.TY_NAMED {
        return c""
    }
    val short_name: ref u8 = cg_last_type_segment(parser.node_str_raw(concrete.d0))
    val suffix: ref u8 = str.concat_raw(short_name, str.concat_raw(c"__", method))
    val found: ref u8 = cg_find_fn_by_suffix(ctx, suffix)
    if str.len_raw(found) != 0 {
        return found
    }
    if str.raw_ends_with(short_name, c"Allocator") {
        val base_len: i64 = str.len_raw(short_name) - 9
        val base_name: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (base_len + 1) as usize
        ) as ref u8
        @memcpy(base_name, short_name, base_len as usize)
        @store8(@ptradd(base_name, base_len), 0)
        val alt_suffix: ref u8 = str.concat_raw(base_name, str.concat_raw(c"__", method))
        return cg_find_fn_by_suffix(ctx, alt_suffix)
    }
    return c""
}

fn cg_alloc_adapter_prefix(ctx: mut ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    val concrete: ref parser.Node = cg_concrete_ty(ctx, ty)
    if concrete == none || concrete.kind != parser.TY_NAMED {
        stdio.eprint("error: intrinsic allocator type argument must be a concrete named type\n", {})
        os.exit(1)
    }
    val full_name: ref u8 = parser.node_str_raw(concrete.d0)
    val sanitized: ref u8 = sanitize_mangle_atom(ctx, full_name)
    val prefix: ref u8 = str.concat_raw(c"sx__allocadapt_", sanitized)
    val nlen: i64 = @len(ctx.alloc_adapter_prefixes as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.alloc_adapter_prefixes as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, prefix) == 0 {
                return prefix
            }
        }
        ni++
    }
    val alloc_fn: ref u8 = cg_resolve_alloc_fn(ctx, ty, c"alloc")
    val free_fn: ref u8 = cg_resolve_alloc_fn(ctx, ty, c"free")
    val realloc_fn: ref u8 = cg_resolve_alloc_fn(ctx, ty, c"realloc")
    if str.len_raw(alloc_fn) == 0 || str.len_raw(free_fn) == 0 || str.len_raw(realloc_fn) == 0 {
        stdio.eprint("error: allocator '{s}' does not implement GeneralAllocator\n", {full_name})
        os.exit(1)
    }
    @append(ctx.alloc_adapter_prefixes, prefix)
    val cap: i64 = str.len_raw(prefix) + str.len_raw(alloc_fn) + str.len_raw(free_fn)
    + str.len_raw(realloc_fn) + 2048
    val line: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, cap as usize) as ref u8
    @snprintf(
        line,
        cap,
        "extern void {s}(long long*,long long,unsigned long long);\nextern int {s}(long long,long long);\nextern void {s}(long long*,long long,long long,unsigned long long);\nlong long {s}_alloc(long long ctx,unsigned long long size)\{long long r[3]=\{0,0,0\};{s}(r,ctx,size);return (r[0]!=0&&r[1]!=0)?r[1]+1:0;\}\nint {s}_free(long long ctx,long long ptr)\{{s}(ctx,ptr);return 0;\}\nlong long {s}_realloc(long long ctx,long long ptr,unsigned long long size)\{long long r[3]=\{0,0,0\};{s}(r,ctx,ptr,size);return (r[0]!=0&&r[1]!=0)?r[1]+1:0;\}\n",
        {
            alloc_fn,
            free_fn,
            realloc_fn,
            prefix,
            alloc_fn,
            prefix,
            free_fn,
            prefix,
            realloc_fn
        }
    )
    @append(ctx.alloc_adapter_lines, line)
    return prefix
}

fn cg_alloc_fn_ptr_targs(
    ctx: mut ref CgCtx,
    targs: list[ref parser.Node],
    method: ref u8
) ref u8 = trust {
    if (@len(targs) as i64) > 0 {
        val first_opt = @get(targs, 0 as usize)
        if first_opt is some first {
            return cg_alloc_fn_ptr(ctx, first as ref parser.Node, method)
        }
    }
    return c""
}

fn cg_alloc_fn_ptr(ctx: mut ref CgCtx, ty: ref parser.Node, method: ref u8) ref u8 = trust {
    val sym: mut ref u8 = c""
    if str.raw_cmp(method, c"alloc_raw") != 0 {
        val prefix: ref u8 = cg_alloc_adapter_prefix(ctx, ty)
        sym = str.concat_raw(prefix, str.concat_raw(c"_", method))
    } else {
        sym = cg_resolve_alloc_fn(ctx, ty, method)
    }
    if str.len_raw(sym) == 0 {
        stdio.eprint(
            "error: allocator '{s}' does not implement GeneralAllocator\n",
            {parser.node_str_raw(ty.d0)}
        )
        os.exit(1)
    }
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf, 128, "    %%t{lld} =l copy ${s}\n", {tmp, sym})
    emit(
        ctx,
        buf
    )
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn cg_named_ty_from_ann(ctx: ref CgCtx, ann: ref u8) ref parser.Node = trust {
    if ann == none || str.raw_cmp(ann, c"") == 0 {
        return none
    }
    val parsed: ref parser.Node = cg_parse_type_annotation(ctx, ann)
    if parsed != none {
        return parsed
    }
    val node: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
    parser.node_store_string_slot(@addr(node.d0), ann)
    return node
}

fn cg_ann_is_scalar(ann: ref u8) bool = trust {
    if str.raw_cmp(ann, c"") == 0 {
        return false
    }
    if is_word_type_name(ann) || is_float_type_name(ann) {
        return true
    }
    if str.raw_cmp(ann, c"bool") == 0 || str.raw_cmp(ann, c"i64") == 0
    || str.raw_cmp(ann, c"u64") == 0 || str.raw_cmp(ann, c"usize") == 0
    || str.raw_cmp(ann, c"isize") == 0 || str.raw_cmp(ann, c"u8") == 0 {
        return true
    }
    return false
}

/// Unboxed implementation of @get / @getref / @getmut.
/// mode: 0 = copy, 1 = borrowed ref, 2 = borrowed mut ref.
fn gen_get_unboxed(
    ctx: mut ref CgCtx,
    expr: ref parser.Node,
    args: ref void,
    mode: i64
) ref u8 = trust {
    val opt_ann: ref u8 = infer_type_annotation(ctx, expr)
    val elem_ann: ref u8 = parse_option_inner(opt_ann)
    val payload_ty: ref parser.Node = cg_named_ty_from_ann(ctx, elem_ann)
    val opt_ty: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_OPTION, expr.line)
    parser.node_store_slot[ref parser.Node](@addr(opt_ty.d0), payload_ty)
    val opt_sz: i64 = cg_option_layout_size(ctx, opt_ty, 0)
    val opt_buf: i64 = fresh_tmp(ctx)
    val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(
        init_buf,
        128,
        "    %%t{lld} =l alloc8 {lld}\n    storel 0, %%t{lld}\n",
        {opt_buf, opt_sz, opt_buf}
    )
    emit(ctx, init_buf)

    val base_arg_opt = @get(args as list[ref parser.Node], 0 as usize)
    val base_arg: mut ref parser.Node = none
    if base_arg_opt is some base_arg_raw {
        base_arg = base_arg_raw as ref parser.Node
    }
    val base_ann: ref u8 = infer_type_annotation(ctx, base_arg)
    val some_lbl: i64 = fresh_lbl(ctx)
    val none_lbl: i64 = fresh_lbl(ctx)
    val end_lbl: i64 = fresh_lbl(ctx)
    val opt_str: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(opt_str, 32, "%%t{lld}", {opt_buf})

    if !raw_starts_with(base_ann, c"[") {
        val lst: ref u8 = get_list_arg(ctx, args, 0)
        val idx_raw: ref u8 = get_arg(ctx, args, 1)
        val idx_node_opt = @get(args as list[ref parser.Node], 1 as usize)
        val idx_qt: mut ref u8 = c"l"
        if idx_node_opt is some idx_node {
            idx_qt = expr_qtype(ctx, idx_node as ref parser.Node)
        }
        val idx: ref u8 = cg_coerce_qtype(ctx, idx_raw, idx_qt, c"l")
        val valid_tmp: i64 = fresh_tmp(ctx)
        val hbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(hbuf3, 256, "    %%t{lld} =w call $sxqbe_list_valid(l {s}, l {s})\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {valid_tmp, lst, idx, valid_tmp, some_lbl, none_lbl, some_lbl})
        emit(ctx, hbuf3)
        ctx.alloc_runtime = true
        val data_tmp: i64 = fresh_tmp(ctx)
        val hbuf1: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(hbuf1, 256, "    %%t{lld} =l call $sxqbe_list_buf(l {s})\n", {data_tmp, lst})
        emit(ctx, hbuf1)
        val off_tmp: i64 = fresh_tmp(ctx)
        val elem_addr: i64 = fresh_tmp(ctx)
        val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(abuf, 256, "    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n",
            {off_tmp, idx, elem_addr, data_tmp, off_tmp})
        emit(ctx, abuf)
        val elem_str: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(elem_str, 32, "%%t{lld}", {elem_addr})
        val base_elem_ann: mut ref u8 = elem_ann
        if raw_starts_with(base_ann, c"list[") {
            val bal: i64 = str.len_raw(base_ann)
            base_elem_ann = str.substr(base_ann, 5, bal - 6)
        } elif raw_starts_with(base_ann, c"[") {
            val argn: i64 = @len(args as list[ref parser.Node]) as i64
            val be: ref u8 = cg_ann_after_get_indices(base_ann, argn - 1)
            if str.raw_cmp(be, c"") != 0 {
                base_elem_ann = be
            }
        }
        if mode == 0 {
            val src_tmp: i64 = fresh_tmp(ctx)
            val lbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(lbuf, 128, "    %%t{lld} =l loadl %%t{lld}\n", {src_tmp, elem_addr})
            emit(ctx, lbuf)
            val src_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(src_str, 32, "%%t{lld}", {src_tmp})
            if !cg_wrap_payload_is_aggregate(ctx, payload_ty) {
                val woff: i64 = fresh_tmp(ctx)
                val wbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(wbuf, 128, "    %%t{lld} =l add %%t{lld}, 8\n    storel {s}, %%t{lld}\n",
                    {woff, opt_buf, src_str, woff})
                emit(ctx, wbuf)
            } else {
                val sz: i64 = cg_payload_storage_size(ctx, payload_ty, 0)
                val off2: i64 = fresh_tmp(ctx)
                val dbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(dbuf, 512, "    %%t{lld} =l add %%t{lld}, 8\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                    {off2, opt_buf, off2, src_str, sz})
                emit(ctx, dbuf)
            }
        } else {
            if cg_ann_is_scalar(base_elem_ann) {
                cg_emit_store_typed(ctx, opt_str, 8, elem_str, payload_ty)
            } else {
                val src2: i64 = fresh_tmp(ctx)
                val lbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(lbuf2, 128, "    %%t{lld} =l loadl %%t{lld}\n", {src2, elem_addr})
                emit(ctx, lbuf2)
                val src2_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(src2_str, 32, "%%t{lld}", {src2})
                cg_emit_store_typed(ctx, opt_str, 8, src2_str, payload_ty)
            }
        }
        val tag_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(tag_buf, 256, "    storel 1, %%t{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n",
            {opt_buf, end_lbl, none_lbl, end_lbl, end_lbl})
        emit(ctx, tag_buf)
        return opt_str
    }

    // Fixed arrays.
    val base_ptr: mut ref u8 = get_arg(ctx, args, 0)
    val arg_count: i64 = @len(args as list[ref parser.Node]) as i64
    val cur_ann: mut ref u8 = base_ann
    val ai: mut i64 = 1
    for {
        if ai >= arg_count {
            break
        }
        if !raw_starts_with(cur_ann, c"[") {
            val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(jbuf, 64, "    jmp @lbl{lld}\n", {none_lbl})
            emit(ctx, jbuf)
            break
        }
        val idx_raw2: ref u8 = get_arg(ctx, args, ai)
        val idx_node_opt2 = @get(args as list[ref parser.Node], ai as usize)
        val idx_qt2: mut ref u8 = c"l"
        if idx_node_opt2 is some idx_node2 {
            idx_qt2 = expr_qtype(ctx, idx_node2 as ref parser.Node)
        }
        val idx2: ref u8 = cg_coerce_qtype(ctx, idx_raw2, idx_qt2, c"l")
        val len2: i64 = cg_ann_fixed_arr_len_val(ctx, cur_ann)
        val next_ann: ref u8 = ann_fixed_arr_inner(cur_ann)
        val elem_sz: i64 = cg_ann_size(ctx, next_ann)
        val ok_tmp2: i64 = fresh_tmp(ctx)
        val cont_lbl: i64 = fresh_lbl(ctx)
        val step_off: i64 = fresh_tmp(ctx)
        val step_ptr: i64 = fresh_tmp(ctx)
        val dbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 768 as usize) as ref u8
        @snprintf(dbuf2, 768,
            "    %%t{lld} =w csltl {s}, {lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n    %%t{lld} =l mul {s}, {lld}\n    %%t{lld} =l add {s}, %%t{lld}\n",
            {
                ok_tmp2,
                idx2,
                len2,
                ok_tmp2,
                cont_lbl,
                none_lbl,
                cont_lbl,
                step_off,
                idx2,
                elem_sz,
                step_ptr,
                base_ptr,
                step_off
            })
        emit(ctx, dbuf2)
        val step_name: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(step_name, 32, "%%t{lld}", {step_ptr})
        base_ptr = step_name
        cur_ann = next_ann
        ai++
    }
    if raw_starts_with(cur_ann, c"[") {
        if mode == 0 {
            cg_emit_store_typed(ctx, opt_str, 8, base_ptr, payload_ty)
        } else {
            cg_emit_store_typed(ctx, opt_str, 8, base_ptr, payload_ty)
        }
    } else {
        if mode == 0 {
            val l_instr: ref u8 = cg_ann_load_instr(cur_ann)
            val l_qt: ref u8 = cg_ann_qtype(cur_ann)
            val loaded_tmp: i64 = fresh_tmp(ctx)
            val lbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                lbuf3,
                128,
                "    %%t{lld} ={s} {s} {s}\n",
                {loaded_tmp, l_qt, l_instr, base_ptr}
            )
            emit(ctx, lbuf3)
            val loaded_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(loaded_str, 32, "%%t{lld}", {loaded_tmp})
            cg_emit_store_typed(ctx, opt_str, 8, loaded_str, payload_ty)
        } else {
            cg_emit_store_typed(ctx, opt_str, 8, base_ptr, payload_ty)
        }
    }
    val tag_buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(tag_buf2, 256, "    storel 1, %%t{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n",
        {opt_buf, end_lbl, none_lbl, end_lbl, end_lbl})
    emit(ctx, tag_buf2)
    return opt_str
}

fn gen_builtin(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val name: ref u8 = parser.node_str_raw(expr.d0)
    val args: ref void = expr.d1 as ref void

    if str.raw_cmp(name, c"staticerror") == 0 {
        val msg: mut ref u8 = c""
        if args != none {
            val arg0_opt = @get(args, 0)
            if arg0_opt is some arg0 {
                val arg_node: ref parser.Node = arg0 as ref parser.Node
                if arg_node.kind == parser.NK_STR_LIT {
                    msg = parser.node_str_raw(arg_node.d0)
                }
            }
        }
        val line: i64 = expr.line
        val filename: ref u8 = ctx.current_filename
        if str.raw_cmp(filename, c"") == 0 {
            stdio.eprint("error: line {lld}: {s}\n", {line, msg})
        } else {
            stdio.eprint("error: {s}:{lld}: {s}\n", {filename, line, msg})
        }
        os.exit(1)
    }

    val tmp: mut i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8

    if str.raw_cmp(name, c"embed") == 0 {
        val epath: ref u8 = parser.node_str_raw(expr.d2)
        if epath == none {
            stdio.eprint("error: @embed path was not resolved\n", {})
            os.exit(1)
        }
        val before: i64 = @len(ctx.embed_labels) as i64
        val label: ref u8 = cg_embed_label(ctx, epath)
        if (@len(ctx.embed_labels) as i64) > before {
            cg_emit_embed_data(ctx, epath, label, expr.d3)
        }
        @snprintf(buf, 512, "    %%t{lld} =l copy ${s}\n", {tmp, label})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"embedlen") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =l copy {lld}\n", {tmp, expr.d3})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"alloc") == 0 {
        val sz: ref u8 = get_arg(ctx, args, 0)
        if ctx.leak_check {
            val file_index: i64 = intern_string_raw(ctx, ctx.current_filename)
            @snprintf(
                buf,
                512,
                "    %%t{lld} =l call $__sx_leak_alloc(l {s}, l $__str{lld}, l {lld})\n",
                {tmp, sz, file_index, expr.line}
            )
        } else {
            @snprintf(buf, 512, "    %%t{lld} =l call $malloc(l {s})\n", {tmp, sz})
        }
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"free") == 0 {
        val ptr: ref u8 = get_arg(ctx, args, 0)
        if ctx.leak_check {
            @snprintf(
                buf,
                512,
                "    call $__sx_leak_free(l {s})\n    %%t{lld} =l copy 0\n",
                {ptr, tmp}
            )
        } else {
            @snprintf(buf, 512, "    call $free(l {s})\n    %%t{lld} =l copy 0\n", {ptr, tmp})
        }
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"realloc") == 0 {
        val ptr2: ref u8 = get_arg(ctx, args, 0)
        val sz2: ref u8 = get_arg(ctx, args, 1)
        if ctx.leak_check {
            val file_index: i64 = intern_string_raw(ctx, ctx.current_filename)
            @snprintf(
                buf,
                512,
                "    %%t{lld} =l call $__sx_leak_realloc(l {s}, l {s}, l $__str{lld}, l {lld})\n",
                {tmp, ptr2, sz2, file_index, expr.line}
            )
        } else {
            @snprintf(buf, 512, "    %%t{lld} =l call $realloc(l {s}, l {s})\n", {tmp, ptr2, sz2})
        }
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"dumpmemleaks") == 0 {
        val diag_fields: mut ref void = none
        val expected_diag: ref parser.Node = ctx.expected_ty as ref parser.Node
        if expected_diag != none {
            diag_fields = cg_struct_fields_for_type(ctx, expected_diag)
        }
        if diag_fields == none {
            diag_fields = cg_lookup_struct(ctx, c"testing.LeakDiagnostics")
        }
        if diag_fields == none {
            diag_fields = cg_lookup_struct(ctx, c"LeakDiagnostics")
        }
        val diag_size: mut i64 = 72
        if diag_fields != none {
            diag_size = struct_size(ctx, diag_fields)
        }
        if diag_size < 72 {
            diag_size = 72
        }
        @snprintf(
            buf,
            512,
            "    %%t{lld} =l call $calloc(l 1, l {lld})\n",
            {tmp, diag_size}
        )
        emit(ctx, buf)
        if ctx.leak_check {
            @snprintf(buf, 512, "    call $__sx_leak_fill(l %%t{lld})\n", {tmp})
            emit(ctx, buf)
        }
    } elif str.raw_cmp(name, c"memcpy") == 0 {
        val dst: ref u8 = get_arg(ctx, args, 0)
        val src: ref u8 = get_arg(ctx, args, 1)
        val len: ref u8 = get_arg(ctx, args, 2)
        @snprintf(
            buf,
            512,
            "    call $memcpy(l {s}, l {s}, l {s})\n    %%t{lld} =l copy 0\n",
            {dst, src, len, tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"memset") == 0 {
        val dst2: ref u8 = get_arg(ctx, args, 0)
        val val2: ref u8 = get_arg(ctx, args, 1)
        val len2: ref u8 = get_arg(ctx, args, 2)
        @snprintf(
            buf,
            512,
            "    call $memset(l {s}, w {s}, l {s})\n    %%t{lld} =l copy 0\n",
            {dst2, val2, len2, tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"load") == 0 || str.raw_cmp(name, c"load64") == 0 {
        val ptr3: ref u8 = get_arg(ctx, args, 0)
        @snprintf(buf, 512, "    %%t{lld} =l loadl {s}\n", {tmp, ptr3})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"store") == 0 || str.raw_cmp(name, c"store64") == 0 {
        val ptr4: ref u8 = get_arg(ctx, args, 0)
        val val3_node_opt = @get(args, 1)
        val val3: ref u8 = get_arg(ctx, args, 1)
        val val3_qtype: mut ref u8 = c"l"

        if val3_node_opt is some vn {
            val3_qtype = expr_qbe_type(ctx, vn as ref parser.Node)
        }

        if str.raw_cmp(val3_qtype, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, val3})
            emit(ctx, ext_buf)
            @snprintf(
                buf,
                512,
                "    storel %%t{lld}, {s}\n    %%t{lld} =l copy 0\n",
                {ext_tmp, ptr4, tmp}
            )
        } else {
            @snprintf(buf, 512, "    storel {s}, {s}\n    %%t{lld} =l copy 0\n", {val3, ptr4, tmp})
        }
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"load8") == 0 {
        val ptr5: ref u8 = get_arg(ctx, args, 0)
        val w_tmp: i64 = fresh_tmp(ctx)
        val wbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(wbuf, 64, "    %%t{lld} =w loadub {s}\n", {w_tmp, ptr5})
        emit(ctx, wbuf)
        @snprintf(buf, 512, "    %%t{lld} =l extsw %%t{lld}\n", {tmp, w_tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"load16") == 0 {
        val ptr16: ref u8 = get_arg(ctx, args, 0)
        val w_tmp16: i64 = fresh_tmp(ctx)
        val wbuf16: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(wbuf16, 64, "    %%t{lld} =w loaduh {s}\n", {w_tmp16, ptr16})
        emit(ctx, wbuf16)
        @snprintf(buf, 512, "    %%t{lld} =l extsw %%t{lld}\n", {tmp, w_tmp16})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"load32") == 0 {
        val ptr32: ref u8 = get_arg(ctx, args, 0)
        val w_tmp32: i64 = fresh_tmp(ctx)
        val wbuf32: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(wbuf32, 64, "    %%t{lld} =w loadsw {s}\n", {w_tmp32, ptr32})
        emit(ctx, wbuf32)
        @snprintf(buf, 512, "    %%t{lld} =l extsw %%t{lld}\n", {tmp, w_tmp32})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"store8") == 0 {
        val ptr6: ref u8 = get_arg(ctx, args, 0)
        val val4: ref u8 = get_arg(ctx, args, 1)
        @snprintf(buf, 512, "    storeb {s}, {s}\n    %%t{lld} =l copy 0\n", {val4, ptr6, tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"store16") == 0 {
        val ptr16: ref u8 = get_arg(ctx, args, 0)
        val val16: ref u8 = get_arg(ctx, args, 1)
        val val16_node_opt = @get(args, 1)
        val val16_qtype: mut ref u8 = c"l"
        if val16_node_opt is some vn16 {
            val16_qtype = expr_qbe_type(ctx, vn16 as ref parser.Node)
        }
        val store_val16: mut ref u8 = val16
        if str.raw_cmp(val16_qtype, c"w") != 0 {
            val trunc16: i64 = fresh_tmp(ctx)
            val trunc16_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(trunc16_buf, 64, "    %%t{lld} =w copy {s}\n", {trunc16, val16})
            emit(
                ctx,
                trunc16_buf
            )
            val trunc16_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(trunc16_res, 16, "%%t{lld}", {trunc16})
            store_val16 = trunc16_res
        }
        @snprintf(
            buf,
            512,
            "    storeh {s}, {s}\n    %%t{lld} =l copy 0\n",
            {store_val16, ptr16, tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"store32") == 0 {
        val ptr32: ref u8 = get_arg(ctx, args, 0)
        val val32: ref u8 = get_arg(ctx, args, 1)
        val val32_node_opt = @get(args, 1)
        val val32_qtype: mut ref u8 = c"l"
        if val32_node_opt is some vn32 {
            val32_qtype = expr_qbe_type(ctx, vn32 as ref parser.Node)
        }
        val store_val32: mut ref u8 = val32
        if str.raw_cmp(val32_qtype, c"w") != 0 {
            val trunc32: i64 = fresh_tmp(ctx)
            val trunc32_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(trunc32_buf, 64, "    %%t{lld} =w copy {s}\n", {trunc32, val32})
            emit(
                ctx,
                trunc32_buf
            )
            val trunc32_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(trunc32_res, 16, "%%t{lld}", {trunc32})
            store_val32 = trunc32_res
        }
        @snprintf(
            buf,
            512,
            "    storew {s}, {s}\n    %%t{lld} =l copy 0\n",
            {store_val32, ptr32, tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"ptradd") == 0 {
        val ptr7: ref u8 = get_arg(ctx, args, 0)
        val off: ref u8 = get_arg(ctx, args, 1)
        @snprintf(buf, 512, "    %%t{lld} =l add {s}, {s}\n", {tmp, ptr7, off})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"puts") == 0 {
        val s: mut ref u8 = c"0"
        if args != none {
            val alen_puts: i64 = @len(args) as i64
            if alen_puts > 0 {
                val a_opt = @get(args, 0)
                if a_opt is some a {
                    s = gen_cstr_arg(ctx, a as ref parser.Node)
                }
            }
        }
        @snprintf(buf, 512, "    %%t{lld} =w call $puts(l {s})\n", {tmp, s})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"flush") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =w call $fflush(l 0)\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"print") == 0 {
        val fmt: ref u8 = get_print_format_arg(ctx, args)
        val call_buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            4096 as usize
        ) as ref u8
        val call_pos2: mut i64 = 0
        val hdr2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(hdr2, 256, "    %%t{lld} =w call $printf(l {s}, ...", {tmp, fmt})
        val hdr2_len: i64 = str.len_raw(hdr2 as ref u8)
        @memcpy(@ptradd(call_buf2, call_pos2), hdr2, hdr2_len)
        call_pos2 = call_pos2 + hdr2_len
        if args != none {
            val alen2: i64 = @len(args) as i64
            if alen2 > 1 {
                val pack_opt = @get(args, 1)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        val pack: ref void = pn.d0 as ref void
                        val plen2: i64 = @len(pack) as i64
                        val pi2: mut i64 = 0
                        for {
                            if pi2 >= plen2 {
                                break
                            }
                            val pe_opt = @get(pack, pi2 as usize)
                            if pe_opt is some pe {
                                val pe_node: ref parser.Node = pe as ref parser.Node
                                val pvarg: ref u8 = gen_print_arg(ctx, pe_node)
                                val pbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    128 as usize
                                ) as ref u8
                                @snprintf(pbuf2, 128, ", {s}", {pvarg})
                                val pbuf2_len: i64 = str.len_raw(pbuf2)
                                @memcpy(@ptradd(call_buf2, call_pos2), pbuf2, pbuf2_len)
                                call_pos2 = call_pos2 + pbuf2_len
                            }
                            pi2++
                        }
                    } elif pn.kind == parser.NK_IDENT &&
                    cg_current_fn_param_is_argspack(ctx, parser.node_str_raw(pn.d0)) {
                        val pack_val: ref u8 = gen_expr(ctx, pn)
                        val expanded: ref u8 = cg_expand_argspack_pack_args(ctx, pack_val)
                        val exp_len: i64 = str.len_raw(expanded)
                        @memcpy(@ptradd(call_buf2, call_pos2), expanded, exp_len)
                        call_pos2 = call_pos2 + exp_len
                    }
                }
            }
        }
        @store8(@ptradd(call_buf2, call_pos2), 41) // ')'
        call_pos2++
        @store8(@ptradd(call_buf2, call_pos2), 10) // '\n'
        call_pos2++
        @store8(@ptradd(call_buf2, call_pos2), 0)
        emit(ctx, call_buf2)
    } elif str.raw_cmp(name, c"snprintf") == 0 {
        val sbuf: ref u8 = get_arg(ctx, args, 0)
        val ssz: ref u8 = get_arg(ctx, args, 1)
        val ssz_qtype: mut ref u8 = c"l"
        val ssz_node_opt = @get(args, 1)
        if ssz_node_opt is some ssz_node {
            ssz_qtype = expr_qbe_type(ctx, ssz_node as ref parser.Node)
        }
        val ssz_l: ref u8 = cg_coerce_qtype(ctx, ssz, ssz_qtype, c"l")
        val sfmt: ref u8 = get_format_arg_viewaware(ctx, args, 2, 3)
        val scall_sb: ref void = str.StringBuilder.new()
        val shdr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(
            shdr,
            256,
            "    %%t{lld} =w call $snprintf(l {s}, l {s}, l {s}, ...",
            {tmp, sbuf, ssz_l, sfmt}
        )
        str.StringBuilder.append_cstr(scall_sb, shdr)
        if args != none {
            val salen: i64 = @len(args) as i64
            if salen > 3 {
                val spack_opt = @get(args, 3)
                if spack_opt is some spack_node {
                    val spn: ref parser.Node = spack_node as ref parser.Node
                    if spn.kind == parser.NK_ARGS_PACK {
                        val spack: ref void = spn.d0 as ref void
                        val splen: i64 = @len(spack) as i64
                        val spi: mut i64 = 0
                        for {
                            if spi >= splen {
                                break
                            }
                            val spe_opt = @get(spack, spi as usize)
                            if spe_opt is some spe {
                                val spe_node: ref parser.Node = spe as ref parser.Node
                                val svarg: ref u8 = gen_print_arg(ctx, spe_node)
                                val spbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    128 as usize
                                ) as ref u8
                                @snprintf(spbuf, 128, ", {s}", {svarg})
                                str.StringBuilder.append_cstr(scall_sb, spbuf)
                            }
                            spi++
                        }
                    } elif spn.kind == parser.NK_IDENT &&
                    cg_current_fn_param_is_argspack(ctx, parser.node_str_raw(spn.d0)) {
                        val pack_val: ref u8 = gen_expr(ctx, spn)
                        val expanded: ref u8 = cg_expand_argspack_pack_args(ctx, pack_val)
                        str.StringBuilder.append_cstr(scall_sb, expanded)
                    } else {
                        // Single non-pack argument (e.g. argspack parameter passthrough)
                        val svarg2: ref u8 = gen_print_arg(ctx, spn)
                        val spbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(spbuf2, 128, ", {s}", {svarg2})
                        str.StringBuilder.append_cstr(scall_sb, spbuf2)
                    }
                }
            }
        }
        str.StringBuilder.append_cstr(scall_sb, c")\n")
        val scall_line: ref void = str.StringBuilder.build(scall_sb)
        str.StringBuilder.free(scall_sb)
        emit(ctx, str.cstr(scall_line))
        @free(@load(scall_line))
        @free(scall_line)
        val sext_tmp: i64 = fresh_tmp(ctx)
        val sext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(sext_buf, 64, "    %%t{lld} =l extsw %%t{lld}\n", {sext_tmp, tmp})
        emit(
            ctx,
            sext_buf
        )
        val sres: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(sres, 16, "%%t{lld}", {sext_tmp})
        return sres
    } elif str.raw_cmp(name, c"strlen") == 0 {
        val s2: ref u8 = get_arg(ctx, args, 0)
        @snprintf(buf, 512, "    %%t{lld} =l call $sxqbe_strlen(l {s})\n", {tmp, s2})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"strcmp") == 0 {
        val a: ref u8 = get_arg(ctx, args, 0)
        val b: ref u8 = get_arg(ctx, args, 1)
        @snprintf(buf, 512, "    %%t{lld} =l call $sxqbe_strcmp(l {s}, l {s})\n", {tmp, a, b})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"atoi") == 0 {
        val s3: ref u8 = get_arg(ctx, args, 0)
        @snprintf(buf, 512, "    %%t{lld} =l call $sxqbe_atoi(l {s})\n", {tmp, s3})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"append") == 0 {
        val lst: ref u8 = cg_list_arg_ensured(ctx, args, 0)
        val val5_node_opt = @get(args, 1)
        val val5_qtype: mut ref u8 = c"l"
        ctx.aggregate_heap++
        val val5_raw: ref u8 = get_arg(ctx, args, 1)
        ctx.aggregate_heap--
        val val5_ann: ref u8 = infer_type_annotation(ctx, val5_node_opt as ref parser.Node)
        val val5: ref u8 = cg_materialize_stack_aggregate_ann(ctx, val5_raw, val5_ann)
        if val5_node_opt is some vn {
            val5_qtype = expr_qtype(ctx, vn as ref parser.Node)
        }

        val len_slot: i64 = fresh_tmp(ctx)
        val cap_slot: i64 = fresh_tmp(ctx)
        val buf_app1: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_app1,
            256,
            "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 16\n",
            {len_slot, lst, cap_slot, lst}
        )
        emit(ctx, buf_app1)
        val len_val: i64 = fresh_tmp(ctx)
        val cap_val: i64 = fresh_tmp(ctx)
        val buf_app2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_app2,
            256,
            "    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
            {len_val, len_slot, cap_val, cap_slot}
        )
        emit(ctx, buf_app2)
        val grow_ok: i64 = fresh_tmp(ctx)
        val need_val: i64 = fresh_tmp(ctx)
        val grow_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            grow_buf,
            256,
            "    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =w call $sxqbe_list_grow(l {s}, l %%t{lld})\n",
            {need_val, len_val, grow_ok, lst, need_val}
        )
        emit(ctx, grow_buf)
        ctx.alloc_runtime = true
        val buf_tmp: i64 = fresh_tmp(ctx)
        val off: i64 = fresh_tmp(ctx)
        val elem_ptr: i64 = fresh_tmp(ctx)
        val buf_app8a: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(buf_app8a, 256, "    %%t{lld} =l call $sxqbe_list_buf(l {s})\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n",
            {buf_tmp, lst, off, len_val, elem_ptr, buf_tmp, off})
        emit(ctx, buf_app8a)
        val store_val: mut ref u8 = val5
        if str.raw_cmp(val5_qtype, c"w") == 0 {
            val ext_tmp: i64 = fresh_tmp(ctx)
            val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            val first_ch: i64 = @load8(@ptradd(val5, 0)) as i64
            if ((first_ch >= 48 && first_ch <= 57) || first_ch == 45) {
                @snprintf(ext_buf, 64, "    %%t{lld} =l copy {s}\n", {ext_tmp, val5})
            } else {
                @snprintf(ext_buf, 64, "    %%t{lld} =l extsw {s}\n", {ext_tmp, val5})
            }
            emit(
                ctx,
                ext_buf
            )
            val sv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(sv, 16, "%%t{lld}", {ext_tmp})
            store_val = sv
        } elif str.raw_cmp(val5_qtype, c"d") == 0 {
            val cast_app: i64 = fresh_tmp(ctx)
            val cast_app_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(cast_app_buf, 64, "    %%t{lld} =l cast {s}\n", {cast_app, val5})
            emit(
                ctx,
                cast_app_buf
            )
            val sv2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(sv2, 16, "%%t{lld}", {cast_app})
            store_val = sv2
        }
        val buf_app8b: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_app8b, 64, "    storel {s}, %%t{lld}\n", {store_val, elem_ptr})
        emit(ctx, buf_app8b)
        val new_len: i64 = fresh_tmp(ctx)
        val buf_app9: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_app9,
            256,
            "    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n",
            {new_len, len_val, new_len, len_slot}
        )
        emit(ctx, buf_app9)
        @snprintf(buf, 512, "    %%t{lld} =l copy 0\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"sizeof") == 0 {
        val arg_node_opt = @get(args, 0)
        val sizeof_val: mut i64 = 0
        if arg_node_opt is some arg_node {
            val arg_nd: ref parser.Node = arg_node as ref parser.Node
            val arg_k: i64 = arg_nd.kind
            if arg_k == parser.NK_IDENT {
                val vname: ref u8 = parser.node_str_raw(arg_nd.d0)
                val flds: ref void = cg_lookup_struct(ctx, vname)
                if flds != none {
                    sizeof_val = struct_size(ctx, flds)
                } else {
                    val ltype: ref u8 = cg_local_type(ctx, vname)
                    if str.raw_cmp(ltype, c"") != 0 {
                        val fake_ty: mut ref parser.Node = none
                        if str.raw_cmp(
                            ltype,
                            c"i8"
                        ) == 0 || str.raw_cmp(ltype, c"u8") == 0 || str.raw_cmp(ltype, c"u8") == 0 {
                            fake_ty = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
                            parser.node_store_string_slot(@addr(fake_ty.d0), ltype)
                            sizeof_val = type_size(fake_ty)
                        } elif str.raw_cmp(ltype, c"i16") == 0 || str.raw_cmp(ltype, c"u16") == 0 {
                            fake_ty = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
                            parser.node_store_string_slot(@addr(fake_ty.d0), ltype)
                            sizeof_val = type_size(fake_ty)
                        } elif str.raw_cmp(
                            ltype,
                            c"i32"
                        ) == 0 || str.raw_cmp(ltype, c"u32") == 0 || str.raw_cmp(ltype, c"f32") == 0 {
                            fake_ty = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
                            parser.node_store_string_slot(@addr(fake_ty.d0), ltype)
                            sizeof_val = type_size(fake_ty)
                        } elif str.raw_cmp(
                            ltype,
                            c"i64"
                        ) == 0 || str.raw_cmp(ltype, c"u64") == 0 || str.raw_cmp(ltype, c"f64") == 0 {
                            sizeof_val = 8
                        } elif str.raw_cmp(ltype, c"bool") == 0 {
                            sizeof_val = 4
                        } else {
                            val flds2: ref void = cg_lookup_struct(ctx, ltype)
                            if flds2 != none {
                                sizeof_val = struct_size(ctx, flds2)
                            } else {
                                sizeof_val = 8
                            }
                        }
                    } else {
                        sizeof_val = 8
                    }
                }
            } elif arg_k == parser.NK_CAST {
                val ty: ref parser.Node = arg_nd.d1 as ref parser.Node
                sizeof_val = type_size(ty)
            } elif arg_k == parser.TY_NAMED {
                val tname: ref u8 = parser.node_str_raw(arg_nd.d0)
                val flds: ref void = cg_lookup_struct(ctx, tname)
                if flds != none {
                    sizeof_val = struct_size(ctx, flds)
                } else {
                    sizeof_val = type_size(arg_nd)
                }
            } elif arg_k == parser.TY_LIST || arg_k == parser.TY_REF ||
            arg_k == parser.TY_MUT || arg_k == parser.TY_OPTION || arg_k == parser.TY_RESULT ||
            arg_k == parser.TY_SLICE || arg_k == parser.TY_FIXED_ARR || arg_k == parser.TY_FNPTR ||
            arg_k == parser.TY_VOID {
                sizeof_val = type_size(arg_nd)
            } else {
                sizeof_val = 8
            }
        } else {
            sizeof_val = 0
        }
        @snprintf(buf, 512, "    %%t{lld} =l copy {lld}\n", {tmp, sizeof_val})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"bitcast") == 0 {
        val target_opt = @get(args as list[ref parser.Node], 0 as usize)
        val source_opt = @get(args as list[ref parser.Node], 1 as usize)
        if source_opt is some source_node_raw {
            val source_node: ref parser.Node = source_node_raw as ref parser.Node
            val source_qtype: ref u8 = expr_qbe_type(ctx, source_node)
            val source_expr: ref u8 = gen_expr(ctx, source_node)
            val target_qtype: mut ref u8 = c"l"
            val target_size: mut i64 = 8
            if target_opt is some target_node_raw {
                val target_node: ref parser.Node = target_node_raw as ref parser.Node
                target_qtype = qbe_type_of(target_node)
                target_size = type_size(target_node)
            }
            if str.raw_cmp(source_qtype, target_qtype) == 0 {
                @snprintf(
                    buf,
                    512,
                    "    %%t{lld} ={s} copy {s}\n",
                    {tmp, target_qtype, source_expr}
                )
                emit(ctx, buf)
            } else {
                val slot_tmp: i64 = fresh_tmp(ctx)
                val alloc_size: mut i64 = target_size
                if alloc_size < 8 {
                    alloc_size = 8
                }
                val slot_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(slot_buf, 128, "    %%t{lld} =l alloc8 {lld}\n", {slot_tmp, alloc_size})
                emit(ctx, slot_buf)
                val store_op: mut ref u8 = c"storel"
                if str.raw_cmp(source_qtype, c"w") == 0 {
                    store_op = c"storew"
                } elif str.raw_cmp(source_qtype, c"s") == 0 {
                    store_op = c"stores"
                } elif str.raw_cmp(source_qtype, c"d") == 0 {
                    store_op = c"stored"
                }
                val store_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(
                    store_buf,
                    128,
                    "    {s} {s}, %%t{lld}\n",
                    {store_op, source_expr, slot_tmp}
                )
                emit(ctx, store_buf)
                val load_op: mut ref u8 = c"loadl"
                if str.raw_cmp(target_qtype, c"w") == 0 {
                    load_op = c"loadw"
                } elif str.raw_cmp(target_qtype, c"s") == 0 {
                    load_op = c"loads"
                } elif str.raw_cmp(target_qtype, c"d") == 0 {
                    load_op = c"loadd"
                }
                @snprintf(
                    buf,
                    512,
                    "    %%t{lld} ={s} {s} %%t{lld}\n",
                    {tmp, target_qtype, load_op, slot_tmp}
                )
                emit(ctx, buf)
            }
        } else {
            @snprintf(buf, 512, "    %%t{lld} =l copy 0\n", {tmp})
            emit(ctx, buf)
        }
    } elif str.raw_cmp(name, c"len") == 0 {
        val lst2: ref u8 = get_list_arg(ctx, args, 0)
        val len_val: i64 = fresh_tmp(ctx)
        @snprintf(
            buf,
            512,
            "    %%t{lld} =l call $sxqbe_list_len(l {s})\n",
            {len_val, lst2}
        )
        emit(ctx, buf)
        ctx.alloc_runtime = true
        tmp = len_val
    } elif str.raw_cmp(name, c"get") == 0 || str.raw_cmp(name, c"getref") == 0
    || str.raw_cmp(name, c"getmut") == 0 {
        if true {
            val get_mode: mut i64 = 0
            if str.raw_cmp(name, c"getref") == 0 {
                get_mode = 1
            } elif str.raw_cmp(name, c"getmut") == 0 {
                get_mode = 2
            }
            return gen_get_unboxed(ctx, expr, args, get_mode)
        }
        val arg0_opt = @get(args as list[ref parser.Node], 0 as usize)
        val base_ann: mut ref u8 = c""
        if arg0_opt is some a0 {
            base_ann = infer_type_annotation(ctx, a0 as ref parser.Node)
        }

        if raw_starts_with(base_ann, c"[") {
            val arg_count: i64 = @len(args as list[ref parser.Node]) as i64
            val result_slot: i64 = fresh_tmp(ctx)
            val none_lbl: i64 = fresh_lbl(ctx)
            val end_lbl: i64 = fresh_lbl(ctx)
            val base_ptr_name: mut ref u8 = get_arg(ctx, args, 0)
            val cur_ann: mut ref u8 = base_ann
            val ai: mut i64 = 1

            val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(init_buf, 64, "    %%t{lld} =l alloc8 8\n", {result_slot})
            emit(ctx, init_buf)
            for {
                if ai >= arg_count {
                    break
                }
                if !raw_starts_with(cur_ann, c"[") {
                    val fail_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(fail_buf, 64, "    jmp @lbl{lld}\n", {none_lbl})
                    emit(ctx, fail_buf)
                    break
                }
                val idx_i_raw: ref u8 = get_arg(ctx, args, ai)
                val idx_i_node_opt = @get(args as list[ref parser.Node], ai as usize)
                val idx_i_qt: mut ref u8 = c"l"
                if idx_i_node_opt is some idx_node {
                    idx_i_qt = expr_qtype(ctx, idx_node as ref parser.Node)
                }
                val idx_i: ref u8 = cg_coerce_qtype(ctx, idx_i_raw, idx_i_qt, c"l")
                val len_i: i64 = cg_ann_fixed_arr_len_val(ctx, cur_ann)
                val next_ann: ref u8 = ann_fixed_arr_inner(cur_ann)
                val elem_sz: i64 = cg_ann_size(ctx, next_ann)
                val ok_tmp: i64 = fresh_tmp(ctx)
                val ok_lbl: i64 = fresh_lbl(ctx)
                val step_ptr: i64 = fresh_tmp(ctx)
                val step_off: i64 = fresh_tmp(ctx)
                val dim_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    384 as usize
                ) as ref u8
                @snprintf(dim_buf, 384,
                    "    %%t{lld} =w csltl {s}, {lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n    %%t{lld} =l mul {s}, {lld}\n    %%t{lld} =l add {s}, %%t{lld}\n",
                    {
                        ok_tmp,
                        idx_i,
                        len_i,
                        ok_tmp,
                        ok_lbl,
                        none_lbl,
                        ok_lbl,
                        step_off,
                        idx_i,
                        elem_sz,
                        step_ptr,
                        base_ptr_name,
                        step_off
                    })
                emit(
                    ctx,
                    dim_buf
                )
                val step_name: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(step_name, 16, "%%t{lld}", {step_ptr})
                base_ptr_name = step_name
                cur_ann = next_ann
                ai++
            }

            if raw_starts_with(cur_ann, c"[") {
                val some_box: i64 = fresh_tmp(ctx)
                val some_ptr: i64 = fresh_tmp(ctx)
                val some_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    192 as usize
                ) as ref u8
                @snprintf(some_buf, 192, "    %%t{lld} =l call $malloc(l 8)\n    storel {s}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                    {
                        some_box,
                        base_ptr_name,
                        some_box,
                        some_ptr,
                        some_box,
                        some_ptr,
                        result_slot,
                        end_lbl
                    })
                emit(ctx, some_buf)
            } else {
                val load_tmp: i64 = fresh_tmp(ctx)
                val load_instr: ref u8 = cg_ann_load_instr(cur_ann)
                val qtype_get: ref u8 = cg_ann_qtype(cur_ann)
                val done_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                if str.raw_cmp(qtype_get, c"d") == 0 || str.raw_cmp(qtype_get, c"s") == 0 {
                    val box_tmp: i64 = fresh_tmp(ctx)
                    val some_tmp: i64 = fresh_tmp(ctx)
                    if str.raw_cmp(qtype_get, c"d") == 0 {
                        @snprintf(done_buf, 512,
                            "    %%t{lld} =d {s} {s}\n    %%t{lld} =l call $malloc(l 8)\n    stored %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                            {
                                load_tmp,
                                load_instr,
                                base_ptr_name,
                                box_tmp,
                                load_tmp,
                                box_tmp,
                                some_tmp,
                                box_tmp,
                                some_tmp,
                                result_slot,
                                end_lbl
                            })
                    } else {
                        @snprintf(done_buf, 512,
                            "    %%t{lld} =s {s} {s}\n    %%t{lld} =l call $malloc(l 8)\n    stores %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                            {
                                load_tmp,
                                load_instr,
                                base_ptr_name,
                                box_tmp,
                                load_tmp,
                                box_tmp,
                                some_tmp,
                                box_tmp,
                                some_tmp,
                                result_slot,
                                end_lbl
                            })
                    }
                } elif str.raw_cmp(qtype_get, c"w") == 0 {
                    val ext_tmp: i64 = fresh_tmp(ctx)
                    val box_tmp2: i64 = fresh_tmp(ctx)
                    val some_tmp2: i64 = fresh_tmp(ctx)
                    val ext_instr: ref u8 = cg_ann_word_extend_instr(cur_ann)
                    @snprintf(done_buf, 512,
                        "    %%t{lld} =w {s} {s}\n    %%t{lld} =l {s} %%t{lld}\n    %%t{lld} =l call $malloc(l 8)\n    storel %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                        {
                            load_tmp,
                            load_instr,
                            base_ptr_name,
                            ext_tmp,
                            ext_instr,
                            load_tmp,
                            box_tmp2,
                            ext_tmp,
                            box_tmp2,
                            some_tmp2,
                            box_tmp2,
                            some_tmp2,
                            result_slot,
                            end_lbl
                        })
                } else {
                    val box_tmp3: i64 = fresh_tmp(ctx)
                    val some_tmp3: i64 = fresh_tmp(ctx)
                    @snprintf(done_buf, 512,
                        "    %%t{lld} =l {s} {s}\n    %%t{lld} =l call $malloc(l 8)\n    storel %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                        {
                            load_tmp,
                            load_instr,
                            base_ptr_name,
                            box_tmp3,
                            load_tmp,
                            box_tmp3,
                            some_tmp3,
                            box_tmp3,
                            some_tmp3,
                            result_slot,
                            end_lbl
                        })
                }
                emit(ctx, done_buf)
            }

            val none_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(none_buf, 128, "@lbl{lld}\n    storel 0, %%t{lld}\n@lbl{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
                {none_lbl, result_slot, end_lbl, tmp, result_slot})
            emit(ctx, none_buf)
        } else {
            val lst3: ref u8 = get_list_arg(ctx, args, 0)
            val idx: ref u8 = get_arg(ctx, args, 1)
            val elem_ann_list: mut ref u8 = c""
            if raw_starts_with(base_ann, c"list[") {
                val ba_len: i64 = str.len_raw(base_ann)
                elem_ann_list = str.substr(base_ann, 5, ba_len - 6)
            }

            val len_slot: i64 = fresh_tmp(ctx)
            val len_val: i64 = fresh_tmp(ctx)
            val buf_get1: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(
                buf_get1,
                256,
                "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n",
                {len_slot, lst3, len_val, len_slot}
            )
            emit(ctx, buf_get1)
            val in_bounds: i64 = fresh_tmp(ctx)
            val some_lbl: i64 = fresh_lbl(ctx)
            val none_lbl: i64 = fresh_lbl(ctx)
            val end_lbl: i64 = fresh_lbl(ctx)
            val result_slot: i64 = fresh_tmp(ctx)

            val buf_get2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf_get2, 256, "    %%t{lld} =l alloc8 8\n    %%t{lld} =w csltl {s}, %%t{lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n",
                {result_slot, in_bounds, idx, len_val, in_bounds, some_lbl, none_lbl})
            emit(
                ctx,
                buf_get2
            )
            val buf_get3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(buf_get3, 64, "@lbl{lld}\n", {some_lbl})
            emit(ctx, buf_get3)
            val buf_get_tmp: i64 = fresh_tmp(ctx)
            val off: i64 = fresh_tmp(ctx)
            val elem_ptr: i64 = fresh_tmp(ctx)
            val elem_val: i64 = fresh_tmp(ctx)

            val buf_get4: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                768 as usize
            ) as ref u8
            if str.raw_cmp(elem_ann_list, c"f64") == 0 || str.raw_cmp(elem_ann_list, c"f32") == 0 {
                val box_tmp2: i64 = fresh_tmp(ctx)
                val some_val2: i64 = fresh_tmp(ctx)
                val load_instr2: ref u8 = cg_ann_load_instr(elem_ann_list)
                if str.raw_cmp(elem_ann_list, c"f64") == 0 {
                    @snprintf(buf_get4, 768, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =d {s} %%t{lld}\n    %%t{lld} =l call $malloc(l 8)\n    stored %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                        {
                            buf_get_tmp,
                            lst3,
                            off,
                            idx,
                            elem_ptr,
                            buf_get_tmp,
                            off,
                            elem_val,
                            load_instr2,
                            elem_ptr,
                            box_tmp2,
                            elem_val,
                            box_tmp2,
                            some_val2,
                            box_tmp2,
                            some_val2,
                            result_slot,
                            end_lbl
                        })
                } else {
                    @snprintf(buf_get4, 768, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =s {s} %%t{lld}\n    %%t{lld} =l call $malloc(l 8)\n    stores %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                        {
                            buf_get_tmp,
                            lst3,
                            off,
                            idx,
                            elem_ptr,
                            buf_get_tmp,
                            off,
                            elem_val,
                            load_instr2,
                            elem_ptr,
                            box_tmp2,
                            elem_val,
                            box_tmp2,
                            some_val2,
                            box_tmp2,
                            some_val2,
                            result_slot,
                            end_lbl
                        })
                }
            } else {
                val box_tmp4: i64 = fresh_tmp(ctx)
                val some_val: i64 = fresh_tmp(ctx)
                @snprintf(buf_get4, 768, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l call $malloc(l 8)\n    storel %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n",
                    {
                        buf_get_tmp,
                        lst3,
                        off,
                        idx,
                        elem_ptr,
                        buf_get_tmp,
                        off,
                        elem_val,
                        elem_ptr,
                        box_tmp4,
                        elem_val,
                        box_tmp4,
                        some_val,
                        box_tmp4,
                        some_val,
                        result_slot,
                        end_lbl
                    })
            }
            emit(
                ctx,
                buf_get4
            )
            val buf_get5: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                buf_get5,
                128,
                "@lbl{lld}\n    storel 0, %%t{lld}\n    jmp @lbl{lld}\n",
                {none_lbl, result_slot, end_lbl}
            )
            emit(
                ctx,
                buf_get5
            )
            val buf_get6: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(
                buf_get6,
                128,
                "@lbl{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
                {end_lbl, tmp, result_slot}
            )
            emit(ctx, buf_get6)
        }
    } elif str.raw_cmp(name, c"set") == 0 {
        val lst_s: ref u8 = get_list_arg(ctx, args, 0)
        val idx_s: ref u8 = get_arg(ctx, args, 1)
        val val_s_node_opt = @get(args, 2)
        val val_s_qtype: mut ref u8 = c"l"
        ctx.aggregate_heap++
        val val_s_raw: ref u8 = get_arg(ctx, args, 2)
        ctx.aggregate_heap--
        val val_s_ann: ref u8 = infer_type_annotation(ctx, val_s_node_opt as ref parser.Node)
        val val_s: ref u8 = cg_materialize_stack_aggregate_ann(ctx, val_s_raw, val_s_ann)
        if val_s_node_opt is some vn_s {
            val_s_qtype = expr_qtype(ctx, vn_s as ref parser.Node)
        }
        val data_s: i64 = fresh_tmp(ctx)
        val off_s: i64 = fresh_tmp(ctx)
        val eptr_s: i64 = fresh_tmp(ctx)
        val set_b1: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(set_b1, 256, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n",
            {data_s, lst_s, off_s, idx_s, eptr_s, data_s, off_s})
        emit(ctx, set_b1)
        val sv_s: mut ref u8 = val_s
        if str.raw_cmp(val_s_qtype, c"w") == 0 {
            val ext_s: i64 = fresh_tmp(ctx)
            val ext_b: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            val fc_s: i64 = @load8(@ptradd(val_s, 0)) as i64
            if ((fc_s >= 48 && fc_s <= 57) || fc_s == 45) {
                @snprintf(ext_b, 64, "    %%t{lld} =l copy {s}\n", {ext_s, val_s})
            } else {
                @snprintf(ext_b, 64, "    %%t{lld} =l extsw {s}\n", {ext_s, val_s})
            }
            emit(
                ctx,
                ext_b
            )
            val sv_s2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(sv_s2, 16, "%%t{lld}", {ext_s})
            sv_s = sv_s2
        } elif str.raw_cmp(val_s_qtype, c"d") == 0 {
            val cast_s: i64 = fresh_tmp(ctx)
            val cast_b: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(cast_b, 64, "    %%t{lld} =l cast {s}\n", {cast_s, val_s})
            emit(
                ctx,
                cast_b
            )
            val sv_s3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(sv_s3, 16, "%%t{lld}", {cast_s})
            sv_s = sv_s3
        }
        val set_b2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(set_b2, 64, "    storel {s}, %%t{lld}\n", {sv_s, eptr_s})
        emit(ctx, set_b2)
        @snprintf(buf, 512, "    %%t{lld} =l copy 0\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"remove") == 0 {
        val lst4: ref u8 = cg_list_arg_ensured(ctx, args, 0)
        val idx2: ref u8 = get_arg(ctx, args, 1)

        val len_slot: i64 = fresh_tmp(ctx)
        val len_val: i64 = fresh_tmp(ctx)
        val buf_rem1: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_rem1,
            256,
            "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n",
            {len_slot, lst4, len_val, len_slot}
        )
        emit(ctx, buf_rem1)
        val buf_tmp: i64 = fresh_tmp(ctx)
        val off: i64 = fresh_tmp(ctx)
        val elem_ptr: i64 = fresh_tmp(ctx)
        val elem_val: i64 = fresh_tmp(ctx)
        val buf_rem2: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(buf_rem2, 512, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
            {buf_tmp, lst4, off, idx2, elem_ptr, buf_tmp, off, elem_val, elem_ptr})
        emit(ctx, buf_rem2)
        val shift_loop: i64 = fresh_lbl(ctx)
        val shift_body: i64 = fresh_lbl(ctx)
        val shift_end: i64 = fresh_lbl(ctx)
        val shift_idx: i64 = fresh_tmp(ctx)

        val buf_rem3: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_rem3,
            256,
            "    %%t{lld} =l copy {s}\n    jmp @lbl{lld}\n",
            {shift_idx, idx2, shift_loop}
        )
        emit(
            ctx,
            buf_rem3
        )
        val buf_rem4: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_rem4, 64, "@lbl{lld}\n", {shift_loop})
        emit(ctx, buf_rem4)
        val one_past_end: i64 = fresh_tmp(ctx)
        val should_shift: i64 = fresh_tmp(ctx)
        val buf_rem5: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(buf_rem5, 256, "    %%t{lld} =l sub %%t{lld}, 1\n    %%t{lld} =w csltl %%t{lld}, %%t{lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n",
            {
                one_past_end,
                len_val,
                should_shift,
                shift_idx,
                one_past_end,
                should_shift,
                shift_body,
                shift_end
            })
        emit(
            ctx,
            buf_rem5
        )
        val buf_rem6: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_rem6, 64, "@lbl{lld}\n", {shift_body})
        emit(ctx, buf_rem6)
        val src_off_tmp: i64 = fresh_tmp(ctx)
        val src_off: i64 = fresh_tmp(ctx)
        val dst_off: i64 = fresh_tmp(ctx)
        val buf_tmp2: i64 = fresh_tmp(ctx)
        val src_ptr: i64 = fresh_tmp(ctx)
        val dst_ptr: i64 = fresh_tmp(ctx)
        val src_val: i64 = fresh_tmp(ctx)
        val buf_rem7: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(buf_rem7, 512, "    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l loadl {s}\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    storel %%t{lld}, %%t{lld}\n",
            {
                src_off_tmp,
                shift_idx,
                src_off,
                src_off_tmp,
                dst_off,
                shift_idx,
                buf_tmp2,
                lst4,
                src_ptr,
                buf_tmp2,
                src_off,
                dst_ptr,
                buf_tmp2,
                dst_off,
                src_val,
                src_ptr,
                src_val,
                dst_ptr
            })
        emit(ctx, buf_rem7)
        val shift_idx_new: i64 = fresh_tmp(ctx)
        val buf_rem8: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(buf_rem8, 256, "    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =l copy %%t{lld}\n    jmp @lbl{lld}\n",
            {shift_idx_new, shift_idx, shift_idx, shift_idx_new, shift_loop})
        emit(
            ctx,
            buf_rem8
        )
        val buf_rem9: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_rem9, 64, "@lbl{lld}\n", {shift_end})
        emit(ctx, buf_rem9)
        val new_len: i64 = fresh_tmp(ctx)
        val buf_rem10: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_rem10,
            256,
            "    %%t{lld} =l sub %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n",
            {new_len, len_val, new_len, len_slot}
        )
        emit(ctx, buf_rem10)
        tmp = elem_val
    } elif str.raw_cmp(name, c"insert") == 0 {
        val lst_ins: ref u8 = cg_list_arg_ensured(ctx, args, 0)
        val idx_ins: ref u8 = get_arg(ctx, args, 1)
        val val_ins_node_opt = @get(args, 2)
        ctx.aggregate_heap++
        val val_ins_raw: ref u8 = get_arg(ctx, args, 2)
        ctx.aggregate_heap--
        val val_ins_ann: ref u8 = infer_type_annotation(ctx, val_ins_node_opt as ref parser.Node)
        val val_ins: ref u8 = cg_materialize_stack_aggregate_ann(
            ctx,
            val_ins_raw,
            val_ins_ann
        )

        val len_slot: i64 = fresh_tmp(ctx)
        val cap_slot: i64 = fresh_tmp(ctx)
        val len_val: i64 = fresh_tmp(ctx)
        val cap_val: i64 = fresh_tmp(ctx)
        val buf_ins1: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(buf_ins1, 512, "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l add {s}, 16\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
            {len_slot, lst_ins, cap_slot, lst_ins, len_val, len_slot, cap_val, cap_slot})
        emit(ctx, buf_ins1)
        val grow_ok: i64 = fresh_tmp(ctx)
        val need_val: i64 = fresh_tmp(ctx)
        val grow_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            grow_buf,
            256,
            "    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =w call $sxqbe_list_grow(l {s}, l %%t{lld})\n",
            {need_val, len_val, grow_ok, lst_ins, need_val}
        )
        emit(ctx, grow_buf)
        ctx.alloc_runtime = true
        val shift_loop: i64 = fresh_lbl(ctx)
        val shift_body: i64 = fresh_lbl(ctx)
        val shift_end: i64 = fresh_lbl(ctx)
        val shift_idx: i64 = fresh_tmp(ctx)

        val buf_ins7: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_ins7,
            256,
            "    %%t{lld} =l sub %%t{lld}, 1\n    jmp @lbl{lld}\n",
            {shift_idx, len_val, shift_loop}
        )
        emit(
            ctx,
            buf_ins7
        )
        val buf_ins8: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_ins8, 64, "@lbl{lld}\n", {shift_loop})
        emit(ctx, buf_ins8)
        val should_shift: i64 = fresh_tmp(ctx)
        val buf_ins9: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(buf_ins9, 256, "    %%t{lld} =w cslel {s}, %%t{lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n",
            {should_shift, idx_ins, shift_idx, should_shift, shift_body, shift_end})
        emit(
            ctx,
            buf_ins9
        )
        val buf_ins10: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_ins10, 64, "@lbl{lld}\n", {shift_body})
        emit(ctx, buf_ins10)
        val src_off: i64 = fresh_tmp(ctx)
        val dst_off_tmp: i64 = fresh_tmp(ctx)
        val dst_off: i64 = fresh_tmp(ctx)
        val src_ptr: i64 = fresh_tmp(ctx)
        val dst_ptr: i64 = fresh_tmp(ctx)
        val src_val: i64 = fresh_tmp(ctx)
        val buf2: i64 = fresh_tmp(ctx)
        val buf_ins11: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(buf_ins11, 512, "    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l loadl {s}\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    storel %%t{lld}, %%t{lld}\n",
            {
                src_off,
                shift_idx,
                dst_off_tmp,
                shift_idx,
                dst_off,
                dst_off_tmp,
                buf2,
                lst_ins,
                src_ptr,
                buf2,
                src_off,
                dst_ptr,
                buf2,
                dst_off,
                src_val,
                src_ptr,
                src_val,
                dst_ptr
            })
        emit(ctx, buf_ins11)
        val shift_idx_new: i64 = fresh_tmp(ctx)
        val buf_ins12: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(buf_ins12, 256, "    %%t{lld} =l sub %%t{lld}, 1\n    %%t{lld} =l copy %%t{lld}\n    jmp @lbl{lld}\n",
            {shift_idx_new, shift_idx, shift_idx, shift_idx_new, shift_loop})
        emit(
            ctx,
            buf_ins12
        )
        val buf_ins13: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(buf_ins13, 64, "@lbl{lld}\n", {shift_end})
        emit(ctx, buf_ins13)
        val buf3: i64 = fresh_tmp(ctx)
        val elem_off: i64 = fresh_tmp(ctx)
        val elem_ptr: i64 = fresh_tmp(ctx)
        val buf_ins14: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(buf_ins14, 512, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l mul {s}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    storel {s}, %%t{lld}\n",
            {buf3, lst_ins, elem_off, idx_ins, elem_ptr, buf3, elem_off, val_ins, elem_ptr})
        emit(ctx, buf_ins14)
        val new_len: i64 = fresh_tmp(ctx)
        val buf_ins15: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
