    \\void* __sx_leak_realloc(void* ptr, unsigned long long size, const char* file, long long line) {
    \\    if (!ptr) return __sx_leak_alloc(size, file, line);
    \\    if (size == 0) {
    \\        __sx_leak_free(ptr);
