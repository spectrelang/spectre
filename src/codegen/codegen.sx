    \\static long long sx_leak_collect_records(void) {
    \\    long long count = sx_leak_live_allocations;
    \\    if (count > sx_leak_records_cap) {
    \\        long long cap = count < 8 ? 8 : count;
    \\        sx_leak_record* next = (sx_leak_record*)realloc(sx_leak_records, (size_t)cap * sizeof(sx_leak_record));
    \\        if (!next) return 0;
