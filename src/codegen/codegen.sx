extern (C, header) fn strstr(haystack: ref u8, needle: ref u8) ref u8 = "strstr"

/// Codegen context
pub type CgCtx = {
    sb: mut ref void
    arena: mut allocators.ScopedArenaAllocator
    mono_sb: mut ref void
    tmp: mut i64
    lbl: mut i64
    fn_name: mut ref u8
    current_fn_ret_qtype: mut ref u8
    current_fn_ret_union: mut ref u8
    current_fn_ret_ty: mut ref void
    expected_ty: mut ref void
    strs: mut list[str.StringView]
    str_cnt: mut i64
    sv_stridx: mut list[i64]
    sv_len: mut list[i64]
    tdefs: mut list[ref void]
    edefs: mut list[ref void]
    dvars: mut list[ref u8]
    dqtypes: mut list[ref u8]
    snames: mut list[ref u8]
    sfields: mut list[ref void]
    sis_extern: mut list[bool]
    lnames: mut list[ref u8]
    ltypes: mut list[ref u8]
    unames: mut list[ref u8]
    uvariants: mut list[ref void]
    fn_nodes: mut list[ref void]
    fn_names: mut list[ref u8]
    fn_params: mut list[ref void]
    fn_rets: mut list[ref void]
    ext_names: mut list[ref u8]
    ext_syms: mut list[ref u8]
    ext_rets: mut list[ref void]
    tv_names: mut list[ref u8]
    tv_owners: mut list[ref u8]
    tv_tags: mut list[i64]
    tv_fields: mut list[ref void]
    break_lbl: mut i64
    cont_lbl: mut i64
    mc_names: mut list[ref u8]
    mc_vals: mut list[ref u8]
    mc_index: mut ref void
    fn_name_index: mut ref void
    fn_suffix_index: mut ref void
    defer_stack: mut list[ref void]
    local_src_names: mut list[ref u8]
    local_qbe_names: mut list[ref u8]
    local_slot_names: mut list[ref u8]
    local_ref_types: mut list[ref u8]
    global_src_names: mut list[ref u8]
    global_labels: mut list[ref u8]
    global_qtypes: mut list[ref u8]
    global_anns: mut list[ref u8]
    used_prefixes: mut list[ref u8]
    current_module_prefix: mut ref u8
    emitted_labels: mut list[ref u8]
    emitted_shims: mut list[ref u8]
    alloc_adapter_prefixes: mut list[ref u8]
    alloc_adapter_lines: mut list[ref u8]
    c_headers: mut list[ref u8]
    c_consts: mut list[ref u8]
    c_const_syms: mut list[ref u8]
    c_const_index: mut ref void
    global_inits: mut list[ref GlobalInit]
    release_mode: mut bool
    leak_check: mut bool
    src_target: mut ref u8
    inv_tnames: mut list[ref u8]
    inv_tlists: mut list[ref void]
    inv_cur_pnames: mut list[ref u8]
    inv_cur_ptypes: mut list[ref u8]
    gfn_names: mut list[ref u8]
    gfn_nodes: mut list[ref void]
    gfn_prefixes: mut list[ref u8]
    gsubst_names: mut list[ref u8]
    gsubst_tnodes: mut list[ref void]
    current_filename: mut ref u8
    embed_sb: mut ref void
    embed_paths: mut list[ref u8]
    embed_labels: mut list[ref u8]
    embed_count: mut i64
    alloc_runtime: mut bool
    current_fn_ret_unboxed: mut bool
    current_fn_ret_layout_size: mut i64
    aggregate_heap: mut i64
    stack_agg_values: mut list[ref u8]
}

/// Result of a code generation pass: QBE IR plus any generated C shim.
pub type CgOutput = {
    qbe: mut ref u8
    shim: mut ref u8
}

type GlobalInit = {
    label: mut ref u8
    ty: mut ref void
    expr: mut ref void
}

fn cg_list_slot(list: ref void, i: i64) ref void = trust {
    val buf: ref void = @load(list)
    return @ptradd(buf, (i * 8) as usize)
}

fn cg_copy_str(ctx: ref CgCtx, s: ref u8) ref u8 = trust {
    if s == none {
        return c""
    }
    val n: i64 = str.len_raw(s)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (n + 1) as usize
    ) as ref u8
    if n > 0 {
        @memcpy(out, s, n)
    }
    @store8(@ptradd(out, n), 0)
    return out
}

fn cg_new() ref CgCtx = trust {
    val ctx: mut ref CgCtx = @alloc(@sizeof(CgCtx)) as ref CgCtx
    match allocators.ScopedArena.new(67108864 as usize) {
        ok a => {
            ctx.arena = a
        }
        err _ => {
            os.exit(1)
        }
    }
    ctx.sb = str.StringBuilder.new()
    ctx.mono_sb = str.StringBuilder.new()
    ctx.tmp = 0
    ctx.lbl = 0
    ctx.fn_name = none
    ctx.current_fn_ret_qtype = c"l"
    ctx.current_fn_ret_union = c""
    ctx.current_fn_ret_ty = none
    ctx.expected_ty = none
    ctx.strs = mem.new[str.StringView]()
    ctx.str_cnt = 0
    ctx.sv_stridx = mem.new[i64]()
    ctx.sv_len = mem.new[i64]()
    ctx.tdefs = mem.new[ref void]()
    ctx.edefs = mem.new[ref void]()
    ctx.dvars = mem.new[ref u8]()
    ctx.dqtypes = mem.new[ref u8]()
    ctx.snames = mem.new[ref u8]()
    ctx.sfields = mem.new[ref void]()
    ctx.sis_extern = mem.new[bool]()
    ctx.lnames = mem.new[ref u8]()
    ctx.ltypes = mem.new[ref u8]()
    ctx.unames = mem.new[ref u8]()
    ctx.uvariants = mem.new[ref void]()
    ctx.fn_nodes = mem.new[ref void]()
    ctx.fn_names = mem.new[ref u8]()
    ctx.fn_params = mem.new[ref void]()
    ctx.fn_rets = mem.new[ref void]()
    ctx.ext_names = mem.new[ref u8]()
    ctx.ext_syms = mem.new[ref u8]()
    ctx.ext_rets = mem.new[ref void]()
    ctx.tv_names = mem.new[ref u8]()
    ctx.tv_owners = mem.new[ref u8]()
    ctx.tv_tags = mem.new[i64]()
    ctx.tv_fields = mem.new[ref void]()
    ctx.break_lbl = -1
    ctx.cont_lbl = -1
    ctx.mc_names = mem.new[ref u8]()
    ctx.mc_vals = mem.new[ref u8]()
    ctx.mc_index = collections.RawIndexMap.new(64 as usize)
    ctx.fn_name_index = collections.RawIndexMap.new(256 as usize)
    ctx.fn_suffix_index = collections.RawIndexMap.new(256 as usize)
    ctx.defer_stack = mem.new[ref void]()
    ctx.local_src_names = mem.new[ref u8]()
    ctx.local_qbe_names = mem.new[ref u8]()
    ctx.local_slot_names = mem.new[ref u8]()
    ctx.local_ref_types = mem.new[ref u8]()
    ctx.global_src_names = mem.new[ref u8]()
    ctx.global_labels = mem.new[ref u8]()
    ctx.global_qtypes = mem.new[ref u8]()
    ctx.global_anns = mem.new[ref u8]()
    ctx.used_prefixes = mem.new[ref u8]()
    ctx.current_module_prefix = c""
    ctx.emitted_labels = mem.new[ref u8]()
    ctx.emitted_shims = mem.new[ref u8]()
    ctx.alloc_adapter_prefixes = mem.new[ref u8]()
    ctx.alloc_adapter_lines = mem.new[ref u8]()
    ctx.c_headers = mem.new[ref u8]()
    ctx.c_consts = mem.new[ref u8]()
    ctx.c_const_syms = mem.new[ref u8]()
    ctx.c_const_index = collections.RawIndexMap.new(32 as usize)
    ctx.global_inits = mem.new[ref GlobalInit]()
    ctx.release_mode = false
    ctx.leak_check = false
    ctx.src_target = c""
    ctx.inv_tnames = mem.new[ref u8]()
    ctx.inv_tlists = mem.new[ref void]()
    ctx.inv_cur_pnames = mem.new[ref u8]()
    ctx.inv_cur_ptypes = mem.new[ref u8]()
    ctx.gfn_names = mem.new[ref u8]()
    ctx.gfn_nodes = mem.new[ref void]()
    ctx.gfn_prefixes = mem.new[ref u8]()
    ctx.gsubst_names = mem.new[ref u8]()
    ctx.gsubst_tnodes = mem.new[ref void]()
    ctx.current_filename = c""
    ctx.embed_sb = str.StringBuilder.new()
    ctx.embed_paths = mem.new[ref u8]()
    ctx.embed_labels = mem.new[ref u8]()
    ctx.embed_count = 0
    ctx.alloc_runtime = false
    ctx.current_fn_ret_unboxed = false
    ctx.current_fn_ret_layout_size = 0
    ctx.aggregate_heap = 0
    ctx.stack_agg_values = mem.new[ref u8]()
    cg_register_builtin_stringview(ctx)
    return ctx
}

fn cg_free_ctx(ctx: mut ref CgCtx) void = trust {
    if ctx.mc_index != none {
        collections.RawIndexMap.free(ctx.mc_index)
    }
    if ctx.fn_name_index != none {
        collections.RawIndexMap.free(ctx.fn_name_index)
    }
    if ctx.fn_suffix_index != none {
        collections.RawIndexMap.free(ctx.fn_suffix_index)
    }
    if ctx.c_const_index != none {
        collections.RawIndexMap.free(ctx.c_const_index)
    }
    @free(ctx)
}

fn cg_sb(ctx: ref CgCtx) ref void = {
    return ctx.sb as ref void
}

fn cg_tmp(ctx: ref CgCtx) i64 = {
    return ctx.tmp as i64
}

fn cg_lbl(ctx: ref CgCtx) i64 = {
    return ctx.lbl as i64
}

fn cg_fn_name(ctx: ref CgCtx) ref u8 = {
    return ctx.fn_name as ref u8
}

fn cg_strs(ctx: ref CgCtx) ref void = {
    return ctx.strs as ref void
}

fn cg_str_cnt(ctx: ref CgCtx) i64 = {
    return ctx.str_cnt as i64
}

fn cg_set_tmp(ctx: mut ref CgCtx, v: i64) void = trust {
    ctx.tmp = v
}

fn cg_set_lbl(ctx: mut ref CgCtx, v: i64) void = trust {
    ctx.lbl = v
}

fn cg_set_fn_name(ctx: mut ref CgCtx, v: ref u8) void = trust {
    ctx.fn_name = v
}

fn cg_set_str_cnt(ctx: mut ref CgCtx, v: i64) void = trust {
    ctx.str_cnt = v
}

fn cg_emit_label_if_new(ctx: mut ref CgCtx, label: ref u8) bool = trust {
    val elen: i64 = @len(ctx.emitted_labels as list[ref u8]) as i64
    val ei: mut i64 = 0
    for {
        if ei >= elen {
            break
        }
        val e_opt = @get(ctx.emitted_labels as list[ref u8], ei as usize)
        if e_opt is some e {
            if str.raw_cmp(e as ref u8, label) == 0 {
                return false
            }
        }
        ei++
    }
    @append(ctx.emitted_labels as list[ref u8], label)
    return true
}

fn cg_dvars(ctx: ref CgCtx) ref void = {
    return ctx.dvars as ref void
}

fn cg_snames(ctx: ref CgCtx) ref void = {
    return ctx.snames as ref void
}

fn cg_global_src_names(ctx: ref CgCtx) ref void = {
    return ctx.global_src_names as ref void
}

fn cg_global_labels(ctx: ref CgCtx) ref void = {
    return ctx.global_labels as ref void
}

fn cg_global_qtypes(ctx: ref CgCtx) ref void = {
    return ctx.global_qtypes as ref void
}

fn cg_global_anns(ctx: ref CgCtx) ref void = {
    return ctx.global_anns as ref void
}

fn cg_mark_prefix_used(ctx: mut ref CgCtx, prefix: ref u8) void = trust {
    val nlen: i64 = @len(ctx.used_prefixes as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.used_prefixes as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, prefix) == 0 {
                return
            }
        }
        ni++
    }
    @append(ctx.used_prefixes as list[ref u8], prefix)
}

fn cg_is_prefix_used(ctx: ref CgCtx, prefix: ref u8) bool = trust {
    val nlen: i64 = @len(ctx.used_prefixes as list[ref u8]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.used_prefixes as list[ref u8], ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, prefix) == 0 {
                return true
            }
        }
        ni++
    }
    return false
}

/// Returns true if the given when-clause selector matches the specified
/// platform (or the real host platform when src_target is "").
/// Supports platform names, architecture names, and platform.architecture.
pub fn platform_matches_with_target(name: ref u8, src_target: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(256 as usize)?
    val cur: mut ref u8 = reflection.current_platform_name[allocators.Arena](arena)
    if str.raw_cmp(src_target, c"") != 0 {
        cur = src_target
    }
    val matched: bool = module.when_selector_matches(cur, name)
    allocators.Arena.free(arena)
    return matched
}

/// Returns true if the given when-clause name matches the host platform (no override).
pub fn platform_matches(name: ref u8) bool = trust {
    return platform_matches_with_target(name, c"")
}

/// Returns true if the given when-clause name matches considering ctx.src_target.
fn cg_platform_matches(ctx: mut ref CgCtx, name: ref u8) bool = trust {
    return platform_matches_with_target(name, ctx.src_target)
}

/// Register a generic function node for later monomorphization.
fn register_generic_fn(
    ctx: mut ref CgCtx,
    name: ref u8,
    node: ref parser.Node,
    prefix: ref u8
) void = trust {
    @append(ctx.gfn_names, name)
    @append(ctx.gfn_nodes as list[ref void], node)
    @append(ctx.gfn_prefixes, prefix)
}

/// Look up a generic function node by base name.
///
/// Returns null if not found.
fn lookup_generic_fn(ctx: ref CgCtx, name: ref u8) ref parser.Node = trust {
    val nlen: i64 = @len(ctx.gfn_names) as i64
    val namelen: i64 = str.len_raw(name)
    val suffix: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (namelen + 3) as usize
    ) as ref u8
    @snprintf(suffix, namelen + 3, "__{s}", {name})
    val found_idx: mut i64 = -1
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.gfn_names, ni as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            if str.raw_cmp(candidate, name) == 0 {
                val nd_opt = @get(ctx.gfn_nodes as list[ref void], ni as usize)
                if nd_opt is some nd {
                    return nd as ref parser.Node
                } else {
                    return none
                }
            }
            val clen: i64 = str.len_raw(candidate)
            val slen: i64 = namelen + 2
            if clen > slen {
                val tail: ref u8 = @ptradd(candidate, clen - slen) as ref u8
                if str.raw_cmp(tail, suffix) == 0 {
                    found_idx = ni
                }
            }
        }
        ni++
    }
    if found_idx >= 0 {
        val nd_opt = @get(ctx.gfn_nodes as list[ref void], found_idx as usize)
        if nd_opt is some nd {
            return nd as ref parser.Node
        } else {
            return none
        }
    }
    return none
}

/// Look up a generic function's module prefix by base name.
fn lookup_generic_fn_prefix(ctx: ref CgCtx, name: ref u8) ref u8 = trust {
    val nlen: i64 = @len(ctx.gfn_names) as i64
    val namelen: i64 = str.len_raw(name)
    val suffix: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (namelen + 3) as usize
    ) as ref u8
    @snprintf(suffix, namelen + 3, "__{s}", {name})
    val found_idx: mut i64 = -1
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.gfn_names, ni as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            if str.raw_cmp(candidate, name) == 0 {
                val p_opt = @get(ctx.gfn_prefixes, ni as usize)
                if p_opt is some p {
                    return p as ref u8
                } else {
                    return c""
                }
            }
            val clen: i64 = str.len_raw(candidate)
            val slen: i64 = namelen + 2
            if clen > slen {
                val tail: ref u8 = @ptradd(candidate, clen - slen) as ref u8
                if str.raw_cmp(tail, suffix) == 0 {
                    found_idx = ni
                }
            }
        }
        ni++
    }
    if found_idx >= 0 {
        val p_opt = @get(ctx.gfn_prefixes, found_idx as usize)
        if p_opt is some p {
            return p as ref u8
        } else {
            return c""
        }
    }
    return c""
}

fn lookup_generic_fn_prefix_by_node(ctx: ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c""
    }
    val nlen: i64 = @len(ctx.gfn_nodes as list[ref void]) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val nd_opt = @get(ctx.gfn_nodes as list[ref void], ni as usize)
        if nd_opt is some nd {
            if nd as ref parser.Node == node {
                val p_opt = @get(ctx.gfn_prefixes, ni as usize)
                if p_opt is some p {
                    return p as ref u8
                } else {
                    return c""
                }
            }
        }
        ni++
    }
    return c""
}

fn generic_fn_qualified_name(
    ctx: ref CgCtx,
    node: ref parser.Node,
    mod_prefix: ref u8
) ref u8 = trust {
    val ns: ref u8 = parser.node_str_raw(node.d1)
    val name: ref u8 = parser.node_str_raw(node.d2)
    val base: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    if ns != none {
        @snprintf(base, 256, "{s}__{s}", {ns, name})
    } else {
        @snprintf(base, 256, "{s}", {name})
    }
    if str.raw_cmp(mod_prefix, c"") == 0 {
        return base
    }
    val is_std_child: bool = is_std_child_name(mod_prefix)
    val qualified: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if is_std_child {
        @snprintf(qualified, 512, "std__{s}__{s}", {mod_prefix, base})
    } else {
        @snprintf(qualified, 512, "{s}__{s}", {mod_prefix, base})
    }
    return qualified
}

/// Push a type substitution (type_param_name -> concrete type node).
fn gsubst_push(ctx: mut ref CgCtx, name: ref u8, ty: ref parser.Node) void = trust {
    @append(ctx.gsubst_names, name)
    @append(ctx.gsubst_tnodes as list[ref void], ty)
}

/// Resolve a type node through current generic substitutions.
fn gsubst_resolve(ctx: ref CgCtx, ty: ref parser.Node) ref parser.Node = trust {
    if ty == none {
        return ty
    }
    if ty.kind != parser.TY_NAMED {
        return ty
    }
    val name: ref u8 = parser.node_str_raw(ty.d0)
    val nlen: i64 = @len(ctx.gsubst_names) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.gsubst_names, ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                val t_opt = @get(ctx.gsubst_tnodes as list[ref void], ni as usize)
                if t_opt is some t {
                    return t as ref parser.Node
                } else {
                    return ty
                }
            }
        }
        ni++
    }
    return ty
}

/// Resolve a generic type parameter name to its concrete substituted type name.
fn gsubst_resolve_name(ctx: ref CgCtx, name: ref u8) ref u8 = trust {
    val nlen: i64 = @len(ctx.gsubst_names) as i64
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(ctx.gsubst_names, ni as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, name) == 0 {
                val t_opt = @get(ctx.gsubst_tnodes as list[ref void], ni as usize)
                if t_opt is some t {
                    val resolved: ref parser.Node = t as ref parser.Node
                    return type_node_to_mangled_ident(ctx, resolved)
                } else {
                    return c""
                }
            }
        }
        ni++
    }
    return c""
}

fn cg_clone_node(ctx: ref CgCtx, node: ref parser.Node) ref parser.Node = trust {
    if node == none {
        return none
    }
    val out: mut ref parser.Node = parser.make_node(ctx.arena, node.kind, node.line)
    out.d0 = node.d0
    out.d1 = node.d1
    out.d2 = node.d2
    out.d3 = node.d3
    out.d4 = node.d4
    out.d5 = node.d5
    out.d6 = node.d6
    return out
}

fn cg_clone_char_list(xs: list[ref u8]) list[ref u8] = trust {
    val out: mut list[ref u8] = mem.new[ref u8]()
    val len: i64 = @len(xs) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val x_opt = @get(xs, i as usize)
        if x_opt is some x {
            @append(out, x as ref u8)
        }
        i++
    }
    return out
}

fn cg_clone_void_list(xs: list[ref void]) list[ref void] = trust {
    val out: mut list[ref void] = mem.new[ref void]()
    val len: i64 = @len(xs) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val x_opt = @get(xs, i as usize)
        if x_opt is some x {
            @append(out, x as ref void)
        }
        i++
    }
    return out
}

fn cg_concrete_ty(ctx: mut ref CgCtx, ty: ref parser.Node) ref parser.Node = trust {
    if ty == none {
        return none
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        return gsubst_resolve(ctx, ty)
    }
    if k == parser.TY_MUT || k == parser.TY_REF || k == parser.TY_OPTION ||
    k == parser.TY_LIST || k == parser.TY_RESULT || k == parser.TY_SLICE {
        val inner: ref parser.Node = ty.d0 as ref parser.Node
        val resolved_inner: ref parser.Node = cg_concrete_ty(ctx, inner)
        if resolved_inner == inner {
            return ty
        }
        val out: mut ref parser.Node = cg_clone_node(ctx, ty)
        parser.node_store_slot[ref parser.Node](@addr(out.d0), resolved_inner)
        return out
    }
    if k == parser.TY_FIXED_ARR {
        val inner2: ref parser.Node = ty.d1 as ref parser.Node
        val resolved_inner2: ref parser.Node = cg_concrete_ty(ctx, inner2)
        if resolved_inner2 == inner2 {
            return ty
        }
        val out2: mut ref parser.Node = cg_clone_node(ctx, ty)
        parser.node_store_slot[ref parser.Node](@addr(out2.d1), resolved_inner2)
        return out2
    }
    if k == parser.TY_FNPTR {
        val params: ref void = ty.d0 as ref void
        val ret: ref parser.Node = ty.d1 as ref parser.Node
        val resolved_ret: ref parser.Node = cg_concrete_ty(ctx, ret)
        val resolved_params: mut list[ref parser.Node] = mem.new[ref parser.Node]()
        val changed: mut bool = resolved_ret != ret
        if params != none {
            for p in params as list[ref parser.Node] {
                val rp: ref parser.Node = cg_concrete_ty(ctx, p)
                if rp != p {
                    changed = true
                }
                @append(resolved_params, rp)
            }
        }
        if !changed {
            return ty
        }
        val out3: mut ref parser.Node = cg_clone_node(ctx, ty)
        parser.node_store_slot[list[ref parser.Node]](@addr(out3.d0), resolved_params)
        parser.node_store_slot[ref parser.Node](@addr(out3.d1), resolved_ret)
        return out3
    }
    return ty
}

/// Extract the list element type node from a type. Unwraps mut wrappers.
fn cg_unwrap_list_elem_ty(ctx: mut ref CgCtx, ty: ref parser.Node) ref parser.Node = trust {
    if ty == none {
        return none
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    val k: i64 = resolved.kind
    if k == parser.TY_LIST {
        return resolved.d0 as ref parser.Node
    }
    if k == parser.TY_MUT {
        return cg_unwrap_list_elem_ty(ctx, resolved.d0 as ref parser.Node)
    }
    return none
}

fn cg_struct_fields_for_type(ctx: mut ref CgCtx, ty: ref parser.Node) ref void = trust {
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return none
    }
    val k: i64 = resolved.kind
    if k == parser.TY_MUT || k == parser.TY_REF {
        return cg_struct_fields_for_type(ctx, resolved.d0 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        return cg_lookup_struct(ctx, parser.node_str_raw(resolved.d0))
    }
    return none
}

fn cg_rewrite_empty_struct_init(ctx: mut ref CgCtx, expr: ref parser.Node) bool = trust {
    if expr == none || expr.kind != parser.NK_ARGS_PACK {
        return false
    }
    val pack: ref void = expr.d0 as ref void
    if pack != none && @len(pack as list[ref parser.Node]) as i64 != 0 {
        return false
    }
    val expected_ty: ref parser.Node = ctx.expected_ty as ref parser.Node
    val struct_fields: ref void = cg_struct_fields_for_type(ctx, expected_ty)
    if struct_fields == none || @len(struct_fields as list[ref void]) as i64 != 0 {
        return false
    }
    val lit_expr: mut ref parser.Node = expr
    lit_expr.kind = parser.NK_STRUCT_LIT
    return true
}

fn cg_union_payload_size(ctx: mut ref CgCtx, variants: ref void) i64 = trust {
    if variants == none {
        return 8
    }
    val vlen: i64 = @len(variants as list[ref parser.Node]) as i64
    val max_payload: mut i64 = 8
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants as list[ref parser.Node], vi as usize)
        if v_opt is some v {
            val vnode: ref parser.Node = v as ref parser.Node
            val fields: ref void = vnode.d1 as ref void
            val psize: mut i64 = 0
            if fields != none {
                val flen: i64 = @len(fields as list[ref parser.Node]) as i64
                val fi: mut i64 = 0
                for {
                    if fi >= flen {
                        break
                    }
                    val f_opt = @get(fields as list[ref parser.Node], fi as usize)
                    if f_opt is some f {
                        val fsize: i64 = cg_alloc_size_for_type(ctx, f as ref parser.Node)
                        if fsize <= 0 {
                            psize = psize + 8
                        } else {
                            psize = psize + align_to(fsize, 8)
                        }
                    } else {
                        psize = psize + 8
                    }
                    fi++
                }
            }
            if psize > max_payload {
                max_payload = psize
            }
        }
        vi++
    }
    return max_payload
}

fn cg_union_size(ctx: mut ref CgCtx, variants: ref void) i64 = trust {
    return 8 + cg_union_payload_size(ctx, variants)
}

fn cg_alloc_size_for_type(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return 0
    }
    val k: i64 = resolved.kind
    if k == parser.TY_MUT {
        return cg_alloc_size_for_type(ctx, resolved.d0 as ref parser.Node)
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(resolved.d0)
        val union_vars: ref void = cg_lookup_union_suffix(ctx, tname)
        if union_vars != none {
            return cg_union_size(ctx, union_vars)
        }
        val struct_fields: ref void = cg_lookup_struct(ctx, tname)
        if struct_fields != none {
            return struct_size(ctx, struct_fields)
        }
    }
    return type_size(resolved)
}

fn cg_ann_payload_size(ctx: mut ref CgCtx, ann: ref u8, depth: i64) i64 = trust {
    if ann == none || str.raw_cmp(ann, c"") == 0 || depth > 64 {
        return 8
    }
    if raw_starts_with(ann, c"option[") {
        val inner: ref u8 = parse_option_inner(ann)
        val sz: i64 = cg_ann_payload_size(ctx, inner, depth + 1)
        val aligned: i64 = align_to(sz, 8)
        if aligned < 8 {
            return 16
        }
        return 8 + aligned
    }
    if raw_starts_with(ann, c"result[") {
        val ok_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        val err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        parse_result_types(ann, ok_buf, err_buf)
        val ok_sz: i64 = cg_ann_payload_size(ctx, ok_buf, depth + 1)
        val err_sz: i64 = cg_ann_payload_size(ctx, err_buf, depth + 1)
        val mx: mut i64 = ok_sz
        if err_sz > mx {
            mx = err_sz
        }
        val aligned: i64 = align_to(mx, 8)
        if aligned < 8 {
            return 16
        }
        return 8 + aligned
    }
    if raw_starts_with(ann, c"ref ") || raw_starts_with(ann, c"mut ref ")
    || raw_starts_with(
        ann,
        c"list["
    ) || raw_starts_with(ann, c"slice[") || raw_starts_with(ann, c"mut ") {
        return 8
    }
    return cg_ann_size(ctx, ann)
}

fn cg_payload_storage_size(ctx: mut ref CgCtx, ty: ref parser.Node, depth: i64) i64 = trust {
    if ty == none || depth > 64 {
        return 8
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return 8
    }
    val k: i64 = resolved.kind
    if k == parser.TY_VOID {
        return 0
    }
    if k == parser.TY_MUT {
        return cg_payload_storage_size(ctx, resolved.d0 as ref parser.Node, depth + 1)
    }
    if k == parser.TY_OPTION {
        return cg_option_layout_size(ctx, resolved, depth + 1)
    }
    if k == parser.TY_RESULT {
        return cg_result_layout_size(ctx, resolved, depth + 1)
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(resolved.d0)
        if raw_starts_with(tname, c"option[") || raw_starts_with(tname, c"result[") {
            return cg_ann_payload_size(ctx, tname, depth + 1)
        }
        if cg_lookup_struct(ctx, tname) != none {
            return 8
        }
        if cg_lookup_union_suffix(ctx, tname) != none {
            return 8
        }
        return cg_alloc_size_for_type(ctx, resolved)
    }
    if k == parser.TY_FIXED_ARR {
        val count: i64 = parser.fixed_arr_size(resolved)
        val inner: i64 = cg_payload_storage_size(ctx, resolved.d1 as ref parser.Node, depth + 1)
        return count * inner
    }
    if k == parser.TY_LIST || k == parser.TY_REF || k == parser.TY_SLICE || k == parser.TY_FNPTR {
        return 8
    }
    return type_size(resolved)
}

fn cg_option_payload_size(ctx: mut ref CgCtx, ty: ref parser.Node, depth: i64) i64 = trust {
    val inner: ref parser.Node = ty.d0 as ref parser.Node
    val sz: i64 = cg_payload_storage_size(ctx, inner, depth + 1)
    val aligned: i64 = align_to(sz, 8)
    if aligned < 8 {
        return 8
    }
    return aligned
}

fn cg_option_layout_size(ctx: mut ref CgCtx, ty: ref parser.Node, depth: i64) i64 = trust {
    return 8 + cg_option_payload_size(ctx, ty, depth)
}

fn cg_result_payload_size(ctx: mut ref CgCtx, ty: ref parser.Node, depth: i64) i64 = trust {
    val ok_sz: i64 = cg_payload_storage_size(ctx, ty.d0 as ref parser.Node, depth + 1)
    val err_sz: i64 = cg_payload_storage_size(ctx, ty.d1 as ref parser.Node, depth + 1)
    val mx: mut i64 = ok_sz
    if err_sz > mx {
        mx = err_sz
    }
    val aligned: i64 = align_to(mx, 8)
    if aligned < 8 {
        return 8
    }
    return aligned
}

fn cg_result_layout_size(ctx: mut ref CgCtx, ty: ref parser.Node, depth: i64) i64 = trust {
    return 8 + cg_result_payload_size(ctx, ty, depth)
}

fn cg_wrap_payload_is_aggregate(ctx: mut ref CgCtx, ty: ref parser.Node) bool = trust {
    if ty == none {
        return false
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return false
    }
    if resolved.kind == parser.TY_OPTION || resolved.kind == parser.TY_RESULT {
        return true
    }
    if resolved.kind == parser.TY_FIXED_ARR {
        return true
    }
    if resolved.kind == parser.TY_NAMED {
        val n: ref u8 = parser.node_str_raw(resolved.d0)
        if raw_starts_with(n, c"option[") || raw_starts_with(n, c"result[") {
            return true
        }
        return false
    }
    return false
}

fn cg_wrap_layout_size(ctx: mut ref CgCtx, ty: ref parser.Node) i64 = trust {
    if ty == none {
        return 8
    }
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return 8
    }
    if resolved.kind == parser.TY_OPTION {
        return cg_option_layout_size(ctx, resolved, 0)
    }
    if resolved.kind == parser.TY_RESULT {
        return cg_result_layout_size(ctx, resolved, 0)
    }
    return cg_payload_storage_size(ctx, resolved, 0)
}

fn cg_emit_store_typed(
    ctx: mut ref CgCtx,
    base: ref u8,
    offset: i64,
    value: ref u8,
    ty: ref parser.Node
) void = trust {
    val sz: i64 = cg_payload_storage_size(ctx, ty, 0)
    val aggregate: bool = cg_wrap_payload_is_aggregate(ctx, ty)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if aggregate {
        val off_tmp: i64 = fresh_tmp(ctx)
        @snprintf(buf, 512, "    %%t{lld} =l add {s}, {lld}\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
            {off_tmp, base, offset, off_tmp, value, sz})
        emit(ctx, buf)
        return
    }
    val qt: ref u8 = qbe_type_of(ty)
    val op: mut ref u8 = c"storel"
    if str.raw_cmp(qt, c"w") == 0 {
        op = c"storew"
    } elif str.raw_cmp(qt, c"s") == 0 {
        op = c"stores"
    } elif str.raw_cmp(qt, c"d") == 0 {
        op = c"stored"
    }
    if offset == 0 {
        @snprintf(buf, 512, "    {s} {s}, {s}\n", {op, value, base})
    } else {
        val off_tmp2: i64 = fresh_tmp(ctx)
        @snprintf(buf, 512, "    %%t{lld} =l add {s}, {lld}\n    {s} {s}, %%t{lld}\n",
            {off_tmp2, base, offset, op, value, off_tmp2})
    }
    emit(ctx, buf)
}

fn cg_emit_bind_typed(
    ctx: mut ref CgCtx,
    base: ref u8,
    offset: i64,
    bind: ref u8,
    ty: ref parser.Node
) void = trust {
    val ann: ref u8 = type_expr_to_annotation(ctx, ty)
    if cg_wrap_payload_is_aggregate(ctx, ty) {
        val sz: i64 = cg_payload_storage_size(ctx, ty, 0)
        val dst: i64 = fresh_tmp(ctx)
        val off_tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "    %%t{lld} =l alloc8 {lld}\n    %%t{lld} =l add {s}, {lld}\n    call $memcpy(l %%t{lld}, l %%t{lld}, l {lld})\n",
            {dst, sz, off_tmp, base, offset, dst, off_tmp, sz})
        emit(ctx, buf)
        val tmp_str: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(tmp_str, 32, "%%t{lld}", {dst})
        cg_register_local_var(ctx, bind, tmp_str)
        if str.raw_cmp(ann, c"") != 0 {
            cg_register_local_type(ctx, bind, ann)
        }
        if raw_starts_with(
            ann,
            c"ref "
        ) || raw_starts_with(ann, c"mut ref ") || cg_ann_is_indirect_value(ctx, ann) {
            cg_register_local_ref_type(ctx, bind)
        }
        return
    }
    val qt: ref u8 = qbe_type_of(ty)
    val load_op: mut ref u8 = c"loadl"
    if str.raw_cmp(qt, c"w") == 0 {
        load_op = c"loadw"
    } elif str.raw_cmp(qt, c"s") == 0 {
        load_op = c"loads"
    } elif str.raw_cmp(qt, c"d") == 0 {
        load_op = c"loadd"
    }
    val val_tmp: i64 = fresh_tmp(ctx)
    val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if offset == 0 {
        @snprintf(buf2, 512, "    %%t{lld} ={s} {s} {s}\n", {val_tmp, qt, load_op, base})
    } else {
        val off_tmp2: i64 = fresh_tmp(ctx)
        @snprintf(buf2, 512, "    %%t{lld} =l add {s}, {lld}\n    %%t{lld} ={s} {s} %%t{lld}\n",
            {off_tmp2, base, offset, val_tmp, qt, load_op, off_tmp2})
    }
    emit(ctx, buf2)
    val tmp_str2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(tmp_str2, 32, "%%t{lld}", {val_tmp})
    cg_register_local_var(ctx, bind, tmp_str2)
    if str.raw_cmp(ann, c"") != 0 {
        cg_register_local_type(ctx, bind, ann)
    }
}

fn cg_emit_load_typed(
    ctx: mut ref CgCtx,
    base: ref u8,
    offset: i64,
    ty: ref parser.Node
) ref u8 = trust {
    if cg_wrap_payload_is_aggregate(ctx, ty) {
        val sz: i64 = cg_payload_storage_size(ctx, ty, 0)
        val dst: i64 = fresh_tmp(ctx)
        val off_tmp: i64 = fresh_tmp(ctx)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "    %%t{lld} =l alloc8 {lld}\n    %%t{lld} =l add {s}, {lld}\n    call $memcpy(l %%t{lld}, l %%t{lld}, l {lld})\n",
            {dst, sz, off_tmp, base, offset, dst, off_tmp, sz})
        emit(ctx, buf)
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(res, 32, "%%t{lld}", {dst})
        return res
    }
    val qt: ref u8 = qbe_type_of(ty)
    val load_op: mut ref u8 = c"loadl"
    if str.raw_cmp(qt, c"w") == 0 {
        load_op = c"loadw"
    } elif str.raw_cmp(qt, c"s") == 0 {
        load_op = c"loads"
    } elif str.raw_cmp(qt, c"d") == 0 {
        load_op = c"loadd"
    }
    val val_tmp: i64 = fresh_tmp(ctx)
    val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if offset == 0 {
        @snprintf(buf2, 512, "    %%t{lld} ={s} {s} {s}\n", {val_tmp, qt, load_op, base})
    } else {
        val off_tmp2: i64 = fresh_tmp(ctx)
        @snprintf(buf2, 512, "    %%t{lld} =l add {s}, {lld}\n    %%t{lld} ={s} {s} %%t{lld}\n",
            {off_tmp2, base, offset, val_tmp, qt, load_op, off_tmp2})
    }
    emit(ctx, buf2)
    val res2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(res2, 32, "%%t{lld}", {val_tmp})
    return res2
}

fn cg_expr_is_zero_init_like(expr: ref parser.Node) bool = trust {
    if expr == none {
        return false
    }
    if expr.kind == parser.NK_ZERO_INIT {
        return true
    }
    if expr.kind == parser.NK_INT_LIT {
        return str.raw_cmp(parser.int_lit_text_raw(expr), c"0") == 0
    }
    if expr.kind == parser.NK_CAST {
        val inner: ref parser.Node = expr.d0 as ref parser.Node
        if inner != none && inner.kind == parser.NK_INT_LIT {
            return str.raw_cmp(parser.int_lit_text_raw(inner), c"0") == 0
        }
    }
    return false
}

fn cg_type_needs_aggregate_copy(ctx: mut ref CgCtx, ty: ref parser.Node) bool = trust {
    val resolved: ref parser.Node = cg_concrete_ty(ctx, ty)
    if resolved == none {
        return false
    }
    val k: i64 = resolved.kind
    if k == parser.TY_MUT {
        return cg_type_needs_aggregate_copy(ctx, resolved.d0 as ref parser.Node)
    }
    if k == parser.TY_RESULT || k == parser.TY_SLICE || k == parser.TY_FIXED_ARR {
        return true
    }
    if k == parser.TY_NAMED {
        val tname: ref u8 = parser.node_str_raw(resolved.d0)
        if cg_lookup_struct(ctx, tname) != none {
            return true
        }
        if cg_lookup_union_suffix(ctx, tname) != none {
            return true
        }
    }
    return false
}

fn cg_alloc_aggregate_temp(ctx: mut ref CgCtx, tmp: i64, size: i64) void = trust {
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    if ctx.aggregate_heap > 0 {
        @snprintf(buf, 128, "    %%t{lld} =l call $malloc(l {lld})\n", {tmp, size})
    } else {
        @snprintf(buf, 128, "    %%t{lld} =l alloc8 {lld}\n", {tmp, size})
        val val_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            32 as usize
        ) as ref u8
        @snprintf(val_buf, 32, "%%t{lld}", {tmp})
        @append(ctx.stack_agg_values, val_buf)
    }
    emit(ctx, buf)
}

fn cg_is_stack_aggregate(ctx: ref CgCtx, value: ref u8) bool = trust {
    for item in ctx.stack_agg_values {
        if str.raw_cmp(item as ref u8, value) == 0 {
            return true
        }
    }
    return false
}

/// Copy a stack-owned aggregate value into a stable heap allocation when it
/// escapes the current expression or function.
fn cg_materialize_stack_aggregate(
    ctx: mut ref CgCtx,
    value: ref u8,
    ty: ref parser.Node
) ref u8 = trust {
    if !cg_is_stack_aggregate(ctx, value) {
        return value
    }
    val size: i64 = cg_alloc_size_for_type(ctx, ty)
    if size <= 0 {
        return value
    }
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(
        buf,
        256,
        "    %%t{lld} =l call $malloc(l {lld})\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
        {tmp, size, tmp, value, size}
    )
    emit(ctx, buf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn cg_materialize_stack_aggregate_ann(
    ctx: mut ref CgCtx,
    value: ref u8,
    ann: ref u8
) ref u8 = trust {
    if !cg_is_stack_aggregate(ctx, value) {
        return value
    }
    val size: mut i64 = 0
    if raw_starts_with(ann, c"[") {
        size = cg_ann_size(ctx, ann)
    } else {
        val ty: ref parser.Node = cg_named_ty_from_ann(ctx, ann)
        if ty != none {
            size = cg_alloc_size_for_type(ctx, ty)
        }
    }
    if size <= 0 {
        return value
    }
    val tmp: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(
        buf,
        256,
        "    %%t{lld} =l call $malloc(l {lld})\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
        {tmp, size, tmp, value, size}
    )
    emit(ctx, buf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn cg_literal_matches_struct_fields(
    ctx: mut ref CgCtx,
    lit_fields: ref void,
    struct_fields: ref void
) bool = trust {
    if lit_fields == none || struct_fields == none {
        return false
    }
    val lflen: i64 = @len(lit_fields as list[ref void]) as i64
    val li: mut i64 = 0
    for {
        if li >= lflen {
            break
        }
        val lf_opt = @get(lit_fields as list[ref void], li as usize)
        if lf_opt is some lf {
            val lf_name: ref u8 = parser.node_str_raw((lf as ref parser.Node).d0)
            if field_offset(ctx, struct_fields, lf_name) < 0 {
                return false
            }
        }
        li++
    }
    return true
}

fn cg_literal_exact_struct_match(
    ctx: mut ref CgCtx,
    lit_fields: ref void,
    struct_fields: ref void
) bool = trust {
    if lit_fields == none || struct_fields == none {
        return false
    }
    if @len(lit_fields as list[ref void]) as i64 != @len(struct_fields as list[ref void]) as i64 {
        return false
    }
    return cg_literal_matches_struct_fields(ctx, lit_fields, struct_fields)
}

fn cg_find_struct_fields_for_literal(ctx: mut ref CgCtx, lit_fields: ref void) ref void = trust {
    if lit_fields == none {
        return none
    }
    val sfields_list: list[ref void] = cg_sfields(ctx)
    val slen: i64 = @len(sfields_list as list[ref void]) as i64
    val match_fields: mut ref void = none
    val matches: mut i64 = 0
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val sf_opt = @get(sfields_list as list[ref void], si as usize)
        if sf_opt is some sf {
            val sfields: ref void = sf as ref void
            if cg_literal_exact_struct_match(ctx, lit_fields, sfields) {
                match_fields = sfields
                matches++
                if matches > 1 {
                    break
                }
            }
        }
        si++
    }
    if matches == 1 {
        return match_fields
    }

    match_fields = none
    matches = 0
    si = 0
    for {
        if si >= slen {
            break
        }
        val sf_opt = @get(sfields_list as list[ref void], si as usize)
        if sf_opt is some sf {
            val sfields: ref void = sf as ref void
            if cg_literal_matches_struct_fields(ctx, lit_fields, sfields) {
                match_fields = sfields
                matches++
                if matches > 1 {
                    return none
                }
            }
        }
        si++
    }
    if matches == 1 {
        return match_fields
    }
    return none
}

/// Serialize a type node to a canonical string for constraint matching.
fn type_node_to_str(ctx: ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"void"
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        return parser.node_str_raw(ty.d0)
    }
    if k == parser.TY_REF {
        val inner: ref u8 = type_node_to_str(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "ref {s}", {inner})
        return buf
    }
    if k == parser.TY_MUT {
        val inner: ref u8 = type_node_to_str(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "mut {s}", {inner})
        return buf
    }
    if k == parser.TY_VOID {
        return c"void"
    }
    return c"unknown"
}

/// Serialize a type node to a mangled identifier string for function naming.
fn sanitize_mangle_atom(ctx: ref CgCtx, name: ref u8) ref u8 = trust {
    val nlen: i64 = str.len_raw(name)
    val out: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (nlen * 2 + 1) as usize
    ) as ref u8
    val si: mut i64 = 0
    val oi: mut i64 = 0
    for {
        if si >= nlen {
            break
        }
        val ch: u8 = @load8(@ptradd(name, si))
        if ch == 46 {
            @store8(@ptradd(out, oi), 95)
            @store8(@ptradd(out, oi + 1), 95)
            oi += 2
        } else {
            @store8(@ptradd(out, oi), ch)
            oi++
        }
        si++
    }
    @store8(@ptradd(out, oi), 0)
    return out
}

fn type_node_to_mangle(ctx: ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c"void"
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        return sanitize_mangle_atom(ctx, parser.node_str_raw(ty.d0))
    }
    if k == parser.TY_REF {
        val inner: ref u8 = type_node_to_mangle(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "ref_{s}", {inner})
        return buf
    }
    if k == parser.TY_MUT {
        val inner: ref u8 = type_node_to_mangle(ctx, ty.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(buf, 256, "mut_{s}", {inner})
        return buf
    }
    if k == parser.TY_VOID {
        return c"void"
    }
    return c"unknown"
}

fn type_node_to_mangled_ident(ctx: ref CgCtx, ty: ref parser.Node) ref u8 = trust {
    if ty == none {
        return c""
    }
    val k: i64 = ty.kind
    if k == parser.TY_NAMED {
        return sanitize_mangle_atom(ctx, parser.node_str_raw(ty.d0))
    }
    if k == parser.TY_REF || k == parser.TY_MUT {
        return type_node_to_mangled_ident(ctx, ty.d0 as ref parser.Node)
    }
    if k == parser.TY_VOID {
        return c"void"
    }
    return type_node_to_mangle(ctx, ty)
}

/// Check whether a NK_GENERIC_WHEN node's conditions match current substitutions.
fn gwhen_matches_gsubst(ctx: mut ref CgCtx, when_node: ref parser.Node) bool = trust {
    val conds: ref void = when_node.d0 as ref void
    if conds == none {
        return true
    }
    val clen: i64 = @len(conds as list[ref parser.Node]) as i64
    val ci: mut i64 = 0
    for {
        if ci >= clen {
            break
        }
        val c_opt = @get(conds as list[ref parser.Node], ci as usize)
        if c_opt is some c {
            val cond: ref parser.Node = c as ref parser.Node
            val ckind: i64 = cond.d1
            if ckind == 0 {
                ci++
                continue
            }
            val tparam: ref u8 = parser.node_str_raw(cond.d0)
            val dummy: mut ref parser.Node = parser.make_node(ctx.arena, parser.TY_NAMED, 0)
            parser.node_store_string_slot(@addr(dummy.d0), tparam)
            val resolved: ref parser.Node = gsubst_resolve(ctx, dummy)
            if resolved == dummy {
                ci++
                continue
            }
            val concrete_str: ref u8 = type_node_to_str(ctx, resolved)
            val ctypes: ref void = cond.d2 as ref void
            if ckind == 1 {
                val matched: mut bool = false
                if ctypes != none {
                    val tlen: i64 = @len(ctypes as list[ref parser.Node]) as i64
                    val ti: mut i64 = 0
                    for {
                        if ti >= tlen {
                            break
                        }
                        val t_opt = @get(ctypes as list[ref parser.Node], ti as usize)
                        if t_opt is some t {
                            val resolved_t: ref parser.Node = gsubst_resolve(
                                ctx,
                                t as ref parser.Node
                            )
                            val ts: ref u8 = type_node_to_str(ctx, resolved_t)
                            if str.raw_cmp(concrete_str, ts) == 0 {
                                matched = true
                            }
                        }
                        ti++
                    }
                }
                if !matched {
                    return false
                }
            } elif ckind == 2 {
                val matched2: mut bool = false
                if ctypes != none {
                    val t_opt = @get(ctypes as list[ref parser.Node], 0)
                    if t_opt is some t {
                        val resolved_t2: ref parser.Node = gsubst_resolve(ctx, t as ref parser.Node)
                        val ts: ref u8 = type_node_to_str(ctx, resolved_t2)
                        if str.raw_cmp(concrete_str, ts) == 0 {
                            matched2 = true
                        }
                    }
                }
                if !matched2 {
                    return false
                }
            } elif ckind == 3 {
                val matched3: mut bool = false
                if ctypes != none {
                    val tlen3: i64 = @len(ctypes as list[ref parser.Node]) as i64
                    val ti3: mut i64 = 0
                    for {
                        if ti3 >= tlen3 {
                            break
                        }
                        val t_opt3 = @get(ctypes as list[ref parser.Node], ti3 as usize)
                        if t_opt3 is some t3 {
                            val resolved_t3: ref parser.Node = gsubst_resolve(
                                ctx,
                                t3 as ref parser.Node
                            )
                            val ts3: ref u8 = type_node_to_str(ctx, resolved_t3)
                            if str.raw_cmp(concrete_str, ts3) == 0 {
                                matched3 = true
                            }
                        }
                        ti3++
                    }
                }
                if matched3 {
                    return false
                }
            }
        }
        ci++
    }
    return true
}

/// Find the first matching NK_GENERIC_WHEN branch body in a function body, given current substitutions.
/// Returns the body stmts (as ref parser.Node = list) or null if none found.
fn find_matching_gwhen_body(ctx: mut ref CgCtx, fn_body: ref parser.Node) ref parser.Node = trust {
    if fn_body == none {
        return none
    }
    val blen: i64 = @len(fn_body) as i64
    val bi: mut i64 = 0
    for {
        if bi >= blen {
            break
        }
        val s_opt = @get(fn_body, bi as usize)
        if s_opt is some s {
            val sn: ref parser.Node = s as ref parser.Node
            if sn.kind == parser.NK_GENERIC_WHEN {
                if gwhen_matches_gsubst(ctx, sn) {
                    return sn.d1 as ref parser.Node
                }
            }
        }
        bi++
    }
    return none
}

/// Substitute TY_NAMED type params in a param node's type, returning new param node.
fn make_concrete_param(ctx: mut ref CgCtx, param: ref parser.Node) ref parser.Node = trust {
    val pname: ref u8 = parser.node_str_raw(param.d0)
    val pty: ref parser.Node = param.d1 as ref parser.Node
    val resolved: ref parser.Node = cg_concrete_ty(ctx, pty)
    val np: mut ref parser.Node = parser.make_node(ctx.arena, parser.NK_VAL, param.line)
    parser.node_store_string_slot(@addr(np.d0), pname)
    parser.node_store_slot[ref parser.Node](@addr(np.d1), resolved)
    return np
}

/// Monomorphize a generic function and emit it. Returns the base mangled name (without sx__ prefix).
fn monomorphize_generic_fn(ctx: mut ref CgCtx, gfn_node: ref parser.Node, gfn_prefix: ref u8,
    type_args: list[ref parser.Node]) ref u8 = trust {
    val fn_name: ref u8 = generic_fn_qualified_name(ctx, gfn_node, gfn_prefix)
    val tparams: ref void = gfn_node.d6 as ref void
    val suffix: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    val spos: mut i64 = 0
    val nargs: i64 = @len(type_args) as i64
    val ai: mut i64 = 0
    for {
        if ai >= nargs {
            break
        }
        val ta_opt = @get(type_args, ai as usize)
        if ta_opt is some ta {
            val mangle: ref u8 = type_node_to_mangle(ctx, ta as ref parser.Node)
            val sep: ref u8 = c"__"
            val seplen: i64 = 2
            val mlen: i64 = str.len_raw(mangle)
            @memcpy(@ptradd(suffix, spos), sep, seplen as usize)
            spos = spos + seplen
            @memcpy(@ptradd(suffix, spos), mangle, mlen as usize)
            spos = spos + mlen
        }
        ai++
    }
    @store8(@ptradd(suffix, spos), 0)

    val mono_base: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(
        mono_base,
        1024,
        "{s}__GENMONO{s}",
        {fn_name, suffix}
    )
    val old_gsubst_names: mut list[ref u8] = mem.new[ref u8]()
    for n in ctx.gsubst_names {
        @append(old_gsubst_names, n)
    }
    val old_gsubst_tnodes: mut list[ref void] = mem.new[ref void]()
    for t in ctx.gsubst_tnodes {
        @append(old_gsubst_tnodes, t)
    }
    ctx.gsubst_names = mem.new[ref u8]()
    ctx.gsubst_tnodes = mem.new[ref void]()

    if tparams != none {
        val nparms: i64 = @len(tparams as list[ref parser.Node]) as i64
        val pi: mut i64 = 0
        for {
            if pi >= nparms {
                break
            }
            val pn_opt = @get(tparams as list[ref parser.Node], pi as usize)
            val ta_opt = @get(type_args, pi as usize)
            if pn_opt is some pn {
                if ta_opt is some ta {
                    gsubst_push(
                        ctx,
                        parser.tparam_name_raw(pn as ref parser.Node),
                        ta as ref parser.Node
                    )
                }
            }
            pi++
        }
    }

    val orig_params: ref void = gfn_node.d3 as ref void
    val new_params: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    if orig_params != none {
        for param in orig_params as list[ref parser.Node] {
            @append(new_params, make_concrete_param(ctx, param))
        }
    }

    val orig_ret: ref parser.Node = gfn_node.d4 as ref parser.Node
    val new_ret: ref parser.Node = gsubst_resolve(ctx, orig_ret)
    val fn_body: ref parser.Node = gfn_node.d5 as ref parser.Node
    val branch_body: ref parser.Node = find_matching_gwhen_body(ctx, fn_body)
    val final_body: mut ref parser.Node = branch_body
    if final_body == none {
        final_body = fn_body
    }

    if final_body != none {
        val syn: mut ref parser.Node = parser.make_node(ctx.arena, parser.NK_FN, gfn_node.line)
        syn.d0 = 0
        syn.d1 = 0 as i64
        parser.node_store_string_slot(@addr(syn.d2), mono_base)
        val pl: list[ref parser.Node] = new_params
        parser.node_store_slot[list[ref parser.Node]](@addr(syn.d3), pl)
        parser.node_store_slot[ref parser.Node](@addr(syn.d4), new_ret)
        parser.node_store_slot[ref parser.Node](@addr(syn.d5), final_body)
        syn.d6 = 0
        if parser.fn_is_unsafe(gfn_node) {
            syn.d6 = syn.d6 | parser.FN_FLAG_UNSAFE
        }
        if parser.fn_is_inline(gfn_node) {
            syn.d6 = syn.d6 | parser.FN_FLAG_INLINE
        }
        if parser.fn_suppresses_unused(gfn_node) {
            syn.d6 = syn.d6 | parser.FN_FLAG_SUPPRESS_UNUSED
        }

        val saved_sb = ctx.sb
        val saved_tmp = ctx.tmp
        val saved_lbl = ctx.lbl
        val saved_fn_name = ctx.fn_name
        val saved_ret_qtype = ctx.current_fn_ret_qtype
        val saved_ret_union = ctx.current_fn_ret_union
        val saved_ret_ty = ctx.current_fn_ret_ty
        val saved_ret_unboxed = ctx.current_fn_ret_unboxed
        val saved_ret_layout_size = ctx.current_fn_ret_layout_size
        val saved_expected_ty = ctx.expected_ty
        val saved_local_src_names = cg_clone_char_list(ctx.local_src_names)
        val saved_local_qbe_names = cg_clone_char_list(ctx.local_qbe_names)
        val saved_local_slot_names = cg_clone_char_list(ctx.local_slot_names)
        val saved_local_ref_types = cg_clone_char_list(ctx.local_ref_types)
        val saved_lnames = cg_clone_char_list(ctx.lnames)
        val saved_ltypes = cg_clone_char_list(ctx.ltypes)
        val saved_dvars = cg_clone_char_list(ctx.dvars)
        val saved_dqtypes = cg_clone_char_list(ctx.dqtypes)
        val saved_defer_stack = cg_clone_void_list(ctx.defer_stack)
        val saved_module_prefix = ctx.current_module_prefix
        val saved_stack_agg_values = cg_clone_char_list(ctx.stack_agg_values)
        val saved_aggregate_heap = ctx.aggregate_heap

        val temp_mono_sb: ref void = str.StringBuilder.new()
        ctx.sb = temp_mono_sb
        ctx.current_module_prefix = gfn_prefix
        gen_fn_prefixed(ctx, syn, c"")

        ctx.sb = saved_sb
        ctx.tmp = saved_tmp
        ctx.lbl = saved_lbl
        ctx.fn_name = saved_fn_name
        ctx.current_fn_ret_qtype = saved_ret_qtype
        ctx.current_fn_ret_union = saved_ret_union
        ctx.current_fn_ret_ty = saved_ret_ty
        ctx.current_fn_ret_unboxed = saved_ret_unboxed
        ctx.current_fn_ret_layout_size = saved_ret_layout_size
        ctx.expected_ty = saved_expected_ty
        ctx.local_src_names = saved_local_src_names
        ctx.local_qbe_names = saved_local_qbe_names
        ctx.local_slot_names = saved_local_slot_names
        ctx.local_ref_types = saved_local_ref_types
        ctx.lnames = saved_lnames
        ctx.ltypes = saved_ltypes
        ctx.dvars = saved_dvars
        ctx.dqtypes = saved_dqtypes
        ctx.defer_stack = saved_defer_stack
        ctx.current_module_prefix = saved_module_prefix
        ctx.stack_agg_values = saved_stack_agg_values
        ctx.aggregate_heap = saved_aggregate_heap
        val temp_built: ref void = str.StringBuilder.build(temp_mono_sb)
        str.StringBuilder.append_cstr(ctx.mono_sb, str.cstr(temp_built))
        str.StringBuilder.free(temp_mono_sb)
        @free(@load(temp_built))
        @free(temp_built)
    }

    ctx.gsubst_names = old_gsubst_names
    ctx.gsubst_tnodes = old_gsubst_tnodes

    return mono_base
}

/// Preserve the full qualified callee path for generic function lookup.
fn generic_callee_base_name(ctx: mut ref CgCtx, node: ref parser.Node) ref u8 = trust {
    return resolve_callee_name(ctx, node)
}

fn cg_is_c_escape_expr(node: ref parser.Node) bool = trust {
    if node == none || node.kind != parser.NK_FIELD {
        return false
    }
    val cur: mut ref parser.Node = node
    for {
        if cur == none {
            return false
        }
        if cur.kind == parser.NK_IDENT {
            return str.raw_cmp(parser.node_str_raw(cur.d0), c"C") == 0
        }
        if cur.kind != parser.NK_FIELD {
            return false
        }
        cur = parser.field_base(cur)
    }
    return false
}

fn cg_raw_c_name(ctx: ref CgCtx, node: ref parser.Node) ref u8 = trust {
    if node == none {
        return c""
    }
    if node.kind == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(node.d0)
        if str.raw_cmp(name, c"C") == 0 {
            return c""
        }
        return name
    }
    if node.kind == parser.NK_FIELD {
        val base_raw: ref u8 = cg_raw_c_name(ctx, parser.field_base(node))
        val fname: ref u8 = parser.field_name_raw(node)
        if str.raw_cmp(base_raw, c"") == 0 {
            return fname
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "{s}.{s}", {base_raw, fname})
        return buf
    }
    return c""
}

/// Extract the module prefix from a mangled function name.
/// E.g. "std__stdio__puts" with bare name "puts" -> "std__stdio"
pub fn extract_prefix_from_mangled(
    arena: allocators.ScopedArenaAllocator,
    mangled: ref u8,
    bare_name: ref u8
) ref u8 = trust {
    val mlen: i64 = str.len_raw(mangled)
    val blen: i64 = str.len_raw(bare_name)
    if mlen <= blen + 2 {
        return c""
    }
    val prefix_len: i64 = mlen - blen - 2
    val prefix: ref u8 = allocators.ScopedArena.alloc_or_none(
        arena,
        (prefix_len + 1) as usize
    ) as ref u8
    @memcpy(prefix, mangled, prefix_len as usize)
    @store8(@ptradd(prefix, prefix_len), 0)
    return prefix
}

fn cg_register_global(
    ctx: mut ref CgCtx,
    src_name: ref u8,
    label: ref u8,
    qtype: ref u8,
    ann: ref u8
) void = trust {
    @append(cg_global_src_names(ctx) as list[ref u8], src_name)
    @append(cg_global_labels(ctx) as list[ref u8], label)
    @append(cg_global_qtypes(ctx) as list[ref u8], qtype)
    @append(cg_global_anns(ctx) as list[ref u8], ann)
}

/// Look up a global by source name. Returns ("", "") if not found.
fn cg_lookup_global(
    ctx: mut ref CgCtx,
    src_name: ref u8,
    out_label: ref u8,
    out_qtype: ref u8,
    out_ann: ref u8
) bool = trust {
    val names: ref void = cg_global_src_names(ctx)
    val len: i64 = @len(names) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val n_opt = @get(names, i as usize)
        if n_opt is some n {
            if str.raw_cmp(n as ref u8, src_name) == 0 {
                val lbl_opt = @get(cg_global_labels(ctx) as list[ref u8], i as usize)
                val qty_opt = @get(cg_global_qtypes(ctx) as list[ref u8], i as usize)
                if lbl_opt is some lbl {
                    @memcpy(out_label, lbl as ref u8, str.len_raw(lbl as ref u8) + 1)
                }
                if qty_opt is some qty {
                    @memcpy(out_qtype, qty as ref u8, str.len_raw(qty as ref u8) + 1)
                }
                val ann_opt = @get(cg_global_anns(ctx) as list[ref u8], i as usize)
                if ann_opt is some ann {
                    @memcpy(out_ann, ann as ref u8, str.len_raw(ann as ref u8) + 1)
                }
                return true
            }
        }
        i++
    }
    return false
}

/// Return true when a global label with this exact name has been registered.
fn cg_global_label_exists(ctx: ref CgCtx, label: ref u8) bool = trust {
    val labels: ref void = cg_global_labels(ctx)
    val len: i64 = @len(labels) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val l_opt = @get(labels as list[ref u8], i as usize)
        if l_opt is some l {
            if str.raw_cmp(l as ref u8, label) == 0 {
                return true
            }
        }
        i++
    }
    return false
}

/// Look up the type annotation of a global by its mangled label.
fn cg_global_ann_by_label(ctx: ref CgCtx, label: ref u8) ref u8 = trust {
    val labels: ref void = cg_global_labels(ctx)
    val len: i64 = @len(labels) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val l_opt = @get(labels as list[ref u8], i as usize)
        if l_opt is some l {
            if str.raw_cmp(l as ref u8, label) == 0 {
                val a_opt = @get(cg_global_anns(ctx) as list[ref u8], i as usize)
                if a_opt is some a {
                    return a as ref u8
                }
                return c""
            }
        }
        i++
    }
    return c""
}

fn cg_sfields(ctx: ref CgCtx) list[ref void] = trust {
    return ctx.sfields
}

fn cg_sis_extern(ctx: ref CgCtx) list[bool] = trust {
    return ctx.sis_extern
}

fn cg_unames(ctx: ref CgCtx) ref void = trust {
    return ctx.unames as ref void
}

fn cg_uvariants(ctx: ref CgCtx) ref void = trust {
    return ctx.uvariants as ref void
}

fn cg_fn_names(ctx: ref CgCtx) ref void = trust {
    return ctx.fn_names as ref void
}

fn cg_fn_params(ctx: ref CgCtx) ref void = trust {
    return ctx.fn_params as ref void
}

fn cg_fn_rets(ctx: ref CgCtx) ref void = trust {
    return ctx.fn_rets as ref void
}

fn cg_extern_names(ctx: ref CgCtx) ref void = trust {
    return ctx.ext_names as ref void
}

fn cg_extern_syms(ctx: ref CgCtx) ref void = trust {
    return ctx.ext_syms as ref void
}

fn cg_ext_rets(ctx: ref CgCtx) ref void = trust {
    return ctx.ext_rets as ref void
}

fn cg_tv_names(ctx: ref CgCtx) ref void = trust {
    return ctx.tv_names as ref void
}

fn cg_tv_owners(ctx: ref CgCtx) ref void = trust {
    return ctx.tv_owners as ref void
}

fn cg_tv_tags(ctx: ref CgCtx) ref void = trust {
    return ctx.tv_tags as ref void
}

fn cg_tv_fields(ctx: ref CgCtx) ref void = trust {
    return ctx.tv_fields as ref void
}

fn cg_break_lbl(ctx: ref CgCtx) i64 = trust {
    return ctx.break_lbl
}

fn cg_cont_lbl(ctx: ref CgCtx) i64 = trust {
    return ctx.cont_lbl
}

fn cg_set_break_lbl(ctx: mut ref CgCtx, v: i64) void = trust {
    ctx.break_lbl = v
}

fn cg_set_cont_lbl(ctx: mut ref CgCtx, v: i64) void = trust {
    ctx.cont_lbl = v
}

fn cg_defer_stack(ctx: ref CgCtx) ref void = trust {
    return ctx.defer_stack as ref void
}

fn cg_defer_push(ctx: mut ref CgCtx, body: ref parser.Node) void = trust {
    val stack: ref void = cg_defer_stack(ctx)
    @append(stack as list[ref void], body)
}

fn cg_defer_clear(ctx: mut ref CgCtx) void = trust {
    ctx.defer_stack = mem.new[ref void]()
}

/// Emit all deferred statements in LIFO order.
fn cg_emit_defers(ctx: mut ref CgCtx) void = trust {
    val stack: ref void = cg_defer_stack(ctx)
    val n: i64 = @len(stack as list[ref void]) as i64
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        val d_opt = @get(stack as list[ref void], i as usize)
        if d_opt is some d {
            gen_stmts(ctx, d as ref parser.Node)
        }
        i--
    }
}

fn cg_mc_names(ctx: ref CgCtx) ref void = trust {
    return ctx.mc_names as ref void
}

fn cg_mc_vals(ctx: ref CgCtx) ref void = trust {
    return ctx.mc_vals as ref void
}

fn cg_register_module_const(ctx: mut ref CgCtx, name: ref u8, val_str: ref u8) void = trust {
    @append(cg_mc_names(ctx) as list[ref u8], name)
    @append(cg_mc_vals(ctx) as list[ref u8], val_str)
    if !collections.RawIndexMap.contains(ctx.mc_index, name) {
        val val_str_usize: mut usize = 0
        @store(@addr(val_str_usize) as ref void, val_str)
        collections.RawIndexMap.set(ctx.mc_index, name, val_str_usize)
    }
}

/// Look up a module-level constant value by name. Returns "" if not found.
fn cg_const_val(ctx: ref CgCtx, name: ref u8) ref u8 = trust {
    if collections.RawIndexMap.get(ctx.mc_index, name) is some v {
        return v as ref u8
    } else {
        return c""
    }
}

fn cg_register_c_header(ctx: mut ref CgCtx, header: ref u8) void = trust {
    if header == none || str.raw_cmp(header, c"") == 0 {
        return
    }
    for existing in ctx.c_headers {
        if str.raw_cmp(existing, header) == 0 {
            return
        }
    }
    @append(ctx.c_headers, header)
}

/// Register a C header constant and return the symbol used by the C shim.
fn cg_c_const_symbol(ctx: mut ref CgCtx, raw_name: ref u8) ref u8 = trust {
    if raw_name == none || str.raw_cmp(raw_name, c"") == 0 {
        return c""
    }
    if collections.RawIndexMap.get(ctx.c_const_index, raw_name) is some v {
        return v as ref u8
    }
    val idx: i64 = @len(ctx.c_consts) as i64
    val sym: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(sym, 64, "sxqbe_c_{lld}", {idx})
    @append(ctx.c_consts, raw_name)
    @append(ctx.c_const_syms, sym)
    val sym_usize: mut usize = 0
    @store(@addr(sym_usize) as ref void, sym)
    collections.RawIndexMap.set(ctx.c_const_index, raw_name, sym_usize)
    return sym
}

