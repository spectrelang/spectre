        ) as ref u8
        @snprintf(
            buf_ins15,
            256,
            "    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n",
            {new_len, len_val, new_len, len_slot}
        )
        emit(ctx, buf_ins15)
        @snprintf(buf, 512, "    %%t{lld} =l copy 0\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"reserve") == 0 {
        val lst5: ref u8 = cg_list_arg_ensured(ctx, args, 0)
        val cap: ref u8 = get_arg(ctx, args, 1)

        val cap_slot: i64 = fresh_tmp(ctx)
        val cur_cap: i64 = fresh_tmp(ctx)
        val buf_res1: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            buf_res1,
            256,
            "    %%t{lld} =l add {s}, 16\n    %%t{lld} =l loadl %%t{lld}\n",
            {cap_slot, lst5, cur_cap, cap_slot}
        )
        emit(
            ctx,
            buf_res1
        )
        val rbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(rbuf, 256, "    call $sxqbe_list_reserve(l {s}, l {s})\n", {lst5, cap})
        emit(ctx, rbuf)
        ctx.alloc_runtime = true
        @snprintf(buf, 512, "    %%t{lld} =l copy 0\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"capacity") == 0 {
        val lst6: ref u8 = get_list_arg(ctx, args, 0)
        val cap_val: i64 = fresh_tmp(ctx)
        @snprintf(
            buf,
            512,
            "    %%t{lld} =l call $sxqbe_list_cap(l {s})\n",
            {cap_val, lst6}
        )
        emit(ctx, buf)
        ctx.alloc_runtime = true
        tmp = cap_val
    } elif str.raw_cmp(name, c"list") == 0 {
        val ac_node_opt = @get(args, 0)
        val ac_node: mut ref parser.Node = none
        if ac_node_opt is some a {
            ac_node = a as ref parser.Node
        }
        val ac_ann: ref u8 = infer_type_annotation(ctx, ac_node)
        val ac_ty: ref parser.Node = cg_named_ty_from_ann(ctx, ac_ann)
        if ac_ty == none {
            stdio.eprint("error: cannot infer allocator type for @list\n", {})
            os.exit(1)
        }
        val ac: ref u8 = get_arg(ctx, args, 0)
        val af: ref u8 = cg_alloc_fn_ptr(ctx, ac_ty, c"alloc")
        val ff: ref u8 = cg_alloc_fn_ptr(ctx, ac_ty, c"free")
        val rf: ref u8 = cg_alloc_fn_ptr(ctx, ac_ty, c"realloc")
        val alen: i64 = @len(args as list[ref parser.Node]) as i64
        val count: i64 = alen - 1
        val arr_tmp: i64 = fresh_tmp(ctx)
        val alloc_bytes: mut i64 = 8
        if count > 0 {
            alloc_bytes = count * 8
        }
        val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            init_buf,
            256,
            "    %%t{lld} =l alloc8 {lld}\n    call $memset(l %%t{lld}, w 0, l {lld})\n",
            {arr_tmp, alloc_bytes, arr_tmp, alloc_bytes}
        )
        emit(ctx, init_buf)
        val ei: mut i64 = 1
        for {
            if ei >= alen {
                break
            }
            val e_opt = @get(args, ei as usize)
            if e_opt is some e {
                val e_node: ref parser.Node = e as ref parser.Node
                ctx.aggregate_heap++
                val ev_raw: ref u8 = gen_expr(ctx, e_node)
                ctx.aggregate_heap--
                val e_ann: ref u8 = infer_type_annotation(ctx, e_node)
                val ev: ref u8 = cg_materialize_stack_aggregate_ann(ctx, ev_raw, e_ann)
                val eqt: ref u8 = expr_qtype(ctx, e_node)
                val eval: mut ref u8 = ev
                if str.raw_cmp(eqt, c"w") == 0 {
                    val conv: i64 = fresh_tmp(ctx)
                    val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(cb, 128, "    %%t{lld} =l extsw {s}\n", {conv, ev})
                    emit(
                        ctx,
                        cb
                    )
                    val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(cr, 16, "%%t{lld}", {conv})
                    eval = cr
                } elif str.raw_cmp(eqt, c"d") == 0 || str.raw_cmp(eqt, c"s") == 0 {
                    val conv: i64 = fresh_tmp(ctx)
                    val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(cb, 128, "    %%t{lld} =l cast {s}\n", {conv, ev})
                    emit(
                        ctx,
                        cb
                    )
                    val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(cr, 16, "%%t{lld}", {conv})
                    eval = cr
                }
                val off: i64 = (ei - 1) * 8
                val off_tmp: i64 = fresh_tmp(ctx)
                val sbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(
                    sbuf,
                    128,
                    "    %%t{lld} =l add %%t{lld}, {lld}\n    storel {s}, %%t{lld}\n",
                    {off_tmp, arr_tmp, off, eval, off_tmp}
                )
                emit(ctx, sbuf)
            }
            ei++
        }
        ctx.alloc_runtime = true
        @snprintf(
            buf,
            1024,
            "    %%t{lld} =l call $sxqbe_list_from(l {s}, l {s}, l {s}, l {s}, l %%t{lld}, l {lld})\n",
            {tmp, af, ff, rf, ac, arr_tmp, count}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"listalloc") == 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val af: ref u8 = cg_alloc_fn_ptr_targs(ctx, btargs, c"alloc")
        val ff: ref u8 = cg_alloc_fn_ptr_targs(ctx, btargs, c"free")
        val rf: ref u8 = cg_alloc_fn_ptr_targs(ctx, btargs, c"realloc")
        val ac: ref u8 = get_arg(ctx, args, 0)
        ctx.alloc_runtime = true
        @snprintf(
            buf,
            512,
            "    %%t{lld} =l call $sxqbe_list_alloc(l {s}, l {s}, l {s}, l {s})\n",
            {tmp, af, ff, rf, ac}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"listfree") == 0 {
        val lst: ref u8 = get_arg(ctx, args, 0)
        @snprintf(
            buf,
            512,
            "    call $sxqbe_list_free(l {s})\n    %%t{lld} =l copy 0\n",
            {lst, tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"argsalloc") == 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val ty: ref parser.Node = cg_first_type_arg(btargs)
        val ac: ref u8 = get_arg(ctx, args, 0)
        val af: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"alloc")
        val ff: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"free")
        val rf: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"realloc")
        val argc_tmp: i64 = fresh_tmp(ctx)
        val argv_tmp: i64 = fresh_tmp(ctx)
        ctx.alloc_runtime = true
        @snprintf(
            buf,
            1024,
            "    %%t{lld} =l loadl $sx_argc_store\n    %%t{lld} =l loadl $sx_argv_store\n    %%t{lld} =l call $sxqbe_args_alloc(l {s}, l {s}, l {s}, l {s}, l %%t{lld}, l %%t{lld})\n",
            {argc_tmp, argv_tmp, tmp, af, ff, rf, ac, argc_tmp, argv_tmp}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"fmtalloc") == 0 &&
    (@len(parser.builtin_type_args(expr)) as i64) > 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val ty: ref parser.Node = cg_first_type_arg(btargs)
        val ac: ref u8 = get_arg(ctx, args, 0)
        val fmt_arg: ref u8 = get_format_arg_viewaware(ctx, args, 1, 2)
        val af: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"alloc")
        val ff: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"free")
        val rf: ref u8 = cg_alloc_fn_ptr(ctx, ty, c"realloc")
        val pack_ref: mut ref u8 = c"0"
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 2 {
                val pack_opt = @get(args, 2)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        val pack_tmp: i64 = fresh_tmp(ctx)
                        val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            256 as usize
                        ) as ref u8
                        @snprintf(
                            init_buf,
                            256,
                            "    %%t{lld} =l alloc8 128\n    call $memset(l %%t{lld}, w 0, l 128)\n",
                            {pack_tmp, pack_tmp}
                        )
                        emit(ctx, init_buf)
                        val pack: ref void = pn.d0 as ref void
                        val plen: i64 = @len(pack as list[ref parser.Node]) as i64
                        val pi: mut i64 = 0
                        val slot: mut i64 = 0
                        for {
                            if pi >= plen || slot >= 16 {
                                break
                            }
                            val pe_opt = @get(pack as list[ref parser.Node], pi as usize)
                            if pe_opt is some pe {
                                val pe_node: ref parser.Node = pe as ref parser.Node
                                val pann: ref u8 = infer_type_annotation(ctx, pe_node)
                                if ann_is_string_type(pann, c"StringView") {
                                    val raw: ref u8 = gen_expr(ctx, pe_node)
                                    val off_tmp: i64 = fresh_tmp(ctx)
                                    val len_tmp: i64 = fresh_tmp(ctx)
                                    val ptr_tmp: i64 = fresh_tmp(ctx)
                                    val view_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        view_buf,
                                        256,
                                        "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =l loadl {s}\n",
                                        {off_tmp, raw, len_tmp, off_tmp, ptr_tmp, raw}
                                    )
                                    emit(ctx, view_buf)
                                    val len_slot: i64 = slot * 8
                                    val ptr_slot: i64 = (slot + 1) * 8
                                    val len_off: i64 = fresh_tmp(ctx)
                                    val ptr_off: i64 = fresh_tmp(ctx)
                                    val slot_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        slot_buf,
                                        256,
                                        "    %%t{lld} =l add %%t{lld}, {lld}\n    storel %%t{lld}, %%t{lld}\n    %%t{lld} =l add %%t{lld}, {lld}\n    storel %%t{lld}, %%t{lld}\n",
                                        {len_off, pack_tmp, len_slot, len_tmp, len_off,
                                            ptr_off, pack_tmp, ptr_slot, ptr_tmp, ptr_off}
                                    )
                                    emit(ctx, slot_buf)
                                    slot += 2
                                } else {
                                    val pval: mut ref u8 = c"0"
                                    if ann_is_string_type(pann, c"String") {
                                        pval = gen_string_pack_value(ctx, pe_node)
                                    } else {
                                        val pv: ref u8 = gen_expr(ctx, pe_node)
                                        val pqt: ref u8 = expr_qtype(ctx, pe_node)
                                        pval = pv
                                        if str.raw_cmp(pqt, c"w") == 0 {
                                            val conv: i64 = fresh_tmp(ctx)
                                            val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                128 as usize
                                            ) as ref u8
                                            @snprintf(
                                                cb,
                                                128,
                                                "    %%t{lld} =l extsw {s}\n",
                                                {conv, pv}
                                            )
                                            emit(
                                                ctx,
                                                cb
                                            )
                                            val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                16 as usize
                                            ) as ref u8
                                            @snprintf(cr, 16, "%%t{lld}", {conv})
                                            pval = cr
                                        } elif str.raw_cmp(
                                            pqt,
                                            c"d"
                                        ) == 0 || str.raw_cmp(pqt, c"s") == 0 {
                                            val conv: i64 = fresh_tmp(ctx)
                                            val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                128 as usize
                                            ) as ref u8
                                            @snprintf(
                                                cb,
                                                128,
                                                "    %%t{lld} =l cast {s}\n",
                                                {conv, pv}
                                            )
                                            emit(
                                                ctx,
                                                cb
                                            )
                                            val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                16 as usize
                                            ) as ref u8
                                            @snprintf(cr, 16, "%%t{lld}", {conv})
                                            pval = cr
                                        }
                                    }
                                    val off: i64 = slot * 8
                                    val off_tmp: i64 = fresh_tmp(ctx)
                                    val sbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        128 as usize
                                    ) as ref u8
                                    @snprintf(
                                        sbuf,
                                        128,
                                        "    %%t{lld} =l add %%t{lld}, {lld}\n    storel {s}, %%t{lld}\n",
                                        {off_tmp, pack_tmp, off, pval, off_tmp}
                                    )
                                    emit(ctx, sbuf)
                                    slot++
                                }
                            }
                            pi++
                        }
                        val pr: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            16 as usize
                        ) as ref u8
                        @snprintf(pr, 16, "%%t{lld}", {pack_tmp})
                        pack_ref = pr
                    } else {
                        val pack_tmp: i64 = fresh_tmp(ctx)
                        val pann: ref u8 = infer_type_annotation(ctx, pn)
                        val pval: mut ref u8 = c"0"
                        if ann_is_string_type(pann, c"String")
                        || ann_is_string_type(pann, c"StringView") {
                            pval = gen_string_pack_value(ctx, pn)
                        } else {
                            val pv: ref u8 = gen_expr(ctx, pn)
                            val pqt: ref u8 = expr_qtype(ctx, pn)
                            pval = pv
                            if str.raw_cmp(pqt, c"w") == 0 {
                                val conv: i64 = fresh_tmp(ctx)
                                val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    128 as usize
                                ) as ref u8
                                @snprintf(cb, 128, "    %%t{lld} =l extsw {s}\n", {conv, pv})
                                emit(
                                    ctx,
                                    cb
                                )
                                val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    16 as usize
                                ) as ref u8
                                @snprintf(cr, 16, "%%t{lld}", {conv})
                                pval = cr
                            } elif str.raw_cmp(pqt, c"d") == 0 || str.raw_cmp(pqt, c"s") == 0 {
                                val conv: i64 = fresh_tmp(ctx)
                                val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    128 as usize
                                ) as ref u8
                                @snprintf(cb, 128, "    %%t{lld} =l cast {s}\n", {conv, pv})
                                emit(
                                    ctx,
                                    cb
                                )
                                val cr: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    16 as usize
                                ) as ref u8
                                @snprintf(cr, 16, "%%t{lld}", {conv})
                                pval = cr
                            }
                        }
                        val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            256 as usize
                        ) as ref u8
                        @snprintf(
                            init_buf,
                            256,
                            "    %%t{lld} =l alloc8 128\n    call $memset(l %%t{lld}, w 0, l 128)\n    storel {s}, %%t{lld}\n",
                            {pack_tmp, pack_tmp, pval, pack_tmp}
                        )
                        emit(
                            ctx,
                            init_buf
                        )
                        val pr: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            16 as usize
                        ) as ref u8
                        @snprintf(pr, 16, "%%t{lld}", {pack_tmp})
                        pack_ref = pr
                    }
                }
            }
        }
        ctx.alloc_runtime = true
        @snprintf(
            buf,
            1024,
            "    %%t{lld} =l call $sxqbe_fmt_alloc(l {s}, l {s}, l {s}, l {s}, l {s}, l {s})\n",
            {tmp, af, ff, rf, ac, fmt_arg, pack_ref}
        )
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"fmt") == 0 || str.raw_cmp(name, c"fmtalloc") == 0 {
        val fmt2: ref u8 = get_format_arg_viewaware(ctx, args, 0, 1)
        val fmt_buf: i64 = fresh_tmp(ctx)
        val fmt_written_w: i64 = fresh_tmp(ctx)
        val fmt_written: i64 = fresh_tmp(ctx)
        val fmt_copy_size: i64 = fresh_tmp(ctx)
        val fmt_copy: i64 = fresh_tmp(ctx)
        val fmt_nul: i64 = fresh_tmp(ctx)
        val fmt_hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(fmt_hdr, 256, "    %%t{lld} =l call $malloc(l 4096)\n", {fmt_buf})
        emit(ctx, fmt_hdr)
        val fmt_call_sb: ref void = str.StringBuilder.new()
        val snp_hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(
            snp_hdr,
            256,
            "    %%t{lld} =w call $snprintf(l %%t{lld}, l 4096, l {s}",
            {fmt_written_w, fmt_buf, fmt2}
        )
        str.StringBuilder.append_cstr(fmt_call_sb, snp_hdr)
        if args != none {
            val falen: i64 = @len(args) as i64
            if falen > 1 {
                val fpack_opt = @get(args, 1)
                if fpack_opt is some fpack_node {
                    val fpn: ref parser.Node = fpack_node as ref parser.Node
                    if fpn.kind == parser.NK_ARGS_PACK {
                        val fpack: ref void = fpn.d0 as ref void
                        val fplen: i64 = @len(fpack) as i64
                        if fplen > 0 {
                            str.StringBuilder.append_cstr(fmt_call_sb, c", ...")
                            val fpi: mut i64 = 0
                            for {
                                if fpi >= fplen {
                                    break
                                }
                                val fpe_opt = @get(fpack, fpi as usize)
                                if fpe_opt is some fpe {
                                    val fpe_node: ref parser.Node = fpe as ref parser.Node
                                    val fpvarg: ref u8 = gen_print_arg(ctx, fpe_node)
                                    val fpbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        128 as usize
                                    ) as ref u8
                                    @snprintf(fpbuf, 128, ", {s}", {fpvarg})
                                    str.StringBuilder.append_cstr(fmt_call_sb, fpbuf)
                                }
                                fpi++
                            }
                        }
                    }
                }
            }
        }
        str.StringBuilder.append_cstr(fmt_call_sb, c")\n")
        val fmt_call_line: ref void = str.StringBuilder.build(fmt_call_sb)
        str.StringBuilder.free(fmt_call_sb)
        emit(ctx, str.cstr(fmt_call_line))
        @free(@load(fmt_call_line))
        @free(fmt_call_line)
        // extsw, malloc copy, memcpy, nul-terminate, free buf
        val tail_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(tail_buf, 512, "    %%t{lld} =l extsw %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    %%t{lld} =l call $malloc(l %%t{lld})\n    call $memcpy(l %%t{lld}, l %%t{lld}, l %%t{lld})\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    storeb 0, %%t{lld}\n    call $free(l %%t{lld})\n",
            {fmt_written, fmt_written_w,
                fmt_copy_size, fmt_written,
                fmt_copy, fmt_copy_size,
                fmt_copy, fmt_buf, fmt_written,
                fmt_nul, fmt_copy, fmt_written,
                fmt_nul,
                fmt_buf})
        emit(ctx, tail_buf)
        @snprintf(buf, 512, "    %%t{lld} =l copy %%t{lld}\n", {tmp, fmt_copy})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"args") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =l call $__sx_get_args()\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"stdin") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =l call $sx_stdin()\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"stdout") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =l call $sx_stdout()\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"stderr") == 0 {
        @snprintf(buf, 512, "    %%t{lld} =l call $sx_stderr()\n", {tmp})
        emit(ctx, buf)
    } elif str.raw_cmp(name, c"call") == 0 {
        if args != none && @len(args as list[ref parser.Node]) as i64 > 0 {
            val fn_node_opt = @get(args as list[ref parser.Node], 0)
            if fn_node_opt is some fn_node_raw {
                val fn_node: ref parser.Node = fn_node_raw as ref parser.Node
                val fn_ptr: ref u8 = gen_expr(ctx, fn_node)
                val fn_sig: ref parser.Node = cg_lookup_fnptr_sig(ctx, fn_node)
                val fn_params: mut ref void = none
                val ret_ty: mut ref parser.Node = none
                if fn_sig != none {
                    fn_params = fn_sig.d0 as ref void
                    ret_ty = fn_sig.d1 as ref parser.Node
                }
                val ret_qtype: mut ref u8 = c"l"
                val ret_union_name: mut ref u8 = c""
                if ret_ty != none {
                    ret_qtype = qbe_type_of(ret_ty)
                    ret_union_name = is_union_type(ctx, ret_ty)
                }
                val returns_union: bool = str.raw_cmp(ret_union_name, c"") != 0
                val returns_unboxed: bool = ret_ty != none
                && (ret_ty.kind == parser.TY_OPTION || ret_ty.kind == parser.TY_RESULT)
                val has_sret: bool = returns_union || returns_unboxed
                val ret_buf_tmp: mut i64 = -1
                if has_sret {
                    ret_buf_tmp = fresh_tmp(ctx)
                    val ret_sz: mut i64 = 16
                    if returns_union {
                        val uv: ref void = cg_lookup_union_suffix(ctx, ret_union_name)
                        if uv != none {
                            ret_sz = cg_union_size(ctx, uv)
                        }
                    }
                    if returns_unboxed {
                        ret_sz = cg_wrap_layout_size(ctx, ret_ty)
                    }
                    val alloc_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(
                        alloc_buf,
                        64,
                        "    %%t{lld} =l alloc8 {lld}\n",
                        {ret_buf_tmp, ret_sz}
                    )
                    emit(ctx, alloc_buf)
                }

                val arg_tmps2: mut list[ref u8] = mem.new[ref u8]()
                val arg_qts2: mut list[ref u8] = mem.new[ref u8]()
                val alen3: i64 = @len(args as list[ref parser.Node]) as i64
                val ai3: mut i64 = 1
                for {
                    if ai3 >= alen3 {
                        break
                    }
                    val a3_opt = @get(args as list[ref parser.Node], ai3 as usize)
                    if a3_opt is some a3 {
                        val a3_node: ref parser.Node = a3 as ref parser.Node
                        val param_ty: mut ref parser.Node = none
                        if fn_params != none {
                            val pi3: i64 = ai3 - 1
                            if pi3 < @len(fn_params as list[ref parser.Node]) as i64 {
                                val p3_opt = @get(fn_params as list[ref parser.Node], pi3 as usize)
                                if p3_opt is some p3 {
                                    param_ty = p3 as ref parser.Node
                                }
                            }
                        }
                        val at3: mut ref u8 = c"0"
                        if param_ty != none {
                            at3 = gen_expr_expected(ctx, a3_node, param_ty)
                            @append(arg_qts2, qbe_type_of(param_ty))
                        } else {
                            at3 = gen_expr(ctx, a3_node)
                            @append(arg_qts2, expr_qtype(ctx, a3_node))
                        }
                        @append(arg_tmps2, at3)
                    }
                    ai3++
                }

                if fn_params != none {
                    val plen3: i64 = @len(fn_params as list[ref parser.Node]) as i64
                    val tlen0: i64 = @len(arg_tmps2) as i64
                    val wi: mut i64 = 0
                    for {
                        if wi >= plen3 {
                            break
                        }
                        if wi >= tlen0 {
                            break
                        }
                        val p_opt = @get(fn_params as list[ref parser.Node], wi as usize)
                        if p_opt is some p {
                            val pty: ref parser.Node = p as ref parser.Node
                            if pty != none && pty.kind == parser.TY_NAMED {
                                val ptype_name: ref u8 = parser.node_str_raw(pty.d0)
                                val union_vars: ref void = cg_lookup_union_suffix(ctx, ptype_name)
                                if union_vars != none {
                                    val at_opt = @get(arg_tmps2, wi as usize)
                                    if at_opt is some at {
                                        val arg_val: ref u8 = at as ref u8
                                        val should_wrap: mut bool = true
                                        if @load8(arg_val) as i64 == 37 {
                                            val second: i64 = @load8(@ptradd(arg_val, 1)) as i64
                                            if second == 116 {
                                                should_wrap = false
                                            }
                                        }
                                        if should_wrap {
                                            val box_ptr: i64 = fresh_tmp(ctx)
                                            val payload_ptr: i64 = fresh_tmp(ctx)
                                            val bbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                256 as usize
                                            ) as ref u8
                                            @snprintf(bbuf, 256,
                                                "    %%t{lld} =l call $malloc(l 16)\n    storew 0, %%t{lld}\n    %%t{lld} =l add %%t{lld}, 8\n    storel {s}, %%t{lld}\n",
                                                {
                                                    box_ptr,
                                                    box_ptr,
                                                    payload_ptr,
                                                    box_ptr,
                                                    arg_val,
                                                    payload_ptr
                                                })
                                            emit(
                                                ctx,
                                                bbuf
                                            )
                                            val wrapped: ref u8 = allocators.ScopedArena.alloc_or_none(
                                                ctx.arena,
                                                16 as usize
                                            ) as ref u8
                                            @snprintf(wrapped, 16, "%%t{lld}", {box_ptr})
                                            val new_tmps: mut list[ref u8] = mem.new[ref u8]()
                                            val tlen_r: i64 = @len(arg_tmps2) as i64
                                            val ri: mut i64 = 0
                                            for {
                                                if ri >= tlen_r {
                                                    break
                                                }
                                                val r_opt = @get(arg_tmps2, ri as usize)
                                                if r_opt is some r {
                                                    if ri == wi {
                                                        @append(new_tmps, wrapped)
                                                    } else {
                                                        @append(new_tmps, r as ref u8)
                                                    }
                                                }
                                                ri++
                                            }
                                            arg_tmps2 = new_tmps
                                        }
                                    }
                                }
                            }
                        }
                        wi++
                    }
                }

                val call_sb2: ref void = str.StringBuilder.new()
                val hdr3_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(hdr3_buf, 512, "    %%t{lld} ={s} call {s}(", {tmp, ret_qtype, fn_ptr})
                str.StringBuilder.append_cstr(call_sb2, hdr3_buf)
                if has_sret {
                    val ret_arg: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        32 as usize
                    ) as ref u8
                    @snprintf(ret_arg, 32, "l %%t{lld}", {ret_buf_tmp})
                    str.StringBuilder.append_cstr(call_sb2, ret_arg)
                }
                val tlen3: i64 = @len(arg_tmps2) as i64
                val ti3: mut i64 = 0
                for {
                    if ti3 >= tlen3 {
                        break
                    }
                    val t3_opt = @get(arg_tmps2, ti3 as usize)
                    if t3_opt is some t3 {
                        val arg_qt: mut ref u8 = c"l"
                        if fn_params != none && ti3 < @len(fn_params as list[ref parser.Node]) as i64 {
                            val p3_opt = @get(fn_params as list[ref parser.Node], ti3 as usize)
                            if p3_opt is some p3 {
                                arg_qt = qbe_type_of(p3 as ref parser.Node)
                            }
                        }
                        val src_qt_opt = @get(arg_qts2, ti3 as usize)
                        val src_qt: mut ref u8 = c"l"
                        if src_qt_opt is some sq {
                            src_qt = sq as ref u8
                        }
                        val arg_val2: ref u8 = cg_coerce_qtype(ctx, t3 as ref u8, src_qt, arg_qt)
                        if has_sret || ti3 > 0 {
                            str.StringBuilder.append_cstr(call_sb2, c", ")
                        }
                        val tbuf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            64 as usize
                        ) as ref u8
                        @snprintf(tbuf4, 64, "{s} {s}", {arg_qt, arg_val2})
                        str.StringBuilder.append_cstr(call_sb2, tbuf4)
                    }
                    ti3++
                }
                str.StringBuilder.append_cstr(call_sb2, c")\n")
                val call_line3: ref void = str.StringBuilder.build(call_sb2)
                str.StringBuilder.free(call_sb2)
                emit(ctx, str.cstr(call_line3))
                @free(@load(call_line3))
                @free(call_line3)
                if has_sret {
                    @snprintf(buf, 512, "    %%t{lld} =l copy %%t{lld}\n", {tmp, ret_buf_tmp})
                    emit(ctx, buf)
                }
            }
        }
    } else {
        val call_sb: ref void = str.StringBuilder.new()
        val hdr2_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(hdr2_buf, 512, "    %%t{lld} =l call ${s}(", {tmp, name})
        str.StringBuilder.append_cstr(call_sb, hdr2_buf)
        if args != none {
            val alen: i64 = @len(args) as i64
            val ai: mut i64 = 0
            val arg_nodes: mut list[ref parser.Node] = mem.new[ref parser.Node]()
            val arg_tmps2: mut list[ref u8] = mem.new[ref u8]()
            for {
                if ai >= alen {
                    break
                }
                val a_opt = @get(args, ai as usize)
                if a_opt is some a {
                    val a_node: ref parser.Node = a as ref parser.Node
                    val ak: i64 = a_node.kind
                    if ak == parser.NK_ARGS_PACK {
                        val pack: ref void = a_node.d0 as ref void
                        val plen: i64 = @len(pack) as i64
                        val pi: mut i64 = 0
                        for {
                            if pi >= plen {
                                break
                            }
                            val pe_opt = @get(pack, pi as usize)
                            if pe_opt is some pe {
                                val pe_node: ref parser.Node = pe as ref parser.Node
                                val at: ref u8 = gen_expr(ctx, pe_node)
                                @append(arg_nodes, pe_node)
                                @append(arg_tmps2, at)
                            }
                            pi++
                        }
                    } else {
                        val at: ref u8 = gen_expr(ctx, a_node)
                        @append(arg_nodes, a_node)
                        @append(arg_tmps2, at)
                    }
                }
                ai++
            }
            val tlen3: i64 = @len(arg_tmps2) as i64
            val ti3: mut i64 = 0
            for {
                if ti3 >= tlen3 {
                    break
                }
                val t3_opt = @get(arg_tmps2, ti3 as usize)
                val n_opt = @get(arg_nodes, ti3 as usize)
                if t3_opt is some t3 {
                    if ti3 > 0 {
                        str.StringBuilder.append_cstr(call_sb, c", ")
                    }
                    val qtype: mut ref u8 = c"l"
                    if n_opt is some n {
                        val qt: ref u8 = expr_qtype(ctx, n as ref parser.Node)
                        if str.raw_cmp(qt, c"") != 0 {
                            qtype = qt
                        }
                    }
                    val tbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(tbuf3, 64, "{s} {s}", {qtype, t3 as ref u8})
                    str.StringBuilder.append_cstr(call_sb, tbuf3)
                }
                ti3++
            }
        }
        str.StringBuilder.append_cstr(call_sb, c")")
        val call_line2: ref void = str.StringBuilder.build(call_sb)
        str.StringBuilder.free(call_sb)
        emitln(ctx, str.cstr(call_line2))
        @free(@load(call_line2))
        @free(call_line2)
    }
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn gen_fixed_arr_lit(
    ctx: mut ref CgCtx,
    expr: ref parser.Node,
    ty: ref parser.Node
) ref u8 = trust {
    if expr == none || ty == none || ty.kind != parser.TY_FIXED_ARR {
        return c"0"
    }

    val total_size: i64 = cg_type_size(ctx, ty)
    val elem_ty: ref parser.Node = parser.fixed_arr_inner(ty)
    val elem_size: i64 = cg_type_size(ctx, elem_ty)
    val tmp: i64 = fresh_tmp(ctx)
    cg_alloc_aggregate_temp(ctx, tmp, total_size)
    val zero_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(zero_buf, 128, "    call $memset(l %%t{lld}, w 0, l {lld})\n", {tmp, total_size})
    emit(ctx, zero_buf)
    if expr.kind == parser.NK_ZERO_INIT {
        val zero_res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            16 as usize
        ) as ref u8
        @snprintf(zero_res, 16, "%%t{lld}", {tmp})
        return zero_res
    }

    if expr.kind == parser.NK_LIST_LIT {
        val elems: ref void = expr.d0 as ref void
        val elen: mut i64 = 0
        if elems != none {
            elen = @len(elems) as i64
        }

        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            val e_opt = @get(elems, ei as usize)
            if e_opt is some e {
                val e_node: ref parser.Node = e as ref parser.Node
                val off: i64 = ei * elem_size
                val elem_is_fa: bool = elem_ty != none && elem_ty.kind == parser.TY_FIXED_ARR
                if elem_is_fa {
                    val off_tmp: i64 = fresh_tmp(ctx)
                    val off_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    @snprintf(
                        off_buf,
                        256,
                        "    %%t{lld} =l add %%t{lld}, {lld}\n",
                        {off_tmp, tmp, off}
                    )
                    emit(
                        ctx,
                        off_buf
                    )
                    val is_zero: bool = e_node.kind == parser.NK_INT_LIT && str.raw_cmp(
                        parser.int_lit_text_raw(e_node),
                        c"0"
                    ) == 0
                    if is_zero {
                        val memset_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(
                            memset_buf,
                            128,
                            "    call $memset(l %%t{lld}, w 0, l {lld})\n",
                            {off_tmp, elem_size}
                        )
                        emit(ctx, memset_buf)
                    } else {
                        val eval: ref u8 = gen_fixed_arr_lit(ctx, e_node, elem_ty)
                        val memcpy_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(
                            memcpy_buf,
                            128,
                            "    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                            {off_tmp, eval, elem_size}
                        )
                        emit(ctx, memcpy_buf)
                    }
                } else {
                    val eval2: ref u8 = gen_expr_expected(ctx, e_node, elem_ty)
                    val store_op: mut ref u8 = c"storel"
                    val qt: ref u8 = qbe_type_of(elem_ty)
                    if str.raw_cmp(qt, c"d") == 0 {
                        store_op = c"stored"
                    } elif str.raw_cmp(qt, c"s") == 0 {
                        store_op = c"stores"
                    } elif str.raw_cmp(qt, c"w") == 0 {
                        store_op = c"storew"
                    }

                    val store_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    if off == 0 {
                        @snprintf(store_buf, 256, "    {s} {s}, %%t{lld}\n", {store_op, eval2, tmp})
                    } else {
                        val off_tmp2: i64 = fresh_tmp(ctx)
                        @snprintf(store_buf, 256, "    %%t{lld} =l add %%t{lld}, {lld}\n    {s} {s}, %%t{lld}\n",
                            {off_tmp2, tmp, off, store_op, eval2, off_tmp2})
                    }
                    emit(ctx, store_buf)
                }
            }
            ei++
        }
    }

    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn gen_list_lit(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    stdio.eprint(
        "error: {s}:{lld}: implicit dynamic list allocation is not allowed, use @list(ac, ...) or @listalloc[Alloc, T](ac), squared bracket syntax denotes an array literal and requires an explicit type annotation\n",
        {ctx.current_filename, expr.line}
    )
    os.exit(1)
    val elems: ref void = expr.d0 as ref void
    val elen: mut i64 = 0
    if elems != none {
        elen = @len(elems) as i64
    }
    val elem_ty: ref parser.Node = cg_unwrap_list_elem_ty(ctx, ctx.expected_ty as ref parser.Node)
    val elem_qt: mut ref u8 = c"l"
    if elem_ty != none {
        elem_qt = qbe_type_of(elem_ty)
    } elif elen > 0 {
        val first_opt = @get(elems, 0)
        if first_opt is some first {
            elem_qt = expr_qbe_type(ctx, first as ref parser.Node)
        }
    }

    val cap: mut i64 = 1
    if elen > 0 {
        cap = elen
    }

    val hdr_ptr: i64 = fresh_tmp(ctx)
    val buf_ptr: i64 = fresh_tmp(ctx)
    val buf1: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf1, 128, "    %%t{lld} =l call $malloc(l 32)\n", {hdr_ptr})
    emit(
        ctx,
        buf1
    )
    val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf2, 128, "    %%t{lld} =l call $malloc(l {lld})\n", {buf_ptr, cap * 8})
    emit(
        ctx,
        buf2
    )
    val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf3, 128, "    storel %%t{lld}, %%t{lld}\n", {buf_ptr, hdr_ptr})
    emit(ctx, buf3)
    val len_slot: i64 = fresh_tmp(ctx)
    val cap_slot: i64 = fresh_tmp(ctx)
    val buf4: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf4, 128, "    %%t{lld} =l add %%t{lld}, 8\n", {len_slot, hdr_ptr})
    emit(
        ctx,
        buf4
    )
    val buf5: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf5, 128, "    %%t{lld} =l add %%t{lld}, 16\n", {cap_slot, hdr_ptr})
    emit(
        ctx,
        buf5
    )
    val buf6: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf6, 128, "    storel {lld}, %%t{lld}\n", {elen, len_slot})
    emit(
        ctx,
        buf6
    )
    val buf7: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf7, 128, "    storel {lld}, %%t{lld}\n", {cap, cap_slot})
    emit(ctx, buf7)
    val desc_slot: i64 = fresh_tmp(ctx)
    val buf7b: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(
        buf7b,
        128,
        "    %%t{lld} =l add %%t{lld}, 24\n    storel 0, %%t{lld}\n",
        {desc_slot, hdr_ptr, desc_slot}
    )
    emit(ctx, buf7b)
    if elems != none {
        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            val e_opt = @get(elems, ei as usize)
            if e_opt is some e {
                val val_tmp: ref u8 = gen_expr_expected(ctx, e as ref parser.Node, elem_ty)
                val store_val: mut ref u8 = val_tmp
                // List slots are always 64-bit. Mirror @append's representation:
                // floating-point values are bit-cast into the slot, and word
                // values are sign-extended.
                if str.raw_cmp(elem_qt, c"d") == 0 {
                    val cast_tmp: i64 = fresh_tmp(ctx)
                    val cast_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(cast_buf, 128, "    %%t{lld} =l cast {s}\n", {cast_tmp, val_tmp})
                    emit(
                        ctx,
                        cast_buf
                    )
                    val cast_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(cast_res, 16, "%%t{lld}", {cast_tmp})
                    store_val = cast_res
                } elif str.raw_cmp(elem_qt, c"s") == 0 {
                    val w_tmp: i64 = fresh_tmp(ctx)
                    val w_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(w_buf, 128, "    %%t{lld} =w cast {s}\n", {w_tmp, val_tmp})
                    emit(ctx, w_buf)
                    val ext_tmp: i64 = fresh_tmp(ctx)
                    val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(ext_buf, 128, "    %%t{lld} =l extuw %%t{lld}\n", {ext_tmp, w_tmp})
                    emit(
                        ctx,
                        ext_buf
                    )
                    val ext_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(ext_res, 16, "%%t{lld}", {ext_tmp})
                    store_val = ext_res
                } elif str.raw_cmp(elem_qt, c"w") == 0 {
                    val ext_tmp: i64 = fresh_tmp(ctx)
                    val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(ext_buf, 128, "    %%t{lld} =l extsw {s}\n", {ext_tmp, val_tmp})
                    emit(
                        ctx,
                        ext_buf
                    )
                    val ext_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(ext_res, 16, "%%t{lld}", {ext_tmp})
                    store_val = ext_res
                }
                val off: i64 = fresh_tmp(ctx)
                val elem_ptr: i64 = fresh_tmp(ctx)
                val buf8: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8

                @snprintf(buf8, 128, "    %%t{lld} =l mul {lld}, 8\n", {off, ei})
                emit(
                    ctx,
                    buf8
                )
                val buf9: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(
                    buf9,
                    128,
                    "    %%t{lld} =l add %%t{lld}, %%t{lld}\n",
                    {elem_ptr, buf_ptr, off}
                )
                emit(
                    ctx,
                    buf9
                )
                val buf10: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(buf10, 128, "    storel {s}, %%t{lld}\n", {store_val, elem_ptr})
                emit(ctx, buf10)
            }

            ei++
        }
    }

    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {hdr_ptr})
    return res
}

fn gen_struct_lit(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    val fields: ref void = expr.d0 as ref void
    val flen: mut i64 = 0
    if fields != none {
        flen = @len(fields) as i64
    }

    val struct_fields: mut ref void = none
    val named_ty: ref u8 = parser.struct_lit_type_name_raw(expr)
    val expected_ty: ref parser.Node = ctx.expected_ty as ref parser.Node
    if named_ty != none {
        struct_fields = cg_lookup_struct(ctx, named_ty)
    }
    if struct_fields == none && expected_ty != none {
        struct_fields = cg_struct_fields_for_type(ctx, expected_ty)
    }
    if struct_fields == none {
        struct_fields = cg_find_struct_fields_for_literal(ctx, fields)
    }

    // Compute the total allocation size using struct_size which correctly
    // accounts for tagged unions (16 bytes) and other named types.
    val size: mut i64 = flen * 8
    if struct_fields != none {
        size = struct_size(ctx, struct_fields)
    } elif expected_ty != none {
        val expected_size: i64 = cg_alloc_size_for_type(ctx, expected_ty)
        if expected_size > size {
            size = expected_size
        }
    }
    if flen < 1 && size < 8 {
        size = 8
    }

    val tmp: i64 = fresh_tmp(ctx)
    cg_alloc_aggregate_temp(ctx, tmp, size)
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields, fi as usize)
        if f_opt is some f {
            val fnode: ref parser.Node = f as ref parser.Node
            val fname: ref u8 = parser.node_str_raw(fnode.d0)
            val fexpr_node: ref parser.Node = fnode.d1 as ref parser.Node
            val off: mut i64 = fi * 8
            val fty_node: mut ref parser.Node = none
            if struct_fields != none {
                val real_off: i64 = field_offset(ctx, struct_fields, fname)
                if real_off >= 0 {
                    off = real_off
                }
                val sflen2: i64 = @len(struct_fields as list[ref void]) as i64
                val sfi2: mut i64 = 0
                for {
                    if sfi2 >= sflen2 {
                        break
                    }
                    val sf2_opt = @get(struct_fields as list[ref void], sfi2 as usize)
                    if sf2_opt is some sf2 {
                        val sfn2: ref parser.Node = sf2 as ref parser.Node
                        val sfname2: ref u8 = parser.node_str_raw(sfn2.d0)
                        if str.raw_cmp(sfname2, fname) == 0 {
                            fty_node = sfn2.d2 as ref parser.Node
                            sfi2 = sflen2 // break
                        }
                    }
                    sfi2++
                }
            }
            val is_fa: mut bool = false
            if fty_node != none {
                if fty_node.kind == parser.TY_FIXED_ARR {
                    is_fa = true
                }
            }
            if is_fa {
                val fa_size: i64 = type_size(fty_node)
                val off_tmp2: i64 = fresh_tmp(ctx)
                val fbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(fbuf2, 256, "    %%t{lld} =l add %%t{lld}, {lld}\n", {off_tmp2, tmp, off})
                emit(
                    ctx,
                    fbuf2
                )
                val is_zero: bool = fexpr_node.kind == parser.NK_INT_LIT && str.raw_cmp(
                    parser.int_lit_text_raw(fexpr_node),
                    c"0"
                ) == 0
                if is_zero {
                    val fbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        fbuf3,
                        128,
                        "    call $memset(l %%t{lld}, w 0, l {lld})\n",
                        {off_tmp2, fa_size}
                    )
                    emit(ctx, fbuf3)
                } else {
                    val fval2: ref u8 = gen_expr_expected(ctx, fexpr_node, fty_node)
                    val fbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        fbuf3,
                        128,
                        "    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                        {off_tmp2, fval2, fa_size}
                    )
                    emit(ctx, fbuf3)
                }
            } elif cg_type_needs_aggregate_copy(ctx, fty_node) {
                val agg_size: i64 = cg_alloc_size_for_type(ctx, fty_node)
                val off_tmp2: i64 = fresh_tmp(ctx)
                val fbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(fbuf2, 256, "    %%t{lld} =l add %%t{lld}, {lld}\n", {off_tmp2, tmp, off})
                emit(ctx, fbuf2)
                if cg_expr_is_zero_init_like(fexpr_node) {
                    val fbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        fbuf3,
                        128,
                        "    call $memset(l %%t{lld}, w 0, l {lld})\n",
                        {off_tmp2, agg_size}
                    )
                    emit(ctx, fbuf3)
                } else {
                    val fval2: ref u8 = gen_expr_expected(ctx, fexpr_node, fty_node)
                    val fbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        fbuf3,
                        128,
                        "    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                        {off_tmp2, fval2, agg_size}
                    )
                    emit(ctx, fbuf3)
                }
            } else {
                val store_op: ref u8 = field_store_instr_for_struct(ctx, struct_fields, fty_node)
                val fval: ref u8 = cg_gen_expr_for_store(ctx, fexpr_node, fty_node, store_op)
                val fbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                val off_tmp: i64 = fresh_tmp(ctx)

                if off == 0 {
                    @snprintf(fbuf, 128, "    {s} {s}, %%t{lld}\n", {store_op, fval, tmp})
                } else {
                    @snprintf(fbuf, 128, "    %%t{lld} =l add %%t{lld}, {lld}\n    {s} {s}, %%t{lld}\n",
                        {off_tmp, tmp, off, store_op, fval, off_tmp})
                }
                emit(ctx, fbuf)
            }
        }
        fi++
    }
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {tmp})
    return res
}

fn gen_try(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    // expr? — if tag==0 (ok), unwrap value; if tag==1 (err), return result as-is
    val inner_node: ref parser.Node = expr.d0 as ref parser.Node
    val inner: ref u8 = gen_expr(ctx, inner_node)
    val tag_tmp: i64 = fresh_tmp(ctx)
    val ok_lbl: i64 = fresh_lbl(ctx)
    val err_lbl: i64 = fresh_lbl(ctx)
    val is_ok: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(buf, 256,
        "    %%t{lld} =l loadl {s}\n    %%t{lld} =w ceql %%t{lld}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
        {tag_tmp, inner, is_ok, tag_tmp, is_ok, ok_lbl, err_lbl, err_lbl})
    emit(ctx, buf) // err branch: propagate the result
    if ctx.current_fn_ret_unboxed {
        val rbuf0: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(rbuf0, 128, "    call $memcpy(l %%__ret, l {s}, l {lld})\n    ret %%__ret\n@lbl{lld}\n",
            {inner, ctx.current_fn_ret_layout_size, ok_lbl})
        emit(ctx, rbuf0)
    } else {
        val rbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(rbuf, 64, "    ret {s}\n@lbl{lld}\n", {inner, ok_lbl})
        emit(ctx, rbuf)
    }
    // ok branch: load the payload
    if true {
        val res_ann: ref u8 = infer_type_annotation(ctx, inner_node)
        val ok_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        val err_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        parse_result_types(res_ann, ok_buf, err_buf)
        val payload_ty: ref parser.Node = cg_named_ty_from_ann(ctx, ok_buf)
        return cg_emit_load_typed(ctx, inner, 8, payload_ty)
    }
    val off_tmp: i64 = fresh_tmp(ctx)
    val val_tmp: i64 = fresh_tmp(ctx)
    val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(vbuf, 128, "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n",
        {off_tmp, inner, val_tmp, off_tmp})
    emit(ctx, vbuf)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(res, 16, "%%t{lld}", {val_tmp})
    return res
}

fn stmt_terminated(ctx: mut ref CgCtx, stmt: ref parser.Node) bool = trust {
    if stmt == none {
        return false
    }
    val k: i64 = stmt.kind
    if k == parser.NK_RETURN {
        return true
    }
    if k == parser.NK_BREAK {
        return true
    }
    if k == parser.NK_CONTINUE {
        return true
    }
    if k == parser.NK_WHEN_STMT {
        return when_stmt_terminated(ctx, stmt)
    }
    return false
}

/// Returns true if the effective last statement in a list is a terminator.
fn stmts_terminated(ctx: mut ref CgCtx, stmts: ref parser.Node) bool = trust {
    if stmts == none {
        return false
    }
    val len: i64 = @len(stmts) as i64
    if len == 0 {
        return false
    }
    val last_opt = @get(stmts, (len - 1) as usize)
    if last_opt is some last {
        val s: ref parser.Node = last as ref parser.Node
        if s.kind == parser.NK_GENERIC_WHEN {
            val start: mut i64 = len - 1
            for {
                if start <= 0 {
                    break
                }
                val prev_opt = @get(stmts, (start - 1) as usize)
                if prev_opt is some prev {
                    if ((prev as ref parser.Node).kind != parser.NK_GENERIC_WHEN) {
                        break
                    }
                    start--
                } else {
                    break
                }
            }
            val gi: mut i64 = start
            for {
                if gi >= len {
                    break
                }
                val g_opt = @get(stmts, gi as usize)
                if g_opt is some g {
                    val gnode: ref parser.Node = g as ref parser.Node
                    if gnode.kind != parser.NK_GENERIC_WHEN {
                        break
                    }
                    if gwhen_matches_gsubst(ctx, gnode) {
                        return stmts_terminated(ctx, gnode.d1 as ref parser.Node)
                    }
                } else {
                    break
                }
                gi++
            }
            return false
        }
        return stmt_terminated(ctx, s)
    } else {
        return false
    }
}

/// Returns true if the active branch of a NK_WHEN_STMT is terminated.
fn when_stmt_terminated(ctx: mut ref CgCtx, stmt: ref parser.Node) bool = trust {
    val plat: ref u8 = parser.node_str_raw(stmt.d0)
    if cg_platform_matches(ctx, plat) {
        return stmts_terminated(ctx, stmt.d1 as ref parser.Node)
    }
    val or_when_branches: ref void = stmt.d2 as ref void
    if or_when_branches != none {
        for ow_node in or_when_branches as list[ref parser.Node] {
            val ow_plat: ref u8 = parser.node_str_raw(ow_node.d0)
            if cg_platform_matches(ctx, ow_plat) {
                return stmts_terminated(ctx, ow_node.d1 as ref parser.Node)
            }
        }
    }
    val otherwise_stmts: ref void = stmt.d3 as ref void
    if otherwise_stmts != none {
        return stmts_terminated(ctx, stmt.d3 as ref parser.Node)
    }
    return false
}

fn gen_stmts(ctx: mut ref CgCtx, stmts: ref parser.Node) void = trust {
    if stmts == none {
        return
    }
    val len: i64 = @len(stmts) as i64
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val s_opt = @get(stmts, i as usize)
        if s_opt is some s {
            val snode: ref parser.Node = s as ref parser.Node
            if snode.kind == parser.NK_GENERIC_WHEN {
                val matched: mut bool = false
                val matched_terminated: mut bool = false
                val j: mut i64 = i
                for {
                    if j >= len {
                        break
                    }
                    val s_opt2 = @get(stmts, j as usize)
                    if s_opt2 is some s2 {
                        val sn2: ref parser.Node = s2 as ref parser.Node
                        if sn2.kind != parser.NK_GENERIC_WHEN {
                            break
                        }
                        if !matched && gwhen_matches_gsubst(ctx, sn2) {
                            gen_stmts(ctx, sn2.d1 as ref parser.Node)
                            matched = true
                            matched_terminated = stmts_terminated(ctx, sn2.d1 as ref parser.Node)
                        }
                    } else {
                        break
                    }
                    j++
                }
                if matched_terminated {
                    break
                }
                i = j
                continue
            } else {
                gen_stmt(ctx, snode)
                if snode.kind == parser.NK_WHEN_STMT {
                    if when_stmt_terminated(ctx, snode) {
                        break
                    }
                }
            }
        }
        i++
    }
}

/// True when a `val` initializer produces an aggregate copy that is owned by
/// a temporary and must be moved into a heap box.
fn cg_val_init_needs_box(ctx: mut ref CgCtx, expr: ref parser.Node) bool = trust {
    val e0: mut ref parser.Node = expr
    for {
        if e0 == none {
            break
        }
        if e0.kind == parser.NK_TRUST || e0.kind == parser.NK_CAST {
            e0 = e0.d0 as ref parser.Node
        } else {
            break
        }
    }
    if e0 == none {
        return false
    }
    if e0.kind == parser.NK_STRUCT_LIT || e0.kind == parser.NK_ZERO_INIT {
        return true
    }
    if e0.kind == parser.NK_TRY {
        val ann: ref u8 = infer_type_annotation(ctx, e0)
        if str.raw_cmp(ann, c"") != 0 {
            val ty: ref parser.Node = cg_named_ty_from_ann(ctx, ann)
            return cg_wrap_payload_is_aggregate(ctx, ty)
        }
    }
    return false
}

fn gen_stmt(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    if stmt == none {
        return
    }
    val k: i64 = stmt.kind

    if k == parser.NK_VAL {
        val name: ref u8 = parser.node_str_raw(stmt.d0)
        val mutable: i64 = stmt.d1
        val raw_ty_node: ref parser.Node = stmt.d2 as ref parser.Node
        val ty_node: ref parser.Node = cg_concrete_ty(ctx, raw_ty_node)
        val expr: ref parser.Node = stmt.d3 as ref parser.Node
        val val_tmp: mut ref u8 = c"0"
        val use_fixed_arr_lit: mut bool = false
        if ty_node != none {
            if ty_node.kind == parser.TY_FIXED_ARR {
                if expr != none {
                    if expr.kind == parser.NK_LIST_LIT || expr.kind == parser.NK_ZERO_INIT {
                        use_fixed_arr_lit = true
                    }
                }
            }
        }
        if use_fixed_arr_lit {
            val_tmp = gen_fixed_arr_lit(ctx, expr, ty_node)
        } else {
            val_tmp = gen_expr_expected(ctx, expr, ty_node)
        }

        if ty_node != none && expr != none {
            val decl_qbe_type: ref u8 = qbe_type_of(ty_node)
            val old_expected_decl: ref parser.Node = ctx.expected_ty as ref parser.Node
            ctx.expected_ty = ty_node
            val expr_qbe_type_val: ref u8 = expr_qbe_type(ctx, expr)
            ctx.expected_ty = old_expected_decl
            if !(str.raw_cmp(
                    expr_qbe_type_val,
                    c"w"
                ) == 0 && str.raw_cmp(decl_qbe_type, c"l") == 0 && is_ref_type(ty_node)) {
                val_tmp = cg_coerce_qtype(ctx, val_tmp, expr_qbe_type_val, decl_qbe_type)
            }
        }

        if ty_node != none {
            val narrow_ann: ref u8 = type_expr_to_annotation(ctx, ty_node)
            val_tmp = cg_narrow_int_for_ann(ctx, val_tmp, narrow_ann)
        }

        if ty_node != none {
            // Preserve the full annotation (including ref/mut wrappers) so that
            // later inference and variadic argument promotion see the real type.
            val local_ann: ref u8 = type_expr_to_annotation(ctx, ty_node)
            if str.raw_cmp(local_ann, c"") != 0 {
                cg_register_local_type(ctx, name, local_ann)
            }
            if is_ref_type(ty_node) || cg_ann_is_indirect_value(ctx, local_ann) {
                cg_register_local_ref_type(ctx, name)
            }
        } elif expr != none && expr.kind == parser.NK_CALL {
            val callee: ref parser.Node = parser.call_callee(expr)
            val callee_name: ref u8 = resolve_callee_name(ctx, callee)
            val ret_expr: mut ref parser.Node = cg_infer_call_ret_ty(ctx, expr)
            if ret_expr == none &&
            callee != none &&
            callee_name != none &&
            str.raw_cmp(callee_name, c"unknown") != 0 {
                ret_expr = cg_lookup_fn_ret_type_expr(ctx, callee_name)
            }
            if ret_expr != none {
                val ret_ann: ref u8 = type_expr_to_annotation(ctx, ret_expr)
                if str.raw_cmp(ret_ann, c"") != 0 {
                    val type_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (str.len_raw(ret_ann) + 1) as usize
                    ) as ref u8
                    @memcpy(type_copy, ret_ann, str.len_raw(ret_ann) + 1)
                    cg_register_local_type(ctx, name, type_copy)
                    if cg_ann_is_indirect_value(ctx, ret_ann) {
                        cg_register_local_ref_type(ctx, name)
                    }
                }
            }
        } elif expr != none {
            val inferred: ref u8 = infer_type_annotation(ctx, expr)
            if str.raw_cmp(inferred, c"") != 0 {
                val type_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (str.len_raw(inferred) + 1) as usize
                ) as ref u8
                @memcpy(type_copy, inferred, str.len_raw(inferred) + 1)
                cg_register_local_type(ctx, name, type_copy)
                if cg_ann_is_indirect_value(ctx, inferred) {
                    cg_register_local_ref_type(ctx, name)
                }
            }
        }

        if mutable != 0 {
            val named_agg_name: ref u8 = unwrap_type_name(ty_node)
            val named_agg_fields: ref void = cg_lookup_struct(ctx, named_agg_name)
            val named_agg_union: ref void = cg_lookup_union_suffix(ctx, named_agg_name)
            val is_named_aggregate: bool = ty_node != none &&
            str.raw_cmp(named_agg_name, c"") != 0 &&
            !is_ref_type(ty_node) &&
            (named_agg_fields != none || named_agg_union != none)
            if is_named_aggregate {
                val agg_size: i64 = cg_alloc_size_for_type(ctx, ty_node)
                val agg_ptr: i64 = fresh_tmp(ctx)
                val agg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(agg_buf, 256, "    %%t{lld} =l call $malloc(l {lld})\n    call $memset(l %%t{lld}, w 0, l {lld})\n",
                    {agg_ptr, agg_size, agg_ptr, agg_size})
                emit(ctx, agg_buf)
                val zero_named_init: mut bool = false
                if expr != none {
                    if expr.kind == parser.NK_ZERO_INIT {
                        zero_named_init = true
                    } elif expr.kind == parser.NK_INT_LIT {
                        zero_named_init = str.raw_cmp(parser.int_lit_text_raw(expr), c"0") == 0
                    } elif expr.kind == parser.NK_CAST {
                        val cast_inner: ref parser.Node = expr.d0 as ref parser.Node
                        if cast_inner != none && cast_inner.kind == parser.NK_INT_LIT {
                            zero_named_init = str.raw_cmp(
                                parser.int_lit_text_raw(cast_inner),
                                c"0"
                            ) == 0
                        }
                    }
                }

                if !zero_named_init {
                    val copy_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        copy_buf,
                        128,
                        "    call $memcpy(l %%t{lld}, l {s}, l {lld})\n",
                        {agg_ptr, val_tmp, agg_size}
                    )
                    emit(ctx, copy_buf)
                }

                val agg_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(agg_res, 16, "%%t{lld}", {agg_ptr})
                val_tmp = agg_res
            }

            val qbe_tmp: i64 = fresh_tmp(ctx)
            val qbe_name: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(qbe_name, 32, "{lld}", {qbe_tmp})

            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val store_op: mut ref u8 = c"storel"
            val is_ref: bool = ty_node != none && is_ref_type(ty_node)

            if !is_ref {
                val ltype2: ref u8 = cg_local_type(ctx, name)
                if str.raw_cmp(ltype2, c"f64") == 0 {
                    store_op = c"stored"
                } elif str.raw_cmp(ltype2, c"f32") == 0 {
                    store_op = c"stores"
                } elif is_word_type_name(ltype2) {
                    store_op = c"storew"
                }
            }

            @snprintf(
                buf,
                256,
                "    %%t{lld} =l alloc8 8\n    {s} {s}, %%t{lld}\n",
                {qbe_tmp, store_op, val_tmp, qbe_tmp}
            )
            emit(ctx, buf)
            cg_register_local_var(ctx, name, qbe_name)
            cg_mark_as_slot(ctx, name)
        } else {
            cg_unmark_slot(ctx, name)
            val imm_ty_node: mut ref parser.Node = ty_node
            if imm_ty_node == none && expr != none {
                val inferred_ann: ref u8 = infer_type_annotation(ctx, expr)
                if str.raw_cmp(inferred_ann, c"") != 0 {
                    imm_ty_node = cg_parse_type_annotation(ctx, inferred_ann)
                }
            }
            val imm_agg_name: ref u8 = unwrap_type_name(imm_ty_node)
            val imm_agg_fields: ref void = cg_lookup_struct(ctx, imm_agg_name)
            val imm_agg_union: ref void = cg_lookup_union_suffix(ctx, imm_agg_name)
            val imm_is_named_aggregate: bool = imm_ty_node != none
            && str.raw_cmp(imm_agg_name, c"") != 0
            && !is_ref_type(imm_ty_node)
            && (imm_agg_fields != none || imm_agg_union != none)
            val imm_should_box: bool = cg_val_init_needs_box(ctx, expr)
            if imm_is_named_aggregate && imm_should_box {
                val imm_agg_size: i64 = cg_alloc_size_for_type(ctx, imm_ty_node)
                val imm_agg_ptr: i64 = fresh_tmp(ctx)
                val imm_res_ptr: i64 = fresh_tmp(ctx)
                val imm_cond: i64 = fresh_tmp(ctx)
                val imm_box_lbl: i64 = fresh_lbl(ctx)
                val imm_done_lbl: i64 = fresh_lbl(ctx)
                val imm_agg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    1024 as usize
                ) as ref u8
                @snprintf(imm_agg_buf, 1024,
                    "    %%t{lld} =l copy 0\n    %%t{lld} =w cnel {s}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n    %%t{lld} =l call $malloc(l {lld})\n    call $memset(l %%t{lld}, w 0, l {lld})\n    call $memcpy(l %%t{lld}, l {s}, l {lld})\n    %%t{lld} =l copy %%t{lld}\n@lbl{lld}\n",
                    {
                        imm_res_ptr,
                        imm_cond,
                        val_tmp,
                        imm_cond,
                        imm_box_lbl,
                        imm_done_lbl,
                        imm_box_lbl,
                        imm_agg_ptr,
                        imm_agg_size,
                        imm_agg_ptr,
                        imm_agg_size,
                        imm_agg_ptr,
                        val_tmp,
                        imm_agg_size,
                        imm_res_ptr,
                        imm_agg_ptr,
                        imm_done_lbl
                    })
                emit(ctx, imm_agg_buf)
                val imm_agg_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(imm_agg_res, 16, "%%t{lld}", {imm_res_ptr})
                val_tmp = imm_agg_res
            }
            val c0: u8 = @load8(val_tmp) as u8
            if c0 == 37 || c0 == 36 {
                val qbe_val: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (str.len_raw(val_tmp) + 1) as usize
                ) as ref u8
                @memcpy(qbe_val, val_tmp, str.len_raw(val_tmp) + 1)
                cg_register_local_var(ctx, name, qbe_val)
            } else {
                val copy_tmp: i64 = fresh_tmp(ctx)
                val copy_qt: mut ref u8 = c"l"
                if ty_node != none {
                    copy_qt = qbe_type_of(ty_node)
                } elif expr != none {
                    copy_qt = expr_qbe_type(ctx, expr)
                }
                val buf_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(
                    buf_copy,
                    128,
                    "    %%t{lld} ={s} copy {s}\n",
                    {copy_tmp, copy_qt, val_tmp}
                )
                emit(
                    ctx,
                    buf_copy
                )
                val qbe_val2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(qbe_val2, 32, "%%t{lld}", {copy_tmp})
                cg_register_local_var(ctx, name, qbe_val2)
            }
        }
        return
    }

    if k == parser.NK_ASSIGN {
        val target: ref parser.Node = stmt.d0 as ref parser.Node
        val value: ref parser.Node = stmt.d1 as ref parser.Node
        val tk: i64 = target.kind as i64
        if tk == parser.NK_IDENT {
            val tname: ref u8 = parser.node_str_raw(target.d0)
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, tname)
            val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            val store_op2: mut ref u8 = c"storel"
            val is_ref2: bool = cg_is_local_ref_type(ctx, tname)
            val dst_qtype2: mut ref u8 = c"l"
            if !is_ref2 {
                val ltype3_pre: ref u8 = cg_local_type(ctx, tname)
                dst_qtype2 = cg_ann_qtype(ltype3_pre)
            }
            val val_tmp2_raw: ref u8 = gen_expr_with_type(ctx, value, dst_qtype2)
            val val_qtype2: mut ref u8 = expr_qbe_type(ctx, value)
            if str.raw_cmp(dst_qtype2, c"") != 0 {
                val_qtype2 = dst_qtype2
            }
            val val_tmp2: mut ref u8 = val_tmp2_raw

            if !is_ref2 {
                val ltype3: ref u8 = cg_local_type(ctx, tname)
                if str.raw_cmp(ltype3, c"f64") == 0 {
                    store_op2 = c"stored"
                } elif str.raw_cmp(ltype3, c"f32") == 0 {
                    store_op2 = c"stores"
                } elif is_word_type_name(ltype3) {
                    store_op2 = c"storew"
                }
                if str.raw_cmp(dst_qtype2, c"") != 0 {
                    val_tmp2 = cg_coerce_qtype(ctx, val_tmp2, val_qtype2, dst_qtype2)
                }
                val_tmp2 = cg_narrow_int_for_ann(ctx, val_tmp2, ltype3)
            }

            if str.raw_cmp(qbe_var, c"") != 0 {
                val qbe_store_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
                @snprintf(buf2, 128, "    {s} {s}, {s}\n", {store_op2, val_tmp2, qbe_store_ref})
            } else {
                @snprintf(buf2, 128, "    {s} {s}, %%{s}\n", {store_op2, val_tmp2, tname})
            }
            emit(ctx, buf2)
        } elif tk == parser.NK_FIELD {
            val val_tmp2_raw: ref u8 = gen_expr(ctx, value)
            val val_qtype2: ref u8 = expr_qbe_type(ctx, value)
            gen_store_field_value(ctx, target, val_tmp2_raw, val_qtype2)
        } elif tk == parser.NK_DEREF {
            val inner_target4: ref parser.Node = target.d0 as ref parser.Node
            val ptr: ref u8 = gen_expr(ctx, inner_target4)
            if value.kind == parser.NK_ARGS_PACK || value.kind == parser.NK_STRUCT_LIT {
                val target_ann4: ref u8 = infer_type_annotation(ctx, inner_target4)
                val lookup_ann4: ref u8 = cg_ann_deref(target_ann4)
                val struct_fields4: ref void = cg_lookup_struct(ctx, lookup_ann4)
                if struct_fields4 != none {
                    val ptr_tmp4: i64 = fresh_tmp(ctx)
                    val ptr_buf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(ptr_buf4, 64, "    %%t{lld} =l copy {s}\n", {ptr_tmp4, ptr})
                    emit(
                        ctx,
                        ptr_buf4
                    )
                    gen_struct_lit_inline(ctx, value, ptr_tmp4, 0, struct_fields4)
                } else {
                    val val_tmp2_raw: ref u8 = gen_expr(ctx, value)
                    val buf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(buf4, 128, "    storel {s}, {s}\n", {val_tmp2_raw, ptr})
                    emit(ctx, buf4)
                }
            } else {
                val pointee4: ref u8 = cg_ann_deref(infer_type_annotation(ctx, inner_target4))
                val store_op4: ref u8 = scalar_store_instr_for_name(pointee4)
                val value_qtype4: ref u8 = scalar_store_qtype_for_name(pointee4)
                val val_tmp2_raw: ref u8 = gen_expr_with_type(ctx, value, value_qtype4)
                val buf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(buf4, 128, "    {s} {s}, {s}\n", {store_op4, val_tmp2_raw, ptr})
                emit(ctx, buf4)
            }
        }
        return
    }

    if k == parser.NK_RETURN {
        val expr2: ref parser.Node = stmt.d0 as ref parser.Node
        if expr2 == none {
            cg_emit_invariant_checks(ctx)
            cg_emit_defers(ctx)
            emitln(ctx, c"    ret 0")
        } else {
            val rv0_raw: ref u8 = gen_expr_expected(
                ctx,
                expr2,
                ctx.current_fn_ret_ty as ref parser.Node
            )
            val rv0: ref u8 = cg_materialize_stack_aggregate(
                ctx,
                rv0_raw,
                ctx.current_fn_ret_ty as ref parser.Node
            )
            if str.raw_cmp(ctx.fn_name, c"main") == 0 && ctx.current_fn_ret_ty != none
            && (ctx.current_fn_ret_ty as ref parser.Node).kind == parser.TY_RESULT {
                val tag_m: i64 = fresh_tmp(ctx)
                val err_m: i64 = fresh_tmp(ctx)
                val mb: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(mb, 128, "    %%t{lld} =l loadl {s}\n    %%t{lld} =w cnel %%t{lld}, 0\n",
                    {tag_m, rv0, err_m, tag_m})
                emit(ctx, mb)
                cg_emit_invariant_checks(ctx)
                cg_emit_defers(ctx)
                val rb: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(rb, 64, "    ret %%t{lld}\n", {err_m})
                emit(ctx, rb)
                return
            }
            val rv_qt: ref u8 = expr_qbe_type(ctx, expr2)
            val rv: mut ref u8 = rv0
            if str.raw_cmp(rv_qt, ctx.current_fn_ret_qtype) != 0 {
                if str.raw_cmp(rv_qt, c"w") == 0 && str.raw_cmp(ctx.current_fn_ret_qtype, c"l") == 0 {
                    val ann: ref u8 = infer_type_annotation(ctx, expr2)
                    val instr: mut ref u8 = c"extsw"
                    if str.raw_cmp(ann, c"u8") == 0
                    || str.raw_cmp(ann, c"u16") == 0
                    || str.raw_cmp(ann, c"u32") == 0
                    || str.raw_cmp(ann, c"bool") == 0
                    || str.raw_cmp(ann, c"u8") == 0 {
                        instr = c"extuw"
                    }
                    val promoted_tmp: i64 = fresh_tmp(ctx)
                    val promoted_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        promoted_buf,
                        128,
                        "    %%t{lld} =l {s} {s}\n",
                        {promoted_tmp, instr, rv}
                    )
                    emit(
                        ctx,
                        promoted_buf
                    )
                    val promoted_val: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        16 as usize
                    ) as ref u8
                    @snprintf(promoted_val, 16, "%%t{lld}", {promoted_tmp})
                    rv = promoted_val
                } else {
                    // f32 values are promoted to double by arithmetic and
                    // comparisons; narrow them back at the return boundary.
                    rv = cg_coerce_qtype(ctx, rv, rv_qt, ctx.current_fn_ret_qtype)
                }
            }
            cg_emit_invariant_checks(ctx)
            cg_emit_defers(ctx)

            // Aggregate and unboxed returns are copied into the caller's buffer.
            if str.raw_cmp(ctx.current_fn_ret_union, c"") != 0 || ctx.current_fn_ret_unboxed {
                val sz: mut i64 = 16
                if str.raw_cmp(ctx.current_fn_ret_union, c"") != 0 {
                    val uv: ref void = cg_lookup_union_suffix(ctx, ctx.current_fn_ret_union)
                    if uv != none {
                        sz = cg_union_size(ctx, uv)
                    }
                }
                if ctx.current_fn_ret_unboxed {
                    sz = ctx.current_fn_ret_layout_size
                }
                val buf5: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(
                    buf5,
                    128,
                    "    call $memcpy(l %%__ret, l {s}, l {lld})\n    ret %%__ret\n",
                    {rv, sz}
                )
                emit(ctx, buf5)
            } else {
                val buf5: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                @snprintf(buf5, 64, "    ret {s}\n", {rv})
                emit(ctx, buf5)
            }
        }
        return
    }

    if k == parser.NK_EXPR_STMT {
        gen_expr(ctx, stmt.d0 as ref parser.Node)
        return
    }

    if k == parser.NK_IF {
        gen_if_stmt(ctx, stmt)
        return
    }

    if k == parser.NK_GUARD {
        val gcond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
        val pass_lbl: i64 = fresh_lbl(ctx)
        val fail_lbl: i64 = fresh_lbl(ctx)
        val gbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(
            gbuf,
            128,
            "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {gcond, pass_lbl, fail_lbl, fail_lbl}
        )
        emit(ctx, gbuf)
        gen_stmts(ctx, stmt.d1 as ref parser.Node)
        val glbl_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(glbl_buf, 64, "@lbl{lld}\n", {pass_lbl})
        emit(ctx, glbl_buf)
        return
    }

    if k == parser.NK_FOR {
        gen_for_stmt(ctx, stmt)
        return
    }

    if k == parser.NK_FORIN {
        gen_forin_stmt(ctx, stmt)
        return
    }

    if k == parser.NK_BREAK {
        val blbl: i64 = cg_break_lbl(ctx)
        val bbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(bbuf, 64, "    jmp @lbl{lld}\n", {blbl})
        emit(ctx, bbuf)
        return
    }

    if k == parser.NK_CONTINUE {
        val clbl: i64 = cg_cont_lbl(ctx)
        val cbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(cbuf, 64, "    jmp @lbl{lld}\n", {clbl})
        emit(ctx, cbuf)
        return
    }

    if k == parser.NK_TRUST_BLOCK {
        gen_stmts(ctx, stmt.d0 as ref parser.Node)
        return
    }

    if k == parser.NK_DEFER {
        cg_defer_push(ctx, stmt.d0 as ref parser.Node)
        return
    }

    if k == parser.NK_ASSERT {
        val cond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
        val ok_lbl: i64 = fresh_lbl(ctx)
        val fail_lbl: i64 = fresh_lbl(ctx)
        val buf6: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(
            buf6,
            128,
            "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {cond, ok_lbl, fail_lbl, fail_lbl}
        )
        emit(ctx, buf6)
        val node: ref parser.Node = stmt as ref parser.Node
        val msg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(msg_buf, 512, "spectre: assertion failed at line {lld}\n", {node.line})
        val msg_idx: i64 = intern_string_raw(ctx, msg_buf)
        val msg_tmp: i64 = fresh_tmp(ctx)
        val abuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(abuf, 256,
            "    %%t{lld} =l copy $__str{lld}\n    call $dprintf(w 2, l %%t{lld})\n    call $fflush(l 0)\n    call $exit(l 1)\n    hlt\n@lbl{lld}\n",
            {msg_tmp, msg_idx, msg_tmp, ok_lbl})
        emit(ctx, abuf)
        return
    }

    if k == parser.NK_PRE || k == parser.NK_GUARDED_PRE ||
    k == parser.NK_POST || k == parser.NK_GUARDED_POST {
        if ctx.release_mode {
            if k == parser.NK_PRE || k == parser.NK_POST {
                return
            }
        }
        val is_pre: bool = k == parser.NK_PRE || k == parser.NK_GUARDED_PRE
        val kind_str: mut ref u8 = c"precondition"
        if !is_pre {
            kind_str = c"postcondition"
        }
        val fn_name: ref u8 = cg_fn_name(ctx)
        val clist: ref void = stmt.d0 as ref void
        if clist != none {
            val clen: i64 = @len(clist) as i64
            val ci: mut i64 = 0
            for {
                if ci >= clen {
                    break
                }
                val c_opt = @get(clist, ci as usize)
                if c_opt is some c {
                    val cnode: ref parser.Node = c as ref parser.Node
                    val label: ref u8 = parser.node_str_raw(cnode.d0)
                    val cexpr: ref parser.Node = cnode.d1 as ref parser.Node
                    val cv: ref u8 = gen_expr(ctx, cexpr)
                    val ok_lbl: i64 = fresh_lbl(ctx)
                    val fail_lbl: i64 = fresh_lbl(ctx)
                    val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(jbuf, 128, "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                        {cv, ok_lbl, fail_lbl, fail_lbl})
                    emit(
                        ctx,
                        jbuf
                    )
                    val msg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    if label != none {
                        @snprintf(msg_buf, 512, "spectre: {s} '{s}' violated in function '{s}'\n",
                            {kind_str, label, fn_name})
                    } else {
                        @snprintf(msg_buf, 512, "spectre: {s} violated in function '{s}'\n",
                            {kind_str, fn_name})
                    }
                    val msg_idx: i64 = intern_string_raw(ctx, msg_buf)
                    val msg_tmp: i64 = fresh_tmp(ctx)
                    val call_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    @snprintf(call_buf, 256,
                        "    %%t{lld} =l copy $__str{lld}\n    call $dprintf(w 2, l %%t{lld})\n    call $fflush(l 0)\n    call $exit(l 1)\n    hlt\n@lbl{lld}\n",
                        {msg_tmp, msg_idx, msg_tmp, ok_lbl})
                    emit(ctx, call_buf)
                }
                ci++
            }
        }
        return
    }

    if k == parser.NK_MATCH_OPT {
        gen_match_opt(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_RES {
        gen_match_res(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_ENUM {
        gen_match_enum(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_VALUE {
        gen_match_value(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_STR {
        gen_match_str(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_UNION {
        // union match: emit tag-based dispatch
        gen_match_union(ctx, stmt)
        return
    }

    if k == parser.NK_MATCH_TAGGED_UNION {
        gen_match_tagged_union(ctx, stmt)
        return
    }

    if k == parser.NK_GENERIC_WHEN {
        return
    }

    if k == parser.NK_WHEN_STMT {
        val plat: ref u8 = parser.node_str_raw(stmt.d0)
        if cg_platform_matches(ctx, plat) {
            gen_stmts(ctx, stmt.d1 as ref parser.Node)
        } else {
            val or_when_branches: ref void = stmt.d2 as ref void
            val matched: mut bool = false
            if or_when_branches != none {
                for ow_node in or_when_branches as list[ref parser.Node] {
                    if !matched {
                        val ow_plat: ref u8 = parser.node_str_raw(ow_node.d0)
                        if cg_platform_matches(ctx, ow_plat) {
                            gen_stmts(ctx, ow_node.d1 as ref parser.Node)
                            matched = true
                        }
                    }
                }
            }
            if !matched {
                val otherwise_stmts: ref void = stmt.d3 as ref void
                if otherwise_stmts != none {
                    gen_stmts(ctx, stmt.d3 as ref parser.Node)
                }
            }
        }
        return
    }

    if k == parser.NK_INCREMENT {
        val target2: ref parser.Node = stmt.d0 as ref parser.Node
        if target2.kind == parser.NK_DEREF {
            gen_update_deref_value(ctx, target2, 1)
            return
        }
        if target2.kind == parser.NK_FIELD {
            val curv3: ref u8 = gen_expr(ctx, target2)
            val next_tmp3: i64 = fresh_tmp(ctx)
            val next_buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val target2_qt: ref u8 = expr_qbe_type(ctx, target2)
            if str.raw_cmp(target2_qt, c"w") == 0 {
                @snprintf(next_buf3, 256, "    %%t{lld} =l add {s}, 1\n", {next_tmp3, curv3})
                emit(
                    ctx,
                    next_buf3
                )
                val next_res3: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(next_res3, 16, "%%t{lld}", {next_tmp3})
                gen_store_field_value(ctx, target2, next_res3, c"w")
            } else {
                @snprintf(next_buf3, 256, "    %%t{lld} =l add {s}, 1\n", {next_tmp3, curv3})
                emit(
                    ctx,
                    next_buf3
                )
                val next_res3: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(next_res3, 16, "%%t{lld}", {next_tmp3})
                gen_store_field_value(ctx, target2, next_res3, c"l")
            }
            return
        }
        val tname2: mut ref u8 = none
        if target2.kind == parser.NK_IDENT {
            tname2 = parser.node_str_raw(target2.d0)
        } else {
            tname2 = parser.node_str_raw(stmt.d0)
        }
        if tname2 != none {
            // Look up QBE temporary name for local variables
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, tname2)
            val var_ref: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if str.raw_cmp(qbe_var, c"") != 0 {
                val qbe_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
                @snprintf(var_ref, 64, "{s}", {qbe_ref})
            } else {
                @snprintf(var_ref, 64, "%%{s}", {tname2})
            }

            val cur: i64 = fresh_tmp(ctx)
            val nxt: i64 = fresh_tmp(ctx)
            val buf9: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val ltype_inc: ref u8 = cg_local_type(ctx, tname2)
            if is_word_type_name(ltype_inc) {
                val w_cur: i64 = fresh_tmp(ctx)
                @snprintf(buf9, 256, "    %%t{lld} =w loadw {s}\n    %%t{lld} =l extsw %%t{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storew %%t{lld}, {s}\n",
                    {w_cur, var_ref, cur, w_cur, nxt, cur, nxt, var_ref})
            } else {
                @snprintf(buf9, 256, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, {s}\n",
                    {cur, var_ref, nxt, cur, nxt, var_ref})
            }
            emit(ctx, buf9)
        }
        return
    }

    if k == parser.NK_DECREMENT {
        val target3: ref parser.Node = stmt.d0 as ref parser.Node
        if target3.kind == parser.NK_DEREF {
            gen_update_deref_value(ctx, target3, -1)
            return
        }
        if target3.kind == parser.NK_FIELD {
            val curv4: ref u8 = gen_expr(ctx, target3)
            val next_tmp4: i64 = fresh_tmp(ctx)
            val next_buf4: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val target3_qt: ref u8 = expr_qbe_type(ctx, target3)
            if str.raw_cmp(target3_qt, c"w") == 0 {
                @snprintf(next_buf4, 256, "    %%t{lld} =l sub {s}, 1\n", {next_tmp4, curv4})
                emit(
                    ctx,
                    next_buf4
                )
                val next_res4: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(next_res4, 16, "%%t{lld}", {next_tmp4})
                gen_store_field_value(ctx, target3, next_res4, c"w")
            } else {
                @snprintf(next_buf4, 256, "    %%t{lld} =l sub {s}, 1\n", {next_tmp4, curv4})
                emit(
                    ctx,
                    next_buf4
                )
                val next_res4: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(next_res4, 16, "%%t{lld}", {next_tmp4})
                gen_store_field_value(ctx, target3, next_res4, c"l")
            }
            return
        }
        val tname3: mut ref u8 = none
        if target3.kind == parser.NK_IDENT {
            tname3 = parser.node_str_raw(target3.d0)
        } else {
            tname3 = parser.node_str_raw(stmt.d0)
        }
        if tname3 != none {
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, tname3)
            val var_ref: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if str.raw_cmp(qbe_var, c"") != 0 {
                val qbe_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
                @snprintf(var_ref, 64, "{s}", {qbe_ref})
            } else {
                @snprintf(var_ref, 64, "%%{s}", {tname3})
            }

            val cur2: i64 = fresh_tmp(ctx)
            val nxt2: i64 = fresh_tmp(ctx)
            val buf10: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val ltype_dec: ref u8 = cg_local_type(ctx, tname3)
            if is_word_type_name(ltype_dec) {
                val w_cur2: i64 = fresh_tmp(ctx)
                @snprintf(buf10, 256, "    %%t{lld} =w loadw {s}\n    %%t{lld} =l extsw %%t{lld}\n    %%t{lld} =l sub %%t{lld}, 1\n    storew %%t{lld}, {s}\n",
                    {w_cur2, var_ref, cur2, w_cur2, nxt2, cur2, nxt2, var_ref})
            } else {
                @snprintf(buf10, 256, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l sub %%t{lld}, 1\n    storel %%t{lld}, {s}\n",
                    {cur2, var_ref, nxt2, cur2, nxt2, var_ref})
            }
            emit(ctx, buf10)
        }
        return
    }

    if k == parser.NK_ADD_ASSIGN {
        val target4: ref parser.Node = stmt.d0 as ref parser.Node
        val rhs_node: ref parser.Node = stmt.d1 as ref parser.Node
        val rhs: ref u8 = gen_expr(ctx, rhs_node)
        val rhs_qt: ref u8 = expr_qbe_type(ctx, rhs_node)
        if target4.kind == parser.NK_FIELD {
            val curv: ref u8 = gen_expr(ctx, target4)
            val target4_qt: ref u8 = expr_qbe_type(ctx, target4)
            val sum_tmp: i64 = fresh_tmp(ctx)
            val sum_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            if str.raw_cmp(target4_qt, c"s") == 0 || str.raw_cmp(target4_qt, c"d") == 0 {
                val curv_d: ref u8 = cg_coerce_qtype(ctx, curv, target4_qt, c"d")
                val rhs_d: ref u8 = cg_coerce_qtype(ctx, rhs, rhs_qt, c"d")
                @snprintf(sum_buf, 256, "    %%t{lld} =d add {s}, {s}\n", {sum_tmp, curv_d, rhs_d})
            } else {
                @snprintf(sum_buf, 256, "    %%t{lld} =l add {s}, {s}\n", {sum_tmp, curv, rhs})
            }
            emit(
                ctx,
                sum_buf
            )
            val sum_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(sum_res, 16, "%%t{lld}", {sum_tmp})
            if str.raw_cmp(target4_qt, c"s") == 0 || str.raw_cmp(target4_qt, c"d") == 0 {
                gen_store_field_value(ctx, target4, sum_res, c"d")
            } else {
                gen_store_field_value(ctx, target4, sum_res, c"l")
            }
            return
        }
        if target4.kind == parser.NK_DEREF {
            gen_deref_compound_assign(ctx, target4, rhs, rhs_qt, false)
            return
        }
        val tname4: mut ref u8 = none
        if target4.kind == parser.NK_IDENT {
            tname4 = parser.node_str_raw(target4.d0)
        } else {
            tname4 = parser.node_str_raw(stmt.d0)
        }
        if tname4 != none {
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, tname4)
            val var_ref: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if str.raw_cmp(qbe_var, c"") != 0 {
                val qbe_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
                @snprintf(var_ref, 64, "{s}", {qbe_ref})
            } else {
                @snprintf(var_ref, 64, "%%{s}", {tname4})
            }

            val cur3: i64 = fresh_tmp(ctx)
            val nxt3: i64 = fresh_tmp(ctx)
            val buf11: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val ltype_add: ref u8 = cg_local_type(ctx, tname4)
            if str.raw_cmp(ltype_add, c"f32") == 0 || str.raw_cmp(ltype_add, c"f64") == 0 {
                val load_op_add: mut ref u8 = c"loads"
                if str.raw_cmp(ltype_add, c"f64") == 0 {
                    load_op_add = c"loadd"
                }
                val cur_qt_add: ref u8 = cg_ann_qtype(ltype_add)
                val cur_val_add: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                val rhs_d_add: ref u8 = cg_coerce_qtype(ctx, rhs, rhs_qt, c"d")
                @snprintf(cur_val_add, 16, "%%t{lld}", {cur3})
                @snprintf(
                    buf11,
                    256,
                    "    %%t{lld} ={s} {s} {s}\n",
                    {cur3, cur_qt_add, load_op_add, var_ref}
                )
                emit(ctx, buf11)
                val cur_d_add: ref u8 = cg_coerce_qtype(ctx, cur_val_add, cur_qt_add, c"d")
                @snprintf(
                    buf11,
                    256,
                    "    %%t{lld} =d add {s}, {s}\n",
                    {nxt3, cur_d_add, rhs_d_add}
                )
                emit(ctx, buf11)
                if str.raw_cmp(cur_qt_add, c"s") == 0 {
                    val trunc_tmp_add: i64 = fresh_tmp(ctx)
                    @snprintf(
                        buf11,
                        256,
                        "    %%t{lld} =s truncd %%t{lld}\n    stores %%t{lld}, {s}\n",
                        {trunc_tmp_add, nxt3, trunc_tmp_add, var_ref}
                    )
                } else {
                    @snprintf(buf11, 256, "    stored %%t{lld}, {s}\n", {nxt3, var_ref})
                }
            } else {
                @snprintf(buf11, 256, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l add %%t{lld}, {s}\n    storel %%t{lld}, {s}\n",
                    {cur3, var_ref, nxt3, cur3, rhs, nxt3, var_ref})
            }
            emit(ctx, buf11)
        }
        return
    }

    if k == parser.NK_SUB_ASSIGN {
        val target5: ref parser.Node = stmt.d0 as ref parser.Node
        val rhs2_node: ref parser.Node = stmt.d1 as ref parser.Node
        val rhs2: ref u8 = gen_expr(ctx, rhs2_node)
        val rhs2_qt: ref u8 = expr_qbe_type(ctx, rhs2_node)
        if target5.kind == parser.NK_FIELD {
            val curv2: ref u8 = gen_expr(ctx, target5)
            val target5_qt: ref u8 = expr_qbe_type(ctx, target5)
            val diff_tmp: i64 = fresh_tmp(ctx)
            val diff_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            if str.raw_cmp(target5_qt, c"s") == 0 || str.raw_cmp(target5_qt, c"d") == 0 {
                val curv2_d: ref u8 = cg_coerce_qtype(ctx, curv2, target5_qt, c"d")
                val rhs2_d: ref u8 = cg_coerce_qtype(ctx, rhs2, rhs2_qt, c"d")
                @snprintf(
                    diff_buf,
                    256,
                    "    %%t{lld} =d sub {s}, {s}\n",
                    {diff_tmp, curv2_d, rhs2_d}
                )
            } else {
                @snprintf(diff_buf, 256, "    %%t{lld} =l sub {s}, {s}\n", {diff_tmp, curv2, rhs2})
            }
            emit(
                ctx,
                diff_buf
            )
            val diff_res: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(diff_res, 16, "%%t{lld}", {diff_tmp})
            if str.raw_cmp(target5_qt, c"s") == 0 || str.raw_cmp(target5_qt, c"d") == 0 {
                gen_store_field_value(ctx, target5, diff_res, c"d")
            } else {
                gen_store_field_value(ctx, target5, diff_res, c"l")
            }
            return
        }
        if target5.kind == parser.NK_DEREF {
            gen_deref_compound_assign(ctx, target5, rhs2, rhs2_qt, true)
            return
        }
        val tname5: mut ref u8 = none
        if target5.kind == parser.NK_IDENT {
            tname5 = parser.node_str_raw(target5.d0)
        } else {
            tname5 = parser.node_str_raw(stmt.d0)
        }
        if tname5 != none {
            val qbe_var: ref u8 = cg_lookup_local_var(ctx, tname5)
            val var_ref: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if str.raw_cmp(qbe_var, c"") != 0 {
                val qbe_ref: ref u8 = cg_qbe_value_ref(ctx, qbe_var)
                @snprintf(var_ref, 64, "{s}", {qbe_ref})
            } else {
                @snprintf(var_ref, 64, "%%{s}", {tname5})
            }

            val cur4: i64 = fresh_tmp(ctx)
            val nxt4: i64 = fresh_tmp(ctx)
            val buf12: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val ltype_sub: ref u8 = cg_local_type(ctx, tname5)
            if str.raw_cmp(ltype_sub, c"f32") == 0 || str.raw_cmp(ltype_sub, c"f64") == 0 {
                val load_op_sub: mut ref u8 = c"loads"
                if str.raw_cmp(ltype_sub, c"f64") == 0 {
                    load_op_sub = c"loadd"
                }
                val cur_qt_sub: ref u8 = cg_ann_qtype(ltype_sub)
                val cur_val_sub: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                val rhs_d_sub: ref u8 = cg_coerce_qtype(ctx, rhs2, rhs2_qt, c"d")
                @snprintf(cur_val_sub, 16, "%%t{lld}", {cur4})
                @snprintf(
                    buf12,
                    256,
                    "    %%t{lld} ={s} {s} {s}\n",
                    {cur4, cur_qt_sub, load_op_sub, var_ref}
                )
                emit(ctx, buf12)
                val cur_d_sub: ref u8 = cg_coerce_qtype(ctx, cur_val_sub, cur_qt_sub, c"d")
                @snprintf(
                    buf12,
                    256,
                    "    %%t{lld} =d sub {s}, {s}\n",
                    {nxt4, cur_d_sub, rhs_d_sub}
                )
                emit(ctx, buf12)
                if str.raw_cmp(cur_qt_sub, c"s") == 0 {
                    val trunc_tmp_sub: i64 = fresh_tmp(ctx)
                    @snprintf(
                        buf12,
                        256,
                        "    %%t{lld} =s truncd %%t{lld}\n    stores %%t{lld}, {s}\n",
                        {trunc_tmp_sub, nxt4, trunc_tmp_sub, var_ref}
                    )
                } else {
                    @snprintf(buf12, 256, "    stored %%t{lld}, {s}\n", {nxt4, var_ref})
                }
            } else {
                @snprintf(buf12, 256, "    %%t{lld} =l loadl {s}\n    %%t{lld} =l sub %%t{lld}, {s}\n    storel %%t{lld}, {s}\n",
                    {cur4, var_ref, nxt4, cur4, rhs2, nxt4, var_ref})
            }
            emit(ctx, buf12)
        }
        return
    }
}

fn gen_deref_compound_assign(
    ctx: mut ref CgCtx,
    target: ref parser.Node,
    rhs: ref u8,
    rhs_qt: ref u8,
    subtract: bool
) void = trust {
    val ptr: ref u8 = gen_expr(ctx, target.d0 as ref parser.Node)
    val pointee: ref u8 = infer_type_annotation(ctx, target)
    val load_op: ref u8 = scalar_load_instr_for_name(pointee)
    val load_qt: ref u8 = scalar_load_qtype_for_name(pointee)
    val cur_tmp: i64 = fresh_tmp(ctx)
    val cur_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(cur_buf, 128, "    %%t{lld} ={s} {s} {s}\n", {cur_tmp, load_qt, load_op, ptr})
    emit(ctx, cur_buf)
    val cur_val: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(cur_val, 16, "%%t{lld}", {cur_tmp})
    val op: mut ref u8 = c"add"
    if subtract {
        op = c"sub"
    }
    val res_tmp: i64 = fresh_tmp(ctx)
    val res_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    val store_op: ref u8 = scalar_store_instr_for_name(pointee)
    val store_qt: ref u8 = scalar_store_qtype_for_name(pointee)
    val store_val: mut ref u8 = none
    if str.raw_cmp(load_qt, c"s") == 0 || str.raw_cmp(load_qt, c"d") == 0 {
        val cur_d: ref u8 = cg_coerce_qtype(ctx, cur_val, load_qt, c"d")
        val rhs_d: ref u8 = cg_coerce_qtype(ctx, rhs, rhs_qt, c"d")
        @snprintf(res_buf, 128, "    %%t{lld} =d {s} {s}, {s}\n", {res_tmp, op, cur_d, rhs_d})
        emit(ctx, res_buf)
        val res_val: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res_val, 16, "%%t{lld}", {res_tmp})
        store_val = cg_coerce_qtype(ctx, res_val, c"d", store_qt)
    } else {
        val cur_l: ref u8 = cg_coerce_qtype(ctx, cur_val, load_qt, c"l")
        val rhs_l: ref u8 = cg_coerce_qtype(ctx, rhs, rhs_qt, c"l")
        @snprintf(res_buf, 128, "    %%t{lld} =l {s} {s}, {s}\n", {res_tmp, op, cur_l, rhs_l})
        emit(ctx, res_buf)
        val res_val: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
        @snprintf(res_val, 16, "%%t{lld}", {res_tmp})
        store_val = cg_coerce_qtype(ctx, res_val, c"l", store_qt)
    }
    val store_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(store_buf, 128, "    {s} {s}, {s}\n", {store_op, store_val, ptr})
    emit(ctx, store_buf)
}

fn gen_update_deref_value(ctx: mut ref CgCtx, target: ref parser.Node, delta: i64) void = trust {
    val ptr_expr: ref parser.Node = target.d0 as ref parser.Node
    val ptr: ref u8 = gen_expr(ctx, ptr_expr)
    val deref_ann: ref u8 = infer_type_annotation(ctx, target)
    val load_op: ref u8 = scalar_load_instr_for_name(deref_ann)
    val load_qt: ref u8 = scalar_load_qtype_for_name(deref_ann)
    val cur_tmp: i64 = fresh_tmp(ctx)
    val cur_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(cur_buf, 128, "    %%t{lld} ={s} {s} {s}\n", {cur_tmp, load_qt, load_op, ptr})
    emit(ctx, cur_buf)
    val cur_val: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(cur_val, 16, "%%t{lld}", {cur_tmp})
    val cur_l: ref u8 = cg_coerce_qtype(ctx, cur_val, load_qt, c"l")
    val op: mut ref u8 = c"add"
    val amount: mut i64 = delta
    if delta < 0 {
        op = c"sub"
        amount = 0 - delta
    }
    val next_tmp: i64 = fresh_tmp(ctx)
    val next_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(next_buf, 128, "    %%t{lld} =l {s} {s}, {lld}\n", {next_tmp, op, cur_l, amount})
    emit(ctx, next_buf)
    val next_val: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 16 as usize) as ref u8
    @snprintf(next_val, 16, "%%t{lld}", {next_tmp})
    val store_op: ref u8 = scalar_store_instr_for_name(deref_ann)
    val store_qt: ref u8 = scalar_store_qtype_for_name(deref_ann)
    val store_val: ref u8 = cg_coerce_qtype(ctx, next_val, c"l", store_qt)
    val store_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(store_buf, 128, "    {s} {s}, {s}\n", {store_op, store_val, ptr})
    emit(ctx, store_buf)
}

fn block_ends_with_terminator(stmts: ref parser.Node) bool = trust {
    if stmts == none {
        return false
    }
    val len: i64 = @len(stmts) as i64
    if len == 0 {
        return false
    }
    val last_opt = @get(stmts, (len - 1) as usize)
    if last_opt is some last {
        val lk: i64 = (last as ref parser.Node).kind
        return lk == parser.NK_RETURN || lk == parser.NK_BREAK || lk == parser.NK_CONTINUE
    } else {
        return false
    }
}

/// Like block_ends_with_terminator but takes a body wrapper node (d0 = stmts list).
fn body_ends_with_terminator(body_node: ref parser.Node) bool = trust {
    if body_node == none {
        return false
    }
    return block_ends_with_terminator(body_node.d0 as ref parser.Node)
}

fn gen_if_stmt(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val then_lbl: i64 = fresh_lbl(ctx)
    val end_lbl: i64 = fresh_lbl(ctx)
    val has_else: bool = stmt.d3 != 0
    val elif_list: ref void = stmt.d2 as ref void
    val has_elif: bool = elif_list != none && @len(elif_list as list[ref void]) > 0

    // Determine where the main if/false branch jumps.
    // If there are elifs, we need to pre-allocate their condition labels so we
    // can chain them. We collect them first, then emit everything in order.
    //
    // So, the strategy here is: allocate one "next" label per elif plus one for else/end.
    //   next_lbls[i] = label to jump to when elif[i-1] condition is false
    //   next_lbls[0] = first elif cond label (or else_lbl or end_lbl)
    val next_lbls: mut list[i64] = mem.new[i64]()
    val body_lbls: mut list[i64] = mem.new[i64]()

    if has_elif {
        val elen: i64 = @len(elif_list) as i64
        val pi: mut i64 = 0
        for {
            if pi >= elen {
                break
            }
            @append(next_lbls, fresh_lbl(ctx))
            @append(body_lbls, fresh_lbl(ctx))
            pi++
        }
    }

    val else_lbl: i64 = fresh_lbl(ctx)
    val first_false: mut i64 = end_lbl

    if has_elif {
        val fl_opt = @get(next_lbls, 0 as usize)
        if fl_opt is some fl {
            first_false = fl as i64
        }
    } elif has_else {
        first_false = else_lbl
    }

    val cond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(
        buf,
        128,
        "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
        {cond, then_lbl, first_false, then_lbl}
    )
    emit(ctx, buf)
    gen_stmts(ctx, stmt.d1 as ref parser.Node)

    if !block_ends_with_terminator(stmt.d1 as ref parser.Node) {
        val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(buf2, 64, "    jmp @lbl{lld}\n", {end_lbl})
        emit(ctx, buf2)
    }

    if has_elif {
        val elen: i64 = @len(elif_list) as i64
        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            if @get(elif_list, ei as usize) is some ep {
                if @get(next_lbls, ei as usize) is some cl {
                    if @get(body_lbls, ei as usize) is some bl {
                        val cond_lbl: i64 = cl as i64
                        val body_lbl: i64 = bl as i64
                        val false_lbl: mut i64 = end_lbl
                        if ei + 1 < elen {
                            if @get(next_lbls, (ei + 1) as usize) is some nl {
                                false_lbl = nl as i64
                            }
                        } elif has_else {
                            false_lbl = else_lbl
                        }
                        val clbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            32 as usize
                        ) as ref u8
                        @snprintf(clbuf, 32, "@lbl{lld}\n", {cond_lbl})
                        emit(ctx, clbuf)
                        val econd: ref u8 = gen_expr(
                            ctx,
                            (ep as ref parser.Node).d0 as ref parser.Node
                        )
                        val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(ebuf, 128, "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                            {econd, body_lbl, false_lbl, body_lbl})
                        emit(
                            ctx,
                            ebuf
                        )
                        gen_stmts(ctx, (ep as ref parser.Node).d1 as ref parser.Node)
                        if !block_ends_with_terminator((ep as ref parser.Node).d1 as ref parser.Node) {
                            val ejbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                64 as usize
                            ) as ref u8
                            @snprintf(ejbuf, 64, "    jmp @lbl{lld}\n", {end_lbl})
                            emit(ctx, ejbuf)
                        }
                    }
                }
            }
            ei++
        }
    }

    if has_else {
        val ebuf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(ebuf2, 32, "@lbl{lld}\n", {else_lbl})
        emit(ctx, ebuf2)
        gen_stmts(ctx, (stmt.d3 as ref parser.Node).d0 as ref parser.Node)
        if !block_ends_with_terminator((stmt.d3 as ref parser.Node).d0 as ref parser.Node) {
            val ejbuf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(ejbuf3, 64, "    jmp @lbl{lld}\n", {end_lbl})
            emit(ctx, ejbuf3)
        }
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf)
}

fn gen_for_stmt(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val loop_lbl: i64 = fresh_lbl(ctx)
    val body_lbl: i64 = fresh_lbl(ctx)
    val cont_lbl: i64 = fresh_lbl(ctx)
    val break_lbl: i64 = fresh_lbl(ctx)
    val init_name: ref u8 = parser.node_str_raw(stmt.d0)
    val prev_break: i64 = cg_break_lbl(ctx)
    val prev_cont: i64 = cg_cont_lbl(ctx)

    cg_set_break_lbl(ctx, break_lbl)
    cg_set_cont_lbl(ctx, cont_lbl)

    if init_name != none {
        val init_val: ref u8 = gen_expr(ctx, stmt.d1 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        val already_local: bool = str.raw_cmp(cg_local_type(ctx, init_name), c"") != 0
        val already_direct: bool = str.raw_cmp(cg_direct_type(ctx, init_name), c"") != 0
        if already_local || already_direct {
            @snprintf(buf, 128, "    storel {s}, %%{s}\n", {init_val, init_name})
        } else {
            @snprintf(
                buf,
                128,
                "    %%{s} =l alloc8 8\n    storel {s}, %%{s}\n",
                {init_name, init_val, init_name}
            )
        }
        emit(ctx, buf)
    }

    val ljbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(ljbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {loop_lbl, loop_lbl})
    emit(ctx, ljbuf)
    val cond_node: ref void = stmt.d2 as ref void
    if cond_node != none {
        val cond: ref u8 = gen_expr(ctx, cond_node as ref parser.Node)
        val cbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(cbuf, 128, "    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {cond, body_lbl, break_lbl, body_lbl})
        emit(ctx, cbuf)
    } else {
        val ibuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(ibuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {body_lbl, body_lbl})
        emit(ctx, ibuf)
    }

    gen_stmts(ctx, stmt.d4 as ref parser.Node)

    if !block_ends_with_terminator(stmt.d4 as ref parser.Node) {
        val cjbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
        @snprintf(cjbuf, 64, "    jmp @lbl{lld}\n", {cont_lbl})
        emit(ctx, cjbuf)
    }

    val clbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(clbuf, 32, "@lbl{lld}\n", {cont_lbl})
    emit(ctx, clbuf)
    val post_step: ref void = stmt.d3 as ref void
    if post_step != none {
        gen_stmt(ctx, post_step as ref parser.Node)
    }

    val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {loop_lbl, break_lbl})
    emit(ctx, jbuf)
    cg_set_break_lbl(ctx, prev_break)
    cg_set_cont_lbl(ctx, prev_cont)
}

fn gen_fixed_forin_stmt(
    ctx: mut ref CgCtx,
    stmt: ref parser.Node,
    binding: ref u8,
    iter: ref u8,
    loop_lbl: i64,
    body_lbl: i64,
    break_lbl: i64,
    cont_lbl: i64,
    prev_break: i64,
    prev_cont: i64
) bool = trust {
    val fixed_iter_node: ref parser.Node = stmt.d1 as ref parser.Node
    val fixed_ann_raw: ref u8 = infer_type_annotation(ctx, fixed_iter_node)
    val fixed_ann: mut ref u8 = fixed_ann_raw
    if raw_starts_with(fixed_ann, c"ref ") {
        fixed_ann = @ptradd(fixed_ann, 4) as ref u8
    }
    if str.raw_cmp(fixed_ann, c"") != 0 && raw_starts_with(fixed_ann, c"[") {
        val fixed_count: i64 = cg_ann_fixed_arr_len_val(ctx, fixed_ann)
        val fixed_elem_ann: ref u8 = ann_fixed_arr_inner(fixed_ann)
        val fixed_elem_size: i64 = cg_ann_size(ctx, fixed_elem_ann)
        val fixed_idx_slot: i64 = fresh_tmp(ctx)
        val fixed_init: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(fixed_init, 256,
            "    %%t{lld} =l alloc8 8\n    storel 0, %%t{lld}\n@lbl{lld}\n",
            {fixed_idx_slot, fixed_idx_slot, loop_lbl})
        emit(ctx, fixed_init)

        val fixed_cur: i64 = fresh_tmp(ctx)
        val fixed_cmp: i64 = fresh_tmp(ctx)
        val fixed_head: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(fixed_head, 512,
            "    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =w csltl %%t{lld}, {lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {
                fixed_cur,
                fixed_idx_slot,
                fixed_cmp,
                fixed_cur,
                fixed_count,
                fixed_cmp,
                body_lbl,
                break_lbl,
                body_lbl
            })
        emit(ctx, fixed_head)

        val fixed_off: i64 = fresh_tmp(ctx)
        val fixed_elem_ptr: i64 = fresh_tmp(ctx)
        val fixed_ptr_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(fixed_ptr_buf, 512,
            "    %%t{lld} =l mul %%t{lld}, {lld}\n    %%t{lld} =l add {s}, %%t{lld}\n",
            {fixed_off, fixed_cur, fixed_elem_size, fixed_elem_ptr, iter, fixed_off})
        emit(ctx, fixed_ptr_buf)

        val fixed_binding_qbe: mut ref u8 = c""
        val fixed_elem_is_scalar: bool = cg_ann_is_scalar(fixed_elem_ann)
        || raw_starts_with(fixed_elem_ann, c"ref ")
        || raw_starts_with(fixed_elem_ann, c"mut ref ")
        if fixed_elem_is_scalar {
            val fixed_elem: i64 = fresh_tmp(ctx)
            val fixed_load_op: ref u8 = scalar_load_instr_for_name(fixed_elem_ann)
            val fixed_load_qt: ref u8 = scalar_load_qtype_for_name(fixed_elem_ann)
            val fixed_load_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(fixed_load_buf, 256,
                "    %%t{lld} ={s} {s} %%t{lld}\n",
                {fixed_elem, fixed_load_qt, fixed_load_op, fixed_elem_ptr})
            emit(ctx, fixed_load_buf)
            val fixed_bind: mut i64 = fixed_elem
            if str.raw_cmp(fixed_load_qt, c"w") == 0 {
                val fixed_wide: i64 = fresh_tmp(ctx)
                val fixed_ext: mut ref u8 = c"extuw"
                if str.raw_cmp(fixed_elem_ann, c"i8") == 0
                || str.raw_cmp(fixed_elem_ann, c"i16") == 0
                || str.raw_cmp(fixed_elem_ann, c"i32") == 0 {
                    fixed_ext = c"extsw"
                }
                val fixed_ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                @snprintf(fixed_ext_buf, 128,
                    "    %%t{lld} =l {s} %%t{lld}\n",
                    {fixed_wide, fixed_ext, fixed_elem})
                emit(ctx, fixed_ext_buf)
                fixed_bind = fixed_wide
            }
            val fixed_bind_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(fixed_bind_buf, 32, "%%t{lld}", {fixed_bind})
            fixed_binding_qbe = fixed_bind_buf
        } else {
            val fixed_bind_buf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(fixed_bind_buf2, 32, "%%t{lld}", {fixed_elem_ptr})
            fixed_binding_qbe = fixed_bind_buf2
        }

        cg_register_local_var(ctx, binding, fixed_binding_qbe)
        if str.raw_cmp(fixed_elem_ann, c"") != 0 {
            if fixed_elem_is_scalar {
                cg_register_local_type(ctx, binding, fixed_elem_ann)
                if raw_starts_with(fixed_elem_ann, c"ref ")
                || raw_starts_with(fixed_elem_ann, c"mut ref ") {
                    cg_register_local_ref_type(ctx, binding)
                }
            } else {
                val fixed_ref_ann: ref u8 = str.concat_raw(c"ref ", fixed_elem_ann)
                cg_register_local_type(ctx, binding, fixed_ref_ann)
                cg_register_local_ref_type(ctx, binding)
            }
        }

        gen_stmts(ctx, stmt.d2 as ref parser.Node)

        val fixed_nxt: i64 = fresh_tmp(ctx)
        val fixed_tail: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        @snprintf(fixed_tail, 256,
            "@lbl{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n",
            {cont_lbl, fixed_nxt, fixed_cur, fixed_nxt, fixed_idx_slot, loop_lbl, break_lbl})
        emit(ctx, fixed_tail)
        cg_set_break_lbl(ctx, prev_break)
        cg_set_cont_lbl(ctx, prev_cont)
        return true
    }
    return false
}



fn gen_forin_stmt(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val binding: ref u8 = parser.node_str_raw(stmt.d0)
    val iter: ref u8 = gen_expr(ctx, stmt.d1 as ref parser.Node)
    val body: ref void = stmt.d2 as ref void
    val idx: i64 = fresh_tmp(ctx)
    val len: i64 = fresh_tmp(ctx)
    val loop_lbl: i64 = fresh_lbl(ctx)
    val body_lbl: i64 = fresh_lbl(ctx)
    val break_lbl: i64 = fresh_lbl(ctx)
    val cont_lbl: i64 = fresh_lbl(ctx)
    val prev_break2: i64 = cg_break_lbl(ctx)
    val prev_cont2: i64 = cg_cont_lbl(ctx)

    cg_set_break_lbl(ctx, break_lbl)
    cg_set_cont_lbl(ctx, cont_lbl)

    if gen_fixed_forin_stmt(
        ctx,
        stmt,
        binding,
        iter,
        loop_lbl,
        body_lbl,
        break_lbl,
        cont_lbl,
        prev_break2,
        prev_cont2
    ) {
        return
    }

    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8

    @snprintf(buf, 512,
        "    %%t{lld} =l alloc8 8\n    storel 0, %%t{lld}\n    %%t{lld} =l call $sxqbe_list_len(l {s})\n@lbl{lld}\n",
        {idx, idx, len, iter, loop_lbl})
    emit(ctx, buf)
    ctx.alloc_runtime = true
    val cur_idx: i64 = fresh_tmp(ctx)
    val cmp: i64 = fresh_tmp(ctx)
    val buf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(buf2, 256,
        "    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =w csltl %%t{lld}, %%t{lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
        {cur_idx, idx, cmp, cur_idx, len, cmp, body_lbl, break_lbl, body_lbl})
    emit(ctx, buf2)
    val buf_tmp: i64 = fresh_tmp(ctx)
    val off: i64 = fresh_tmp(ctx)
    val elem_ptr: i64 = fresh_tmp(ctx)
    val elem: i64 = fresh_tmp(ctx)
    val binding_qbe: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(binding_qbe, 32, "%%t{lld}", {elem})

    val elem_stype: mut ref u8 = c"l"
    val iter_node2: ref parser.Node = stmt.d1 as ref parser.Node
    val iter_type2: mut ref u8 = infer_type_annotation(ctx, iter_node2)
    if str.raw_cmp(
        iter_type2,
        c""
    ) == 0 && iter_node2 != none && iter_node2.kind == parser.NK_IDENT {
        val iter_name2: ref u8 = parser.node_str_raw(iter_node2.d0)
        iter_type2 = cg_local_type(ctx, iter_name2)
        if str.raw_cmp(iter_type2, c"") == 0 {
            val fparams2: ref void = cg_lookup_fn_params(ctx, ctx.fn_name)
            if fparams2 != none {
                val plen2: i64 = @len(fparams2 as list[ref parser.Node]) as i64
                val pi2: mut i64 = 0
                for {
                    if pi2 >= plen2 {
                        break
                    }
                    val p_opt2 = @get(fparams2 as list[ref parser.Node], pi2 as usize)
                    if p_opt2 is some p2 {
                        val pnode2: ref parser.Node = p2 as ref parser.Node
                        if str.raw_cmp(parser.node_str_raw(pnode2.d0), iter_name2) == 0 {
                            iter_type2 = type_expr_to_annotation(
                                ctx,
                                cg_concrete_ty(ctx, pnode2.d1 as ref parser.Node)
                            )
                        }
                    }
                    pi2++
                }
            }
        }
    }
    if str.raw_cmp(iter_type2, c"") != 0 && raw_starts_with(iter_type2, c"list[") {
        val elem_type2: ref u8 = @ptradd(iter_type2, 5) as ref u8 // skip "list["
        val elem_len2: i64 = str.len_raw(elem_type2)
        if elem_len2 > 1 {
            val elem_type_copy2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (elem_len2) as usize
            ) as ref u8
            @memcpy(elem_type_copy2, elem_type2, (elem_len2 - 1) as usize)
            @store8(@ptradd(elem_type_copy2, elem_len2 - 1), 0)
            if str.raw_cmp(elem_type_copy2, c"f32") == 0 {
                elem_stype = c"s"
            } elif is_float_type_name(elem_type_copy2) {
                elem_stype = c"d"
            } elif is_word_type_name(elem_type_copy2) {
                elem_stype = c"w"
            }
        }
    }

    if str.raw_cmp(elem_stype, c"d") == 0 {
        val elem_raw: i64 = fresh_tmp(ctx)
        val d_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 768 as usize) as ref u8
        @snprintf(d_buf, 768,
            "    %%t{lld} =l call $sxqbe_list_buf(l {s})\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =d cast %%t{lld}\n",
            {
                buf_tmp,
                iter,
                off,
                cur_idx,
                elem_ptr,
                buf_tmp,
                off,
                elem_raw,
                elem_ptr,
                elem,
                elem_raw
            })
        emit(ctx, d_buf)
    } elif str.raw_cmp(elem_stype, c"s") == 0 {
        val elem_raw2: i64 = fresh_tmp(ctx)
        val elem_word: i64 = fresh_tmp(ctx)
        val s_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 768 as usize) as ref u8
        @snprintf(s_buf, 768,
            "    %%t{lld} =l call $sxqbe_list_buf(l {s})\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n    %%t{lld} =w cast %%t{lld}\n    %%t{lld} =s cast %%t{lld}\n",
            {
                buf_tmp,
                iter,
                off,
                cur_idx,
                elem_ptr,
                buf_tmp,
                off,
                elem_raw2,
                elem_ptr,
                elem_word,
                elem_raw2,
                elem,
                elem_word
            })
        emit(ctx, s_buf)
    } else {
        val buf3: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf3, 512,
            "    %%t{lld} =l call $sxqbe_list_buf(l {s})\n    %%t{lld} =l mul %%t{lld}, 8\n    %%t{lld} =l add %%t{lld}, %%t{lld}\n    %%t{lld} =l loadl %%t{lld}\n",
            {buf_tmp, iter, off, cur_idx, elem_ptr, buf_tmp, off, elem, elem_ptr})
        emit(ctx, buf3)
    }

    cg_register_local_var(ctx, binding, binding_qbe)

    val iter_type: mut ref u8 = infer_type_annotation(ctx, iter_node2)
    if str.raw_cmp(iter_type, c"") == 0 && iter_node2 != none && iter_node2.kind == parser.NK_IDENT {
        val iter_name: ref u8 = parser.node_str_raw(iter_node2.d0)
        iter_type = cg_local_type(ctx, iter_name)
        if str.raw_cmp(iter_type, c"") == 0 {
            val fparams: ref void = cg_lookup_fn_params(ctx, ctx.fn_name)
            if fparams != none {
                val plen: i64 = @len(fparams as list[ref parser.Node]) as i64
                val pi: mut i64 = 0
                for {
                    if pi >= plen {
                        break
                    }
                    val p_opt = @get(fparams as list[ref parser.Node], pi as usize)
                    if p_opt is some p {
                        val pnode: ref parser.Node = p as ref parser.Node
                        if str.raw_cmp(parser.node_str_raw(pnode.d0), iter_name) == 0 {
                            iter_type = type_expr_to_annotation(
                                ctx,
                                cg_concrete_ty(ctx, pnode.d1 as ref parser.Node)
                            )
                        }
                    }
                    pi++
                }
            }
        }
    }
    if str.raw_cmp(iter_type, c"") != 0 && raw_starts_with(iter_type, c"list[") {
        val elem_type: ref u8 = @ptradd(iter_type, 5) as ref u8 // skip "list["
        val elem_len: i64 = str.len_raw(elem_type)
        val yo = @load8(@ptradd(elem_type, elem_len - 1)) as i64
        if elem_len > 1 && yo == 93 { // ']'
            val elem_type_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (elem_len) as usize
            ) as ref u8
            @memcpy(elem_type_copy, elem_type, (elem_len - 1) as usize)
            @store8(@ptradd(elem_type_copy, elem_len - 1), 0)
            cg_register_local_type(ctx, binding, elem_type_copy)
            if raw_starts_with(elem_type_copy, c"ref ") {
                cg_register_local_ref_type(ctx, binding)
            }
        }
    }

    gen_stmts(ctx, body as ref parser.Node)

    val nxt: i64 = fresh_tmp(ctx)
    val buf4: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(buf4, 256,
        "@lbl{lld}\n    %%t{lld} =l add %%t{lld}, 1\n    storel %%t{lld}, %%t{lld}\n    jmp @lbl{lld}\n@lbl{lld}\n",
        {cont_lbl, nxt, cur_idx, nxt, idx, loop_lbl, break_lbl})
    emit(ctx, buf4)
    cg_set_break_lbl(ctx, prev_break2)
    cg_set_cont_lbl(ctx, prev_cont2)
}

fn gen_match_opt(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_opt_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val some_bind: ref u8 = parser.match_opt_some_bind_raw(stmt)
    val some_body_node = parser.match_opt_some_body(stmt)
    val none_body_node = parser.match_opt_none_body(stmt)

    val some_lbl: i64 = fresh_lbl(ctx)
    val none_lbl: i64 = fresh_lbl(ctx)
    val end_lbl: i64 = fresh_lbl(ctx)
    val tag: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    if true {
        val is_some: i64 = fresh_tmp(ctx)
        @snprintf(buf, 256,
            "    %%t{lld} =l loadl {s}\n    %%t{lld} =w cnel %%t{lld}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {tag, expr, is_some, tag, is_some, some_lbl, none_lbl, some_lbl})
        emit(ctx, buf)
    } else {
        @snprintf(buf, 256,
            "    %%t{lld} =w cnel {s}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {tag, expr, tag, some_lbl, none_lbl, some_lbl})
        emit(ctx, buf)
    }
    if some_bind != none && str.raw_cmp(some_bind, c"_") != 0 {
        val opt_ann: ref u8 = infer_type_annotation(ctx, expr_node)
        val inner_type: ref u8 = parse_option_inner(opt_ann)
        if true {
            val inner_ty: ref parser.Node = cg_named_ty_from_ann(ctx, inner_type)
            cg_emit_bind_typed(ctx, expr, 8, some_bind, inner_ty)
        } else {
            val val_tmp: i64 = fresh_tmp(ctx)
            val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(vbuf, 128, "    %%t{lld} =l sub {s}, 1\n", {val_tmp, expr})
            emit(ctx, vbuf)
            val eff_tmp: i64 = fresh_tmp(ctx)
            val cbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if str.raw_cmp(inner_type, c"f64") == 0 {
                @snprintf(cbuf, 64, "    %%t{lld} =d loadd %%t{lld}\n", {eff_tmp, val_tmp})
            } elif str.raw_cmp(inner_type, c"f32") == 0 {
                @snprintf(cbuf, 64, "    %%t{lld} =s loads %%t{lld}\n", {eff_tmp, val_tmp})
            } else {
                @snprintf(cbuf, 64, "    %%t{lld} =l loadl %%t{lld}\n", {eff_tmp, val_tmp})
            }
            emit(ctx, cbuf)
            val tmp_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(tmp_str, 16, "{lld}", {eff_tmp})
            cg_register_local_var(ctx, some_bind, tmp_str)
            if str.raw_cmp(inner_type, c"") != 0 {
                cg_register_local_type(ctx, some_bind, inner_type)
                if raw_starts_with(inner_type, c"ref ") {
                    cg_register_local_ref_type(ctx, some_bind)
                }
            } else {
                cg_register_local_ref_type(ctx, some_bind)
            }
        }
    }

    if some_body_node != none {
        gen_stmts(ctx, some_body_node.d0 as ref parser.Node)
    }

    val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    if !body_ends_with_terminator(some_body_node) {
        @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, none_lbl})
        emit(ctx, jbuf)
    } else {
        @snprintf(jbuf, 64, "@lbl{lld}\n", {none_lbl})
        emit(ctx, jbuf)
    }
    if none_body_node != none {
        gen_stmts(ctx, none_body_node.d0 as ref parser.Node)
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    if !body_ends_with_terminator(none_body_node) {
        @snprintf(endbuf, 32, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, end_lbl})
        emit(ctx, endbuf)
    } else {
        @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
        emit(ctx, endbuf)
    }
}

fn gen_match_res(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_res_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val ok_bind: ref u8 = parser.match_res_ok_bind_raw(stmt)
    val ok_body_node = parser.match_res_ok_body(stmt)
    val err_bind: ref u8 = parser.match_res_err_bind_raw(stmt)
    val err_body_node = parser.match_res_err_body(stmt)
    val tag: i64 = fresh_tmp(ctx)
    val is_ok: i64 = fresh_tmp(ctx)
    val ok_lbl: i64 = fresh_lbl(ctx)
    val err_lbl: i64 = fresh_lbl(ctx)
    val end_lbl: i64 = fresh_lbl(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8

    val result_ann: ref u8 = infer_type_annotation(ctx, expr_node)
    val ok_type_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    val err_type_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    parse_result_types(result_ann, ok_type_buf, err_type_buf)
    val is_real_result: bool = str.raw_cmp(
        result_ann,
        c""
    ) == 0 || raw_starts_with(result_ann, c"result[")

    if is_real_result {
        // A result value is always a pointer to a {tag, payload} object,
        // including when it arrives as a function parameter.
        @snprintf(buf, 256,
            "    %%t{lld} =l loadl {s}\n    %%t{lld} =w ceql %%t{lld}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {tag, expr, is_ok, tag, is_ok, ok_lbl, err_lbl, ok_lbl})
    } else {
        @snprintf(buf, 256,
            "    %%t{lld} =w copy 1\n    jnz {s}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
            {tag, expr, ok_lbl, err_lbl, ok_lbl})
    }

    emit(ctx, buf)
    if is_real_result {
        if ok_bind != none && str.raw_cmp(ok_bind, c"_") != 0 {
            if true {
                val ok_ty: ref parser.Node = cg_named_ty_from_ann(ctx, ok_type_buf)
                cg_emit_bind_typed(ctx, expr, 8, ok_bind, ok_ty)
            } else {
                val off_ok: i64 = fresh_tmp(ctx)
                val val_ok: i64 = fresh_tmp(ctx)
                val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(vbuf, 256,
                    "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n",
                    {off_ok, expr, val_ok, off_ok})
                emit(
                    ctx,
                    vbuf
                )
                val tmp_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(tmp_str, 16, "{lld}", {val_ok})
                cg_register_local_var(ctx, ok_bind, tmp_str)
                val ok_inner: ref u8 = ok_type_buf
                if str.raw_cmp(ok_inner, c"") != 0 {
                    cg_register_local_type(ctx, ok_bind, ok_inner)
                    if raw_starts_with(ok_inner, c"ref ") {
                        cg_register_local_ref_type(ctx, ok_bind)
                    }
                }
            }
        }
    } else {
        if ok_bind != none && str.raw_cmp(ok_bind, c"_") != 0 {
            val ok_copy: i64 = fresh_tmp(ctx)
            val ok_cbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            val expr_qt: ref u8 = expr_qbe_type(ctx, expr_node)
            if str.raw_cmp(expr_qt, c"w") == 0 {
                val ext_tmp: i64 = fresh_tmp(ctx)
                @snprintf(ok_cbuf, 64, "    %%t{lld} =l extsw {s}\n", {ext_tmp, expr})
                emit(
                    ctx,
                    ok_cbuf
                )
                val ok_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(ok_str, 16, "{lld}", {ext_tmp})
                cg_register_local_var(ctx, ok_bind, ok_str)
            } else {
                @snprintf(ok_cbuf, 64, "    %%t{lld} =l copy {s}\n", {ok_copy, expr})
                emit(
                    ctx,
                    ok_cbuf
                )
                val ok_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(ok_str, 16, "{lld}", {ok_copy})
                cg_register_local_var(ctx, ok_bind, ok_str)
            }
            if str.raw_cmp(result_ann, c"") != 0 {
                cg_register_local_type(ctx, ok_bind, result_ann)
            }
        }
    }
    if ok_body_node != none {
        gen_stmts(ctx, ok_body_node.d0 as ref parser.Node)
    }

    val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    if !body_ends_with_terminator(ok_body_node) {
        @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, err_lbl})
        emit(ctx, jbuf)
    } else {
        @snprintf(jbuf, 64, "@lbl{lld}\n", {err_lbl})
        emit(ctx, jbuf)
    }
    if is_real_result {
        if err_bind != none && str.raw_cmp(err_bind, c"_") != 0 {
            if true {
                val err_ty: ref parser.Node = cg_named_ty_from_ann(ctx, err_type_buf)
                cg_emit_bind_typed(ctx, expr, 8, err_bind, err_ty)
            } else {
                val off_err: i64 = fresh_tmp(ctx)
                val val_err: i64 = fresh_tmp(ctx)
                val vbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(vbuf2, 256,
                    "    %%t{lld} =l add {s}, 8\n    %%t{lld} =l loadl %%t{lld}\n    %%{s} =l copy %%t{lld}\n",
                    {off_err, expr, val_err, off_err, err_bind, val_err})
                emit(
                    ctx,
                    vbuf2
                )
                val tmp_str_err: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    16 as usize
                ) as ref u8
                @snprintf(tmp_str_err, 16, "{lld}", {val_err})
                cg_register_local_var(ctx, err_bind, tmp_str_err)
            }
        }
    } else {
        if err_bind != none && str.raw_cmp(err_bind, c"_") != 0 {
            val err_tmp: i64 = fresh_tmp(ctx)
            val err_zbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            @snprintf(err_zbuf, 64, "    %%t{lld} =l copy 0\n", {err_tmp})
            emit(
                ctx,
                err_zbuf
            )
            val err_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                16 as usize
            ) as ref u8
            @snprintf(err_str, 16, "{lld}", {err_tmp})
            cg_register_local_var(ctx, err_bind, err_str)
        }
    }
    if err_body_node != none {
        gen_stmts(ctx, err_body_node.d0 as ref parser.Node)
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    if !body_ends_with_terminator(err_body_node) {
        @snprintf(endbuf, 32, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, end_lbl})
        emit(ctx, endbuf)
    } else {
        @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
        emit(ctx, endbuf)
    }
}

fn gen_match_enum(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_enum_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val arms = parser.match_enum_arms(stmt)
    val end_lbl: i64 = fresh_lbl(ctx)

    val alen: i64 = @len(arms) as i64
    if alen == 0 {
        return
    }
    val ai: mut i64 = 0
    for {
        if ai >= alen {
            break
        }
        val arm_opt = @get(arms, ai as usize)
        if arm_opt is some arm {
            val arm_node: ref parser.Node = arm as ref parser.Node
            val variant_name: ref u8 = parser.node_str_raw(arm_node.d0)
            val type_name: ref u8 = parser.node_str_raw(arm_node.d2)
            val eval_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(eval_str, 32, "{lld}", {ai})
            if type_name != none && str.raw_cmp(type_name, c"") != 0 {
                val key: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(key, 512, "{s}__{s}", {type_name, variant_name})
                val found: ref u8 = cg_const_val(ctx, key)
                if str.raw_cmp(found, c"") != 0 {
                    @snprintf(eval_str, 32, "{s}", {found})
                }
            }
            val body_lbl: i64 = fresh_lbl(ctx)
            val next_lbl: i64 = fresh_lbl(ctx)
            val cmp: i64 = fresh_tmp(ctx)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256,
                "    %%t{lld} =w ceql {s}, {s}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                {
                    cmp,
                    expr,
                    eval_str,
                    cmp,
                    body_lbl,
                    next_lbl,
                    body_lbl
                })
            emit(ctx, buf)
            val arm_body = parser.match_enum_arm_body(arm_node)
            gen_stmts(ctx, arm_body as ref parser.Node)
            val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                64 as usize
            ) as ref u8
            if !block_ends_with_terminator(arm_body as ref parser.Node) {
                @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, next_lbl})
            } else {
                @snprintf(jbuf, 64, "@lbl{lld}\n", {next_lbl})
            }
            emit(ctx, jbuf)
        }
        ai++
    }
    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf)
}

fn gen_match_value(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_value_expr(stmt)
    val expr_ann: ref u8 = infer_type_annotation(ctx, expr_node)
    val target_qt: ref u8 = cg_ann_qtype(expr_ann)
    val expr_qt_raw: ref u8 = expr_qbe_type(ctx, expr_node)
    val expr_raw: ref u8 = gen_expr_with_type(ctx, expr_node, target_qt)
    val arms = parser.match_value_arms(stmt)
    val else_body = parser.match_value_else(stmt)
    val end_lbl: i64 = fresh_lbl(ctx)

    val expr_cmp: mut ref u8 = expr_raw
    val expr_cmp_qt: mut ref u8 = target_qt
    if str.raw_cmp(expr_cmp_qt, c"") == 0 {
        expr_cmp_qt = expr_qt_raw
    }
    if str.raw_cmp(expr_cmp_qt, c"s") == 0 {
        val ext_tmp: i64 = fresh_tmp(ctx)
        val ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            128 as usize
        ) as ref u8
        @snprintf(ext_buf, 128, "    %%t{lld} =d exts {s}\n", {ext_tmp, expr_cmp})
        emit(
            ctx,
            ext_buf
        )
        expr_cmp = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(expr_cmp, 32, "%%t{lld}", {ext_tmp})
        expr_cmp_qt = c"d"
    }

    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val arm_node: ref parser.Node = arm as ref parser.Node
                val pat_node: ref parser.Node = parser.match_value_arm_pattern(arm_node)
                val body_lbl: i64 = fresh_lbl(ctx)
                val next_lbl: i64 = fresh_lbl(ctx)
                val cmp_tmp: i64 = fresh_tmp(ctx)
                val pat_raw: ref u8 = gen_expr_with_type(ctx, pat_node, target_qt)
                val pat_cmp: mut ref u8 = pat_raw
                if str.raw_cmp(expr_cmp_qt, c"d") == 0 && str.raw_cmp(target_qt, c"s") == 0 {
                    val pat_ext_tmp: i64 = fresh_tmp(ctx)
                    val pat_ext_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        pat_ext_buf,
                        128,
                        "    %%t{lld} =d exts {s}\n",
                        {pat_ext_tmp, pat_cmp}
                    )
                    emit(
                        ctx,
                        pat_ext_buf
                    )
                    pat_cmp = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        32 as usize
                    ) as ref u8
                    @snprintf(pat_cmp, 32, "%%t{lld}", {pat_ext_tmp})
                }
                val cmp_op: mut ref u8 = c"ceql"
                if str.raw_cmp(expr_cmp_qt, c"w") == 0 {
                    cmp_op = c"ceqw"
                } elif str.raw_cmp(expr_cmp_qt, c"d") == 0 {
                    cmp_op = c"ceqd"
                }
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(buf, 256,
                    "    %%t{lld} =w {s} {s}, {s}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                    {cmp_tmp, cmp_op, expr_cmp, pat_cmp, cmp_tmp, body_lbl, next_lbl, body_lbl})
                emit(ctx, buf)
                val arm_body = parser.match_value_arm_body(arm_node)
                gen_stmts(ctx, arm_body as ref parser.Node)
                val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                if !block_ends_with_terminator(arm_body as ref parser.Node) {
                    @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, next_lbl})
                } else {
                    @snprintf(jbuf, 64, "@lbl{lld}\n", {next_lbl})
                }
                emit(ctx, jbuf)
            }
            ai++
        }
    }

    if else_body != none {
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf)
}

fn gen_match_str(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_str_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val arms = parser.match_str_arms(stmt)
    val else_body = parser.match_str_else(stmt)
    val end_lbl: i64 = fresh_lbl(ctx)

    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val arm_node: ref parser.Node = arm as ref parser.Node
                val pat: ref u8 = parser.match_str_arm_value_raw(arm_node)
                val pat_idx: i64 = intern_string_raw(ctx, pat)
                val body_lbl: i64 = fresh_lbl(ctx)
                val next_lbl: i64 = fresh_lbl(ctx)
                val cmp: i64 = fresh_tmp(ctx)
                val cmp2: i64 = fresh_tmp(ctx)
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(buf, 256,
                    "    %%t{lld} =l call $strcmp(l {s}, l $__str{lld})\n    %%t{lld} =w ceql %%t{lld}, 0\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                    {cmp, expr, pat_idx, cmp2, cmp, cmp2, body_lbl, next_lbl, body_lbl})
                emit(ctx, buf)
                val arm_body = parser.match_str_arm_body(arm_node)
                gen_stmts(ctx, arm_body as ref parser.Node)
                val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                if !block_ends_with_terminator(arm_body as ref parser.Node) {
                    @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, next_lbl})
                } else {
                    @snprintf(jbuf, 64, "@lbl{lld}\n", {next_lbl})
                }
                emit(ctx, jbuf)
            }
            ai++
        }
    }

    if else_body != none {
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf)
}

/// Look up union variants by type name, trying exact match then suffix match for mangled names.
fn cg_lookup_union_suffix(ctx: mut ref CgCtx, type_name: ref u8) ref void = trust {
    val exact = cg_lookup_union(ctx, type_name)
    if exact != none {
        return exact
    }
    val mangled_name: ref u8 = sanitize_mangle_atom(ctx, type_name)
    if str.raw_cmp(mangled_name, type_name) != 0 {
        val mangled_exact = cg_lookup_union(ctx, mangled_name)
        if mangled_exact != none {
            return mangled_exact
        }
    }
    val names: ref void = cg_unames(ctx)
    val nlen: i64 = @len(names as list[ref u8]) as i64
    val tlen: i64 = str.len_raw(type_name)
    val suffix_len: i64 = tlen + 2
    val ni: mut i64 = 0
    for {
        if ni >= nlen {
            break
        }
        val n_opt = @get(names as list[ref u8], ni as usize)
        if n_opt is some n {
            val candidate: ref u8 = n as ref u8
            val clen: i64 = str.len_raw(candidate)
            if clen > suffix_len {
                val tail: ref u8 = @ptradd(candidate, clen - suffix_len) as ref u8
                val c1: u8 = @load8(@ptradd(tail, 0))
                val c2: u8 = @load8(@ptradd(tail, 1))
                if c1 == 95 && c2 == 95 {
                    val rest: ref u8 = @ptradd(tail, 2) as ref u8
                    if str.raw_cmp(rest, type_name) == 0 {
                        val v_opt = @get(cg_uvariants(ctx) as list[ref void], ni as usize)
                        if v_opt is some v {
                            return v as ref void
                        }
                    }
                }
            }
        }
        ni++
    }
    if str.raw_cmp(mangled_name, type_name) != 0 {
        val mlen: i64 = str.len_raw(mangled_name)
        val mangled_suffix_len: i64 = mlen + 2
        val mi: mut i64 = 0
        for {
            if mi >= nlen {
                break
            }
            val m_opt = @get(names as list[ref u8], mi as usize)
            if m_opt is some m {
                val candidate2: ref u8 = m as ref u8
                val clen2: i64 = str.len_raw(candidate2)
                if clen2 > mangled_suffix_len {
                    val tail2: ref u8 = @ptradd(candidate2, clen2 - mangled_suffix_len) as ref u8
                    val c1b: u8 = @load8(@ptradd(tail2, 0))
                    val c2b: u8 = @load8(@ptradd(tail2, 1))
                    if c1b == 95 && c2b == 95 {
                        val rest2: ref u8 = @ptradd(tail2, 2) as ref u8
                        if str.raw_cmp(rest2, mangled_name) == 0 {
                            val v_opt2 = @get(cg_uvariants(ctx) as list[ref void], mi as usize)
                            if v_opt2 is some v2 {
                                return v2 as ref void
                            }
                        }
                    }
                }
            }
            mi++
        }
    }
    return none
}

fn gen_match_union(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_union_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val arms = parser.match_union_arms(stmt)
    val else_body = parser.match_union_else(stmt)
    val end_lbl: i64 = fresh_lbl(ctx)
    val tag: i64 = fresh_tmp(ctx)
    val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8

    @snprintf(tbuf, 64, "    %%t{lld} =l loadl {s}\n", {tag, expr})
    emit(ctx, tbuf)
    val union_variants: mut ref void = none
    if expr_node != none && expr_node.kind == parser.NK_IDENT {
        val ename: ref u8 = parser.node_str_raw(expr_node.d0)
        val local_ty: ref u8 = cg_local_type(ctx, ename)
        if str.raw_cmp(local_ty, c"") != 0 {
            union_variants = cg_lookup_union_suffix(ctx, cg_ann_deref(local_ty))
        }
    }

    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val arm_node: ref parser.Node = arm as ref parser.Node
                val arm_ty = parser.match_union_arm_type(arm_node)
                val tag_idx: mut i64 = ai

                if union_variants != none && arm_ty != none {
                    if arm_ty.kind == parser.TY_NAMED {
                        val arm_tname: ref u8 = parser.node_str_raw(arm_ty.d0)
                        val vlen: i64 = @len(union_variants) as i64
                        val vi: mut i64 = 0
                        for {
                            if vi >= vlen {
                                break
                            }
                            val v_opt = @get(union_variants, vi as usize)
                            if v_opt is some v {
                                if str.raw_cmp(v as ref u8, arm_tname) == 0 {
                                    tag_idx = vi
                                    break
                                }
                            }
                            vi++
                        }
                    }
                }

                val body_lbl: i64 = fresh_lbl(ctx)
                val next_lbl: i64 = fresh_lbl(ctx)
                val cmp: i64 = fresh_tmp(ctx)
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(buf, 256,
                    "    %%t{lld} =w ceql %%t{lld}, {lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                    {cmp, tag, tag_idx, cmp, body_lbl, next_lbl, body_lbl})
                emit(ctx, buf)
                val arm_body = parser.match_union_arm_body(arm_node)
                gen_stmts(ctx, arm_body as ref parser.Node)
                val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                if !block_ends_with_terminator(arm_body as ref parser.Node) {
                    @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, next_lbl})
                } else {
                    @snprintf(jbuf, 64, "@lbl{lld}\n", {next_lbl})
                }
                emit(ctx, jbuf)
            }
            ai++
        }
    }

    if else_body != none {
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }

    val endbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf)
}

/// Tagged union match: `match expr { VariantName binding => { ... } ... }`
/// Node layout: d0=expr, d1=list[arm], d2=else_arm
/// Arm layout: d0=variant_name(ref u8), d1=list[ref u8] bindings, d2=body stmts list
fn gen_match_tagged_union(ctx: mut ref CgCtx, stmt: ref parser.Node) void = trust {
    val expr_node = parser.match_tagged_union_expr(stmt)
    val expr: mut ref u8 = c"0"
    if expr_node != none {
        expr = gen_expr(ctx, expr_node)
    }
    val arms = parser.match_tagged_union_arms(stmt)
    val else_body = parser.match_tagged_union_else(stmt)
    val end_lbl: i64 = fresh_lbl(ctx)
    val tag: i64 = fresh_tmp(ctx)
    val tbuf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8

    @snprintf(tbuf, 64, "    %%t{lld} =l loadl {s}\n", {tag, expr})
    emit(ctx, tbuf)
    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val arm_node: ref parser.Node = arm as ref parser.Node
                val vname: ref u8 = parser.match_tagged_union_arm_variant_raw(arm_node)
                val bindings = parser.match_tagged_union_arm_bindings(arm_node)

                val owner_slot: ref void = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    8 as usize
                )
                val field_slot: ref void = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    8 as usize
                )
                @store(owner_slot, 0)
                @store(field_slot, 0)
                val tag_idx: i64 = cg_lookup_tv(ctx, vname, owner_slot, field_slot)
                val variant_fields: ref void = @load(field_slot) as ref void
                val actual_idx: mut i64 = ai
                if tag_idx >= 0 {
                    actual_idx = tag_idx
                }

                val body_lbl: i64 = fresh_lbl(ctx)
                val next_lbl: i64 = fresh_lbl(ctx)
                val cmp: i64 = fresh_tmp(ctx)
                val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(buf, 256,
                    "    %%t{lld} =w ceql %%t{lld}, {lld}\n    jnz %%t{lld}, @lbl{lld}, @lbl{lld}\n@lbl{lld}\n",
                    {cmp, tag, actual_idx, cmp, body_lbl, next_lbl, body_lbl})
                emit(ctx, buf)
                val blen: i64 = @len(bindings) as i64
                if blen > 0 {
                    val bi: mut i64 = 0
                    for {
                        if bi >= blen {
                            break
                        }
                        val b_opt = @get(bindings, bi as usize)
                        if b_opt is some b {
                            val bname: ref u8 = b as ref u8
                            if str.raw_cmp(bname, c"_") != 0 {
                                val offset: i64 = 8 + bi * 8
                                val is_inline_struct: mut bool = false
                                val struct_type_name: mut ref u8 = c""
                                val field_load_op: mut ref u8 = c"loadl"
                                val field_qt2: mut ref u8 = c"l"
                                val binding_type: mut ref u8 = c""

                                if variant_fields != none {
                                    val field_ty_opt = @get(
                                        variant_fields as list[ref parser.Node],
                                        bi as usize
                                    )
                                    if field_ty_opt is some field_ty {
                                        val fty: ref parser.Node = field_ty as ref parser.Node
                                        binding_type = type_expr_to_annotation(ctx, fty)
                                        field_load_op = field_load_instr_for(fty)
                                        if str.raw_cmp(field_load_op, c"loadd") == 0 {
                                            field_qt2 = c"d"
                                        } elif str.raw_cmp(field_load_op, c"loads") == 0 {
                                            field_qt2 = c"s"
                                        } elif str.raw_cmp(field_load_op, c"loadsw") == 0 {
                                            field_qt2 = c"w"
                                        } elif str.raw_cmp(field_load_op, c"loaduw") == 0 {
                                            field_qt2 = c"w"
                                        } elif str.raw_cmp(field_load_op, c"loadsh") == 0 {
                                            field_qt2 = c"w"
                                        } elif str.raw_cmp(field_load_op, c"loaduh") == 0 {
                                            field_qt2 = c"w"
                                        } elif str.raw_cmp(field_load_op, c"loadsb") == 0 {
                                            field_qt2 = c"w"
                                        } elif str.raw_cmp(field_load_op, c"loadub") == 0 {
                                            field_qt2 = c"w"
                                        }
                                        val concrete_fty: ref parser.Node = cg_concrete_ty(ctx, fty)
                                        if concrete_fty != none && concrete_fty.kind == parser.TY_NAMED {
                                            val type_name: ref u8 = parser.node_str_raw(concrete_fty.d0)
                                            val is_struct: ref void = cg_lookup_struct(
                                                ctx,
                                                type_name
                                            )
                                            if is_struct != none {
                                                is_inline_struct = true
                                                struct_type_name = type_name
                                            }
                                        }
                                    }
                                }

                                if is_inline_struct {
                                    val payload_ptr: i64 = fresh_tmp(ctx)
                                    val bbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(bbuf, 256,
                                        "    %%t{lld} =l add {s}, {lld}\n    %%{s} =l copy %%t{lld}\n",
                                        {payload_ptr, expr, offset, bname, payload_ptr})
                                    emit(ctx, bbuf)
                                    cg_dvars_add(ctx, bname, c"l")
                                    cg_register_local_ref_type(ctx, bname)
                                    cg_register_local_type(ctx, bname, struct_type_name)
                                } else {
                                    val payload_ptr: i64 = fresh_tmp(ctx)
                                    val bbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    val payload_val: i64 = fresh_tmp(ctx)
                                    @snprintf(bbuf, 256,
                                        "    %%t{lld} =l add {s}, {lld}\n    %%t{lld} ={s} {s} %%t{lld}\n    %%{s} ={s} copy %%t{lld}\n",
                                        {
                                            payload_ptr,
                                            expr,
                                            offset,
                                            payload_val,
                                            field_qt2,
                                            field_load_op,
                                            payload_ptr,
                                            bname,
                                            field_qt2,
                                            payload_val
                                        })
                                    emit(ctx, bbuf)
                                    cg_dvars_add(ctx, bname, field_qt2)
                                    if str.raw_cmp(binding_type, c"") != 0 {
                                        cg_register_local_type(ctx, bname, binding_type)
                                    }
                                }
                            }
                        }
                        bi++
                    }
                }

                val arm_body = parser.match_tagged_union_arm_body(arm_node)
                gen_stmts(ctx, arm_body as ref parser.Node)
                val jbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                if !block_ends_with_terminator(arm_body as ref parser.Node) {
                    @snprintf(jbuf, 64, "    jmp @lbl{lld}\n@lbl{lld}\n", {end_lbl, next_lbl})
                } else {
                    @snprintf(jbuf, 64, "@lbl{lld}\n", {next_lbl})
                }
                emit(ctx, jbuf)
            }
            ai++
        }
    }

    if else_body != none {
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }

    val endbuf2: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(endbuf2, 32, "@lbl{lld}\n", {end_lbl})
    emit(ctx, endbuf2)
}

fn is_std_child_name(name: ref u8) bool = trust {
    return str.raw_cmp(name, c"allocators") == 0
    || str.raw_cmp(name, c"collections") == 0
    || str.raw_cmp(name, c"crypto") == 0
    || str.raw_cmp(name, c"env") == 0
    || str.raw_cmp(name, c"fmt") == 0
    || str.raw_cmp(name, c"fs") == 0
    || str.raw_cmp(name, c"log") == 0
    || str.raw_cmp(name, c"math") == 0
    || str.raw_cmp(name, c"os") == 0
    || str.raw_cmp(name, c"path") == 0
    || str.raw_cmp(name, c"random") == 0
    || str.raw_cmp(name, c"reflection") == 0
    || str.raw_cmp(name, c"stdio") == 0
    || str.raw_cmp(name, c"string") == 0
    || str.raw_cmp(name, c"str") == 0
    || str.raw_cmp(name, c"time") == 0
    || str.raw_cmp(name, c"thread") == 0
    || str.raw_cmp(name, c"algorithms") == 0
    || str.raw_cmp(name, c"encoding") == 0
}

fn gen_fn_prefixed(ctx: mut ref CgCtx, fn_node: ref parser.Node, mod_prefix: ref u8) void = trust {
    val public: i64 = fn_node.d0 as i64
    val ns: ref u8 = parser.node_str_raw(fn_node.d1)
    val name: ref u8 = parser.node_str_raw(fn_node.d2)
    val params: ref void = fn_node.d3 as ref void
    val ret_ty: ref parser.Node = fn_node.d4 as ref parser.Node
    val body: ref parser.Node = fn_node.d5 as ref parser.Node
    val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    val base: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8

    if ns != none {
        @snprintf(base, 256, "{s}__{s}", {ns, name})
    } else {
        @snprintf(base, 256, "{s}", {name})
    }

    val is_std_child: bool = is_std_child_name(mod_prefix)

    if str.raw_cmp(mod_prefix, c"") == 0 {
        @snprintf(mangled, 512, "{s}", {base})
    } elif is_std_child {
        @snprintf(mangled, 512, "std__{s}__{s}", {mod_prefix, base})
    } else {
        @snprintf(mangled, 512, "{s}__{s}", {mod_prefix, base})
    }

    if !cg_emit_label_if_new(ctx, mangled) {
        return
    }

    cg_set_fn_name(ctx, mangled)
    val saved_module_prefix = ctx.current_module_prefix
    if str.raw_cmp(mod_prefix, c"") != 0 || str.raw_cmp(saved_module_prefix, c"") == 0 {
        ctx.current_module_prefix = mod_prefix
    }

    if params != none {
        cg_register_fn(ctx, fn_node, mangled, params, ret_ty)
    }

    val export_kw: mut ref u8 = c""
    if public == 1 || str.raw_ends_with(mangled, c"__alloc")
    || str.raw_ends_with(mangled, c"__free")
    || str.raw_ends_with(mangled, c"__realloc") {
        export_kw = c"export "
    }
    val ret_qt: mut ref u8 = qbe_type_of(ret_ty)
    val sig_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8

    val ret_union_name: mut ref u8 = is_union_type(ctx, ret_ty)
    if str.raw_cmp(ret_union_name, c"") == 0 && ret_ty != none && ret_ty.kind == parser.TY_NAMED {
        val unprefixed_name: ref u8 = parser.node_str_raw(ret_ty.d0)
        if str.raw_cmp(mod_prefix, c"") != 0 {
            val prefixed_name: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(prefixed_name, 256, "{s}__{s}", {mod_prefix, unprefixed_name})
            val union_vars: ref void = cg_lookup_union_suffix(ctx, prefixed_name)
            if union_vars != none {
                ret_union_name = prefixed_name
            }
        }
    }
    val returns_union: bool = str.raw_cmp(ret_union_name, c"") != 0
    val returns_unboxed: bool = ret_ty != none
    && (ret_ty.kind == parser.TY_OPTION || ret_ty.kind == parser.TY_RESULT)
    val is_main: bool = str.raw_cmp(name, c"main") == 0 && str.raw_cmp(mod_prefix, c"") == 0
    if is_main {
        ret_qt = c"w"
    }
    val has_sret: bool = (returns_union || returns_unboxed) && !is_main

    @snprintf(sig_buf, 512, "{s}function {s} ${s}(", {export_kw, ret_qt, mangled})
    emit(ctx, sig_buf)
    if has_sret {
        emit(ctx, c"l %__ret")
    }

    if is_main {
        if has_sret {
            emit(ctx, c", ")
        }
        emit(ctx, c"w %argc, l %argv")
    }

    if params != none && !is_main {
        val plen: i64 = @len(params) as i64
        val pi: mut i64 = 0
        for {
            if pi >= plen {
                break
            }
            val p_opt = @get(params, pi as usize)
            if p_opt is some param {
                val pname: ref u8 = parser.node_str_raw((param as ref parser.Node).d0)
                val pty: ref parser.Node = (param as ref parser.Node).d1 as ref parser.Node
                val pqt: ref u8 = qbe_type_of(pty)
                val pqname: ref u8 = cg_param_qbe_name(ctx, pi, pname)
                val pbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    64 as usize
                ) as ref u8
                if pi > 0 || has_sret {
                    emit(ctx, c", ")
                }
                @snprintf(pbuf, 64, "{s} %%{s}", {pqt, pqname})
                emit(ctx, pbuf)
            }
            pi++
        }
    }

    emitln(ctx, c") {")
    emitln(ctx, c"@start")

    if is_main {
        emitln(ctx, c"    %sx_argc_val =l extsw %argc")
        emitln(ctx, c"    storel %sx_argc_val, $sx_argc_store")
        emitln(ctx, c"    storel %argv, $sx_argv_store")
        if !ctx.release_mode {
            emitln(ctx, c"    call $__sx_panic_init()")
        }
        emitln(ctx, c"    call $__sx_global_init()")
    }

    if returns_union {
        ctx.current_fn_ret_union = ret_union_name
    } else {
        ctx.current_fn_ret_union = c""
    }
    ctx.current_fn_ret_unboxed = returns_unboxed && !is_main
    if returns_unboxed && !is_main {
        ctx.current_fn_ret_layout_size = cg_wrap_layout_size(ctx, ret_ty)
    } else {
        ctx.current_fn_ret_layout_size = 0
    }
    ctx.current_fn_ret_qtype = ret_qt
    ctx.current_fn_ret_ty = ret_ty
    ctx.expected_ty = none

    cg_dvars_clear(ctx)
    ctx.inv_cur_pnames = mem.new[ref u8]()
    ctx.inv_cur_ptypes = mem.new[ref u8]()

    if params != none {
        val plen2: i64 = @len(params) as i64
        val pi2: mut i64 = 0
        for {
            if pi2 >= plen2 {
                break
            }
            val p_opt2 = @get(params, pi2 as usize)
            if p_opt2 is some param2 {
                val pname2: ref u8 = parser.node_str_raw((param2 as ref parser.Node).d0)
                val pty2: ref parser.Node = cg_concrete_ty(
                    ctx,
                    (param2 as ref parser.Node).d1 as ref parser.Node
                )
                val full_ptype: ref u8 = type_expr_to_annotation(ctx, pty2)
                if str.raw_cmp(full_ptype, c"") != 0 {
                    cg_register_local_type(ctx, pname2, full_ptype)
                }
                if is_ref_type(pty2) || cg_ann_is_indirect_value(ctx, full_ptype) {
                    cg_register_local_ref_type(ctx, pname2)
                }

                if pty2 != none && pty2.kind == parser.TY_MUT {
                    val slot_tmp: i64 = fresh_tmp(ctx)
                    val slot_name: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        32 as usize
                    ) as ref u8
                    @snprintf(slot_name, 32, "{lld}", {slot_tmp})

                    val slot_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    val param_qt: ref u8 = qbe_type_of(pty2)
                    val store_op: mut ref u8 = c"storel"
                    if str.raw_cmp(param_qt, c"w") == 0 {
                        store_op = c"storew"
                    } elif str.raw_cmp(param_qt, c"s") == 0 {
                        store_op = c"stores"
                    } elif str.raw_cmp(param_qt, c"d") == 0 {
                        store_op = c"stored"
                    }

                    @snprintf(
                        slot_buf,
                        256,
                        "    %%t{lld} =l alloc8 8\n    {s} %%{s}, %%t{lld}\n",
                        {slot_tmp, store_op, cg_param_qbe_name(ctx, pi2, pname2), slot_tmp}
                    )
                    emit(ctx, slot_buf)
                    cg_register_local_var(ctx, pname2, slot_name)
                    cg_mark_as_slot(ctx, pname2)
                }
            }
            pi2++
        }
    }

    val gnames_list: ref void = cg_global_src_names(ctx)
    val glen: i64 = @len(gnames_list) as i64
    val gi: mut i64 = 0
    for {
        if gi >= glen {
            break
        }
        val gn_opt = @get(gnames_list, gi as usize)
        if gn_opt is some gn {
            val glbl_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val gqt_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                8 as usize
            ) as ref u8
            val gann_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val found: bool = cg_lookup_global(ctx, gn as ref u8, glbl_buf, gqt_buf, gann_buf)
            if found && cg_lookup_local_var(ctx, gn as ref u8) == c"" {
                val dollar_label: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    260 as usize
                ) as ref u8
                @snprintf(dollar_label, 260, "${s}", {glbl_buf})
                cg_register_local_var(ctx, gn as ref u8, dollar_label)
                val is_fixed_arr_global: bool = @load8(gann_buf) as i64 == 91
                if !is_fixed_arr_global {
                    cg_mark_as_slot(ctx, gn as ref u8)
                }
                if str.raw_cmp(gann_buf, c"") != 0 {
                    val gann_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (str.len_raw(gann_buf) + 1) as usize
                    ) as ref u8
                    @memcpy(gann_copy, gann_buf, str.len_raw(gann_buf) + 1)
                    cg_register_local_type(ctx, gn as ref u8, gann_copy)
                    if raw_starts_with(
                        gann_copy,
                        c"ref "
                    ) || raw_starts_with(
                        gann_copy,
                        c"mut ref "
                    ) || cg_ann_is_indirect_value(ctx, gann_copy) {
                        cg_register_local_ref_type(ctx, gn as ref u8)
                    }
                } elif str.raw_cmp(gqt_buf, c"w") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"i32")
                } elif str.raw_cmp(gqt_buf, c"s") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f32")
                } elif str.raw_cmp(gqt_buf, c"d") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f64")
                }
            }
        }
        gi++
    }

    if params != none {
        val plen2: i64 = @len(params) as i64
        val pi2: mut i64 = 0
        for {
            if pi2 >= plen2 {
                break
            }
            val p2_opt = @get(params, pi2 as usize)
            if p2_opt is some param2 {
                val pname2: ref u8 = parser.node_str_raw((param2 as ref parser.Node).d0)
                val pty2: ref parser.Node = cg_concrete_ty(
                    ctx,
                    (param2 as ref parser.Node).d1 as ref parser.Node
                )
                val ptk: i64 = pty2.kind
                if ptk != parser.TY_MUT {
                    cg_dvars_add(ctx, pname2, qbe_type_of(pty2))
                }
                if ptk == parser.TY_MUT {
                    val inner: ref parser.Node = pty2.d0 as ref parser.Node
                    if inner != none && inner.kind == parser.TY_NAMED {
                        val tname2: ref u8 = parser.node_str_raw(inner.d0)
                        if !ctx.release_mode {
                            val has_inv: ref void = cg_lookup_invariant(ctx, tname2)
                            if has_inv != none {
                                @append(
                                    ctx.inv_cur_pnames as list[ref u8],
                                    cg_param_qbe_name(ctx, pi2, pname2)
                                )
                                @append(ctx.inv_cur_ptypes as list[ref u8], tname2)
                            }
                        }
                    }
                }
                val full_ptype2: ref u8 = type_expr_to_annotation(ctx, pty2)
                if str.raw_cmp(full_ptype2, c"") != 0 {
                    cg_register_local_type(ctx, pname2, full_ptype2)
                    if cg_ann_is_indirect_value(ctx, full_ptype2) {
                        cg_register_local_ref_type(ctx, pname2)
                    }
                }
            }
            pi2++
        }
    }

    gen_stmts(ctx, body)

    val needs_ret: bool = !stmts_terminated(ctx, body)
    if needs_ret {
        cg_emit_invariant_checks(ctx)
        cg_emit_defers(ctx)
        emitln(ctx, c"    ret 0")
    }
    ctx.current_fn_ret_qtype = c"l"
    ctx.current_fn_ret_union = c""
    ctx.current_fn_ret_unboxed = false
    ctx.current_fn_ret_layout_size = 0
    ctx.current_fn_ret_ty = none
    ctx.expected_ty = none
    ctx.current_module_prefix = saved_module_prefix
    emitln(ctx, c"}")
    emitln(ctx, c"")
}

/// Register all variants of a tagged union into the ctx variant table.
fn gen_tagged_union_def(
    ctx: mut ref CgCtx,
    item: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val name: ref u8 = parser.node_str_raw(item.d1)
    val variants: ref void = item.d2 as ref void
    if variants == none {
        return
    }
    val vlen: i64 = @len(variants) as i64
    val mangled_name: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    if str.raw_cmp(mod_prefix, c"") == 0 {
        @snprintf(mangled_name, 256, "{s}", {name})
    } else {
        @snprintf(mangled_name, 256, "{s}__{s}", {mod_prefix, name})
    }

    cg_register_union(ctx, mangled_name, variants)

    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vnode: ref parser.Node = v as ref parser.Node
            val vname: ref u8 = parser.node_str_raw(vnode.d0)
            val vty: ref void = vnode.d1 as ref void
            cg_register_tv(ctx, vname, mangled_name, vi, vty)
            if str.raw_cmp(mod_prefix, c"") != 0 {
                val prefixed_vname: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(prefixed_vname, 256, "{s}__{s}", {mod_prefix, vname})
                cg_register_tv(ctx, prefixed_vname, mangled_name, vi, vty)
            }
        }
        vi++
    }
}

fn gen_extern_fn(ctx: mut ref CgCtx, item: ref parser.Node) void = trust {
    gen_extern_fn_prefixed(ctx, item, c"")
}

fn gen_extern_fn_prefixed(
    ctx: mut ref CgCtx,
    item: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val public: i64 = item.d0 as i64
    val name: ref u8 = parser.node_str_raw(item.d1)
    val symbol: ref u8 = parser.node_str_raw(item.d2)
    val params: ref void = item.d4 as ref void
    val ret_ty: ref void = item.d5 as ref void

    cg_register_extern(ctx, name, symbol, ret_ty)

    if params != none {
        cg_register_fn(ctx, item, symbol, params, ret_ty)
    }

    if public == 1 && str.raw_cmp(mod_prefix, c"") != 0 {
        val mangled_name: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            512 as usize
        ) as ref u8
        @snprintf(mangled_name, 512, "{s}__{s}", {mod_prefix, name})
        cg_register_extern(ctx, mangled_name, symbol, ret_ty)
        if params != none {
            cg_register_fn(ctx, item, mangled_name, params, ret_ty)
        }
    }
}

fn gen_union_def_prefixed(
    ctx: mut ref CgCtx,
    item: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val name: ref u8 = parser.node_str_raw(item.d1)
    val variants: ref void = item.d2 as ref void
    if variants == none {
        return
    }
    val vlen: i64 = @len(variants) as i64
    val vnames: mut list[ref u8] = mem.new[ref u8]()
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vty: ref parser.Node = v as ref parser.Node
            val tname: mut ref u8 = c"unknown"
            if vty.kind == parser.TY_NAMED {
                tname = parser.node_str_raw(vty.d0)
            } elif vty.kind == parser.TY_REF {
                tname = c"ref"
            }
            @append(vnames, tname)
        }
        vi++
    }
    val mangled_name: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    if str.raw_cmp(mod_prefix, c"") == 0 {
        @snprintf(mangled_name, 256, "{s}", {name})
    } else {
        @snprintf(mangled_name, 256, "{s}__{s}", {mod_prefix, name})
    }
    val vl: list[ref u8] = vnames
    cg_register_union(ctx, mangled_name, vl as ref void)
}

fn gen_enum_def_prefixed(
    ctx: mut ref CgCtx,
    item: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val name: ref u8 = parser.node_str_raw(item.d1)
    val variants: ref void = item.d2 as ref void

    if variants == none {
        return
    }

    val vlen: i64 = @len(variants) as i64
    val vi: mut i64 = 0

    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vname: ref u8 = v as ref u8
            val const_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            val idx_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8

            @snprintf(idx_str, 32, "{lld}", {vi})

            if str.raw_cmp(mod_prefix, c"") == 0 {
                @snprintf(const_key, 512, "{s}__{s}", {name, vname})
            } else {
                @snprintf(const_key, 512, "{s}__{s}__{s}", {mod_prefix, name, vname})
            }

            cg_register_module_const(ctx, const_key, idx_str)
            if str.raw_cmp(mod_prefix, c"") != 0 {
                val bare_key: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(bare_key, 256, "{s}__{s}", {name, vname})
                val idx_str2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(idx_str2, 32, "{lld}", {vi})
                cg_register_module_const(ctx, bare_key, idx_str2)
            }
        }
        vi++
    }
}

/// Generate the assert_fail handler and any needed runtime helpers.
fn emit_runtime_helpers(ctx: mut ref CgCtx) void = trust {
    emitln_view(ctx,
        \\data $str_w_mode = { b "w", b 0 }
        \\data $str_r_mode = { b "r", b 0 }
        \\data $sx_stdin_ptr = { l 0 }
        \\data $sx_stdout_ptr = { l 0 }
        \\data $sx_stderr_ptr = { l 0 }
        \\
        \\function l $sx_stdout() {
        \\@start
        \\    %p =l loadl $sx_stdout_ptr
        \\    %c =w cnel %p, 0
        \\    jnz %c, @done, @init
        \\@init
        \\    %r =l call $fdopen(w 1, l $str_w_mode)
        \\    storel %r, $sx_stdout_ptr
        \\    ret %r
        \\@done
        \\    ret %p
        \\}
        \\function l $sx_stderr() {
        \\@start
        \\    %p =l loadl $sx_stderr_ptr
        \\    %c =w cnel %p, 0
        \\    jnz %c, @done, @init
        \\@init
        \\    %r =l call $fdopen(w 2, l $str_w_mode)
        \\    storel %r, $sx_stderr_ptr
        \\    ret %r
        \\@done
        \\    ret %p
        \\}
        \\function l $sx_stdin() {
        \\@start
        \\    %p =l loadl $sx_stdin_ptr
        \\    %c =w cnel %p, 0
        \\    jnz %c, @done, @init
        \\@init
        \\    %r =l call $fdopen(w 0, l $str_r_mode)
        \\    storel %r, $sx_stdin_ptr
        \\    ret %r
        \\@done
        \\    ret %p
        \\}
        \\
        \\data $sx_argc_store = { l 0 }
        \\data $sx_argv_store = { l 0 }
        \\
        \\function l $sx_get_args() {
        \\@start
        \\    %argc =l loadl $sx_argc_store
        \\    %argv =l loadl $sx_argv_store
        \\    %hdr =l call $malloc(l 32)
        \\    %cap =l mul %argc, 8
        \\    %buf =l call $malloc(l %cap)
        \\    storel %buf, %hdr
        \\    %len_slot =l add %hdr, 8
        \\    storel 0, %len_slot
        \\    %cap_slot =l add %hdr, 16
        \\    storel %argc, %cap_slot
        \\    %desc_slot =l add %hdr, 24
        \\    storel 0, %desc_slot
        \\    %i =l copy 0
        \\@args_loop
        \\    %done =w csgel %i, %argc
        \\    jnz %done, @args_done, @args_body
        \\@args_body
        \\    %off =l mul %i, 8
        \\    %slot =l add %argv, %off
        \\    %str =l loadl %slot
        \\    %cur_len =l loadl %len_slot
        \\    %boff =l mul %cur_len, 8
        \\    %bslot =l add %buf, %boff
        \\    storel %str, %bslot
        \\    %new_len =l add %cur_len, 1
        \\    storel %new_len, %len_slot
        \\    %i =l add %i, 1
        \\    jmp @args_loop
        \\@args_done
        \\    ret %hdr
        \\}
        \\
        \\function l $__sx_get_args() {
        \\@start
        \\    %r =l call $sx_get_args()
        \\    ret %r
        \\}
        \\
        \\function l $sxqbe_strcmp(l %a, l %b) {
        \\@start
        \\    %pa =l copy %a
        \\    %pb =l copy %b
        \\@loop
        \\    %ca =w loadub %pa
        \\    %cb =w loadub %pb
        \\    %d =w sub %ca, %cb
        \\    %ne =w cnew %d, 0
        \\    jnz %ne, @diff, @same
        \\@same
        \\    %z =w ceqw %ca, 0
        \\    jnz %z, @done, @advance
        \\@advance
        \\    %pa =l add %pa, 1
        \\    %pb =l add %pb, 1
        \\    jmp @loop
        \\@diff
        \\    %r =l extsw %d
        \\    ret %r
        \\@done
        \\    ret 0
        \\}
        \\
        \\function l $sxqbe_atoi(l %s) {
        \\@start
        \\    %p =l copy %s
        \\    %n =l copy 0
        \\    %sign =l copy 1
        \\@ws
        \\    %c =w loadub %p
        \\    %is_sp =w ceqw %c, 32
        \\    %is_tab =w ceqw %c, 9
        \\    %is_nl =w ceqw %c, 10
        \\    %is_vt =w ceqw %c, 11
        \\    %is_ff =w ceqw %c, 12
        \\    %is_cr =w ceqw %c, 13
        \\    %w1 =w or %is_sp, %is_tab
        \\    %w2 =w or %is_nl, %is_vt
        \\    %w3 =w or %is_ff, %is_cr
        \\    %w4 =w or %w1, %w2
        \\    %is_ws =w or %w4, %w3
        \\    jnz %is_ws, @ws_advance, @sign
        \\@ws_advance
        \\    %p =l add %p, 1
        \\    jmp @ws
        \\@sign
        \\    %c2 =w loadub %p
        \\    %is_plus =w ceqw %c2, 43
        \\    %is_minus =w ceqw %c2, 45
        \\    %is_sign =w or %is_plus, %is_minus
        \\    jnz %is_sign, @sign_advance, @digits
        \\@sign_advance
        \\    jnz %is_minus, @negative, @sign_done
        \\@negative
        \\    %sign =l copy -1
        \\@sign_done
        \\    %p =l add %p, 1
        \\    jmp @digits
        \\@digits
        \\    %c3 =w loadub %p
        \\    %ge0 =w cugew %c3, 48
        \\    %le9 =w culew %c3, 57
        \\    %is_digit =w and %ge0, %le9
        \\    jnz %is_digit, @digit_body, @done
        \\@digit_body
        \\    %d =w sub %c3, 48
        \\    %dl =l extuw %d
        \\    %n10 =l mul %n, 10
        \\    %n =l add %n10, %dl
        \\    %p =l add %p, 1
        \\    jmp @digits
        \\@done
        \\    %r =l mul %n, %sign
        \\    ret %r
        \\}
        \\
        \\function l $sxqbe_strlen(l %s) {
        \\@start
        \\    %p =l copy %s
        \\    %n =l copy 0
        \\@loop
        \\    %c =w loadub %p
        \\    %done =w ceqw %c, 0
        \\    jnz %done, @done, @body
        \\@body
        \\    %p =l add %p, 1
        \\    %n =l add %n, 1
        \\    jmp @loop
        \\@done
        \\    ret %n
        \\}
        \\
        \\function w $os__exit(w %code) {
        \\@start
        \\    call $exit(w %code)
        \\    ret 0
        \\}
    )
}

/// Pre-registration pass: register all function names and tagged union variants
/// before emitting any code, so forward references resolve correctly.
fn preregister_items(
    ctx: mut ref CgCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_GENERIC_FN {
                val gname: ref u8 = generic_fn_qualified_name(ctx, node, mod_prefix)
                register_generic_fn(ctx, gname, node, mod_prefix)
            } elif k == parser.NK_FN {
                val ns: ref u8 = parser.node_str_raw(node.d1)
                val name: ref u8 = parser.node_str_raw(node.d2)
                val params: ref void = node.d3 as ref void
                val ret_ty: ref void = node.d4 as ref void
                val base: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                if ns != none {
                    @snprintf(base, 256, "{s}__{s}", {ns, name})
                } else {
                    @snprintf(base, 256, "{s}", {name})
                }
                val is_std_child: bool = is_std_child_name(mod_prefix)
                val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                if str.raw_cmp(mod_prefix, c"") == 0 {
                    @snprintf(mangled, 512, "{s}", {base})
                } elif is_std_child {
                    @snprintf(mangled, 512, "std__{s}__{s}", {mod_prefix, base})
                } else {
                    @snprintf(mangled, 512, "{s}__{s}", {mod_prefix, base})
                }
                if params != none {
                    cg_register_fn(ctx, node, mangled, params, ret_ty)
                }
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                val tname: ref u8 = parser.node_str_raw(node.d1)
                val tfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, tname, tfields, false)
                if node.d3 != 0 as i64 {
                    cg_register_invariant(ctx, tname, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                val etname: ref u8 = parser.node_str_raw(node.d1)
                val etfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, etname, etfields, true)
            } elif k == parser.NK_CONST {
                val cname: ref u8 = parser.node_str_raw(node.d1)
                val cexpr: ref parser.Node = node.d2 as ref parser.Node
                val cval_reg: mut ref u8 = none
                if cexpr != none {
                    if cexpr.kind == parser.NK_INT_LIT {
                        cval_reg = normalize_static_int_text(ctx, parser.int_lit_text_raw(cexpr))
                    } elif cexpr.kind == parser.NK_FLOAT_LIT {
                        val ftext: ref u8 = parser.float_lit_text_raw(cexpr)
                        val fval: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(fval, 128, "d_{s}", {ftext})
                        cval_reg = fval
                    } elif cexpr.kind == parser.NK_UNOP {
                        val uval: ref u8 = const_unop_value(ctx, cexpr)
                        if str.raw_cmp(uval, c"") != 0 {
                            cval_reg = uval
                        }
                    } elif cexpr.kind == parser.NK_CAST {
                        val target: ref u8 = type_expr_to_annotation(
                            ctx,
                            cexpr.d1 as ref parser.Node
                        )
                        val cast_val: ref u8 = const_cast_value(
                            ctx,
                            cexpr.d0 as ref parser.Node,
                            target
                        )
                        if str.raw_cmp(cast_val, c"") != 0 {
                            cval_reg = cast_val
                        }
                    } elif cexpr.kind == parser.NK_BOOL {
                        val bval: i64 = cexpr.d0 as i64
                        if bval != 0 {
                            cval_reg = c"1"
                        } else {
                            cval_reg = c"0"
                        }
                    } elif cexpr.kind == parser.NK_STR_LIT {
                        val sbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            64 as usize
                        ) as ref u8
                        if parser.str_lit_is_cstr(cexpr) {
                            val sidx: i64 = intern_string(ctx, parser.str_lit_text(cexpr))
                            @snprintf(sbuf, 64, "$__str{lld}", {sidx})
                        } else {
                            val sidx: i64 = intern_string_view(ctx, parser.str_lit_text(cexpr))
                            @snprintf(sbuf, 64, "$__sv{lld}", {sidx})
                        }
                        cval_reg = sbuf
                    }
                }
                if cval_reg != none {
                    cg_register_module_const(ctx, cname, cval_reg)
                    if str.raw_cmp(mod_prefix, c"") != 0 {
                        val pkey: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            512 as usize
                        ) as ref u8
                        @snprintf(pkey, 512, "{s}__{s}", {mod_prefix, cname})
                        cg_register_module_const(ctx, pkey, cval_reg)
                    }
                }
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = parser.node_str_raw(node.d0)
                if cg_platform_matches(ctx, plat) {
                    val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
                    preregister_items(ctx, witems, mod_prefix)
                } else {
                    val or_when_branches2: ref void = node.d2 as ref void
                    val matched2: mut bool = false
                    if or_when_branches2 != none {
                        for ow2 in or_when_branches2 as list[ref parser.Node] {
                            if !matched2 {
                                val ow_plat2: ref u8 = parser.node_str_raw(ow2.d0)
                                if cg_platform_matches(ctx, ow_plat2) {
                                    val ow_items2: list[ref parser.Node] = ow2.d1 as list[ref parser.Node]
                                    preregister_items(ctx, ow_items2, mod_prefix)
                                    matched2 = true
                                }
                            }
                        }
                    }
                    if !matched2 {
                        val ow_otherwise2: ref void = node.d3 as ref void
                        if ow_otherwise2 != none {
                            val ow_oi2: list[ref parser.Node] = ow_otherwise2 as list[ref parser.Node]
                            preregister_items(ctx, ow_oi2, mod_prefix)
                        }
                    }
                }
            }
        }
        i++
    }
}

fn const_cast_value(ctx: mut ref CgCtx, inner: ref parser.Node, target: ref u8) ref u8 = trust {
    if inner == none {
        return c""
    }
    val k: i64 = inner.kind
    if k == parser.NK_CAST {
        return const_cast_value(ctx, inner.d0 as ref parser.Node, target)
    }
    if k == parser.NK_INT_LIT {
        val itext: ref u8 = normalize_static_int_text(ctx, parser.int_lit_text_raw(inner))
        if is_float_type_name(target) {
            val fval: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(fval, 128, "d_{s}.0", {itext})
            return fval
        }
        return itext
    }
    if k == parser.NK_FLOAT_LIT {
        val ftext: ref u8 = parser.float_lit_text_raw(inner)
        val fval: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        if str.raw_cmp(target, c"f32") == 0 {
            @snprintf(fval, 128, "s_{s}", {ftext})
        } else {
            @snprintf(fval, 128, "d_{s}", {ftext})
        }
        return fval
    }
    if k == parser.NK_BOOL {
        val bv: i64 = inner.d0 as i64
        if is_float_type_name(target) {
            if bv != 0 {
                return c"d_1.0"
            }
            return c"d_0.0"
        }
        if bv != 0 {
            return c"1"
        }
        return c"0"
    }
    if k == parser.NK_CHAR_LIT {
        val cv: i64 = inner.d0 as i64
        val cv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        if is_float_type_name(target) {
            @snprintf(cv_buf, 32, "d_{lld}.0", {cv})
        } else {
            @snprintf(cv_buf, 32, "{lld}", {cv})
        }
        return cv_buf
    }
    if k == parser.NK_UNOP {
        val uop: i64 = parser.unop_op(inner)
        val operand: ref parser.Node = parser.unop_inner(inner)
        if uop == parser.UOP_NEG && operand != none {
            val inner_val: ref u8 = const_cast_value(ctx, operand, target)
            if str.raw_cmp(inner_val, c"") != 0 {
                val neg: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    160 as usize
                ) as ref u8
                if raw_starts_with(inner_val, c"d_") {
                    @snprintf(neg, 160, "d_-{s}", {@ptradd(inner_val, 2) as ref u8})
                } elif raw_starts_with(inner_val, c"s_") {
                    @snprintf(neg, 160, "s_-{s}", {@ptradd(inner_val, 2) as ref u8})
                } else {
                    @snprintf(neg, 160, "-{s}", {inner_val})
                }
                return neg
            }
        }
    }
    return c""
}

fn const_expr_value(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c""
    }
    val k: i64 = expr.kind
    if k == parser.NK_INT_LIT {
        return normalize_static_int_text(ctx, parser.int_lit_text_raw(expr))
    }
    if k == parser.NK_FLOAT_LIT {
        val fval: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(fval, 128, "d_{s}", {parser.float_lit_text_raw(expr)})
        return fval
    }
    if k == parser.NK_BOOL {
        if (expr.d0 as i64) != 0 {
            return c"1"
        }
        return c"0"
    }
    if k == parser.NK_CHAR_LIT {
        val cv_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
        @snprintf(cv_buf, 32, "{lld}", {expr.d0 as i64})
        return cv_buf
    }
    if k == parser.NK_CAST {
        val target: ref u8 = type_expr_to_annotation(ctx, expr.d1 as ref parser.Node)
        return const_cast_value(ctx, expr.d0 as ref parser.Node, target)
    }
    if k == parser.NK_UNOP {
        return const_unop_value(ctx, expr)
    }
    return c""
}

fn const_unop_value(ctx: mut ref CgCtx, expr: ref parser.Node) ref u8 = trust {
    if expr == none {
        return c""
    }
    val uop: i64 = parser.unop_op(expr)
    val operand: ref parser.Node = parser.unop_inner(expr)
    if uop != parser.UOP_NEG || operand == none {
        return c""
    }
    val inner_val: ref u8 = const_expr_value(ctx, operand)
    if str.raw_cmp(inner_val, c"") == 0 {
        return c""
    }
    val neg: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 160 as usize) as ref u8
    if raw_starts_with(inner_val, c"d_") {
        @snprintf(neg, 160, "d_-{s}", {@ptradd(inner_val, 2) as ref u8})
    } elif raw_starts_with(inner_val, c"s_") {
        @snprintf(neg, 160, "s_-{s}", {@ptradd(inner_val, 2) as ref u8})
    } else {
        @snprintf(neg, 160, "-{s}", {inner_val})
    }
    return neg
}

/// Emit all items from one module layer, using `mod_prefix` for name mangling.
fn gen_items_with_prefix(
    ctx: mut ref CgCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    preregister_items(ctx, items, mod_prefix)
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_GENERIC_FN {
                // already registered in preregister_items; skip generation
            } elif k == parser.NK_FN {
                gen_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                val tname: ref u8 = parser.node_str_raw(node.d1)
                val tfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, tname, tfields, false)
                if node.d3 != 0 as i64 {
                    cg_register_invariant(ctx, tname, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                val etname: ref u8 = parser.node_str_raw(node.d1)
                val etfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, etname, etfields, true)
            } elif k == parser.NK_EXTERN_HEADER {
                cg_register_c_header(ctx, parser.node_str_raw(node.d0))
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = parser.node_str_raw(node.d0)
                if cg_platform_matches(ctx, plat) {
                    val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
                    gen_items_with_prefix(ctx, witems, mod_prefix)
                } else {
                    val or_when_branches3: ref void = node.d2 as ref void
                    val matched3: mut bool = false
                    if or_when_branches3 != none {
                        for ow3 in or_when_branches3 as list[ref parser.Node] {
                            if !matched3 {
                                val ow_plat3: ref u8 = parser.node_str_raw(ow3.d0)
                                if cg_platform_matches(ctx, ow_plat3) {
                                    val ow_items3: list[ref parser.Node] = ow3.d1 as list[ref parser.Node]
                                    gen_items_with_prefix(ctx, ow_items3, mod_prefix)
                                    matched3 = true
                                }
                            }
                        }
                    }
                    if !matched3 {
                        val ow_otherwise3: ref void = node.d3 as ref void
                        if ow_otherwise3 != none {
                            val ow_oi3: list[ref parser.Node] = ow_otherwise3 as list[ref parser.Node]
                            gen_items_with_prefix(ctx, ow_oi3, mod_prefix)
                        }
                    }
                }
            } elif k == parser.NK_VAL {
                emit_global_val(ctx, mod_prefix, node)
            } elif k == parser.NK_CONST {
                val cname: ref u8 = parser.node_str_raw(node.d1)
                val cexpr: ref parser.Node = node.d2 as ref parser.Node
                if cexpr != none {
                    val const_label: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    if str.raw_cmp(mod_prefix, c"") == 0 {
                        @snprintf(const_label, 512, "{s}", {cname})
                    } else {
                        @snprintf(const_label, 512, "{s}__{s}", {mod_prefix, cname})
                    }

                    if cexpr.kind == parser.NK_INT_LIT {
                        val cval: ref u8 = normalize_static_int_text(
                            ctx,
                            parser.int_lit_text_raw(cexpr)
                        )
                        cg_register_module_const(ctx, cname, cval)
                        if cg_emit_label_if_new(ctx, const_label) {
                            val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(
                                data_buf,
                                256,
                                "data ${s} = \{ l {s} \}\n",
                                {const_label, cval}
                            )
                            emit(ctx, data_buf)
                        } else { }
                    } elif cexpr.kind == parser.NK_FLOAT_LIT {
                        val ftext: ref u8 = parser.float_lit_text_raw(cexpr)
                        val fval: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(fval, 128, "d_{s}", {ftext})
                        cg_register_module_const(ctx, cname, fval)
                    } elif cexpr.kind == parser.NK_UNOP {
                        val cval: ref u8 = const_unop_value(ctx, cexpr)
                        if str.raw_cmp(cval, c"") != 0 {
                            cg_register_module_const(ctx, cname, cval)
                            if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") { } else {
                                if cg_emit_label_if_new(ctx, const_label) {
                                    val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        data_buf,
                                        256,
                                        "data ${s} = \{ l {s} \}\n",
                                        {const_label, cval}
                                    )
                                    emit(ctx, data_buf)
                                } else { }
                            }
                        } else { }
                    } elif cexpr.kind == parser.NK_CAST {
                        val target: ref u8 = type_expr_to_annotation(
                            ctx,
                            cexpr.d1 as ref parser.Node
                        )
                        val cval: ref u8 = const_cast_value(
                            ctx,
                            cexpr.d0 as ref parser.Node,
                            target
                        )
                        if str.raw_cmp(cval, c"") != 0 {
                            cg_register_module_const(ctx, cname, cval)
                            if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") { } else {
                                if cg_emit_label_if_new(ctx, const_label) {
                                    val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        data_buf,
                                        256,
                                        "data ${s} = \{ l {s} \}\n",
                                        {const_label, cval}
                                    )
                                    emit(ctx, data_buf)
                                } else { }
                            }
                        } else { }
                    } elif cexpr.kind == parser.NK_BOOL {
                        val bval: i64 = cexpr.d0 as i64
                        val bstr: mut ref u8 = c"0"
                        if bval != 0 {
                            cg_register_module_const(ctx, cname, c"1")
                            bstr = c"1"
                        } else {
                            cg_register_module_const(ctx, cname, c"0")
                        }
                        if cg_emit_label_if_new(ctx, const_label) {
                            val data_buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(
                                data_buf3,
                                256,
                                "data ${s} = \{ w {s} \}\n",
                                {const_label, bstr}
                            )
                            emit(ctx, data_buf3)
                        } else { }
                    } elif cexpr.kind == parser.NK_LIST_LIT {
                        if cg_emit_label_if_new(ctx, const_label) {
                            emit_global_list_literal(ctx, const_label, cexpr)
                            cg_register_global(ctx, cname, const_label, c"l", c"")
                        } else { }
                    } elif cexpr.kind == parser.NK_BUILTIN {
                        if !cg_emit_embed_const(ctx, cname, const_label, cexpr) { }
                    } else {
                        emit_const_runtime_global(ctx, mod_prefix, node)
                    }
                }
            }
        }
        i++
    }
}

/// Returns true if the items contain any external link statements.
fn items_have_external_links(items: list[ref parser.Node]) bool = trust {
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val node: ref parser.Node = @load(cg_list_slot(items as ref void, i)) as ref parser.Node
        if node.kind == parser.NK_LINK || node.kind == parser.NK_LIB {
            return true
        }
        if node.kind == parser.NK_WHEN_ITEMS {
            val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
            if items_have_external_links(witems) {
                return true
            }
            val or_when_branches: ref void = node.d2 as ref void
            if or_when_branches != none {
                for ow in or_when_branches as list[ref parser.Node] {
                    val ow_items: list[ref parser.Node] = ow.d1 as list[ref parser.Node]
                    if items_have_external_links(ow_items) {
                        return true
                    }
                }
            }
            val ow_otherwise: ref void = node.d3 as ref void
            if ow_otherwise != none {
                if items_have_external_links(ow_otherwise as list[ref parser.Node]) {
                    return true
                }
            }
        }
        i++
    }
    return false
}

/// Mark the owning module of an already-qualified function name as used.
///
/// `resolve_callee_name` returns names such as `json__build_object`, while
/// `cg_resolve_fn_name` is normally given the bare `build_object`. Without
/// this, test mode's usage pruning can emit callers but omit the module that
/// defines their callees.
fn cg_mark_name_prefix(ctx: mut ref CgCtx, name: ref u8) void = trust {
    val n: i64 = str.len_raw(name)
    val sep: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i + 1 >= n {
            break
        }
        if @load8(@ptradd(name, i)) == 95 && @load8(@ptradd(name, i + 1)) == 95 {
            sep = i
            i += 2
        } else {
            i++
        }
    }
    if sep <= 0 {
        return
    }
    val prefix: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        (sep + 1) as usize
    ) as ref u8
    @memcpy(prefix, name, sep as usize)
    @store8(@ptradd(prefix, sep), 0)
    val plen: i64 = sep
    val pi: mut i64 = 0
    for {
        if pi >= plen {
            break
        }
        if pi + 1 < plen && @load8(@ptradd(prefix, pi)) == 95 &&
        @load8(@ptradd(prefix, pi + 1)) == 95 {
            val sub_prefix: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (pi + 1) as usize
            ) as ref u8
            @memcpy(sub_prefix, prefix, pi as usize)
            @store8(@ptradd(sub_prefix, pi), 0)
            cg_mark_prefix_used(ctx, sub_prefix)
            pi++
        }
        pi++
    }
    cg_mark_prefix_used(ctx, prefix)
}

/// Scan items for function calls to track which modules are used, without emitting code.
fn scan_items_for_usage(
    ctx: mut ref CgCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val node: ref parser.Node = @load(cg_list_slot(items as ref void, i)) as ref parser.Node
        val k: i64 = node.kind
        if k == parser.NK_FN {
            val body: ref void = node.d5 as ref void
            if body != none {
                val blen: i64 = @len(body as list[ref parser.Node]) as i64
                val bi: mut i64 = 0
                for {
                    if bi >= blen {
                        break
                    }
                    val stmt: ref parser.Node = @load(cg_list_slot(body, bi)) as ref parser.Node
                    scan_node_for_calls_depth(ctx, stmt, 0)
                    bi++
                }
            }
        } elif k == parser.NK_WHEN_ITEMS {
            val plat: ref u8 = parser.node_str_raw(node.d0)
            if cg_platform_matches(ctx, plat) {
                val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
                scan_items_for_usage(ctx, witems, mod_prefix)
            }
        }
        i++
    }
}

/// Scan a statement list (function body) for calls.
fn scan_stmts_for_calls(ctx: mut ref CgCtx, stmts: ref void) void = trust {
    if stmts == none {
        return
    }

    val slen: i64 = @len(stmts as list[ref parser.Node]) as i64
    if slen < 0 || slen > 100000 {
        return
    }
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val stmt: ref parser.Node = @load(cg_list_slot(stmts, si)) as ref parser.Node
        scan_node_for_calls_depth(ctx, stmt, 0)
        si++
    }
}

/// Recursively scan a node tree for function calls to mark prefixes as used, with depth limit.
fn scan_node_for_calls_depth(ctx: mut ref CgCtx, node: ref parser.Node, depth: i64) void = trust {
    if node == none {
        return
    }
    if depth > 100 {
        return
    }

    val k: i64 = node.kind

    if k == parser.NK_CALL {
        val callee: ref parser.Node = parser.call_callee(node)
        if callee != none {
            if callee.kind == parser.NK_IDENT || callee.kind == parser.NK_FIELD {
                val callee_name: ref u8 = resolve_callee_name(ctx, callee)
                cg_resolve_fn_name(ctx, callee_name)
                cg_mark_name_prefix(ctx, callee_name)
            } elif callee.kind == parser.NK_GENERIC_INST {
                val gi_base: ref parser.Node = parser.generic_inst_base(callee)
                val gi_name: ref u8 = generic_callee_base_name(ctx, gi_base)
                cg_resolve_fn_name(ctx, gi_name)
                cg_mark_name_prefix(ctx, gi_name)
            }
            scan_node_for_calls_depth(ctx, callee, depth + 1)
        }
        val args: ref void = parser.call_args(node) as ref void
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg: ref parser.Node = @load(cg_list_slot(args, ai)) as ref parser.Node
                scan_node_for_calls_depth(ctx, arg, depth + 1)
                ai++
            }
        }
    } elif k == parser.NK_IDENT {
        val name: ref u8 = parser.node_str_raw(node.d0)
        cg_resolve_fn_name(ctx, name)
        cg_mark_name_prefix(ctx, name)
    } elif k == parser.NK_FIELD {
        scan_node_for_calls_depth(ctx, parser.field_base(node), depth + 1)
    } elif k == parser.NK_IF {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
        val then_stmts: ref void = node.d1 as ref void
        if then_stmts != none {
            scan_stmts_for_calls(ctx, then_stmts)
        }
        val else_stmts: ref void = node.d2 as ref void
        if else_stmts != none {
            scan_stmts_for_calls(ctx, else_stmts)
        }
    } elif k == parser.NK_FOR {
        val body: ref void = node.d4 as ref void
        if body != none {
            scan_stmts_for_calls(ctx, body)
        }
    } elif k == parser.NK_FORIN {
        scan_node_for_calls_depth(ctx, node.d2 as ref parser.Node, depth + 1)
        val body: ref void = node.d3 as ref void
        if body != none {
            scan_stmts_for_calls(ctx, body)
        }
    } elif k == parser.NK_MATCH_OPT {
        val mexpr = parser.match_opt_expr(node)
        if mexpr != none {
            scan_node_for_calls_depth(ctx, mexpr, depth + 1)
        }
        val some_body = parser.match_opt_some_body(node)
        if some_body != none {
            val some_stmts: ref void = some_body.d0 as ref void
            if some_stmts != none {
                scan_stmts_for_calls(ctx, some_stmts)
            }
        }
        val none_body = parser.match_opt_none_body(node)
        if none_body != none {
            val none_stmts: ref void = none_body.d0 as ref void
            if none_stmts != none {
                scan_stmts_for_calls(ctx, none_stmts)
            }
        }
    } elif k == parser.NK_MATCH_RES {
        val rexpr = parser.match_res_expr(node)
        if rexpr != none {
            scan_node_for_calls_depth(ctx, rexpr, depth + 1)
        }
        val ok_body = parser.match_res_ok_body(node)
        if ok_body != none {
            val ok_stmts: ref void = ok_body.d0 as ref void
            if ok_stmts != none {
                scan_stmts_for_calls(ctx, ok_stmts)
            }
        }
        val err_body = parser.match_res_err_body(node)
        if err_body != none {
            val err_stmts: ref void = err_body.d0 as ref void
            if err_stmts != none {
                scan_stmts_for_calls(ctx, err_stmts)
            }
        }
    } elif k == parser.NK_MATCH_ENUM {
        val mexpr2 = parser.match_enum_expr(node)
        if mexpr2 != none {
            scan_node_for_calls_depth(ctx, mexpr2, depth + 1)
        }
        val arms = parser.match_enum_arms(node)
        val alen: i64 = @len(arms) as i64
        if alen > 0 {
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arm: ref parser.Node = @load(cg_list_slot(
                        arms as ref void,
                        ai
                    )) as ref parser.Node
                val arm_body = parser.match_enum_arm_body(arm)
                scan_stmts_for_calls(ctx, arm_body as ref void)
                ai++
            }
        }
    } elif k == parser.NK_MATCH_VALUE {
        val mexprv = parser.match_value_expr(node)
        if mexprv != none {
            scan_node_for_calls_depth(ctx, mexprv, depth + 1)
        }
        val varms = parser.match_value_arms(node)
        val valen: i64 = @len(varms) as i64
        if valen > 0 {
            val vai: mut i64 = 0
            for {
                if vai >= valen {
                    break
                }
                val varm: ref parser.Node = @load(cg_list_slot(
                        varms as ref void,
                        vai
                    )) as ref parser.Node
                val vpat = parser.match_value_arm_pattern(varm)
                if vpat != none {
                    scan_node_for_calls_depth(ctx, vpat, depth + 1)
                }
                val varm_body = parser.match_value_arm_body(varm)
                scan_stmts_for_calls(ctx, varm_body as ref void)
                vai++
            }
        }
        val velse = parser.match_value_else(node)
        if velse != none {
            val velse_stmts: ref void = velse.d0 as ref void
            if velse_stmts != none {
                scan_stmts_for_calls(ctx, velse_stmts)
            }
        }
    } elif k == parser.NK_MATCH_STR {
        val mexpr3 = parser.match_str_expr(node)
        if mexpr3 != none {
            scan_node_for_calls_depth(ctx, mexpr3, depth + 1)
        }
        val sarms = parser.match_str_arms(node)
        val salen: i64 = @len(sarms) as i64
        if salen > 0 {
            val sai: mut i64 = 0
            for {
                if sai >= salen {
                    break
                }
                val sarm: ref parser.Node = @load(cg_list_slot(
                        sarms as ref void,
                        sai
                    )) as ref parser.Node
                val sarm_body = parser.match_str_arm_body(sarm)
                scan_stmts_for_calls(ctx, sarm_body as ref void)
                sai++
            }
        }
        val selse = parser.match_str_else(node)
        if selse != none {
            val selse_stmts: ref void = selse.d0 as ref void
            if selse_stmts != none {
                scan_stmts_for_calls(ctx, selse_stmts)
            }
        }
    } elif k == parser.NK_MATCH_UNION {
        val uexpr = parser.match_union_expr(node)
        if uexpr != none {
            scan_node_for_calls_depth(ctx, uexpr, depth + 1)
        }
        val uarms = parser.match_union_arms(node)
        val ualen: i64 = @len(uarms) as i64
        if ualen > 0 {
            val uai: mut i64 = 0
            for {
                if uai >= ualen {
                    break
                }
                val uarm: ref parser.Node = @load(cg_list_slot(
                        uarms as ref void,
                        uai
                    )) as ref parser.Node
                val uarm_body = parser.match_union_arm_body(uarm)
                scan_stmts_for_calls(ctx, uarm_body as ref void)
                uai++
            }
        }
        val uelse = parser.match_union_else(node)
        if uelse != none {
            val uelse_stmts: ref void = uelse.d0 as ref void
            if uelse_stmts != none {
                scan_stmts_for_calls(ctx, uelse_stmts)
            }
        }
    } elif k == parser.NK_MATCH_TAGGED_UNION {
        val texpr = parser.match_tagged_union_expr(node)
        if texpr != none {
            scan_node_for_calls_depth(ctx, texpr, depth + 1)
        }
        val tarms = parser.match_tagged_union_arms(node)
        val talen: i64 = @len(tarms) as i64
        if talen > 0 {
            val tai: mut i64 = 0
            for {
                if tai >= talen {
                    break
                }
                val tarm: ref parser.Node = @load(cg_list_slot(
                        tarms as ref void,
                        tai
                    )) as ref parser.Node
                val tarm_body = parser.match_tagged_union_arm_body(tarm)
                scan_stmts_for_calls(ctx, tarm_body as ref void)
                tai++
            }
        }
        val telse = parser.match_tagged_union_else(node)
        if telse != none {
            val telse_stmts: ref void = telse.d0 as ref void
            if telse_stmts != none {
                scan_stmts_for_calls(ctx, telse_stmts)
            }
        }
    } elif k == parser.NK_RETURN {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_ASSIGN {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
        scan_node_for_calls_depth(ctx, node.d1 as ref parser.Node, depth + 1)
    } elif k == parser.NK_VAL {
        scan_node_for_calls_depth(ctx, node.d3 as ref parser.Node, depth + 1)
    } elif k == parser.NK_BINOP {
        scan_node_for_calls_depth(ctx, parser.binop_left(node), depth + 1)
        scan_node_for_calls_depth(ctx, parser.binop_right(node), depth + 1)
    } elif k == parser.NK_UNOP {
        scan_node_for_calls_depth(ctx, parser.unop_inner(node), depth + 1)
    } elif k == parser.NK_FIELD {
        scan_node_for_calls_depth(ctx, parser.field_base(node), depth + 1)
    } elif k == parser.NK_BUILTIN {
        val args: ref void = node.d1 as ref void
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val arg: ref parser.Node = @load(cg_list_slot(args, ai)) as ref parser.Node
                scan_node_for_calls_depth(ctx, arg, depth + 1)
                ai++
            }
        }
    } elif k == parser.NK_CAST {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_STRUCT_LIT {
        val fields: ref void = node.d1 as ref void
        if fields != none {
            val flen: i64 = @len(fields as list[ref parser.Node]) as i64
            val fi: mut i64 = 0
            for {
                if fi >= flen {
                    break
                }
                val field: ref parser.Node = @load(cg_list_slot(fields, fi)) as ref parser.Node
                scan_node_for_calls_depth(ctx, field.d1 as ref parser.Node, depth + 1)
                fi++
            }
        }
    } elif k == parser.NK_LIST_LIT {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems as list[ref parser.Node]) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val elem: ref parser.Node = @load(cg_list_slot(elems, ei)) as ref parser.Node
                scan_node_for_calls_depth(ctx, elem, depth + 1)
                ei++
            }
        }
    } elif k == parser.NK_ARGS_PACK {
        val elems: ref void = node.d0 as ref void
        if elems != none {
            val elen: i64 = @len(elems as list[ref parser.Node]) as i64
            val ei: mut i64 = 0
            for {
                if ei >= elen {
                    break
                }
                val elem: ref parser.Node = @load(cg_list_slot(elems, ei)) as ref parser.Node
                scan_node_for_calls_depth(ctx, elem, depth + 1)
                ei++
            }
        }
    } elif k == parser.NK_EXPR_STMT {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_DEFER {
        val body: ref void = node.d0 as ref void
        if body != none {
            scan_stmts_for_calls(ctx, body)
        }
    } elif k == parser.NK_TRUST_BLOCK {
        val body: ref void = node.d0 as ref void
        if body != none {
            scan_stmts_for_calls(ctx, body)
        }
    } elif k == parser.NK_TRY {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_SOME {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_OK_VAL {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_ERR_VAL {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_ADDR {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    } elif k == parser.NK_DEREF {
        scan_node_for_calls_depth(ctx, node.d0 as ref parser.Node, depth + 1)
    }
}

fn cg_contains_raw(haystack: ref u8, needle: ref u8) bool = trust {
    return strstr(haystack, needle) != none
}

fn cg_qbe_char_at(qbe: ref u8, index: i64, at_end: bool) i64 = trust {
    if at_end {
        return 10
    }
    return @load8(@ptradd(qbe, index)) as i64
}

fn cg_qbe_is_line_end(c: i64, at_end: bool) bool = trust {
    if at_end {
        return true
    }
    if c == 10 {
        return true
    }
    return false
}

fn cg_qbe_is_fn_header(line: ref u8) bool = trust {
    if str.raw_starts_with(line, c"function ") {
        return true
    }
    if str.raw_starts_with(line, c"export function ") {
        return true
    }
    return false
}

fn cg_append_qbe_line(out: ref void, line: ref u8) void = trust {
    str.StringBuilder.append_cstr(out, line)
    str.StringBuilder.append_char(out, 10 as u8)
}

fn cg_flush_qbe_fn(
    out: ref void,
    lines: list[ref u8],
    allocs: list[ref u8],
    insert_at: i64
) void = trust {
    val llen: i64 = @len(lines) as i64
    val alen: i64 = @len(allocs) as i64
    val i: mut i64 = 0
    for {
        if i >= llen {
            break
        }
        if i == insert_at {
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val a_opt = @get(allocs, ai as usize)
                if a_opt is some a {
                    cg_append_qbe_line(out, a as ref u8)
                    @free(a)
                }
                ai++
            }
        }
        val l_opt = @get(lines, i as usize)
        if l_opt is some l {
            cg_append_qbe_line(out, l as ref u8)
            @free(l as ref void)
        }
        i++
    }
    if insert_at >= llen {
        val ai2: mut i64 = 0
        for {
            if ai2 >= alen {
                break
            }
            val a2_opt = @get(allocs, ai2 as usize)
            if a2_opt is some a2 {
                cg_append_qbe_line(out, a2 as ref u8)
                @free(a2 as ref void)
            }
            ai2++
        }
    }
}

/// QBE lowers each alloc instruction to a dynamic stack adjustment at its
/// execution point. Allocations emitted inside loops therefore grow the stack
/// every iteration and eventually overflow it. Hoist every allocation in a
/// function to just after its @start label so each one is performed only once
/// per call. Allocation sizes in this backend are always compile-time constants.
fn cg_hoist_qbe_allocs(qbe: ref u8) ref u8 = trust {
    val out: ref void = str.StringBuilder.new()
    val lines: mut list[ref u8] = mem.new[ref u8]()
    val allocs: mut list[ref u8] = mem.new[ref u8]()
    val in_fn: mut bool = false
    val insert_at: mut i64 = 1
    val n: i64 = str.len_raw(qbe)
    val i: mut i64 = 0
    val ls: mut i64 = 0
    for {
        if i > n {
            break
        }
        val at_end: bool = i == n
        if at_end {
            if i == ls {
                break
            }
        }
        val c: i64 = cg_qbe_char_at(qbe, i, at_end)
        if cg_qbe_is_line_end(c, at_end) {
            val line: ref u8 = str.substr(qbe, ls, i - ls)
            if !in_fn {
                if cg_qbe_is_fn_header(line) {
                    in_fn = true
                    lines = mem.new[ref u8]()
                    allocs = mem.new[ref u8]()
                    insert_at = 1
                    @append(lines, line)
                } else {
                    cg_append_qbe_line(out, line)
                    @free(line)
                }
            } else {
                if str.raw_cmp(line, c"}") == 0 {
                    cg_flush_qbe_fn(out, lines, allocs, insert_at)
                    cg_append_qbe_line(out, line)
                    @free(line)
                    in_fn = false
                } elif cg_contains_raw(line, c"=l alloc") {
                    @append(allocs, line)
                } else {
                    @append(lines, line)
                    if str.raw_cmp(line, c"@start") == 0 {
                        insert_at = @len(lines) as i64
                    }
                }
            }
            if at_end {
                break
            }
            ls = i + 1
        }
        i++
    }
    if in_fn {
        cg_flush_qbe_fn(out, lines, allocs, insert_at)
        cg_append_qbe_line(out, c"}")
    }
    val built: ref void = str.StringBuilder.build(out)
    val result: ref u8 = str.cstr(built)
    str.StringBuilder.free(out)
    @free(built)
    @free(qbe)
    return result
}

fn cg_finish_qbe(ctx: mut ref CgCtx) ref u8 = trust {
    val mono_built: ref void = str.StringBuilder.build(ctx.mono_sb)
    val mono_str: ref u8 = str.cstr(mono_built)
    str.StringBuilder.append_cstr(cg_sb(ctx), mono_str)
    str.StringBuilder.free(ctx.mono_sb)
    @free(@load(mono_built))
    @free(mono_built)

    val embed_built: ref void = str.StringBuilder.build(ctx.embed_sb)
    str.StringBuilder.append_cstr(cg_sb(ctx), str.cstr(embed_built))
    str.StringBuilder.free(ctx.embed_sb)
    @free(@load(embed_built))
    @free(embed_built)

    val built: ref void = str.StringBuilder.build(cg_sb(ctx))
    val result: ref u8 = str.cstr(built)
    str.StringBuilder.free(cg_sb(ctx))
    @free(built)
    return cg_hoist_qbe_allocs(result)
}

/// Main entry for the resolved module tree.
/// Flattens children depth-first, emits each layer with its mangled prefix.
pub fn gen_module_resolved(
    root: ref module.ResolvedModule,
    release_mode: bool,
    src_target: ref u8,
    leak_check: bool
) ref CgOutput = trust {
    val ctx: mut ref CgCtx = cg_new()
    defer {
        val arena = ctx.arena
        cg_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }
    ctx.release_mode = release_mode
    ctx.leak_check = leak_check
    ctx.src_target = src_target
    ctx.current_filename = module.module_filename(root)
    emit_runtime_helpers(ctx)

    val out_prefixes: mut list[ref u8] = mem.new[ref u8]()
    val out_items: mut list[ref void] = mem.new[ref void]()
    val out_filenames: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[String] = mem.new[String]()

    module.flatten_modules_with_files(ctx.arena,
        root, c"",
        out_prefixes,
        out_items,
        out_filenames,
        seen
    )

    val layers: i64 = @len(out_prefixes) as i64

    cg_mark_prefix_used(ctx, c"")

    val li: mut i64 = 0
    for {
        if li >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li as usize)
        val items_opt = @get(out_items, li as usize)
        if pfx_opt is some pfx {
            if items_opt is some items_ptr {
                val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                preregister_items(ctx, items, pfx as ref u8)
                if str.raw_cmp(pfx as ref u8, c"") == 0 {
                    scan_items_for_usage(ctx, items, c"")
                }
            }
        }
        li++
    }

    val scan_pass: mut i64 = 0
    for {
        if scan_pass >= 10 {
            break
        }
        scan_pass++

        val li_scan: mut i64 = 0
        for {
            if li_scan >= layers {
                break
            }
            val pfx_scan_opt = @get(out_prefixes, li_scan as usize)
            val items_scan_opt = @get(out_items, li_scan as usize)
            if pfx_scan_opt is some pfx_scan {
                if cg_is_prefix_used(ctx, pfx_scan as ref u8) {
                    if items_scan_opt is some items_scan_ptr {
                        val items_scan: list[ref parser.Node] = items_scan_ptr as list[ref parser.Node]
                        scan_items_for_usage(ctx, items_scan, pfx_scan as ref u8)
                    }
                }
            }
            li_scan++
        }
    }

    if cg_is_prefix_used(ctx, c"std") {
        val li_std: mut i64 = 0
        for {
            if li_std >= layers {
                break
            }
            val pfx_std_opt = @get(out_prefixes, li_std as usize)
            if pfx_std_opt is some pfx_std {
                val pfx_str: ref u8 = pfx_std as ref u8
                if is_std_child_name(pfx_str) {
                    cg_mark_prefix_used(ctx, pfx_str)
                }
            }
            li_std++
        }
    }

    val li2: mut i64 = 0
    for {
        if li2 >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li2 as usize)
        val items_opt = @get(out_items, li2 as usize)
        if pfx_opt is some pfx {
            if items_opt is some items_ptr {
                val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                val fname_opt = @get(out_filenames, li2 as usize)
                if fname_opt is some fname {
                    ctx.current_filename = fname as ref u8
                } else {
                    ctx.current_filename = c""
                }
                val is_root2: bool = str.raw_cmp(pfx as ref u8, c"") == 0
                val is_used2: bool = cg_is_prefix_used(ctx, pfx as ref u8)
                val has_links: bool = items_have_external_links(items)

                if !has_links || is_root2 || is_used2 {
                    gen_items_with_prefix(ctx, items, pfx as ref u8)
                } else {
                    gen_items_with_prefix_skip_links(ctx, items, pfx as ref u8)
                }
            }
        }
        li2++
    }

    cg_emit_global_init(ctx)
    emit_string_data(ctx)

    val cg_out: mut ref CgOutput = @alloc(@sizeof(CgOutput)) as ref CgOutput
    cg_out.qbe = cg_finish_qbe(ctx)
    cg_out.shim = cg_build_c_shim(ctx)
    return cg_out
}

pub fn get_used_prefixes(root: ref module.ResolvedModule) list[ref u8] = trust {
    val ctx: mut ref CgCtx = cg_new()
    defer {
        val arena = ctx.arena
        cg_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }

    val out_prefixes: mut list[ref u8] = mem.new[ref u8]()
    val out_items: mut list[ref void] = mem.new[ref void]()
    val seen: mut list[String] = mem.new[String]()

    module.flatten_modules(ctx.arena,
        root, c"",
        out_prefixes,
        out_items,
        seen
    )

    val layers: i64 = @len(out_prefixes) as i64

    cg_mark_prefix_used(ctx, c"")

    val li: mut i64 = 0
    for {
        if li >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li as usize)
        val items_opt = @get(out_items, li as usize)
        if pfx_opt is some pfx {
            if items_opt is some items_ptr {
                val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                preregister_items(ctx, items, pfx as ref u8)
            }
        }
        li++
    }

    val li2: mut i64 = 0
    for {
        if li2 >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li2 as usize)
        val items_opt = @get(out_items, li2 as usize)
        if pfx_opt is some pfx {
            if cg_is_prefix_used(ctx, pfx as ref u8) {
                if items_opt is some items_ptr {
                    val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                    scan_items_for_usage(ctx, items, pfx as ref u8)
                }
            }
        }
        li2++
    }

    if cg_is_prefix_used(ctx, c"std") {
        val li_std: mut i64 = 0
        for {
            if li_std >= layers {
                break
            }
            val pfx_std_opt = @get(out_prefixes, li_std as usize)
            if pfx_std_opt is some pfx_std {
                val pfx_str: ref u8 = pfx_std as ref u8
                if is_std_child_name(pfx_str) {
                    cg_mark_prefix_used(ctx, pfx_str)
                }
            }
            li_std++
        }
    }

    val result: list[ref u8] = ctx.used_prefixes
    return result
}

/// Emit a single test block as a numbered function. Returns the function name.
fn gen_test_fn(ctx: mut ref CgCtx, body_stmts: ref parser.Node, test_id: i64) void = trust {
    cg_dvars_clear(ctx)
    val fname: ref u8 = arenafmt.format(ctx.arena, "__sx_test_{lld}", {test_id}).ptr
    val hdr: ref u8 = arenafmt.format(
        ctx.arena,
        "export function w ${s}() {\n@start\n",
        {fname}
    ).ptr
    emit(ctx, hdr)
    val gnames_list: ref void = cg_global_src_names(ctx)
    val glen: i64 = @len(gnames_list) as i64
    val gi: mut i64 = 0
    for {
        if gi >= glen {
            break
        }
        val gn_opt = @get(gnames_list, gi as usize)
        if gn_opt is some gn {
            val glbl_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val gqt_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                8 as usize
            ) as ref u8
            val gann_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            val found: bool = cg_lookup_global(ctx, gn as ref u8, glbl_buf, gqt_buf, gann_buf)
            if found && cg_lookup_local_var(ctx, gn as ref u8) == c"" {
                val dollar_label: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    260 as usize
                ) as ref u8
                @snprintf(dollar_label, 260, "${s}", {glbl_buf})
                cg_register_local_var(ctx, gn as ref u8, dollar_label)
                val is_fixed_arr_global2: bool = @load8(gann_buf) as i64 == 91
                if !is_fixed_arr_global2 {
                    cg_mark_as_slot(ctx, gn as ref u8)
                }
                if str.raw_cmp(gann_buf, c"") != 0 {
                    val gann_copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        (str.len_raw(gann_buf) + 1) as usize
                    ) as ref u8
                    @memcpy(gann_copy, gann_buf, str.len_raw(gann_buf) + 1)
                    cg_register_local_type(ctx, gn as ref u8, gann_copy)
                    if raw_starts_with(
                        gann_copy,
                        c"ref "
                    ) || raw_starts_with(
                        gann_copy,
                        c"mut ref "
                    ) || cg_ann_is_indirect_value(ctx, gann_copy) {
                        cg_register_local_ref_type(ctx, gn as ref u8)
                    }
                } elif str.raw_cmp(gqt_buf, c"w") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"i32")
                } elif str.raw_cmp(gqt_buf, c"s") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f32")
                } elif str.raw_cmp(gqt_buf, c"d") == 0 {
                    cg_register_local_type(ctx, gn as ref u8, c"f64")
                }
            }
        }
        gi++
    }
    gen_stmts(ctx, body_stmts)
    cg_emit_defers(ctx)
    emitln(ctx, c"    ret 0")
    emitln(ctx, c"}")
    emitln(ctx, c"")
}

/// Emit a $main that calls all collected test functions and prints a summary.
fn gen_test_main(
    ctx: mut ref CgCtx,
    test_ids: list[i64],
    test_names: list[ref u8]
) void = trust {
    emitln(ctx, c"export function w $main(w %argc, l %argv) {")
    emitln(ctx, c"@start")
    emitln(ctx, c"    %sx_argc_val =l extsw %argc")
    emitln(ctx, c"    storel %sx_argc_val, $sx_argc_store")
    emitln(ctx, c"    storel %argv, $sx_argv_store")
    if !ctx.release_mode {
        emitln(ctx, c"    call $__sx_panic_init()")
    }
    emitln(ctx, c"    call $__sx_global_init()")
    val tlen: i64 = @len(test_ids) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val id_opt = @get(test_ids, ti as usize)
        if id_opt is some id {
            val call: ref u8 = arenafmt.format(
                ctx.arena,
                "    call $__sx_test_{lld}()\n",
                {id as i64}
            ).ptr
            emit(ctx, call)
            val name_opt = @get(test_names, ti as usize)
            if name_opt is some name_val {
                val tname: ref u8 = name_val as ref u8
                if tname != none && str.len_raw(tname) > 0 {
                    val fmt_idx: i64 = intern_string_raw(ctx, c"[pass] %s\n")
                    val name_idx: i64 = intern_string_raw(ctx, tname)
                    val fmt_tmp: i64 = fresh_tmp(ctx)
                    val name_tmp: i64 = fresh_tmp(ctx)
                    val call_tmp: i64 = fresh_tmp(ctx)
                    val pbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    @snprintf(
                        pbuf,
                        256,
                        "    %%t{lld} =l copy $__str{lld}\n    %%t{lld} =l copy $__str{lld}\n    %%t{lld} =w call $printf(l %%t{lld}, ..., l %%t{lld})\n",
                        {fmt_tmp, fmt_idx, name_tmp, name_idx, call_tmp, fmt_tmp, name_tmp}
                    )
                    emit(ctx, pbuf)
                }
            }
        }
        ti++
    }
    val ok_idx: i64 = intern_string_raw(ctx, c"[note] all tests passed\n")
    val ok_tmp: i64 = fresh_tmp(ctx)
    val ok_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(ok_buf, 128, "    %%t{lld} =l copy $__str{lld}\n    call $printf(l %%t{lld})\n    ret 0\n}\n\n",
        {ok_tmp, ok_idx, ok_tmp})
    emit(ctx, ok_buf)
}

/// Entry point for -test mode: emits test blocks from root module only,
/// suppresses main(), and emits a test runner $main.
pub fn gen_module_resolved_test(
    root: ref module.ResolvedModule,
    release_mode: bool,
    src_target: ref u8,
    leak_check: bool
) ref CgOutput = trust {
    val ctx: mut ref CgCtx = cg_new()
    defer {
        val arena = ctx.arena
        cg_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }
    ctx.release_mode = release_mode
    ctx.leak_check = leak_check
    ctx.src_target = src_target
    ctx.current_filename = module.module_filename(root)
    emit_runtime_helpers(ctx)

    val out_prefixes: mut list[ref u8] = mem.new[ref u8]()
    val out_items: mut list[ref void] = mem.new[ref void]()
    val out_filenames: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[String] = mem.new[String]()

    module.flatten_modules_with_files(ctx.arena,
        root, c"",
        out_prefixes,
        out_items,
        out_filenames,
        seen
    )

    val layers: i64 = @len(out_prefixes) as i64

    cg_mark_prefix_used(ctx, c"")

    val root_imports: list[ref u8] = root.import_names
    val rimp_len: i64 = @len(root_imports) as i64
    val ri_idx: mut i64 = 0
    for {
        if ri_idx >= rimp_len {
            break
        }
        val imp_opt = @get(root_imports, ri_idx as usize)
        if imp_opt is some imp_name {
            cg_mark_prefix_used(ctx, imp_name as ref u8)
        }
        ri_idx++
    }

    val li: mut i64 = 0
    for {
        if li >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li as usize)
        val items_opt = @get(out_items, li as usize)
        if pfx_opt is some pfx {
            if items_opt is some items_ptr {
                val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                preregister_items(ctx, items, pfx as ref u8)
            }
        }
        li++
    }

    val test_ids: mut list[i64] = mem.new[i64]()
    val test_names: mut list[ref u8] = mem.new[ref u8]()
    val test_counter: mut i64 = 0
    val root_items: list[ref parser.Node] = root.items
    val rlen: i64 = @len(root_items) as i64
    val ri: mut i64 = 0
    for {
        if ri >= rlen {
            break
        }
        val item_opt = @get(root_items, ri as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            if node.kind == parser.NK_TEST {
                val body: ref void = node.d0 as ref void
                if body != none {
                    scan_stmts_for_calls(ctx, body)
                }
            }
        }
        ri++
    }

    val scan_pass: mut i64 = 0
    for {
        if scan_pass >= 10 {
            break
        }
        scan_pass++

        val li_scan: mut i64 = 0
        for {
            if li_scan >= layers {
                break
            }
            val pfx_scan_opt = @get(out_prefixes, li_scan as usize)
            val items_scan_opt = @get(out_items, li_scan as usize)
            if pfx_scan_opt is some pfx_scan {
                if cg_is_prefix_used(ctx, pfx_scan as ref u8) {
                    if items_scan_opt is some items_scan_ptr {
                        val items_scan: list[ref parser.Node] = items_scan_ptr as list[ref parser.Node]
                        scan_items_for_usage(ctx, items_scan, pfx_scan as ref u8)
                    }
                }
            }
            li_scan++
        }
    }

    if cg_is_prefix_used(ctx, c"std") {
        val li_std: mut i64 = 0
        for {
            if li_std >= layers {
                break
            }
            val pfx_std_opt = @get(out_prefixes, li_std as usize)
            if pfx_std_opt is some pfx_std {
                val pfx_str: ref u8 = pfx_std as ref u8
                if is_std_child_name(pfx_str) {
                    cg_mark_prefix_used(ctx, pfx_str)
                }
            }
            li_std++
        }
    }

    val li2: mut i64 = 0
    for {
        if li2 >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li2 as usize)
        val items_opt = @get(out_items, li2 as usize)
        if pfx_opt is some pfx {
            val fname_opt = @get(out_filenames, li2 as usize)
            if fname_opt is some fname {
                ctx.current_filename = fname as ref u8
            } else {
                ctx.current_filename = c""
            }
            val is_root: bool = str.raw_cmp(pfx as ref u8, c"") == 0
            val is_used: bool = cg_is_prefix_used(ctx, pfx as ref u8)

            if items_opt is some items_ptr {
                val items: list[ref parser.Node] = items_ptr as list[ref parser.Node]
                val has_links: bool = items_have_external_links(items)

                if is_root || is_used || !has_links {
                    if is_root {
                        gen_items_with_prefix_skip_main(ctx, items, c"")
                    } else {
                        gen_items_with_prefix(ctx, items, pfx as ref u8)
                    }
                }
            }
        }
        li2++
    }

    val ri2: mut i64 = 0
    for {
        if ri2 >= rlen {
            break
        }
        val item_opt = @get(root_items, ri2 as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            if node.kind == parser.NK_TEST {
                test_counter++
                @append(test_ids, test_counter)
                @append(test_names, parser.test_name_raw(node))
                gen_test_fn(ctx, node.d0 as ref parser.Node, test_counter)
            }
        }
        ri2++
    }

    cg_emit_global_init(ctx)
    gen_test_main(ctx, test_ids, test_names)
    emit_string_data(ctx)

    val cg_out: mut ref CgOutput = @alloc(@sizeof(CgOutput)) as ref CgOutput
    cg_out.qbe = cg_finish_qbe(ctx)
    cg_out.shim = cg_build_c_shim(ctx)
    return cg_out
}

/// Like gen_items_with_prefix but skips NK_LINK and NK_LIB directives.
/// Used to emit module code without pulling in external libraries.
fn gen_items_with_prefix_skip_links(
    ctx: mut ref CgCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    preregister_items(ctx, items, mod_prefix)
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_LINK || k == parser.NK_LIB {
                // Skip link directive to avoid pulling in external library
            } elif k == parser.NK_GENERIC_FN {
                register_generic_fn(
                    ctx,
                    generic_fn_qualified_name(ctx, node, mod_prefix),
                    node,
                    mod_prefix
                )
            } elif k == parser.NK_FN {
                gen_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                val tname: ref u8 = parser.node_str_raw(node.d1)
                val tfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, tname, tfields, false)
                if node.d3 != 0 as i64 {
                    cg_register_invariant(ctx, tname, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                val etname: ref u8 = parser.node_str_raw(node.d1)
                val etfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, etname, etfields, true)
            } elif k == parser.NK_EXTERN_HEADER {
                cg_register_c_header(ctx, parser.node_str_raw(node.d0))
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = parser.node_str_raw(node.d0)
                if cg_platform_matches(ctx, plat) {
                    val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
                    gen_items_with_prefix_skip_links(ctx, witems, mod_prefix)
                }
            } elif k == parser.NK_VAL {
                emit_global_val(ctx, mod_prefix, node)
            } elif k == parser.NK_CONST {
                val cname: ref u8 = parser.node_str_raw(node.d1)
                val cexpr: ref parser.Node = node.d2 as ref parser.Node
                if cexpr != none {
                    val const_label: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    if str.raw_cmp(mod_prefix, c"") == 0 {
                        @snprintf(const_label, 512, "{s}", {cname})
                    } else {
                        @snprintf(const_label, 512, "{s}__{s}", {mod_prefix, cname})
                    }

                    if cexpr.kind == parser.NK_INT_LIT {
                        val cval: ref u8 = normalize_static_int_text(
                            ctx,
                            parser.int_lit_text_raw(cexpr)
                        )
                        cg_register_module_const(ctx, cname, cval)
                        if cg_emit_label_if_new(ctx, const_label) {
                            val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(
                                data_buf,
                                256,
                                "data ${s} = \{ l {s} \}\n",
                                {const_label, cval}
                            )
                            emit(ctx, data_buf)
                        } else { }
                    } elif cexpr.kind == parser.NK_FLOAT_LIT {
                        val ftext: ref u8 = parser.float_lit_text_raw(cexpr)
                        val fval: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(fval, 128, "d_{s}", {ftext})
                        cg_register_module_const(ctx, cname, fval)
                    } elif cexpr.kind == parser.NK_UNOP {
                        val cval: ref u8 = const_unop_value(ctx, cexpr)
                        if str.raw_cmp(cval, c"") != 0 {
                            cg_register_module_const(ctx, cname, cval)
                            if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") { } else {
                                if cg_emit_label_if_new(ctx, const_label) {
                                    val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        data_buf,
                                        256,
                                        "data ${s} = \{ l {s} \}\n",
                                        {const_label, cval}
                                    )
                                    emit(ctx, data_buf)
                                } else { }
                            }
                        } else { }
                    } elif cexpr.kind == parser.NK_CAST {
                        val target: ref u8 = type_expr_to_annotation(
                            ctx,
                            cexpr.d1 as ref parser.Node
                        )
                        val cval: ref u8 = const_cast_value(
                            ctx,
                            cexpr.d0 as ref parser.Node,
                            target
                        )
                        if str.raw_cmp(cval, c"") != 0 {
                            cg_register_module_const(ctx, cname, cval)
                            if raw_starts_with(cval, c"d_") || raw_starts_with(cval, c"s_") { } else {
                                if cg_emit_label_if_new(ctx, const_label) {
                                    val data_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                                        ctx.arena,
                                        256 as usize
                                    ) as ref u8
                                    @snprintf(
                                        data_buf,
                                        256,
                                        "data ${s} = \{ l {s} \}\n",
                                        {const_label, cval}
                                    )
                                    emit(ctx, data_buf)
                                } else { }
                            }
                        } else { }
                    } elif cexpr.kind == parser.NK_BOOL {
                        val bval: i64 = cexpr.d0 as i64
                        val bstr: mut ref u8 = c"0"
                        if bval != 0 {
                            cg_register_module_const(ctx, cname, c"1")
                            bstr = c"1"
                        } else {
                            cg_register_module_const(ctx, cname, c"0")
                        }
                        if cg_emit_label_if_new(ctx, const_label) {
                            val data_buf3: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(
                                data_buf3,
                                256,
                                "data ${s} = \{ w {s} \}\n",
                                {const_label, bstr}
                            )
                            emit(ctx, data_buf3)
                        } else { }
                    } elif cexpr.kind == parser.NK_LIST_LIT {
                        if cg_emit_label_if_new(ctx, const_label) {
                            emit_global_list_literal(ctx, const_label, cexpr)
                            cg_register_global(ctx, cname, const_label, c"l", c"")
                        } else { }
                    } elif cexpr.kind == parser.NK_BUILTIN {
                        if !cg_emit_embed_const(ctx, cname, const_label, cexpr) { }
                    } else {
                        emit_const_runtime_global(ctx, mod_prefix, node)
                    }
                }
            }
        }
        i++
    }
}

/// Kinda like gen_items_with_prefix but skips NK_FN named "main" and handles NK_TEST.
fn gen_items_with_prefix_skip_main(
    ctx: mut ref CgCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    preregister_items(ctx, items, mod_prefix)
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_GENERIC_FN {
                register_generic_fn(
                    ctx,
                    generic_fn_qualified_name(ctx, node, mod_prefix),
                    node,
                    mod_prefix
                )
            } elif k == parser.NK_FN {
                val fname: ref u8 = parser.node_str_raw(node.d2)
                if str.raw_cmp(fname, c"main") != 0 {
                    gen_fn_prefixed(ctx, node, mod_prefix)
                }
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                val tname: ref u8 = parser.node_str_raw(node.d1)
                val tfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, tname, tfields, false)
                if node.d3 != 0 as i64 {
                    cg_register_invariant(ctx, tname, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                val etname: ref u8 = parser.node_str_raw(node.d1)
                val etfields: ref void = node.d2 as ref void
                cg_register_struct(ctx, etname, etfields, true)
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = parser.node_str_raw(node.d0)
                if cg_platform_matches(ctx, plat) {
                    val witems: list[ref parser.Node] = node.d1 as list[ref parser.Node]
                    gen_items_with_prefix_skip_main(ctx, witems, mod_prefix)
                } else {
                    val or_when_branches4: ref void = node.d2 as ref void
                    val matched4: mut bool = false
                    if or_when_branches4 != none {
                        for ow4 in or_when_branches4 as list[ref parser.Node] {
                            if !matched4 {
                                val ow_plat4: ref u8 = parser.node_str_raw(ow4.d0)
                                if cg_platform_matches(ctx, ow_plat4) {
                                    val ow_items4: list[ref parser.Node] = ow4.d1 as list[ref parser.Node]
                                    gen_items_with_prefix_skip_main(ctx, ow_items4, mod_prefix)
                                    matched4 = true
                                }
                            }
                        }
                    }
                    if !matched4 {
                        val ow_otherwise4: ref void = node.d3 as ref void
                        if ow_otherwise4 != none {
                            val ow_oi4: list[ref parser.Node] = ow_otherwise4 as list[ref parser.Node]
                            gen_items_with_prefix_skip_main(ctx, ow_oi4, mod_prefix)
                        }
                    }
                }
            } elif k == parser.NK_CONST {
                val cname: ref u8 = parser.node_str_raw(node.d1)
                val cexpr: ref parser.Node = node.d2 as ref parser.Node
                if cexpr != none {
                    if cexpr.kind == parser.NK_INT_LIT {
                        cg_register_module_const(
                            ctx,
                            cname,
                            normalize_static_int_text(ctx, parser.int_lit_text_raw(cexpr))
                        )
                    } elif cexpr.kind == parser.NK_FLOAT_LIT {
                        val ftext3: ref u8 = parser.float_lit_text_raw(cexpr)
                        val fval3: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(fval3, 128, "d_{s}", {ftext3})
                        cg_register_module_const(ctx, cname, fval3)
                    } elif cexpr.kind == parser.NK_UNOP {
                        val uval: ref u8 = const_unop_value(ctx, cexpr)
                        if str.raw_cmp(uval, c"") != 0 {
                            cg_register_module_const(ctx, cname, uval)
                        }
                    } elif cexpr.kind == parser.NK_CAST {
                        val target: ref u8 = type_expr_to_annotation(
                            ctx,
                            cexpr.d1 as ref parser.Node
                        )
                        val cast_val: ref u8 = const_cast_value(
                            ctx,
                            cexpr.d0 as ref parser.Node,
                            target
                        )
                        if str.raw_cmp(cast_val, c"") != 0 {
                            cg_register_module_const(ctx, cname, cast_val)
                        }
                    } elif cexpr.kind == parser.NK_BOOL {
                        val bval2: i64 = cexpr.d0 as i64
                        if bval2 != 0 {
                            cg_register_module_const(ctx, cname, c"1")
                        } else {
                            cg_register_module_const(ctx, cname, c"0")
                        }
                    } elif cexpr.kind == parser.NK_LIST_LIT {
                        val const_label2: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            512 as usize
                        ) as ref u8
                        if str.raw_cmp(mod_prefix, c"") == 0 {
                            @snprintf(const_label2, 512, "{s}", {cname})
                        } else {
                            @snprintf(const_label2, 512, "{s}__{s}", {mod_prefix, cname})
                        }
                        if cg_emit_label_if_new(ctx, const_label2) {
                            emit_global_list_literal(ctx, const_label2, cexpr)
                            cg_register_global(ctx, cname, const_label2, c"l", c"")
                        } else { }
                    }
                }
            } elif k == parser.NK_VAL {
                emit_global_val(ctx, mod_prefix, node)
            }
        }
        i++
    }
}

// Main entry: generate QBE IR for a module (single-file, no imports).
pub fn gen_module(items: list[ref parser.Node]) ref u8 = trust {
    val ctx: mut ref CgCtx = cg_new()
    defer {
        val arena = ctx.arena
        cg_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }

    emit_runtime_helpers(ctx)
    preregister_items(ctx, items, c"")

    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0

    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val k: i64 = (item as ref parser.Node).kind
            if k == parser.NK_GENERIC_FN {
                register_generic_fn(
                    ctx,
                    generic_fn_qualified_name(ctx, item as ref parser.Node, c""),
                    item as ref parser.Node,
                    c""
                )
            } elif k == parser.NK_FN {
                gen_fn_prefixed(ctx, item as ref parser.Node, c"")
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn(ctx, item as ref parser.Node)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, item as ref parser.Node, c"")
            } elif k == parser.NK_TYPEDEF {
                // Already registered during preregister, but emit type info
            } elif k == parser.NK_EXTERN_TYPE {
                // Already registered during preregister
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, item as ref parser.Node, c"")
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, item as ref parser.Node, c"")
            }
        }
        i++
    }

    cg_emit_global_init(ctx)
    emit_string_data(ctx)

    val out = cg_finish_qbe(ctx)
    return out
}
