            val fill: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(fill, 128, "__sx_leak_fill((long long*)sx__ld{lld});\n", {t})
            emit(ctx, fill)
        }
        val res: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            64 as usize
        ) as ref u8
        @snprintf(res, 64, "(int64_t)(intptr_t)sx__ld{lld}", {t})
        return cc_expr_track(ctx, res)
    }
    if str.raw_cmp(bname, "sizeof") == 0 {
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 0 {
                val ty_opt = @get(args as list[ref parser.Node], 0 as usize)
                if ty_opt is some ty {
                    val sz: i64 = c_size_of(ctx, ty as ref parser.Node)
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        64 as usize
                    ) as ref u8
                    @snprintf(buf, 64, "INT64_C({lld})", {sz})
                    return cc_expr_track(ctx, buf)
                }
            }
        }
        return "8"
    }
    if str.raw_cmp(bname, "bitcast") == 0 {
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 1 {
                val target_ty_opt = @get(args as list[ref parser.Node], 0 as usize)
                val source_opt = @get(args as list[ref parser.Node], 1 as usize)
                if target_ty_opt is some target_ty {
                    if source_opt is some source {
                        val target_node: ref parser.Node = target_ty as ref parser.Node
                        val source_node: ref parser.Node = source as ref parser.Node
                        val target_ct: ref u8 = cc_c_type_of(ctx, target_node)
                        val source_ty: ref parser.Node = cc_infer_expr_ty(ctx, source_node)
                        val source_ct: ref u8 = cc_c_type_of(ctx, source_ty)
                        val source_expr: ref u8 = gen_expr(ctx, source_node)
                        val cap: i64 = str.len_raw(target_ct) + str.len_raw(source_ct) +
                        str.len_raw(source_expr) + 128
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            (cap) as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            cap,
                            "((union \{ {s} sx_src; {s} sx_dst; \})\{ .sx_src = ({s}) \}.sx_dst)",
