    emitln_fwd(
        ctx,
        "static void sx__rt_append_f(int64_t*lfield,int64_t elem){if(*lfield==0){int64_t*hdr=(int64_t*)calloc(1,32);hdr[1]=0;hdr[2]=0;hdr[3]=0;*lfield=(int64_t)(intptr_t)hdr;}sx__rt_append((void*)(intptr_t)(*lfield),elem);}\nstatic int64_t sx__rt_insert(void*list,int64_t idx,int64_t elem){int64_t*hdr=(int64_t*)list;if(!hdr)return 0;int64_t len=hdr[1];if(idx<0||idx>len)return 0;if(!sx__list_grow(hdr,len+1))return 0;int64_t*buf=(int64_t*)(intptr_t)hdr[0];int64_t i=len;while(i>idx){buf[i]=buf[i-1];i--;}buf[idx]=elem;hdr[1]=len+1;return 1;}\nstatic void sx__rt_insert_f(int64_t*lfield,int64_t idx,int64_t elem){if(*lfield==0){int64_t*hdr=(int64_t*)calloc(1,32);hdr[1]=0;hdr[2]=0;hdr[3]=0;*lfield=(int64_t)(intptr_t)hdr;}sx__rt_insert((void*)(intptr_t)(*lfield),idx,elem);}"
    )
    emitln_fwd(
        ctx,
        "static int64_t sx__rt_get(void*list,int64_t idx){if(!list)return 0;int64_t*hdr=(int64_t*)list;int64_t*buf=*(int64_t**)hdr;int64_t len=hdr[1];if(idx<0||idx>=len)return 0;int64_t*box=(int64_t*)calloc(1,sizeof(int64_t));if(!box)return 0;*box=buf[idx];return (int64_t)(intptr_t)box+1;}"
    )
    emitln_fwd(
        ctx,
        "static int64_t sx__rt_remove(void*list,int64_t idx){if(!list)return 0;int64_t*hdr=(int64_t*)list;int64_t*buf=*(int64_t**)hdr;int64_t len=hdr[1];if(idx<0||idx>=len)return 0;int64_t val=buf[idx];int64_t i;for(i=idx;i<len-1;i++)buf[i]=buf[i+1];hdr[1]=len-1;return val;}"
    )
    emitln_fwd(
        ctx,
        "static void sx__rt_reserve(void*list,int64_t cap){int64_t*hdr=(int64_t*)list;if(!hdr)return;if(cap>hdr[2]){sx__list_grow(hdr,cap);}}"
    )
    emitln_fwd(
        ctx,
        "static void*sx__rt_get_args(void){int64_t*hdr=(int64_t*)calloc(1,32);int64_t c=sx__argc;int64_t*buf=(int64_t*)calloc(1,(size_t)(c>0?c*8:8));char**av=(char**)(intptr_t)sx__argv;int64_t i;for(i=0;i<c;i++)buf[i]=(int64_t)(intptr_t)av[i];hdr[0]=(int64_t)(intptr_t)buf;hdr[1]=c;hdr[2]=c>0?c:1;hdr[3]=0;return hdr;}"
    )
    emitln_fwd(
        ctx,
        "static void sx__rt_printf(const char* f, int64_t* p){if(!p){printf(\"%s\",f);return;} printf(f,p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15]);}"
    )
    emitln_fwd(
        ctx,
        "#ifdef _WIN32\n#include <stdarg.h>\nstatic int sx__dprintf(int fd,const char*fmt,...){char buf[4096];va_list ap;va_start(ap,fmt);int n=vsnprintf(buf,(int)(sizeof(buf)-1),fmt,ap);va_end(ap);if(n>0)_write(fd,buf,(unsigned)n);return n;}\n#else\n#define sx__dprintf dprintf\n#endif"
    )
    emitln_fwd(
        ctx,
        "static void sx__rt_dprintf(int fd, const char* f, int64_t* p){if(!p){sx__dprintf(fd,\"%s\",f);return;} sx__dprintf(fd,f,p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15]);}"
    )
    emitln_fwd(
        ctx,
        "static char* sx__rt_fmt(const char* f, int64_t* p){char* b=(char*)malloc(4096);if(!p){strcpy(b,f);return b;} snprintf(b,4096,f,p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15]);return b;}"
    )
    if ctx.leak_check {
        emitln_fwd(ctx, codegen.leak_runtime_c_source())
    }
}

fn emit_c_panic_handler(ctx: ref CCtx) void = trust {
    if !ctx.release_mode {
        emitln_fwd(ctx, "extern void __sx_panic_init(void);")
    }
}

fn emit_string_data(ctx: ref CCtx) void = trust {
    val slen: i64 = @len(ctx.strs as list[ref u8]) as i64
    val si: mut i64 = 0
    for {
        if si >= slen {
            break
        }
        val s_opt = @get(ctx.strs as list[ref u8], si as usize)
        if s_opt is some s {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "static char sx__str{lld}[]=\"", {si})
            emit_to_fwd(ctx, buf)
            val raw: ref u8 = s as ref u8
            val rlen: i64 = str.len_raw(raw)
            val ri: mut i64 = 0
            for {
                if ri >= rlen {
                    break
                }
                val ch: u8 = @load8(@ptradd(raw, ri))
                if ch == 10 {
                    emit_to_fwd(ctx, "\\n")
                } elif ch == 13 {
                    emit_to_fwd(ctx, "\\r")
                } elif ch == 9 {
                    emit_to_fwd(ctx, "\\t")
                } elif ch == 0 {
                    emit_to_fwd(ctx, "\\0")
                } elif ch == 34 {
                    emit_to_fwd(ctx, "\\\"")
                } elif ch == 92 {
                    emit_to_fwd(ctx, "\\\\")
                } else {
                    val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        2 as usize
                    ) as ref u8
                    @store8(
                        cb,
                        ch
                    )
                    @store8(@ptradd(cb, 1), 0)
                    emit_to_fwd(ctx, cb)
                }
                ri++
            }
            emitln_fwd(ctx, "\";")
        }
        si++
    }
}

fn emit_forward_decls(ctx: ref CCtx) void = trust {
    val flen: i64 = @len(ctx.fn_names as list[ref u8]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val mangled_opt = @get(ctx.fn_names as list[ref u8], fi as usize)
        if mangled_opt is some mangled_ref {
            val mangled: ref u8 = mangled_ref as ref u8
            if str.raw_cmp(mangled, "main") == 0 {
                fi++
                continue
            }
            val nf_opt = @get(ctx.fn_no_forward as list[bool], fi as usize)
            if nf_opt is some nf {
                if nf as bool {
                    fi++
                    continue
                }
            }

            val ret_ct: mut ref u8 = "int64_t"
            val r_opt = @get(ctx.fn_rets as list[ref void], fi as usize)
            val ret_unboxed_fwd: mut bool = false
            val ret_is_void: mut bool = false
            if r_opt is some r {
                ret_ct = c_ret_type_of(ctx, r as ref parser.Node)
                ret_is_void = is_void_ret(r as ref parser.Node)
                if cc_is_unboxed_wrap(ctx, r as ref parser.Node) {
                    ret_unboxed_fwd = true
                }
            }

            val sig: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                1024 as usize
            ) as ref u8
            val is_extern: mut bool = false
            val is_inline: mut bool = false
            val nd_opt = @get(ctx.fn_nodes as list[ref void], fi as usize)
            if nd_opt is some nd_ref {
                val nd: ref parser.Node = nd_ref as ref parser.Node
                if nd.kind == parser.NK_EXTERN_FN {
                    is_extern = true
                } elif parser.fn_is_inline(nd) {
                    is_inline = true
                }
            }
            if is_extern {
                ret_unboxed_fwd = false
                if ret_is_void {
                    ret_ct = "void"
                }
                @snprintf(sig, 1024, "{s} {s}(", {ret_ct, mangled})
            } elif is_inline {
                @snprintf(sig, 1024, "static inline {s} {s}(", {ret_ct, mangled})
            } else {
                @snprintf(sig, 1024, "static {s} {s}(", {ret_ct, mangled})
            }
            emit_to_fwd(ctx, sig)
            if ret_unboxed_fwd {
                emit_to_fwd(ctx, "int64_t*")
            }
            val is_var: mut bool = false
            val v_opt = @get(ctx.fn_variadics as list[bool], fi as usize)
            if v_opt is some v {
                is_var = v as bool
            }

            val p_opt = @get(ctx.fn_params as list[ref void], fi as usize)
            if p_opt is some p {
                val params_list: ref u8 = p
                val plen: i64 = @len(params_list as list[ref void]) as i64
                if plen == 0 && !is_var && !ret_unboxed_fwd {
                    emit_to_fwd(ctx, "void")
                }
                val pi: mut i64 = 0
                for {
                    if pi >= plen {
                        break
                    }
                    val param_opt = @get(params_list as list[ref void], pi as usize)
                    if param_opt is some param {
                        val pt: ref parser.Node = (param as ref parser.Node).d1 as ref parser.Node
                        val pct: ref u8 = cc_c_type_of(ctx, pt)
                        if pi > 0 || ret_unboxed_fwd {
                            emit_to_fwd(ctx, ",")
                        }
                        emit_to_fwd(ctx, pct)
                    }
                    pi++
                }
                if is_var {
                    emit_to_fwd(ctx, ",...")
                }
            } elif !ret_unboxed_fwd {
                emit_to_fwd(ctx, "void")
            }
            emitln_fwd(ctx, ");")
        }
        fi++
    }
}

fn gen_init_fn(ctx: mut ref CCtx) void = trust {
    val init_body: ref void = str.StringBuilder.build(ctx.init_sb)
    val body_str: ref u8 = str.cstr(init_body)
    emitln(ctx, "static void sx__init(void){")
    emit(ctx, body_str)
    emitln(ctx, "}")
    emitln(ctx, "")
    @free(@load(init_body))
    @free(init_body)
}

fn gen_items_with_prefix_skip_main(
    ctx: mut ref CCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    preregister_items(ctx, items, mod_prefix)
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_FN {
                val fname: ref u8 = node.d2 as ref u8
                if str.raw_cmp(fname, "main") != 0 {
                    gen_fn_prefixed(ctx, node, mod_prefix)
                }
            } elif k == parser.NK_VAL {
                gen_module_val(ctx, node, mod_prefix)
            } elif k == parser.NK_CONST {
                val ce: ref parser.Node = node.d2 as ref parser.Node
                if ce != none && ce.kind == parser.NK_LIST_LIT {
                    gen_module_const_list(ctx, node, mod_prefix)
                } else {
                    gen_module_const_global(ctx, node, mod_prefix)
                }
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_EXTERN_HEADER {
                gen_extern_header(ctx, node)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, false)
                if node.d3 != 0 as i64 {
                    cc_register_invariant(ctx, node.d1 as ref u8, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, true)
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = node.d0 as ref u8
                if cc_platform_matches(ctx, plat) {
                    gen_items_with_prefix_skip_main(
                        ctx,
                        node.d1 as list[ref parser.Node],
                        mod_prefix
                    )
                } else {
                    val ow: ref void = node.d2 as ref void
                    val matched: mut bool = false
                    if ow != none {
                        for own in ow as list[ref parser.Node] {
                            if !matched {
                                if cc_platform_matches(ctx, own.d0 as ref u8) {
                                    gen_items_with_prefix_skip_main(
                                        ctx,
                                        own.d1 as list[ref parser.Node],
                                        mod_prefix
                                    )
                                    matched = true
                                }
                            }
                        }
                    }
                    if !matched {
                        val otherwise: ref void = node.d3 as ref void
                        if otherwise != none {
                            gen_items_with_prefix_skip_main(
                                ctx,
                                otherwise as list[ref parser.Node],
                                mod_prefix
                            )
                        }
                    }
                }
            }
        }
        i++
    }
}

fn gen_test_fn_c(ctx: mut ref CCtx, body_stmts: ref parser.Node, test_id: i64) void = trust {
    cc_clear_locals(ctx)
    ctx.current_ret_ctype = "void"
    ctx.current_ret_is_void = true
    ctx.current_ret_ty = none
    val fname: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 32 as usize) as ref u8
    @snprintf(fname, 32, "sx__test_{lld}", {test_id})
    ctx.fn_name = fname
    val hdr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(hdr, 64, "void {s}(void)\{", {fname})
    emitln(ctx, hdr)
    gen_stmts(ctx, body_stmts)
    cc_emit_defers(ctx)
    emitln(ctx, "return;")
    emitln(ctx, "}")
    emitln(ctx, "")
}

fn gen_test_main_c(
    ctx: mut ref CCtx,
    test_ids: list[i64],
    test_names: list[ref u8]
) void = trust {
    emitln(ctx, "int main(int argc,char**argv) {")
    emitln(ctx, "sx__argc=(int64_t)argc;sx__argv=(int64_t)(intptr_t)argv;")
    emitln(ctx, "sx__init();")
    if !ctx.release_mode {
        emitln(ctx, "__sx_panic_init();")
    }
    val tlen: i64 = @len(test_ids) as i64
    val ti: mut i64 = 0
    for {
        if ti >= tlen {
            break
        }
        val id_opt = @get(test_ids, ti as usize)
        if id_opt is some id {
            val call: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                48 as usize
            ) as ref u8
            @snprintf(call, 48, "sx__test_{lld}();", {id as i64})
            emitln(ctx, call)
            val name_opt = @get(test_names, ti as usize)
            if name_opt is some name_val {
                val tname: ref u8 = name_val as ref u8
                if tname != none && str.len_raw(tname) > 0 {
                    val fmt_idx: i64 = intern_format_string(ctx, "[pass] %s\n")
                    val name_idx: i64 = intern_string(ctx, tname)
                    val pbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        128 as usize
                    ) as ref u8
                    @snprintf(
                        pbuf,
                        128,
                        "printf(sx__str{lld},sx__str{lld});",
                        {fmt_idx, name_idx}
                    )
                    emitln(ctx, pbuf)
                }
            }
        }
        ti++
    }
    val ok_idx: i64 = intern_format_string(ctx, "[note] all tests passed\n")
    val ok_buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(ok_buf, 64, "printf(sx__str{lld});", {ok_idx})
    emitln(ctx, ok_buf)
    emitln(ctx, "return 0;")
    emitln(ctx, "}")
    emitln(ctx, "")
}

pub fn gen_module_c_test(
    root: ref module.ResolvedModule,
    release_mode: bool,
    extra_includes: list[ref u8],
    src_target: ref u8,
    emit_line_directives: bool,
    simd_backend: i64,
    leak_check: bool
) ref u8 = trust {
    val ctx: mut ref CCtx = cc_new()
    defer {
        val arena = ctx.arena
        cc_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }
    ctx.release_mode = release_mode
    ctx.leak_check = leak_check
    ctx.src_target = src_target
    ctx.simd_backend = simd_backend
    val out_prefixes: mut list[ref u8] = mem.new[ref u8]()
    val out_items: mut list[ref void] = mem.new[ref void]()
    val out_filenames: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[String] = mem.new[String]()
    module.flatten_modules_with_files(
        ctx.arena,
        root,
        "",
        out_prefixes,
        out_items,
        out_filenames,
        seen
    )
    val layers: i64 = @len(out_prefixes) as i64
    cc_mark_prefix_used(ctx, "")
    emit_c_preamble(ctx)
    for inc in extra_includes {
        emitln_fwd(ctx, str.concat_raw("#include \"", str.concat_raw(inc, "\"")))
    }
    emit_c_panic_handler(ctx)
    val li: mut i64 = 0
    for {
        if li >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li as usize)
        val items_opt = @get(out_items, li as usize)
        if pfx_opt is some pfx {
            if items_opt is some ip {
                preregister_items(ctx, ip as list[ref parser.Node], pfx as ref u8)
            }
        }
        li++
    }
    val li2: mut i64 = 0
    for {
        if li2 >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li2 as usize)
        val items_opt = @get(out_items, li2 as usize)
        if emit_line_directives {
            val fname_opt = @get(out_filenames, li2 as usize)
            if fname_opt is some fname {
                ctx.current_src_file = fname as ref u8
            } else {
                ctx.current_src_file = ""
            }
        }
        if pfx_opt is some pfx {
            if items_opt is some ip {
                val is_root: bool = str.raw_cmp(pfx as ref u8, "") == 0
                if is_root {
                    gen_items_with_prefix_skip_main(ctx, ip as list[ref parser.Node], "")
                } else {
                    gen_items_with_prefix(ctx, ip as list[ref parser.Node], pfx as ref u8)
                }
            }
        }
        li2++
    }
    gen_init_fn(ctx)
    val test_ids: mut list[i64] = mem.new[i64]()
    val test_names: mut list[ref u8] = mem.new[ref u8]()
    val test_counter: mut i64 = 0
    if emit_line_directives {
        ctx.current_src_file = module.module_filename(root)
    }
    val root_items: list[ref parser.Node] = root.items
    val rlen: i64 = @len(root_items) as i64
    val ri: mut i64 = 0
    for {
        if ri >= rlen {
            break
        }
        val item_opt = @get(root_items, ri as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            if node.kind == parser.NK_TEST {
                test_counter++
                @append(test_ids, test_counter)
                @append(test_names, parser.test_name(node))
                gen_test_fn_c(ctx, node.d0 as ref parser.Node, test_counter)
            }
        }
        ri++
    }
    gen_test_main_c(ctx, test_ids, test_names)
    emit_string_data(ctx)
    emit_forward_decls(ctx)
    val hdr_built: ref void = str.StringBuilder.build(ctx.fwd_sb)
    val hdr_str: ref u8 = str.cstr(hdr_built)
    val mono_built: ref void = str.StringBuilder.build(ctx.mono_sb)
    val mono_str: ref u8 = str.cstr(mono_built)
    val body_built: ref void = str.StringBuilder.build(ctx.sb)
    val body_str: ref u8 = str.cstr(body_built)
    val hdr_len: i64 = str.len_raw(hdr_str)
    val mono_len: i64 = str.len_raw(mono_str)
    val body_len: i64 = str.len_raw(body_str)
    val total: i64 = hdr_len + mono_len + body_len + 1
    val result: ref u8 = @alloc(total) as ref u8
    @memcpy(result, hdr_str, hdr_len as usize)
    @memcpy(@ptradd(result, hdr_len), mono_str, mono_len as usize)
    @memcpy(@ptradd(result, hdr_len + mono_len), body_str, (body_len + 1) as usize)
    @free(@load(hdr_built))
    @free(hdr_built)
    @free(@load(mono_built))
    @free(mono_built)
    @free(@load(body_built))
    @free(body_built)
    str.StringBuilder.free(ctx.fwd_sb)
    str.StringBuilder.free(ctx.mono_sb)
    str.StringBuilder.free(ctx.init_sb)
    str.StringBuilder.free(ctx.sb)
    return result
}

pub fn gen_module_c(
    root: ref module.ResolvedModule,
    release_mode: bool,
    extra_includes: list[ref u8],
    src_target: ref u8,
    emit_line_directives: bool,
    simd_backend: i64,
    leak_check: bool
) ref u8 = trust {
    val ctx: mut ref CCtx = cc_new()
    defer {
        val arena = ctx.arena
        cc_free_ctx(ctx)
        allocators.ScopedArena.free(arena)
    }
    ctx.release_mode = release_mode
    ctx.leak_check = leak_check
    ctx.src_target = src_target
    ctx.simd_backend = simd_backend
    val out_prefixes: mut list[ref u8] = mem.new[ref u8]()
    val out_items: mut list[ref void] = mem.new[ref void]()
    val out_filenames: mut list[ref u8] = mem.new[ref u8]()
    val seen: mut list[String] = mem.new[String]()
    module.flatten_modules_with_files(
        ctx.arena,
        root,
        "",
        out_prefixes,
        out_items,
        out_filenames,
        seen
    )
    val layers: i64 = @len(out_prefixes) as i64
    cc_mark_prefix_used(ctx, "")
    emit_c_preamble(ctx)
    for inc in extra_includes {
        emitln_fwd(ctx, str.concat_raw("#include \"", str.concat_raw(inc, "\"")))
    }
    emit_c_panic_handler(ctx)
    emitln_fwd(ctx, "static void sx__init(void);")
    val li: mut i64 = 0
    for {
        if li >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li as usize)
        val items_opt = @get(out_items, li as usize)
        if pfx_opt is some pfx {
            if items_opt is some ip {
                preregister_items(ctx, ip as list[ref parser.Node], pfx as ref u8)
            }
        }
        li++
    }
    val li2: mut i64 = 0
    for {
        if li2 >= layers {
            break
        }
        val pfx_opt = @get(out_prefixes, li2 as usize)
        val items_opt = @get(out_items, li2 as usize)
        if emit_line_directives {
            val fname_opt = @get(out_filenames, li2 as usize)
            if fname_opt is some fname {
                ctx.current_src_file = fname as ref u8
            } else {
                ctx.current_src_file = ""
            }
        }
        if pfx_opt is some pfx {
            if items_opt is some ip {
                gen_items_with_prefix(ctx, ip as list[ref parser.Node], pfx as ref u8)
            }
        }
        li2++
    }
    gen_init_fn(ctx)
    emit_string_data(ctx)
    emit_forward_decls(ctx)
    val hdr_built: ref void = str.StringBuilder.build(ctx.fwd_sb)
    val hdr_str: ref u8 = str.cstr(hdr_built)
    val mono_built: ref void = str.StringBuilder.build(ctx.mono_sb)
    val mono_str: ref u8 = str.cstr(mono_built)
    val body_built: ref void = str.StringBuilder.build(ctx.sb)
    val body_str: ref u8 = str.cstr(body_built)
    val hdr_len: i64 = str.len_raw(hdr_str)
    val mono_len: i64 = str.len_raw(mono_str)
    val body_len: i64 = str.len_raw(body_str)
    val total: i64 = hdr_len + mono_len + body_len + 1
    val result: ref u8 = @alloc(total) as ref u8
    @memcpy(result, hdr_str, hdr_len as usize)
    @memcpy(@ptradd(result, hdr_len), mono_str, mono_len as usize)
    @memcpy(@ptradd(result, hdr_len + mono_len), body_str, (body_len + 1) as usize)
    @free(@load(hdr_built))
    @free(hdr_built)
    @free(@load(mono_built))
    @free(mono_built)
    @free(@load(body_built))
    @free(body_built)
    str.StringBuilder.free(ctx.fwd_sb)
    str.StringBuilder.free(ctx.mono_sb)
    str.StringBuilder.free(ctx.init_sb)
    str.StringBuilder.free(ctx.sb)
    return result
}
