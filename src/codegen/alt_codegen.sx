                        ) as ref u8
                        @snprintf(fail_buf, 128, "goto sx__get_none{lld};\n", {res_t})
                        emit(ctx, fail_buf)
                        break
                    }
                    val idx_expr: ref u8 = get_arg(ctx, args, ai)
                    val idx_t: i64 = fresh_tmp(ctx)
                    val next_ty: ref parser.Node = parser.fixed_arr_inner(cur_ty)
                    val cur_len: i64 = cc_fixed_arr_size_val(ctx, cur_ty)
                    val elem_sz: i64 = c_size_of(ctx, next_ty)
                    val step_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
