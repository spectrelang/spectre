            val ai: mut i64 = 1
            for {
                if ai >= alen {
                    break
                }
                val a_opt = @get(args as list[ref parser.Node], ai as usize)
                if a_opt is some a {
                    if ai > 1 {
                        str.StringBuilder.append_cstr(call_sb, ",")
                    }
                    val arg_node: ref parser.Node = a as ref parser.Node
                    val arg_expr: ref u8 = gen_expr(ctx, arg_node)
                    val arg_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    val pi: i64 = ai - 1
                    if params != none && pi < @len(params as list[ref parser.Node]) as i64 {
                        val p_opt = @get(params as list[ref parser.Node], pi as usize)
                        if p_opt is some p {
                            val pct: ref u8 = cc_c_type_of(ctx, p as ref parser.Node)
                            @snprintf(arg_buf, 512, "({s})({s})", {pct, arg_expr})
                        } else {
                            @snprintf(arg_buf, 512, "({s})", {arg_expr})
                        }
                    } else {
                        @snprintf(arg_buf, 512, "({s})", {arg_expr})
                    }
                    str.StringBuilder.append_cstr(call_sb, arg_buf)
                }
                ai++
            }
            str.StringBuilder.append_cstr(call_sb, ")")
            val call_line_cstr: ref u8 = cc_sb_build_cstr(ctx, call_sb)
            str.StringBuilder.free(call_sb)
