        val l: ref u8 = get_arg(ctx, args, 0)
        val i: ref u8 = get_arg(ctx, args, 1)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(
            buf,
            256,
            "sx__rt_remove((void*)(intptr_t)({s}),(int64_t)({s}))",
            {l, i}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "reserve") == 0 {
        val l: ref u8 = get_arg(ctx, args, 0)
        val c: ref u8 = get_arg(ctx, args, 1)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(
            buf,
            256,
            "sx__rt_reserve((void*)(intptr_t)({s}),(int64_t)({s}))",
            {l, c}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "capacity") == 0 {
        val l: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
        @snprintf(
            buf,
            128,
            "(({s})==0?0:(*(int64_t*)((char*)(intptr_t)({s})+16)))",
            {l, l}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "list") == 0 {
        val ac_node_opt = @get(args as list[ref parser.Node], 0 as usize)
        val ac_node: mut ref parser.Node = none
        if ac_node_opt is some a {
            ac_node = a as ref parser.Node
        }
        val ac_ty: ref parser.Node = cc_infer_expr_ty(ctx, ac_node)
        if ac_ty == none {
            stdio.eprint("error: cannot infer allocator type for @list\n", {})
            os.exit(1)
        }
        val ac: ref u8 = get_arg(ctx, args, 0)
        val prefix: ref u8 = cc_alloc_adapter_prefix(ctx, ac_ty)
        val alen: i64 = @len(args as list[ref parser.Node]) as i64
        val count: i64 = alen - 1
        val elems_ref: mut ref u8 = "0"
        if count > 0 {
            val arr_tmp: i64 = fresh_tmp(ctx)
            val sb: ref void = str.StringBuilder.new()
            val name_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(name_buf, 128, "int64_t sx__le{lld}[{lld}]=", {arr_tmp, count})
            str.StringBuilder.append_cstr(sb, name_buf)
            str.StringBuilder.append_char(sb, 123 as u8)
            val ei: mut i64 = 1
            for {
                if ei >= alen {
                    break
                }
                val e_opt = @get(args as list[ref parser.Node], ei as usize)
                if e_opt is some e {
                    val ev: ref u8 = gen_expr(ctx, e as ref parser.Node)
                    val eb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        256 as usize
                    ) as ref u8
                    if ei > 1 {
                        @snprintf(eb, 256, ",(int64_t)({s})", {ev})
                    } else {
                        @snprintf(eb, 256, "(int64_t)({s})", {ev})
                    }
                    str.StringBuilder.append_cstr(sb, eb)
                }
                ei++
            }
            str.StringBuilder.append_cstr(sb, "};\n")
            val built: ref void = str.StringBuilder.build(sb)
            emit(ctx, str.cstr(built))
            str.StringBuilder.free(sb)
            @free(@load(built))
            @free(built)
            val er: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
            @snprintf(er, 128, "sx__le{lld}", {arr_tmp})
            elems_ref = er
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "sx__rt_list_from({s}_alloc,{s}_free,{s}_realloc,(int64_t)({s}),{s},{lld})",
            {prefix, prefix, prefix, ac, elems_ref, count}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "listalloc") == 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val ac: ref u8 = get_arg(ctx, args, 0)
        val prefix: ref u8 = cc_alloc_adapter_prefix(ctx, cc_first_type_arg(btargs))
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "sx__rt_list_alloc({s}_alloc,{s}_free,{s}_realloc,(int64_t)({s}))",
            {prefix, prefix, prefix, ac}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "listfree") == 0 {
        val lst: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "(sx__rt_list_free((int64_t*)(intptr_t)({s})),0)",
            {lst}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "argsalloc") == 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val ac: ref u8 = get_arg(ctx, args, 0)
        val prefix: ref u8 = cc_alloc_adapter_prefix(ctx, cc_first_type_arg(btargs))
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "sx__rt_get_args_alloc({s}_alloc,{s}_free,{s}_realloc,(int64_t)({s}))",
            {prefix, prefix, prefix, ac}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "fmt") == 0 || str.raw_cmp(bname, "fmtalloc") == 0 {
        val btargs: list[ref parser.Node] = parser.builtin_type_args(expr)
        val use_alloc: bool = (@len(btargs) as i64) > 0
        val fmt_idx: mut i64 = 0
        if use_alloc {
            fmt_idx = 1
        }
        val pack_idx: i64 = fmt_idx + 1
        val f: ref u8 = get_format_arg(ctx, args, fmt_idx)
        val p: mut ref u8 = "0"
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > pack_idx {
                val pack_opt = @get(args as list[ref parser.Node], pack_idx as usize)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        p = gen_vararg_pack(ctx, pn.d0 as ref void)
                    } else {
                        p = gen_vararg_scalar_pack(ctx, gen_expr(ctx, pn))
                    }
                }
            }
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        if use_alloc {
            val ac: ref u8 = get_arg(ctx, args, 0)
            val prefix: ref u8 = cc_alloc_adapter_prefix(ctx, cc_first_type_arg(btargs))
            @snprintf(
                buf,
                512,
                "sx__rt_fmt_alloc({s}_alloc,{s}_free,{s}_realloc,(int64_t)({s}),(const char*)(intptr_t)({s}),(int64_t*)(intptr_t)({s}))",
                {prefix, prefix, prefix, ac, f, p}
            )
        } else {
            @snprintf(
                buf,
                512,
                "(int64_t)(intptr_t)sx__rt_fmt((const char*)(intptr_t)({s}),(int64_t*)(intptr_t)({s}))",
                {f, p}
            )
        }
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "args") == 0 {
        return "(int64_t)(intptr_t)sx__rt_get_args()"
    }
    if str.raw_cmp(bname, "puts") == 0 {
        val s: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(
            buf,
            256,
            "puts((const char*)(intptr_t)({s}))",
            {s}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "flush") == 0 {
        return "(fflush(stdout),0)"
    }
    if str.raw_cmp(bname, "stdin") == 0 {
        return "(int64_t)(intptr_t)stdin"
    }
    if str.raw_cmp(bname, "fgets") == 0 {
        val b: ref u8 = get_arg(
            ctx,
            args,
            0
        )
        val n: ref u8 = get_arg(ctx, args, 1)
        val s: ref u8 = get_arg(ctx, args, 2)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "(int64_t)(intptr_t)fgets((char*)(intptr_t)({s}),(int)({s}),(FILE*)(intptr_t)({s}))",
            {b, n, s}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "getchar") == 0 {
        return "(int64_t)(int)getchar()"
    }
    if str.raw_cmp(bname, "snprintf") == 0 {
        val sb: ref void = str.StringBuilder.new()
        val dest_arg: ref u8 = get_arg(ctx, args, 0)
        val sz_arg: ref u8 = get_arg(ctx, args, 1)
        val fmt_arg: ref u8 = get_format_arg(ctx, args, 2)
        val hdr: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 8192 as usize) as ref u8
        @snprintf(
            hdr,
            8192,
            "snprintf((char*)(intptr_t)({s}),(size_t)({s}),(const char*)(intptr_t)({s})",
            {dest_arg, sz_arg, fmt_arg}
        )
        str.StringBuilder.append_cstr(sb, hdr)
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 3 {
                val pack_opt = @get(args as list[ref parser.Node], 3 as usize)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        val pack: ref void = pn.d0 as ref void
                        val plen: i64 = @len(pack as list[ref parser.Node]) as i64
                        val pi: mut i64 = 0
                        for {
                            if pi >= plen {
                                break
                            }
                            val pe_opt = @get(pack as list[ref parser.Node], pi as usize)
                            if pe_opt is some pe {
                                val av: ref u8 = gen_expr(ctx, pe as ref parser.Node)
                                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(
                                    ab,
                                    256,
                                    ",({s})",
                                    {av}
                                )
                                str.StringBuilder.append_cstr(sb, ab)
                            }
                            pi++
                        }
                    } elif pn.kind == parser.NK_IDENT &&
                    cc_current_fn_param_is_argspack(ctx, pn.d0 as ref u8) {
                        val av2: ref u8 = gen_expr(ctx, pn)
                        val expanded: ref u8 = cc_expand_argspack_pack(ctx, av2)
                        str.StringBuilder.append_cstr(sb, expanded)
                    } else {
                        val av2: ref u8 = gen_expr(ctx, pn)
                        val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            256 as usize
                        ) as ref u8
                        @snprintf(
                            ab,
                            256,
                            ",({s})",
                            {av2}
                        )
                        str.StringBuilder.append_cstr(sb, ab)
                    }
                }
            }
        }
        str.StringBuilder.append_cstr(sb, ")")
        val buf: ref u8 = cc_sb_build_cstr(ctx, sb)
        str.StringBuilder.free(sb)
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "dprintf") == 0 {
        val fd: ref u8 = get_arg(ctx, args, 0)
        val fmt_arg: ref u8 = get_format_arg(ctx, args, 1)
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 2 {
                val pack_opt = @get(args as list[ref parser.Node], 2 as usize)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        val pack: ref void = pn.d0 as ref void
                        val sb: ref void = str.StringBuilder.new()
                        val plen: i64 = @len(pack as list[ref parser.Node]) as i64
                        val pi: mut i64 = 0
                        val hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            4096 as usize
                        ) as ref u8
                        @snprintf(
                            hdr,
                            4096,
                            "sx__dprintf((int)({s}),(const char*)(intptr_t)({s})",
                            {fd, fmt_arg}
                        )
                        str.StringBuilder.append_cstr(sb, hdr)
                        for {
                            if pi >= plen {
                                break
                            }
                            val pe_opt = @get(pack as list[ref parser.Node], pi as usize)
                            if pe_opt is some pe {
                                val av: ref u8 = gen_expr(ctx, pe as ref parser.Node)
                                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(
                                    ab,
                                    256,
                                    ",({s})",
                                    {av}
                                )
                                str.StringBuilder.append_cstr(sb, ab)
                            }
                            pi++
                        }
                        str.StringBuilder.append_cstr(sb, ")")
                        val buf: ref u8 = cc_sb_build_cstr(ctx, sb)
                        str.StringBuilder.free(sb)
                        return cc_expr_track(ctx, buf)
                    } else {
                        val av2: ref u8 = gen_expr(ctx, pn)
                        val packed: ref u8 = gen_vararg_scalar_pack(ctx, av2)
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            4096 as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            4096,
                            "sx__rt_dprintf((int)({s}),(const char*)(intptr_t)({s}),(int64_t*)(intptr_t)({s}))",
                            {fd, fmt_arg, packed}
                        )
                        return cc_expr_track(ctx, buf)
                    }
                }
            }
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 4096 as usize) as ref u8
        @snprintf(
            buf,
            4096,
            "sx__dprintf((int)({s}),(const char*)(intptr_t)({s}))",
            {fd, fmt_arg}
        )
        return cc_expr_track(ctx, buf)
    }
    if (str.raw_cmp(bname, "print") == 0) {
        val fmt_arg: ref u8 = get_format_arg(ctx, args, 0)
        if args != none {
            val alen: i64 = @len(args as list[ref parser.Node]) as i64
            if alen > 1 {
                val pack_opt = @get(args as list[ref parser.Node], 1 as usize)
                if pack_opt is some pack_node {
                    val pn: ref parser.Node = pack_node as ref parser.Node
                    if pn.kind == parser.NK_ARGS_PACK {
                        val pack: ref void = pn.d0 as ref void
                        val sb: ref void = str.StringBuilder.new()
                        val plen: i64 = @len(pack as list[ref parser.Node]) as i64
                        val pi: mut i64 = 0
                        val hdr: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            4096 as usize
                        ) as ref u8
                        @snprintf(hdr, 4096, "printf((const char*)(intptr_t)({s})", {fmt_arg})
                        str.StringBuilder.append_cstr(sb, hdr)
                        for {
                            if pi >= plen {
                                break
                            }
                            val pe_opt = @get(pack as list[ref parser.Node], pi as usize)
                            if pe_opt is some pe {
                                val av: ref u8 = gen_expr(ctx, pe as ref parser.Node)
                                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    256 as usize
                                ) as ref u8
                                @snprintf(
                                    ab,
                                    256,
                                    ",({s})",
                                    {av}
                                )
                                str.StringBuilder.append_cstr(sb, ab)
                            }
                            pi++
                        }
                        str.StringBuilder.append_cstr(sb, ")")
                        val buf: ref u8 = cc_sb_build_cstr(ctx, sb)
                        str.StringBuilder.free(sb)
                        return cc_expr_track(ctx, buf)
                    } elif pn.kind == parser.NK_IDENT &&
                    cc_current_fn_param_is_argspack(ctx, pn.d0 as ref u8) {
                        val av2: ref u8 = gen_expr(ctx, pn)
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            4096 as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            4096,
                            "sx__rt_printf((const char*)(intptr_t)({s}),(int64_t*)(intptr_t)({s}))",
                            {fmt_arg, av2}
                        )
                        return cc_expr_track(ctx, buf)
                    } else {
                        val av2: ref u8 = gen_expr(ctx, pn)
                        val packed: ref u8 = gen_vararg_scalar_pack(ctx, av2)
                        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            4096 as usize
                        ) as ref u8
                        @snprintf(
                            buf,
                            4096,
                            "sx__rt_printf((const char*)(intptr_t)({s}),(int64_t*)(intptr_t)({s}))",
                            {fmt_arg, packed}
                        )
                        return cc_expr_track(ctx, buf)
                    }
                }
            }
        }
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 4096 as usize) as ref u8
        @snprintf(
            buf,
            4096,
            "printf((const char*)(intptr_t)({s}))",
            {fmt_arg}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "mkdir") == 0 && cc_platform_matches(ctx, "windows") {
        val p: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "_mkdir((const char*)(intptr_t)({s}))", {p})
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "strlen") == 0 {
        val arg: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "strlen((const char*)(intptr_t)({s}))", {arg})
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "strcmp") == 0 {
        val a: ref u8 = get_arg(ctx, args, 0)
        val b: ref u8 = get_arg(ctx, args, 1)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "strcmp((const char*)(intptr_t)({s}),(const char*)(intptr_t)({s}))",
            {a, b}
        )
        return cc_expr_track(ctx, buf)
    }
    if str.raw_cmp(bname, "atoi") == 0 {
        val arg: ref u8 = get_arg(ctx, args, 0)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(buf, 512, "atoi((const char*)(intptr_t)({s}))", {arg})
        return cc_expr_track(ctx, buf)
    }
    return "0"
}

fn gen_struct_lit(ctx: mut ref CCtx, expr: ref parser.Node) ref u8 = trust {
    val lit_fields: ref void = expr.d0 as ref void
    val fcount: mut i64 = 0
    if lit_fields != none {
        fcount = @len(lit_fields as list[ref void]) as i64
    }

    val alloc_size: mut i64 = (fcount * 8) as i64
    val struct_fields: mut ref void = none
    val named_ty: ref u8 = parser.struct_lit_type_name(expr)
    if named_ty != none {
        struct_fields = cc_lookup_struct(ctx, named_ty)
        if struct_fields != none {
            alloc_size = struct_size_bytes(ctx, struct_fields)
        }
    }
    val expected_ty: ref parser.Node = cc_expected_struct_ty(ctx, ctx.expected_ty)
    if struct_fields == none && expected_ty != none {
        alloc_size = c_size_of(ctx, expected_ty)
        struct_fields = cc_lookup_struct(ctx, expected_ty.d0 as ref u8)
    }
    if fcount < 1 && alloc_size < 8 {
        alloc_size = 8 as i64
    }

    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(
        buf,
        256,
        "int64_t*sx__sl{lld}=(int64_t*)calloc(1,{lld});\n",
        {t, alloc_size}
    )
    emit(ctx, buf)
    if lit_fields != none {
        val lflen: i64 = @len(lit_fields as list[ref void]) as i64
        val li: mut i64 = 0
        for {
            if li >= lflen {
                break
            }
            val lf_opt = @get(lit_fields as list[ref void], li as usize)
            if lf_opt is some lf {
                val lf_node: ref parser.Node = lf as ref parser.Node
                val off: mut i64 = li * 8
                val fld_sz: mut i64 = 8
                val field_ty: mut ref parser.Node = none
                if struct_fields != none {
                    val fname: ref u8 = lf_node.d0 as ref u8
                    val roff: i64 = field_offset_bytes(ctx, struct_fields, fname)
                    if roff >= 0 {
                        off = roff
                    }
                    fld_sz = cc_field_size_from_fields(ctx, struct_fields, fname)
                    field_ty = cc_field_ty_from_fields(ctx, struct_fields, fname)
                }

                val fct: mut ref u8 = "int64_t"
                if struct_fields != none {
                    fct = cc_field_ctype_from_fields(ctx, struct_fields, lf_node.d0 as ref u8)
                }
                val old_expected = ctx.expected_ty
                if field_ty != none {
                    ctx.expected_ty = field_ty
                }
                val fval: ref u8 = gen_expr(ctx, lf_node.d1 as ref parser.Node)
                ctx.expected_ty = old_expected
                val stmt_cap: i64 = str.len_raw(fval) + str.len_raw(fct) + 160
                val fb: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (stmt_cap) as usize
                ) as ref u8
                if cc_type_needs_aggregate_copy(ctx, field_ty) {
                    if cc_expr_is_zero_init_like(lf_node.d1 as ref parser.Node) {
                        @snprintf(
                            fb,
                            stmt_cap,
                            "memset((char*)sx__sl{lld}+{lld},0,(size_t){lld});\n",
                            {t, off, fld_sz}
                        )
                    } else {
                        @snprintf(
                            fb,
                            stmt_cap,
                            "memcpy((char*)sx__sl{lld}+{lld},(void*)(intptr_t)({s}),(size_t){lld});\n",
                            {t, off, fval, fld_sz}
                        )
                    }
                } else {
                    @snprintf(
                        fb,
                        stmt_cap,
                        "*({s}*)((char*)sx__sl{lld}+{lld})=({s})({s});\n",
                        {fct, t, off, fct, fval}
                    )
                }
                emit(ctx, fb)
            }
            li++
        }
    }
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(res, 64, "(int64_t)(intptr_t)sx__sl{lld}", {t})
    return cc_expr_track(ctx, res)
}

fn gen_list_lit(ctx: mut ref CCtx, expr: ref parser.Node) ref u8 = trust {
    stdio.eprint(
        "error: {s}:{lld}: implicit dynamic list allocation is not allowed, use @list(ac, ...) or @listalloc[Alloc, T](ac), squared bracket syntax denotes an array literal and requires an explicit type annotation\n",
        {ctx.current_src_file, expr.line}
    )
    os.exit(1)
    val elems: ref void = expr.d0 as ref void
    val elen: mut i64 = 0
    if elems != none {
        elen = @len(elems as list[ref void]) as i64
    }
    val elem_ty: ref parser.Node = cc_unwrap_list_elem_ty(ctx.expected_ty)
    val t: i64 = fresh_tmp(ctx)
    val cap: mut i64 = elen * 8
    if cap < 64 {
        cap = 64
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    @snprintf(buf, 512, "int64_t*sx__ll{lld}=(int64_t*)calloc(1,32);int64_t*sx__lld{lld}=(int64_t*)calloc(1,{lld});sx__ll{lld}[0]=(int64_t)(intptr_t)sx__lld{lld};sx__ll{lld}[1]={lld};sx__ll{lld}[2]={lld};sx__ll{lld}[3]=0;\n",
        {t, t, cap, t, t, t, elen, t, cap/8, t})
    emit(ctx, buf)
    if elems != none {
        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            val e_opt = @get(elems as list[ref void], ei as usize)
            if e_opt is some e {
                val old_expected = ctx.expected_ty
                if elem_ty != none {
                    ctx.expected_ty = elem_ty
                }
                val ev: ref u8 = gen_expr(ctx, e as ref parser.Node)
                ctx.expected_ty = old_expected
                val stmt_cap: i64 = str.len_raw(ev) + 96
                val eb: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (stmt_cap) as usize
                ) as ref u8
                @snprintf(
                    eb,
                    stmt_cap,
                    "sx__lld{lld}[{lld}]=(int64_t)({s});\n",
                    {t, ei, ev}
                )
                emit(ctx, eb)
            }
            ei++
        }
    }
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(res, 64, "(int64_t)(intptr_t)sx__ll{lld}", {t})
    return cc_expr_track(ctx, res)
}

fn cc_fixed_arr_ty(ctx: ref CCtx, ty: ref parser.Node) ref parser.Node = trust {
    val concrete: ref parser.Node = cc_concrete_ty(ctx, ty)
    if concrete == none {
        return none
    }
    if concrete.kind == parser.TY_MUT {
        return cc_fixed_arr_ty(ctx, concrete.d0 as ref parser.Node)
    }
    if concrete.kind == parser.TY_FIXED_ARR {
        return concrete
    }
    return none
}

fn gen_fixed_arr_fill(
    ctx: mut ref CCtx,
    buf_tmp: i64,
    base_off: i64,
    ty: ref parser.Node,
    expr: ref parser.Node
) void = trust {
    val concrete: ref parser.Node = cc_concrete_ty(ctx, ty)
    if concrete == none {
        return
    }
    if concrete.kind == parser.TY_MUT {
        gen_fixed_arr_fill(ctx, buf_tmp, base_off, concrete.d0 as ref parser.Node, expr)
        return
    }

    if concrete.kind == parser.TY_FIXED_ARR {
        val count: i64 = cc_fixed_arr_size_val(ctx, concrete)
        val inner: ref parser.Node = parser.fixed_arr_inner(concrete)
        val elem_sz: i64 = c_size_of(ctx, inner)

        val elems: mut ref void = none
        val elen: mut i64 = 0
        if expr != none && expr.kind == parser.NK_LIST_LIT {
            elems = expr.d0 as ref void
            if elems != none {
                elen = @len(elems as list[ref void]) as i64
            }
        }

        val i: mut i64 = 0
        for {
            if i >= count {
                break
            }
            if i < elen {
                val e_opt = @get(elems as list[ref void], i as usize)
                if e_opt is some e {
                    gen_fixed_arr_fill(
                        ctx,
                        buf_tmp,
                        base_off + i * elem_sz,
                        inner,
                        e as ref parser.Node
                    )
                }
            }
            i++
        }
        return
    }

    if expr == none || cc_expr_is_zero_init_like(expr) {
        return
    }

    val old_expected = ctx.expected_ty
    ctx.expected_ty = concrete
    val val_str: ref u8 = gen_expr(ctx, expr)
    ctx.expected_ty = old_expected

    val elem_sz: i64 = c_size_of(ctx, concrete)
    if cc_type_needs_aggregate_copy(ctx, concrete) {
        val copy_cap: i64 = str.len_raw(val_str) + 192
        val copy: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (copy_cap) as usize
        ) as ref u8
        @snprintf(copy, copy_cap, "memcpy((void*)(intptr_t)((char*)(intptr_t)sx__fa{lld}+{lld}),(void*)(intptr_t)({s}),{lld});\n",
            {buf_tmp, base_off, val_str, elem_sz})
        emit(ctx, copy)
    } else {
        val ctype: ref u8 = cc_c_type_of(ctx, concrete)
        val asg_cap: i64 = str.len_raw(val_str) + str.len_raw(ctype) + 192
        val asg: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            (asg_cap) as usize
        ) as ref u8
        @snprintf(asg, asg_cap, "*({s}*)(intptr_t)((char*)(intptr_t)sx__fa{lld}+{lld})=({s})({s});\n",
            {ctype, buf_tmp, base_off, ctype, val_str})
        emit(ctx, asg)
    }
}

fn gen_fixed_arr_lit(
    ctx: mut ref CCtx,
    expr: ref parser.Node,
    ty_node: ref parser.Node
) ref u8 = trust {
    val arr_ty: ref parser.Node = cc_fixed_arr_ty(ctx, ty_node)
    if arr_ty == none {
        return "0"
    }
    val t: i64 = fresh_tmp(ctx)
    val sz: i64 = c_size_of(ctx, arr_ty)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    @snprintf(buf, 256, "int64_t sx__fa{lld}=(int64_t)(intptr_t)calloc(1,{lld});\n", {t, sz})
    emit(ctx, buf)
    gen_fixed_arr_fill(ctx, t, 0, arr_ty, expr)
    val res: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 64 as usize) as ref u8
    @snprintf(res, 64, "(int64_t)(intptr_t)sx__fa{lld}", {t})
    return cc_expr_track(ctx, res)
}

fn gen_field_addr(ctx: mut ref CCtx, expr: ref parser.Node) ref u8 = trust {
    val base_node: ref parser.Node = parser.field_base(expr)
    val fname: ref u8 = parser.field_name(expr)

    // A module-qualified global such as `mod.value` is an lvalue even though
    // `mod` itself is not a value. Resolve the mangled symbol directly.
    val direct: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    if base_node.kind == parser.NK_IDENT {
        val base_name: ref u8 = base_node.d0 as ref u8
        if str.raw_cmp(cc_lookup_ident_type(ctx, base_name), "") == 0 {
            val key: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            @snprintf(key, 512, "{s}__{s}", {base_name, fname})
            val gn: ref u8 = cc_resolve_global_name(ctx, key)
            if str.raw_cmp(gn, "") != 0 {
                val gty: ref parser.Node = cc_lookup_global_ty_node(ctx, key)
                if gty != none && cc_is_aggregate_storage(ctx, gty) {
                    @snprintf(direct, 4096, "{s}", {gn})
                } else {
                    @snprintf(direct, 4096, "(int64_t)(intptr_t)&{s}", {gn})
                }
                return cc_expr_track(ctx, direct)
            }
        }
    }

    val base: ref u8 = gen_expr(ctx, base_node)
    val bt: ref u8 = cc_field_base_type_name(ctx, base_node)
    val fields: mut ref void = cc_lookup_struct(ctx, bt)
    if fields == none && str.raw_cmp(bt, "") != 0 {
        val btlen2: i64 = str.len_raw(bt)
        val dotpos2: mut i64 = -1
        val bi2: mut i64 = 0
        for {
            if bi2 >= btlen2 {
                break
            }
            if @load8(@ptradd(bt, bi2)) == 46 {
                dotpos2 = bi2
            }
            bi2++
        }
        if dotpos2 >= 0 {
            val suffix2: ref u8 = @ptradd(bt, dotpos2 + 1) as ref u8
            fields = cc_lookup_struct(ctx, suffix2)
        }
    }
    val off: mut i64 = 0
    if fields != none {
        val ro: i64 = field_offset_bytes(ctx, fields, fname)
        if ro >= 0 {
            off = ro
        }
    } elif str.raw_cmp(fname, "len") == 0 {
        off = 8
    } elif str.raw_cmp(fname, "cap") == 0 {
        off = 16
    }
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 4096 as usize) as ref u8
    @snprintf(buf, 4096, "(int64_t)(intptr_t)((char*)(intptr_t)({s})+{lld})", {base, off})
    return cc_expr_track(ctx, buf)
}

fn cc_field_size_from_fields(ctx: ref CCtx, fields: ref void, fname: ref u8) i64 = trust {
    if fields == none {
        return 8
    }
    val use_c_abi: bool = cc_struct_uses_c_abi(ctx, fields)
    val flen: i64 = @len(fields as list[ref void]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fn_node: ref parser.Node = f as ref parser.Node
            if str.raw_cmp(fn_node.d0 as ref u8, fname) == 0 {
                if use_c_abi {
                    return cc_c_abi_size_of(ctx, fn_node.d2 as ref parser.Node)
                }
                return c_size_of(ctx, fn_node.d2 as ref parser.Node)
            }
        }
        fi++
    }
    return 8
}

fn cc_field_ty_from_fields(ctx: ref CCtx, fields: ref void, fname: ref u8) ref parser.Node = trust {
    if fields == none {
        return none
    }
    val flen: i64 = @len(fields as list[ref void]) as i64
    val fi: mut i64 = 0
    for {
        if fi >= flen {
            break
        }
        val f_opt = @get(fields as list[ref void], fi as usize)
        if f_opt is some f {
            val fn_node: ref parser.Node = f as ref parser.Node
            if str.raw_cmp(fn_node.d0 as ref u8, fname) == 0 {
                return cc_concrete_ty(ctx, fn_node.d2 as ref parser.Node)
            }
        }
        fi++
    }
    return none
}

fn cc_field_ctype_from_fields(ctx: ref CCtx, fields: ref void, fname: ref u8) ref u8 = trust {
    val fty: ref parser.Node = cc_field_ty_from_fields(ctx, fields, fname)
    if fty == none {
        return "int64_t"
    }
    if cc_struct_uses_c_abi(ctx, fields) {
        return cc_c_abi_type_of(ctx, fty)
    }
    return cc_c_type_of(ctx, fty)
}

fn cc_field_size_of_expr(ctx: mut ref CCtx, expr: ref parser.Node) i64 = trust {
    val base_node: ref parser.Node = parser.field_base(expr)
    val fname: ref u8 = parser.field_name(expr)
    val bt: ref u8 = cc_field_base_type_name(ctx, base_node)
    val fields: mut ref void = cc_lookup_struct(ctx, bt)
    if fields == none && str.raw_cmp(bt, "") != 0 {
        val btlen2: i64 = str.len_raw(bt)
        val dotpos2: mut i64 = -1
        val bi2: mut i64 = 0
        for {
            if bi2 >= btlen2 {
                break
            }
            if @load8(@ptradd(bt, bi2)) == 46 {
                dotpos2 = bi2
            }
            bi2++
        }
        if dotpos2 >= 0 {
            val suffix2: ref u8 = @ptradd(bt, dotpos2 + 1) as ref u8
            fields = cc_lookup_struct(ctx, suffix2)
        }
    }
    if fields != none {
        return cc_field_size_from_fields(ctx, fields, fname)
    }
    return 8
}

fn cc_field_ctype_of_expr(ctx: mut ref CCtx, expr: ref parser.Node) ref u8 = trust {
    val base_node: ref parser.Node = parser.field_base(expr)
    val fname: ref u8 = parser.field_name(expr)
    val bt: ref u8 = cc_field_base_type_name(ctx, base_node)
    val fields: mut ref void = cc_lookup_struct(ctx, bt)
    if fields == none && str.raw_cmp(bt, "") != 0 {
        val btlen2: i64 = str.len_raw(bt)
        val dotpos2: mut i64 = -1
        val bi2: mut i64 = 0
        for {
            if bi2 >= btlen2 {
                break
            }
            if @load8(@ptradd(bt, bi2)) == 46 {
                dotpos2 = bi2
            }
            bi2++
        }
        if dotpos2 >= 0 {
            val suffix2: ref u8 = @ptradd(bt, dotpos2 + 1) as ref u8
            fields = cc_lookup_struct(ctx, suffix2)
        }
    }
    if fields != none {
        return cc_field_ctype_from_fields(ctx, fields, fname)
    }
    return "int64_t"
}

fn gen_stmts(ctx: mut ref CCtx, stmts: ref parser.Node) void = trust {
    if stmts == none {
        return
    }
    val old_depth: i64 = @len(ctx.defer_stack) as i64
    val len: i64 = @len(stmts) as i64
    val i: mut i64 = 0
    val terminated: mut bool = false
    for {
        if i >= len {
            break
        }
        val s_opt = @get(stmts, i as usize)
        if s_opt is some s {
            val sn: ref parser.Node = s as ref parser.Node
            if sn.kind == parser.NK_GENERIC_WHEN {
                val matched: mut bool = false
                val matched_terminated: mut bool = false
                val j: mut i64 = i
                for {
                    if j >= len {
                        break
                    }
                    val s_opt2 = @get(stmts, j as usize)
                    if s_opt2 is some s2 {
                        val sn2: ref parser.Node = s2 as ref parser.Node
                        if sn2.kind != parser.NK_GENERIC_WHEN {
                            break
                        }
                        if !matched && cc_gwhen_matches(ctx, sn2) {
                            gen_stmts(ctx, sn2.d1 as ref parser.Node)
                            matched = true
                            matched_terminated = cc_stmts_terminated(
                                ctx,
                                sn2.d1 as ref parser.Node
                            )
                        }
                    } else {
                        break
                    }
                    j++
                }
                if matched_terminated {
                    terminated = true
                    break
                }
                i = j
                continue
            } else {
                gen_stmt(ctx, sn)
                if cc_stmt_terminated(ctx, sn) {
                    terminated = true
                    break
                }
            }
        }
        i++
    }

    if terminated {
        cc_discard_block_defers(ctx, old_depth)
    } else {
        cc_handle_block_defers(ctx, old_depth)
    }
}

fn gen_stmt(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    if stmt == none {
        return
    }
    emit_line_directive(ctx, stmt.line)
    val k: i64 = stmt.kind
    if k == parser.NK_VAL {
        val name: ref u8 = stmt.d0 as ref u8
        val mutable: i64 = stmt.d1
        val ty_node: mut ref parser.Node = stmt.d2 as ref parser.Node
        val init_expr: ref parser.Node = stmt.d3 as ref parser.Node
        if ctx.autovec_plan != none {
            val plan: ref autovec.Plan = ctx.autovec_plan as ref autovec.Plan
            val vec_val: ref u8 = gen_expr(ctx, init_expr)
            val vbuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (str.len_raw(vec_val) + 160) as usize
            ) as ref u8
            if ctx.simd_backend == 1 {
                @snprintf(
                    vbuf,
                    str.len_raw(vec_val) + 160,
                    "{s} t_{s}={s};\n",
                    {plan.vec_type, name, vec_val}
                )
            } else {
                @snprintf(
                    vbuf,
                    str.len_raw(vec_val) + 160,
                    "{s} t_{s}=({s})({s});\n",
                    {plan.vec_type, name, plan.vec_type, vec_val}
                )
            }
            emit(ctx, vbuf)
            cc_expr_drain(ctx)
            cc_register_local(ctx, name, plan.vec_type, none, 1)
            return
        }
        if ty_node == none && init_expr != none {
            val ie: mut ref parser.Node = init_expr
            if init_expr.kind == parser.NK_TRY || init_expr.kind == parser.NK_TRUST {
                ie = init_expr.d0 as ref parser.Node
            }
            if ie != none && ie.kind == parser.NK_CALL {
                val ret: ref parser.Node = cc_infer_call_ret_ty(ctx, ie)
                if ret != none {
                    val rk: i64 = ret.kind
                    if rk == parser.TY_RESULT {
                        val inner: ref parser.Node = ret.d0 as ref parser.Node
                        if inner != none && inner.kind != parser.TY_VOID {
                            ty_node = inner
                        }
                    } elif rk == parser.TY_OPTION {
                        ty_node = ret
                    } elif rk != parser.TY_VOID {
                        ty_node = ret
                    }
                }
            }
            if ty_node == none {
                ty_node = cc_infer_expr_ty(ctx, init_expr)
            }
        }
        ty_node = cc_concrete_ty(ctx, ty_node)
        val old_expected = ctx.expected_ty
        ctx.expected_ty = ty_node
        val val_str: ref u8 = gen_expr(ctx, init_expr)
        ctx.expected_ty = old_expected
        val ct: mut ref u8 = "int64_t"
        if ty_node != none {
            ct = cc_c_type_of(ctx, ty_node)
        }

        if ty_node != none && ty_node.kind == parser.TY_FIXED_ARR {
            val arr_sz: i64 = c_size_of(ctx, ty_node)
            val decl_cap: i64 = str.len_raw(name) + 128
            val decl: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (decl_cap) as usize
            ) as ref u8
            @snprintf(
                decl,
                decl_cap,
                "int64_t t_{s}=(int64_t)(intptr_t)calloc(1,{lld});\n",
                {name, arr_sz}
            )
            emit(ctx, decl)
            if !cc_expr_is_zero_init_like(init_expr) {
                val copy_cap: i64 = str.len_raw(name) + str.len_raw(val_str) + 160
                val copy: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    (copy_cap) as usize
                ) as ref u8
                @snprintf(
                    copy,
                    copy_cap,
                    "memcpy((void*)(intptr_t)t_{s},(void*)(intptr_t)({s}),(size_t){lld});\n",
                    {name, val_str, arr_sz}
                )
                emit(ctx, copy)
            }
            cc_expr_drain(ctx)
            val is_slot_arr: mut i64 = 0
            if mutable != 0 {
                is_slot_arr = 1
            }
            cc_register_local(
                ctx,
                name,
                cc_spectre_type_name_of(ctx, ty_node),
                ty_node,
                is_slot_arr
            )
            return
        }

        if ty_node != none && cc_is_aggregate_storage(ctx, ty_node) &&
        (init_expr == none || cc_expr_is_zero_init_like(init_expr)) {
            val agg_sz: i64 = c_size_of(ctx, ty_node)
            val decl_cap2: i64 = str.len_raw(name) + 128
            val decl2: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                (decl_cap2) as usize
            ) as ref u8
            @snprintf(
                decl2,
                decl_cap2,
                "int64_t t_{s}=(int64_t)(intptr_t)calloc(1,{lld});\n",
                {name, agg_sz}
            )
            emit(ctx, decl2)
            cc_expr_drain(ctx)
            val is_slot_z: mut i64 = 0
            if mutable != 0 {
                is_slot_z = 1
            }
            cc_register_local(
                ctx,
                name,
                cc_spectre_type_name_of(ctx, ty_node),
                ty_node,
                is_slot_z
            )
            return
        }

        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 8192 as usize) as ref u8
        @snprintf(
            buf,
            8192,
            "{s} t_{s}=({s})({s});\n",
            {ct, name, ct, val_str}
        )
        emit(ctx, buf)
        cc_expr_drain(ctx)
        val is_slot: mut i64 = 0
        if mutable != 0 {
            is_slot = 1
        }
        cc_register_local(ctx, name, cc_spectre_type_name_of(ctx, ty_node), ty_node, is_slot)
        return
    }
    if k == parser.NK_ASSIGN {
        val target: ref parser.Node = stmt.d0 as ref parser.Node
        val old_expected = ctx.expected_ty
        if target.kind == parser.NK_IDENT {
            ctx.expected_ty = cc_lookup_local_ty_node(ctx, target.d0 as ref u8)
        } elif target.kind == parser.NK_DEREF {
            val ptr_ty: ref parser.Node = cc_infer_expr_ty(ctx, target.d0 as ref parser.Node)
            ctx.expected_ty = cc_unwrap_ref_inner_ty(ptr_ty)
        }
        val val_str: ref u8 = gen_expr(ctx, stmt.d1 as ref parser.Node)
        ctx.expected_ty = old_expected
        if target.kind == parser.NK_IDENT {
            val name: ref u8 = target.d0 as ref u8
            val gn: ref u8 = cc_resolve_global_name(ctx, name)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            if str.raw_cmp(gn, "") != 0 {
                @snprintf(buf, 4096, "{s}=({s});\n", {gn, val_str})
            } else {
                @snprintf(buf, 4096, "t_{s}=({s});\n", {name, val_str})
            }
            emit(ctx, buf)
        } elif target.kind == parser.NK_FIELD {
            val fsz: i64 = cc_field_size_of_expr(ctx, target)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, target)
            val fty: ref parser.Node = cc_infer_expr_ty(ctx, target)
            val fa: ref u8 = gen_field_addr(
                ctx,
                target
            )
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            if cc_type_needs_aggregate_copy(ctx, fty) || fsz > 8 {
                @snprintf(
                    buf,
                    4096,
                    "memcpy((void*)(intptr_t)({s}),(void*)(intptr_t)({s}),(size_t){lld});\n",
                    {fa, val_str, fsz}
                )
            } else {
                @snprintf(
                    buf,
                    4096,
                    "*({s}*)(intptr_t)({s})=({s})({s});\n",
                    {fct, fa, fct, val_str}
                )
            }
            emit(ctx, buf)
        } elif target.kind == parser.NK_DEREF {
            val ptr: ref u8 = gen_expr(ctx, target.d0 as ref parser.Node)
            val ptr_ty: ref parser.Node = cc_infer_expr_ty(ctx, target.d0 as ref parser.Node)
            val inner_ty: ref parser.Node = cc_unwrap_ref_inner_ty(ptr_ty)
            val resolved_inner: ref parser.Node = cc_concrete_ty(ctx, inner_ty)
            val is_list: bool = resolved_inner != none
            && resolved_inner.kind == parser.TY_LIST
            val isz: i64 = c_size_of(ctx, inner_ty)
            val ict: ref u8 = cc_c_type_of(ctx, inner_ty)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            if !is_list && (cc_type_needs_aggregate_copy(ctx, inner_ty) || isz > 8) {
                @snprintf(
                    buf,
                    4096,
                    "memcpy((void*)(intptr_t)({s}),(void*)(intptr_t)({s}),(size_t){lld});\n",
                    {ptr, val_str, isz}
                )
            } else {
                @snprintf(
                    buf,
                    4096,
                    "*({s}*)(intptr_t)({s})=({s})({s});\n",
                    {ict, ptr, ict, val_str}
                )
            }
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_RETURN {
        val expr: ref parser.Node = stmt.d0 as ref parser.Node
        cc_emit_defers(ctx)
        if expr == none {
            if str.raw_cmp(ctx.current_ret_ctype, "void") == 0 {
                emitln(ctx, "return;")
            } else {
                emitln(ctx, "return 0;")
            }
        } else {
            val old_expected = ctx.expected_ty
            ctx.expected_ty = ctx.current_ret_ty
            val rv: ref u8 = gen_expr(ctx, expr)
            ctx.expected_ty = old_expected
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                8192 as usize
            ) as ref u8
            if ctx.current_ret_unboxed {
                @snprintf(
                    buf,
                    8192,
                    "memcpy(sx__ret,(void*)(intptr_t)({s}),24);return 0;\n",
                    {rv}
                )
            } else {
                @snprintf(
                    buf,
                    8192,
                    "return({s})({s});\n",
                    {ctx.current_ret_ctype, rv}
                )
            }
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_EXPR_STMT {
        val ev: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            8192 as usize
        ) as ref u8
        @snprintf(
            buf,
            8192,
            "(void)({s});\n",
            {ev}
        )
        emit(ctx, buf)
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_IF {
        gen_if_stmt(ctx, stmt)
        return
    }
    if k == parser.NK_GUARD {
        val gc: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            4096 as usize
        ) as ref u8
        @snprintf(
            buf,
            4096,
            "if(!({s}))\n",
            {gc}
        )
        emit(ctx, buf)
        emitln(ctx, "{")
        cc_expr_drain(ctx)
        gen_stmts(ctx, stmt.d1 as ref parser.Node)
        emitln(ctx, "}")
        return
    }
    if k == parser.NK_FOR {
        gen_for_stmt(ctx, stmt)
        return
    }
    if k == parser.NK_FORIN {
        gen_forin_stmt(ctx, stmt)
        return
    }
    if k == parser.NK_BREAK {
        emitln(ctx, "break;")
        return
    }
    if k == parser.NK_CONTINUE {
        emitln(ctx, "continue;")
        return
    }
    if k == parser.NK_TRUST_BLOCK {
        gen_stmts(ctx, stmt.d0 as ref parser.Node)
        return
    }
    if k == parser.NK_DEFER {
        cc_defer_push(ctx, stmt.d0 as ref parser.Node)
        return
    }
    if k == parser.NK_ASSERT {
        val cond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
        val line: i64 = stmt.line
        val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
        @snprintf(
            buf,
            512,
            "if(!({s}))\{fprintf(stderr,\"spectre: assertion failed at line {lld}\\n\");fflush(stderr);exit(1);}\n",
            {cond, line}
        )
        emit(ctx, buf)
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_PRE || k == parser.NK_GUARDED_PRE || k == parser.NK_POST || k == parser.NK_GUARDED_POST {
        if ctx.release_mode {
            if k == parser.NK_PRE || k == parser.NK_POST {
                return
            }
        }
        val is_pre: bool = k == parser.NK_PRE || k == parser.NK_GUARDED_PRE
        val ks: mut ref u8 = "precondition"
        if !is_pre {
            ks = "postcondition"
        }
        val fn_n: ref u8 = ctx.fn_name
        val clist: ref void = stmt.d0 as ref void
        if clist != none {
            val clen: i64 = @len(clist) as i64
            val ci: mut i64 = 0
            for {
                if ci >= clen {
                    break
                }
                val c_opt = @get(clist, ci as usize)
                if c_opt is some c {
                    val cn: ref parser.Node = c as ref parser.Node
                    val label: ref u8 = cn.d0 as ref u8
                    val cexpr: ref parser.Node = cn.d1 as ref parser.Node
                    val cv: ref u8 = gen_expr(
                        ctx,
                        cexpr
                    )
                    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        1024 as usize
                    ) as ref u8
                    if label != none {
                        @snprintf(
                            buf,
                            1024,
                            "if(!({s}))\{fprintf(stderr,\"spectre: {s} '%%s' violated in function '%%s'\\n\",\"{s}\",\"{s}\");fflush(stderr);exit(1);}\n",
                            {cv, ks, label, fn_n}
                        )
                    } else {
                        @snprintf(
                            buf,
                            1024,
                            "if(!({s}))\{fprintf(stderr,\"spectre: {s} violated in function '%%s'\\n\",\"{s}\");fflush(stderr);exit(1);}\n",
                            {cv, ks, fn_n}
                        )
                    }
                    emit(ctx, buf)
                    cc_expr_drain(ctx)
                }
                ci++
            }
        }
        return
    }
    if k == parser.NK_MATCH_OPT {
        gen_match_opt(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_RES {
        gen_match_res(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_ENUM {
        gen_match_enum(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_VALUE {
        gen_match_value(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_STR {
        gen_match_str(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_UNION {
        gen_match_union(ctx, stmt)
        return
    }
    if k == parser.NK_MATCH_TAGGED_UNION {
        gen_match_tagged_union(ctx, stmt)
        return
    }
    if k == parser.NK_GENERIC_WHEN {
        return
    }
    if k == parser.NK_WHEN_STMT {
        val plat: ref u8 = stmt.d0 as ref u8
        if cc_platform_matches(ctx, plat) {
            gen_stmts(ctx, stmt.d1 as ref parser.Node)
        } else {
            val ow: ref void = stmt.d2 as ref void
            val matched: mut bool = false
            if ow != none {
                for own in ow as list[ref parser.Node] {
                    if !matched {
                        if cc_platform_matches(ctx, own.d0 as ref u8) {
                            gen_stmts(ctx, own.d1 as ref parser.Node)
                            matched = true
                        }
                    }
                }
            }
            if !matched {
                val otherwise: ref void = stmt.d3 as ref void
                if otherwise != none {
                    gen_stmts(ctx, stmt.d3 as ref parser.Node)
                }
            }
        }
        return
    }
    if k == parser.NK_INCREMENT {
        val tgt: ref parser.Node = stmt.d0 as ref parser.Node
        if tgt.kind == parser.NK_IDENT {
            val name: ref u8 = tgt.d0 as ref u8
            val gn: ref u8 = cc_resolve_global_name(ctx, name)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            if str.raw_cmp(gn, "") != 0 {
                @snprintf(buf, 128, "{s}++;\n", {gn})
            } else {
                @snprintf(buf, 128, "t_{s}++;\n", {name})
            }
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))++;\n", {fct, fa})
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(
                ctx,
                tgt.d0 as ref parser.Node
            )
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(
                buf,
                256,
                "(*({s}*)(intptr_t)({s}))++;\n",
                {ict, p}
            )
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_DECREMENT {
        val tgt: ref parser.Node = stmt.d0 as ref parser.Node
        if tgt.kind == parser.NK_IDENT {
            val name: ref u8 = tgt.d0 as ref u8
            val gn: ref u8 = cc_resolve_global_name(ctx, name)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            if str.raw_cmp(gn, "") != 0 {
                @snprintf(buf, 128, "{s}--;\n", {gn})
            } else {
                @snprintf(buf, 128, "t_{s}--;\n", {name})
            }
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))--;\n", {fct, fa})
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(
                ctx,
                tgt.d0 as ref parser.Node
            )
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(
                buf,
                256,
                "(*({s}*)(intptr_t)({s}))--;\n",
                {ict, p}
            )
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_ADD_ASSIGN {
        val tgt: ref parser.Node = stmt.d0 as ref parser.Node
        val rhs: ref u8 = gen_expr(
            ctx,
            stmt.d1 as ref parser.Node
        )
        if tgt.kind == parser.NK_IDENT {
            val name: ref u8 = tgt.d0 as ref u8
            val gn: ref u8 = cc_resolve_global_name(ctx, name)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            if str.raw_cmp(gn, "") != 0 {
                @snprintf(buf, 256, "{s}+=({s});\n", {gn, rhs})
            } else {
                @snprintf(buf, 256, "t_{s}+=({s});\n", {name, rhs})
            }
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))+=({s});\n", {fct, fa, rhs})
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))+=({s});\n", {ict, p, rhs})
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
    if k == parser.NK_SUB_ASSIGN {
        val tgt: ref parser.Node = stmt.d0 as ref parser.Node
        val rhs: ref u8 = gen_expr(
            ctx,
            stmt.d1 as ref parser.Node
        )
        if tgt.kind == parser.NK_IDENT {
            val name: ref u8 = tgt.d0 as ref u8
            val gn: ref u8 = cc_resolve_global_name(ctx, name)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            if str.raw_cmp(gn, "") != 0 {
                @snprintf(buf, 256, "{s}-=({s});\n", {gn, rhs})
            } else {
                @snprintf(buf, 256, "t_{s}-=({s});\n", {name, rhs})
            }
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))-=({s});\n", {fct, fa, rhs})
            emit(ctx, buf)
        } elif tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))-=({s});\n", {ict, p, rhs})
            emit(ctx, buf)
        }
        cc_expr_drain(ctx)
        return
    }
}

fn gen_if_stmt(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    if ctx.autovec_plan != none {
        val plan: ref autovec.Plan = ctx.autovec_plan as ref autovec.Plan
        cc_autovec_select(ctx, plan, stmt)
        return
    }
    val cond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    @snprintf(
        buf,
        4096,
        "if({s})\n",
        {cond}
    )
    emit(ctx, buf)
    emitln(ctx, "{")
    cc_expr_drain(ctx)
    gen_stmts(ctx, stmt.d1 as ref parser.Node)
    val elif_list: ref void = stmt.d2 as ref void
    if elif_list != none && @len(elif_list as list[ref void]) > 0 {
        val elen: i64 = @len(elif_list as list[ref void]) as i64
        val ei: mut i64 = 0
        for {
            if ei >= elen {
                break
            }
            val ep_opt = @get(elif_list as list[ref void], ei as usize)
            if ep_opt is some ep {
                val econd: ref u8 = gen_expr(ctx, (ep as ref parser.Node).d0 as ref parser.Node)
                val eb: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    4096 as usize
                ) as ref u8
                @snprintf(eb, 4096, "}else if({s})\n", {econd})
                emit(ctx, eb)
                emitln(ctx, "{")
                cc_expr_drain(ctx)
                gen_stmts(ctx, (ep as ref parser.Node).d1 as ref parser.Node)
            }
            ei++
        }
    }
    if stmt.d3 != 0 {
        emitln(ctx, "}else{")
        gen_stmts(ctx, (stmt.d3 as ref parser.Node).d0 as ref parser.Node)
    }
    emitln(ctx, "}")
}

fn cc_autovec_offset(ctx: ref CCtx, plan: ref autovec.Plan) ref u8 = trust {
    val idx: ref u8 = plan.index
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
    @snprintf(buf, 128, "(t_{s}*(INT64_C({lld})))", {idx, plan.elem_size})
    return buf
}

fn cc_autovec_load_expr(
    ctx: mut ref CCtx,
    plan: ref autovec.Plan,
    node: ref parser.Node
) ref u8 = trust {
    val ptr: ref parser.Node = autovec.Plan.load_ptr(plan, node)
    val base_node: ref parser.Node = autovec.Plan.ptr_base(plan, ptr)
    val base: ref u8 = gen_expr(ctx, base_node)
    val off: ref u8 = cc_autovec_offset(ctx, plan)
    val suffix: mut ref u8 = "i32"
    if plan.elem_size != 4 {
        suffix = "i64"
    }
    val cap: i64 = str.len_raw(base) + str.len_raw(off) + 192
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, cap as usize) as ref u8
    @snprintf(
        buf,
        cap,
        "sx__vload_{s}((void*)(intptr_t)((char*)(intptr_t)({s})+({s})))",
        {suffix, base, off}
    )
    return cc_expr_track(ctx, buf)
}

fn cc_autovec_store_expr(
    ctx: mut ref CCtx,
    plan: ref autovec.Plan,
    node: ref parser.Node
) ref u8 = trust {
    val ptr: ref parser.Node = autovec.Plan.store_ptr(plan, node)
    val base_node: ref parser.Node = autovec.Plan.ptr_base(plan, ptr)
    val value_node: ref parser.Node = autovec.Plan.store_value(plan, node)
    val base: ref u8 = gen_expr(ctx, base_node)
    val value: ref u8 = gen_expr(ctx, value_node)
    val off: ref u8 = cc_autovec_offset(ctx, plan)
    val suffix: mut ref u8 = "i32"
    if plan.elem_size != 4 {
        suffix = "i64"
    }
    val cap: i64 = str.len_raw(base) + str.len_raw(value) + str.len_raw(off) + 256
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, cap as usize) as ref u8
    if ctx.simd_backend == 1 {
        @snprintf(
            buf,
            cap,
            "sx__vstore_{s}((void*)(intptr_t)((char*)(intptr_t)({s})+({s})),{s})",
            {suffix, base, off, value}
        )
    } else {
        @snprintf(
            buf,
            cap,
            "sx__vstore_{s}((void*)(intptr_t)((char*)(intptr_t)({s})+({s})),({s})({s}))",
            {suffix, base, off, plan.vec_type, value}
        )
    }
    return cc_expr_track(ctx, buf)
}

fn cc_autovec_select(
    ctx: mut ref CCtx,
    plan: ref autovec.Plan,
    stmt: ref parser.Node
) void = trust {
    val cond: ref u8 = gen_expr(ctx, stmt.d0 as ref parser.Node)
    val then_store: ref parser.Node = autovec.Plan.select_then_store(plan, stmt)
    val else_store: ref parser.Node = autovec.Plan.select_else_store(plan, stmt)
    val then_value: ref u8 = gen_expr(ctx, autovec.Plan.store_value(plan, then_store))
    val else_value: ref u8 = gen_expr(ctx, autovec.Plan.store_value(plan, else_store))
    val ptr: ref parser.Node = autovec.Plan.store_ptr(plan, then_store)
    val base_node: ref parser.Node = autovec.Plan.ptr_base(plan, ptr)
    val base: ref u8 = gen_expr(ctx, base_node)
    val off: ref u8 = cc_autovec_offset(ctx, plan)
    val suffix: mut ref u8 = "i32"
    if plan.elem_size != 4 {
        suffix = "i64"
    }
    val cap: i64 = str.len_raw(cond) + str.len_raw(then_value)
    + str.len_raw(else_value) + str.len_raw(base) + str.len_raw(off) + 512
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, cap as usize) as ref u8
    if ctx.simd_backend == 1 {
        @snprintf(
            buf,
            cap,
            "sx__vstore_{s}((void*)(intptr_t)((char*)(intptr_t)({s})+({s})),sx__vselect_{s}({s},{s},{s}));\n",
            {suffix, base, off, suffix, cond, then_value, else_value}
        )
    } else {
        @snprintf(
            buf,
            cap,
            "sx__vstore_{s}((void*)(intptr_t)((char*)(intptr_t)({s})+({s})),sx__vselect_{s}(({s})({s}),({s})({s}),({s})({s})));\n",
            {
                suffix,
                base,
                off,
                suffix,
                plan.vec_type,
                cond,
                plan.vec_type,
                then_value,
                plan.vec_type,
                else_value
            }
        )
    }
    emit(ctx, buf)
    cc_expr_drain(ctx)
}

fn cc_gen_autovec_vector(
    ctx: mut ref CCtx,
    plan: ref autovec.Plan,
    stmt: ref parser.Node
) void = trust {
    val end_src: ref u8 = gen_expr(ctx, plan.end_expr)
    val end_tmp: i64 = fresh_tmp(ctx)
    val lane_macro: mut ref u8 = "SX__VLANES_I64"
    val guard_macro: mut ref u8 = "SX__HAVE_VECTOR_I64"
    if plan.elem_size == 4 {
        lane_macro = "SX__VLANES_I32"
        guard_macro = "SX__HAVE_VECTOR_I32"
    }
    val head_cap: i64 = str.len_raw(end_src) + 256
    val head: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        head_cap as usize
    ) as ref u8
    @snprintf(
        head,
        head_cap,
        "#if {s}\n\{int64_t sx__ve{lld}=({s});for(;((t_{s})+{s})<=(sx__ve{lld});t_{s}+={s})\n\{\n",
        {guard_macro, end_tmp, end_src, plan.index, lane_macro, end_tmp, plan.index, lane_macro}
    )
    emit(ctx, head)
    cc_expr_drain(ctx)
    val raw_list: list[ref parser.Node] = stmt.d4 as list[ref parser.Node]
    val raw_len: i64 = @len(raw_list) as i64
    val stop: mut i64 = raw_len
    if plan.trailing_increment {
        stop = raw_len - 1
    }
    val vec_body: mut list[ref parser.Node] = mem.new[ref parser.Node]()
    val bi: mut i64 = 0
    for {
        if bi >= stop {
            break
        }
        val it_opt = @get(raw_list, bi as usize)
        if it_opt is some it {
            @append(vec_body, it as ref parser.Node)
        }
        bi++
    }
    ctx.autovec_plan = plan
    gen_stmts(ctx, vec_body as ref parser.Node)
    ctx.autovec_plan = none
    emitln(ctx, "}}")
    emitln(ctx, "#endif")
}

fn gen_for_stmt(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val init_name: ref u8 = stmt.d0 as ref u8
    val cond_node: ref void = stmt.d2 as ref void
    val pst: ref void = stmt.d3 as ref void

    val has_block: mut bool = false
    if init_name != none {
        emitln(ctx, "{")
        has_block = true
        val init_val: ref u8 = gen_expr(ctx, stmt.d1 as ref parser.Node)
        val ib: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        @snprintf(ib, 256, "int64_t t_{s}=({s});\n", {init_name, init_val})
        emit(ctx, ib)
        cc_expr_drain(ctx)
        cc_register_local(ctx, init_name, "int64_t", none, 1)
    }

    val plan: mut autovec.Plan = {
        index: ""
        end_expr: none
        trailing_increment: false
    }
    if autovec.detect(stmt, @addr(plan)) {
        val can_vectorize: bool = ctx.simd_backend == 0
        || (ctx.simd_backend == 1 && plan.elem_size == 4)
        if can_vectorize {
            cc_gen_autovec_vector(ctx, @addr(plan), stmt)
        }
    }

    if cond_node != none {
        val cond: ref u8 = gen_expr(ctx, cond_node as ref parser.Node)
        if pst != none {
            val pst_str: ref u8 = gen_for_post_expr(ctx, pst as ref parser.Node)
            val wb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
            @snprintf(wb, 512, "for(;{s};{s})\n", {cond, pst_str})
            emit(ctx, wb)
            emitln(ctx, "{")
        } else {
            val wb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
            @snprintf(wb, 256, "while({s})\n", {cond})
            emit(ctx, wb)
            emitln(ctx, "{")
        }
        cc_expr_drain(ctx)
    } else {
        emitln(ctx, "for(;;){")
    }
    gen_stmts(ctx, stmt.d4 as ref parser.Node)
    emitln(ctx, "}")
    if has_block {
        emitln(ctx, "}")
    }
}

/// Convert a for-loop post-step statement node into an expression string
fn gen_for_post_expr(ctx: mut ref CCtx, pst: ref parser.Node) ref u8 = trust {
    if pst == none {
        return ""
    }
    val k: i64 = pst.kind
    val tgt: ref parser.Node = pst.d0 as ref parser.Node
    val name: mut ref u8 = none
    if tgt != none && tgt.kind == parser.NK_IDENT {
        name = tgt.d0 as ref u8
    }
    if k == parser.NK_INCREMENT {
        if name != none {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf, 128, "t_{s}++", {name})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))++", {fct, fa})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))++", {ict, p})
            return cc_expr_track(ctx, buf)
        }
        return ""
    }
    if k == parser.NK_DECREMENT {
        if name != none {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                128 as usize
            ) as ref u8
            @snprintf(buf, 128, "t_{s}--", {name})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))--", {fct, fa})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))--", {ict, p})
            return cc_expr_track(ctx, buf)
        }
        return ""
    }
    if k == parser.NK_ADD_ASSIGN {
        val rhs: ref u8 = gen_expr(ctx, pst.d1 as ref parser.Node)
        if name != none {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "t_{s}+=({s})", {name, rhs})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))+=({s})", {fct, fa, rhs})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))+=({s})", {ict, p, rhs})
            return cc_expr_track(ctx, buf)
        }
        return ""
    }
    if k == parser.NK_SUB_ASSIGN {
        val rhs: ref u8 = gen_expr(ctx, pst.d1 as ref parser.Node)
        if name != none {
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "t_{s}-=({s})", {name, rhs})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_FIELD {
            val fa: ref u8 = gen_field_addr(ctx, tgt)
            val fct: ref u8 = cc_field_ctype_of_expr(ctx, tgt)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                4096 as usize
            ) as ref u8
            @snprintf(buf, 4096, "(*({s}*)({s}))-=({s})", {fct, fa, rhs})
            return cc_expr_track(ctx, buf)
        }
        if tgt.kind == parser.NK_DEREF {
            val p: ref u8 = gen_expr(ctx, tgt.d0 as ref parser.Node)
            val ict: ref u8 = cc_deref_c_type(ctx, tgt.d0 as ref parser.Node)
            val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(buf, 256, "(*({s}*)(intptr_t)({s}))-=({s})", {ict, p, rhs})
            return cc_expr_track(ctx, buf)
        }
        return ""
    }
    return gen_expr(ctx, pst)
}

fn gen_forin_stmt(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val binding: ref u8 = stmt.d0 as ref u8
    val iter_node: ref parser.Node = stmt.d1 as ref parser.Node
    val iter: ref u8 = gen_expr(ctx, iter_node)
    val t: i64 = fresh_tmp(ctx)

    val iter_ty_pre: ref parser.Node = cc_infer_expr_ty(ctx, iter_node)
    val concrete_pre0: ref parser.Node = cc_concrete_ty(ctx, iter_ty_pre)
    val concrete_pre: mut ref parser.Node = concrete_pre0
    for {
        if concrete_pre == none || concrete_pre.kind != parser.TY_MUT {
            break
        }
        concrete_pre = cc_concrete_ty(ctx, concrete_pre.d0 as ref parser.Node)
    }
    if concrete_pre != none && concrete_pre.kind == parser.TY_FIXED_ARR {
        val fixed_count: i64 = cc_fixed_arr_size_val(ctx, concrete_pre)
        val fixed_inner: ref parser.Node = parser.fixed_arr_inner(concrete_pre)
        val fixed_ctype: ref u8 = c_type_of(fixed_inner)
        val fixed_stype: ref u8 = cc_spectre_type_name_of(ctx, fixed_inner)
        val fixed_size: i64 = c_size_of(ctx, fixed_inner)
        val fixed_scalar: bool = cc_elem_is_scalar(ctx, fixed_inner)
        || (fixed_inner != none && fixed_inner.kind == parser.TY_REF)
        val fixed_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            1024 as usize
        ) as ref u8
        if fixed_scalar {
            @snprintf(fixed_buf, 1024,
                "\{int64_t sx__i{lld}=0;for(;sx__i{lld}<{lld};sx__i{lld}++)\{{s} t_{s}=*(({s}*)((char*)(intptr_t)({s})+sx__i{lld}*{lld}));\n",
                {
                    t,
                    t,
                    fixed_count,
                    t,
                    fixed_ctype,
                    binding,
                    fixed_ctype,
                    iter,
                    t,
                    fixed_size
                })
        } else {
            @snprintf(fixed_buf, 1024,
                "\{int64_t sx__i{lld}=0;for(;sx__i{lld}<{lld};sx__i{lld}++)\{int64_t t_{s}=(int64_t)(intptr_t)((char*)(intptr_t)({s})+sx__i{lld}*{lld});\n",
                {t, t, fixed_count, t, binding, iter, t, fixed_size})
        }
        emit(ctx, fixed_buf)
        cc_expr_drain(ctx)
        cc_register_local(ctx, binding, fixed_stype, fixed_inner, 1)
        gen_stmts(ctx, stmt.d2 as ref parser.Node)
        emitln(ctx, "}}")
        return
    }

    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(buf, 1024, "\{int64_t sx__it{lld}={s};int64_t sx__len{lld}=(sx__it{lld}==0?0:*(int64_t*)((char*)(intptr_t)sx__it{lld}+8));int64_t*sx__buf{lld}=(sx__it{lld}==0?0:*(int64_t**)(intptr_t)sx__it{lld});int64_t sx__i{lld}=0;for(;sx__i{lld}<sx__len{lld};sx__i{lld}++)\{int64_t t_{s}=sx__buf{lld}[sx__i{lld}];\n",
        {t, iter, t, t, t, t, t, t, t, t, t, t, binding, t, t})
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val elem_stype: mut ref u8 = "int64_t"
    val elem_ty: mut ref parser.Node = none
    val iter_ty: ref parser.Node = cc_infer_expr_ty(ctx, iter_node)
    val inner_ty: ref parser.Node = cc_unwrap_list_elem_ty(iter_ty)
    if inner_ty != none {
        elem_stype = cc_spectre_type_name_of(ctx, inner_ty)
        elem_ty = inner_ty
    }
    cc_register_local(ctx, binding, elem_stype, elem_ty, 1)
    gen_stmts(ctx, stmt.d2 as ref parser.Node)
    emitln(ctx, "}}")
}

fn gen_match_opt(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_opt_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val sb: ref u8 = parser.match_opt_some_bind(stmt)
    val sbody: ref parser.Node = parser.match_opt_some_body(stmt)
    val nbody: ref parser.Node = parser.match_opt_none_body(stmt)
    val t: i64 = fresh_tmp(ctx)
    val stmt_cap: i64 = str.len_raw(expr) + 128
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, (stmt_cap) as usize) as ref u8
    if true {
        @snprintf(
            buf,
            stmt_cap,
            "\{int64_t* sx__mp{lld}=(int64_t*)(intptr_t)({s});if(sx__mp{lld}[0]!=0)\n",
            {t, expr, t}
        )
    } else {
        @snprintf(buf, stmt_cap, "\{int64_t sx__mv{lld}={s};if(sx__mv{lld}!=0)\n", {t, expr, t})
    }
    emit(ctx, buf)
    emitln(ctx, "{")
    cc_expr_drain(ctx)
    if sb != none {
        val bind_stype: mut ref u8 = "int64_t"
        val bind_ctype: mut ref u8 = "int64_t"
        val bind_ty: mut ref parser.Node = none
        val expr_ty: ref parser.Node = cc_infer_expr_ty(ctx, en)
        val opt_inner: ref parser.Node = cc_unwrap_option_inner_ty(expr_ty)
        if opt_inner != none {
            bind_stype = cc_spectre_type_name_of(ctx, opt_inner)
            bind_ctype = c_type_of(opt_inner)
            bind_ty = opt_inner
        }
        val vb: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
        if cc_is_unboxed_wrap(ctx, opt_inner) {
            @snprintf(
                vb,
                256,
                "int64_t t_{s}=(int64_t)(intptr_t)(&sx__mp{lld}[1]);\n",
                {sb, t}
            )
        } elif true {
            @snprintf(
                vb,
                256,
                "{s} t_{s}=*(({s}*)(intptr_t)(&sx__mp{lld}[1]));\n",
                {bind_ctype, sb, bind_ctype, t}
            )
        } else {
            @snprintf(
                vb,
                256,
                "{s} t_{s}=*(({s}*)(intptr_t)(sx__mv{lld}-1));\n",
                {bind_ctype, sb, bind_ctype, t}
            )
        }
        emit(ctx, vb)
        cc_register_local(ctx, sb, bind_stype, bind_ty, 0)
    }
    if sbody != none {
        gen_stmts(ctx, sbody.d0 as ref parser.Node)
    }
    emitln(ctx, "}else{")
    if nbody != none {
        gen_stmts(ctx, nbody.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn gen_match_res(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_res_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val ob: ref u8 = parser.match_res_ok_bind(stmt)
    val obody: ref parser.Node = parser.match_res_ok_body(stmt)
    val eb: ref u8 = parser.match_res_err_bind(stmt)
    val ebody: ref parser.Node = parser.match_res_err_body(stmt)
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    @snprintf(
        buf,
        4096,
        "\{int64_t*sx__rp{lld}=(int64_t*)(intptr_t)({s});if(sx__rp{lld}[0]==0)\n",
        {t, expr, t}
    )
    emit(ctx, buf)
    emitln(ctx, "{")
    cc_expr_drain(ctx)
    val expr_ty: ref parser.Node = cc_infer_expr_ty(ctx, en)
    val ok_ty: ref parser.Node = cc_unwrap_result_ok_ty(expr_ty)
    val err_ty: mut ref parser.Node = none
    if expr_ty != none && expr_ty.kind == parser.TY_RESULT {
        err_ty = expr_ty.d1 as ref parser.Node
    }
    if ob != none {
        val vb: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        val ok_ct: ref u8 = cc_c_type_of(ctx, ok_ty)
        val ok_is_float: bool = str.raw_cmp(ok_ct, "double") == 0
        || str.raw_cmp(ok_ct, "float") == 0
        if cc_is_unboxed_wrap(ctx, ok_ty) {
            @snprintf(vb, 256, "int64_t t_{s}=(int64_t)(intptr_t)(&sx__rp{lld}[1]);\n", {ob, t})
        } elif ok_is_float {
            @snprintf(
                vb,
                256,
                "{s} t_{s};memcpy(&t_{s},&sx__rp{lld}[1],sizeof({s}));\n",
                {ok_ct, ob, ob, t, ok_ct}
            )
        } else {
            @snprintf(vb, 256, "int64_t t_{s}=sx__rp{lld}[1];\n", {ob, t})
        }
        emit(ctx, vb)
        val bind_stype: mut ref u8 = "int64_t"
        val bind_ty: mut ref parser.Node = none
        if ok_ty != none {
            bind_stype = cc_spectre_type_name_of(ctx, ok_ty)
            bind_ty = ok_ty
        }
        cc_register_local(ctx, ob, bind_stype, bind_ty, 0)
    }
    if obody != none {
        gen_stmts(ctx, obody.d0 as ref parser.Node)
    }
    emitln(ctx, "}else{")
    if eb != none {
        val vb: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            256 as usize
        ) as ref u8
        if cc_is_unboxed_wrap(ctx, err_ty) {
            @snprintf(vb, 256, "int64_t t_{s}=(int64_t)(intptr_t)(&sx__rp{lld}[1]);\n", {eb, t})
        } else {
            @snprintf(vb, 256, "int64_t t_{s}=sx__rp{lld}[1];\n", {eb, t})
        }
        emit(ctx, vb)
        cc_register_local(ctx, eb, "int64_t", err_ty, 0)
    }
    if ebody != none {
        gen_stmts(ctx, ebody.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn gen_match_enum(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_enum_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val arms: list[ref parser.Node] = parser.match_enum_arms(stmt)
    val alen: i64 = @len(arms) as i64
    if alen == 0 {
        cc_expr_drain(ctx)
        return
    }
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        128 as usize
    ) as ref u8
    @snprintf(buf, 128, "\{int64_t sx__ev{lld}={s};\n", {t, expr})
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val ai: mut i64 = 0
    for {
        if ai >= alen {
            break
        }
        val arm_opt = @get(arms, ai as usize)
        if arm_opt is some arm {
            val an: ref parser.Node = arm as ref parser.Node
            val variant_name: ref u8 = an.d0 as ref u8
            val type_name: ref u8 = an.d2 as ref u8
            val eval_str: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(eval_str, 32, "{lld}", {ai})
            if type_name != none && str.raw_cmp(type_name, "") != 0 {
                val key: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                @snprintf(key, 512, "{s}__{s}", {type_name, variant_name})
                val found: ref u8 = cc_const_val(ctx, key)
                if str.raw_cmp(found, "") != 0 {
                    @snprintf(eval_str, 32, "{s}", {found})
                }
            }
            val ab: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 128 as usize) as ref u8
            if ai == 0 {
                @snprintf(ab, 128, "if(sx__ev{lld}=={s})\n", {t, eval_str})
            } else {
                @snprintf(ab, 128, "}else if(sx__ev{lld}=={s})\n", {t, eval_str})
            }
            emit(
                ctx,
                ab
            )
            emitln(
                ctx,
                "{"
            )
            gen_stmts(ctx, parser.match_enum_arm_body(an) as ref parser.Node)
        }
        ai++
    }
    emitln(ctx, "}}")
}

fn gen_match_value(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_value_expr(stmt)
    val expr_ty: ref parser.Node = cc_concrete_ty(ctx, cc_infer_expr_ty(ctx, en))
    val old_expected = ctx.expected_ty
    ctx.expected_ty = expr_ty
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    ctx.expected_ty = old_expected
    val arms: list[ref parser.Node] = parser.match_value_arms(stmt)
    val else_body: ref parser.Node = parser.match_value_else(stmt)
    val ct: mut ref u8 = "int64_t"
    if expr_ty != none {
        ct = cc_c_type_of(ctx, expr_ty)
    }
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 4096 as usize) as ref u8
    @snprintf(buf, 4096, "\{{s} sx__mv{lld}=({s})({s});\n", {ct, t, ct, expr})
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val an: ref parser.Node = arm as ref parser.Node
                val saved_expected = ctx.expected_ty
                ctx.expected_ty = expr_ty
                val pat: ref u8 = gen_expr(ctx, parser.match_value_arm_pattern(an))
                ctx.expected_ty = saved_expected
                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    4096 as usize
                ) as ref u8
                if ai == 0 {
                    @snprintf(ab, 4096, "if(sx__mv{lld}==({s})({s}))\n", {t, ct, pat})
                } else {
                    @snprintf(ab, 4096, "}else if(sx__mv{lld}==({s})({s}))\n", {t, ct, pat})
                }
                emit(
                    ctx,
                    ab
                )
                emitln(
                    ctx,
                    "{"
                )
                gen_stmts(ctx, parser.match_value_arm_body(an) as ref parser.Node)
            }
            ai++
        }
    }
    if else_body != none {
        emitln(ctx, "}else{")
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn gen_match_str(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_str_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val arms: list[ref parser.Node] = parser.match_str_arms(stmt)
    val else_body: ref parser.Node = parser.match_str_else(stmt)
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    @snprintf(
        buf,
        4096,
        "\{const char*sx__sv{lld}=(const char*)(intptr_t)({s});\n",
        {t, expr}
    )
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val an: ref parser.Node = arm as ref parser.Node
                val pat: ref u8 = parser.match_str_arm_value(an)
                val pi: i64 = intern_string(
                    ctx,
                    pat
                )
                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    4096 as usize
                ) as ref u8
                if ai == 0 {
                    @snprintf(ab, 4096, "if(strcmp(sx__sv{lld},sx__str{lld})==0)\n", {t, pi})
                } else {
                    @snprintf(ab, 4096, "}else if(strcmp(sx__sv{lld},sx__str{lld})==0)\n", {t, pi})
                }
                emit(
                    ctx,
                    ab
                )
                emitln(
                    ctx,
                    "{"
                )
                gen_stmts(ctx, parser.match_str_arm_body(an) as ref parser.Node)
            }
            ai++
        }
    }
    if else_body != none {
        emitln(ctx, "}else{")
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn gen_match_union(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_union_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val arms: list[ref parser.Node] = parser.match_union_arms(stmt)
    val else_body: ref parser.Node = parser.match_union_else(stmt)
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    @snprintf(
        buf,
        4096,
        "\{int64_t sx__uv{lld}=(int64_t)({s});int64_t sx__ut{lld}=*(int64_t*)(intptr_t)sx__uv{lld};\n",
        {t, expr, t, t}
    )
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    128 as usize
                ) as ref u8
                if ai == 0 {
                    @snprintf(ab, 128, "if(sx__ut{lld}=={lld})\n", {t, ai})
                } else {
                    @snprintf(ab, 128, "}else if(sx__ut{lld}=={lld})\n", {t, ai})
                }
                emit(
                    ctx,
                    ab
                )
                emitln(
                    ctx,
                    "{"
                )
                gen_stmts(
                    ctx,
                    parser.match_union_arm_body(arm as ref parser.Node) as ref parser.Node
                )
            }
            ai++
        }
    }
    if else_body != none {
        emitln(ctx, "}else{")
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn gen_match_tagged_union(ctx: mut ref CCtx, stmt: ref parser.Node) void = trust {
    val en: ref parser.Node = parser.match_tagged_union_expr(stmt)
    val expr: mut ref u8 = "0"
    if en != none {
        expr = gen_expr(ctx, en)
    }
    val arms: list[ref parser.Node] = parser.match_tagged_union_arms(stmt)
    val else_body: ref parser.Node = parser.match_tagged_union_else(stmt)
    val t: i64 = fresh_tmp(ctx)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        4096 as usize
    ) as ref u8
    @snprintf(
        buf,
        4096,
        "\{int64_t sx__tv{lld}=(int64_t)({s});int64_t sx__tt{lld}=*(int64_t*)(intptr_t)sx__tv{lld};\n",
        {t, expr, t, t}
    )
    emit(ctx, buf)
    cc_expr_drain(ctx)
    val alen: i64 = @len(arms) as i64
    if alen > 0 {
        val ai: mut i64 = 0
        for {
            if ai >= alen {
                break
            }
            val arm_opt = @get(arms, ai as usize)
            if arm_opt is some arm {
                val an: ref parser.Node = arm as ref parser.Node
                val vname: ref u8 = parser.match_tagged_union_arm_variant(an)
                val bindings: list[ref u8] = parser.match_tagged_union_arm_bindings(an)
                val os: ref void = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    8 as usize
                )
                val fs: ref void = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    8 as usize
                )
                @store(
                    os,
                    0
                )
                @store(fs, 0)
                val ti: i64 = cc_lookup_tv(ctx, vname, os, fs)
                val vtfields2: ref void = @load(fs) as ref void
                val idx: mut i64 = ai
                if ti >= 0 {
                    idx = ti
                }
                val ab: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    4096 as usize
                ) as ref u8
                if ai == 0 {
                    @snprintf(ab, 4096, "if(sx__tt{lld}=={lld})\n", {t, idx})
                } else {
                    @snprintf(ab, 4096, "}else if(sx__tt{lld}=={lld})\n", {t, idx})
                }
                emit(ctx, ab)
                emitln(ctx, "{")
                val blen: i64 = @len(bindings) as i64
                if blen > 0 {
                    val bi: mut i64 = 0
                    for {
                        if bi >= blen {
                            break
                        }
                        val b_opt = @get(bindings, bi as usize)
                        if b_opt is some b {
                            val bn: ref u8 = b as ref u8
                            if str.raw_cmp(bn, "_") != 0 {
                                val off: i64 = 8 + bi * 8
                                val bb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                    ctx.arena,
                                    1024 as usize
                                ) as ref u8
                                val is_float_bind: mut bool = false
                                val bind_ct: mut ref u8 = "int64_t"
                                val bind_st: mut ref u8 = "int64_t"
                                val bind_ty: mut ref parser.Node = none
                                if vtfields2 != none {
                                    val fty_opt2 = @get(
                                        vtfields2 as list[ref parser.Node],
                                        bi as usize
                                    )
                                    if fty_opt2 is some fty2 {
                                        val fct2: ref u8 = c_type_of(fty2 as ref parser.Node)
                                        bind_st = cc_spectre_type_name_of(
                                            ctx,
                                            fty2 as ref parser.Node
                                        )
                                        bind_ty = fty2 as ref parser.Node
                                        if str.raw_cmp(
                                            fct2,
                                            "double"
                                        ) == 0 || str.raw_cmp(fct2, "float") == 0 {
                                            is_float_bind = true
                                            bind_ct = fct2
                                        }
                                    }
                                }
                                if is_float_bind {
                                    @snprintf(
                                        bb,
                                        1024,
                                        "{s} t_{s}=*({s}*)((char*)(intptr_t)sx__tv{lld}+{lld});\n",
                                        {bind_ct, bn, bind_ct, t, off}
                                    )
                                    emit(
                                        ctx,
                                        bb
                                    )
                                    cc_register_local(ctx, bn, bind_st, bind_ty, 0)
                                } else {
                                    @snprintf(
                                        bb,
                                        1024,
                                        "int64_t t_{s}=*(int64_t*)((char*)(intptr_t)sx__tv{lld}+{lld});\n",
                                        {bn, t, off}
                                    )
                                    emit(
                                        ctx,
                                        bb
                                    )
                                    cc_register_local(ctx, bn, bind_st, bind_ty, 0)
                                }
                            }
                        }
                        bi++
                    }
                }
                gen_stmts(ctx, parser.match_tagged_union_arm_body(an) as ref parser.Node)
            }
            ai++
        }
    }
    if else_body != none {
        emitln(ctx, "}else{")
        gen_stmts(ctx, else_body.d0 as ref parser.Node)
    }
    emitln(ctx, "}}")
}

fn is_std_child_name(name: ref u8) bool = trust {
    return str.raw_cmp(name, "allocators") == 0
    || str.raw_cmp(name, "collections") == 0
    || str.raw_cmp(name, "crypto") == 0
    || str.raw_cmp(name, "env") == 0
    || str.raw_cmp(name, "fmt") == 0
    || str.raw_cmp(name, "encoding") == 0
    || str.raw_cmp(name, "fs") == 0
    || str.raw_cmp(name, "log") == 0
    || str.raw_cmp(name, "math") == 0
    || str.raw_cmp(name, "os") == 0
    || str.raw_cmp(name, "path") == 0
    || str.raw_cmp(name, "algorithms") == 0
    || str.raw_cmp(name, "random") == 0
    || str.raw_cmp(name, "reflection") == 0
    || str.raw_cmp(name, "stdio") == 0
    || str.raw_cmp(name, "string") == 0
    || str.raw_cmp(name, "str") == 0
    || str.raw_cmp(name, "time") == 0
    || str.raw_cmp(name, "thread") == 0
}

fn gen_fn_prefixed(ctx: mut ref CCtx, fn_node: ref parser.Node, mod_prefix: ref u8) void = trust {
    val ns: ref u8 = fn_node.d1 as ref u8
    val name: ref u8 = fn_node.d2 as ref u8
    val params: ref void = fn_node.d3 as ref void
    val ret_ty: ref parser.Node = fn_node.d4 as ref parser.Node
    val body: ref parser.Node = fn_node.d5 as ref parser.Node
    val base: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    if ns != none {
        @snprintf(base, 256, "{s}__{s}", {ns, name})
    } else {
        @snprintf(base, 256, "{s}", {name})
    }
    val is_std_child: bool = is_std_child_name(mod_prefix)
    val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 512 as usize) as ref u8
    if str.raw_cmp(mod_prefix, "") == 0 {
        if str.raw_cmp(base, "main") == 0 {
            @snprintf(mangled, 512, "{s}", {base})
        } else {
            @snprintf(mangled, 512, "sx__{s}", {base})
        }
    } elif is_std_child {
        @snprintf(mangled, 512, "std__{s}__{s}", {mod_prefix, base})
    } else {
        @snprintf(mangled, 512, "{s}__{s}", {mod_prefix, base})
    }
    if !cc_emit_label_if_new(ctx, mangled) {
        return
    }
    ctx.fn_name = mangled
    val saved_prefix: ref u8 = ctx.current_prefix
    if str.raw_cmp(mod_prefix, "") != 0 || str.raw_cmp(saved_prefix, "") == 0 {
        ctx.current_prefix = mod_prefix
    }
    if params != none {
        cc_register_fn(ctx, fn_node, mangled, params, ret_ty, false, false)
    }
    val ret_ct: ref u8 = c_ret_type_of(ctx, ret_ty)
    val ret_unboxed: bool = cc_is_unboxed_wrap(ctx, ret_ty)
    val is_main: bool = str.raw_cmp(name, "main") == 0 && str.raw_cmp(mod_prefix, "") == 0
    ctx.current_ret_ctype = ret_ct
    ctx.current_ret_is_void = is_void_ret(ret_ty)
    ctx.current_ret_unboxed = ret_unboxed && !is_main
    ctx.current_ret_ty = ret_ty
    cc_clear_locals(ctx)
    emit_line_directive(ctx, fn_node.line)
    if is_main {
        emitln(ctx, "int32_t main(int argc,char**argv){")
    } else {
        val sig: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            1024 as usize
        ) as ref u8
        val linkage: mut ref u8 = "static "
        if parser.fn_is_inline(fn_node) {
            linkage = "static inline "
        }
        @snprintf(
            sig,
            1024,
            "{s}{s} {s}(",
            {linkage, ret_ct, mangled}
        )
        emit(ctx, sig)
        if ret_unboxed {
            emit(ctx, "int64_t* sx__ret")
        }
        if params != none {
            val plen: i64 = @len(params) as i64
            if plen == 0 {
                if !ret_unboxed {
                    emit(ctx, "void")
                }
            }
            if ret_unboxed && plen > 0 {
                emit(ctx, ",")
            }
            val pi: mut i64 = 0
            for {
                if pi >= plen {
                    break
                }
                val p_opt = @get(params, pi as usize)
                if p_opt is some param {
                    val pn: ref u8 = (param as ref parser.Node).d0 as ref u8
                    val pt: ref parser.Node = (param as ref parser.Node).d1 as ref parser.Node
                    val pct: ref u8 = cc_c_type_of(ctx, pt)
                    if pi > 0 {
                        emit(ctx, ",")
                    }
                    val pb: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        1024 as usize
                    ) as ref u8
                    if str.raw_cmp(pn, "_") == 0 {
                        @snprintf(pb, 1024, "{s} t__{lld}", {pct, pi})
                    } else {
                        @snprintf(pb, 1024, "{s} t_{s}", {pct, pn})
                    }
                    emit(
                        ctx,
                        pb
                    )
                    cc_register_local(ctx, pn, cc_spectre_type_name_of(ctx, pt), pt, 0)
                }
                pi++
            }
        } elif !ret_unboxed {
            emit(ctx, "void")
        }
        emitln(ctx, "){")
    }
    if is_main {
        emitln(ctx, "sx__argc=(int64_t)argc;sx__argv=(int64_t)(intptr_t)argv;")
        emitln(ctx, "sx__init();")
        if !ctx.release_mode {
            emitln(ctx, "__sx_panic_init();")
        }
    }
    gen_stmts(ctx, body)
    val blen: i64 = @len(body) as i64
    val needs_ret: mut bool = true
    if blen > 0 {
        val last_opt = @get(body, (blen - 1) as usize)
        if last_opt is some last {
            if ((last as ref parser.Node).kind == parser.NK_RETURN) {
                needs_ret = false
            }
        }
    }
    if needs_ret {
        cc_emit_defers(ctx)
        if is_main {
            emitln(ctx, "return 0;")
        } elif str.raw_cmp(ctx.current_ret_ctype, "void") == 0 {
            emitln(ctx, "return;")
        } else {
            emitln(ctx, "return 0;")
        }
    }
    ctx.current_prefix = saved_prefix
    ctx.current_ret_unboxed = false
    emitln(ctx, "}")
    emitln(ctx, "")
}

fn gen_extern_fn_prefixed(_: ref CCtx, _: ref parser.Node, _: ref u8) void = trust {
    // NOOP.
}

fn gen_extern_header(ctx: ref CCtx, item: ref parser.Node) void = trust {
    val header: ref u8 = item.d0 as ref u8
    if header == none {
        return
    }
    val inc: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(inc, 1024, "#include \"{s}\"", {header})
    emitln_fwd(ctx, inc)
}

fn gen_tagged_union_def(ctx: ref CCtx, item: ref parser.Node, mod_prefix: ref u8) void = trust {
    val name: ref u8 = item.d1 as ref u8
    val variants: ref void = item.d2 as ref void
    if variants == none {
        return
    }
    val is_sc: bool = is_std_child_name(mod_prefix)
    val vlen: i64 = @len(variants) as i64
    val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(
        ctx.arena,
        256 as usize
    ) as ref u8
    if str.raw_cmp(mod_prefix, "") == 0 {
        @snprintf(mangled, 256, "{s}", {name})
    } else {
        @snprintf(mangled, 256, "{s}__{s}", {mod_prefix, name})
    }
    cc_register_union(ctx, mangled, variants)
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vn: ref parser.Node = v as ref parser.Node
            val vname: ref u8 = vn.d0 as ref u8
            cc_register_tv(ctx, vname, mangled, vi, vn.d1 as ref void)
            val uv: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                256 as usize
            ) as ref u8
            @snprintf(uv, 256, "{s}__{s}", {name, vname})
            cc_register_tv(ctx, uv, mangled, vi, vn.d1 as ref void)
            if str.raw_cmp(mod_prefix, "") != 0 {
                val pv: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(
                    pv,
                    256,
                    "{s}__{s}",
                    {mod_prefix, vname}
                )
                cc_register_tv(ctx, pv, mangled, vi, vn.d1 as ref void)
                val qv: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(
                    qv,
                    256,
                    "{s}__{s}__{s}",
                    {mod_prefix, name, vname}
                )
                cc_register_tv(ctx, qv, mangled, vi, vn.d1 as ref void)
            }
            if is_sc {
                val sv: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(
                    sv,
                    256,
                    "std__{s}__{s}",
                    {mod_prefix, vname}
                )
                cc_register_tv(ctx, sv, mangled, vi, vn.d1 as ref void)
                val sqv: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(
                    sqv,
                    256,
                    "std__{s}__{s}__{s}",
                    {mod_prefix, name, vname}
                )
                cc_register_tv(ctx, sqv, mangled, vi, vn.d1 as ref void)
            }
        }
        vi++
    }
}

fn gen_union_def_prefixed(ctx: ref CCtx, item: ref parser.Node, mod_prefix: ref u8) void = trust {
    val name: ref u8 = item.d1 as ref u8
    val variants: ref void = item.d2 as ref void
    if variants == none {
        return
    }
    val vlen: i64 = @len(variants) as i64
    val vnames: mut list[ref u8] = mem.new[ref u8]()
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vty: ref parser.Node = v as ref parser.Node
            val tn: mut ref u8 = "unknown"
            if vty.kind == parser.TY_NAMED {
                tn = vty.d0 as ref u8
            } elif vty.kind == parser.TY_REF {
                tn = "ref"
            }
            @append(vnames, tn)
        }
        vi++
    }
    val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 256 as usize) as ref u8
    if str.raw_cmp(mod_prefix, "") == 0 {
        @snprintf(mangled, 256, "{s}", {name})
    } else {
        @snprintf(mangled, 256, "{s}__{s}", {mod_prefix, name})
    }
    cc_register_union(ctx, mangled, vnames as ref void)
}

fn gen_enum_def_prefixed(ctx: ref CCtx, item: ref parser.Node, mod_prefix: ref u8) void = trust {
    val name: ref u8 = item.d1 as ref u8
    val variants: ref void = item.d2 as ref void
    if variants == none {
        return
    }
    val vlen: i64 = @len(variants) as i64
    val vi: mut i64 = 0
    for {
        if vi >= vlen {
            break
        }
        val v_opt = @get(variants, vi as usize)
        if v_opt is some v {
            val vname: ref u8 = v as ref u8
            val ck: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                512 as usize
            ) as ref u8
            val is: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                32 as usize
            ) as ref u8
            @snprintf(
                is,
                32,
                "{lld}",
                {vi}
            )
            if str.raw_cmp(mod_prefix, "") == 0 {
                @snprintf(ck, 512, "{s}__{s}", {name, vname})
            } else {
                @snprintf(ck, 512, "{s}__{s}__{s}", {mod_prefix, name, vname})
            }
            cc_register_module_const(ctx, ck, is)
            if str.raw_cmp(mod_prefix, "") != 0 {
                val bk: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                @snprintf(
                    bk,
                    256,
                    "{s}__{s}",
                    {name, vname}
                )
                val is2: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    32 as usize
                ) as ref u8
                @snprintf(
                    is2,
                    32,
                    "{lld}",
                    {vi}
                )
                cc_register_module_const(ctx, bk, is2)
            }
        }
        vi++
    }
}

fn preregister_items(
    ctx: mut ref CCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_GENERIC_FN {
                cc_register_generic_fn(
                    ctx,
                    cc_generic_fn_qualified_name(ctx, node, mod_prefix),
                    node,
                    mod_prefix
                )
            } elif k == parser.NK_FN {
                val ns: ref u8 = node.d1 as ref u8
                val name: ref u8 = node.d2 as ref u8
                val params: ref void = node.d3 as ref void
                val ret_ty: ref void = node.d4 as ref void
                val base: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    256 as usize
                ) as ref u8
                if ns != none {
                    @snprintf(base, 256, "{s}__{s}", {ns, name})
                } else {
                    @snprintf(base, 256, "{s}", {name})
                }
                val is_sc: bool = is_std_child_name(mod_prefix)
                val mangled: ref u8 = allocators.ScopedArena.alloc_or_none(
                    ctx.arena,
                    512 as usize
                ) as ref u8
                if str.raw_cmp(mod_prefix, "") == 0 {
                    if str.raw_cmp(base, "main") == 0 {
                        @snprintf(mangled, 512, "{s}", {base})
                    } else {
                        @snprintf(mangled, 512, "sx__{s}", {base})
                    }
                } elif is_sc {
                    @snprintf(mangled, 512, "std__{s}__{s}", {mod_prefix, base})
                } else {
                    @snprintf(mangled, 512, "{s}__{s}", {mod_prefix, base})
                }
                if params != none {
                    cc_register_fn(ctx, node, mangled, params, ret_ty, false, false)
                }
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, false)
                if node.d3 != 0 as i64 {
                    cc_register_invariant(ctx, node.d1 as ref u8, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, true)
            } elif k == parser.NK_EXTERN_FN {
                val name: ref u8 = node.d1 as ref u8
                val symbol: ref u8 = node.d2 as ref u8
                val params: ref void = node.d4 as ref void
                val ret_ty: ref void = node.d5 as ref void
                val is_var: bool = parser.extern_fn_is_variadic(node)
                val no_forward: bool = parser.extern_fn_uses_header(node)
                val is_sc2: bool = is_std_child_name(mod_prefix)
                cc_register_extern(ctx, name, symbol, ret_ty)
                if params != none {
                    cc_register_fn(ctx, node, symbol, params, ret_ty, is_var, no_forward)
                }
                if str.raw_cmp(mod_prefix, "") != 0 {
                    val m: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    @snprintf(
                        m,
                        512,
                        "{s}__{s}",
                        {mod_prefix, name}
                    )
                    cc_register_extern(ctx, m, symbol, ret_ty)
                    if params != none {
                        cc_register_fn(ctx, node, m, params, ret_ty, is_var, no_forward)
                    }
                }
                if is_sc2 {
                    val sm: ref u8 = allocators.ScopedArena.alloc_or_none(
                        ctx.arena,
                        512 as usize
                    ) as ref u8
                    @snprintf(
                        sm,
                        512,
                        "std__{s}__{s}",
                        {mod_prefix, name}
                    )
                    cc_register_extern(ctx, sm, symbol, ret_ty)
                    if params != none {
                        cc_register_fn(ctx, node, sm, params, ret_ty, is_var, no_forward)
                    }
                }
            } elif k == parser.NK_CONST {
                val cn: ref u8 = node.d1 as ref u8
                val ce: ref parser.Node = node.d2 as ref parser.Node
                val cv: mut ref u8 = none
                if ce != none {
                    if ce.kind == parser.NK_INT_LIT {
                        cv = parser.int_lit_text(ce)
                    } elif ce.kind == parser.NK_BOOL {
                        if ce.d0 as i64 != 0 {
                            cv = "1"
                        } else {
                            cv = "0"
                        }
                    } elif ce.kind == parser.NK_FLOAT_LIT {
                        cv = parser.float_lit_text(ce)
                    } elif ce.kind == parser.NK_UNOP {
                        val uop: i64 = parser.unop_op(ce)
                        val inner: ref parser.Node = parser.unop_inner(ce)
                        if inner != none && uop == parser.UOP_NEG && inner.kind == parser.NK_INT_LIT {
                            val iv: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                128 as usize
                            ) as ref u8
                            @snprintf(
                                iv,
                                128,
                                "-{s}",
                                {parser.int_lit_text(inner)}
                            )
                            cv = iv
                        } elif inner != none && uop == parser.UOP_NEG && inner.kind == parser.NK_FLOAT_LIT {
                            val fv: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                128 as usize
                            ) as ref u8
                            @snprintf(
                                fv,
                                128,
                                "-{s}",
                                {parser.float_lit_text(inner)}
                            )
                            cv = fv
                        }
                    } elif ce.kind == parser.NK_STR_LIT {
                        val sidx: i64 = intern_string(ctx, parser.str_lit_text(ce))
                        val sb: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            128 as usize
                        ) as ref u8
                        @snprintf(sb, 128, "((int64_t)(intptr_t)sx__str{lld})", {sidx})
                        cv = sb
                    } elif ce.kind == parser.NK_CAST {
                        val inner_text: ref u8 = cc_const_literal_text(
                            ctx,
                            ce.d0 as ref parser.Node
                        )
                        if str.raw_cmp(inner_text, "") != 0 {
                            val target_ty: ref parser.Node = ce.d1 as ref parser.Node
                            val ct: ref u8 = c_type_of(cc_concrete_ty(ctx, target_ty))
                            val cb: ref u8 = allocators.ScopedArena.alloc_or_none(
                                ctx.arena,
                                256 as usize
                            ) as ref u8
                            @snprintf(cb, 256, "(({s})({s}))", {ct, inner_text})
                            cv = cb
                        }
                    } elif ce.kind == parser.NK_BUILTIN {
                        val bname: ref u8 = ce.d0 as ref u8
                        if str.raw_cmp(bname, "embed") == 0 {
                            val epath: ref u8 = ce.d2 as ref u8
                            if epath == none {
                                stdio.eprint("error: @embed path was not resolved\n", {})
                                os.exit(1)
                            }
                            val label: ref u8 = cc_embed_data(ctx, epath, ce.d3)
                            cv = arenafmt.format(ctx.arena, "(int64_t)(intptr_t){s}", {label})
                        } elif str.raw_cmp(bname, "embedlen") == 0 {
                            cv = arenafmt.format(ctx.arena, "{lld}", {ce.d3})
                        }
                    }
                }
                if ce != none && ce.kind == parser.NK_LIST_LIT {
                    cc_register_module_global(
                        ctx,
                        cn,
                        mod_prefix,
                        node.d3 as ref parser.Node
                    )
                } else {
                    cc_register_module_global(
                        ctx,
                        cn,
                        mod_prefix,
                        node.d3 as ref parser.Node
                    )
                }
                if cv != none {
                    cc_register_module_const(ctx, cn, cv)
                    if str.raw_cmp(mod_prefix, "") != 0 {
                        val pk: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            512 as usize
                        ) as ref u8
                        @snprintf(
                            pk,
                            512,
                            "{s}__{s}",
                            {mod_prefix, cn}
                        )
                        cc_register_module_const(ctx, pk, cv)
                    }
                    val is_sc3: bool = is_std_child_name(mod_prefix)
                    if is_sc3 {
                        val sk: ref u8 = allocators.ScopedArena.alloc_or_none(
                            ctx.arena,
                            512 as usize
                        ) as ref u8
                        @snprintf(
                            sk,
                            512,
                            "std__{s}__{s}",
                            {mod_prefix, cn}
                        )
                        cc_register_module_const(ctx, sk, cv)
                    }
                }
            } elif k == parser.NK_VAL {
                val vn: ref u8 = node.d0 as ref u8
                val vty_node: ref parser.Node = node.d2 as ref parser.Node
                cc_register_module_global(ctx, vn, mod_prefix, vty_node)
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = node.d0 as ref u8
                if cc_platform_matches(ctx, plat) {
                    preregister_items(ctx, node.d1 as list[ref parser.Node], mod_prefix)
                } else {
                    val ow: ref void = node.d2 as ref void
                    val matched: mut bool = false
                    if ow != none {
                        for own in ow as list[ref parser.Node] {
                            if !matched {
                                if cc_platform_matches(ctx, own.d0 as ref u8) {
                                    preregister_items(
                                        ctx,
                                        own.d1 as list[ref parser.Node],
                                        mod_prefix
                                    )
                                    matched = true
                                }
                            }
                        }
                    }
                    if !matched {
                        val otherwise: ref void = node.d3 as ref void
                        if otherwise != none {
                            preregister_items(ctx, otherwise as list[ref parser.Node], mod_prefix)
                        }
                    }
                }
            }
        }
        i++
    }
}

fn gen_module_storage(
    ctx: mut ref CCtx,
    name: ref u8,
    ty_node_in: ref parser.Node,
    init_expr: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val ty_node: mut ref parser.Node = cc_concrete_ty(ctx, ty_node_in)
    val ct: mut ref u8 = "int64_t"
    if ty_node != none {
        ct = cc_c_type_of(ctx, ty_node)
    }
    val mangled: ref u8 = cc_register_module_global(ctx, name, mod_prefix, ty_node)

    if init_expr != none && init_expr.kind == parser.NK_BUILTIN {
        val bname: ref u8 = init_expr.d0 as ref u8
        if str.raw_cmp(bname, "embed") == 0 {
            val epath: ref u8 = init_expr.d2 as ref u8
            if epath == none {
                stdio.eprint("error: @embed path was not resolved\n", {})
                os.exit(1)
            }
            val label: ref u8 = cc_embed_data(ctx, epath, init_expr.d3)
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                1024 as usize
            ) as ref u8
            @snprintf(
                ebuf,
                1024,
                "static int64_t {s} = (int64_t)(intptr_t){s};\n",
                {mangled, label}
            )
            emit_to_fwd(ctx, ebuf)
            return
        }
        if str.raw_cmp(bname, "embedlen") == 0 {
            val ebuf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                1024 as usize
            ) as ref u8
            @snprintf(ebuf, 1024, "static int64_t {s} = INT64_C({lld});\n", {mangled, init_expr.d3})
            emit_to_fwd(ctx, ebuf)
            return
        }
    }

    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(buf, 1024, "static {s} {s};\n", {ct, mangled})
    emit_to_fwd(ctx, buf)

    if ty_node != none && cc_is_aggregate_storage(ctx, ty_node) {
        if init_expr == none || cc_expr_is_zero_init_like(init_expr) {
            val sz: i64 = c_size_of(ctx, ty_node)
            val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
                ctx.arena,
                2048 as usize
            ) as ref u8
            @snprintf(init_buf, 2048, "{s} = (int64_t)(intptr_t)calloc(1,{lld});\n", {mangled, sz})
            str.StringBuilder.append_cstr(ctx.init_sb, init_buf)
            return
        }
    }

    if init_expr != none {
        val old_sb = ctx.sb
        ctx.sb = ctx.init_sb
        val old_expected = ctx.expected_ty
        ctx.expected_ty = ty_node
        val fixed_ty: ref parser.Node = cc_fixed_arr_ty(ctx, ty_node)
        val val_str: mut ref u8 = ""
        if init_expr.kind == parser.NK_LIST_LIT && fixed_ty != none {
            val_str = gen_fixed_arr_lit(ctx, init_expr, fixed_ty)
        } else {
            val_str = gen_expr(ctx, init_expr)
        }
        ctx.expected_ty = old_expected
        val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            2048 as usize
        ) as ref u8
        @snprintf(init_buf, 2048, "{s} = ({s})({s});\n", {mangled, ct, val_str})
        str.StringBuilder.append_cstr(ctx.init_sb, init_buf)
        cc_expr_drain(ctx)
        ctx.sb = old_sb
    }
}

fn gen_module_val(ctx: mut ref CCtx, node: ref parser.Node, mod_prefix: ref u8) void = trust {
    gen_module_storage(
        ctx,
        node.d0 as ref u8,
        node.d2 as ref parser.Node,
        node.d3 as ref parser.Node,
        mod_prefix
    )
}

fn gen_module_const_global(
    ctx: mut ref CCtx,
    node: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    gen_module_storage(
        ctx,
        node.d1 as ref u8,
        node.d3 as ref parser.Node,
        node.d2 as ref parser.Node,
        mod_prefix
    )
}

fn gen_module_const_list(
    ctx: mut ref CCtx,
    node: ref parser.Node,
    mod_prefix: ref u8
) void = trust {
    val name: ref u8 = node.d1 as ref u8
    val init_expr: ref parser.Node = node.d2 as ref parser.Node
    val ty_node: ref parser.Node = cc_concrete_ty(ctx, node.d3 as ref parser.Node)
    val mangled: ref u8 = cc_register_module_global(ctx, name, mod_prefix, ty_node)
    val buf: ref u8 = allocators.ScopedArena.alloc_or_none(ctx.arena, 1024 as usize) as ref u8
    @snprintf(buf, 1024, "static int64_t {s};\n", {mangled})
    emit_to_fwd(ctx, buf)
    if init_expr != none {
        val old_sb = ctx.sb
        ctx.sb = ctx.init_sb
        val old_expected = ctx.expected_ty
        ctx.expected_ty = ty_node
        val fixed_ty: ref parser.Node = cc_fixed_arr_ty(ctx, ty_node)
        val val_str: mut ref u8 = ""
        if init_expr.kind == parser.NK_LIST_LIT && fixed_ty != none {
            val_str = gen_fixed_arr_lit(ctx, init_expr, fixed_ty)
        } else {
            val_str = gen_expr(ctx, init_expr)
        }
        ctx.expected_ty = old_expected
        val init_buf: ref u8 = allocators.ScopedArena.alloc_or_none(
            ctx.arena,
            2048 as usize
        ) as ref u8
        @snprintf(init_buf, 2048, "{s} = (int64_t)({s});\n", {mangled, val_str})
        str.StringBuilder.append_cstr(ctx.init_sb, init_buf)
        cc_expr_drain(ctx)
        ctx.sb = old_sb
    }
}

fn gen_items_with_prefix(
    ctx: mut ref CCtx,
    items: list[ref parser.Node],
    mod_prefix: ref u8
) void = trust {
    preregister_items(ctx, items, mod_prefix)
    val ilen: i64 = @len(items) as i64
    val i: mut i64 = 0
    for {
        if i >= ilen {
            break
        }
        val item_opt = @get(items, i as usize)
        if item_opt is some item {
            val node: ref parser.Node = item as ref parser.Node
            val k: i64 = node.kind
            if k == parser.NK_GENERIC_FN {
                cc_register_generic_fn(
                    ctx,
                    cc_generic_fn_qualified_name(ctx, node, mod_prefix),
                    node,
                    mod_prefix
                )
            } elif k == parser.NK_FN {
                gen_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_VAL {
                gen_module_val(ctx, node, mod_prefix)
            } elif k == parser.NK_CONST {
                val ce: ref parser.Node = node.d2 as ref parser.Node
                if ce != none && ce.kind == parser.NK_LIST_LIT {
                    gen_module_const_list(ctx, node, mod_prefix)
                } else {
                    gen_module_const_global(ctx, node, mod_prefix)
                }
            } elif k == parser.NK_EXTERN_FN {
                gen_extern_fn_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_EXTERN_HEADER {
                gen_extern_header(ctx, node)
            } elif k == parser.NK_ENUMDEF {
                gen_enum_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_UNIONDEF {
                gen_union_def_prefixed(ctx, node, mod_prefix)
            } elif k == parser.NK_TAGGED_UNIONDEF {
                gen_tagged_union_def(ctx, node, mod_prefix)
            } elif k == parser.NK_TYPEDEF {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, false)
                if node.d3 != 0 as i64 {
                    cc_register_invariant(ctx, node.d1 as ref u8, node.d3 as ref void)
                }
            } elif k == parser.NK_EXTERN_TYPE {
                cc_register_struct(ctx, node.d1 as ref u8, node.d2 as ref void, true)
            } elif k == parser.NK_WHEN_ITEMS {
                val plat: ref u8 = node.d0 as ref u8
                if cc_platform_matches(ctx, plat) {
                    gen_items_with_prefix(ctx, node.d1 as list[ref parser.Node], mod_prefix)
                } else {
                    val ow: ref void = node.d2 as ref void
                    val matched: mut bool = false
                    if ow != none {
                        for own in ow as list[ref parser.Node] {
                            if !matched {
                                if cc_platform_matches(ctx, own.d0 as ref u8) {
                                    gen_items_with_prefix(
                                        ctx,
                                        own.d1 as list[ref parser.Node],
                                        mod_prefix
                                    )
                                    matched = true
                                }
                            }
                        }
                    }
                    if !matched {
                        val otherwise: ref void = node.d3 as ref void
                        if otherwise != none {
                            gen_items_with_prefix(
                                ctx,
                                otherwise as list[ref parser.Node],
                                mod_prefix
                            )
                        }
                    }
                }
            }
        }
        i++
    }
}

fn emit_to_fwd(ctx: ref CCtx, s: ref u8) void = trust {
    str.StringBuilder.append_cstr(ctx.fwd_sb, s)
}

fn emitln_fwd(ctx: ref CCtx, s: ref u8) void = trust {
    str.StringBuilder.append_cstr(ctx.fwd_sb, s)
    str.StringBuilder.append_char(ctx.fwd_sb, 10 as u8)
}

fn emit_c_preamble(ctx: ref CCtx) void = trust {
    if cc_platform_matches(ctx, "posix") {
        emitln_fwd(ctx, "#define _POSIX_C_SOURCE 200809L")
    }
    emitln_fwd(ctx, "#include <stdint.h>")
    emitln_fwd(ctx, "#include <stdlib.h>")
    emitln_fwd(ctx, "#include <string.h>")
    emitln_fwd(ctx, "#include <stdio.h>")
    emitln_fwd(ctx, "#include <time.h>")
    emitln_fwd(ctx, \\static char* sx__rt_rewrite_fmt(const char* s){if(!s)return(char*)"";size_t n=strlen(s);int ps=0;for(size_t i=0;i+1<n;i++){char c=s[i+1];if(s[i]=='%'&&(c=='%'||c=='d'||c=='i'||c=='o'||c=='u'||c=='x'||c=='X'||c=='e'||c=='E'||c=='f'||c=='F'||c=='g'||c=='G'||c=='a'||c=='A'||c=='c'||c=='s'||c=='p'||c=='l')){ps=1;break;}}char*o=(char*)malloc(n*4+2);size_t oi=0;if(ps){memcpy(o,s,n);o[n]=0;return o;}for(size_t i=0;i<n;){unsigned char c=(unsigned char)s[i];if(c=='\\'&&i+1<n&&(s[i+1]=='{'||s[i+1]=='}')){o[oi++]=s[i+1];i+=2;}else if(c=='{'){size_t j=i+1;while(j<n&&s[j]!='}')j++;if(j<n){size_t tlen=j-(i+1);int okk=0;char sp[8];memset(sp,0,8);if(tlen==1){char sc=s[i+1];if(sc=='d'||sc=='i'||sc=='s'||sc=='x'||sc=='c'||sc=='p'||sc=='f'){okk=1;sp[0]=sc;}}else if(tlen<=6){memcpy(sp,s+i+1,tlen);if((tlen==2&&((sp[0]=='l'&&(sp[1]=='d'||sp[1]=='u'||sp[1]=='x'))||(sp[0]=='z'&&(sp[1]=='u'||sp[1]=='d'))))||(tlen==3&&sp[0]=='l'&&sp[1]=='l'&&(sp[2]=='d'||sp[2]=='u'||sp[2]=='x')))okk=1;}if(okk){if(tlen==1){char sc=sp[0];if(sc=='d'||sc=='i'){memcpy(o+oi,"%lld",4);oi+=4;}else if(sc=='s'){memcpy(o+oi,"%s",2);oi+=2;}else if(sc=='x'){memcpy(o+oi,"%llx",4);oi+=4;}else if(sc=='c'){memcpy(o+oi,"%c",2);oi+=2;}else if(sc=='p'){memcpy(o+oi,"%p",2);oi+=2;}else{memcpy(o+oi,"%f",2);oi+=2;}}else{o[oi++]='%';memcpy(o+oi,sp,tlen);oi+=tlen;}}else{memcpy(o+oi,s+i,j-i+1);oi+=j-i+1;}i=j+1;}else{o[oi++]=c;i++;}}else{o[oi++]=c;i++;}}o[oi]=0;return o;}
    )
    if cc_platform_matches(ctx, "posix") {
        emitln_fwd(ctx, "#include <sys/time.h>")
        emitln_fwd(ctx, "#include <sys/types.h>")
        emitln_fwd(ctx, "#include <sys/stat.h>")
        emitln_fwd(ctx, "#include <unistd.h>")
        emitln_fwd(ctx, "#include <dirent.h>")
    }
    if cc_platform_matches(ctx, "windows") {
        emitln_fwd(ctx, "#ifndef WIN32_LEAN_AND_MEAN")
        emitln_fwd(ctx, "#define WIN32_LEAN_AND_MEAN")
        emitln_fwd(ctx, "#endif")
        emitln_fwd(ctx, "#include <windows.h>")
        emitln_fwd(ctx, "#include <io.h>")
        emitln_fwd(ctx, "#include <direct.h>")
        emitln_fwd(ctx, "#ifdef __MINGW32__")
        emitln_fwd(ctx, "#include <dirent.h>")
        emitln_fwd(ctx, "#include <sys/time.h>")
        emitln_fwd(ctx, "#endif")
        emitln_fwd(ctx, "#if defined(_WIN32) && !defined(__MINGW32__)")
        emitln_fwd(ctx, "#include <io.h>")
        emitln_fwd(ctx, "#include <direct.h>")
        emitln_fwd(ctx, "#include <fcntl.h>")
        emitln_fwd(ctx, "#include <sys/stat.h>")
        emitln_fwd(
            ctx,
            "static int sx__win_access(int64_t path,int32_t mode){return _access((const char*)(intptr_t)path,(int)mode);}"
        )
        emitln_fwd(ctx, "#define access sx__win_access")
        emitln_fwd(
            ctx,
            "static void* sx__win_getcwd(int64_t buf,int64_t size){return (void*)_getcwd((char*)(intptr_t)buf,(int)size);}"
        )
        emitln_fwd(ctx, "#define getcwd sx__win_getcwd")
        emitln_fwd(
            ctx,
            "typedef struct sx__win_dirent { int32_t d_ino; uint16_t d_reclen; uint16_t d_namlen; char d_name[260]; } sx__win_dirent;"
        )
        emitln_fwd(
            ctx,
            "typedef struct sx__win_dir { HANDLE h; WIN32_FIND_DATAA data; int first; sx__win_dirent ent; } sx__win_dir;"
        )
