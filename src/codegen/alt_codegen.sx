            val cast_expr: ref u8 = cc_build_fnptr_cast(ctx, fn_ty, fn_expr)
            val call_sb: ref void = str.StringBuilder.new()
            str.StringBuilder.append_cstr(call_sb, cast_expr)
            str.StringBuilder.append_cstr(call_sb, "(")
            val ret_ty: mut ref parser.Node = none
            if fn_ty != none {
                ret_ty = fn_ty.d1 as ref parser.Node
