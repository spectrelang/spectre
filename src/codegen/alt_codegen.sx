    if str.raw_cmp(bname, "get") == 0 || str.raw_cmp(bname, "getref") == 0
    || str.raw_cmp(bname, "getmut") == 0 {
        if true {
            val mode: mut i64 = 0
            if str.raw_cmp(bname, "getref") == 0 {
                mode = 1
            } elif str.raw_cmp(bname, "getmut") == 0 {
                mode = 2
            }
            return cc_gen_get_unboxed(ctx, expr, args, mode)
